/* --- Phase 6: 提出前チェック --- */
function buildPrecheckPhase(){
  const items = [...preChecks.querySelectorAll('.self-check-row')].map(r => {
    const checked = r.querySelector('input[type=checkbox]').checked;
    const label = r.querySelector('.sc-label').value.trim();
    const note = r.querySelector('.sc-note').value.trim();
    if (!label) return null;
    return `- [${checked ? 'x' : ' '}] ${label}${note ? ` _(${note})_` : ''}`;
  }).filter(Boolean);
  const total = items.length;
  const done = [...preChecks.querySelectorAll('input[type=checkbox]:checked')].length;
  const pct = total > 0 ? Math.round(done / total * 100) : 0;
  const known = w_v('w_pre_known') || '_（特になし）_';

  if (webPerspective === 'teacher') {
    return `## ✅ ⑥ 提出前チェック（指示・評価観点）

### 6-1. 受講生は提出前に以下を完了すること

達成度： **${done} / ${total}**（${pct}%）

${items.length ? items.join('\n') : '_（チェック項目未入力）_'}

### 6-2. 既知の課題・限界（受講生が申告したもの）

${known}

### 6-3. 評価観点

- [ ] チェック項目を実際に確認した形跡がある（メモ記載含む）
- [ ] 達成度が80%以上
- [ ] 未達項目について隠さず申告できている`;
  }

  return `## ✅ ⑥ 提出前チェック

**達成度： ${done} / ${total}（${pct}%）**

${items.length ? items.join('\n') : '_（チェック項目未入力）_'}

### 6-1. 既知の課題・限界

${known}`;
}

