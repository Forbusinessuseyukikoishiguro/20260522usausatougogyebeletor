}

/* ============ 一人MTG2（目標・KPT＋Change） ============ */
// 生成結果ボタン用
function mtg2FromOutput(){
  var tab=[].slice.call(document.querySelectorAll(&quot;.tab&quot;)).filter(function(t){return t.dataset.tab===&quot;mtg2&quot;;})[0];
  if(tab) tab.click();
  buildMtg2();
}
// 保存ログからKeep/Problem/Tryを下書き
function mtg2DraftFromLog(){
  var days=loadDays();
  if(!days.length){ toast(&quot;保存ログがありません（時間割タブで保存）&quot;); return; }
  days=days.slice().sort(function(a,b){return (dateKey(a.date)||0)-(dateKey(b.date)||0);}).slice(-7);
  var keeps=[], probs=[], tries=[];
  days.forEach(function(d){
    if(d.keep) keeps.push(d.keep);
    if(d.goal &amp;&amp; d.rate>=75) keeps.push(&quot;【めあて達成】&quot;+d.goal);
    if(d.problem) probs.push(d.problem);
    if(d.tryv) tries.push(d.tryv);
    (d.periods||[]).forEach(function(p){ if(!(p.kind===&quot;break&quot;||p.isBreak) &amp;&amp; p.status===&quot;△&quot;){ var w=(p.actual||p.plan||&quot;&quot;).trim(); if(w) probs.push(w+&quot;（未達）&quot;); } });
  });
  function uniq(a){ var s={},o=[]; a.forEach(function(x){ if(!s[x]){s[x]=1;o.push(x);} }); return o; }
  if(!v(&quot;g2_keep&quot;) &amp;&amp; keeps.length) document.getElementById(&quot;g2_keep&quot;).value=uniq(keeps).join(&quot;\n&quot;);
  if(!v(&quot;g2_problem&quot;) &amp;&amp; probs.length) document.getElementById(&quot;g2_problem&quot;).value=uniq(probs).join(&quot;\n&quot;);
  if(!v(&quot;g2_try&quot;) &amp;&amp; tries.length) document.getElementById(&quot;g2_try&quot;).value=uniq(tries).join(&quot;\n&quot;);
  toast(&quot;Keep / Problem / Try を下書きしました&quot;);
}
function buildMtg2(){
  currentTab=&quot;mtg2&quot;;
  var theme=v(&quot;g2_theme&quot;), due=v(&quot;g2_due&quot;);
  var minG=v(&quot;g2_min&quot;), maxG=v(&quot;g2_max&quot;), minT=v(&quot;g2_min_time&quot;), maxT=v(&quot;g2_max_time&quot;);
  var keep=lines(v(&quot;g2_keep&quot;)), prob=lines(v(&quot;g2_problem&quot;)), tryv=lines(v(&quot;g2_try&quot;)), chg=lines(v(&quot;g2_change&quot;));

  /* テキスト版 */
  var o=[];
  o.push(BAR); o.push(&quot;🎯 一人MTG2（目標・KPT）　&quot;+nowParts().date); o.push(BAR);
  if(theme) o.push(&quot;テーマ：&quot;+theme);
  if(due) o.push(&quot;期日：&quot;+due);
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;🎯 目標（2段階）&quot;); o.push(BAR2);
  o.push(&quot;🟢 最低限の目標&quot;+(minT?(&quot;（目安 &quot;+minT+&quot;）&quot;):&quot;&quot;)+&quot;：&quot;);
  (minG?[minG]:[&quot;（必ず達成するラインを書こう）&quot;]).forEach(function(x){ o.push(&quot;　&quot;+x); });
  o.push(&quot;🌟 最高の目標&quot;+(maxT?(&quot;（目安 &quot;+maxT+&quot;）&quot;):&quot;&quot;)+&quot;：&quot;);
  (maxG?[maxG]:[&quot;（できたら最高のラインを書こう）&quot;]).forEach(function(x){ o.push(&quot;　&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;✅ Keep（続けたい・うまくいった）&quot;); o.push(BAR2);
  (keep.length?keep:[&quot;（記録なし）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;🌧 Problem（課題）&quot;); o.push(BAR2);
  (prob.length?prob:[&quot;（特になし）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;🌱 Try（次に試す）&quot;); o.push(BAR2);
  (tryv.length?tryv:[&quot;（試したいことを書こう）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;🔄 Change（やめる・変える）&quot;); o.push(BAR2);
  (chg.length?chg:[&quot;（やめる/変えることを書こう）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(&quot;🐰 うさうさ先生：まず『最低限の目標』を死守。余力で『最高の目標』へ。期日から逆算して一歩目を決めよう。&quot;);
  var txt=o.join(&quot;\n&quot;);

  /* Markdown版 */
  var m=[];
  m.push(&quot;# 🎯 一人MTG2（目標・KPT）&quot;);
  m.push(&quot;&quot;);
  if(theme) m.push(&quot;- **テーマ**：&quot;+theme);
  if(due) m.push(&quot;- **期日**：&quot;+due);
  m.push(&quot;- 日付：&quot;+nowParts().date);
  m.push(&quot;&quot;);
  m.push(&quot;## 🎯 目標（2段階）&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;| 区分 | 目標 | 時間の目安 |&quot;);
  m.push(&quot;|---|---|---|&quot;);
  m.push(&quot;| 🟢 最低限 | &quot;+(minG||&quot;（必ず達成）&quot;).replace(/\n/g,&quot;／&quot;)+&quot; | &quot;+(minT||&quot;&quot;)+&quot; |&quot;);
  m.push(&quot;| 🌟 最高 | &quot;+(maxG||&quot;（できたら最高）&quot;).replace(/\n/g,&quot;／&quot;)+&quot; | &quot;+(maxT||&quot;&quot;)+&quot; |&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;## ✅ Keep&quot;); m.push(&quot;&quot;); (keep.length?keep:[&quot;（記録なし）&quot;]).forEach(function(x){m.push(&quot;- &quot;+x);}); m.push(&quot;&quot;);
  m.push(&quot;## 🌧 Problem&quot;); m.push(&quot;&quot;); (prob.length?prob:[&quot;（特になし）&quot;]).forEach(function(x){m.push(&quot;- &quot;+x);}); m.push(&quot;&quot;);
  m.push(&quot;## 🌱 Try&quot;); m.push(&quot;&quot;); (tryv.length?tryv:[&quot;（試したいこと）&quot;]).forEach(function(x){m.push(&quot;- &quot;+x);}); m.push(&quot;&quot;);
  m.push(&quot;## 🔄 Change&quot;); m.push(&quot;&quot;); (chg.length?chg:[&quot;（やめる/変える）&quot;]).forEach(function(x){m.push(&quot;- &quot;+x);}); m.push(&quot;&quot;);
  m.push(&quot;> 🐰 まず最低限を死守、余力で最高へ。期日から逆算して一歩目を決めよう。&quot;);
  var md=m.join(&quot;\n&quot;);

  setOut(txt, md);
}

/* ============ 一人MTG（PDCA）タイマー ============ */
var PDCA_PHASES=[
  {key:&quot;P&quot;, name:&quot;📝 Plan（計画）&quot;, min:&quot;pd_min_P&quot;, sub:&quot;目標とやることを書き出す&quot;},
  {key:&quot;D&quot;, name:&quot;🏃 Do（実行）&quot;,  min:&quot;pd_min_D&quot;, sub:&quot;手を動かす・進める&quot;},
  {key:&quot;C&quot;, name:&quot;🔍 Check（評価）&quot;,min:&quot;pd_min_C&quot;, sub:&quot;結果をふりかえる&quot;},
  {key:&quot;A&quot;, name:&quot;🚀 Act（改善）&quot;,  min:&quot;pd_min_A&quot;, sub:&quot;次の一手を決める&quot;}
];
var pdca={timer:null, idx:-1, remain:0, total:0, running:false, mode:null};

function pdcaFmt(sec){ var m=Math.floor(sec/60), s=sec%60; return (&quot;0&quot;+m).slice(-2)+&quot;:&quot;+(&quot;0&quot;+s).slice(-2); }
function pdcaSetClock(){
  document.getElementById(&quot;pd_clock&quot;).textContent=pdcaFmt(Math.max(0,pdca.remain));
  var fill=document.getElementById(&quot;pd_barfill&quot;);
  fill.style.width = pdca.total>0 ? (Math.max(0,pdca.remain)/pdca.total*100)+&quot;%&quot; : &quot;0%&quot;;
}
function pdcaHighlight(phaseKey){
  [].slice.call(document.querySelectorAll(&quot;.pdca-step&quot;)).forEach(function(el){
    el.classList.toggle(&quot;active&quot;, el.dataset.phase===phaseKey);
  });
}
function pdcaBeep(){
  if(!document.getElementById(&quot;pd_sound&quot;) || !document.getElementById(&quot;pd_sound&quot;).checked) return;
  try{
    var Ctx=window.AudioContext||window.webkitAudioContext; if(!Ctx) return;
    var ctx=new Ctx(); var osc=ctx.createOscillator(); var g=ctx.createGain();
    osc.connect(g); g.connect(ctx.destination);
    osc.type=&quot;sine&quot;; osc.frequency.value=880; g.gain.value=0.15;
    osc.start(); setTimeout(function(){ osc.stop(); ctx.close&amp;&amp;ctx.close(); }, 350);
  }catch(e){}
}
function pdcaTick(){
  pdca.remain--;
  pdcaSetClock();
  if(pdca.remain<=0){
    pdcaBeep();
    if(pdca.mode===&quot;auto&quot;){
      // 次のステップへ
      pdcaGoto(pdca.idx+1);
    } else {
      pdcaStopTimer();
      document.getElementById(&quot;pd_phase&quot;).textContent=&quot;⏰ 終了&quot;;
      document.getElementById(&quot;pd_sub&quot;).textContent=&quot;おつかれさま🐰&quot;;
      document.getElementById(&quot;pdcaTimer&quot;).classList.remove(&quot;running&quot;);
    }
  }
}
function pdcaStopTimer(){
  if(pdca.timer){ clearInterval(pdca.timer); pdca.timer=null; }
  pdca.running=false;
}
function pdcaStartTimer(){
  pdcaStopTimer();
  pdca.running=true;
  document.getElementById(&quot;pdcaTimer&quot;).classList.add(&quot;running&quot;);
  pdca.timer=setInterval(pdcaTick,1000);
}
function pdcaPhaseMinutes(i){
  var ph=PDCA_PHASES[i]; var el=document.getElementById(ph.min);
  var mn=parseInt(el&amp;&amp;el.value,10); if(isNaN(mn)||mn<1) mn=1;
  return mn;
}
function pdcaGoto(i){
  if(i>=PDCA_PHASES.length){
    pdcaStopTimer();
    document.getElementById(&quot;pd_phase&quot;).textContent=&quot;🎉 MTG完了&quot;;
    document.getElementById(&quot;pd_clock&quot;).textContent=&quot;00:00&quot;;
    document.getElementById(&quot;pd_sub&quot;).textContent=&quot;PDCAを1周しました。お疲れさまでした🐰&quot;;
    document.getElementById(&quot;pdcaTimer&quot;).classList.remove(&quot;running&quot;);
    pdcaHighlight(null);
    pdca.idx=-1; pdca.mode=null;
    toast(&quot;PDCA 1周 完了！&quot;);
    return;
  }
  pdca.idx=i; pdca.mode=&quot;auto&quot;;
  var ph=PDCA_PHASES[i];
  pdca.total=pdcaPhaseMinutes(i)*60; pdca.remain=pdca.total;
  document.getElementById(&quot;pd_phase&quot;).textContent=ph.name;
  document.getElementById(&quot;pd_sub&quot;).textContent=ph.sub+&quot;（残り &quot;+pdcaPhaseMinutes(i)+&quot;分）&quot;;
  pdcaHighlight(ph.key);
  pdcaSetClock();
  pdcaStartTimer();
}
function pdcaStart(){
  // 一時停止からの再開か、最初から開始か
  if(!pdca.running &amp;&amp; pdca.idx>=0 &amp;&amp; pdca.remain>0){ pdcaStartTimer(); return; }
  pdcaGoto(0);
}
function pdcaPause(){
  if(pdca.running){ pdcaStopTimer(); document.getElementById(&quot;pdcaTimer&quot;).classList.remove(&quot;running&quot;);
    document.getElementById(&quot;pd_sub&quot;).textContent=&quot;一時停止中（▶で再開）&quot;; }
}
function pdcaSkip(){
  if(pdca.mode===&quot;auto&quot; &amp;&amp; pdca.idx>=0){ pdcaGoto(pdca.idx+1); }
  else { toast(&quot;自動MTG中のみ次へ進めます&quot;); }
}
function pdcaReset(){
  pdcaStopTimer();
  pdca.idx=-1; pdca.mode=null; pdca.remain=0; pdca.total=0;
  document.getElementById(&quot;pd_phase&quot;).textContent=&quot;準備OK&quot;;
  document.getElementById(&quot;pd_clock&quot;).textContent=&quot;00:00&quot;;
  document.getElementById(&quot;pd_sub&quot;).textContent=&quot;「▶ MTG開始」で Plan から始まります&quot;;
  document.getElementById(&quot;pd_barfill&quot;).style.width=&quot;0%&quot;;
  document.getElementById(&quot;pdcaTimer&quot;).classList.remove(&quot;running&quot;);
  pdcaHighlight(null);
}
// 単発タイマー（指定分カウントダウンのみ）
function pdcaQuick(min){
  pdcaStopTimer();
  pdca.mode=&quot;quick&quot;; pdca.idx=-1;
  pdca.total=min*60; pdca.remain=pdca.total;
  document.getElementById(&quot;pd_phase&quot;).textContent=&quot;⏱ &quot;+min+&quot;分タイマー&quot;;
  document.getElementById(&quot;pd_sub&quot;).textContent=&quot;集中していこう🐰&quot;;
  pdcaHighlight(null);
  pdcaSetClock();
  pdcaStartTimer();
}

// 保存ログからCheck/Actを下書き
function pdcaDraftFromLog(){
  var days=loadDays();
  if(!days.length){ toast(&quot;保存ログがありません（時間割タブで保存）&quot;); return; }
  days=days.slice().sort(function(a,b){return (dateKey(a.date)||0)-(dateKey(b.date)||0);});
  var recent=days.slice(-7);
  var probs=[], tries=[], rateSum=0;
  recent.forEach(function(d){
    rateSum+=d.rate||0;
    if(d.problem) probs.push(d.problem);
    if(d.tryv) tries.push(d.tryv);
    (d.periods||[]).forEach(function(p){ if(!(p.kind===&quot;break&quot;||p.isBreak) &amp;&amp; p.status===&quot;△&quot;){ var w=(p.actual||p.plan||&quot;&quot;).trim(); if(w) probs.push(w+&quot;（未達）&quot;); } });
  });
  function uniq(a){ var s={},o=[]; a.forEach(function(x){ if(!s[x]){s[x]=1;o.push(x);} }); return o; }
  probs=uniq(probs); tries=uniq(tries);
  var avg=recent.length?Math.round(rateSum/recent.length):0;
  if(!v(&quot;pd_check&quot;)){
    document.getElementById(&quot;pd_check&quot;).value=&quot;直近&quot;+recent.length+&quot;日の平均達成率 &quot;+avg+&quot;%\n&quot;+(probs.length?(&quot;課題：\n- &quot;+probs.join(&quot;\n- &quot;)):&quot;課題：特記なし&quot;);
  }
  if(!v(&quot;pd_act&quot;) &amp;&amp; tries.length){
    document.getElementById(&quot;pd_act&quot;).value=tries.join(&quot;\n&quot;);
  }
  toast(&quot;Check / Act を下書きしました&quot;);
}

// 一人MTG（PDCA）を文章として生成
function buildPdca(){
  currentTab=&quot;pdca&quot;;
  var plan=lines(v(&quot;pd_plan&quot;)), doo=lines(v(&quot;pd_do&quot;)), check=lines(v(&quot;pd_check&quot;)), act=lines(v(&quot;pd_act&quot;));
  var o=[];
  o.push(BAR); o.push(&quot;🔄 一人MTG（PDCA）　&quot;+today()); o.push(BAR);
  o.push(&quot;&quot;); o.push(BAR2); o.push(&quot;📝 Plan（計画）&quot;); o.push(BAR2);
  (plan.length?plan:[&quot;（計画を書こう）&quot;]).forEach(function(x){o.push(&quot;・&quot;+x);});
  o.push(&quot;&quot;); o.push(BAR2); o.push(&quot;🏃 Do（実行）&quot;); o.push(BAR2);
  (doo.length?doo:[&quot;（やったことを書こう）&quot;]).forEach(function(x){o.push(&quot;・&quot;+x);});
  o.push(&quot;&quot;); o.push(BAR2); o.push(&quot;🔍 Check（評価）&quot;); o.push(BAR2);
  (check.length?check:[&quot;（ふりかえりを書こう）&quot;]).forEach(function(x){o.push(&quot;・&quot;+x);});
  o.push(&quot;&quot;); o.push(BAR2); o.push(&quot;🚀 Act（改善）&quot;); o.push(BAR2);
  (act.length?act:[&quot;（次の一手を書こう）&quot;]).forEach(function(x){o.push(&quot;・&quot;+x);});
  o.push(&quot;&quot;); o.push(&quot;🐰 うさうさ先生：PDCAは小さく速く回すほど効きます。Actを1つ実行に移せたら花丸です。&quot;);
  var txt=o.join(&quot;\n&quot;);

  var m=[];
  m.push(&quot;# 🔄 一人MTG（PDCA）&quot;); m.push(&quot;&quot;); m.push(&quot;**日付**：&quot;+today()); m.push(&quot;&quot;);
  m.push(&quot;## 📝 Plan（計画）&quot;); m.push(&quot;&quot;); (plan.length?plan:[&quot;（計画を書こう）&quot;]).forEach(function(x){m.push(&quot;- &quot;+x);}); m.push(&quot;&quot;);
  m.push(&quot;## 🏃 Do（実行）&quot;); m.push(&quot;&quot;); (doo.length?doo:[&quot;（やったことを書こう）&quot;]).forEach(function(x){m.push(&quot;- &quot;+x);}); m.push(&quot;&quot;);
  m.push(&quot;## 🔍 Check（評価）&quot;); m.push(&quot;&quot;); (check.length?check:[&quot;（ふりかえりを書こう）&quot;]).forEach(function(x){m.push(&quot;- &quot;+x);}); m.push(&quot;&quot;);
  m.push(&quot;## 🚀 Act（改善）&quot;); m.push(&quot;&quot;); (act.length?act:[&quot;（次の一手を書こう）&quot;]).forEach(function(x){m.push(&quot;- &quot;+x);}); m.push(&quot;&quot;);
  m.push(&quot;> 🐰 PDCAは小さく速く回すほど効きます。&quot;);
  var md=m.join(&quot;\n&quot;);

  setOut(txt, md);
}

/* ============ 自由ひな形（日報） ============ */
var TPL_KEY=&quot;usausa_templates_v1&quot;;
var TPL_VALS_PREFIX=&quot;usausa_tplvals_&quot;;
var tplCurrentName=&quot;&quot;; // 現在編集中のひな形名

function tplLoadAll(){
  if(!lsAvailable()) return (window.__memTpls||{});
  try{ return JSON.parse(window.localStorage.getItem(TPL_KEY)||&quot;{}&quot;); }catch(e){ return {}; }
}
function tplStoreAll(obj){
  if(lsAvailable()){ try{ window.localStorage.setItem(TPL_KEY, JSON.stringify(obj)); }catch(e){} }
  window.__memTpls=obj;
}
// 差し込み値の保存（ひな形ごと）
function tplLoadVals(name){
  if(!lsAvailable()) return ((window.__memTplVals||{})[name]||{});
  try{ return JSON.parse(window.localStorage.getItem(TPL_VALS_PREFIX+name)||&quot;{}&quot;); }catch(e){ return {}; }
}
function tplStoreVals(name, vals){
  if(lsAvailable()){ try{ window.localStorage.setItem(TPL_VALS_PREFIX+name, JSON.stringify(vals)); }catch(e){} }
  window.__memTplVals=window.__memTplVals||{}; window.__memTplVals[name]=vals;
}

// {{ }} のプレースホルダを抽出（順序維持・重複除去）
function tplExtractPh(body){
  var out=[], seen={}, re=/\{\{\s*([^}]+?)\s*\}\}/g, m;
  while((m=re.exec(body||&quot;&quot;))!==null){ var k=m[1].trim(); if(k &amp;&amp; !seen[k]){ seen[k]=1; out.push(k); } }
  return out;
}
// 本文を見て差し込み入力欄を再構築（既存値は保持）
function tplScan(){
  var body=v(&quot;tpl_body&quot;);
  var phs=tplExtractPh(body);
  var box=document.getElementById(&quot;tpl_fields&quot;);
  // 既存入力値を退避
  var prev={};
  [].slice.call(box.querySelectorAll(&quot;[data-ph]&quot;)).forEach(function(el){ prev[el.getAttribute(&quot;data-ph&quot;)]=el.value; });
  if(!phs.length){ box.innerHTML='<div class=&quot;empty&quot;>本文に <code>{{ }}</code> を書くと、ここに入力欄が出ます。</div>'; return; }
  box.innerHTML=&quot;&quot;;
  phs.forEach(function(ph){
    var row=document.createElement(&quot;div&quot;); row.className=&quot;ph-row&quot;;
    var lab=document.createElement(&quot;label&quot;); lab.textContent=ph;
    var ta=document.createElement(&quot;textarea&quot;); ta.setAttribute(&quot;data-ph&quot;,ph);
    ta.placeholder=ph+&quot;を入力&quot;;
    if(prev[ph]!=null) ta.value=prev[ph];
    row.appendChild(lab); row.appendChild(ta); box.appendChild(row);
  });
  // 日付があれば今日を自動補完（空のときだけ）
  // 日付・日時系プレースホルダは開いた瞬間の値を自動補完（空のときだけ）
  var np=nowParts();
  var autofill={ &quot;日付&quot;:np.date, &quot;日時&quot;:np.datetime, &quot;曜日&quot;:np.weekday, &quot;時刻&quot;:np.time, &quot;今日&quot;:np.date };
  Object.keys(autofill).forEach(function(k){
    var el=box.querySelector('[data-ph=&quot;'+k+'&quot;]');
    if(el &amp;&amp; !el.value){ el.value=autofill[k]; }
  });
}
function tplReadVals(){
  var vals={};
  [].slice.call(document.querySelectorAll(&quot;#tpl_fields [data-ph]&quot;)).forEach(function(el){ vals[el.getAttribute(&quot;data-ph&quot;)]=el.value; });
  return vals;
}
function tplInsertPh(name){
  var ta=document.getElementById(&quot;tpl_body&quot;);
  var tag=&quot;{{&quot;+name+&quot;}}&quot;;
  var s=ta.selectionStart, e=ta.selectionEnd, val=ta.value;
  if(s==null){ ta.value=val+tag; } else { ta.value=val.slice(0,s)+tag+val.slice(e); ta.selectionStart=ta.selectionEnd=s+tag.length; }
  ta.focus(); tplScan();
}

function tplRenderSaved(){
  var all=tplLoadAll(), names=Object.keys(all);
  var wrap=document.getElementById(&quot;tpl_savedList&quot;);
  if(!names.length){ wrap.innerHTML='<span class=&quot;hint&quot; style=&quot;margin:0;&quot;>保存したひな形はまだありません。本文を書いて「保存」してください。</span>'; return; }
  wrap.innerHTML='<span class=&quot;hint&quot; style=&quot;margin:0;&quot;>保存済み：</span>';
  names.forEach(function(nm){
    var chip=document.createElement(&quot;span&quot;); chip.className=&quot;tpl-chip&quot;+(nm===tplCurrentName?&quot; cur&quot;:&quot;&quot;);
    var lbl=document.createElement(&quot;span&quot;); lbl.textContent=nm; lbl.onclick=function(){ tplLoadOne(nm); };
    var x=document.createElement(&quot;span&quot;); x.className=&quot;x&quot;; x.textContent=&quot;×&quot;; x.title=&quot;削除&quot;;
    x.onclick=function(ev){ ev.stopPropagation(); tplDelete(nm); };
    chip.appendChild(lbl); chip.appendChild(x); wrap.appendChild(chip);
  });
}
function tplSave(){
  var name=(v(&quot;tpl_name&quot;)||&quot;&quot;).trim();
  var body=v(&quot;tpl_body&quot;);
  if(!name){ toast(&quot;ひな形の名前を入れてください&quot;); return; }
  if(!body){ toast(&quot;本文を入力してください&quot;); return; }
  var all=tplLoadAll();
  var existed=!!all[name];
  all[name]=body; tplStoreAll(all);
  tplStoreVals(name, tplReadVals()); // 入力値も一緒に保存
  tplCurrentName=name;
  tplRenderSaved();
  toast(existed?&quot;上書き保存しました&quot;:&quot;保存しました&quot;);
}
function tplLoadOne(name){
  var all=tplLoadAll();
  if(all[name]==null) return;
  document.getElementById(&quot;tpl_name&quot;).value=name;
  document.getElementById(&quot;tpl_body&quot;).value=all[name];
  tplCurrentName=name;
  tplScan();
  // 保存済みの入力値を流し込む
  var vals=tplLoadVals(name);
  [].slice.call(document.querySelectorAll(&quot;#tpl_fields [data-ph]&quot;)).forEach(function(el){
    var k=el.getAttribute(&quot;data-ph&quot;); if(vals[k]!=null) el.value=vals[k];
  });
  tplRenderSaved();
  toast(&quot;「&quot;+name+&quot;」を読み込みました&quot;);
}
function tplNew(){
  document.getElementById(&quot;tpl_name&quot;).value=&quot;&quot;;
  document.getElementById(&quot;tpl_body&quot;).value=&quot;&quot;;
  tplCurrentName=&quot;&quot;;
  tplScan(); tplRenderSaved();
}
function tplDelete(name){
  if(window.confirm &amp;&amp; !window.confirm(&quot;「&quot;+name+&quot;」を削除しますか？&quot;)) return;
  var all=tplLoadAll(); delete all[name]; tplStoreAll(all);
  if(lsAvailable()){ try{ window.localStorage.removeItem(TPL_VALS_PREFIX+name); }catch(e){} }
  if(window.__memTplVals) delete window.__memTplVals[name];
  if(tplCurrentName===name) tplCurrentName=&quot;&quot;;
  tplRenderSaved();
  toast(&quot;削除しました&quot;);
}

// 差し込み生成
function buildTplDoc(){
  currentTab=&quot;tpl&quot;;
  var body=v(&quot;tpl_body&quot;);
  if(!body){ toast(&quot;本文がありません&quot;); return; }
  var vals=tplReadVals();
  // 現在のひな形に紐づく入力値も保存
  if(tplCurrentName){ tplStoreVals(tplCurrentName, vals); }
  var out=body.replace(/\{\{\s*([^}]+?)\s*\}\}/g, function(_,k){ k=k.trim(); var x=vals[k]; return (x==null||x===&quot;&quot;)?(&quot;（&quot;+k+&quot;）&quot;):x; });
  setOut(out, out); // テキスト＝Markdownとして同一（自由フォーマットのため）
}

// JSON 書き出し／取り込み
function tplExport(){
  var all=tplLoadAll();
  if(!Object.keys(all).length){ toast(&quot;保存したひな形がありません&quot;); return; }
  // 値も含めてエクスポート
  var valsAll={};
  Object.keys(all).forEach(function(nm){ valsAll[nm]=tplLoadVals(nm); });
  var payload={templates:all, values:valsAll, _type:&quot;usausa_templates&quot;, _ver:1};
  var blob=new Blob([JSON.stringify(payload,null,2)],{type:&quot;application/json&quot;});
  _saveBlob(blob, &quot;日報ひな形_&quot;+today()+&quot;.json&quot;);
  toast(&quot;ひな形をJSONで書き出しました&quot;);
}
function tplImport(input){
  var file=input.files&amp;&amp;input.files[0]; if(!file) return;
  var reader=new FileReader();
  reader.onload=function(){
    try{
      var data=JSON.parse(String(reader.result||&quot;{}&quot;));
      var tpls = data.templates || data; // {templates,values} 形式 or 素の{name:body}
      if(typeof tpls!==&quot;object&quot;){ toast(&quot;形式が不正です&quot;); input.value=&quot;&quot;; return; }
      var all=tplLoadAll();
      var n=0;
      Object.keys(tpls).forEach(function(nm){ if(typeof tpls[nm]===&quot;string&quot;){ all[nm]=tpls[nm]; n++; } });
      tplStoreAll(all);
      if(data.values){ Object.keys(data.values).forEach(function(nm){ tplStoreVals(nm, data.values[nm]||{}); }); }
      tplRenderSaved();
      toast(n+&quot;件のひな形を取り込みました&quot;);
    }catch(e){ toast(&quot;読み込みに失敗しました&quot;); }
    input.value=&quot;&quot;;
  };
  reader.readAsText(file,&quot;UTF-8&quot;);
}

// 生成結果ボタン用：ひな形日報（タブ切替して生成）
function tplDocFromOutput(){
  var tab=[].slice.call(document.querySelectorAll(&quot;.tab&quot;)).filter(function(t){return t.dataset.tab===&quot;tpl&quot;;})[0];
  if(tab) tab.click();
  if(!v(&quot;tpl_body&quot;)){ toast(&quot;先に自由ひな形タブで本文を作ってください&quot;); return; }
  buildTplDoc();
}

// 初回起動時：標準ひな形を登録し、本文欄にも読み込む
var TPL_SEEDED_KEY=&quot;usausa_tpl_seeded_v1&quot;;
function tplDefaultBody(){
  return [
    &quot;【業務日報】{{日付}}　記入時刻 {{時刻}}&quot;,
    &quot;氏名：{{氏名}}&quot;,
    &quot;&quot;,
    &quot;■本日のめあて&quot;,
    &quot;{{めあて}}&quot;,
    &quot;&quot;,
    &quot;■今日やったこと&quot;,
    &quot;{{今日やったこと}}&quot;,
    &quot;&quot;,
    &quot;■できたこと / 気づき（Keep）&quot;,
    &quot;{{できたこと}}&quot;,
    &quot;&quot;,
    &quot;■課題・うまくいかなかったこと（Problem）&quot;,
    &quot;{{課題}}&quot;,
    &quot;&quot;,
    &quot;■明日やること（Try）&quot;,
    &quot;{{明日の予定}}&quot;,
    &quot;&quot;,
    &quot;■相談・共有したいこと&quot;,
    &quot;{{相談}}&quot;,
    &quot;&quot;,
    &quot;■趣味枠（個人開発・記事・インプット）&quot;,
    &quot;{{趣味枠}}&quot;
  ].join(&quot;\n&quot;);
}
function tplSeedDefault(){
  var seeded=false;
  if(lsAvailable()){ try{ seeded = window.localStorage.getItem(TPL_SEEDED_KEY)===&quot;1&quot;; }catch(e){} }
  else { seeded = !!window.__tplSeeded; }
  var all=tplLoadAll();
  var name=&quot;うさうさ日報（曜日つき・標準）&quot;;
  // 初回（seedしておらず、かつ同名が無い）だけ登録
  if(!seeded &amp;&amp; all[name]==null){
    all[name]=tplDefaultBody();
    tplStoreAll(all);
    if(lsAvailable()){ try{ window.localStorage.setItem(TPL_SEEDED_KEY,&quot;1&quot;); }catch(e){} }
    window.__tplSeeded=true;
    // 本文欄が空なら初期表示として読み込む
    if(!v(&quot;tpl_body&quot;)){
      document.getElementById(&quot;tpl_name&quot;).value=name;
      document.getElementById(&quot;tpl_body&quot;).value=all[name];
      tplCurrentName=name;
    }
  }
}

/* ============ メモから月末報告書（タスク別・タグ別の時間集計つき） ============ */
// 1行から所要時間（分）を抽出。「（90分）」「90分」「1h」「1:30」「1時間30分」などに対応
function parseMinutes(line){
  if(!line) return 0;
  var total=0, matched=false;
  // 1時間30分 / 2時間 / 1h（時間＋任意の分）
  var hh=/(\d+(?:\.\d+)?)\s*(?:時間|hr|h|時)/i.exec(line);
  if(hh){ total += Math.round(parseFloat(hh[1])*60); matched=true; }
  // 分（90分 / 45min / 30m）。日本語の「分」は語境界が効かないので \b を使わない
  var mm=/(\d+)\s*(?:分|min|m)(?![a-z])/i.exec(line);
  if(mm){ total += parseInt(mm[1],10); matched=true; }
  // 上で取れなければ 1:30（時:分）形式
  if(!matched){
    var hm=/(\d{1,2}):(\d{2})/.exec(line);
    if(hm){ total += parseInt(hm[1],10)*60+parseInt(hm[2],10); matched=true; }
  }
  return matched? total : 0;
}
// タスク名の正規化（時間表記・タグ・先頭記号を落とす）
function memoTaskName(line){
  var s=line;
  s=s.replace(/[（(]\s*\d+(?:\.\d+)?\s*(?:時間|分|h|hr|min|m)\s*[)）]/gi,&quot;&quot;); // （90分）等の括弧つき
  s=s.replace(/\d{1,2}:\d{2}/g,&quot;&quot;);                 // 1:30
  s=s.replace(/\d+(?:\.\d+)?\s*(?:時間|h|hr|時)\s*(?:\d+\s*(?:分|min|m))?/gi,&quot;&quot;); // 1時間30分/2h
  s=s.replace(/\d+\s*(?:分|min|m)(?![a-z])/gi,&quot;&quot;);          // 90分
  s=normWorkItem(s);                                 // 記号・タグ・状態語除去（既存）
  return s;
}
// メモ全体を解析：{taskMin, tagMin, dates, items}
function analyzeMemo(text){
  var taskMin={}, tagMin={}, dates=[], items=[];
  (text||&quot;&quot;).split(/\r?\n/).forEach(function(raw){
    var line=raw.trim(); if(!line) return;
    // 日付行
    var dm=/(\d{4})\D+(\d{1,2})\D+(\d{1,2})/.exec(line);
    if(dm &amp;&amp; line.replace(/[\d\/\-\.年月日（）\(\)月火水木金土曜\s]/g,&quot;&quot;).length<=2){ dates.push(line); return; }
    // CSV対応：カンマがあればセルごとに見る
    var cells = line.indexOf(&quot;,&quot;)>=0 ? line.split(&quot;,&quot;) : [line];
    cells.forEach(function(c){
      c=c.trim(); if(!c) return;
      var mins=parseMinutes(c);
      var tags=extractTags(c);
      var name=memoTaskName(c);
      if(isMeaningful(name)){
        items.push(name);
        if(mins>0) taskMin[name]=(taskMin[name]||0)+mins;
      }
      // タグ別：タグに時間を割り当て（同一セルの重複タグは1回）
      if(mins>0 &amp;&amp; tags.length){
        var uniqT={}; tags.forEach(function(t){uniqT[t]=1;});
        Object.keys(uniqT).forEach(function(t){ tagMin[t]=(tagMin[t]||0)+mins; });
      }
    });
  });
  return {taskMin:taskMin, tagMin:tagMin, dates:dates, items:items};
}

// メモCSV/テキスト読み込み（貼り付け欄に追記）
function repMemoImport(input){
  var file=input.files&amp;&amp;input.files[0]; if(!file) return;
  var reader=new FileReader();
  reader.onload=function(){
    var text=String(reader.result||&quot;&quot;).replace(/^\uFEFF/,&quot;&quot;);
    var ta=document.getElementById(&quot;rep_memo&quot;);
    ta.value = ta.value ? (ta.value.replace(/\s+$/,&quot;&quot;)+&quot;\n&quot;+text) : text;
    toast(&quot;メモを追記しました&quot;);
    input.value=&quot;&quot;;
  };
  reader.readAsText(file,&quot;UTF-8&quot;);
}

function buildMonthlyReportFromMemo(){
  currentTab=&quot;timetable&quot;;
  var text=v(&quot;rep_memo&quot;);
  if(!text){ toast(&quot;メモを貼り付けてください&quot;); return; }
  var a=analyzeMemo(text);
  var taskKeys=Object.keys(a.taskMin).sort(function(x,y){return a.taskMin[y]-a.taskMin[x];});
  var tagKeys=Object.keys(a.tagMin).sort(function(x,y){return a.tagMin[y]-a.tagMin[x];});
  var totalMin=taskKeys.reduce(function(s,k){return s+a.taskMin[k];},0);
  // やったこと候補（時間なしの作業も含む・重複集約）
  var doneMap={}; a.items.forEach(function(t){ doneMap[t]=(doneMap[t]||0)+1; });
  var doneList=Object.keys(doneMap).sort(function(x,y){return doneMap[y]-doneMap[x];});
  var nDays=a.dates.length;
  var head=(v(&quot;rep_month&quot;)||&quot;&quot;)+&quot; 月末報告書（メモ集計）&quot;;
  var U=ROUND_UNIT||15;
  function pctTask(min){ return totalMin>0? Math.round(min/totalMin*100):0; }

  /* テキスト版 */
  var o=[];
  o.push(BAR); o.push(&quot;📋 &quot;+head); o.push(BAR);
  o.push(&quot;対象：&quot;+(nDays?nDays+&quot;日分&quot;:&quot;メモ&quot;)+&quot;／ 合計時間 &quot;+fmtHM(totalMin));
  o.push(&quot;&quot;);
  if(taskKeys.length){
    o.push(BAR2); o.push(&quot;🧩 タスク別 時間まとめ（多い順）&quot;); o.push(BAR2);
    taskKeys.forEach(function(k){ o.push(&quot;・&quot;+k+&quot;：&quot;+fmtHM(a.taskMin[k])+&quot;（&quot;+a.taskMin[k]+&quot;分・&quot;+pctTask(a.taskMin[k])+&quot;%）&quot;); });
    o.push(&quot;合計：&quot;+fmtHM(totalMin));
    o.push(&quot;&quot;);
  }
  if(tagKeys.length){
    o.push(BAR2); o.push(&quot;🏷 タグ別 時間集計&quot;); o.push(BAR2);
    tagKeys.forEach(function(k){ o.push(&quot;・#&quot;+k+&quot;：&quot;+fmtHM(a.tagMin[k])); });
    o.push(&quot;&quot;);
  }
  o.push(BAR2); o.push(&quot;✅ やったこと&quot;); o.push(BAR2);
  (doneList.length?doneList:[&quot;（メモから抽出できる作業がありませんでした）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;📣 リーダーに伝えたいこと&quot;); o.push(BAR2);
  var leader=lines(v(&quot;rep_leader&quot;));
  (leader.length?leader:[&quot;（特になし）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  var txt=o.join(&quot;\n&quot;);

  /* Markdown版 */
  var m=[];
  m.push(&quot;# 📋 &quot;+head); m.push(&quot;&quot;);
  m.push(&quot;- 対象：&quot;+(nDays?nDays+&quot;日分&quot;:&quot;メモ&quot;)+&quot; ／ 合計時間 &quot;+fmtHM(totalMin)); m.push(&quot;&quot;);
  if(taskKeys.length){
    m.push(&quot;## 🧩 タスク別 時間まとめ&quot;); m.push(&quot;&quot;);
    m.push(&quot;| タスク | 時間 | 分 | 割合 |&quot;);
    m.push(&quot;|---|---|---:|---:|&quot;);
    taskKeys.forEach(function(k){ m.push(&quot;| &quot;+k+&quot; | &quot;+fmtHM(a.taskMin[k])+&quot; | &quot;+a.taskMin[k]+&quot; | &quot;+pctTask(a.taskMin[k])+&quot;% |&quot;); });
    m.push(&quot;| **合計** | **&quot;+fmtHM(totalMin)+&quot;** | **&quot;+totalMin+&quot;** | 100% |&quot;);
    m.push(&quot;&quot;);
  }
  if(tagKeys.length){
    m.push(&quot;## 🏷 タグ別 時間集計&quot;); m.push(&quot;&quot;);
    m.push(&quot;| タグ | 時間 | 分 |&quot;);
    m.push(&quot;|---|---|---:|&quot;);
    tagKeys.forEach(function(k){ m.push(&quot;| #&quot;+k+&quot; | &quot;+fmtHM(a.tagMin[k])+&quot; | &quot;+a.tagMin[k]+&quot; |&quot;); });
    m.push(&quot;&quot;);
  }
  m.push(&quot;## ✅ やったこと&quot;); m.push(&quot;&quot;);
  (doneList.length?doneList:[&quot;（抽出なし）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  m.push(&quot;&quot;);
  m.push(&quot;## 📣 リーダーに伝えたいこと&quot;); m.push(&quot;&quot;);
  (leader.length?leader:[&quot;（特になし）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  var md=m.join(&quot;\n&quot;);

  setOut(txt, md);
}

function buildMonthlyReport(){
  currentTab=&quot;timetable&quot;;
  var from=v(&quot;rep_from&quot;), to=v(&quot;rep_to&quot;);
  var days = (from||to) ? daysInRange(from,to) : loadDays();
  if(!days.length){ toast(&quot;対象期間に保存データがありません&quot;); return; }

  // 集計（選択中の丸め単位・カスタム区分込み）
  var km={lesson:0,meeting:0,work:0}, brk=0, custom={}, tagMin={}, planSum=0, actSum=0, rateSum=0;
  var insCount=0, insMin=0;
  days.forEach(function(d){
    km.lesson+=(d.kindMin&amp;&amp;d.kindMin.lesson)||0;
    km.meeting+=(d.kindMin&amp;&amp;d.kindMin.meeting)||0;
    km.work+=(d.kindMin&amp;&amp;d.kindMin.work)||0;
    brk+=d.breakMin||0;
    if(d.customMin){ Object.keys(d.customMin).forEach(function(k){ custom[k]=(custom[k]||0)+d.customMin[k]; }); }
    // タグ別：各日のコマから積み上げ
    var tm=tagMinutesFromPeriods(d.periods);
    Object.keys(tm).forEach(function(k){ tagMin[k]=(tagMin[k]||0)+tm[k]; });
    // 差し込み対応の集計
    (d.periods||[]).forEach(function(p){ if(p.isInsert &amp;&amp; !(p.kind===&quot;break&quot;||p.isBreak)){ insCount++; insMin+=p.dur||0; } });
    planSum+=d.planMin||0; actSum+=d.actMin||0; rateSum+=d.rate||0;
  });
  var workTotal = km.lesson+km.meeting+km.work + Object.keys(custom).reduce(function(a,k){return a+custom[k];},0);
  var avgRate = Math.round(rateSum/days.length);
  function pct(min){ return workTotal>0 ? Math.round(min/workTotal*100) : 0; }

  // やったこと（各日の実績・作業を集約）／達成したこと（◎コマと達成しためあて）／課題（Problem＋△未達）
  var doneList=[], achievedList=[], issueList=[];
  days.forEach(function(d){
    (d.periods||[]).forEach(function(p){
      if(p.isBreak||p.kind===&quot;break&quot;) return;
      var what=(p.actual||p.plan||&quot;&quot;).trim();
      if(what){
        if(p.status===&quot;◎&quot;){ achievedList.push(what); doneList.push(what); }
        else if(p.status===&quot;○&quot;){ doneList.push(what); }
        else if(p.status===&quot;△&quot;){ issueList.push(what+&quot;（未達）&quot;); doneList.push(what); }
        else { doneList.push(what); }
      }
    });
    if(d.goal &amp;&amp; d.rate>=75) achievedList.push(&quot;【めあて】&quot;+d.goal+&quot;（&quot;+d.date+&quot;）&quot;);
    if(d.problem) issueList.push(d.problem+&quot;（&quot;+d.date+&quot;）&quot;);
  });
  function uniq(arr){ var seen={}, out=[]; arr.forEach(function(x){ if(!seen[x]){seen[x]=1; out.push(x);} }); return out; }
  doneList=uniq(doneList); achievedList=uniq(achievedList); issueList=uniq(issueList);

  var head=(v(&quot;rep_month&quot;)||&quot;&quot;)+&quot; 月末報告書&quot;;
  var period = (from||to) ? ((from||&quot;&quot;)+&quot; 〜 &quot;+(to||&quot;&quot;)) : &quot;保存した全期間&quot;;

  /* テキスト版 */
  var o=[];
  o.push(BAR); o.push(&quot;📋 &quot;+head); o.push(BAR);
  o.push(&quot;対象期間：&quot;+period+&quot;（&quot;+days.length+&quot;日分）&quot;);
  o.push(&quot;平均達成率：&quot;+avgRate+&quot;%&quot;);
  o.push(&quot;&quot;);
  var _ttlink = (typeof isTtLink===&quot;function&quot;) ? isTtLink() : true;
  if(_ttlink){
    o.push(BAR2); o.push(&quot;⏱ 区分別 時間集計（&quot;+unitLabel()+&quot;／&quot;+modeLabel()+&quot;）&quot;); o.push(BAR2);
    o.push(&quot;授業：&quot;+fmt15(km.lesson)+&quot;  &quot;+pct(km.lesson)+&quot;%&quot;);
    o.push(&quot;会議：&quot;+fmt15(km.meeting)+&quot;  &quot;+pct(km.meeting)+&quot;%&quot;);
    o.push(&quot;作業：&quot;+fmt15(km.work)+&quot;  &quot;+pct(km.work)+&quot;%&quot;);
    Object.keys(custom).forEach(function(k){ o.push(k+&quot;：&quot;+fmt15(custom[k])+&quot;  &quot;+pct(custom[k])+&quot;%&quot;); });
    o.push(&quot;（休憩：&quot;+fmt15(brk)+&quot;）&quot;);
    o.push(&quot;稼働合計：&quot;+fmt15(workTotal));
    if(insCount){ o.push(&quot;⚡差し込み対応：&quot;+insCount+&quot;件・&quot;+fmt15(insMin)+&quot;（うち稼働の &quot;+(workTotal?Math.round(insMin/workTotal*100):0)+&quot;%）&quot;); }
    o.push(&quot;&quot;);
    var tagKeysT=Object.keys(tagMin).sort(function(a,b){return tagMin[b]-tagMin[a];});
    if(tagKeysT.length){
      o.push(BAR2); o.push(&quot;🏷 タグ別 時間集計&quot;); o.push(BAR2);
      tagKeysT.forEach(function(k){ o.push(&quot;#&quot;+k+&quot;：&quot;+fmt15(tagMin[k])); });
      o.push(&quot;&quot;);
    }
  } else {
    o.push(&quot;※ 時間割の連携OFF：時間集計は省略しています（時間割タブの🔗連携をONにすると表示）。&quot;);
    o.push(&quot;&quot;);
  }
  o.push(BAR2); o.push(&quot;✅ やったこと&quot;); o.push(BAR2);
  doneList.forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;🎯 達成したこと&quot;); o.push(BAR2);
  (achievedList.length?achievedList:[&quot;（達成度◎のコマがありません）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;⚠ 課題&quot;); o.push(BAR2);
  (issueList.length?issueList:[&quot;（特記事項なし）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;📣 リーダーに伝えたいこと&quot;); o.push(BAR2);
  var leader=lines(v(&quot;rep_leader&quot;));
  (leader.length?leader:[&quot;（特になし）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  var txt=o.join(&quot;\n&quot;);

  /* Markdown版 */
  var m=[];
  m.push(&quot;# 📋 &quot;+head);
  m.push(&quot;&quot;);
  m.push(&quot;- 対象期間：&quot;+period+&quot;（&quot;+days.length+&quot;日分）&quot;);
  m.push(&quot;- 平均達成率：&quot;+avgRate+&quot;%&quot;);
  m.push(&quot;&quot;);
  var U=ROUND_UNIT||15;
  if(_ttlink){
    m.push(&quot;## ⏱ 区分別 時間集計（&quot;+unitLabel()+&quot;／&quot;+modeLabel()+&quot;）&quot;);
    m.push(&quot;&quot;);
    m.push(&quot;| 区分 | 時間 | コマ(&quot;+U+&quot;分) | 割合 |&quot;);
    m.push(&quot;|---|---|---:|---:|&quot;);
    m.push(&quot;| 授業 | &quot;+fmtHM(km.lesson)+&quot; | &quot;+Math.round(km.lesson/U)+&quot; | &quot;+pct(km.lesson)+&quot;% |&quot;);
    m.push(&quot;| 会議 | &quot;+fmtHM(km.meeting)+&quot; | &quot;+Math.round(km.meeting/U)+&quot; | &quot;+pct(km.meeting)+&quot;% |&quot;);
    m.push(&quot;| 作業 | &quot;+fmtHM(km.work)+&quot; | &quot;+Math.round(km.work/U)+&quot; | &quot;+pct(km.work)+&quot;% |&quot;);
    Object.keys(custom).forEach(function(k){ m.push(&quot;| &quot;+k+&quot; | &quot;+fmtHM(custom[k])+&quot; | &quot;+Math.round(custom[k]/U)+&quot; | &quot;+pct(custom[k])+&quot;% |&quot;); });
    m.push(&quot;| （休憩） | &quot;+fmtHM(brk)+&quot; | &quot;+Math.round(brk/U)+&quot; | — |&quot;);
    m.push(&quot;| **稼働合計** | **&quot;+fmtHM(workTotal)+&quot;** | **&quot;+Math.round(workTotal/U)+&quot;** | 100% |&quot;);
    if(insCount){ m.push(&quot;&quot;); m.push(&quot;**⚡差し込み対応**：&quot;+insCount+&quot;件・&quot;+fmtHM(insMin)+&quot;（稼働の &quot;+(workTotal?Math.round(insMin/workTotal*100):0)+&quot;%）&quot;); }
    m.push(&quot;&quot;);
    var tagKeysM=Object.keys(tagMin).sort(function(a,b){return tagMin[b]-tagMin[a];});
    if(tagKeysM.length){
      m.push(&quot;## 🏷 タグ別 時間集計&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;| タグ | 時間 | コマ(&quot;+U+&quot;分) |&quot;);
      m.push(&quot;|---|---|---:|&quot;);
      tagKeysM.forEach(function(k){ m.push(&quot;| #&quot;+k+&quot; | &quot;+fmtHM(tagMin[k])+&quot; | &quot;+Math.round(tagMin[k]/U)+&quot; |&quot;); });
      m.push(&quot;&quot;);
    }
  } else {
    m.push(&quot;> ※ 時間割の連携OFF：時間集計は省略しています（時間割タブの🔗連携をONにすると表示）。&quot;);
    m.push(&quot;&quot;);
  }
  m.push(&quot;## ✅ やったこと&quot;);
  m.push(&quot;&quot;);
  doneList.forEach(function(x){ m.push(&quot;- &quot;+x); });
  m.push(&quot;&quot;);
  m.push(&quot;## 🎯 達成したこと&quot;);
  m.push(&quot;&quot;);
  (achievedList.length?achievedList:[&quot;（達成度◎のコマがありません）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  m.push(&quot;&quot;);
  m.push(&quot;## ⚠ 課題&quot;);
  m.push(&quot;&quot;);
  (issueList.length?issueList:[&quot;（特記事項なし）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  m.push(&quot;&quot;);
  m.push(&quot;## 📣 リーダーに伝えたいこと&quot;);
  m.push(&quot;&quot;);
  (leader.length?leader:[&quot;（特になし）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  var md=m.join(&quot;\n&quot;);

  setOut(txt, md);
}

/* ---- 週次振り返り（自分用・直近7日） ---- */
function buildWeeklyReview(){
  currentTab=&quot;timetable&quot;;
  var all=loadDays().slice();
  if(!all.length){ toast(&quot;保存データがありません&quot;); return; }
  // 日付キーでソートし、最新日から7日ウィンドウを対象に
  all.sort(function(a,b){ var ka=dateKey(a.date), kb=dateKey(b.date); return (ka||0)-(kb||0); });
  var latest=all[all.length-1];
  var lk=dateKey(latest.date);
  var days;
  if(lk!=null){
    var fromK=lk-6; // 同月内のざっくり7日ウィンドウ
    days=all.filter(function(d){ var k=dateKey(d.date); return k==null?false:(k<=lk &amp;&amp; k>=fromK); });
    if(days.length<1) days=all.slice(-7);
  } else {
    days=all.slice(-7);
  }

  // 集計
  var km={lesson:0,meeting:0,work:0}, brk=0, custom={}, tagMin={}, rateSum=0;
  var goodList=[], learnList=[], notWellList=[], tryList=[];
  days.forEach(function(d){
    km.lesson+=(d.kindMin&amp;&amp;d.kindMin.lesson)||0;
    km.meeting+=(d.kindMin&amp;&amp;d.kindMin.meeting)||0;
    km.work+=(d.kindMin&amp;&amp;d.kindMin.work)||0;
    brk+=d.breakMin||0;
    if(d.customMin){ Object.keys(d.customMin).forEach(function(k){ custom[k]=(custom[k]||0)+d.customMin[k]; }); }
    var tm=tagMinutesFromPeriods(d.periods);
    Object.keys(tm).forEach(function(k){ tagMin[k]=(tagMin[k]||0)+tm[k]; });
    rateSum+=d.rate||0;
    // できたこと=Keep、気づき=goal達成や◎、うまくいかない=Problem/△、来週=Try
    if(d.keep) goodList.push(d.keep+&quot;（&quot;+d.date+&quot;）&quot;);
    if(d.goal &amp;&amp; d.rate>=75) goodList.push(&quot;【めあて達成】&quot;+d.goal+&quot;（&quot;+d.date+&quot;）&quot;);
    if(d.tryv) tryList.push(d.tryv+&quot;（&quot;+d.date+&quot;）&quot;);
    if(d.problem) notWellList.push(d.problem+&quot;（&quot;+d.date+&quot;）&quot;);
    (d.periods||[]).forEach(function(p){
      if(p.kind===&quot;break&quot;||p.isBreak) return;
      var what=(p.actual||p.plan||&quot;&quot;).trim();
      if(!what) return;
      if(p.status===&quot;◎&quot;) learnList.push(what);
      else if(p.status===&quot;△&quot;) notWellList.push(what+&quot;（未達）&quot;);
    });
  });
  function uniq(a){ var s={},o=[]; a.forEach(function(x){ if(!s[x]){s[x]=1;o.push(x);} }); return o; }
  goodList=uniq(goodList); learnList=uniq(learnList); notWellList=uniq(notWellList); tryList=uniq(tryList);
  var avgRate=Math.round(rateSum/days.length);
  var workTotal=km.lesson+km.meeting+km.work+Object.keys(custom).reduce(function(a,k){return a+custom[k];},0);
  var period=days[0].date+&quot; 〜 &quot;+days[days.length-1].date;

  /* テキスト版 */
  var o=[];
  o.push(BAR); o.push(&quot;🗓 週次振り返り（自分用）&quot;); o.push(BAR);
  o.push(&quot;対象：&quot;+period+&quot;（&quot;+days.length+&quot;日分）／ 平均達成率 &quot;+avgRate+&quot;%&quot;);
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;⏱ 今週の時間の使い方（&quot;+unitLabel()+&quot;）&quot;); o.push(BAR2);
  o.push(&quot;授業 &quot;+fmtHM(km.lesson)+&quot; ／ 会議 &quot;+fmtHM(km.meeting)+&quot; ／ 作業 &quot;+fmtHM(km.work)+(Object.keys(custom).length?(&quot; ／ &quot;+Object.keys(custom).map(function(k){return k+&quot; &quot;+fmtHM(custom[k]);}).join(&quot; ／ &quot;)):&quot;&quot;));
  o.push(&quot;稼働合計 &quot;+fmtHM(workTotal)+&quot;（休憩 &quot;+fmtHM(brk)+&quot;）&quot;);
  var tagKeys=Object.keys(tagMin).sort(function(a,b){return tagMin[b]-tagMin[a];});
  if(tagKeys.length){ o.push(&quot;タグ別：&quot;+tagKeys.slice(0,8).map(function(k){return &quot;#&quot;+k+&quot; &quot;+fmtHM(tagMin[k]);}).join(&quot; ／ &quot;)); }
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;😊 できたこと・続けたいこと（Keep）&quot;); o.push(BAR2);
  (goodList.length?goodList:[&quot;（記録なし）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;💡 気づき・学び&quot;); o.push(BAR2);
  (learnList.length?learnList.slice(0,12):[&quot;（達成度◎の作業なし）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;🌧 うまくいかなかったこと（Problem）&quot;); o.push(BAR2);
  (notWellList.length?notWellList:[&quot;（特になし）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;🌱 来週やってみること（Try）&quot;); o.push(BAR2);
  (tryList.length?tryList:[&quot;（来週のTryを書こう）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  var txt=o.join(&quot;\n&quot;);

  /* Markdown版 */
  var m=[];
  m.push(&quot;# 🗓 週次振り返り（自分用）&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;- 対象：&quot;+period+&quot;（&quot;+days.length+&quot;日分）&quot;);
  m.push(&quot;- 平均達成率：&quot;+avgRate+&quot;%&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;## ⏱ 今週の時間の使い方（&quot;+unitLabel()+&quot;）&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;| 区分 | 時間 |&quot;);
  m.push(&quot;|---|---|&quot;);
  m.push(&quot;| 授業 | &quot;+fmtHM(km.lesson)+&quot; |&quot;);
  m.push(&quot;| 会議 | &quot;+fmtHM(km.meeting)+&quot; |&quot;);
  m.push(&quot;| 作業 | &quot;+fmtHM(km.work)+&quot; |&quot;);
  Object.keys(custom).forEach(function(k){ m.push(&quot;| &quot;+k+&quot; | &quot;+fmtHM(custom[k])+&quot; |&quot;); });
  m.push(&quot;| 稼働合計 | &quot;+fmtHM(workTotal)+&quot; |&quot;);
  if(tagKeys.length){
    m.push(&quot;&quot;);
    m.push(&quot;**タグ別**：&quot;+tagKeys.slice(0,8).map(function(k){return &quot;#&quot;+k+&quot; &quot;+fmtHM(tagMin[k]);}).join(&quot; / &quot;));
  }
  m.push(&quot;&quot;);
  m.push(&quot;## 😊 できたこと・続けたいこと（Keep）&quot;);
  m.push(&quot;&quot;);
  (goodList.length?goodList:[&quot;（記録なし）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  m.push(&quot;&quot;);
  m.push(&quot;## 💡 気づき・学び&quot;);
  m.push(&quot;&quot;);
  (learnList.length?learnList.slice(0,12):[&quot;（達成度◎の作業なし）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  m.push(&quot;&quot;);
  m.push(&quot;## 🌧 うまくいかなかったこと（Problem）&quot;);
  m.push(&quot;&quot;);
  (notWellList.length?notWellList:[&quot;（特になし）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  m.push(&quot;&quot;);
  m.push(&quot;## 🌱 来週やってみること（Try）&quot;);
  m.push(&quot;&quot;);
  (tryList.length?tryList:[&quot;（来週のTryを書こう）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  var md=m.join(&quot;\n&quot;);

  setOut(txt, md);
}

/* ---- 個人用カイゼンMTG（KPTC＋趣味枠・直近7日） ---- */
function buildKaizenMTG(){
  currentTab=&quot;timetable&quot;;
  var all=loadDays().slice();
  all.sort(function(a,b){ var ka=dateKey(a.date), kb=dateKey(b.date); return (ka||0)-(kb||0); });
  // 直近7日ウィンドウ（週次と同じロジック）
  var days=[];
  if(all.length){
    var lk=dateKey(all[all.length-1].date);
    if(lk!=null){ days=all.filter(function(d){ var k=dateKey(d.date); return k!=null &amp;&amp; k<=lk &amp;&amp; k>=lk-6; }); }
    if(!days.length) days=all.slice(-7);
  }

  var keepList=[], tryList=[], problemList=[], goodWork=[];
  var rateSum=0;
  days.forEach(function(d){
    rateSum+=d.rate||0;
    if(d.keep) keepList.push(d.keep+&quot;（&quot;+d.date+&quot;）&quot;);
    if(d.goal &amp;&amp; d.rate>=75) keepList.push(&quot;【めあて達成】&quot;+d.goal+&quot;（&quot;+d.date+&quot;）&quot;);
    if(d.tryv) tryList.push(d.tryv+&quot;（&quot;+d.date+&quot;）&quot;);
    if(d.problem) problemList.push(d.problem+&quot;（&quot;+d.date+&quot;）&quot;);
    (d.periods||[]).forEach(function(p){
      if(p.kind===&quot;break&quot;||p.isBreak) return;
      var what=(p.actual||p.plan||&quot;&quot;).trim(); if(!what) return;
      if(p.status===&quot;◎&quot;) goodWork.push(what);
      else if(p.status===&quot;△&quot;) problemList.push(what+&quot;（未達）&quot;);
    });
  });
  function uniq(a){ var s={},o=[]; a.forEach(function(x){ if(!s[x]){s[x]=1;o.push(x);} }); return o; }
  keepList=uniq(keepList); tryList=uniq(tryList); problemList=uniq(problemList); goodWork=uniq(goodWork);
  var hobby=lines(v(&quot;kz_hobby&quot;));
  var change=lines(v(&quot;kz_change&quot;));
  var avgRate=days.length?Math.round(rateSum/days.length):0;
  var period=days.length?(days[0].date+&quot; 〜 &quot;+days[days.length-1].date):&quot;（保存ログなし）&quot;;

  /* テキスト版 */
  var o=[];
  o.push(BAR); o.push(&quot;🛠 個人用カイゼンMTG（KPTC）&quot;); o.push(BAR);
  o.push(&quot;対象：&quot;+period+(days.length?(&quot;（&quot;+days.length+&quot;日分）／ 平均達成率 &quot;+avgRate+&quot;%&quot;):&quot;&quot;));
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;✅ Keep（続けること・うまくいったこと）&quot;); o.push(BAR2);
  var keeps=keepList.concat(goodWork.slice(0,8).map(function(x){return x;}));
  (keeps.length?uniq(keeps):[&quot;（記録なし）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;🌱 Try（次に試すこと）&quot;); o.push(BAR2);
  (tryList.length?tryList:[&quot;（試したいことを書こう）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;🔄 Change（やめる・変えること）&quot;); o.push(BAR2);
  var changes=change.concat(problemList.map(function(x){return &quot;課題から→ &quot;+x;}));
  (changes.length?changes:[&quot;（やめる/変えることを書こう）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;🎨 趣味枠（個人開発・記事・インプット）&quot;); o.push(BAR2);
  (hobby.length?hobby:[&quot;（今週の趣味・学びを書こう）&quot;]).forEach(function(x){ o.push(&quot;・&quot;+x); });
  o.push(&quot;&quot;);
  o.push(&quot;🐰 うさうさ先生：完璧じゃなくていい。Keepを1つ残せたら、それが前進です。&quot;);
  var txt=o.join(&quot;\n&quot;);

  /* Markdown版 */
  var m=[];
  m.push(&quot;# 🛠 個人用カイゼンMTG（KPTC）&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;- 対象：&quot;+period+(days.length?(&quot;（&quot;+days.length+&quot;日分・平均達成率 &quot;+avgRate+&quot;%）&quot;):&quot;&quot;));
  m.push(&quot;&quot;);
  m.push(&quot;## ✅ Keep（続けること）&quot;);
  m.push(&quot;&quot;);
  (keeps.length?uniq(keeps):[&quot;（記録なし）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  m.push(&quot;&quot;);
  m.push(&quot;## 🌱 Try（次に試すこと）&quot;);
  m.push(&quot;&quot;);
  (tryList.length?tryList:[&quot;（試したいことを書こう）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  m.push(&quot;&quot;);
  m.push(&quot;## 🔄 Change（やめる・変えること）&quot;);
  m.push(&quot;&quot;);
  (changes.length?changes:[&quot;（やめる/変えることを書こう）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  m.push(&quot;&quot;);
  m.push(&quot;## 🎨 趣味枠（個人開発・記事・インプット）&quot;);
  m.push(&quot;&quot;);
  (hobby.length?hobby:[&quot;（今週の趣味・学びを書こう）&quot;]).forEach(function(x){ m.push(&quot;- &quot;+x); });
  m.push(&quot;&quot;);
  m.push(&quot;> 🐰 完璧じゃなくていい。Keepを1つ残せたら、それが前進です。&quot;);
  var md=m.join(&quot;\n&quot;);

  setOut(txt, md);
}

function renderDayList(){
  var info=aggregateDays();
  var list=document.getElementById(&quot;dayList&quot;);
  var ap=document.getElementById(&quot;aggPanel&quot;);
  if(!info.count){
    list.innerHTML='<div class=&quot;empty&quot;>まだ保存された日がありません。</div>';
    ap.style.display=&quot;none&quot;;
    return;
  }
  ap.style.display=&quot;block&quot;;
  document.getElementById(&quot;a_lesson&quot;).textContent=fmtHM(info.agg.lesson);
  document.getElementById(&quot;a_meeting&quot;).textContent=fmtHM(info.agg.meeting);
  document.getElementById(&quot;a_work&quot;).textContent=fmtHM(info.agg.work);
  document.getElementById(&quot;a_break&quot;).textContent=fmtHM(info.agg.brk);
  document.getElementById(&quot;a_meta&quot;).textContent=&quot;保存日数 &quot;+info.count+&quot;日 ／ 平均達成率 &quot;+info.avgRate+&quot;%&quot;;

  var html=&quot;&quot;;
  info.days.slice(-30).reverse().forEach(function(d){
    var safe=encodeURIComponent(d.date);
    html+='<div class=&quot;day-item&quot;>'+
      '<div><strong>'+_xmlEsc(d.date)+'</strong> <span class=&quot;meta&quot;>達成率 '+d.rate+'% ／ 授業'+fmtHM((d.kindMin&amp;&amp;d.kindMin.lesson)||0)+'・会議'+fmtHM((d.kindMin&amp;&amp;d.kindMin.meeting)||0)+'・作業'+fmtHM((d.kindMin&amp;&amp;d.kindMin.work)||0)+'</span></div>'+
      '<button class=&quot;mini-btn&quot; onclick=&quot;loadDayToForm(decodeURIComponent(\''+safe+'\'))&quot;>読込</button>'+
      '<button class=&quot;mini-btn del&quot; onclick=&quot;deleteDay(decodeURIComponent(\''+safe+'\'))&quot;>削除</button>'+
    '</div>';
  });
  list.innerHTML=html;
}

/* ---- 最小XLSXライタ（依存ゼロ・ZIP STORE） ---- */
function _crc32(bytes){
  var table=_crc32.t || (_crc32.t=(function(){var t=[],c;for(var n=0;n<256;n++){c=n;for(var k=0;k<8;k++){c=(c&amp;1)?(0xEDB88320^(c>>>1)):(c>>>1);}t[n]=c>>>0;}return t;})());
  var crc=0xFFFFFFFF;
  for(var i=0;i<bytes.length;i++){ crc=(crc>>>8)^table[(crc^bytes[i])&amp;0xFF]; }
  return (crc^0xFFFFFFFF)>>>0;
}
function _sb(s){ return new TextEncoder().encode(s); }
function _u16(n){ return [n&amp;0xFF,(n>>>8)&amp;0xFF]; }
function _u32(n){ return [n&amp;0xFF,(n>>>8)&amp;0xFF,(n>>>16)&amp;0xFF,(n>>>24)&amp;0xFF]; }
function _zipStore(files){
  var locals=[], central=[], offset=0;
  files.forEach(function(f){
    var nameB=_sb(f.name), crc=_crc32(f.data), size=f.data.length;
    var lh=[].concat(_u32(0x04034b50),_u16(20),_u16(0),_u16(0),_u16(0),_u16(0),_u32(crc),_u32(size),_u32(size),_u16(nameB.length),_u16(0));
    var local=new Uint8Array(lh.length+nameB.length+size);
    local.set(lh,0); local.set(nameB,lh.length); local.set(f.data,lh.length+nameB.length);
    locals.push(local);
    var ch=[].concat(_u32(0x02014b50),_u16(20),_u16(20),_u16(0),_u16(0),_u16(0),_u16(0),_u32(crc),_u32(size),_u32(size),_u16(nameB.length),_u16(0),_u16(0),_u16(0),_u16(0),_u32(0),_u32(offset));
    var cent=new Uint8Array(ch.length+nameB.length); cent.set(ch,0); cent.set(nameB,ch.length);
    central.push(cent); offset+=local.length;
  });
  var cdSize=central.reduce(function(a,b){return a+b.length;},0);
  var eocd=new Uint8Array([].concat(_u32(0x06054b50),_u16(0),_u16(0),_u16(files.length),_u16(files.length),_u32(cdSize),_u32(offset),_u16(0)));
  var total=locals.reduce(function(a,b){return a+b.length;},0)+cdSize+eocd.length;
  var out=new Uint8Array(total), p=0;
  locals.forEach(function(l){ out.set(l,p); p+=l.length; });
  central.forEach(function(c){ out.set(c,p); p+=c.length; });
  out.set(eocd,p); return out;
}
function _xmlEsc(s){ return String(s).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;).replace(/&quot;/g,&quot;&amp;quot;&quot;); }
function _col(i){ var s=&quot;&quot;; i++; while(i>0){ var m=(i-1)%26; s=String.fromCharCode(65+m)+s; i=Math.floor((i-1)/26);} return s; }
function _sheetXml(rows){
  var sd=&quot;&quot;;
  rows.forEach(function(row,ri){
    var cells=&quot;&quot;;
    row.forEach(function(cell,ci){
      if(cell==null||cell.v===&quot;&quot;||cell.v==null) return;
      var ref=_col(ci)+(ri+1);
      if(cell.t===&quot;n&quot;){ cells+='<c r=&quot;'+ref+'&quot;><v>'+cell.v+'</v></c>'; }
      else { cells+='<c r=&quot;'+ref+'&quot; t=&quot;inlineStr&quot;><is><t xml:space=&quot;preserve&quot;>'+_xmlEsc(cell.v)+'</t></is></c>'; }
    });
    sd+='<row r=&quot;'+(ri+1)+'&quot;>'+cells+'</row>';
  });
  return '<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><worksheet xmlns=&quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot;><sheetData>'+sd+'</sheetData></worksheet>';
}
function _buildXlsx(sheets){
  var files=[];
  var ct='<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Types xmlns=&quot;http://schemas.openxmlformats.org/package/2006/content-types&quot;>'+
    '<Default Extension=&quot;rels&quot; ContentType=&quot;application/vnd.openxmlformats-package.relationships+xml&quot;/>'+
    '<Default Extension=&quot;xml&quot; ContentType=&quot;application/xml&quot;/>'+
    '<Override PartName=&quot;/xl/workbook.xml&quot; ContentType=&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml&quot;/>';
  sheets.forEach(function(s,i){ ct+='<Override PartName=&quot;/xl/worksheets/sheet'+(i+1)+'.xml&quot; ContentType=&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml&quot;/>'; });
  ct+='</Types>';
  files.push({name:&quot;[Content_Types].xml&quot;, data:_sb(ct)});
  files.push({name:&quot;_rels/.rels&quot;, data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Relationships xmlns=&quot;http://schemas.openxmlformats.org/package/2006/relationships&quot;><Relationship Id=&quot;rId1&quot; Type=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument&quot; Target=&quot;xl/workbook.xml&quot;/></Relationships>')});
  var wbSheets=&quot;&quot;, wbRels=&quot;&quot;;
  sheets.forEach(function(s,i){
    wbSheets+='<sheet name=&quot;'+_xmlEsc(s.name)+'&quot; sheetId=&quot;'+(i+1)+'&quot; r:id=&quot;rId'+(i+1)+'&quot;/>';
    wbRels+='<Relationship Id=&quot;rId'+(i+1)+'&quot; Type=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet&quot; Target=&quot;worksheets/sheet'+(i+1)+'.xml&quot;/>';
  });
  files.push({name:&quot;xl/workbook.xml&quot;, data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><workbook xmlns=&quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot; xmlns:r=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships&quot;><sheets>'+wbSheets+'</sheets></workbook>')});
  files.push({name:&quot;xl/_rels/workbook.xml.rels&quot;, data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Relationships xmlns=&quot;http://schemas.openxmlformats.org/package/2006/relationships&quot;>'+wbRels+'</Relationships>')});
  sheets.forEach(function(s,i){ files.push({name:&quot;xl/worksheets/sheet&quot;+(i+1)+&quot;.xml&quot;, data:_sb(_sheetXml(s.rows))}); });
  return _zipStore(files);
}
function _S(v){return {v:(v==null?&quot;&quot;:v),t:&quot;s&quot;};}
function _N(v){return {v:(v==null||v===&quot;&quot;?&quot;&quot;:v),t:&quot;n&quot;};}

/* ===== 月末報告書 Excel（タスク工数・丸め単位はROUND_UNITに統一） ===== */
// 選択中の単位でのコマ換算（切り上げ：1単位未満でも1コマ計上）
function unitMin(){ return ROUND_UNIT||15; }              // 1コマの分数（5/10/15/30/60）
function toUnits(min){ var u=unitMin(); return Math.ceil((min||0)/u); } // コマ数
function unitColLabel(){ return unitLabel().replace(&quot;単位&quot;,&quot;&quot;)+&quot;コマ&quot;; } // 列名「15分コマ」「1時間コマ」など
// 後方互換：旧名 toQuarter は現在の単位で換算
function toQuarter(min){ return toUnits(min); }

// 保存ログ版：タスク（＝コマの実績/予定テキスト）×日付で工数レコードを作る
function exportMonthlyXlsx(){
  var from=v(&quot;rep_from&quot;), to=v(&quot;rep_to&quot;);
  var days = (from||to) ? daysInRange(from,to) : loadDays();
  if(!days.length){ toast(&quot;対象期間に保存データがありません&quot;); return; }
  days=days.slice().sort(function(a,b){return (dateKey(a.date)||0)-(dateKey(b.date)||0);});

  // タスクレコード：1コマ=1行（日付・タスク名・区分・分・コマ）
  var COL=unitColLabel();
  var rec=[[_S(&quot;日付&quot;),_S(&quot;タスク&quot;),_S(&quot;区分&quot;),_S(&quot;分&quot;),_S(COL),_S(&quot;達成&quot;)]];
  var taskAgg={}; // タスク名 -> 合計分
  var dayAgg={};  // 日付 -> 合計分
  days.forEach(function(d){
    (d.periods||[]).forEach(function(p){
      if(p.kind===&quot;break&quot;||p.isBreak) return;
      var rawName=(p.actual||p.plan||&quot;&quot;).trim(); if(!rawName) return;
      var name=rawName.replace(/[#＃]\S+/g,&quot;&quot;).replace(/\s+/g,&quot; &quot;).trim() || rawName; // タグ除去（空になれば元のまま）
      var mins=p.dur||0;
      rec.push([_S(d.date),_S(name),_S(p.kindLabel||&quot;&quot;),_N(mins),_N(toUnits(mins)),_S(p.status||&quot;&quot;)]);
      taskAgg[name]=(taskAgg[name]||0)+mins;
      dayAgg[d.date]=(dayAgg[d.date]||0)+mins;
    });
  });
  if(rec.length<=1){ toast(&quot;タスク（実績/予定）が入ったコマがありません&quot;); return; }

  // タスク別 月次集計（選択中の丸め単位）
  var taskKeys=Object.keys(taskAgg).sort(function(a,b){return taskAgg[b]-taskAgg[a];});
  var totalMin=taskKeys.reduce(function(s,k){return s+taskAgg[k];},0);
  var s_task=[[_S(&quot;タスク&quot;),_S(&quot;合計分&quot;),_S(&quot;時間&quot;),_S(COL),_S(&quot;割合%&quot;)]];
  taskKeys.forEach(function(k){
    s_task.push([_S(k),_N(taskAgg[k]),_S(fmtHM(taskAgg[k])),_N(toUnits(taskAgg[k])),_N(totalMin?Math.round(taskAgg[k]/totalMin*100):0)]);
  });
  s_task.push([_S(&quot;合計&quot;),_N(totalMin),_S(fmtHM(totalMin)),_N(toUnits(totalMin)),_N(100)]);

  // 日別工数
  var s_day=[[_S(&quot;日付&quot;),_S(&quot;合計分&quot;),_S(&quot;時間&quot;),_S(COL)]];
  Object.keys(dayAgg).sort(function(a,b){return (dateKey(a)||0)-(dateKey(b)||0);}).forEach(function(dt){
    s_day.push([_S(dt),_N(dayAgg[dt]),_S(fmtHM(dayAgg[dt])),_N(toUnits(dayAgg[dt]))]);
  });

  // タグ別
  var tagAll={};
  days.forEach(function(d){ var tm=tagMinutesFromPeriods(d.periods); Object.keys(tm).forEach(function(k){ tagAll[k]=(tagAll[k]||0)+tm[k]; }); });
  var tagKeys=Object.keys(tagAll).sort(function(a,b){return tagAll[b]-tagAll[a];});
  var s_tag=[[_S(&quot;タグ&quot;),_S(&quot;合計分&quot;),_S(&quot;時間&quot;),_S(COL)]];
  if(tagKeys.length){ tagKeys.forEach(function(k){ s_tag.push([_S(&quot;#&quot;+k),_N(tagAll[k]),_S(fmtHM(tagAll[k])),_N(toUnits(tagAll[k]))]); }); }
  else { s_tag.push([_S(&quot;（タグなし）&quot;),_S(&quot;&quot;),_S(&quot;&quot;),_S(&quot;&quot;)]); }

  var buf=_buildXlsx([
    {name:&quot;タスク工数レコード&quot;,rows:rec},
    {name:&quot;タスク別月次集計&quot;,rows:s_task},
    {name:&quot;日別工数&quot;,rows:s_day},
    {name:&quot;タグ別集計&quot;,rows:s_tag}
  ]);
  _saveBlob(new Blob([buf],{type:&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet&quot;}), &quot;月末報告書_&quot;+today()+&quot;.xlsx&quot;);
  toast(&quot;月末報告書をExcelで出力しました（&quot;+(rec.length-1)+&quot;レコード・&quot;+unitLabel()+&quot;）&quot;);
}

// メモ版：貼り付けメモからタスク工数Excelを作る
function exportMonthlyXlsxFromMemo(){
  var text=v(&quot;rep_memo&quot;);
  if(!text){ toast(&quot;メモを貼り付けてください&quot;); return; }
  // 日付つきで1行ずつレコード化（analyzeMemoは合算なので、ここは行単位で再走査）
  var COL=unitColLabel();
  var rec=[[_S(&quot;日付&quot;),_S(&quot;タスク&quot;),_S(&quot;分&quot;),_S(COL),_S(&quot;タグ&quot;)]];
  var taskAgg={}, tagAll={}, dayAgg={}, curDate=&quot;&quot;;
  (text||&quot;&quot;).split(/\r?\n/).forEach(function(raw){
    var line=raw.trim(); if(!line) return;
    var dm=/(\d{4})\D+(\d{1,2})\D+(\d{1,2})/.exec(line);
    if(dm &amp;&amp; line.replace(/[\d\/\-\.年月日（）\(\)月火水木金土曜\s]/g,&quot;&quot;).length<=2){ curDate=line; return; }
    var cells = line.indexOf(&quot;,&quot;)>=0 ? line.split(&quot;,&quot;) : [line];
    cells.forEach(function(c){
      c=c.trim(); if(!c) return;
      var mins=parseMinutes(c), name=memoTaskName(c), tags=extractTags(c);
      if(!isMeaningful(name)) return;
      rec.push([_S(curDate),_S(name),_N(mins),_N(toUnits(mins)),_S(tags.map(function(t){return &quot;#&quot;+t;}).join(&quot; &quot;))]);
      if(mins>0){
        taskAgg[name]=(taskAgg[name]||0)+mins;
        if(curDate) dayAgg[curDate]=(dayAgg[curDate]||0)+mins;
        var uq={}; tags.forEach(function(t){uq[t]=1;});
        Object.keys(uq).forEach(function(t){ tagAll[t]=(tagAll[t]||0)+mins; });
      }
    });
  });
  if(rec.length<=1){ toast(&quot;メモからタスクを抽出できませんでした&quot;); return; }

  var taskKeys=Object.keys(taskAgg).sort(function(a,b){return taskAgg[b]-taskAgg[a];});
  var totalMin=taskKeys.reduce(function(s,k){return s+taskAgg[k];},0);
  var s_task=[[_S(&quot;タスク&quot;),_S(&quot;合計分&quot;),_S(&quot;時間&quot;),_S(COL),_S(&quot;割合%&quot;)]];
  taskKeys.forEach(function(k){ s_task.push([_S(k),_N(taskAgg[k]),_S(fmtHM(taskAgg[k])),_N(toUnits(taskAgg[k])),_N(totalMin?Math.round(taskAgg[k]/totalMin*100):0)]); });
  s_task.push([_S(&quot;合計&quot;),_N(totalMin),_S(fmtHM(totalMin)),_N(toUnits(totalMin)),_N(totalMin?100:0)]);

  var s_day=[[_S(&quot;日付&quot;),_S(&quot;合計分&quot;),_S(&quot;時間&quot;),_S(COL)]];
  Object.keys(dayAgg).sort(function(a,b){return (dateKey(a)||0)-(dateKey(b)||0);}).forEach(function(dt){ s_day.push([_S(dt),_N(dayAgg[dt]),_S(fmtHM(dayAgg[dt])),_N(toUnits(dayAgg[dt]))]); });

  var tagKeys=Object.keys(tagAll).sort(function(a,b){return tagAll[b]-tagAll[a];});
  var s_tag=[[_S(&quot;タグ&quot;),_S(&quot;合計分&quot;),_S(&quot;時間&quot;),_S(COL)]];
  if(tagKeys.length){ tagKeys.forEach(function(k){ s_tag.push([_S(&quot;#&quot;+k),_N(tagAll[k]),_S(fmtHM(tagAll[k])),_N(toUnits(tagAll[k]))]); }); }
  else { s_tag.push([_S(&quot;（タグなし）&quot;),_S(&quot;&quot;),_S(&quot;&quot;),_S(&quot;&quot;)]); }

  var buf=_buildXlsx([
    {name:&quot;タスク工数レコード&quot;,rows:rec},
    {name:&quot;タスク別月次集計&quot;,rows:s_task},
    {name:&quot;日別工数&quot;,rows:s_day},
    {name:&quot;タグ別集計&quot;,rows:s_tag}
  ]);
  _saveBlob(new Blob([buf],{type:&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet&quot;}), &quot;月末報告書_メモ_&quot;+today()+&quot;.xlsx&quot;);
  toast(&quot;メモから月末報告書Excelを出力しました（&quot;+(rec.length-1)+&quot;レコード・&quot;+unitLabel()+&quot;）&quot;);
}

function exportXlsx(){
  var days=loadDays();
  if(!days.length){
    // 未保存なら現在の日を即席で対象に
    var cur=currentDayRecord();
    if(cur.slots>0){ days=[cur]; } else { toast(&quot;先に「この日を保存」してください&quot;); return; }
  }
  // 日次サマリ
  var s1=[[_S(&quot;日付&quot;),_S(&quot;稼働コマ&quot;),_S(&quot;予定分&quot;),_S(&quot;実績分&quot;),_S(&quot;達成率%&quot;),_S(&quot;授業分&quot;),_S(&quot;会議分&quot;),_S(&quot;作業分&quot;),_S(&quot;休憩分&quot;),_S(&quot;めあて&quot;),_S(&quot;先生から一言&quot;)]];
  days.forEach(function(d){
    s1.push([_S(d.date),_N(d.slots),_N(d.planMin),_N(d.actMin),_N(d.rate),
      _N((d.kindMin&amp;&amp;d.kindMin.lesson)||0),_N((d.kindMin&amp;&amp;d.kindMin.meeting)||0),_N((d.kindMin&amp;&amp;d.kindMin.work)||0),_N(d.breakMin||0),
      _S(d.goal),_S(d.teacher)]);
  });
  // 明細（CSVと同じ列＝再インポート可能）
  var s2=[[_S(&quot;日付&quot;),_S(&quot;時限&quot;),_S(&quot;区分&quot;),_S(&quot;開始&quot;),_S(&quot;終了&quot;),_S(&quot;予定分&quot;),_S(&quot;予定&quot;),_S(&quot;実績&quot;),_S(&quot;達成&quot;)]];
  days.forEach(function(d){
    (d.periods||[]).forEach(function(p){
      s2.push([_S(d.date),_S(p.label),_S(p.kindLabel||KIND_LABEL[p.kind]||&quot;&quot;),_S(p.s),_S(p.e),_N(p.dur),_S(p.plan),_S(p.actual),_S(p.status)]);
    });
  });
  // 区分集計
  var info=aggregateDays();
  var s3=[[_S(&quot;区分&quot;),_S(&quot;合計予定分&quot;),_S(&quot;時間&quot;)],
    [_S(&quot;授業&quot;),_N(info.agg.lesson),_S(fmtHM(info.agg.lesson))],
    [_S(&quot;会議&quot;),_N(info.agg.meeting),_S(fmtHM(info.agg.meeting))],
    [_S(&quot;作業&quot;),_N(info.agg.work),_S(fmtHM(info.agg.work))],
    [_S(&quot;休憩&quot;),_N(info.agg.brk),_S(fmtHM(info.agg.brk))],
    [_S(&quot;&quot;),_S(&quot;&quot;),_S(&quot;&quot;)],
    [_S(&quot;保存日数&quot;),_N(info.count),_S(&quot;&quot;)],
    [_S(&quot;平均達成率%&quot;),_N(info.avgRate),_S(&quot;&quot;)]];
  // タグ別集計（独立シート）：全日のコマからタグ時間を積み上げ
  var tagAll={};
  days.forEach(function(d){
    var tm=tagMinutesFromPeriods(d.periods);
    Object.keys(tm).forEach(function(k){ tagAll[k]=(tagAll[k]||0)+tm[k]; });
  });
  var tagKeys=Object.keys(tagAll).sort(function(a,b){return tagAll[b]-tagAll[a];});
  var U=ROUND_UNIT||15;
  var s4=[[_S(&quot;タグ&quot;),_S(&quot;合計予定分&quot;),_S(&quot;時間&quot;),_S(&quot;コマ(&quot;+U+&quot;分)&quot;)]];
  if(tagKeys.length){
    tagKeys.forEach(function(k){ s4.push([_S(&quot;#&quot;+k),_N(tagAll[k]),_S(fmtHM(tagAll[k])),_N(Math.round(tagAll[k]/U))]); });
  } else {
    s4.push([_S(&quot;（タグの記載なし）&quot;),_S(&quot;&quot;),_S(&quot;&quot;),_S(&quot;&quot;)]);
  }
  var buf=_buildXlsx([{name:&quot;日次サマリ&quot;,rows:s1},{name:&quot;明細&quot;,rows:s2},{name:&quot;区分集計&quot;,rows:s3},{name:&quot;タグ別集計&quot;,rows:s4}]);
  var blob=new Blob([buf],{type:&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet&quot;});
  _saveBlob(blob, &quot;時間割ログ_&quot;+today()+&quot;.xlsx&quot;);
  toast(&quot;Excelを書き出しました（&quot;+days.length+&quot;日分）&quot;);
}

/* ---- CSV 入出力（明細形式・再インポート用） ---- */
function _csvCell(s){ s=String(s==null?&quot;&quot;:s); return /[&quot;,\n]/.test(s) ? '&quot;'+s.replace(/&quot;/g,'&quot;&quot;')+'&quot;' : s; }
function exportCsv(){
  var days=loadDays();
  if(!days.length){ var cur=currentDayRecord(); if(cur.slots>0){ days=[cur]; } else { toast(&quot;先に「この日を保存」してください&quot;); return; } }
  var rows=[[&quot;日付&quot;,&quot;時限&quot;,&quot;区分&quot;,&quot;開始&quot;,&quot;終了&quot;,&quot;予定分&quot;,&quot;予定&quot;,&quot;実績&quot;,&quot;達成&quot;]];
  days.forEach(function(d){
    (d.periods||[]).forEach(function(p){
      rows.push([d.date,p.label,p.kindLabel||KIND_LABEL[p.kind]||&quot;&quot;,p.s,p.e,p.dur,p.plan,p.actual,p.status]);
    });
  });
  var csv=rows.map(function(r){return r.map(_csvCell).join(&quot;,&quot;);}).join(&quot;\r\n&quot;);
  var blob=new Blob([&quot;\uFEFF&quot;+csv],{type:&quot;text/csv;charset=utf-8&quot;});
  _saveBlob(blob, &quot;時間割ログ_&quot;+today()+&quot;.csv&quot;);
  toast(&quot;CSVを書き出しました&quot;);
}
/* ============ 月次データ統合（最大31件） ============ */
var HUB_MAX_DAYS=31;
var hubText=&quot;&quot;; // 統合済みのメモ本文（複数ソースを連結）

// 連続して同じ日付が並ぶ重複を除去（同日複数タスクで日付が増殖しないように）
function hubDedupDates(text){
  var dedup=[], prevDate=null;
  (text||&quot;&quot;).split(&quot;\n&quot;).forEach(function(ln){
    var t=ln.trim();
    var isDate = /^\d{4}\D+\d{1,2}\D+\d{1,2}/.test(t) &amp;&amp; t.replace(/[\d\/\-\.年月日（）\(\)月火水木金土曜\s]/g,&quot;&quot;).length<=2;
    if(isDate){ if(t===prevDate) return; prevDate=t; }
    dedup.push(ln);
  });
  return dedup.join(&quot;\n&quot;);
}

// 列ヘッダ名から「日付/タスク/時間/タグ」の列番号を推定（Notion/Excelの表記ゆれ対応）
function hubDetectColumns(header){
  var ci={ date:-1, task:-1, min:-1, tag:-1 };
  header.forEach(function(raw,i){
    var h=(raw||&quot;&quot;).trim().toLowerCase();
    if(!h) return;
    // 日付
    if(ci.date<0 &amp;&amp; /(日付|日時|実施日|作業日|年月日|^date$|date|day)/.test(h)) ci.date=i;
    // タスク名（Notionのタイトル列＝「名前/Name」も拾う）
    if(ci.task<0 &amp;&amp; /(タスク|作業内容|作業|内容|項目|やったこと|予定|実績|名前|名称|タイトル|title|name|task|todo|item)/.test(h)) ci.task=i;
    // 時間・工数
    if(ci.min<0 &amp;&amp; /(時間|工数|所要|分|duration|time|hours?|min)/.test(h)) ci.min=i;
    // タグ・分類
    if(ci.tag<0 &amp;&amp; /(タグ|ラベル|分類|カテゴリ|カテゴリー|区分|種別|tag|label|category|type)/.test(h)) ci.tag=i;
  });
  return ci;
}
// タグ文字列を個別タグに分割（Notionのマルチセレクトはカンマ/読点/空白区切り）
function hubSplitTags(s){
  if(!s) return [];
  return s.split(/[,、，;；\s]+/).map(function(x){ return x.replace(/^[#＃]/,&quot;&quot;).trim(); }).filter(Boolean);
}
// 時間セルを「90分」のような表記へ正規化（数値だけなら分とみなす）
function hubNormTime(s){
  s=(s||&quot;&quot;).trim(); if(!s) return &quot;&quot;;
  if(/^\d+(\.\d+)?$/.test(s)) return s+&quot;分&quot;;      // 90 → 90分
  return s;                                        // 90分 / 1h / 1:30 はそのまま
}

// Markdownテーブル/箇条書き/CSVを「メモ行」テキストに正規化
function hubNormalizeToMemo(raw, kind){
  if(!raw) return &quot;&quot;;
  raw=raw.replace(/^\uFEFF/,&quot;&quot;);
  var out=[];
  if(kind===&quot;csv&quot;){
    var rows=_parseCsv(raw);
    if(!rows.length) return &quot;&quot;;
    var header=rows[0].map(function(s){return (s||&quot;&quot;).trim();});
    var ci=hubDetectColumns(header);
    var hasHeader = (ci.task>=0 || ci.date>=0 || ci.min>=0 || ci.tag>=0);
    var body = hasHeader ? rows.slice(1) : rows;
    body.forEach(function(r){
      if(hasHeader &amp;&amp; ci.task>=0){
        var dt=ci.date>=0?(r[ci.date]||&quot;&quot;).trim():&quot;&quot;;
        var tk=(r[ci.task]||&quot;&quot;).trim(); if(!tk) return;
        var mn=ci.min>=0?hubNormTime(r[ci.min]):&quot;&quot;;
        var tags=ci.tag>=0?hubSplitTags(r[ci.tag]):[];
        if(dt) out.push(dt);
        var line=&quot;・&quot;+tk;
        if(mn) line+=&quot; &quot;+mn;
        if(tags.length) line+=&quot; &quot;+tags.map(function(t){return &quot;#&quot;+t;}).join(&quot; &quot;);
        out.push(line);
      } else {
        out.push(r.join(&quot; &quot;).trim()); // ヘッダ無し：行全体を1メモ行に
      }
    });
    return hubDedupDates(out.join(&quot;\n&quot;));
  }
  // Markdown / テキスト
  var mdLines=raw.split(/\r?\n/);
  // まずMarkdownテーブルのまとまりを検出してCSV的に処理
  var tableRows=[], inTable=false;
  // Notionプロパティ（縦並びのキー:値）を1レコードに合成
  var propRec={has:false, date:&quot;&quot;, task:&quot;&quot;, min:&quot;&quot;, tags:[]};
  function flushProp(){
    if(propRec.has &amp;&amp; propRec.task){
      if(propRec.date) out.push(propRec.date);
      var line=&quot;・&quot;+propRec.task;
      if(propRec.min) line+=&quot; &quot;+propRec.min;
      if(propRec.tags.length) line+=&quot; &quot;+propRec.tags.map(function(t){return &quot;#&quot;+t;}).join(&quot; &quot;);
      out.push(line);
    }
    propRec={has:false, date:&quot;&quot;, task:&quot;&quot;, min:&quot;&quot;, tags:[]};
  }
  function flushTable(){
    if(tableRows.length){
      // 区切り線を除去
      var clean=tableRows.filter(function(cells){ return !cells.every(function(c){return /^:?-+:?$/.test(c)||c===&quot;&quot;; }); });
      if(clean.length){
        // CSV正規化に委譲（ヘッダ認識・タグ分割・時間正規化が効く）
        var csvText=clean.map(function(cells){ return cells.map(function(c){ return /[&quot;,\n]/.test(c)?('&quot;'+c.replace(/&quot;/g,'&quot;&quot;')+'&quot;'):c; }).join(&quot;,&quot;); }).join(&quot;\n&quot;);
        var memoFromTable=hubNormalizeToMemo(csvText,&quot;csv&quot;);
        if(memoFromTable) out.push(memoFromTable);
      }
      tableRows=[];
    }
    inTable=false;
  }
  mdLines.forEach(function(line){
    line=line.replace(/\s+$/,&quot;&quot;);
    if(/^\s*\|.*\|\s*$/.test(line)){
      inTable=true;
      tableRows.push(line.split(&quot;|&quot;).slice(1,-1).map(function(s){return s.trim();}));
      return;
    } else if(inTable){ flushTable(); }
    if(!line.trim()){ flushProp(); return; }
    // Notionプロパティ行（キー: 値）→ レコードに溜める
    var prop=/^[-*]?\s*([^：:]{1,16})\s*[:：]\s*(.+)$/.exec(line);
    if(prop){
      var key=prop[1].trim(), val=prop[2].trim();
      if(/(日付|日時|date)/i.test(key)){ propRec.date=val; }
      else if(/(タグ|ラベル|分類|カテゴリ|区分|tag)/i.test(key)){ propRec.tags=propRec.tags.concat(hubSplitTags(val)); }
      else if(/(時間|工数|所要|分|duration|time)/i.test(key)){ propRec.min=hubNormTime(val); }
      else if(/(名前|名称|タイトル|タスク|作業|内容|項目|title|name|task)/i.test(key)){ propRec.task=val; }
      else { if(!propRec.task) propRec.task=val; } // 最初の不明プロパティをタスク名候補に
      propRec.has=true;
      return;
    }
    // プロパティ以外の通常行が来たら、溜まったレコードを確定
    flushProp();
    var h=/^#{1,6}\s*(.+)$/.exec(line);
    if(h){ out.push(h[1].trim()); return; }
    out.push(line);
  });
  flushProp();
  flushTable();
  return hubDedupDates(out.join(&quot;\n&quot;));
}

// 統合テキストに追記（日付件数で31日まで制限）
function hubAppend(memo, sourceLabel){
  if(!memo || !memo.trim()){ toast(&quot;取り込める内容がありませんでした&quot;); return; }
  hubText = hubText ? (hubText.replace(/\s+$/,&quot;&quot;)+&quot;\n&quot;+memo) : memo;
  // 日付件数チェック
  var a=analyzeMemo(hubText);
  if(a.dates.length>HUB_MAX_DAYS){
    toast(&quot;日付が&quot;+a.dates.length+&quot;件あります（最大&quot;+HUB_MAX_DAYS+&quot;日）。超過分も保持しますが、ご確認ください。&quot;);
  }
  hubRender();
  if(sourceLabel) toast(sourceLabel+&quot;を統合しました&quot;);
}

function hubRender(){
  var box=document.getElementById(&quot;hub_preview&quot;);
  var meta=document.getElementById(&quot;hub_meta&quot;);
  if(!hubText.trim()){
    box.innerHTML='<span class=&quot;empty&quot;>まだ取り込みがありません。上の①から取り込んでください。</span>';
    meta.textContent=&quot;&quot;; return;
  }
  var a=analyzeMemo(hubText);
  var taskKeys=Object.keys(a.taskMin).sort(function(x,y){return a.taskMin[y]-a.taskMin[x];});
  var totalMin=taskKeys.reduce(function(s,k){return s+a.taskMin[k];},0);
  meta.textContent=a.dates.length+&quot;日分 ／ タスク&quot;+Object.keys(a.taskMin).length+&quot;種 ／ 合計&quot;+fmtHM(totalMin);
  var html=&quot;&quot;;
  html+='<div style=&quot;font-weight:700;color:var(--orange-deep);margin-bottom:4px;&quot;>タスク別 時間（多い順）</div>';
  if(taskKeys.length){
    taskKeys.slice(0,30).forEach(function(k){
      html+='<div style=&quot;display:flex;justify-content:space-between;border-bottom:1px dotted var(--line-soft);padding:2px 0;&quot;><span>'+_xmlEsc(k)+'</span><span style=&quot;color:var(--ink-soft);&quot;>'+fmtHM(a.taskMin[k])+'（'+a.taskMin[k]+'分）</span></div>';
    });
  } else {
    html+='<div class=&quot;hint&quot; style=&quot;margin:0;&quot;>時間つきのタスクが見つかりません。「作業 90分」のように時間を書くと集計されます。</div>';
  }
  var tagKeys=Object.keys(a.tagMin).sort(function(x,y){return a.tagMin[y]-a.tagMin[x];});
  if(tagKeys.length){
    html+='<div style=&quot;font-weight:700;color:var(--orange-deep);margin:8px 0 4px;&quot;>タグ別 時間</div>';
    tagKeys.forEach(function(k){ html+='<div style=&quot;display:flex;justify-content:space-between;padding:1px 0;&quot;><span>#'+_xmlEsc(k)+'</span><span style=&quot;color:var(--ink-soft);&quot;>'+fmtHM(a.tagMin[k])+'</span></div>'; });
  }
  box.innerHTML=html;
}

function hubClear(){ hubText=&quot;&quot;; hubRender(); toast(&quot;統合データをクリアしました&quot;); }

function hubAddPaste(){
  var t=v(&quot;hub_paste&quot;);
  if(!t){ toast(&quot;メモを貼り付けてください&quot;); return; }
  hubAppend(t, &quot;貼り付け&quot;);
  document.getElementById(&quot;hub_paste&quot;).value=&quot;&quot;;
}

function hubImportText(input){
  var file=input.files&amp;&amp;input.files[0]; if(!file) return;
  var reader=new FileReader();
  reader.onload=function(){
    var text=String(reader.result||&quot;&quot;);
    var name=(file.name||&quot;&quot;).toLowerCase();
    var kind = /\.csv$/.test(name) ? &quot;csv&quot; : &quot;md&quot;;
    var memo=hubNormalizeToMemo(text, kind);
    hubAppend(memo, file.name);
    input.value=&quot;&quot;;
  };
  reader.readAsText(file,&quot;UTF-8&quot;);
}

function hubFromLog(){
  var days=loadDays();
  if(!days.length){ toast(&quot;時間割の保存ログがありません&quot;); return; }
  var lines=[];
  days.slice().sort(function(a,b){return (dateKey(a.date)||0)-(dateKey(b.date)||0);}).forEach(function(d){
    lines.push(d.date);
    (d.periods||[]).forEach(function(p){
      if(p.kind===&quot;break&quot;||p.isBreak) return;
      var name=(p.actual||p.plan||&quot;&quot;).trim(); if(!name) return;
      var mn=p.dur||0;
      lines.push(&quot;・&quot;+name+(mn?(&quot; &quot;+mn+&quot;分&quot;):&quot;&quot;));
    });
  });
  hubAppend(lines.join(&quot;\n&quot;), &quot;時間割ログ&quot;);
}

// .xlsx 試し読み込み（DecompressionStreamが使えれば）
function hubImportXlsx(input){
  var file=input.files&amp;&amp;input.files[0]; if(!file) return;
  var done=function(){ input.value=&quot;&quot;; };
  if(typeof window.DecompressionStream===&quot;undefined&quot;){
    toast(&quot;この環境では.xlsx直接読み込み不可。ExcelをCSVで保存して読み込んでください&quot;);
    done(); return;
  }
  var reader=new FileReader();
  reader.onload=function(){
    _xlsxToRows(new Uint8Array(reader.result)).then(function(rows){
      if(!rows || !rows.length){ toast(&quot;Excelからデータを取得できませんでした。CSV保存をお試しください&quot;); done(); return; }
      // rowsを擬似CSVテキストにしてnormalize
      var csv=rows.map(function(r){ return r.map(function(c){ c=(c==null?&quot;&quot;:String(c)); return /[&quot;,\n]/.test(c)?('&quot;'+c.replace(/&quot;/g,'&quot;&quot;')+'&quot;'):c; }).join(&quot;,&quot;); }).join(&quot;\n&quot;);
      var memo=hubNormalizeToMemo(csv, &quot;csv&quot;);
      hubAppend(memo, file.name);
      done();
    }).catch(function(){
      toast(&quot;Excelの解析に失敗しました。CSVで保存して読み込んでください&quot;);
      done();
    });
  };
  reader.readAsArrayBuffer(file);
}

// 統一取り込み：source(notion/excel/app) × kind(csv/md/xlsx) を選んで読み込む
function hubImport(input, source, kind){
  var file=input.files&amp;&amp;input.files[0]; if(!file) return;
  var label=(source===&quot;notion&quot;?&quot;Notion&quot;:(source===&quot;excel&quot;?&quot;Excel&quot;:&quot;データ&quot;))+&quot;（&quot;+kind.toUpperCase()+&quot;）&quot;;
  if(kind===&quot;xlsx&quot;){
    var done=function(){ input.value=&quot;&quot;; };
    if(typeof window.DecompressionStream===&quot;undefined&quot;){
      toast(&quot;この環境では.xlsx直接読み込み不可。ExcelをCSVで保存して読み込んでください&quot;); done(); return;
    }
    var rd=new FileReader();
    rd.onload=function(){
      _xlsxToRows(new Uint8Array(rd.result)).then(function(rows){
        if(!rows||!rows.length){ toast(&quot;Excelからデータを取得できませんでした。CSV保存をお試しください&quot;); done(); return; }
        var csv=rows.map(function(r){ return r.map(function(c){ c=(c==null?&quot;&quot;:String(c)); return /[&quot;,\n]/.test(c)?('&quot;'+c.replace(/&quot;/g,'&quot;&quot;')+'&quot;'):c; }).join(&quot;,&quot;); }).join(&quot;\n&quot;);
        hubAppend(hubNormalizeToMemo(csv,&quot;csv&quot;), label+&quot; &quot;+file.name);
        done();
      }).catch(function(){ toast(&quot;Excelの解析に失敗しました。CSVで保存して読み込んでください&quot;); done(); });
    };
    rd.readAsArrayBuffer(file);
    return;
  }
  // csv / md
  var reader=new FileReader();
  reader.onload=function(){
    var text=String(reader.result||&quot;&quot;);
    hubAppend(hubNormalizeToMemo(text, kind===&quot;csv&quot;?&quot;csv&quot;:&quot;md&quot;), label+&quot; &quot;+file.name);
    input.value=&quot;&quot;;
  };
  reader.readAsText(file,&quot;UTF-8&quot;);
}

// 統合データを各機能へ送る
function hubToMonthly(){
  if(!hubText.trim()){ toast(&quot;先に統合データを取り込んでください&quot;); return; }
  var tab=[].slice.call(document.querySelectorAll(&quot;.tab&quot;)).filter(function(t){return t.dataset.tab===&quot;timetable&quot;;})[0];
  if(tab) tab.click();
  var ta=document.getElementById(&quot;rep_memo&quot;); if(ta){ ta.value=hubText; }
  buildMonthlyReportFromMemo();
}
function hubToMonthlyXlsx(){
  if(!hubText.trim()){ toast(&quot;先に統合データを取り込んでください&quot;); return; }
  var ta=document.getElementById(&quot;rep_memo&quot;); if(ta){ ta.value=hubText; }
  exportMonthlyXlsxFromMemo();
}
function hubToSkill(){
  if(!hubText.trim()){ toast(&quot;先に統合データを取り込んでください&quot;); return; }
  var tab=[].slice.call(document.querySelectorAll(&quot;.tab&quot;)).filter(function(t){return t.dataset.tab===&quot;skill&quot;;})[0];
  if(tab) tab.click();
