};

document.querySelectorAll('.pattern-card[data-kmode]').forEach(p => {
  p.addEventListener('click', () => {
    document.querySelectorAll('.pattern-card[data-kmode]').forEach(x => x.classList.remove('active'));
    p.classList.add('active');
    commMode = p.dataset.kmode;
    document.querySelectorAll('.kmode-block').forEach(b => {
      b.style.display = (b.dataset.kmodeTarget === commMode) ? 'block' : 'none';
    });
  });
});
document.querySelector('.pattern-card[data-kmode=&quot;mtg&quot;]').classList.add('active');

(function(){ const el = document.getElementById('k_date'); if (el &amp;&amp; !el.value) el.value = todayStr; })();

/* --- MODE 10: 会議アジェンダ 議題行 --- */
const agItems = document.getElementById('k_ag_items');
let agCount = 0;
function addAgItem(topic='', min=10, goal=''){
  agCount++;
  const row = document.createElement('div');
  row.className = 'ticket-item';
  row.innerHTML = `
    <div class=&quot;ticket-head&quot;>
      <span class=&quot;ticket-type story&quot;>議題 ${agCount}</span>
      <input type=&quot;text&quot; class=&quot;ag-topic&quot; value=&quot;${topic.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;議題（例：リリース日程の確認）&quot; style=&quot;flex:1;min-width:160px;font-size:13px&quot;>
      <button class=&quot;btn-mini&quot; onclick=&quot;this.closest('.ticket-item').remove()&quot;>🗑</button>
    </div>
    <div class=&quot;ticket-row&quot;>
      <div><label>所要分</label><input type=&quot;number&quot; class=&quot;ag-min&quot; value=&quot;${min}&quot; min=&quot;1&quot; step=&quot;5&quot;></div>
      <div style=&quot;grid-column:span 2&quot;><label>この議題で決めること（ゴール）</label><input type=&quot;text&quot; class=&quot;ag-goal&quot; value=&quot;${goal.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;例：6/10で確定させる&quot;></div>
    </div>`;
  agItems.appendChild(row);
}
document.getElementById('k_ag_add').addEventListener('click', () => addAgItem());
document.getElementById('k_ag_clear').addEventListener('click', () => { if(confirm('議題をすべて削除しますか？')){agItems.innerHTML='';agCount=0;} });
addAgItem('開会・本日のゴール共有', 5, '全員が会議の目的を理解');
addAgItem('', 15, '');

/* --- MODE 11: カイゼン アクション行 --- */
const kzActions = document.getElementById('k_kz_actions');
function addKzAction(what='', who='', due=''){
  const row = document.createElement('div');
  row.className = 'ticket-item';
  row.innerHTML = `
    <div class=&quot;ticket-row&quot;>
      <div style=&quot;grid-column:span 1&quot;><label>アクション</label><input type=&quot;text&quot; class=&quot;kz-what&quot; value=&quot;${what.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;例：演習テンプレを作成&quot;></div>
      <div><label>担当</label><input type=&quot;text&quot; class=&quot;kz-who&quot; value=&quot;${who.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;担当者&quot;></div>
      <div><label>期限</label><input type=&quot;text&quot; class=&quot;kz-due&quot; value=&quot;${due.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;例：6/20&quot;></div>
      <button class=&quot;btn-mini&quot; onclick=&quot;this.closest('.ticket-item').remove()&quot;>🗑</button>
    </div>`;
  kzActions.appendChild(row);
}
document.getElementById('k_kz_addaction').addEventListener('click', () => addKzAction());
document.getElementById('k_kz_clearaction').addEventListener('click', () => { if(confirm('アクションをすべて削除しますか？'))kzActions.innerHTML=''; });
addKzAction();

document.getElementById('k_gen-btn').addEventListener('click', () => {
  const v = id => (document.getElementById(id)?.value || '').trim();
  const meta = COMM_MODE_META[commMode];
  const author = v('k_author') || '未設定';
  const to = v('k_to') || '—';
  const date = v('k_date') || todayStr;
  const docno = v('k_docno'), rev = v('k_rev');
  const conf = document.getElementById('k_conf').value;
  const relate = v('k_relate');

  let titleLine, body;

  if (commMode === 'mtg') {
    titleLine = `# 🗓 MTG当日メモ：${v('k_mtg_title') || '会議'}`;
    body = `## 📨 会議情報

| 項目 | 内容 |
|------|------|
| 会議名 | ${v('k_mtg_title') || '—'} |
| 日時 | ${date} ${v('k_mtg_time')} |
| 出席者 | ${v('k_mtg_attendees') || '—'} |
| 目的・ゴール | ${v('k_mtg_goal') || '—'} |
| 記入者 | ${author} |

---

## 📋 議題と議論内容

${v('k_mtg_agenda') || '_（未記入）_'}

---

## ✅ 決定事項

${v('k_mtg_decisions') || '_（未記入）_'}

## ❓ 保留・持ち帰り事項

${v('k_mtg_pending') || '_（なし）_'}

---

## 📌 宿題・アクション

${v('k_mtg_actions') || '_（未記入）_'}`;

  } else if (commMode === 'retro') {
    const frame = sel['retroframe'] || 'KPT';
    const isKPT = frame === 'KPT';
    titleLine = `# 🔄 振り返りシート（${frame}）：${v('k_retro_target') || '振り返り'}`;
    body = `## 📨 基本情報

| 項目 | 内容 |
|------|------|
| フレーム | ${frame} |
| 対象 | ${v('k_retro_target') || '—'} |
| 記入者 | ${author} |
| 日付 | ${date} |

---

## ${isKPT ? '🟢 Keep（続けたい良かったこと）' : '🟢 Y：やったこと'}

${v('k_retro_a') || '_（未記入）_'}

## ${isKPT ? '🟡 Problem（課題）' : '🟡 W：わかったこと（学び）'}

${v('k_retro_b') || '_（未記入）_'}

## ${isKPT ? '🔵 Try（次に試すこと）' : '🔵 T：次にやること'}

${v('k_retro_c') || '_（未記入）_'}

---

## 💡 一番の学び

> **${v('k_retro_learn') || '_（未記入）_'}**`;

  } else if (commMode === 'boss') {
    const level = document.getElementById('k_boss_level').value;
    titleLine = `# 📨 ${level}　ご報告`;
    body = `**宛先：** ${to}　／　**報告者：** ${author}　／　**日付：** ${date}

---

## 🎯 結論

${v('k_boss_conclusion') || '_（未記入）_'}

## 🙋 ご対応いただきたいこと

${v('k_boss_need') || '_（未記入）_'}

**⏰ 期限：** ${v('k_boss_due') || '—'}　／　**重要度：** ${level}

---

<details>
<summary>📋 背景・詳細（必要に応じてご確認ください）</summary>

${v('k_boss_detail') || '_（記載なし）_'}

</details>

${v('k_boss_recommend') ? `## 💡 私の推奨案\n\n${v('k_boss_recommend')}` : ''}`;

  } else if (commMode === 'claim') {
    const sev = document.getElementById('k_claim_severity').value;
    titleLine = `# ⚠️ クレーム対応・改善アクション報告`;
    body = `## 📨 基本情報

| 項目 | 内容 |
|------|------|
| 発生元・日時 | ${v('k_claim_from') || '—'} |
| 重大度 | ${sev} |
| 対応者 | ${author} |
| 記入日 | ${date} |

---

## 📝 クレーム内容（事実）

${v('k_claim_content') || '_（未記入）_'}

---

## 🩹 一次対応

${v('k_claim_first') || '_（未記入）_'}

## 🔍 原因分析（システム視点・個人を責めない）

${v('k_claim_cause') || '_（未記入）_'}

## 🛡 再発防止アクション

${v('k_claim_prevent') || '_（未記入）_'}

---

**📨 報告先・エスカレーション：** ${v('k_claim_report') || '—'}`;

  } else if (commMode === 'confirm2') {
    titleLine = `# ✅ 指示の確認・復唱`;
    body = `**指示元：** ${to}　／　**確認者：** ${author}　／　**日付：** ${date}

---

## 📥 受けた指示

${v('k_cf_received') || '_（未記入）_'}

## 🎯 私の理解（復唱）

${v('k_cf_understand') || '_（未記入）_'}

---

## 📦 成果物・完了条件の認識

${v('k_cf_dod') || '_（未記入）_'}

**⏰ 納期の認識：** ${v('k_cf_due') || '—'}

---

## ❓ 確認したい点

${v('k_cf_questions') || '_（特になし）_'}

---

> 🤝 上記の認識で進めてよろしいでしょうか？ 相違があればご指摘ください。`;

  } else if (commMode === 'progress') {
    const signal = document.getElementById('k_pg_signal').value;
    const pct = document.getElementById('k_pg_percent').value;
    titleLine = `# 📊 進捗報告：${v('k_pg_task') || 'タスク'}`;
    body = `## 📨 サマリー

| 項目 | 内容 |
|------|------|
| タスク | ${v('k_pg_task') || '—'} |
| 全体進捗 | ${pct} |
| 状態 | ${signal} |
| 報告者 | ${author} |
| 宛先 | ${to} |
| 日付 | ${date} |

---

## ✅ 完了したこと

${v('k_pg_done') || '_（未記入）_'}

## 🔄 進行中・次にやること

${v('k_pg_next') || '_（未記入）_'}

## ⚠️ 課題・ブロッカー

${v('k_pg_block') || '_（なし）_'}

## 🙋 支援・判断してほしいこと

${v('k_pg_help') || '_（なし）_'}`;

  } else if (commMode === 'daily') {
    titleLine = `# 📝 日報（${date}）`;
    body = `**記入者：** ${author}　／　**宛先：** ${to}

---

## ✅ 本日やったこと（事実）

${v('k_dl_done') || '_（未記入）_'}

---

## 💭 気づき・所感（主観）

${v('k_dl_thoughts') || '_（未記入）_'}

## ⚠️ 課題・困りごと

${v('k_dl_issues') || '_（なし）_'}

---

## 📅 明日の予定

${v('k_dl_tomorrow') || '_（未記入）_'}

## 🙋 共有・相談したいこと

${v('k_dl_share') || '_（なし）_'}`;
  } else if (commMode === 'prep') {
    titleLine = `# 📋 報告メモ（PREP）：${v('k_pr_project') || '案件'}`;
    body = `## 📨 報告メタ情報

| 項目 | 内容 |
|------|------|
| 案件名 | ${v('k_pr_project') || '—'} |
| 報告日 | ${date} |
| 報告時間の目安 | ${document.getElementById('k_pr_time').value} |
| 報告形式 | ${document.getElementById('k_pr_format').value} |
| 完了度 | ${document.getElementById('k_pr_percent').value} |
| ステータス | ${document.getElementById('k_pr_status').value} |
| 期間 | ${v('k_pr_period') || '—'} |
| 報告者 | ${author} |
| 宛先 | ${to} |

---

## 📝 仕事内容

${v('k_pr_work') || '_（未記入）_'}

---

## 🎯 P：結論（結論から先に）

> **${v('k_pr_point') || '_（未記入）_'}**

## 📊 R：結論の根拠

${v('k_pr_reason') || '_（未記入）_'}

## 📜 E：経緯・背景

${v('k_pr_example') || '_（未記入）_'}

## 🚀 今後の展開・依頼事項

${v('k_pr_future') || '_（未記入）_'}`;

  } else if (commMode === 'timed') {
    const t = parseInt(document.getElementById('k_tm_time').value);
    const fmtLabel = {1:'1分報告（口頭のみ）', 3:'3分報告（口頭＋筆記メモ）', 5:'5分報告（口頭＋書面・報告書）'}[t];
    const parts = [];
    // 1分〜（常に出す）
    parts.push(`## ① 結論（一言）\n\n> **${v('k_tm_conclusion') || '_（未記入）_'}**`);
    parts.push(`| 項目 | 内容 |\n|------|------|\n| ② 完了度・ステータス | ${v('k_tm_status') || '—'} |\n| ③ 次のアクション | ${v('k_tm_next') || '—'} |`);
    // 3分〜
    if (t >= 3) {
      parts.push(`## ④ 根拠・事実\n\n${v('k_tm_reason') || '_（未記入）_'}`);
      parts.push(`## ⑤ 経緯（簡潔に）\n\n${v('k_tm_history') || '_（未記入）_'}`);
    }
    // 5分のみ
    if (t >= 5) {
      parts.push(`## ⑥ 仕事内容の詳細\n\n${v('k_tm_detail') || '_（未記入）_'}`);
      parts.push(`## ⑦ 今後の展開・依頼事項\n\n${v('k_tm_future') || '_（未記入）_'}`);
    }
    titleLine = `# ⏱ ${fmtLabel}：${v('k_tm_project') || '案件'}`;
    body = `## 📨 基本情報

| 項目 | 内容 |
|------|------|
| 案件名 | ${v('k_tm_project') || '—'} |
| 持ち時間 | ${fmtLabel} |
| 報告者 | ${author} |
| 宛先 | ${to} |
| 日付 | ${date} |

> 🐰 持ち時間 **${t}分** に合わせて、伝える項目を絞り込んでいます。

---

${parts.join('\n\n---\n\n')}`;
  } else if (commMode === 'agenda2') {
    let totalMin = 0;
    const rows = [...agItems.querySelectorAll('.ticket-item')].map((r, i) => {
      const topic = r.querySelector('.ag-topic').value.trim();
      if (!topic) return null;
      const min = parseInt(r.querySelector('.ag-min').value) || 0;
      const goal = r.querySelector('.ag-goal').value.trim();
      totalMin += min;
      return `| ${i+1} | ${topic} | ${min}分 | ${goal || '—'} |`;
    }).filter(Boolean).join('\n');
    titleLine = `# 📅 会議アジェンダ：${v('k_ag_title') || '会議'}`;
    body = `## 📨 会議概要

| 項目 | 内容 |
|------|------|
| 会議名 | ${v('k_ag_title') || '—'} |
| 日時 | ${v('k_ag_time') || date} |
| 場所・形式 | ${v('k_ag_place') || '—'} |
| 出席者 | ${v('k_ag_attendees') || '—'} |
| 主催・記入者 | ${author} |

> 🎯 **この会議のゴール：** ${v('k_ag_goal') || '_（未記入）_'}

${v('k_ag_prep') ? `> 📋 **事前準備のお願い：** ${v('k_ag_prep')}` : ''}

---

## 📋 議題（合計 ${totalMin}分）

| # | 議題 | 時間 | この議題で決めること |
|---|------|------|----------------------|
${rows || '|  |  |  |  |'}

---

> 🐰 会議前に参加者へ共有してください。各議題のゴールを意識すると脱線しません。`;

  } else if (commMode === 'kaizen') {
    const whys = [1,2,3,4,5].map(n => {
      const val = v('k_kz_why'+n);
      return val ? `${n}. **なぜ${n}：** ${val}` : null;
    }).filter(Boolean).join('\n');
    const actionRows = [...kzActions.querySelectorAll('.ticket-item')].map(r => {
      const what = r.querySelector('.kz-what').value.trim();
      if (!what) return null;
      const who = r.querySelector('.kz-who').value.trim() || '—';
      const due = r.querySelector('.kz-due').value.trim() || '—';
      return `| ${what} | ${who} | ${due} | ☐ |`;
    }).filter(Boolean).join('\n');
    titleLine = `# 🔧 カイゼンMTG：${v('k_kz_theme') || 'テーマ'}`;
    body = `## 📨 基本情報

| 項目 | 内容 |
|------|------|
| テーマ | ${v('k_kz_theme') || '—'} |
| 参加者 | ${v('k_kz_members') || '—'} |
| 記入者 | ${author} |
| 日付 | ${date} |

---

## 🔍 問題・現状（事実）

${v('k_kz_problem') || '_（未記入）_'}

---

## ❓ なぜなぜ分析

${whys || '_（未記入）_'}

${v('k_kz_why5') ? `> 🎯 **真因：** ${v('k_kz_why5')}` : ''}

---

## 💡 改善策

${v('k_kz_solution') || '_（未記入）_'}

## 📊 効果測定（成功の基準）

${v('k_kz_metric') || '_（未記入）_'}

---

## 📌 アクションプラン

| アクション | 担当 | 期限 | 完了 |
|-----------|------|------|------|
${actionRows || '|  |  |  | ☐ |'}

---

> 🐰 カイゼンの鉄則：個人を責めず、プロセスに原因を求める。`;

  } else if (commMode === 'fb') {
    titleLine = `# 💬 フィードバック面談：${v('k_fb_receiver') || '面談'}`;
    body = `## 📨 基本情報

| 項目 | 内容 |
|------|------|
| FBする人 | ${v('k_fb_giver') || author} |
| FBを受ける人 | ${v('k_fb_receiver') || '—'} |
| 対象期間・案件 | ${v('k_fb_target') || '—'} |
| 日付 | ${date} |

---

## ① 本人の振り返り

**できたと思うこと：**

${v('k_fb_self_good') || '_（未記入）_'}

**課題と思うこと：**

${v('k_fb_self_issue') || '_（未記入）_'}

---

## ② 👍 Good（良かった点）

${v('k_fb_good') || '_（未記入）_'}

---

## ③ 🌱 More（もっと良くなる点）

${v('k_fb_more') || '_（未記入）_'}

---

## ④ 次の目標・アクション

**次に向けた目標（合意）：**

