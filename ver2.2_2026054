const selfChecks = document.getElementById('r_self_checks');
function addSelfCheck(label='', note=''){
  const row = document.createElement('div');
  row.className = 'self-check-row';
  row.innerHTML = `
    <label class=&quot;chk&quot; style=&quot;flex:1;align-items:flex-start&quot;><input type=&quot;checkbox&quot;><span><input type=&quot;text&quot; class=&quot;sc-label&quot; value=&quot;${label.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;チェック項目&quot;></span></label>
    <input type=&quot;text&quot; class=&quot;sc-note&quot; value=&quot;${note.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;確認結果メモ（任意）&quot;>
    <button class=&quot;btn-mini&quot; onclick=&quot;this.parentNode.remove()&quot;>🗑</button>`;
  selfChecks.appendChild(row);
}

document.getElementById('r_self_load').addEventListener('click', () => {
  const cat = document.getElementById('r_self_category').value;
  const items = SELF_REVIEW_TEMPLATES[cat] || [];
  if (!items.length &amp;&amp; cat !== 'custom') {
    alert('テンプレが見つかりません');
    return;
  }
  if (cat === 'custom') {
    addSelfCheck('', '');
    return;
  }
  if (selfChecks.children.length > 0) {
    if (!confirm('既存の項目があります。テンプレを追加読み込みしますか？（既存は残します）')) return;
  }
  items.forEach(item => addSelfCheck(item));
});
document.getElementById('r_self_addcheck').addEventListener('click', () => addSelfCheck());
document.getElementById('r_self_clear').addEventListener('click', () => {
  if (confirm('すべてのチェック項目を削除しますか？')) selfChecks.innerHTML = '';
});

/* ===================================================== */
/* MODE 2: 一次レビュー指摘対応                          */
/* ===================================================== */

const respItems = document.getElementById('r_resp_items');
let respCount = 0;

function addRespItem(){
  respCount++;
  const idx = respCount;
  const row = document.createElement('div');
  row.className = 'resp-item';
  row.innerHTML = `
    <div class=&quot;resp-head&quot;>
      <span class=&quot;resp-num&quot;>指摘 #${idx}</span>
      <select class=&quot;resp-type&quot;>
        <option value=&quot;🔴 Must&quot;>🔴 Must（必須修正）</option>
        <option value=&quot;🟡 Should&quot;>🟡 Should（できれば修正）</option>
        <option value=&quot;🟢 Nice&quot;>🟢 Nice（あれば嬉しい）</option>
        <option value=&quot;💬 Question&quot;>💬 Question（質問）</option>
        <option value=&quot;👍 Good&quot;>👍 Good（褒め）</option>
      </select>
      <select class=&quot;resp-action&quot;>
        <option value=&quot;✅ 修正対応&quot; selected>✅ 修正対応</option>
        <option value=&quot;🔄 一部修正&quot;>🔄 一部修正</option>
        <option value=&quot;💬 相談・確認したい&quot;>💬 相談・確認したい</option>
        <option value=&quot;⏸ 見送り（理由記載）&quot;>⏸ 見送り（理由記載）</option>
        <option value=&quot;❓ 意図確認したい&quot;>❓ 意図確認したい</option>
      </select>
      <button class=&quot;btn-mini&quot; onclick=&quot;this.closest('.resp-item').remove()&quot;>🗑</button>
    </div>
    <div class=&quot;resp-body&quot;>
      <label>📝 指摘内容（受けた指摘をそのまま引用）</label>
      <textarea class=&quot;resp-quote&quot; placeholder=&quot;例：『validateUser関数で、emailのフォーマット検証が抜けています』&quot;></textarea>
      <label>🎯 自分の理解（指摘の意図を自分の言葉で）</label>
      <textarea class=&quot;resp-understand&quot; placeholder=&quot;例：入力値検証は『あらゆる外部入力は信用しない』原則に基づくべきで、現状はその抜けがあるとのご指摘と理解しました&quot;></textarea>
      <label>🔧 対応内容（何を・どこを・どう変えたか）</label>
      <textarea class=&quot;resp-fix&quot; placeholder=&quot;例：&amp;#10;- validateUser関数にメール形式チェックを追加（正規表現＋既存ライブラリ）&amp;#10;- 関連テストケースを3件追加（正常/不正形式/空文字）&amp;#10;- 変更箇所：src/validators/user.js L42-58&quot;></textarea>
      <label>📁 変更ファイル・関連リンク（任意）</label>
      <input type=&quot;text&quot; class=&quot;resp-link&quot; placeholder=&quot;例：src/validators/user.js / コミット abc123&quot;>
    </div>`;
  respItems.appendChild(row);
}
document.getElementById('r_resp_add').addEventListener('click', addRespItem);
addRespItem(); // デフォルト1件

/* ===================================================== */
/* MODE 3: レビュー指摘（する側）                        */
/* ===================================================== */

const REV_TYPE_META = {
  must:    {label:'🔴 Must',     desc:'必須修正',           color:'#F0997B'},
  should:  {label:'🟡 Should',   desc:'できれば修正',       color:'#EF9F27'},
  nice:    {label:'🟢 Nice',     desc:'あれば嬉しい',       color:'#97C459'},
  q:       {label:'💬 Question', desc:'質問・意図確認',     color:'#85B7EB'},
  good:    {label:'👍 Good',     desc:'褒め・承認ポイント', color:'#AFA9EC'}
};

const revItems = document.getElementById('r_rev_items');
let revCount = 0;

function addRevItem(type){
  revCount++;
  const idx = revCount;
  const meta = REV_TYPE_META[type];
  const row = document.createElement('div');
  row.className = 'rev-item';
  row.dataset.revtype = type;
  row.style.borderLeftColor = meta.color;
  row.innerHTML = `
    <div class=&quot;rev-head&quot;>
      <span class=&quot;rev-badge&quot; style=&quot;background:${meta.color}20;color:${meta.color};border-color:${meta.color}&quot;>${meta.label}</span>
      <span class=&quot;rev-num&quot;>No.${idx}</span>
      <input type=&quot;text&quot; class=&quot;rev-where&quot; placeholder=&quot;📍 どこの何（ファイル名・行・章など）&quot;>
      <button class=&quot;btn-mini&quot; onclick=&quot;this.closest('.rev-item').remove()&quot;>🗑</button>
    </div>
    <div class=&quot;rev-body&quot;>
      <label>🔍 観察した事実（こうなっています）</label>
      <textarea class=&quot;rev-fact&quot; placeholder=&quot;例：validateUser関数で、emailの形式チェックが行われていません&quot;></textarea>
      <label>💡 改善案（こうしてみては）</label>
      <textarea class=&quot;rev-suggest&quot; placeholder=&quot;例：正規表現または既存ライブラリ（zod/joi等）でメール形式を検証するとよいでしょう&quot;></textarea>
      <label>🌱 なぜこの指摘か（期待する学び）</label>
      <input type=&quot;text&quot; class=&quot;rev-why&quot; placeholder=&quot;例：外部入力は信用しない原則を体得してほしい&quot;>
    </div>`;
  revItems.appendChild(row);
}
['must','should','nice','q','good'].forEach(type => {
  document.getElementById('r_rev_add_' + type).addEventListener('click', () => addRevItem(type));
});
addRevItem('good'); // デフォルトでGoodを1件先に置く

/* ===================================================== */
/* レビュー生成ボタン                                    */
/* ===================================================== */

document.getElementById('r_gen-btn').addEventListener('click', () => {
  const v = id => (document.getElementById(id)?.value || '').trim();

  const docno = v('r_docno');
  const rev = v('r_rev');
  const conf = document.getElementById('r_conf').value;
  const relate = v('r_relate');

  let md;

  // ===== MODE 1: セルフレビュー =====
  if (reviewMode === 'self') {
    const author = v('r_self_author') || '未設定';
    const target = v('r_self_target') || '（未入力）';
    const date = v('r_self_date') || todayStr;
    const reviewer = v('r_self_reviewer') || '未設定';
    const cat = document.getElementById('r_self_category');
    const catLabel = cat.options[cat.selectedIndex].text;
    const message = v('r_self_message');
    const focus = v('r_self_focus');

    const checks = [...selfChecks.querySelectorAll('.self-check-row')].map(r => {
      const checked = r.querySelector('input[type=checkbox]').checked;
      const label = r.querySelector('.sc-label').value.trim();
      const note = r.querySelector('.sc-note').value.trim();
      if (!label) return null;
      return `- [${checked ? 'x' : ' '}] ${label}${note ? ` _(${note})_` : ''}`;
    }).filter(Boolean);

    const checkedCount = [...selfChecks.querySelectorAll('input[type=checkbox]:checked')].length;
    const totalCount = [...selfChecks.querySelectorAll('.sc-label')].filter(l => l.value.trim()).length;
    const pct = totalCount > 0 ? Math.round(checkedCount / totalCount * 100) : 0;

    md = `${audTone()}

# 🎯 セルフレビュー提出前ToDo：${target}

${isoSection(docno, rev, conf, relate, author, '', '', date)}

---

${buildPrinciplesMarkdown()}

---

## 📨 基本情報

| 項目 | 内容 |
|------|------|
| 提出者 | ${author} |
| 提出先レビュアー | ${reviewer} |
| レビュー対象 | ${target} |
| カテゴリ | ${catLabel} |
| 提出予定日 | ${date} |
| 対象者区分 | ${audLabel()} |
| セルフチェック達成度 | **${checkedCount} / ${totalCount}** （${pct}%） |

---

## 📋 セルフチェック項目

${checks.length ? checks.join('\n') : '_（チェック項目未入力）_'}

---

## 💬 レビュアーへの伝達事項

### 既知の懸念・前提

${message || '_（特になし）_'}

### 特に重点的に見てほしい点

${focus || '_（特になし）_'}

---

## 🤝 提出時メッセージ（コピペ可）

> ${reviewer || 'レビュアー'} さん、
>
> ${target} のレビューをお願いいたします。
> セルフチェック ${checkedCount} / ${totalCount} 項目完了済み（${pct}%）です。
>
> ${message ? '【既知の懸念事項】\n> ' + message.split('\n').join('\n> ') + '\n>\n> ' : ''}${focus ? '【重点的に見てほしい点】\n> ' + focus.split('\n').join('\n> ') + '\n>\n> ' : ''}よろしくお願いいたします。

---

> 🐰 *Generated by うさうさ式 IT現場ジェネレーター v2 ─ 提出前の5分で手戻り3時間を防ぐ*`;
  }

  // ===== MODE 2: 一次レビュー指摘対応 =====
  else if (reviewMode === 'response') {
    const author = v('r_resp_author') || '未設定';
    const reviewer = v('r_resp_reviewer') || '未設定';
    const date = v('r_resp_date') || todayStr;
    const target = v('r_resp_target') || '（未入力）';
    const round = document.getElementById('r_resp_round').value;
    const learnings = v('r_resp_learnings');
    const request = v('r_resp_request');

    const items = [...respItems.querySelectorAll('.resp-item')].map((it, i) => {
      const type = it.querySelector('.resp-type').value;
      const action = it.querySelector('.resp-action').value;
      const quote = it.querySelector('.resp-quote').value.trim();
      const understand = it.querySelector('.resp-understand').value.trim();
      const fix = it.querySelector('.resp-fix').value.trim();
      const link = it.querySelector('.resp-link').value.trim();
      return `### 指摘 #${i + 1}　${type}　→　${action}

**📝 受けた指摘：**
> ${quote || '_（未入力）_'}

**🎯 私の理解：**
${understand || '_（未入力）_'}

**🔧 対応内容：**
${fix || '_（未入力）_'}

${link ? `**📁 変更箇所：** ${link}` : ''}`;
    }).join('\n\n---\n\n');

    // 集計
    const allTypes = [...respItems.querySelectorAll('.resp-type')].map(s => s.value);
    const allActions = [...respItems.querySelectorAll('.resp-action')].map(s => s.value);
    const typeCount = allTypes.reduce((acc, t) => { acc[t] = (acc[t]||0)+1; return acc; }, {});
    const actionCount = allActions.reduce((acc, t) => { acc[t] = (acc[t]||0)+1; return acc; }, {});
    const typeSummary = Object.entries(typeCount).map(([k,v]) => `${k}: ${v}件`).join(' / ');
    const actionSummary = Object.entries(actionCount).map(([k,v]) => `${k}: ${v}件`).join(' / ');

    md = `${audTone()}

# 💬 一次レビュー指摘対応書：${target}

${isoSection(docno, rev, conf, relate, author, reviewer, '', date)}

---

${buildPrinciplesMarkdown()}

---

## 📨 基本情報

| 項目 | 内容 |
|------|------|
| 対応者 | ${author} |
| レビュアー | ${reviewer} |
| レビュー対象 | ${target} |
| レビュー回 | ${round} |
| 対応日 | ${date} |
| 対象者区分 | ${audLabel()} |
| 指摘件数 | ${respItems.children.length}件 |
| 種別内訳 | ${typeSummary || '_なし_'} |
| 対応方針内訳 | ${actionSummary || '_なし_'} |

---

## 📋 指摘事項と対応

${items || '_（指摘事項未入力）_'}

---

## 🎯 全体所感・今回の学び

${learnings || '_（記載なし）_'}

---

## 🙏 再レビュー依頼

${request || `${reviewer} さん、ご指摘いただいた点について対応完了しましたので、再度ご確認をお願いいたします。`}

---

> 🐰 *Generated by うさうさ式 IT現場ジェネレーター v2 ─ 指摘の意図を自分の言葉に直すことが学びの第一歩*`;
  }

  // ===== MODE 3: レビュー指摘（する側） =====
  else if (reviewMode === 'reviewer') {
    const author = v('r_rev_author') || '未設定';
    const targetPerson = v('r_rev_target_person') || '未設定';
    const date = v('r_rev_date') || todayStr;
    const target = v('r_rev_target') || '（未入力）';
    const context = document.getElementById('r_rev_context').value;
    const good = v('r_rev_good');
    const growth = v('r_rev_growth');
    const deadline = v('r_rev_deadline') || '指定なし';
    const renext = document.getElementById('r_rev_renext').value;
    const encourage = v('r_rev_encourage');

    // 種別ごとに分類
    const byType = {must:[], should:[], nice:[], q:[], good:[]};
    [...revItems.querySelectorAll('.rev-item')].forEach((it, i) => {
      const type = it.dataset.revtype;
      const where = it.querySelector('.rev-where').value.trim();
      const fact = it.querySelector('.rev-fact').value.trim();
      const suggest = it.querySelector('.rev-suggest').value.trim();
      const why = it.querySelector('.rev-why').value.trim();
      byType[type].push({where, fact, suggest, why, idx: i + 1});
    });

    const renderItems = (arr, label) => {
      if (!arr.length) return '';
      const meta = Object.values(REV_TYPE_META).find(m => m.label === label) || {};
      return `### ${label}（${arr.length}件）

${arr.map(item => `**📍 ${item.where || '（場所未指定）'}**

- 🔍 **事実：** ${item.fact || '_（未入力）_'}
- 💡 **改善案：** ${item.suggest || '_（未入力）_'}
${item.why ? `- 🌱 **なぜ：** ${item.why}` : ''}`).join('\n\n')}`;
    };

    const mustSection = renderItems(byType.must, '🔴 Must');
    const shouldSection = renderItems(byType.should, '🟡 Should');
    const niceSection = renderItems(byType.nice, '🟢 Nice');
    const qSection = renderItems(byType.q, '💬 Question');
    const goodSection = renderItems(byType.good, '👍 Good');

    const totalCount = revItems.children.length;
    const summary = `Must:${byType.must.length} / Should:${byType.should.length} / Nice:${byType.nice.length} / Q:${byType.q.length} / Good:${byType.good.length}`;

    md = `${audTone()}

# 📝 レビュー指摘書：${target}

${isoSection(docno, rev, conf, relate, author, '', '', date)}

---

${buildPrinciplesMarkdown()}

---

## 📨 基本情報

| 項目 | 内容 |
|------|------|
| レビュアー | ${author} |
| 被レビュー者 | ${targetPerson} |
| レビュー対象 | ${target} |
| レビュー観点 | ${context} |
| レビュー日 | ${date} |
| 対象者区分 | ${audLabel()} |
| 指摘総数 | ${totalCount}件（${summary}） |

---

## 👍 まず：良かった点

${good || '_（記入推奨：必ず1つ以上書きましょう）_'}

---

## 📋 指摘事項

${[mustSection, shouldSection, niceSection, qSection, goodSection].filter(Boolean).join('\n\n---\n\n') || '_（指摘事項未入力）_'}

---

## 🌱 期待する学び・成長ポイント

${growth || '_（記載なし）_'}

---

## 📆 次のアクション

| 項目 | 内容 |
|------|------|
| 対応期限の目安 | ${deadline} |
| 再レビュー方法 | ${renext} |

---

## 💌 ${targetPerson} さんへ

${encourage || '_（記載なし）_'}

---

## 🤝 受領確認（被レビュー者が記入）

| 項目 | 内容 |
|------|------|
| 受領確認 | ☐ 全指摘を確認した |
| 認識相違 | ☐ なし　／　☐ あり（下記に記載） |
| 不明点・質問 |  |
| 対応着手日 |  |

---

> 🐰 *Generated by うさうさ式 IT現場ジェネレーター v2 ─ 承認を先に・事実と改善案を分けて・なぜを伝える*`;
  }

  document.getElementById('r_output').textContent = md;
  document.getElementById('r_output-card').style.display = 'block';
  document.getElementById('r_output-card').scrollIntoView({behavior:'smooth', block:'nearest'});
});

document.getElementById('r_copy-btn').addEventListener('click', () => {
  copyTo('r_output', 'r_copy-btn');
});

/* ===================================================== */
/* ============== タブ6：Web制作 ======================= */
/* ===================================================== */

const PHASE_META = {
  req:      {icon:'📋', name:'要求定義',       num:'①'},
  spec:     {icon:'📐', name:'要件定義',       num:'②'},
  ui:       {icon:'🎨', name:'UIデモ',          num:'③'},
  impl:     {icon:'🛠', name:'実装',           num:'④'},
  test:     {icon:'🧪', name:'テスト',         num:'⑤'},
  precheck: {icon:'✅', name:'提出前チェック', num:'⑥'},
  readme:   {icon:'📖', name:'README',         num:'⑦'},
  all:      {icon:'📦', name:'提出一式',       num:'📦'}
};

/* --- 視点切替 --- */
document.querySelectorAll('.aud[data-pers]').forEach(a => {
  a.addEventListener('click', () => {
    document.querySelectorAll('.aud[data-pers]').forEach(x => x.classList.remove('active'));
    a.classList.add('active');
    webPerspective = a.dataset.pers;
  });
});
document.querySelector('.aud[data-pers=&quot;student&quot;]').classList.add('active');

/* --- フェーズ切替 --- */
document.querySelectorAll('.phase-card[data-phase]').forEach(p => {
  p.addEventListener('click', () => {
    document.querySelectorAll('.phase-card[data-phase]').forEach(x => x.classList.remove('active'));
    p.classList.add('active');
    webPhase = p.dataset.phase;
    document.querySelectorAll('.phase-block').forEach(b => {
      b.style.display = (b.dataset.phaseTarget === webPhase) ? 'block' : 'none';
    });
  });
});
document.querySelector('.phase-card[data-phase=&quot;req&quot;]').classList.add('active');

/* --- 日付初期化 --- */
['w_startdate', 'w_duedate'].forEach(id => {
  const el = document.getElementById(id);
  if (el &amp;&amp; !el.value) el.value = todayStr;
});

/* --- Phase 6: 提出前チェック動的項目 --- */
const WEB_PRECHECK_TEMPLATE = [
  'HTML：W3C Validatorでエラーゼロを確認した',
  'CSS：未使用セレクタ・重複指定を削除した',
  'JavaScript：console.log デバッグコードを削除した',
  '画像：すべて適切なサイズ・形式で軽量化済み',
  '画像：すべてalt属性が設定されている',
  'リンク：内部・外部すべて遷移可能（404なし）',
  'レスポンシブ：スマホ・タブレット・PCで崩れがない',
  'ブラウザ互換：Chrome / Safari / Edge で動作確認済み',
  'アクセシビリティ：コントラスト比4.5:1以上',
  'パフォーマンス：Lighthouse 80点以上',
  'README：セットアップ手順だけで第三者が動かせる',
  '個人情報・APIキー・パスワードがコード/履歴に含まれていない',
  '不要なファイル（.DS_Store / node_modules / .vscode）が.gitignore済み',
  'コミット履歴：意味のある単位で分割されている',
  'デモURL（GitHub Pages等）が公開されている'
];

const preChecks = document.getElementById('w_pre_checks');
function addPreCheck(label='', note=''){
  const row = document.createElement('div');
  row.className = 'self-check-row';
  row.innerHTML = `
    <label class=&quot;chk&quot; style=&quot;flex:1;align-items:flex-start&quot;><input type=&quot;checkbox&quot;><span><input type=&quot;text&quot; class=&quot;sc-label&quot; value=&quot;${label.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;チェック項目&quot;></span></label>
    <input type=&quot;text&quot; class=&quot;sc-note&quot; value=&quot;${note.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;確認メモ（任意）&quot;>
    <button class=&quot;btn-mini&quot; onclick=&quot;this.parentNode.remove()&quot;>🗑</button>`;
  preChecks.appendChild(row);
}
document.getElementById('w_pre_load').addEventListener('click', () => {
  if (preChecks.children.length > 0) {
    if (!confirm('既存項目があります。標準テンプレを追加読み込みしますか？')) return;
  }
  WEB_PRECHECK_TEMPLATE.forEach(item => addPreCheck(item));
});
document.getElementById('w_pre_add').addEventListener('click', () => addPreCheck());
document.getElementById('w_pre_clear').addEventListener('click', () => {
  if (confirm('すべてのチェック項目を削除しますか？')) preChecks.innerHTML = '';
});

/* ===================================================== */
/* === Web制作：フェーズ別マークダウン生成 === */
/* ===================================================== */

function w_v(id){ return (document.getElementById(id)?.value || '').trim(); }

function w_perspectiveNote(){
  if (webPerspective === 'student') {
    return `> 🌱 **受講生視点で記述された制作ドキュメントです。** 私（制作者）が「何をどう作ったか／何を学んだか」を一人称で記述しています。`;
  } else {
    return `> 🏫 **講師視点で記述された指示・評価観点ドキュメントです。** 受講生が満たすべき要件と評価観点を提示しています。`;
  }
}

function w_persLabel(){
  return webPerspective === 'student' ? '🌱 受講生視点' : '🏫 講師視点';
}

function w_metaTable(){
  const project = w_v('w_project') || '無題プロジェクト';
  const student = w_v('w_student') || '未設定';
  const teacher = w_v('w_teacher') || '未設定';
  const start = w_v('w_startdate') || todayStr;
  const due = w_v('w_duedate') || '未設定';
  const course = w_v('w_course') || '未設定';
  return {project, table: `| 項目 | 内容 |
|------|------|
| プロジェクト名 | **${project}** |
| 制作者（受講生） | ${student} |
| 担当講師 | ${teacher} |
| 研修コース・課題 | ${course} |
| 制作開始日 | ${start} |
| 提出期限 | ${due} |
| 視点 | ${w_persLabel()} |
| 対象者区分 | ${audLabel()} |`};
}

/* --- Phase 1: 要求定義 --- */
function buildReqPhase(){
  const user = w_v('w_req_user') || '_（未記入）_';
  const problem = w_v('w_req_problem') || '_（未記入）_';
  const goal = w_v('w_req_goal') || '_（未記入）_';
  const constraint = w_v('w_req_constraint') || '_（未記入）_';
  const stake = w_v('w_req_stake') || '_（未記入）_';

  if (webPerspective === 'teacher') {
    return `## 📋 ① 要求定義（指示・評価観点）

### 1-1. 受講生に求める要求把握項目

受講生は本フェーズで以下を明文化すること：

#### ターゲットユーザー・ペルソナ

${user}

#### 解決する課題

${problem}

#### 期待する効果・成功基準

${goal}

#### 制約条件

${constraint}

#### ステークホルダー

${stake}

### 1-2. 評価観点（講師チェック）

- [ ] ペルソナが具体的（年齢・属性・利用シーンを含む）
- [ ] 課題と解決策が論理的につながっている
- [ ] 成功基準が定性または定量で言語化されている
- [ ] 技術・期限の制約が現実的`;
  }

  return `## 📋 ① 要求定義（誰の・何の課題を・どう解決するか）

### 1-1. ターゲットユーザー・ペルソナ

${user}

### 1-2. 解決したい課題

${problem}

### 1-3. 期待する効果・成功イメージ

${goal}

### 1-4. 制約条件

${constraint}

### 1-5. ステークホルダー

${stake}`;
}

