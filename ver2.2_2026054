<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>うさうさ 統合ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;}
  :root{
    --parchment:#f3e7c9; --parchment2:#e9d8b0; --parchment-deep:#e3d2a8;
    --ink:#3a2c18; --ink-soft:#6b5836; --gold:#a8862e; --gold-light:#c9a94a; --gold-deep:#7a5f1c;
    --wood:#4a2f1a; --wood-deep:#3a2412; --crimson:#7c2230; --crimson-light:#a23a48;
    --emerald:#1e5b3a; --navy:#23304f;
    --serif:"Hoefler Text","Baskerville","Garamond","Times New Roman","Yu Mincho","Hiragino Mincho ProN","MS PMincho",serif;
  }
  body{margin:0;font-family:var(--serif);min-height:100vh;color:var(--ink);
    background:
      radial-gradient(ellipse at 20% 10%, rgba(168,134,46,.10), transparent 50%),
      radial-gradient(ellipse at 80% 90%, rgba(124,34,48,.08), transparent 50%),
      linear-gradient(160deg,#2a1d10,#3a2818 45%,#2a1d10);
    background-attachment:fixed;}

  /* トップバー（金縁の額装風） */
  .topbar{position:sticky;top:0;z-index:10;
    background:linear-gradient(180deg,#4a2f1a,#3a2412);
    border-bottom:3px solid var(--gold);box-shadow:0 4px 20px rgba(0,0,0,.5);}
  .topbar-inner{max-width:1040px;margin:0 auto;padding:10px 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
  .brand{font-weight:700;font-size:1.1rem;display:flex;align-items:center;gap:8px;color:var(--gold-light);
    letter-spacing:.04em;text-shadow:0 1px 2px rgba(0,0,0,.6);cursor:pointer;}
  .brand .bun{font-size:1.3rem;}
  .brand .ver{font-size:.66rem;font-weight:700;letter-spacing:.06em;color:var(--parchment);background:rgba(168,134,46,.3);border:1px solid var(--gold);border-radius:999px;padding:1px 8px;margin-left:4px;}
  .topright{margin-left:auto;display:flex;align-items:center;gap:12px;}
  .clock{display:flex;flex-direction:column;align-items:flex-end;line-height:1.2;color:var(--gold-light);font-family:var(--serif);}
  .clock .c-date{font-size:.74rem;letter-spacing:.04em;opacity:.92;}
  .clock .c-time{font-size:1.02rem;font-weight:700;letter-spacing:.08em;font-variant-numeric:tabular-nums;}
  .home-btn{cursor:pointer;border:1px solid var(--gold);background:rgba(168,134,46,.15);
    color:var(--gold-light);border-radius:6px;padding:7px 16px;font-family:var(--serif);font-weight:700;font-size:.9rem;
    letter-spacing:.05em;transition:all .15s;display:none;}
  .home-btn:hover{background:rgba(168,134,46,.3);transform:translateY(-1px);}
  .home-btn.show{display:inline-block;}
  .modetabs{display:none;}
  @media (max-width:560px){ .clock .c-date{font-size:.66rem;} .clock .c-time{font-size:.9rem;} .brand .ver{display:none;} }

  /* ホーム＝魔法書の目次 */
  .home{max-width:1040px;margin:0 auto;padding:40px 20px 80px;}
  .book{position:relative;background:
      repeating-linear-gradient(0deg, rgba(120,90,30,.025) 0 2px, transparent 2px 4px),
      linear-gradient(155deg,#f5ead0,#ecdcb8 60%,#e4d2a6);
    border:1px solid var(--gold-deep);border-radius:8px;
    box-shadow:0 0 0 6px #3a2412, 0 0 0 8px var(--gold), 0 20px 60px rgba(0,0,0,.55);
    padding:48px 54px 60px;overflow:hidden;}
  .book::before{content:"";position:absolute;inset:14px;border:1.5px solid rgba(168,134,46,.45);border-radius:4px;pointer-events:none;}
  .book::after{content:"❦";position:absolute;top:20px;left:50%;transform:translateX(-50%);color:var(--gold);font-size:1.2rem;opacity:.6;}
  .book-head{text-align:center;margin:14px 0 6px;}
  .crest{font-size:2.6rem;filter:drop-shadow(0 2px 4px rgba(0,0,0,.3));}
  .book-title{font-size:2.1rem;font-weight:700;color:var(--wood-deep);margin:6px 0 2px;letter-spacing:.06em;
    text-shadow:0 1px 0 rgba(255,255,255,.4);}
  .book-sub{font-size:.92rem;color:var(--ink-soft);font-style:italic;letter-spacing:.08em;margin:0;}
  .book-rule{display:flex;align-items:center;gap:14px;margin:20px auto 26px;max-width:520px;color:var(--gold-deep);}
  .book-rule::before,.book-rule::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);}
  .book-rule span{font-size:.82rem;letter-spacing:.3em;white-space:nowrap;text-transform:uppercase;}

  .toc{margin:0 auto;max-width:760px;}
  .toc-item{display:flex;align-items:baseline;gap:14px;padding:13px 16px;cursor:pointer;
    border-radius:6px;transition:background .15s,transform .1s;position:relative;}
  .toc-item:hover{background:rgba(168,134,46,.14);transform:translateX(4px);}
  .toc-item:hover .toc-name{color:var(--crimson);}
  .toc-num{font-size:1.15rem;font-weight:700;color:var(--gold-deep);min-width:2.4em;font-style:italic;}
  .toc-icon{font-size:1.2rem;}
  .toc-name{font-size:1.16rem;font-weight:700;color:var(--wood-deep);letter-spacing:.03em;transition:color .15s;}
  .toc-dots{flex:1;border-bottom:2px dotted rgba(122,95,28,.4);margin:0 6px;transform:translateY(-3px);}
  .toc-desc{font-size:.8rem;color:var(--ink-soft);font-style:italic;white-space:nowrap;}
  .book-foot{text-align:center;margin-top:34px;color:var(--ink-soft);}
  .book-foot .quill{color:var(--gold);font-size:1.1rem;}
  .book-foot .author{font-style:italic;letter-spacing:.12em;font-size:.92rem;margin-top:4px;}
  .book-foot .motto{font-size:.78rem;opacity:.75;margin-top:2px;}
  .test-badge{display:inline-block;margin-top:18px;padding:8px 18px;border:1px solid var(--gold);border-radius:6px;background:rgba(180,150,70,.08);color:var(--ink-soft);font-size:.74rem;letter-spacing:.04em;line-height:1.6;}
  .test-badge .tb-title{color:var(--gold);font-weight:700;letter-spacing:.08em;}
  .test-badge .tb-items{opacity:.85;}
  .test-badge .tb-date{display:block;margin-top:4px;opacity:.7;font-style:italic;}

  /* ツール表示エリア */
  .frame-wrap{max-width:1040px;margin:0 auto;padding:0;display:none;}
  .frame-wrap.show{display:block;}
  iframe{width:100%;border:0;display:none;background:transparent;}
  iframe.active{display:block;}
  .stage{background:linear-gradient(160deg,#e8f0e6,#f6faf5 40%);min-height:60vh;}
  .hint{display:none;}

  @media (max-width:620px){
    .book{padding:30px 22px 40px;}
    .book-title{font-size:1.5rem;}
    .toc-desc{display:none;}
    .toc-dots{margin:0 4px;}
  }
</style>
</head>
<body>
  <div class="topbar">
    <div class="topbar-inner">
      <div class="brand" onclick="goHome()"><span class="bun">🐰</span> うさうさ統合ジェネレーター<span class="ver">v2.2</span></div>
      <div class="topright">
        <div class="clock"><span class="c-date" id="clockDate"></span><span class="c-time" id="clockTime"></span></div>
        <button class="home-btn" id="homeBtn" onclick="goHome()">📖 目次に戻る</button>
      </div>
      <div class="modetabs">
        <div class="modetab nip active" data-mode="nip" onclick="switchMode('nip')">① 📋 日報ジェネレーター</div>
        <div class="modetab fact" data-mode="fact" onclick="switchMode('fact')">㉚ 🔬 ファクト報告（理系新卒）</div>
        <div class="modetab qa" data-mode="qa" onclick="switchMode('qa')">② ✅ 品質保証ジェネレーター</div>
        <div class="modetab v26" data-mode="v26" onclick="switchMode('v26')">③ 🛠 IT現場ジェネレーター</div>
        <div class="modetab quiz" data-mode="quiz" onclick="switchMode('quiz')">④ 📝 作問スタジオ</div>
        <div class="modetab web" data-mode="web" onclick="switchMode('web')">⑤ 🎨 Web制作STUDIO</div>
        <div class="modetab intake" data-mode="intake" onclick="switchMode('intake')">⑥ 📥 業務受領</div>
        <div class="modetab sensei" data-mode="sensei" onclick="switchMode('sensei')">⑦ 🧠 プロンプト先生（APIなし）</div>
        <div class="modetab biz" data-mode="biz" onclick="switchMode('biz')">⑧ 📐 IT業務設計</div>
        <div class="modetab nav" data-mode="nav" onclick="switchMode('nav')">⑨ 🧭 要求定義ナビ</div>
        <div class="modetab fuwa" data-mode="fuwa" onclick="switchMode('fuwa')">⑩ 🌫️ ふわふわ指示変換</div>
        <div class="modetab subt" data-mode="subt" onclick="switchMode('subt')">⑪ 🎧 サブ講師依頼</div>
        <div class="modetab senseiapi" data-mode="senseiapi" onclick="switchMode('senseiapi')">⑫ 🤖 プロンプト先生（APIあり）</div>
        <div class="modetab jira" data-mode="jira" onclick="switchMode('jira')">⑬ 🎫 Jiraタスク作成</div>
        <div class="modetab deleg" data-mode="deleg" onclick="switchMode('deleg')">⑭ 🤝 業務委譲（APIなし）</div>
        <div class="modetab delegapi" data-mode="delegapi" onclick="switchMode('delegapi')">⑮ 🤝 業務委譲（APIあり）</div>
        <div class="modetab horenso" data-mode="horenso" onclick="switchMode('horenso')">⑯ 💬 報連相・敬語（APIなし）</div>
        <div class="modetab horensoapi" data-mode="horensoapi" onclick="switchMode('horensoapi')">⑰ 💬 報連相・敬語（APIあり）</div>
        <div class="modetab timer30" data-mode="timer30" onclick="switchMode('timer30')">⑱ ⏱ 30分説明タイマー</div>
        <div class="modetab script" data-mode="script" onclick="switchMode('script')">⑲ 🎬 説明台本（APIなし）</div>
        <div class="modetab scriptapi" data-mode="scriptapi" onclick="switchMode('scriptapi')">⑳ 🎬 説明台本（APIあり）</div>
        <div class="modetab zenn" data-mode="zenn" onclick="switchMode('zenn')">㉑ ✍️ Zenn風記事テンプレ</div>
        <div class="modetab exam" data-mode="exam" onclick="switchMode('exam')">㉒ 📝 試験・クイズ作成（APIなし）</div>
        <div class="modetab examapi" data-mode="examapi" onclick="switchMode('examapi')">㉓ 📝 試験・クイズ作成（APIあり）</div>
        <div class="modetab facili" data-mode="facili" onclick="switchMode('facili')">㉔ 🎤 ファシリ・議論（APIなし）</div>
        <div class="modetab faciliapi" data-mode="faciliapi" onclick="switchMode('faciliapi')">㉕ 🎤 ファシリ・議論（APIあり）</div>
        <div class="modetab consul" data-mode="consul" onclick="switchMode('consul')">㉖ 💼 ITコンサル練習（APIなし）</div>
        <div class="modetab consulapi" data-mode="consulapi" onclick="switchMode('consulapi')">㉗ 💼 ITコンサル練習（APIあり）</div>
        <div class="modetab kotei" data-mode="kotei" onclick="switchMode('kotei')">㉘ 🥞 開発工程の教え方（APIなし）</div>
        <div class="modetab koteiapi" data-mode="koteiapi" onclick="switchMode('koteiapi')">㉙ 🥞 開発工程の教え方（APIあり）</div>
      </div>
    </div>
  </div>
  <p class="hint">上のタブで「日報」と「品質保証」を切り替えられます。各ツールのデータはそれぞれの中で保持されます（端末内のみ・外部送信なし）。</p>

  <!-- 魔法書の目次（ホーム） -->
  <div class="home" id="homeScreen">
    <div class="book">
      <div class="book-head">
        <div class="crest">🐰</div>
        <h1 class="book-title">うさうさ統合ジェネレーター</h1>
        <p class="book-sub">A Grimoire of Thirty Instruments &middot; 研修と現場のための魔法書</p>
      </div>
      <div class="book-rule"><span>Table of Contents</span></div>
      <div class="toc">
        <div class="toc-item" onclick="openTool('nip')"><span class="toc-num">I</span><span class="toc-icon">📋</span><span class="toc-name">日報ジェネレーター</span><span class="toc-dots"></span><span class="toc-desc">一日の記録と報告</span></div>
        <div class="toc-item" onclick="openTool('qa')"><span class="toc-num">II</span><span class="toc-icon">✅</span><span class="toc-name">品質保証ジェネレーター</span><span class="toc-dots"></span><span class="toc-desc">要件と品質の番人</span></div>
        <div class="toc-item" onclick="openTool('v26')"><span class="toc-num">III</span><span class="toc-icon">🛠</span><span class="toc-name">IT現場ジェネレーター</span><span class="toc-dots"></span><span class="toc-desc">手順と報連相の術</span></div>
        <div class="toc-item" onclick="openTool('quiz')"><span class="toc-num">IV</span><span class="toc-icon">📝</span><span class="toc-name">作問スタジオ</span><span class="toc-dots"></span><span class="toc-desc">問いを生み出す工房</span></div>
        <div class="toc-item" onclick="openTool('web')"><span class="toc-num">V</span><span class="toc-icon">🎨</span><span class="toc-name">Web制作STUDIO</span><span class="toc-dots"></span><span class="toc-desc">頁を織る設計図</span></div>
        <div class="toc-item" onclick="openTool('intake')"><span class="toc-num">VI</span><span class="toc-icon">📥</span><span class="toc-name">業務受領</span><span class="toc-dots"></span><span class="toc-desc">依頼を授かる儀</span></div>
        <div class="toc-item" onclick="openTool('sensei')"><span class="toc-num">VII</span><span class="toc-icon">🧠</span><span class="toc-name">プロンプト先生（APIなし）</span><span class="toc-dots"></span><span class="toc-desc">手動で賢者と対話</span></div>
        <div class="toc-item" onclick="openTool('biz')"><span class="toc-num">VIII</span><span class="toc-icon">📐</span><span class="toc-name">IT業務設計</span><span class="toc-dots"></span><span class="toc-desc">要件工学の設計術</span></div>
        <div class="toc-item" onclick="openTool('nav')"><span class="toc-num">IX</span><span class="toc-icon">🧭</span><span class="toc-name">要求定義ナビ</span><span class="toc-dots"></span><span class="toc-desc">上流工程の羅針盤</span></div>
        <div class="toc-item" onclick="openTool('fuwa')"><span class="toc-num">X</span><span class="toc-icon">🌫️</span><span class="toc-name">ふわふわ指示変換</span><span class="toc-dots"></span><span class="toc-desc">曖昧を仕様に翻訳</span></div>
        <div class="toc-item" onclick="openTool('subt')"><span class="toc-num">XI</span><span class="toc-icon">🎧</span><span class="toc-name">サブ講師依頼</span><span class="toc-dots"></span><span class="toc-desc">依頼と引き継ぎを工程化</span></div>
        <div class="toc-item" onclick="openTool('senseiapi')"><span class="toc-num">XII</span><span class="toc-icon">🤖</span><span class="toc-name">プロンプト先生（APIあり）</span><span class="toc-dots"></span><span class="toc-desc">キーで自動分析</span></div>
        <div class="toc-item" onclick="openTool('jira')"><span class="toc-num">XIII</span><span class="toc-icon">🎫</span><span class="toc-name">Jiraタスク作成</span><span class="toc-dots"></span><span class="toc-desc">課題を整えて起票</span></div>
        <div class="toc-item" onclick="openTool('deleg')"><span class="toc-num">XIV</span><span class="toc-icon">🤝</span><span class="toc-name">業務委譲・交渉（APIなし）</span><span class="toc-dots"></span><span class="toc-desc">仕事を上手に振る</span></div>
        <div class="toc-item" onclick="openTool('delegapi')"><span class="toc-num">XV</span><span class="toc-icon">🤝</span><span class="toc-name">業務委譲・交渉（APIあり）</span><span class="toc-dots"></span><span class="toc-desc">キーで自動分析</span></div>
        <div class="toc-item" onclick="openTool('horenso')"><span class="toc-num">XVI</span><span class="toc-icon">💬</span><span class="toc-name">報連相・敬語（APIなし）</span><span class="toc-dots"></span><span class="toc-desc">伝え方と敬語の練習</span></div>
        <div class="toc-item" onclick="openTool('horensoapi')"><span class="toc-num">XVII</span><span class="toc-icon">💬</span><span class="toc-name">報連相・敬語（APIあり）</span><span class="toc-dots"></span><span class="toc-desc">キーで自動分析</span></div>
        <div class="toc-item" onclick="openTool('timer30')"><span class="toc-num">XVIII</span><span class="toc-icon">⏱</span><span class="toc-name">30分説明タイマー</span><span class="toc-dots"></span><span class="toc-desc">6段階で時間配分</span></div>
        <div class="toc-item" onclick="openTool('script')"><span class="toc-num">XIX</span><span class="toc-icon">🎬</span><span class="toc-name">説明台本（APIなし）</span><span class="toc-dots"></span><span class="toc-desc">6段階の台本づくり</span></div>
        <div class="toc-item" onclick="openTool('scriptapi')"><span class="toc-num">XX</span><span class="toc-icon">🎬</span><span class="toc-name">説明台本（APIあり）</span><span class="toc-dots"></span><span class="toc-desc">キーで自動生成</span></div>
        <div class="toc-item" onclick="openTool('zenn')"><span class="toc-num">XXI</span><span class="toc-icon">✍️</span><span class="toc-name">Zenn風記事テンプレ</span><span class="toc-dots"></span><span class="toc-desc">よかったこと・気づきを記事に</span></div>
        <div class="toc-item" onclick="openTool('exam')"><span class="toc-num">XXII</span><span class="toc-icon">📝</span><span class="toc-name">試験・クイズ作成（APIなし）</span><span class="toc-dots"></span><span class="toc-desc">口頭・筆記・クイズ</span></div>
        <div class="toc-item" onclick="openTool('examapi')"><span class="toc-num">XXIII</span><span class="toc-icon">📝</span><span class="toc-name">試験・クイズ作成（APIあり）</span><span class="toc-dots"></span><span class="toc-desc">キーで自動生成</span></div>
        <div class="toc-item" onclick="openTool('facili')"><span class="toc-num">XXIV</span><span class="toc-icon">🎤</span><span class="toc-name">ファシリ・議論サポート（APIなし）</span><span class="toc-dots"></span><span class="toc-desc">進行・タイマー・結論宿題</span></div>
        <div class="toc-item" onclick="openTool('faciliapi')"><span class="toc-num">XXV</span><span class="toc-icon">🎤</span><span class="toc-name">ファシリ・議論サポート（APIあり）</span><span class="toc-dots"></span><span class="toc-desc">キーで進行プラン生成</span></div>
        <div class="toc-item" onclick="openTool('consul')"><span class="toc-num">XXVI</span><span class="toc-icon">💼</span><span class="toc-name">ITコンサル法人練習（APIなし）</span><span class="toc-dots"></span><span class="toc-desc">商談ロールプレイ</span></div>
        <div class="toc-item" onclick="openTool('consulapi')"><span class="toc-num">XXVII</span><span class="toc-icon">💼</span><span class="toc-name">ITコンサル法人練習（APIあり）</span><span class="toc-dots"></span><span class="toc-desc">キーで自動生成</span></div>
        <div class="toc-item" onclick="openTool('kotei')"><span class="toc-num">XXVIII</span><span class="toc-icon">🥞</span><span class="toc-name">開発工程の教え方（APIなし）</span><span class="toc-dots"></span><span class="toc-desc">文系=ホットケーキ/理系=原理</span></div>
        <div class="toc-item" onclick="openTool('koteiapi')"><span class="toc-num">XXIX</span><span class="toc-icon">🥞</span><span class="toc-name">開発工程の教え方（APIあり）</span><span class="toc-dots"></span><span class="toc-desc">キーで自動生成</span></div>
        <div class="toc-item" onclick="openTool('fact')"><span class="toc-num">XXX</span><span class="toc-icon">🔬</span><span class="toc-name">ファクト報告ジェネレーター（理系新卒）</span><span class="toc-dots"></span><span class="toc-desc">嘘なし・事実だけで書く</span></div>
      </div>
      <div class="book-foot">
        <div class="quill">✒</div>
        <div class="author">written by Yukiko Ishiguro</div>
        <div class="motto">面白きこともなき世を面白く</div>
        <div class="test-badge">
          <span class="tb-title">✔ PRO品質テスト 全工程合格</span><br>
          <span class="tb-items">① 単体 ② 結合 ③ ホワイトボックス ④ ブラックボックス ⑤ 実描画モック ⑥ 統合E2E ⑦ オフライン監査</span>
          <span class="tb-date">v2.2 ・ 全30ツール／検出バグ 0 ・ 全工程テスト合格日 2026年05月23日（土）</span>
        </div>
      </div>
    </div>
  </div>

  <div class="frame-wrap stage" id="frameWrap">
    <iframe id="frm-nip" class="active" title="日報ジェネレーター" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 日報作成ジェネレーター 🐰</title>
<style>
  :root{
    --cream:#fffaf2; --cream2:#fdf3e3; --paper:#fff; --orange:#ea7d2b; --orange-deep:#cf6315;
    --gold:#c79a2e; --gold-soft:#e7c873; --ink:#3a2c20; --ink-soft:#6b5848;
    --line:#ecd9bd; --line-soft:#f3e6cf; --ok:#3f8f5f; --shadow:0 10px 30px rgba(180,120,40,.10);
    --bg1:#ffe9c8; --bg1a:rgba(255,233,200,0); --bg2:#ffeede; --bg2a:rgba(255,238,222,0);
    --accent:var(--orange); --accent-deep:var(--orange-deep);
    --headfont:&quot;Hiragino Sans&quot;,&quot;Hiragino Kaku Gothic ProN&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;
  }
  /* テーマ：日本語＝緑ベース（オフホワイト×フォレストグリーン） */
  body.theme-jp{
    --cream:#f6faf5; --cream2:#eef5ec; --paper:#fffefb; --orange:#3f8f5f; --orange-deep:#2c6a45;
    --gold:#6fae7e; --gold-soft:#bfe0c7; --ink:#26352b; --ink-soft:#5a6f60;
    --line:#d8e7da; --line-soft:#e8f1e8; --ok:#3f8f5f; --shadow:0 10px 30px rgba(60,140,90,.12);
    --bg1:#dff0e2; --bg1a:rgba(223,240,226,0); --bg2:#e9f3e6; --bg2a:rgba(233,243,230,0);
    --accent:#3f8f5f; --accent-deep:#2c6a45;
    --headfont:&quot;Hiragino Sans&quot;,&quot;Hiragino Kaku Gothic ProN&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;
  }
  /* テーマ：英語＝カナダ風（メープルレッド×ホワイト、クリーンなサンセリフ見出し） */
  body.theme-uk{
    --cream:#fbf6f5; --cream2:#f4eceb; --paper:#ffffff; --orange:#d52b1e; --orange-deep:#a81d13;
    --gold:#e07a70; --gold-soft:#f3c9c4; --ink:#2b2b2d; --ink-soft:#6a5d5d;
    --line:#eed7d4; --line-soft:#f6e8e6; --ok:#3f8f5f; --shadow:0 10px 30px rgba(213,43,30,.12);
    --bg1:#fbe2df; --bg1a:rgba(251,226,223,0); --bg2:#f6eae8; --bg2a:rgba(246,234,232,0);
    --accent:#d52b1e; --accent-deep:#a81d13;
    --headfont:&quot;Helvetica Neue&quot;,Helvetica,Arial,&quot;Segoe UI&quot;,sans-serif;
  }
  body.theme-uk h1, body.theme-uk h2, body.theme-uk header.hero h1{font-family:var(--headfont);letter-spacing:.2px;}
  .lang-switch{position:absolute;top:14px;right:16px;display:flex;gap:6px;z-index:2;}
  /* ヘッダーのワンポイント（テーマ連動：日本=トウモロコシ／英=メープル） */
  .hero-motif{position:absolute;top:14px;left:16px;width:36px;height:48px;opacity:.92;z-index:2;}
  .hero-motif svg{width:100%;height:100%;display:none;filter:drop-shadow(0 2px 4px rgba(0,0,0,.08));}
  body.theme-jp .hero-motif .motif-corn{display:block;}
  body.theme-uk .hero-motif .motif-maple{display:block;}
  @media (max-width:520px){ .hero-motif{width:28px;height:38px;top:12px;left:12px;} }
  .lang-btn{border:1px solid var(--line);background:var(--paper);color:var(--ink-soft);border-radius:999px;
    padding:5px 12px;cursor:pointer;font-weight:700;font-size:.78rem;}
  .lang-btn.active{background:linear-gradient(135deg,var(--accent),var(--gold));color:#fff;border-color:transparent;}
  header.hero{position:relative;}
  /* 🐰 は言語ボタンの下・右寄せに置き、タイトル文字と重ならないようにする */
  .bunny{position:absolute;top:50px;right:24px;font-size:30px;filter:drop-shadow(0 4px 8px rgba(120,160,120,.25));z-index:1;}
  @media (max-width:520px){ .bunny{top:46px;right:14px;font-size:26px;} }
  
  body{margin:0;font-family:&quot;Hiragino Sans&quot;,&quot;Hiragino Kaku Gothic ProN&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;
    color:var(--ink);line-height:1.7;-webkit-font-smoothing:antialiased;
    background:radial-gradient(900px 500px at 110% -10%, var(--bg1) 0%, var(--bg1a) 55%),
      radial-gradient(800px 600px at -10% 10%, var(--bg2) 0%, var(--bg2a) 50%),
      linear-gradient(180deg,var(--cream) 0%,var(--cream2) 100%);}
  .wrap{max-width:880px;margin:0 auto;padding:0 18px 80px;}

  header.hero{margin-top:32px;background:var(--paper);border:1px solid var(--line);border-radius:22px;
    padding:26px 30px;box-shadow:var(--shadow);position:relative;overflow:hidden;}
  header.hero::before{content:&quot;&quot;;position:absolute;inset:0 0 auto 0;height:6px;
    background:linear-gradient(90deg,var(--gold-soft),var(--orange),var(--gold));}
  /* タイトル群はmotif(左)と🐰(右)に重ならないよう余白を確保 */
  header.hero h1{margin:0 0 6px;font-size:1.4rem;font-weight:800;padding-left:52px;padding-right:46px;min-height:34px;}
  header.hero p{margin:0;color:var(--ink-soft);font-size:.92rem;padding-right:46px;}
  @media (max-width:520px){
    header.hero h1{padding-left:40px;padding-right:40px;padding-top:34px;}
    header.hero p{padding-right:34px;}
    .hero-motif{top:40px;}
    .bunny{top:74px;}
  }

  .tabs{display:flex;gap:8px;margin:18px 0;flex-wrap:wrap;}
  .tab{flex:1 1 auto;min-width:150px;text-align:center;cursor:pointer;border:1px solid var(--line);
    background:var(--paper);padding:11px 14px;border-radius:14px;font-weight:700;color:var(--ink-soft);
    box-shadow:var(--shadow);transition:.15s;}
  .tab:hover{transform:translateY(-1px);}
  .tab.active{color:#fff;border-color:transparent;background:linear-gradient(135deg,var(--orange),var(--gold));}

  .panel{display:none;background:var(--paper);border:1px solid var(--line);border-radius:20px;
    padding:24px 26px;box-shadow:var(--shadow);}
  .panel.active{display:block;animation:rise .4s ease both;}
  @keyframes rise{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}

  h2{font-size:1.05rem;font-weight:800;margin:4px 0 14px;padding-left:14px;position:relative;}
  h2::before{content:&quot;&quot;;position:absolute;left:0;top:.18em;bottom:.18em;width:6px;border-radius:6px;
    background:linear-gradient(180deg,var(--orange),var(--gold));}
  h3{font-size:.92rem;font-weight:800;color:var(--orange-deep);margin:20px 0 8px;}
  .hint{font-size:.8rem;color:var(--ink-soft);margin:-2px 0 8px;}

  label{display:block;font-size:.82rem;font-weight:700;color:var(--ink-soft);margin:12px 0 4px;}
  input,select,textarea{width:100%;font:inherit;color:var(--ink);background:#fffdf9;
    border:1px solid var(--line);border-radius:10px;padding:9px 11px;outline:none;}
  input:focus,select:focus,textarea:focus{border-color:var(--orange);box-shadow:0 0 0 3px #ffe6c9;}
  textarea{resize:vertical;min-height:62px;line-height:1.6;}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:0 16px;}
  .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0 14px;}

  .task-row{display:grid;grid-template-columns:1.3fr .8fr 1.6fr 1.1fr auto;gap:8px;margin:8px 0;align-items:center;}
  .task-row input,.task-row select{margin:0;}
  .del{background:#fff1e6;border:1px solid #ffd6ad;color:var(--orange-deep);border-radius:9px;
    width:34px;height:34px;cursor:pointer;font-size:1rem;line-height:1;}
  .addbtn{margin-top:8px;background:#fff3e3;border:1px dashed var(--orange);color:var(--orange-deep);
    border-radius:10px;padding:8px 14px;cursor:pointer;font-weight:700;}

  .checks label{display:flex;align-items:center;gap:8px;font-weight:500;color:var(--ink);margin:6px 0;cursor:pointer;}
  .checks input{width:auto;}

  .toggle{display:flex;align-items:center;gap:8px;margin:14px 0 2px;font-weight:700;color:var(--ink-soft);cursor:pointer;}
  .toggle input{width:auto;}
  .collapsible{display:none;}
  .collapsible.open{display:block;}

  .gen{margin-top:22px;width:100%;background:linear-gradient(135deg,var(--orange),var(--orange-deep));
    color:#fff;border:none;border-radius:14px;padding:14px;font-size:1rem;font-weight:800;cursor:pointer;
    box-shadow:0 8px 20px rgba(207,99,21,.3);}
  .gen:hover{filter:brightness(1.04);}

  .outwrap{margin-top:22px;background:var(--paper);border:1px solid var(--line);border-radius:20px;
    padding:20px 22px;box-shadow:var(--shadow);}
  .outhead{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px;}
  .outhead h2{margin:0;}
  .outbtns{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end;}
  .outbtns button{border:1px solid var(--line);background:#fff7ee;color:var(--ink);border-radius:10px;
    padding:8px 14px;cursor:pointer;font-weight:700;}
  .outbtns button:hover{background:#ffeede;}
  #output{width:100%;min-height:320px;font-family:&quot;SFMono-Regular&quot;,Consolas,Menlo,monospace;
    font-size:.86rem;line-height:1.65;background:#fffdf8;border:1px solid var(--line);border-radius:12px;padding:14px;}

  .toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(20px);
    background:var(--ink);color:#fff;padding:10px 20px;border-radius:999px;font-weight:700;font-size:.9rem;
    opacity:0;pointer-events:none;transition:.25s;z-index:50;}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

  .foot{text-align:center;color:var(--gold);font-weight:700;font-size:.8rem;letter-spacing:.06em;margin-top:24px;}

  /* ---- 時間割（HR学校風） ---- */
  .hr-card{background:linear-gradient(160deg,#fff6e9,#fff);border:1px solid var(--line);
    border-radius:14px;padding:14px 16px;margin:10px 0 16px;}
  .hr-card h3{margin:0 0 8px;}
  .tt-head,.tt-row{display:grid;
    grid-template-columns:60px 66px 64px 54px 54px 1.1fr 1.1fr 64px 34px 50px 28px 28px;gap:5px;align-items:center;}
  .tt-head{font-size:.72rem;font-weight:700;color:var(--ink-soft);padding:0 2px 4px;}
  .tt-row{margin:5px 0;border-left:6px solid transparent;padding-left:6px;border-radius:6px;transition:.2s;}
  .tt-row input,.tt-row select{margin:0;padding:7px 8px;font-size:.86rem;}
  .tt-row .tt-custom{padding:6px;font-size:.8rem;}
  .tt-row.brk{opacity:.85;}
  .tt-row.brk input[disabled]{background:#f6efe2;color:var(--ink-soft);}
  /* 区分カラー（左帯＋淡い背景） */
  .tt-row.kind-lesson{border-left-color:#e0792b;background:#fff5ea;}   /* 授業 */
  .tt-row.kind-meeting{border-left-color:#3f7fae;background:#eef6fb;}  /* 会議 */
  .tt-row.kind-work{border-left-color:#3f8f5f;background:#eef8f1;}     /* 作業 */
  .tt-row.kind-break{border-left-color:#b8a26a;background:#faf6ec;}    /* 休憩 */
  .tt-row.kind-other{border-left-color:#8a6fae;background:#f4f0fa;}    /* その他 */
  /* 差し込み（割込）コマ */
  .tt-row.insert{box-shadow:inset 3px 0 0 #d8492b, 0 0 0 1px #f3b8a6;}
  .tt-row.insert::before{content:&quot;⚡&quot;;position:absolute;}
  .tt-ins{display:flex;align-items:center;justify-content:center;gap:2px;font-size:.72rem;color:var(--ink-soft);cursor:pointer;}
  .tt-ins input{width:auto;margin:0;}
  .ins-btn{border:1px solid var(--gold-soft);background:#fff3e2;color:var(--orange-deep);border-radius:8px;
    cursor:pointer;font-weight:800;font-size:.9rem;line-height:1;padding:0;}
  .ins-btn:hover{background:#ffe6c9;}

  /* 月次データ統合：ソース別取り込み */
  .hub-src{display:flex;flex-direction:column;gap:8px;margin:8px 0;}
  .hub-src-row{display:flex;flex-wrap:wrap;gap:6px;align-items:center;}
  .hub-src-label{flex:0 0 auto;font-weight:800;color:var(--orange-deep);min-width:88px;}
  .hub-src-row button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:7px 12px;cursor:pointer;font-weight:700;font-size:.84rem;}
  .hub-src-row button:hover{background:#fff3e2;}
  .tt-min{font-size:.8rem;color:var(--ink-soft);text-align:center;}
  .tt-legend{font-size:.74rem;color:var(--ink-soft);margin:4px 0 0;}
  .kind-chip{display:inline-block;padding:1px 8px;border-radius:999px;font-size:.72rem;font-weight:700;margin-right:6px;}
  .kc-lesson{background:#ffe5cf;color:#a85416;}
  .kc-meeting{background:#dcecf7;color:#2c5d80;}
  .kc-work{background:#dcefe2;color:#2c6a47;}
  .kc-break{background:#efe7d2;color:#7a6a3e;}

  /* よく使うタグ ボタン */
  .tagbar-wrap{border:1px dashed var(--line);border-radius:12px;padding:10px 12px;margin:10px 0;background:#fffdf8;}
  .tagbar-head{display:flex;justify-content:space-between;align-items:baseline;gap:8px;flex-wrap:wrap;margin-bottom:8px;}
  .tagbar{display:flex;flex-wrap:wrap;gap:6px;}
  .tag-btn{display:inline-flex;align-items:center;gap:4px;border:1px solid var(--gold-soft);
    background:#fff3e2;color:var(--orange-deep);border-radius:999px;padding:5px 12px;cursor:pointer;
    font-weight:700;font-size:.8rem;transition:.12s;}
  .tag-btn:hover{background:#ffe6c9;transform:translateY(-1px);}
  .tag-btn .x{color:#c4441f;font-weight:800;opacity:.5;margin-left:2px;}
  .tag-btn .x:hover{opacity:1;}
  .tagbar-add{display:flex;gap:6px;margin-top:8px;align-items:center;}
  .tagbar-add input{flex:1;}
  .tagbar-add .mini-btn{flex:0 0 auto;border:1px solid var(--line);background:#fff;border-radius:8px;padding:7px 12px;cursor:pointer;font-weight:700;font-size:.8rem;}
  .calc{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:14px 0 4px;}
  .calc .cell{background:var(--paper);border:1px solid var(--line);border-radius:12px;
    padding:12px;text-align:center;box-shadow:var(--shadow);}
  .calc .num{font-size:1.35rem;font-weight:800;color:var(--orange-deep);line-height:1.2;}
  .calc .lab{font-size:.72rem;color:var(--ink-soft);margin-top:2px;}
  .bar{height:14px;border-radius:999px;background:#f1e3c9;overflow:hidden;margin:6px 0 2px;}
  .bar > i{display:block;height:100%;background:linear-gradient(90deg,var(--orange),var(--gold));width:0;transition:width .3s;}
  /* 区分別 内訳バー */
  .kindbar{display:flex;height:16px;border-radius:999px;overflow:hidden;margin:10px 0 4px;background:#f1e3c9;}
  .kindbar > span{height:100%;}
  .kb-lesson{background:#e0792b;} .kb-meeting{background:#3f7fae;} .kb-work{background:#3f8f5f;}

  /* 帰りのHR 自動励ましカード */
  .cheer-card{margin:14px 0 4px;border-radius:14px;padding:16px 18px;border:1px solid var(--line);
    background:linear-gradient(160deg,#fff6e9,#fff);display:none;animation:rise .4s ease both;}
  .cheer-card.show{display:block;}
  .cheer-card .emoji{font-size:1.6rem;}
  .cheer-card .title{font-weight:800;font-size:1.05rem;margin:4px 0;color:var(--orange-deep);}
  .cheer-card .msg{font-size:.92rem;color:var(--ink);}
  .cheer-card.lv-hanamaru{background:linear-gradient(160deg,#fff0f3,#fff7ea);border-color:#f3c6cf;}
  .cheer-card.lv-great{background:linear-gradient(160deg,#fff6e9,#fffdf5);}
  .cheer-card.lv-good{background:linear-gradient(160deg,#f3f9ff,#fff);border-color:#cfe2f0;}
  .cheer-card.lv-ok{background:linear-gradient(160deg,#f1f9f3,#fff);border-color:#cfe6d6;}

  /* 30日ログ（保存・入出力） */
  .log-actions{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0;}
  .log-actions button{border:1px solid var(--line);background:#fff7ee;color:var(--ink);
    border-radius:10px;padding:9px 14px;cursor:pointer;font-weight:700;font-size:.88rem;}
  .log-actions button:hover{background:#ffeede;}
  .log-actions .primary{background:linear-gradient(135deg,var(--orange),var(--orange-deep));color:#fff;border:none;}
  .log-actions .danger{background:#fff0ec;border-color:#ffc9b6;color:#c4441f;}
  .daylist{margin:6px 0;border:1px solid var(--line);border-radius:12px;overflow:hidden;}
  .daylist .empty{padding:14px;color:var(--ink-soft);font-size:.88rem;text-align:center;}
  .day-item{display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:center;
    padding:10px 12px;border-top:1px solid var(--line-soft);font-size:.86rem;}
  .day-item:first-child{border-top:none;}
  .day-item .meta{color:var(--ink-soft);font-size:.78rem;}
  .day-item .mini-btn{border:1px solid var(--line);background:#fff;border-radius:8px;padding:5px 10px;cursor:pointer;font-weight:700;font-size:.78rem;}
  .day-item .mini-btn.del{color:#c4441f;border-color:#ffc9b6;background:#fff5f2;width:auto;height:auto;}
  .agg{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:10px 0;}
  .agg .cell{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:12px;text-align:center;box-shadow:var(--shadow);}
  .agg .num{font-size:1.2rem;font-weight:800;color:var(--orange-deep);}
  .agg .lab{font-size:.72rem;color:var(--ink-soft);margin-top:2px;}
  .hidden-file{display:none;}

  /* スキルシート（案件欄） */
  .sk-block{border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin:10px 0;background:#fffdf8;}
  .sk-block .bk-head{display:flex;justify-content:space-between;align-items:baseline;gap:8px;flex-wrap:wrap;}
  .sk-block .bk-title{font-weight:800;color:var(--orange-deep);font-size:.95rem;}
  .sk-guide{font-size:.74rem;color:var(--ink-soft);background:#fff3e2;border-radius:8px;padding:4px 8px;}
  .sk-count{font-size:.74rem;font-weight:700;color:var(--ink-soft);}
  .sk-count.warn{color:#c4441f;}
  .sk-count.okc{color:#2c7a52;}
  .sk-case{display:inline-block;font-weight:800;border-radius:999px;padding:2px 12px;font-size:.8rem;
    background:#ffe5cf;color:#a85416;}
  .sk-check label{display:flex;align-items:flex-start;gap:8px;font-weight:500;color:var(--ink);margin:7px 0;cursor:pointer;font-size:.88rem;}
  .sk-check input{width:auto;margin-top:3px;}
  .work-row{display:flex;gap:6px;align-items:center;margin:5px 0;}
  .work-row .idx{font-size:.78rem;color:var(--ink-soft);width:22px;text-align:right;flex:0 0 auto;}
  .work-row input{margin:0;}
  .work-row .del{flex:0 0 auto;}

  /* 進捗報告タスク行 */
  .ci-row{display:grid;grid-template-columns:1.6fr 92px 64px 1fr 32px;gap:6px;align-items:center;margin:5px 0;}
  .ci-row input,.ci-row select{margin:0;padding:7px 8px;font-size:.86rem;}
  .ci-row .del{width:32px;height:32px;}
  @media(max-width:640px){
    .ci-row{grid-template-columns:1fr 1fr 30px;}
    .ci-row .ci-name{grid-column:1 / -1;}
    .ci-row .ci-note{grid-column:1 / span 2;}
  }

  /* 一人MTG（PDCA） */
  .pdca-timer{background:linear-gradient(160deg,#fff6e9,#fffdf5);border:1px solid var(--line);
    border-radius:16px;padding:18px;text-align:center;box-shadow:var(--shadow);margin:12px 0;}
  .pdca-timer .clock{font-size:3rem;font-weight:800;color:var(--orange-deep);font-variant-numeric:tabular-nums;line-height:1.1;}
  .pdca-timer .phase{font-size:1.05rem;font-weight:800;margin-bottom:4px;}
  .pdca-timer .sub{font-size:.8rem;color:var(--ink-soft);margin-top:4px;}
  .pdca-timer.running{border-color:var(--orange);}
  .pdca-ctrl{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:12px;}
  .pdca-ctrl button{border:1px solid var(--line);background:#fff7ee;color:var(--ink);border-radius:10px;
    padding:9px 16px;cursor:pointer;font-weight:700;font-size:.9rem;}
  .pdca-ctrl button:hover{background:#ffeede;}
  .pdca-ctrl .primary{background:linear-gradient(135deg,var(--orange),var(--orange-deep));color:#fff;border:none;}
  .pdca-step{border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin:10px 0;background:#fffdf8;border-left:6px solid var(--gold);}
  .pdca-step.active{border-left-color:var(--orange);background:#fff5ea;}
  .pdca-step .hd{display:flex;justify-content:space-between;align-items:baseline;gap:8px;flex-wrap:wrap;margin-bottom:6px;}
  .pdca-step .nm{font-weight:800;color:var(--orange-deep);}
  .pdca-step .mins{display:flex;align-items:center;gap:4px;font-size:.8rem;color:var(--ink-soft);}
  .pdca-step .mins input{width:54px;margin:0;padding:5px 6px;text-align:center;}
  .pdca-bar{height:8px;background:#f0e6d4;border-radius:999px;overflow:hidden;margin-top:8px;}
  .pdca-bar i{display:block;height:100%;background:linear-gradient(90deg,var(--orange),var(--gold));width:0;transition:width .3s;}

  /* 自由ひな形（日報） */
  .tpl-fields{border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin:10px 0;background:#fffdf8;}
  .tpl-fields .ph-row{display:grid;grid-template-columns:160px 1fr;gap:8px;align-items:start;margin:6px 0;}
  .tpl-fields .ph-row label{font-weight:700;color:var(--ink);padding-top:7px;font-size:.86rem;}
  .tpl-fields .ph-row textarea{min-height:40px;}
  .tpl-fields .empty{color:var(--ink-soft);font-size:.86rem;}
  .tpl-saved{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:8px 0;}
  .tpl-chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--gold-soft);
    background:#fff3e2;color:var(--orange-deep);border-radius:999px;padding:5px 12px;cursor:pointer;font-weight:700;font-size:.82rem;}
  .tpl-chip:hover{background:#ffe6c9;}
  .tpl-chip.cur{background:linear-gradient(135deg,var(--orange),var(--orange-deep));color:#fff;border:none;}
  .tpl-chip .x{opacity:.55;font-weight:800;}
  .tpl-chip .x:hover{opacity:1;color:#c4441f;}
  @media(max-width:640px){
    .tpl-fields .ph-row{grid-template-columns:1fr;}
    .tpl-fields .ph-row label{padding-top:0;}
    .agg{grid-template-columns:repeat(2,1fr);}
  }
  @media(max-width:640px){
    .grid,.grid3{grid-template-columns:1fr;}
    .task-row{grid-template-columns:1fr 1fr;}
    .task-row .t-purpose,.task-row .t-time{grid-column:span 2;}
    .bunny{font-size:28px;}
    .calc{grid-template-columns:repeat(2,1fr);}
    .tt-head{display:none;}
    .tt-row{grid-template-columns:1fr 1fr 30px;grid-auto-rows:auto;
      border:1px solid var(--line-soft);border-left-width:6px;border-radius:10px;padding:8px;background:#fffdf8;}
    .tt-row .tt-label{grid-column:1 / -1;font-weight:700;}
    .tt-row .tt-kind{grid-column:span 2;}
    .tt-row .tt-start,.tt-row .tt-end{grid-column:span 1;}
    .tt-row .tt-plan,.tt-row .tt-actual{grid-column:1 / -1;}
    .tt-row .tt-status{grid-column:span 2;}
    .tt-row .tt-min{grid-column:span 1;}
  }

  /* ===== ボタンのクリック挙動（影・押し込み） ===== */
  button{ transition:transform .08s ease, box-shadow .12s ease, filter .12s ease, background .12s ease; }
  /* 主要ボタンは通常時に軽い影、ホバーで浮き、クリックで沈む */
  .gen, .outbtns button, .log-actions button, .addbtn, .lang-btn,
  .pdca-ctrl button, .del, .ins-btn, .qtag, .ci-add, .sk-addbtn, .tpl-chip{
    box-shadow:0 2px 5px rgba(0,0,0,.08);
  }
  .gen:hover, .outbtns button:hover, .log-actions button:hover, .addbtn:hover, .lang-btn:hover,
  .pdca-ctrl button:hover, .del:hover, .ins-btn:hover, .qtag:hover, .tpl-chip:hover{
    box-shadow:0 4px 10px rgba(0,0,0,.14); transform:translateY(-1px);
  }
  /* クリック（押下）時：沈み込み＋内側の影で「押した」感触 */
  .gen:active, .outbtns button:active, .log-actions button:active, .addbtn:active, .lang-btn:active,
  .pdca-ctrl button:active, .del:active, .ins-btn:active, .qtag:active, .tab:active,
  .ci-add:active, .sk-addbtn:active, .tpl-chip:active, button:active{
    transform:translateY(1px) scale(.985);
    box-shadow:inset 0 3px 6px rgba(0,0,0,.18);
    filter:brightness(.97);
  }
  /* タブも軽い押し込み */
  .tab{ transition:transform .08s ease, box-shadow .12s ease, background .12s ease; }
  .tab:active{ transform:translateY(1px) scale(.99); }
  /* キーボード操作のフォーカスリング（アクセシビリティ） */
  button:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }

  .lang-switch{display:none !important;}
</style>
</head>
<body>
<div class=&quot;wrap&quot;>

  <header class=&quot;hero&quot;>
    <div class=&quot;hero-motif&quot; aria-hidden=&quot;true&quot;>
      <!-- 日本版：トウモロコシ -->
      <svg class=&quot;motif-corn&quot; viewBox=&quot;0 0 48 64&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;>
        <g>
          <!-- 葉（外皮） -->
          <path d=&quot;M24 60 C14 56 9 44 11 30 C16 34 21 40 24 50 Z&quot; fill=&quot;var(--gold-soft)&quot;/>
          <path d=&quot;M24 60 C34 56 39 44 37 30 C32 34 27 40 24 50 Z&quot; fill=&quot;var(--gold)&quot;/>
          <!-- 実 -->
          <path d=&quot;M24 6 C33 6 38 16 38 30 C38 44 31 56 24 58 C17 56 10 44 10 30 C10 16 15 6 24 6 Z&quot; fill=&quot;var(--accent)&quot;/>
          <!-- 粒 -->
          <g fill=&quot;var(--gold-soft)&quot; opacity=&quot;0.95&quot;>
            <circle cx=&quot;19&quot; cy=&quot;18&quot; r=&quot;2.1&quot;/><circle cx=&quot;24&quot; cy=&quot;16&quot; r=&quot;2.1&quot;/><circle cx=&quot;29&quot; cy=&quot;18&quot; r=&quot;2.1&quot;/>
            <circle cx=&quot;17&quot; cy=&quot;25&quot; r=&quot;2.1&quot;/><circle cx=&quot;22&quot; cy=&quot;24&quot; r=&quot;2.1&quot;/><circle cx=&quot;27&quot; cy=&quot;24&quot; r=&quot;2.1&quot;/><circle cx=&quot;31&quot; cy=&quot;25&quot; r=&quot;2.1&quot;/>
            <circle cx=&quot;17&quot; cy=&quot;32&quot; r=&quot;2.1&quot;/><circle cx=&quot;22&quot; cy=&quot;31&quot; r=&quot;2.1&quot;/><circle cx=&quot;27&quot; cy=&quot;31&quot; r=&quot;2.1&quot;/><circle cx=&quot;31&quot; cy=&quot;32&quot; r=&quot;2.1&quot;/>
            <circle cx=&quot;18&quot; cy=&quot;39&quot; r=&quot;2.1&quot;/><circle cx=&quot;23&quot; cy=&quot;38&quot; r=&quot;2.1&quot;/><circle cx=&quot;28&quot; cy=&quot;38&quot; r=&quot;2.1&quot;/>
            <circle cx=&quot;20&quot; cy=&quot;46&quot; r=&quot;2&quot;/><circle cx=&quot;25&quot; cy=&quot;45&quot; r=&quot;2&quot;/>
          </g>
          <!-- ひげ -->
          <path d=&quot;M22 6 C20 1 18 1 16 3 M24 5 C24 0 26 0 27 2 M26 6 C28 1 31 2 31 4&quot; stroke=&quot;var(--gold)&quot; stroke-width=&quot;1.4&quot; fill=&quot;none&quot; stroke-linecap=&quot;round&quot;/>
        </g>
      </svg>
      <!-- 英語版（カナダ）：紅葉（メープルリーフ） -->
      <svg class=&quot;motif-maple&quot; viewBox=&quot;0 0 100 100&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;>
        <path fill=&quot;var(--accent)&quot; d=&quot;M50 6
 c0 4 2 7 5 6 l-2 8 9-3 -1 6 7-2 -3 9 7-1 -4 9 9-2 -2 7 6-1 -8 14 13-2 0 5 -16 2 1 4 -13 3 7 9 -10-2 1 11 -7-6 -7 6 1-11 -10 2 7-9 -13-3 1-4 -16-2 0-5 13 2 -8-14 6 1 -2-7 9 2 -4-9 7 1 -3-9 7 2 -1-6 9 3 -2-8 c3 1 5-2 5-6 z&quot;/>
      </svg>
    </div>
    <div class=&quot;lang-switch&quot;>
      <button type=&quot;button&quot; id=&quot;langJp&quot; class=&quot;lang-btn active&quot; onclick=&quot;setLang('jp')&quot;>🇯🇵 日本語</button>
      <button type=&quot;button&quot; id=&quot;langEn&quot; class=&quot;lang-btn&quot; onclick=&quot;setLang('en')&quot;>🇬🇧 English</button>
    </div>
    <div class=&quot;bunny&quot;>🐰</div>
    <h1 data-i18n=&quot;title&quot;>うさうさ 日報作成ジェネレーター</h1>
    <p data-i18n=&quot;subtitle&quot;>登録不要・インストール不要。ブラウザだけで日報・ふりかえり・スキルシート・月末の工数集計まで作れる無料ツールです。入力した内容はあなたの端末の中だけに保存され、どこにも送信されません。</p>
  </header>

  <div class=&quot;tabs&quot;>
    <div class=&quot;tab active&quot; data-tab=&quot;report&quot;>📋 退勤前報告（業務日報）</div>
    <div class=&quot;tab&quot; data-tab=&quot;memo&quot;>📝 メモ版 日報・進捗</div>
    <div class=&quot;tab&quot; data-tab=&quot;chat&quot;>💬 相談チャットテンプレ</div>
    <div class=&quot;tab&quot; data-tab=&quot;timetable&quot;>🏫 時間割（HR学校風）</div>
    <div class=&quot;tab&quot; data-tab=&quot;skill&quot;>📐 スキルシート（案件欄）</div>
    <div class=&quot;tab&quot; data-tab=&quot;pdca&quot;>🔄 一人MTG（PDCA）</div>
    <div class=&quot;tab&quot; data-tab=&quot;mtg2&quot;>🎯 一人MTG2（目標・KPT）</div>
    <div class=&quot;tab&quot; data-tab=&quot;tpl&quot;>🧩 自由ひな形（日報）</div>
    <div class=&quot;tab&quot; data-tab=&quot;hub&quot;>🗂 月次データ統合</div>
  </div>

  <!-- ============ TAB 1: 退勤前報告 ============ -->
  <div class=&quot;panel active&quot; id=&quot;panel-report&quot;>
    <h2>① 基本情報</h2>
    <div class=&quot;grid&quot;>
      <div><label>日付</label><input id=&quot;r_date&quot; placeholder=&quot;2026年4月1日(水)&quot;></div>
      <div><label>氏名</label><input id=&quot;r_name&quot; placeholder=&quot;石黒 友季子&quot; value=&quot;石黒 友季子&quot;></div>
    </div>
    <div class=&quot;grid3&quot;>
      <div><label>場所</label>
        <select id=&quot;r_place&quot;><option>対面</option><option>リモート</option><option>在宅</option><option>ハイブリッド</option></select>
      </div>
      <div><label>勤務時間（開始〜終了）</label><input id=&quot;r_time&quot; placeholder=&quot;9:00～18:00&quot;></div>
      <div><label>実働</label><input id=&quot;r_hours&quot; placeholder=&quot;8h&quot;></div>
    </div>

    <h2 style=&quot;margin-top:24px;&quot;>② 本日の業務内容</h2>
    <p class=&quot;hint&quot;>タスクごとに 状態・目的・所要時間 を入力。状態は 完了／対応中／未完了。</p>
    <div id=&quot;taskList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;addTask()&quot;>＋ タスクを追加</button>

    <h2 style=&quot;margin-top:24px;&quot;>③ 成果・進捗</h2>
    <div class=&quot;grid3&quot;>
      <div><label>今日の成果物</label><input id=&quot;r_deliver&quot; placeholder=&quot;◯◯を完成&quot;></div>
      <div><label>進捗率</label><input id=&quot;r_rate&quot; placeholder=&quot;80%&quot;></div>
      <div><label>KPIに対する進捗</label><input id=&quot;r_kpi&quot; placeholder=&quot;週次目標の60%&quot;></div>
    </div>

    <h2 style=&quot;margin-top:24px;&quot;>④ 課題・問題点</h2>
    <p class=&quot;hint&quot;>該当しない欄は空のままでOK（空欄は出力されません）。</p>
    <div class=&quot;grid&quot;>
      <div><label>1. 発生した問題</label><textarea id=&quot;r_p1&quot;></textarea></div>
      <div><label>2. 前提・背景</label><textarea id=&quot;r_p2&quot;></textarea></div>
      <div><label>3. やりたいこと</label><textarea id=&quot;r_p3&quot;></textarea></div>
      <div><label>4. 解決方法</label><textarea id=&quot;r_p4&quot;></textarea></div>
      <div><label>5. 環境</label><textarea id=&quot;r_p5&quot;></textarea></div>
      <div><label>6. 原因（仮説）</label><textarea id=&quot;r_p6&quot;></textarea></div>
    </div>
    <label>7. 影響範囲</label><textarea id=&quot;r_p7&quot;></textarea>

    <h2 style=&quot;margin-top:24px;&quot;>⑤ 対応・アクション</h2>
    <label>明日の対応予定</label><textarea id=&quot;r_action&quot;></textarea>

    <h2 style=&quot;margin-top:24px;&quot;>⑥ 学び・気づき</h2>
    <div class=&quot;grid&quot;>
      <div><label>今日の学び</label><textarea id=&quot;r_learn&quot;></textarea></div>
      <div><label>次に活かすこと</label><textarea id=&quot;r_next&quot;></textarea></div>
    </div>

    <h2 style=&quot;margin-top:24px;&quot;>⑦ 共有事項（上長・関係者向け）</h2>
    <div class=&quot;grid3&quot;>
      <div><label>報告事項</label><textarea id=&quot;r_share&quot;></textarea></div>
      <div><label>相談事項</label><textarea id=&quot;r_consult&quot;></textarea></div>
      <div><label>支援依頼</label><textarea id=&quot;r_help&quot;></textarea></div>
    </div>

    <h2 style=&quot;margin-top:24px;&quot;>⑧ 明日の予定</h2>
    <div class=&quot;grid3&quot;>
      <div><label>タスク</label><textarea id=&quot;r_tmtask&quot;></textarea></div>
      <div><label>想定時間</label><input id=&quot;r_tmtime&quot; placeholder=&quot;09:00〜18:00（在宅）&quot;></div>
      <div><label>優先順位</label><textarea id=&quot;r_tmprio&quot;></textarea></div>
    </div>

    <button class=&quot;gen&quot; onclick=&quot;buildReport()&quot;>📋 業務日報を生成する</button>
  </div>

  <!-- ============ TAB 2: メモ版 ============ -->
  <div class=&quot;panel&quot; id=&quot;panel-memo&quot;>
    <h2>ヘッダ</h2>
    <div class=&quot;grid3&quot;>
      <div><label>日付</label><input id=&quot;m_date&quot; placeholder=&quot;2026/04/01（水）&quot;></div>
      <div><label>役割</label>
        <select id=&quot;m_role&quot;><option>IT研修講師</option><option>社内SE</option><option>SES</option><option>IT営業</option></select>
      </div>
      <div><label>気分</label>
        <select id=&quot;m_mood&quot;><option>😀</option><option>😐</option><option>😣</option></select>
      </div>
    </div>
    <label>一言</label><input id=&quot;m_word&quot; value=&quot;面白きこともなき世を面白く&quot;>

    <label class=&quot;toggle&quot;><input type=&quot;checkbox&quot; id=&quot;m_tt_on&quot;> 🕘 タイムテーブルを含める</label>
    <div class=&quot;collapsible&quot; id=&quot;m_tt_wrap&quot;>
      <p class=&quot;hint&quot;>1行ずつ自由記入（例：09:00-10:00 ｜ 朝会・メール処理）。空なら標準枠を出力します。</p>
      <textarea id=&quot;m_tt&quot; style=&quot;min-height:120px&quot;></textarea>
    </div>

    <h2 style=&quot;margin-top:22px;&quot;>✅ 今日すること</h2>
    <p class=&quot;hint&quot;>1行＝1項目。チェックボックス [ ] が自動で付きます。</p>
    <label>メイン業務</label><textarea id=&quot;m_today_main&quot;></textarea>
    <label>メイン業務以外（学習・整備・社内貢献）</label><textarea id=&quot;m_today_sub&quot;></textarea>
    <label>趣味枠（個人開発・記事・インプット）</label><textarea id=&quot;m_today_hobby&quot;></textarea>
    <label>今日 相談すること（@誰に / 何を / なぜ / 口頭 or Slack）</label><textarea id=&quot;m_today_talk&quot;></textarea>

    <h2 style=&quot;margin-top:22px;&quot;>📊 作業進捗</h2>
    <label>✓ 完了したこと</label><textarea id=&quot;m_done&quot;></textarea>
    <label>→ 着手中・持ち越し</label><textarea id=&quot;m_wip&quot;></textarea>
    <h3>⚠ ブロッカー / 詰まり</h3>
    <div class=&quot;grid&quot;>
      <div><label>内容</label><input id=&quot;m_bl_what&quot;></div>
      <div><label>影響</label><input id=&quot;m_bl_eff&quot;></div>
      <div><label>必要なアクション</label><input id=&quot;m_bl_act&quot;></div>
      <div><label>相手</label><input id=&quot;m_bl_who&quot;></div>
    </div>

    <h2 style=&quot;margin-top:22px;&quot;>🚩 依頼・相談 一覧</h2>
    <label>📨 サポート依頼（@誰／内容／期限／状態）</label><textarea id=&quot;m_req_sup&quot;></textarea>
    <label>🔍 レビュー依頼（@誰／URL／観点／期限）</label><textarea id=&quot;m_req_rev&quot;></textarea>
    <label>👥 他の人と相談が必要（関係者／議題／形式／いつ）</label><textarea id=&quot;m_req_talk&quot;></textarea>
    <label>💭 その他・気になっていること</label><textarea id=&quot;m_req_etc&quot;></textarea>

    <h2 style=&quot;margin-top:22px;&quot;>📅 明日すること</h2>
    <label>メイン業務</label><textarea id=&quot;m_tm_main&quot;></textarea>
    <label>メイン業務以外</label><textarea id=&quot;m_tm_sub&quot;></textarea>
    <label>趣味枠</label><textarea id=&quot;m_tm_hobby&quot;></textarea>
    <label>明日 相談すること</label><textarea id=&quot;m_tm_talk&quot;></textarea>

    <label class=&quot;toggle&quot;><input type=&quot;checkbox&quot; id=&quot;m_wk_on&quot;> 🗓 今週／来週も含める（金曜の棚卸し用）</label>
    <div class=&quot;collapsible&quot; id=&quot;m_wk_wrap&quot;>
      <label>今週すること（残り・メイン）</label><textarea id=&quot;m_wk_main&quot;></textarea>
      <label>今週すること（以外・趣味）</label><textarea id=&quot;m_wk_sub&quot;></textarea>
      <label>来週すること（メイン）</label><textarea id=&quot;m_nw_main&quot;></textarea>
      <label>来週すること（以外・趣味）</label><textarea id=&quot;m_nw_sub&quot;></textarea>
    </div>

    <label class=&quot;toggle&quot;><input type=&quot;checkbox&quot; id=&quot;m_mo_on&quot;> 📆 今月／来月も含める（月初・月末用）</label>
    <div class=&quot;collapsible&quot; id=&quot;m_mo_wrap&quot;>
      <label>今月すること（月次目標）</label><textarea id=&quot;m_mo_main&quot;></textarea>
      <label>今月すること（以外・趣味）</label><textarea id=&quot;m_mo_sub&quot;></textarea>
      <label>来月すること</label><textarea id=&quot;m_nm_main&quot;></textarea>
    </div>

    <h2 style=&quot;margin-top:22px;&quot;>🩺 デイリー習慣</h2>
    <div class=&quot;checks&quot; id=&quot;m_habits&quot;>
      <label><input type=&quot;checkbox&quot; value=&quot;☕ 休憩10分 × 社内記事ドラフト1段落&quot;> ☕ 休憩10分 × 社内記事ドラフト1段落</label>
      <label><input type=&quot;checkbox&quot; value=&quot;🏁 定時退社（残業せず帰る）&quot;> 🏁 定時退社（残業せず帰る）</label>
      <label><input type=&quot;checkbox&quot; value=&quot;📝 明日のタスクを書き切ってからPCを閉じる&quot;> 📝 明日のタスクを書き切ってからPCを閉じる</label>
      <label><input type=&quot;checkbox&quot; value=&quot;🧹 受信トレイ／DMをゼロ（既読＋ピン整理）&quot;> 🧹 受信トレイ／DMをゼロ（既読＋ピン整理）</label>
      <label><input type=&quot;checkbox&quot; value=&quot;🌙 持ち帰り思考をしない&quot;> 🌙 持ち帰り思考をしない</label>
    </div>

    <h2 style=&quot;margin-top:22px;&quot;>🧠 退社前 1分セルフチェック</h2>
    <div class=&quot;checks&quot; id=&quot;m_self&quot;>
      <label><input type=&quot;checkbox&quot; value=&quot;今日の3大ToDoのうち最低1つは完了した&quot;> 今日の3大ToDoのうち最低1つは完了した</label>
      <label><input type=&quot;checkbox&quot; value=&quot;😰 を抱えたまま帰ろうとしていない&quot;> 😰 を抱えたまま帰ろうとしていない</label>
      <label><input type=&quot;checkbox&quot; value=&quot;明日の最初の30分で着手することが決まっている&quot;> 明日の最初の30分で着手することが決まっている</label>
      <label><input type=&quot;checkbox&quot; value=&quot;来週繰越すべきタスクを「今週すること」に書いた&quot;> 来週繰越すべきタスクを「今週すること」に書いた</label>
    </div>

    <button class=&quot;gen&quot; onclick=&quot;buildMemo()&quot;>📝 メモ版を生成する</button>
  </div>

  <!-- ============ TAB 3: 相談チャット ============ -->
  <div class=&quot;panel&quot; id=&quot;panel-chat&quot;>
    <h2>相談チャットテンプレ（Slack / Mattermost コピペ用）</h2>
    <label>テンプレを選ぶ</label>
    <select id=&quot;c_tpl&quot; onchange=&quot;switchTpl()&quot;>
      <option value=&quot;A&quot;>A：相談（判断を仰ぐ）</option>
      <option value=&quot;B&quot;>B：質問（教えてほしい）</option>
      <option value=&quot;C&quot;>C：レビュー依頼</option>
      <option value=&quot;D&quot;>D：即時報告（障害／クレーム）</option>
      <option value=&quot;E&quot;>E：連絡（返信不要）</option>
      <option value=&quot;F&quot;>F：他の人と相談したい（巻き込み）</option>
      <option value=&quot;G&quot;>G：朝会・夕会の簡易日報</option>
      <option value=&quot;H&quot;>H：営業向け お礼＋次アクション</option>
      <option value=&quot;I&quot;>I：進捗報告（ステータス・％／1分・3分・5分・PREP）</option>
    </select>

    <div class=&quot;tpl&quot; data-tpl=&quot;A&quot;>
      <label>状況</label><textarea id=&quot;cA_sit&quot;></textarea>
      <div class=&quot;grid&quot;><div><label>選択肢A</label><input id=&quot;cA_a&quot;></div><div><label>選択肢B</label><input id=&quot;cA_b&quot;></div></div>
      <label>私の推し案（理由）</label><input id=&quot;cA_push&quot; placeholder=&quot;A寄り（理由：）&quot;>
      <label>ほしい判断</label><input id=&quot;cA_want&quot; value=&quot;OK / NG / 別案&quot;>
    </div>
    <div class=&quot;tpl&quot; data-tpl=&quot;B&quot; style=&quot;display:none&quot;>
      <label>あなたの名前</label><input id=&quot;cB_name&quot; value=&quot;石黒 友季子&quot;>
      <label>何について</label><input id=&quot;cB_topic&quot;>
      <label>何が分からないか</label><textarea id=&quot;cB_q&quot;></textarea>
      <label>自分で確認したこと</label><textarea id=&quot;cB_done&quot;></textarea>
      <div class=&quot;grid&quot;><div><label>いつまでに方針が欲しいか</label><input id=&quot;cB_due&quot;></div><div><label>業務影響</label><input id=&quot;cB_eff&quot;></div></div>
    </div>
    <div class=&quot;tpl&quot; data-tpl=&quot;C&quot; style=&quot;display:none&quot;>
      <label>対象URL</label><input id=&quot;cC_url&quot;>
      <div class=&quot;grid&quot;><div><label>見てほしい観点1</label><input id=&quot;cC_p1&quot;></div><div><label>観点2</label><input id=&quot;cC_p2&quot;></div></div>
      <label>期限</label><input id=&quot;cC_due&quot; placeholder=&quot;YYYY/MM/DD HH:MM まで&quot;>
      <label>補足</label>
      <select id=&quot;cC_note&quot;><option>ザッと見でOK</option><option>詳細指摘歓迎</option><option>どちらでも</option></select>
    </div>
    <div class=&quot;tpl&quot; data-tpl=&quot;D&quot; style=&quot;display:none&quot;>
      <label>事実</label><textarea id=&quot;cD_fact&quot;></textarea>
      <label>影響範囲</label><textarea id=&quot;cD_eff&quot;></textarea>
      <label>現在の対応</label><textarea id=&quot;cD_act&quot;></textarea>
      <label>判断ほしい点</label><textarea id=&quot;cD_want&quot;></textarea>
    </div>
    <div class=&quot;tpl&quot; data-tpl=&quot;E&quot; style=&quot;display:none&quot;>
      <label>変更・連絡内容</label><input id=&quot;cE_what&quot; placeholder=&quot;◯◯を◯◯に変更しました&quot;>
      <label>関連URL</label><input id=&quot;cE_url&quot;>
      <label>影響</label><select id=&quot;cE_eff&quot;><option>軽微</option><option>なし</option></select>
    </div>
    <div class=&quot;tpl&quot; data-tpl=&quot;F&quot; style=&quot;display:none&quot;>
      <label>件名・議題</label><textarea id=&quot;cF_topic&quot;></textarea>
      <div class=&quot;grid&quot;><div><label>△△さん（必要な理由）</label><input id=&quot;cF_p1&quot;></div><div><label>□□さん（必要な理由）</label><input id=&quot;cF_p2&quot;></div></div>
      <div class=&quot;grid&quot;><div><label>形式</label><select id=&quot;cF_form&quot;><option>1on1</option><option>グループMTG</option><option>非同期スレッド</option></select></div>
      <div><label>いつ頃</label><select id=&quot;cF_when&quot;><option>本日中</option><option>今週中</option><option>来週前半</option></select></div></div>
    </div>
    <div class=&quot;tpl&quot; data-tpl=&quot;G&quot; style=&quot;display:none&quot;>
      <label>日付</label><input id=&quot;cG_date&quot; placeholder=&quot;2026/04/01（水）&quot;>
      <label>昨日</label><textarea id=&quot;cG_y&quot;></textarea>
      <label>今日</label><textarea id=&quot;cG_t&quot;></textarea>
      <div class=&quot;grid&quot;><div><label>ブロッカー</label><input id=&quot;cG_block&quot; placeholder=&quot;なし&quot;></div><div><label>相談</label><input id=&quot;cG_consult&quot;></div></div>
    </div>
    <div class=&quot;tpl&quot; data-tpl=&quot;H&quot; style=&quot;display:none&quot;>
      <label>本日の合意事項（1行＝1項目）</label><textarea id=&quot;cH_agree&quot;></textarea>
      <div class=&quot;grid&quot;><div><label>次回までのアクション：弊社</label><input id=&quot;cH_us&quot;></div><div><label>次回までのアクション：貴社</label><input id=&quot;cH_you&quot;></div></div>
      <div class=&quot;grid&quot;><div><label>次回予定 日時</label><input id=&quot;cH_next&quot; placeholder=&quot;YYYY/MM/DD HH:MM〜&quot;></div><div><label>候補</label><input id=&quot;cH_cand&quot;></div></div>
    </div>
    <div class=&quot;tpl&quot; data-tpl=&quot;I&quot; style=&quot;display:none&quot;>
      <div class=&quot;grid&quot;><div><label>報告の長さ</label>
        <select id=&quot;cI_len&quot;><option value=&quot;prep&quot;>PREP（結論→理由→例→結論）</option><option value=&quot;1&quot;>1分（廊下でサッと）</option><option value=&quot;3&quot;>3分（定例向け）</option><option value=&quot;5&quot;>5分（しっかり）</option></select>
      </div><div><label>案件・テーマ</label><input id=&quot;cI_topic&quot; placeholder=&quot;例：LPIC応用クラス 教材整備&quot;></div></div>
      <div class=&quot;grid3&quot;>
        <div><label>全体ステータス</label>
          <select id=&quot;cI_status&quot;><option>🟢 順調</option><option>🟡 やや遅延</option><option>🔴 要対応</option><option>✅ 完了</option></select>
        </div>
        <div><label>全体進捗％</label><input id=&quot;cI_pct&quot; placeholder=&quot;60&quot; inputmode=&quot;numeric&quot;></div>
        <div><label>期限・納期（任意）</label><input id=&quot;cI_due&quot; placeholder=&quot;5/30&quot;></div>
      </div>
      <label>タスク（タップで追加。各タスクに状態と％）</label>
      <div id=&quot;cI_taskList&quot;></div>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;ciAddTask()&quot;>＋ タスクを追加</button>
      <div class=&quot;grid&quot;><div><label>次のアクション</label><textarea id=&quot;cI_next&quot; placeholder=&quot;やること（1行＝1項目）&quot;></textarea></div>
        <div><label>リスク・困りごと（任意）</label><textarea id=&quot;cI_risk&quot; placeholder=&quot;遅延要因・相談したいこと&quot;></textarea></div></div>
      <p class=&quot;tt-legend&quot;>💡 状態：🟢順調 / 🟡やや遅延 / 🔴要対応 / ✅完了。タスク％の平均から全体％を自動補完できます（空欄時）。</p>
    </div>

    <button class=&quot;gen&quot; onclick=&quot;buildChat()&quot;>💬 チャット文面を生成する</button>
  </div>

  <!-- ============ TAB 4: 時間割（HR学校風） ============ -->
  <div class=&quot;panel&quot; id=&quot;panel-timetable&quot;>
    <h2>🌅 朝のHR（朝に書く）</h2>
    <div class=&quot;hr-card&quot;>
      <div class=&quot;grid3&quot;>
        <div><label>日付</label><input id=&quot;tt_date&quot;></div>
        <div><label>今日の天気（気分）</label>
          <select id=&quot;tt_mood&quot;><option>☀️ 快調</option><option>⛅ ふつう</option><option>🌧 いまいち</option></select>
        </div>
        <div><label>出席（勤務地）</label>
          <select id=&quot;tt_place&quot;><option>対面</option><option>リモート</option><option>在宅</option></select>
        </div>
      </div>
      <label>今日のめあて（いちばん大事な1つ）</label>
      <input id=&quot;tt_goal&quot; placeholder=&quot;例：LPIC応用クラスの演習資料を完成させる&quot;>
      <label>意気込み・一言</label>
      <input id=&quot;tt_word&quot; value=&quot;面白きこともなき世を面白く&quot;>
    </div>

    <h2>🕘 時間割（08:00〜18:00）</h2>
    <p class=&quot;hint&quot;>朝に「予定」を埋める → 夕方に「実績」と達成度を入れる。予定時間と達成は下で自動計算します。</p>
    <div class=&quot;grid&quot;>
      <div><label>丸め単位（時間計算）</label>
        <select id=&quot;round_unit&quot; onchange=&quot;onRoundChange()&quot;>
          <option value=&quot;5&quot;>5分単位</option>
          <option value=&quot;10&quot;>10分単位</option>
          <option value=&quot;15&quot;>15分単位</option>
          <option value=&quot;30&quot;>30分単位</option>
          <option value=&quot;60&quot;>1時間単位</option>
        </select>
      </div>
      <div><label>丸め方</label>
        <select id=&quot;round_mode&quot; onchange=&quot;onRoundChange()&quot;>
          <option value=&quot;round&quot;>四捨五入（最も近い単位）</option>
          <option value=&quot;ceil&quot;>切り上げ（単位を必ず確保）</option>
        </select>
      </div>
    </div>
    <label class=&quot;toggle&quot; style=&quot;margin-top:10px;&quot;>
      <input type=&quot;checkbox&quot; id=&quot;tt_link&quot; checked onchange=&quot;onTtLinkChange()&quot;>
      🔗 退勤前報告・月末報告書に時間割（予定／実績）を連携する
    </label>
    <p class=&quot;hint&quot; id=&quot;tt_link_hint&quot; style=&quot;margin-top:2px;&quot;>ONのとき、退勤前報告の「本日の業務内容」に今の時間割の実績コマを差し込み、月末報告書に区分別・タグ別の時間集計を載せます。OFFにすると連携しません。</p>
    <div class=&quot;tt-head&quot;>
      <div>時限</div><div>区分</div><div>区分名</div><div>開始</div><div>終了</div><div>予定（やること）</div><div>実績（やったこと）</div><div>達成</div><div title=&quot;差し込み対応&quot;>⚡差込</div><div>予定分</div><div title=&quot;この下に差込追加&quot;>＋差</div><div></div>
    </div>
    <div id=&quot;ttList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;addPeriod()&quot;>＋ コマを追加</button>

    <div class=&quot;tagbar-wrap&quot;>
      <div class=&quot;tagbar-head&quot;>
        <span class=&quot;bk-title&quot; style=&quot;color:var(--orange-deep);font-weight:800;font-size:.9rem;&quot;>🏷 よく使うタグ（タップで挿入）</span>
        <span class=&quot;hint&quot; style=&quot;margin:0;&quot;>直前に触れた予定／実績欄に挿入されます</span>
      </div>
      <div id=&quot;tagButtons&quot; class=&quot;tagbar&quot;></div>
      <div class=&quot;tagbar-add&quot;>
        <input id=&quot;newTag&quot; placeholder=&quot;新しいタグ名（#は不要）&quot; onkeydown=&quot;if(event.key==='Enter'){addQuickTag();}&quot;>
        <button type=&quot;button&quot; class=&quot;mini-btn&quot; onclick=&quot;addQuickTag()&quot;>＋追加</button>
      </div>
    </div>

    <p class=&quot;tt-legend&quot;>
      区分：<span class=&quot;kind-chip kc-lesson&quot;>授業</span><span class=&quot;kind-chip kc-meeting&quot;>会議</span><span class=&quot;kind-chip kc-work&quot;>作業</span><span class=&quot;kind-chip kc-break&quot;>休憩</span>
    </p>
    <p class=&quot;tt-legend&quot;>達成：◎=達成 ／ ○=一部 ／ △=未達 ／ —=該当なし。加重は ◎1.0・○0.5・△0。休憩コマは稼働に含めません。</p>

    <h2 style=&quot;margin-top:22px;&quot;>📊 予定 vs 実績（自動計算）</h2>
    <div class=&quot;calc&quot;>
      <div class=&quot;cell&quot;><div class=&quot;num&quot; id=&quot;c_slots&quot;>0</div><div class=&quot;lab&quot;>稼働コマ</div></div>
      <div class=&quot;cell&quot;><div class=&quot;num&quot; id=&quot;c_plan&quot;>0:00</div><div class=&quot;lab&quot;>予定 稼働時間</div></div>
      <div class=&quot;cell&quot;><div class=&quot;num&quot; id=&quot;c_actual&quot;>0:00</div><div class=&quot;lab&quot;>実績（達成換算）</div></div>
      <div class=&quot;cell&quot;><div class=&quot;num&quot; id=&quot;c_rate&quot;>0%</div><div class=&quot;lab&quot;>達成率</div></div>
    </div>
    <div class=&quot;bar&quot;><i id=&quot;c_barfill&quot;></i></div>
    <p class=&quot;tt-legend&quot; id=&quot;c_breakdown&quot;>◎0 ／ ○0 ／ △0 ／ 休憩0</p>
    <div class=&quot;kindbar&quot; id=&quot;c_kindbar&quot; title=&quot;区分別の予定時間の割合&quot;></div>
    <p class=&quot;tt-legend&quot; id=&quot;c_kindlabel&quot;>区分別 予定時間：授業 0:00 ／ 会議 0:00 ／ 作業 0:00</p>
    <p class=&quot;tt-legend&quot; id=&quot;c_taglabel&quot; style=&quot;display:none;&quot;></p>
    <p class=&quot;hint&quot;>💡 予定・実績に <code>#資料作成</code> のように <code>#</code> でタグを書くと、タグごとの時間を積み上げ集計します（月末報告書にも反映）。</p>

    <h2 style=&quot;margin-top:22px;&quot;>🏁 帰りのHR（夕方に書く）</h2>
    <div class=&quot;cheer-card&quot; id=&quot;cheerCard&quot;>
      <div class=&quot;emoji&quot; id=&quot;cheerEmoji&quot;>🌸</div>
      <div class=&quot;title&quot; id=&quot;cheerTitle&quot;></div>
      <div class=&quot;msg&quot; id=&quot;cheerMsg&quot;></div>
    </div>
    <div class=&quot;hr-card&quot;>
      <div class=&quot;grid3&quot;>
        <div><label>できたこと（Keep）</label><textarea id=&quot;tt_keep&quot;></textarea></div>
        <div><label>できなかった・課題（Problem）</label><textarea id=&quot;tt_problem&quot;></textarea></div>
        <div><label>明日へ（Try）</label><textarea id=&quot;tt_try&quot;></textarea></div>
      </div>
      <label>先生から一言（自己評価・ねぎらい）</label>
      <input id=&quot;tt_teacher&quot; placeholder=&quot;例：午後の集中が良かった。明日は午前に難所を持ってこよう。&quot;>
    </div>

    <button class=&quot;gen&quot; onclick=&quot;buildTimetable()&quot;>🏫 時間割＋振り返りを生成する</button>

    <h2 style=&quot;margin-top:26px;&quot;>📅 30日ログ（保存・Excel入出力）</h2>
    <p class=&quot;hint&quot;>「この日を保存」で日付ごとに記録され、ブラウザ内に貯まります（最大表示30日）。貯めた記録はExcel(.xlsx)とCSVで書き出し、CSVから取り込めます。データは端末内のみで外部送信しません。</p>
    <div class=&quot;log-actions&quot;>
      <button class=&quot;primary&quot; onclick=&quot;saveDay()&quot;>💾 この日を保存／上書き</button>
      <button onclick=&quot;exportXlsx()&quot;>📊 Excelエクスポート(.xlsx)</button>
      <button onclick=&quot;exportCsv()&quot;>📄 CSVエクスポート</button>
      <button onclick=&quot;document.getElementById('csvFile').click()&quot;>📥 CSVインポート</button>
      <button class=&quot;danger&quot; onclick=&quot;clearAllDays()&quot;>🗑 全消去</button>
      <input type=&quot;file&quot; id=&quot;csvFile&quot; class=&quot;hidden-file&quot; accept=&quot;.csv,text/csv&quot; onchange=&quot;importCsv(this)&quot;>
    </div>

    <div id=&quot;aggPanel&quot; style=&quot;display:none;&quot;>
      <h3>区分別 累計時間（保存した全日）</h3>
      <div class=&quot;agg&quot;>
        <div class=&quot;cell&quot;><div class=&quot;num&quot; id=&quot;a_lesson&quot;>0:00</div><div class=&quot;lab&quot;>授業</div></div>
        <div class=&quot;cell&quot;><div class=&quot;num&quot; id=&quot;a_meeting&quot;>0:00</div><div class=&quot;lab&quot;>会議</div></div>
        <div class=&quot;cell&quot;><div class=&quot;num&quot; id=&quot;a_work&quot;>0:00</div><div class=&quot;lab&quot;>作業</div></div>
        <div class=&quot;cell&quot;><div class=&quot;num&quot; id=&quot;a_break&quot;>0:00</div><div class=&quot;lab&quot;>休憩</div></div>
      </div>
      <p class=&quot;tt-legend&quot; id=&quot;a_meta&quot;>保存日数 0日 ／ 平均達成率 0%</p>
    </div>

    <div class=&quot;daylist&quot; id=&quot;dayList&quot;><div class=&quot;empty&quot;>まだ保存された日がありません。</div></div>

    <h2 style=&quot;margin-top:26px;&quot;>📋 月末報告書（時間集計つき）</h2>
    <p class=&quot;hint&quot;>保存した日々のログから、区分別の時間集計（時間割で選んだ丸め単位）と「やったこと／達成したこと／課題／リーダーに伝えたいこと」をまとめた報告書を生成します。期間を空にすると保存した全件が対象です。</p>
    <div class=&quot;grid3&quot;>
      <div><label>対象月（任意・見出しに表示）</label><input id=&quot;rep_month&quot; placeholder=&quot;2026年5月&quot;></div>
      <div><label>期間 開始日（任意）</label><input id=&quot;rep_from&quot; placeholder=&quot;2026/05/01&quot;></div>
      <div><label>期間 終了日（任意）</label><input id=&quot;rep_to&quot; placeholder=&quot;2026/05/31&quot;></div>
    </div>
    <label>リーダーに伝えたいこと（自由記入・任意）</label>
    <textarea id=&quot;rep_leader&quot; placeholder=&quot;来月の体制相談、評価面談で話したい点、リソース希望など&quot;></textarea>
    <button class=&quot;gen&quot; onclick=&quot;buildMonthlyReport()&quot;>📋 月末報告書を生成する（保存ログから）</button>
    <div class=&quot;log-actions&quot;>
      <button onclick=&quot;exportMonthlyXlsx()&quot;>📊 月末報告書をExcelで出力（保存ログ・タスク工数／丸め単位は上の設定）</button>
    </div>

    <div class=&quot;sk-block&quot; style=&quot;background:linear-gradient(160deg,#fff6e9,#fff);margin-top:14px;&quot;>
      <div class=&quot;bk-head&quot;><span class=&quot;bk-title&quot;>📝 メモから月末報告書を作る（30日分を一括貼り付け）</span></div>
      <p class=&quot;hint&quot; style=&quot;margin-top:4px;&quot;>1か月ぶんのメモをまとめて貼り付け、または複数のメモCSV/テキストを読み込んで月末報告書を作れます。各行に <code>（90分）</code> や <code>90分</code>・<code>1h</code>・<code>1:30</code> のような時間、<code>#タグ</code> を書くと、タスクごと・タグごとの時間も集計します。日付行（例：2026/05/01）で日を区切れます。</p>
      <textarea id=&quot;rep_memo&quot; placeholder=&quot;例）&amp;#10;2026/05/01&amp;#10;・教材スライド作成（90分）#資料作成&amp;#10;・演習レビュー 45分 #レビュー&amp;#10;2026/05/02&amp;#10;・模試の採点 1h #採点&amp;#10;・教材スライド作成 30分 #資料作成&quot; style=&quot;min-height:120px&quot;></textarea>
      <div class=&quot;log-actions&quot;>
        <button onclick=&quot;document.getElementById('repMemoFile').click()&quot;>📄 メモCSV/テキストを読み込む（追記）</button>
        <input type=&quot;file&quot; id=&quot;repMemoFile&quot; class=&quot;hidden-file&quot; accept=&quot;.csv,.txt,text/plain,text/csv&quot; onchange=&quot;repMemoImport(this)&quot;>
        <button class=&quot;primary&quot; onclick=&quot;buildMonthlyReportFromMemo()&quot;>📋 メモから月末報告書を生成</button>
        <button onclick=&quot;exportMonthlyXlsxFromMemo()&quot;>📊 メモからExcel出力（タスク工数／丸め単位は上の設定）</button>
      </div>
    </div>

    <h2 style=&quot;margin-top:26px;&quot;>🛠 個人用カイゼンMTG（Keep / Try / Change）</h2>
    <p class=&quot;hint&quot;>自分ひとりの改善ミーティング用。保存した日々のKeep・Problem・Try・達成度を集めて、KPTC（続ける／試す／やめる・変える）に整理します。趣味枠とChangeは手入力で足せます。</p>
    <div class=&quot;grid&quot;>
      <div><label>趣味枠の振り返り（個人開発・記事・インプットなど）</label><textarea id=&quot;kz_hobby&quot; placeholder=&quot;今週やった個人開発・記事・学習（1行＝1項目）&quot;></textarea></div>
      <div><label>Change：やめる・変えること（自由記入）</label><textarea id=&quot;kz_change&quot; placeholder=&quot;やめたい習慣、変えたい進め方（1行＝1項目）&quot;></textarea></div>
    </div>
    <button class=&quot;gen&quot; onclick=&quot;buildKaizenMTG()&quot;>🛠 カイゼンMTGを生成する</button>
  </div>

  <!-- ============ TAB 5: スキルシート（案件欄） ============ -->
  <div class=&quot;panel&quot; id=&quot;panel-skill&quot;>
    <h2>📐 スキルシート 案件欄（1案件 = 1セット）</h2>
    <p class=&quot;hint&quot;>職務経歴書の案件欄サイズ感をガイド表示します。1案件ずつ書いて「この案件を保存」で30件までためられます。公開・提出時は、企業名やシステム名など特定につながる表現は避けてください。</p>

    <div class=&quot;sk-block&quot; style=&quot;background:linear-gradient(160deg,#fff6e9,#fff);&quot;>
      <div class=&quot;bk-head&quot;><span class=&quot;bk-title&quot;>🗓 30日分から下書きを作る（1か月→スキルシート）</span></div>
      <p class=&quot;hint&quot; style=&quot;margin-top:4px;&quot;>1か月ぶんの日報メモを集めて、スキルシートの素材に変換します。① 時間割タブの30日ログから、または ② メモ版日報のテキスト/CSVを貼り付け・読み込み のどちらからでもOK。</p>
      <div class=&quot;log-actions&quot;>
        <button class=&quot;primary&quot; onclick=&quot;skFromLog()&quot;>📥 時間割の30日ログから取り込む</button>
        <button onclick=&quot;document.getElementById('skMemoFile').click()&quot;>📄 メモ日報CSV/テキストを読み込む</button>
        <input type=&quot;file&quot; id=&quot;skMemoFile&quot; class=&quot;hidden-file&quot; accept=&quot;.csv,.txt,text/plain,text/csv&quot; onchange=&quot;skMemoImport(this)&quot;>
      </div>
      <label>メモを貼り付け（複数日OK。日付行＋作業行をそのまま貼ってください）</label>
      <textarea id=&quot;sk_memoPaste&quot; placeholder=&quot;例）&amp;#10;2026/05/01&amp;#10;・LPIC教材のスライド作成&amp;#10;・演習問題のレビュー実施&amp;#10;2026/05/02&amp;#10;[x] 模試の採点&amp;#10;...&quot; style=&quot;min-height:90px&quot;></textarea>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;skParsePaste()&quot;>↑ 貼り付けたメモから候補を抽出</button>

      <div id=&quot;skDraftPanel&quot; style=&quot;display:none;margin-top:12px;&quot;>
        <p class=&quot;tt-legend&quot; id=&quot;sk_draftMeta&quot;></p>
        <h3 style=&quot;margin:10px 0 4px;&quot;>作業内容の候補（チェックしたものを「作業内容」に流し込み）</h3>
        <div class=&quot;sk-check&quot; id=&quot;sk_candidates&quot; style=&quot;max-height:260px;overflow:auto;border:1px solid var(--line-soft);border-radius:10px;padding:8px;&quot;></div>
        <div class=&quot;log-actions&quot; style=&quot;margin-top:8px;&quot;>
          <button class=&quot;primary&quot; onclick=&quot;skApplyCandidates()&quot;>✅ チェックした候補を作業内容へ</button>
          <button onclick=&quot;skCheckAllCand(true)&quot;>全選択</button>
          <button onclick=&quot;skCheckAllCand(false)&quot;>全解除</button>
          <button onclick=&quot;skFillDraftMeta()&quot;>📝 期間・対応工程も下書きに反映</button>
        </div>
      </div>
    </div>

    <h3>メタデータ（外枠9項目）</h3>
    <div class=&quot;grid3&quot;>
      <div><label>No</label><input id=&quot;sk_no&quot; placeholder=&quot;1&quot;></div>
      <div><label>業種（2,3文字）</label><input id=&quot;sk_industry&quot; placeholder=&quot;金融&quot;></div>
      <div><label>役割（2,3文字）</label><input id=&quot;sk_role&quot; placeholder=&quot;SE&quot;></div>
    </div>
    <div class=&quot;grid&quot;>
      <div><label>期間（1行＋1行）</label><input id=&quot;sk_period&quot; placeholder=&quot;4年8ケ月 ／ 2020年02月～2024年09月&quot;></div>
      <div><label>規模</label><input id=&quot;sk_scale&quot; placeholder=&quot;全体20名 ／ チーム7名&quot;></div>
    </div>
    <div class=&quot;grid3&quot;>
      <div><label>言語／ツール</label><input id=&quot;sk_lang&quot; placeholder=&quot;Java（SpringBoot）HTML CSS3 …&quot;></div>
      <div><label>DB</label><input id=&quot;sk_db&quot; placeholder=&quot;PostgreSQL&quot;></div>
      <div><label>サーバ／OS</label><input id=&quot;sk_os&quot; placeholder=&quot;Windows Server&quot;></div>
    </div>
    <div class=&quot;grid&quot;>
      <div><label>環境／ミドルウェア</label><input id=&quot;sk_mw&quot; placeholder=&quot;Git spring&quot;></div>
      <div><label>担当工程（5つ程度）</label><input id=&quot;sk_phase&quot; placeholder=&quot;要件定義、基本設計、詳細設計、製造、テスト&quot;></div>
    </div>

    <h3 style=&quot;margin-top:18px;&quot;>企業・プロジェクト名（タイトル行）</h3>
    <div class=&quot;sk-block&quot;>
      <div class=&quot;bk-head&quot;><span class=&quot;bk-title&quot;>タイトル</span>
        <span class=&quot;sk-guide&quot;>1行・15〜25文字／業界＋システム種別／企業名NG</span>
        <span class=&quot;sk-count&quot; id=&quot;sk_c_title&quot;>0字</span></div>
      <input id=&quot;sk_title&quot; placeholder=&quot;例：金融業　社内システム開発　※FEとBE開発&quot; oninput=&quot;skCount()&quot;>
    </div>

    <div class=&quot;sk-block&quot;>
      <div class=&quot;bk-head&quot;><span class=&quot;bk-title&quot;>■システム内容</span>
        <span class=&quot;sk-guide&quot;>1行・15〜25文字／ユーザー・業界・目的を端的に</span>
        <span class=&quot;sk-count&quot; id=&quot;sk_c_sys&quot;>0字</span></div>
      <textarea id=&quot;sk_sys&quot; placeholder=&quot;例：金融系企業の社内システム開発支援&quot; oninput=&quot;skCount()&quot;></textarea>
    </div>

    <div class=&quot;sk-block&quot;>
      <div class=&quot;bk-head&quot;><span class=&quot;bk-title&quot;>■対応工程</span>
        <span class=&quot;sk-guide&quot;>2〜3行・各行15〜25文字／「工程〜（yyyy/mm〜yyyy/mm）」</span>
        <span class=&quot;sk-count&quot; id=&quot;sk_c_proc&quot;>0字 / 0行</span></div>
      <textarea id=&quot;sk_proc&quot; placeholder=&quot;要件定義〜詳細設計（2020/01〜2022/12）&amp;#10;製造〜（2023/01〜2023/11）&amp;#10;運用保守〜（2023/12〜）&quot; oninput=&quot;skCount()&quot;></textarea>
    </div>

    <div class=&quot;sk-block&quot;>
      <div class=&quot;bk-head&quot;><span class=&quot;bk-title&quot;>■担当業務</span>
        <span class=&quot;sk-guide&quot;>2〜3行・各行10〜30文字／役割と、何を担ったか</span>
        <span class=&quot;sk-count&quot; id=&quot;sk_c_duty&quot;>0字 / 0行</span></div>
      <textarea id=&quot;sk_duty&quot; placeholder=&quot;SEとしてPJに参画&amp;#10;金融業向けの社内システムの新規開発に伴い要件定義から対応&quot; oninput=&quot;skCount()&quot;></textarea>
    </div>

    <div class=&quot;sk-block&quot;>
      <div class=&quot;bk-head&quot;><span class=&quot;bk-title&quot;>■作業内容（・箇条書き）</span>
        <span class=&quot;sk-guide&quot;>10〜12項目・各10〜20文字／動詞語尾で揃える</span>
        <span class=&quot;sk-count&quot; id=&quot;sk_c_work&quot;>0項目</span></div>
      <div id=&quot;sk_workList&quot;></div>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;skAddWork()&quot;>＋ 行を追加</button>
    </div>

    <div class=&quot;sk-block&quot;>
      <div class=&quot;bk-head&quot;><span class=&quot;bk-title&quot;>■成果物</span>
        <span class=&quot;sk-guide&quot;>1〜2行・各15〜25文字／可能なら数字を入れる</span>
        <span class=&quot;sk-count&quot; id=&quot;sk_c_out&quot;>0字 / 0行</span></div>
      <textarea id=&quot;sk_out&quot; placeholder=&quot;例：要件定義書から報告書などの各種ドキュメント&quot; oninput=&quot;skCount()&quot;></textarea>
    </div>

    <h3 style=&quot;margin-top:18px;&quot;>本文ボリューム判定</h3>
    <p class=&quot;tt-legend&quot;>本文セル合計：<strong id=&quot;sk_total&quot;>0</strong> 文字 ／ 推定ケース：<span class=&quot;sk-case&quot; id=&quot;sk_case&quot;>—</span></p>
    <p class=&quot;tt-legend&quot;>A=長期(約300字) ／ B=中期(約100〜150字) ／ C=短期(約100字)。見本PDF実測ベースの目安です。</p>

    <h3 style=&quot;margin-top:18px;&quot;>📊 提出前チェック</h3>
    <div class=&quot;sk-check&quot; id=&quot;sk_checks&quot;>
      <label><input type=&quot;checkbox&quot;> すべての■ブロックが埋まっている（5ブロック）</label>
      <label><input type=&quot;checkbox&quot;> 企業名・システム名の特定表現が無い</label>
      <label><input type=&quot;checkbox&quot;> 作業内容の箇条書きが動詞語尾で揃っている</label>
      <label><input type=&quot;checkbox&quot;> 対応工程に期間（yyyy/mm〜yyyy/mm）が入っている</label>
      <label><input type=&quot;checkbox&quot;> 成果物に可能な限り数字を入れた</label>
      <label><input type=&quot;checkbox&quot;> 担当工程と本文の内容が一致している</label>
    </div>

    <button class=&quot;gen&quot; onclick=&quot;buildSkill()&quot;>📐 スキルシート案件欄を生成する</button>

    <h2 style=&quot;margin-top:26px;&quot;>📅 30日ログ（案件スタック・Excel入出力）</h2>
    <p class=&quot;hint&quot;>「この案件を保存」で1件ずつ貯まります（最大30件表示）。Excel(.xlsx)・CSVで書き出し、CSVから取り込めます。データは端末内のみで外部送信しません。</p>
    <div class=&quot;log-actions&quot;>
      <button class=&quot;primary&quot; onclick=&quot;skSave()&quot;>💾 この案件を保存／上書き</button>
      <button onclick=&quot;skExportXlsx()&quot;>📊 Excelエクスポート(.xlsx)</button>
      <button onclick=&quot;skExportCsv()&quot;>📄 CSVエクスポート</button>
      <button onclick=&quot;document.getElementById('skCsvFile').click()&quot;>📥 CSVインポート</button>
      <button class=&quot;danger&quot; onclick=&quot;skClearAll()&quot;>🗑 全消去</button>
      <input type=&quot;file&quot; id=&quot;skCsvFile&quot; class=&quot;hidden-file&quot; accept=&quot;.csv,text/csv&quot; onchange=&quot;skImportCsv(this)&quot;>
    </div>
    <p class=&quot;tt-legend&quot; id=&quot;sk_logmeta&quot; style=&quot;display:none;&quot;></p>
    <div class=&quot;daylist&quot; id=&quot;skList&quot;><div class=&quot;empty&quot;>まだ保存された案件がありません。</div></div>
  </div>

  <!-- ============ TAB 6: 一人MTG（PDCA） ============ -->
  <div class=&quot;panel&quot; id=&quot;panel-pdca&quot;>
    <h2>🔄 一人MTG（PDCA）</h2>
    <p class=&quot;hint&quot;>ひとりで回す改善ミーティング。各ステップに時間を区切って集中できます。「▶ MTG開始」で Plan→Do→Check→Act を自動で進めます。データは端末内のみ。</p>

    <div class=&quot;pdca-timer&quot; id=&quot;pdcaTimer&quot;>
      <div class=&quot;phase&quot; id=&quot;pd_phase&quot;>準備OK</div>
      <div class=&quot;clock&quot; id=&quot;pd_clock&quot;>00:00</div>
      <div class=&quot;sub&quot; id=&quot;pd_sub&quot;>「▶ MTG開始」で Plan から始まります</div>
      <div class=&quot;pdca-bar&quot;><i id=&quot;pd_barfill&quot;></i></div>
      <div class=&quot;pdca-ctrl&quot;>
        <button class=&quot;primary&quot; id=&quot;pd_startBtn&quot; onclick=&quot;pdcaStart()&quot;>▶ MTG開始（自動）</button>
        <button onclick=&quot;pdcaPause()&quot;>⏸ 一時停止</button>
        <button onclick=&quot;pdcaSkip()&quot;>⏭ 次のステップ</button>
        <button onclick=&quot;pdcaReset()&quot;>↺ リセット</button>
      </div>
      <div class=&quot;pdca-ctrl&quot; style=&quot;margin-top:6px;&quot;>
        <span class=&quot;sub&quot;>単発タイマー：</span>
        <button onclick=&quot;pdcaQuick(3)&quot;>3分</button>
        <button onclick=&quot;pdcaQuick(5)&quot;>5分</button>
        <button onclick=&quot;pdcaQuick(10)&quot;>10分</button>
        <button onclick=&quot;pdcaQuick(15)&quot;>15分</button>
      </div>
      <label style=&quot;display:flex;align-items:center;justify-content:center;gap:6px;margin-top:8px;font-size:.8rem;color:var(--ink-soft);&quot;>
        <input type=&quot;checkbox&quot; id=&quot;pd_sound&quot; checked style=&quot;width:auto;&quot;> ステップ終了時に音を鳴らす
      </label>
    </div>

    <div class=&quot;pdca-step&quot; data-phase=&quot;P&quot;>
      <div class=&quot;hd&quot;><span class=&quot;nm&quot;>📝 Plan（計画）</span>
        <span class=&quot;mins&quot;>分 <input id=&quot;pd_min_P&quot; type=&quot;number&quot; value=&quot;3&quot; min=&quot;1&quot; max=&quot;60&quot;></span></div>
      <textarea id=&quot;pd_plan&quot; placeholder=&quot;今日/今週の目標、やること、優先順位（1行＝1項目）&quot;></textarea>
    </div>
    <div class=&quot;pdca-step&quot; data-phase=&quot;D&quot;>
      <div class=&quot;hd&quot;><span class=&quot;nm&quot;>🏃 Do（実行）</span>
        <span class=&quot;mins&quot;>分 <input id=&quot;pd_min_D&quot; type=&quot;number&quot; value=&quot;10&quot; min=&quot;1&quot; max=&quot;60&quot;></span></div>
      <textarea id=&quot;pd_do&quot; placeholder=&quot;実際にやったこと・進んだこと&quot;></textarea>
    </div>
    <div class=&quot;pdca-step&quot; data-phase=&quot;C&quot;>
      <div class=&quot;hd&quot;><span class=&quot;nm&quot;>🔍 Check（評価）</span>
        <span class=&quot;mins&quot;>分 <input id=&quot;pd_min_C&quot; type=&quot;number&quot; value=&quot;5&quot; min=&quot;1&quot; max=&quot;60&quot;></span></div>
      <textarea id=&quot;pd_check&quot; placeholder=&quot;うまくいった点・課題・達成度（保存ログから下書きできます）&quot;></textarea>
    </div>
    <div class=&quot;pdca-step&quot; data-phase=&quot;A&quot;>
      <div class=&quot;hd&quot;><span class=&quot;nm&quot;>🚀 Act（改善）</span>
        <span class=&quot;mins&quot;>分 <input id=&quot;pd_min_A&quot; type=&quot;number&quot; value=&quot;2&quot; min=&quot;1&quot; max=&quot;60&quot;></span></div>
      <textarea id=&quot;pd_act&quot; placeholder=&quot;次にどう動くか・改善アクション（1行＝1項目）&quot;></textarea>
    </div>

    <div class=&quot;log-actions&quot;>
      <button onclick=&quot;pdcaDraftFromLog()&quot;>📥 保存ログからCheck/Actを下書き</button>
    </div>
    <button class=&quot;gen&quot; onclick=&quot;buildPdca()&quot;>🔄 一人MTG（PDCA）を生成する</button>
  </div>

  <!-- ============ TAB: 一人MTG2（目標・KPT） ============ -->
  <div class=&quot;panel&quot; id=&quot;panel-mtg2&quot;>
    <h2>🎯 一人MTG2（目標設定 ＋ KPT）</h2>
    <p class=&quot;hint&quot;>「最低限の目標」と「最高の目標」を期日・時間つきで立て、Keep / Problem / Try ＋ Change でふりかえる、ひとり作戦会議です。データは端末内のみ。</p>

    <h3>🎯 目標設定（2段階＋期日）</h3>
    <div class=&quot;grid&quot;>
      <div><label>テーマ・案件（任意）</label><input id=&quot;g2_theme&quot; placeholder=&quot;例：LPIC応用クラス 教材整備&quot;></div>
      <div><label>期日（いつまでに）</label><input id=&quot;g2_due&quot; placeholder=&quot;2026/05/30（金）&quot;></div>
    </div>
    <div class=&quot;grid&quot;>
      <div><label>🟢 最低限の目標（これは必ず）</label><textarea id=&quot;g2_min&quot; placeholder=&quot;ここまでできれば合格ライン&quot;></textarea>
        <label>所要時間の見込み</label><input id=&quot;g2_min_time&quot; placeholder=&quot;例：2時間 / 90分&quot;></div>
      <div><label>🌟 最高の目標（できたら最高）</label><textarea id=&quot;g2_max&quot; placeholder=&quot;理想までいけたらここまで&quot;></textarea>
        <label>所要時間の見込み</label><input id=&quot;g2_max_time&quot; placeholder=&quot;例：1日 / 4時間&quot;></div>
    </div>

    <h3 style=&quot;margin-top:18px;&quot;>🔁 ふりかえり（KPT ＋ Change）</h3>
    <div class=&quot;grid&quot;>
      <div><label>✅ Keep（続けたい・うまくいった）</label><textarea id=&quot;g2_keep&quot; placeholder=&quot;1行＝1項目&quot;></textarea></div>
      <div><label>🌧 Problem（課題・困りごと）</label><textarea id=&quot;g2_problem&quot; placeholder=&quot;1行＝1項目&quot;></textarea></div>
    </div>
    <div class=&quot;grid&quot;>
      <div><label>🌱 Try（次に試す）</label><textarea id=&quot;g2_try&quot; placeholder=&quot;1行＝1項目&quot;></textarea></div>
      <div><label>🔄 Change（やめる・変える）</label><textarea id=&quot;g2_change&quot; placeholder=&quot;1行＝1項目&quot;></textarea></div>
    </div>

    <div class=&quot;log-actions&quot;>
      <button onclick=&quot;mtg2DraftFromLog()&quot;>📥 保存ログからKeep/Problem/Tryを下書き</button>
    </div>
    <button class=&quot;gen&quot; onclick=&quot;buildMtg2()&quot;>🎯 一人MTG2を生成する</button>
  </div>

  <!-- ============ TAB 7: 自由ひな形（日報） ============ -->
  <div class=&quot;panel&quot; id=&quot;panel-tpl&quot;>
    <h2>🧩 自由ひな形（日報）</h2>
    <p class=&quot;hint&quot;>あなたの日報フォーマットを自由に登録して使えます。本文の中に <code>{{案件名}}</code> のように <code>{{ }}</code> で差し込み欄を書くと、下に入力欄が自動で出ます。埋めて「生成」すると差し込み済みの日報が出力されます。複数のひな形を保存・切替でき、JSONで書き出し／取り込みもできます。データは端末内のみ。</p>

    <div class=&quot;tpl-saved&quot; id=&quot;tpl_savedList&quot;></div>

    <div class=&quot;grid&quot;>
      <div><label>ひな形の名前</label><input id=&quot;tpl_name&quot; placeholder=&quot;例：2026年5月版 日報&quot;></div>
      <div style=&quot;display:flex;align-items:flex-end;gap:6px;&quot;>
        <button type=&quot;button&quot; class=&quot;addbtn&quot; style=&quot;flex:1&quot; onclick=&quot;tplSave()&quot;>💾 このひな形を保存／上書き</button>
        <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;tplNew()&quot;>＋ 新規</button>
      </div>
    </div>

    <label>ひな形の本文（<code>{{差し込み名}}</code> を自由に書けます）</label>
    <textarea id=&quot;tpl_body&quot; oninput=&quot;tplScan()&quot; placeholder=&quot;例）&amp;#10;【業務日報】{{日付}}&amp;#10;氏名：{{氏名}}&amp;#10;&amp;#10;■今日の作業&amp;#10;{{今日やったこと}}&amp;#10;&amp;#10;■所感・課題&amp;#10;{{所感}}&amp;#10;&amp;#10;■明日の予定&amp;#10;{{明日の予定}}&quot; style=&quot;min-height:160px;font-family:'SFMono-Regular',Consolas,Menlo,monospace;&quot;></textarea>
    <div class=&quot;tpl-saved&quot;>
      <span class=&quot;hint&quot; style=&quot;margin:0;&quot;>挿入：</span>
      <button type=&quot;button&quot; class=&quot;tpl-chip&quot; onclick=&quot;tplInsertPh('日付')&quot;>{{日付}}</button>
      <button type=&quot;button&quot; class=&quot;tpl-chip&quot; onclick=&quot;tplInsertPh('日時')&quot;>{{日時}}</button>
      <button type=&quot;button&quot; class=&quot;tpl-chip&quot; onclick=&quot;tplInsertPh('曜日')&quot;>{{曜日}}</button>
      <button type=&quot;button&quot; class=&quot;tpl-chip&quot; onclick=&quot;tplInsertPh('時刻')&quot;>{{時刻}}</button>
      <button type=&quot;button&quot; class=&quot;tpl-chip&quot; onclick=&quot;tplInsertPh('氏名')&quot;>{{氏名}}</button>
      <button type=&quot;button&quot; class=&quot;tpl-chip&quot; onclick=&quot;tplInsertPh('今日やったこと')&quot;>{{今日やったこと}}</button>
      <button type=&quot;button&quot; class=&quot;tpl-chip&quot; onclick=&quot;tplInsertPh('所感')&quot;>{{所感}}</button>
      <button type=&quot;button&quot; class=&quot;tpl-chip&quot; onclick=&quot;tplInsertPh('明日の予定')&quot;>{{明日の予定}}</button>
    </div>

    <h3 style=&quot;margin-top:16px;&quot;>差し込み入力</h3>
    <div class=&quot;tpl-fields&quot; id=&quot;tpl_fields&quot;><div class=&quot;empty&quot;>本文に <code>{{ }}</code> を書くと、ここに入力欄が出ます。</div></div>

    <div class=&quot;log-actions&quot;>
      <button onclick=&quot;tplExport()&quot;>⬇️ ひな形をJSONで書き出し</button>
      <button onclick=&quot;document.getElementById('tplFile').click()&quot;>📥 JSONを取り込み</button>
      <input type=&quot;file&quot; id=&quot;tplFile&quot; class=&quot;hidden-file&quot; accept=&quot;.json,application/json&quot; onchange=&quot;tplImport(this)&quot;>
    </div>
    <button class=&quot;gen&quot; onclick=&quot;buildTplDoc()&quot;>🧩 このひな形で日報を生成する</button>
  </div>

  <!-- ============ TAB: 月次データ統合 ============ -->
  <div class=&quot;panel&quot; id=&quot;panel-hub&quot;>
    <h2>🗂 月次データ統合（最大31件 → 月末報告書・スキルシート）</h2>
    <p class=&quot;hint&quot;>1か月ぶん（最大31日）のメモを、Excel(CSV)・Notion(CSV/Markdown)・貼り付けから取り込み、ひとつに統合します。統合した素材は、そのまま月末報告書（タスク工数の時間計算）にもスキルシート（作業内容の下書き）にも送れます。データは端末内のみ。</p>

    <div class=&quot;sk-block&quot; style=&quot;background:linear-gradient(160deg,#fff6e9,#fff);&quot;>
      <div class=&quot;bk-head&quot;><span class=&quot;bk-title&quot;>① 取り込み（ソースを選んで読み込み）</span></div>
      <p class=&quot;hint&quot; style=&quot;margin-top:4px;&quot;>ソース別に選べます。列名が違っても「日付・タスク・時間・タグ」を自動で見分けます。時間は <code>（90分）</code><code>90分</code><code>1h</code><code>1:30</code><code>2時間</code> などに対応。</p>

      <div class=&quot;hub-src&quot;>
        <div class=&quot;hub-src-row&quot;>
          <span class=&quot;hub-src-label&quot;>📓 Notion</span>
          <button onclick=&quot;document.getElementById('hubNotionCsv').click()&quot;>CSVを読み込む</button>
          <input type=&quot;file&quot; id=&quot;hubNotionCsv&quot; class=&quot;hidden-file&quot; accept=&quot;.csv,text/csv&quot; onchange=&quot;hubImport(this,'notion','csv')&quot;>
          <button onclick=&quot;document.getElementById('hubNotionMd').click()&quot;>Markdownを読み込む</button>
          <input type=&quot;file&quot; id=&quot;hubNotionMd&quot; class=&quot;hidden-file&quot; accept=&quot;.md,.markdown,.txt,text/markdown,text/plain&quot; onchange=&quot;hubImport(this,'notion','md')&quot;>
          <span class=&quot;hint&quot; style=&quot;margin:0;&quot;>DBを「Markdown &amp;amp; CSV」で書き出し</span>
        </div>
        <div class=&quot;hub-src-row&quot;>
          <span class=&quot;hub-src-label&quot;>📊 Excel</span>
          <button onclick=&quot;document.getElementById('hubExcelXlsx').click()&quot;>.xlsxを読み込む</button>
          <input type=&quot;file&quot; id=&quot;hubExcelXlsx&quot; class=&quot;hidden-file&quot; accept=&quot;.xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet&quot; onchange=&quot;hubImport(this,'excel','xlsx')&quot;>
          <button onclick=&quot;document.getElementById('hubExcelCsv').click()&quot;>CSVを読み込む</button>
          <input type=&quot;file&quot; id=&quot;hubExcelCsv&quot; class=&quot;hidden-file&quot; accept=&quot;.csv,text/csv&quot; onchange=&quot;hubImport(this,'excel','csv')&quot;>
          <span class=&quot;hint&quot; style=&quot;margin:0;&quot;>.xlsx不可の環境はCSV保存で</span>
        </div>
        <div class=&quot;hub-src-row&quot;>
          <span class=&quot;hub-src-label&quot;>🏫 アプリ内</span>
          <button onclick=&quot;hubFromLog()&quot;>時間割の保存ログから取り込む</button>
        </div>
      </div>

      <label style=&quot;margin-top:8px;&quot;>またはメモを貼り付け（複数日OK・追記されます）</label>
      <textarea id=&quot;hub_paste&quot; placeholder=&quot;例）&amp;#10;2026/05/01&amp;#10;・教材スライド作成（90分）#資料作成&amp;#10;・演習レビュー 45分 #レビュー&amp;#10;2026/05/02&amp;#10;・模試の採点 1h #採点&quot; style=&quot;min-height:80px&quot;></textarea>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;hubAddPaste()&quot;>↓ 貼り付け分を統合に追加</button>
    </div>

    <!-- 旧input（互換のため残す。未使用） -->
    <input type=&quot;file&quot; id=&quot;hubFileCsv&quot; class=&quot;hidden-file&quot; onchange=&quot;hubImportText(this)&quot;>
    <input type=&quot;file&quot; id=&quot;hubFileXlsx&quot; class=&quot;hidden-file&quot; onchange=&quot;hubImportXlsx(this)&quot;>

    <div class=&quot;sk-block&quot;>
      <div class=&quot;bk-head&quot;><span class=&quot;bk-title&quot;>② 統合プレビュー</span>
        <span class=&quot;hint&quot; id=&quot;hub_meta&quot; style=&quot;margin:0;&quot;></span></div>
      <div id=&quot;hub_preview&quot; style=&quot;max-height:240px;overflow:auto;border:1px solid var(--line-soft);border-radius:10px;padding:8px;&quot;>
        <span class=&quot;empty&quot;>まだ取り込みがありません。上の①から取り込んでください。</span>
      </div>
      <div class=&quot;log-actions&quot; style=&quot;margin-top:8px;&quot;>
        <button onclick=&quot;hubClear()&quot;>🗑 統合データをクリア</button>
      </div>
    </div>

    <div class=&quot;sk-block&quot; style=&quot;background:linear-gradient(160deg,#fff6e9,#fff);&quot;>
      <div class=&quot;bk-head&quot;><span class=&quot;bk-title&quot;>③ 統合データを活用</span></div>
      <div class=&quot;log-actions&quot;>
        <button class=&quot;primary&quot; onclick=&quot;hubToMonthly()&quot;>📋 月末報告書に送って生成（時間計算）</button>
        <button onclick=&quot;hubToMonthlyXlsx()&quot;>📊 月末報告書をExcelで出力</button>
        <button class=&quot;primary&quot; onclick=&quot;hubToSkill()&quot;>📐 スキルシートの下書きに送る</button>
      </div>
      <p class=&quot;tt-legend&quot;>💡 「月末報告書」は時間割タブの丸め単位（5/10/15/30/60分）で集計します。最大31日分まで統合できます。</p>
    </div>
  </div>

  <!-- ============ OUTPUT ============ -->
  <div class=&quot;outwrap&quot;>
    <div class=&quot;outhead&quot;>
      <h2>生成結果</h2>
      <div class=&quot;outbtns&quot;>
        <button onclick=&quot;reportFromOutput()&quot;>📋 今日の日報</button>
        <button onclick=&quot;weeklyReviewFromOutput()&quot;>🗓 週次振り返り</button>
        <button onclick=&quot;kaizenMTGFromOutput()&quot;>🛠 カイゼンMTG</button>
        <button onclick=&quot;monthlyReportFromOutput()&quot;>📋 月末報告書</button>
        <button onclick=&quot;pdcaFromOutput()&quot;>🔄 一人MTG</button>
        <button onclick=&quot;mtg2FromOutput()&quot;>🎯 一人MTG2</button>
        <button onclick=&quot;skillFromOutput()&quot;>📐 スキルシート</button>
        <button onclick=&quot;tplDocFromOutput()&quot;>🧩 ひな形日報</button>
        <button onclick=&quot;copyOut()&quot;>📋 コピー</button>
        <button onclick=&quot;downloadOut('txt')&quot;>⬇️ テキスト保存(.txt)</button>
        <button onclick=&quot;downloadOut('md')&quot;>⬇️ マークダウン保存(.md)</button>
        <button onclick=&quot;document.getElementById('output').value=''&quot;>🗑 クリア</button>
      </div>
    </div>
    <p class=&quot;hint&quot; id=&quot;mdNote&quot; style=&quot;display:none;margin:0 0 8px;&quot;>
      💡 メモ版は「テキスト保存」で罫線レイアウト版、「マークダウン保存」で見出し・チェックボックス付きのMarkdown版を保存します。
    </p>
    <textarea id=&quot;output&quot; placeholder=&quot;ここに生成結果が表示されます。&quot;></textarea>
  </div>

  <p class=&quot;foot&quot;>🐰 うさうさ先生 ─ 面白きこともなき世を面白く</p>
</div>

<div class=&quot;toast&quot; id=&quot;toast&quot;></div>

<script>
&quot;use strict&quot;;
var currentTab = &quot;report&quot;;
var BAR  = &quot;━&quot;.repeat(28);
var BAR2 = &quot;─&quot;.repeat(28);

/* ============ 言語切替（日本語／英語）＋テーマ ============ */
var I18N={
  jp:{
    title:&quot;うさうさ 日報作成ジェネレーター&quot;,
    subtitle:&quot;登録不要・インストール不要。ブラウザだけで日報・ふりかえり・スキルシート・月末の工数集計まで作れる無料ツールです。入力した内容はあなたの端末の中だけに保存され、どこにも送信されません。&quot;
  },
  en:{
    title:&quot;Usausa Daily Report Generator&quot;,
    subtitle:&quot;No sign-up, no install. A free browser tool for daily reports, reviews, skill sheets and monthly time totals. Your data stays only on your device and is never sent anywhere.&quot;
  }
};
var UI_DICT={&quot;① 基本情報&quot;: &quot;1. Basic Info&quot;, &quot;② 本日の業務内容&quot;: &quot;2. Today’s Work&quot;, &quot;③ 成果・進捗&quot;: &quot;3. Results &amp; Progress&quot;, &quot;④ 課題・問題点&quot;: &quot;4. Issues &amp; Problems&quot;, &quot;⑤ 対応・アクション&quot;: &quot;5. Actions Taken&quot;, &quot;⑥ 学び・気づき&quot;: &quot;6. Learnings&quot;, &quot;⑦ 共有事項（上長・関係者向け）&quot;: &quot;7. To Share (for managers/team)&quot;, &quot;⑧ 明日の予定&quot;: &quot;8. Plan for Tomorrow&quot;, &quot;ヘッダ&quot;: &quot;Header&quot;, &quot;✅ 今日すること&quot;: &quot;✅ Today’s To-Dos&quot;, &quot;📊 作業進捗&quot;: &quot;📊 Progress&quot;, &quot;🚩 依頼・相談 一覧&quot;: &quot;🚩 Requests &amp; Questions&quot;, &quot;📅 明日すること&quot;: &quot;📅 Tomorrow’s To-Dos&quot;, &quot;🩺 デイリー習慣&quot;: &quot;🩺 Daily Habits&quot;, &quot;🧠 退社前 1分セルフチェック&quot;: &quot;🧠 1-min Self Check&quot;, &quot;相談チャットテンプレ（Slack / Mattermost コピペ用）&quot;: &quot;Chat Templates (for Slack / Mattermost)&quot;, &quot;🌅 朝のHR（朝に書く）&quot;: &quot;🌅 Morning Check-in&quot;, &quot;🕘 時間割（08:00〜18:00）&quot;: &quot;🕘 Timetable (08:00–18:00)&quot;, &quot;📊 予定 vs 実績（自動計算）&quot;: &quot;📊 Plan vs Actual (auto)&quot;, &quot;🏁 帰りのHR（夕方に書く）&quot;: &quot;🏁 End-of-day Check-in&quot;, &quot;📅 30日ログ（保存・Excel入出力）&quot;: &quot;📅 30-day Log (save / Excel)&quot;, &quot;📋 月末報告書（時間集計つき）&quot;: &quot;📋 Monthly Report (with time totals)&quot;, &quot;🛠 個人用カイゼンMTG（Keep / Try / Change）&quot;: &quot;🛠 Personal Kaizen MTG (Keep / Try / Change)&quot;, &quot;📐 スキルシート 案件欄（1案件 = 1セット）&quot;: &quot;📐 Skill Sheet – Project (1 project = 1 set)&quot;, &quot;📅 30日ログ（案件スタック・Excel入出力）&quot;: &quot;📅 30-day Log (project stack / Excel)&quot;, &quot;🔄 一人MTG（PDCA）&quot;: &quot;🔄 Solo MTG (PDCA)&quot;, &quot;🎯 一人MTG2（目標設定 ＋ KPT）&quot;: &quot;🎯 Solo MTG 2 (Goals + KPT)&quot;, &quot;🧩 自由ひな形（日報）&quot;: &quot;🧩 Custom Template (report)&quot;, &quot;🗂 月次データ統合（最大31件 → 月末報告書・スキルシート）&quot;: &quot;🗂 Monthly Data Hub (up to 31 → Report / Skill Sheet)&quot;, &quot;生成結果&quot;: &quot;Output&quot;, &quot;⚠ ブロッカー / 詰まり&quot;: &quot;⚠ Blockers&quot;, &quot;区分別 累計時間（保存した全日）&quot;: &quot;Time by Category (all saved days)&quot;, &quot;作業内容の候補（チェックしたものを「作業内容」に流し込み）&quot;: &quot;Task candidates (checked ones go to Work Details)&quot;, &quot;メタデータ（外枠9項目）&quot;: &quot;Metadata (9 fields)&quot;, &quot;企業・プロジェクト名（タイトル行）&quot;: &quot;Company / Project (title line)&quot;, &quot;本文ボリューム判定&quot;: &quot;Length Check&quot;, &quot;📊 提出前チェック&quot;: &quot;📊 Pre-submit Check&quot;, &quot;🎯 目標設定（2段階＋期日）&quot;: &quot;🎯 Goals (2 levels + due date)&quot;, &quot;🔁 ふりかえり（KPT ＋ Change）&quot;: &quot;🔁 Reflection (KPT + Change)&quot;, &quot;差し込み入力&quot;: &quot;Fill-in Fields&quot;, &quot;日付&quot;: &quot;Date&quot;, &quot;氏名&quot;: &quot;Name&quot;, &quot;場所&quot;: &quot;Location&quot;, &quot;勤務時間（開始〜終了）&quot;: &quot;Work hours (start–end)&quot;, &quot;実働&quot;: &quot;Actual hours&quot;, &quot;今日の成果物&quot;: &quot;Today’s deliverables&quot;, &quot;進捗率&quot;: &quot;Progress %&quot;, &quot;KPIに対する進捗&quot;: &quot;Progress vs KPI&quot;, &quot;1. 発生した問題&quot;: &quot;1. Problem&quot;, &quot;2. 前提・背景&quot;: &quot;2. Background&quot;, &quot;3. やりたいこと&quot;: &quot;3. Goal&quot;, &quot;4. 解決方法&quot;: &quot;4. Approach&quot;, &quot;5. 環境&quot;: &quot;5. Environment&quot;, &quot;6. 原因（仮説）&quot;: &quot;6. Cause (hypothesis)&quot;, &quot;7. 影響範囲&quot;: &quot;7. Impact&quot;, &quot;明日の対応予定&quot;: &quot;Plan for tomorrow&quot;, &quot;今日の学び&quot;: &quot;Today’s learning&quot;, &quot;次に活かすこと&quot;: &quot;How to apply it next&quot;, &quot;報告事項&quot;: &quot;Updates&quot;, &quot;相談事項&quot;: &quot;Questions&quot;, &quot;支援依頼&quot;: &quot;Help needed&quot;, &quot;タスク&quot;: &quot;Task&quot;, &quot;想定時間&quot;: &quot;Est. time&quot;, &quot;優先順位&quot;: &quot;Priority&quot;, &quot;役割&quot;: &quot;Role&quot;, &quot;気分&quot;: &quot;Mood&quot;, &quot;一言&quot;: &quot;A word&quot;, &quot;🕘 タイムテーブルを含める&quot;: &quot;🕘 Include timetable&quot;, &quot;メイン業務&quot;: &quot;Main work&quot;, &quot;メイン業務以外（学習・整備・社内貢献）&quot;: &quot;Other (learning, upkeep, contribution)&quot;, &quot;趣味枠（個人開発・記事・インプット）&quot;: &quot;Personal (side projects, writing, input)&quot;, &quot;今日 相談すること（@誰に / 何を / なぜ / 口頭 or Slack）&quot;: &quot;To discuss today (@who / what / why / verbal or Slack)&quot;, &quot;✓ 完了したこと&quot;: &quot;✓ Done&quot;, &quot;→ 着手中・持ち越し&quot;: &quot;→ In progress / carried over&quot;, &quot;内容&quot;: &quot;Details&quot;, &quot;影響&quot;: &quot;Impact&quot;, &quot;必要なアクション&quot;: &quot;Action needed&quot;, &quot;相手&quot;: &quot;To whom&quot;, &quot;📨 サポート依頼（@誰／内容／期限／状態）&quot;: &quot;📨 Support request (@who / what / due / status)&quot;, &quot;🔍 レビュー依頼（@誰／URL／観点／期限）&quot;: &quot;🔍 Review request (@who / URL / focus / due)&quot;, &quot;👥 他の人と相談が必要（関係者／議題／形式／いつ）&quot;: &quot;👥 Need to discuss (people / topic / format / when)&quot;, &quot;💭 その他・気になっていること&quot;: &quot;💭 Other notes&quot;, &quot;メイン業務以外&quot;: &quot;Other work&quot;, &quot;趣味枠&quot;: &quot;Personal&quot;, &quot;明日 相談すること&quot;: &quot;To discuss tomorrow&quot;, &quot;🗓 今週／来週も含める（金曜の棚卸し用）&quot;: &quot;🗓 Include this/next week (for Friday review)&quot;, &quot;今週すること（残り・メイン）&quot;: &quot;This week (main)&quot;, &quot;今週すること（以外・趣味）&quot;: &quot;This week (other)&quot;, &quot;来週すること（メイン）&quot;: &quot;Next week (main)&quot;, &quot;来週すること（以外・趣味）&quot;: &quot;Next week (other)&quot;, &quot;📆 今月／来月も含める（月初・月末用）&quot;: &quot;📆 Include this/next month&quot;, &quot;今月すること（月次目標）&quot;: &quot;This month (goals)&quot;, &quot;今月すること（以外・趣味）&quot;: &quot;This month (other)&quot;, &quot;来月すること&quot;: &quot;Next month&quot;, &quot;☕ 休憩10分 × 社内記事ドラフト1段落&quot;: &quot;☕ 10-min break × draft one paragraph&quot;, &quot;🏁 定時退社（残業せず帰る）&quot;: &quot;🏁 Leave on time&quot;, &quot;📝 明日のタスクを書き切ってからPCを閉じる&quot;: &quot;📝 Write tomorrow’s tasks before closing PC&quot;, &quot;🧹 受信トレイ／DMをゼロ（既読＋ピン整理）&quot;: &quot;🧹 Inbox / DMs to zero&quot;, &quot;🌙 持ち帰り思考をしない&quot;: &quot;🌙 Don’t take work thoughts home&quot;, &quot;今日の3大ToDoのうち最低1つは完了した&quot;: &quot;Finished at least 1 of the top 3 to-dos&quot;, &quot;😰 を抱えたまま帰ろうとしていない&quot;: &quot;Not leaving while stressed&quot;, &quot;明日の最初の30分で着手することが決まっている&quot;: &quot;First 30 min of tomorrow is decided&quot;, &quot;来週繰越すべきタスクを「今週すること」に書いた&quot;: &quot;Wrote carry-over tasks into “This week”&quot;, &quot;テンプレを選ぶ&quot;: &quot;Choose template&quot;, &quot;状況&quot;: &quot;Situation&quot;, &quot;選択肢A&quot;: &quot;Option A&quot;, &quot;選択肢B&quot;: &quot;Option B&quot;, &quot;私の推し案（理由）&quot;: &quot;My pick (why)&quot;, &quot;ほしい判断&quot;: &quot;Decision needed&quot;, &quot;あなたの名前&quot;: &quot;Your name&quot;, &quot;何について&quot;: &quot;About what&quot;, &quot;何が分からないか&quot;: &quot;What’s unclear&quot;, &quot;自分で確認したこと&quot;: &quot;What I checked&quot;, &quot;いつまでに方針が欲しいか&quot;: &quot;When you need direction&quot;, &quot;業務影響&quot;: &quot;Business impact&quot;, &quot;対象URL&quot;: &quot;URL&quot;, &quot;見てほしい観点1&quot;: &quot;Focus 1&quot;, &quot;観点2&quot;: &quot;Focus 2&quot;, &quot;期限&quot;: &quot;Due&quot;, &quot;補足&quot;: &quot;Notes&quot;, &quot;事実&quot;: &quot;Facts&quot;, &quot;影響範囲&quot;: &quot;Impact&quot;, &quot;現在の対応&quot;: &quot;Current action&quot;, &quot;判断ほしい点&quot;: &quot;Decision needed&quot;, &quot;変更・連絡内容&quot;: &quot;Change / notice&quot;, &quot;関連URL&quot;: &quot;Related URL&quot;, &quot;件名・議題&quot;: &quot;Subject / topic&quot;, &quot;△△さん（必要な理由）&quot;: &quot;Person A (why needed)&quot;, &quot;□□さん（必要な理由）&quot;: &quot;Person B (why needed)&quot;, &quot;形式&quot;: &quot;Format&quot;, &quot;いつ頃&quot;: &quot;When&quot;, &quot;昨日&quot;: &quot;Yesterday&quot;, &quot;今日&quot;: &quot;Today&quot;, &quot;ブロッカー&quot;: &quot;Blockers&quot;, &quot;相談&quot;: &quot;Questions&quot;, &quot;本日の合意事項（1行＝1項目）&quot;: &quot;Agreements today (1 per line)&quot;, &quot;次回までのアクション：弊社&quot;: &quot;Action by next time: us&quot;, &quot;次回までのアクション：貴社&quot;: &quot;Action by next time: you&quot;, &quot;次回予定 日時&quot;: &quot;Next meeting&quot;, &quot;候補&quot;: &quot;Options&quot;, &quot;報告の長さ&quot;: &quot;Report length&quot;, &quot;案件・テーマ&quot;: &quot;Project / theme&quot;, &quot;全体ステータス&quot;: &quot;Overall status&quot;, &quot;全体進捗％&quot;: &quot;Overall %&quot;, &quot;期限・納期（任意）&quot;: &quot;Due date (optional)&quot;, &quot;タスク（タップで追加。各タスクに状態と％）&quot;: &quot;Tasks (tap to add; status &amp; % each)&quot;, &quot;次のアクション&quot;: &quot;Next actions&quot;, &quot;リスク・困りごと（任意）&quot;: &quot;Risks / concerns (optional)&quot;, &quot;今日の天気（気分）&quot;: &quot;Today’s weather (mood)&quot;, &quot;出席（勤務地）&quot;: &quot;Attendance (location)&quot;, &quot;今日のめあて（いちばん大事な1つ）&quot;: &quot;Today’s goal (the one that matters most)&quot;, &quot;意気込み・一言&quot;: &quot;A word of resolve&quot;, &quot;丸め単位（時間計算）&quot;: &quot;Rounding unit (time calc)&quot;, &quot;丸め方&quot;: &quot;Rounding method&quot;, &quot;できたこと（Keep）&quot;: &quot;What went well (Keep)&quot;, &quot;できなかった・課題（Problem）&quot;: &quot;Issues (Problem)&quot;, &quot;明日へ（Try）&quot;: &quot;For tomorrow (Try)&quot;, &quot;先生から一言（自己評価・ねぎらい）&quot;: &quot;A word to yourself&quot;, &quot;対象月（任意・見出しに表示）&quot;: &quot;Target month (optional)&quot;, &quot;期間 開始日（任意）&quot;: &quot;From (optional)&quot;, &quot;期間 終了日（任意）&quot;: &quot;To (optional)&quot;, &quot;リーダーに伝えたいこと（自由記入・任意）&quot;: &quot;Message to your lead (optional)&quot;, &quot;趣味枠の振り返り（個人開発・記事・インプットなど）&quot;: &quot;Personal review (side projects, writing, input)&quot;, &quot;Change：やめる・変えること（自由記入）&quot;: &quot;Change: stop / change&quot;, &quot;メモを貼り付け（複数日OK。日付行＋作業行をそのまま貼ってください）&quot;: &quot;Paste memos (multi-day OK; date line + task lines)&quot;, &quot;業種（2,3文字）&quot;: &quot;Industry (short)&quot;, &quot;役割（2,3文字）&quot;: &quot;Role (short)&quot;, &quot;期間（1行＋1行）&quot;: &quot;Period (2 lines)&quot;, &quot;規模&quot;: &quot;Scale&quot;, &quot;言語／ツール&quot;: &quot;Languages / tools&quot;, &quot;サーバ／OS&quot;: &quot;Server / OS&quot;, &quot;環境／ミドルウェア&quot;: &quot;Env / middleware&quot;, &quot;担当工程（5つ程度）&quot;: &quot;Phases (about 5)&quot;, &quot;すべての■ブロックが埋まっている（5ブロック）&quot;: &quot;All 5 blocks filled in&quot;, &quot;企業名・システム名の特定表現が無い&quot;: &quot;No identifying company / system names&quot;, &quot;作業内容の箇条書きが動詞語尾で揃っている&quot;: &quot;Bullet points end with verbs consistently&quot;, &quot;対応工程に期間（yyyy/mm〜yyyy/mm）が入っている&quot;: &quot;Phases include period (yyyy/mm–yyyy/mm)&quot;, &quot;成果物に可能な限り数字を入れた&quot;: &quot;Deliverables include numbers where possible&quot;, &quot;担当工程と本文の内容が一致している&quot;: &quot;Phases match the body content&quot;, &quot;ステップ終了時に音を鳴らす&quot;: &quot;Beep at each step end&quot;, &quot;テーマ・案件（任意）&quot;: &quot;Theme / project (optional)&quot;, &quot;期日（いつまでに）&quot;: &quot;Due date&quot;, &quot;🟢 最低限の目標（これは必ず）&quot;: &quot;🟢 Minimum goal (must do)&quot;, &quot;所要時間の見込み&quot;: &quot;Est. time&quot;, &quot;🌟 最高の目標（できたら最高）&quot;: &quot;🌟 Best-case goal&quot;, &quot;✅ Keep（続けたい・うまくいった）&quot;: &quot;✅ Keep (worked well)&quot;, &quot;🌧 Problem（課題・困りごと）&quot;: &quot;🌧 Problem (issues)&quot;, &quot;🌱 Try（次に試す）&quot;: &quot;🌱 Try (next)&quot;, &quot;🔄 Change（やめる・変える）&quot;: &quot;🔄 Change (stop / change)&quot;, &quot;ひな形の名前&quot;: &quot;Template name&quot;, &quot;ひな形の本文（{{差し込み名}} を自由に書けます）&quot;: &quot;Template body (use {{field}} freely)&quot;, &quot;またはメモを貼り付け（複数日OK・追記されます）&quot;: &quot;Or paste memos (multi-day; appended)&quot;, &quot;🇯🇵 日本語&quot;: &quot;🇯🇵 日本語&quot;, &quot;＋ タスクを追加&quot;: &quot;+ Add task&quot;, &quot;📋 業務日報を生成する&quot;: &quot;📋 Generate report&quot;, &quot;📝 メモ版を生成する&quot;: &quot;📝 Generate memo&quot;, &quot;💬 チャット文面を生成する&quot;: &quot;💬 Generate chat message&quot;, &quot;＋ コマを追加&quot;: &quot;+ Add slot&quot;, &quot;＋追加&quot;: &quot;+ Add&quot;, &quot;🏫 時間割＋振り返りを生成する&quot;: &quot;🏫 Generate timetable + review&quot;, &quot;💾 この日を保存／上書き&quot;: &quot;💾 Save / overwrite this day&quot;, &quot;📊 Excelエクスポート(.xlsx)&quot;: &quot;📊 Export Excel (.xlsx)&quot;, &quot;📄 CSVエクスポート&quot;: &quot;📄 Export CSV&quot;, &quot;📥 CSVインポート&quot;: &quot;📥 Import CSV&quot;, &quot;🗑 全消去&quot;: &quot;🗑 Clear all&quot;, &quot;📋 月末報告書を生成する（保存ログから）&quot;: &quot;📋 Generate monthly report (from log)&quot;, &quot;📊 月末報告書をExcelで出力（保存ログ・タスク工数／丸め単位は上の設定）&quot;: &quot;📊 Export monthly report to Excel (from log; unit above)&quot;, &quot;📄 メモCSV/テキストを読み込む（追記）&quot;: &quot;📄 Load memo CSV/text (append)&quot;, &quot;📋 メモから月末報告書を生成&quot;: &quot;📋 Generate monthly report from memo&quot;, &quot;📊 メモからExcel出力（タスク工数／丸め単位は上の設定）&quot;: &quot;📊 Export Excel from memo (unit above)&quot;, &quot;🛠 カイゼンMTGを生成する&quot;: &quot;🛠 Generate Kaizen MTG&quot;, &quot;📥 時間割の30日ログから取り込む&quot;: &quot;📥 Import from 30-day timetable log&quot;, &quot;📄 メモ日報CSV/テキストを読み込む&quot;: &quot;📄 Load memo CSV/text&quot;, &quot;↑ 貼り付けたメモから候補を抽出&quot;: &quot;↑ Extract candidates from pasted memo&quot;, &quot;✅ チェックした候補を作業内容へ&quot;: &quot;✅ Send checked candidates to Work Details&quot;, &quot;全選択&quot;: &quot;Select all&quot;, &quot;全解除&quot;: &quot;Clear all&quot;, &quot;📝 期間・対応工程も下書きに反映&quot;: &quot;📝 Also draft period &amp; phases&quot;, &quot;＋ 行を追加&quot;: &quot;+ Add row&quot;, &quot;📐 スキルシート案件欄を生成する&quot;: &quot;📐 Generate skill sheet&quot;, &quot;💾 この案件を保存／上書き&quot;: &quot;💾 Save / overwrite this project&quot;, &quot;▶ MTG開始（自動）&quot;: &quot;▶ Start MTG (auto)&quot;, &quot;⏸ 一時停止&quot;: &quot;⏸ Pause&quot;, &quot;⏭ 次のステップ&quot;: &quot;⏭ Next step&quot;, &quot;↺ リセット&quot;: &quot;↺ Reset&quot;, &quot;3分&quot;: &quot;3 min&quot;, &quot;5分&quot;: &quot;5 min&quot;, &quot;10分&quot;: &quot;10 min&quot;, &quot;15分&quot;: &quot;15 min&quot;, &quot;📥 保存ログからCheck/Actを下書き&quot;: &quot;📥 Draft Check/Act from log&quot;, &quot;🔄 一人MTG（PDCA）を生成する&quot;: &quot;🔄 Generate Solo MTG (PDCA)&quot;, &quot;📥 保存ログからKeep/Problem/Tryを下書き&quot;: &quot;📥 Draft Keep/Problem/Try from log&quot;, &quot;🎯 一人MTG2を生成する&quot;: &quot;🎯 Generate Solo MTG 2&quot;, &quot;💾 このひな形を保存／上書き&quot;: &quot;💾 Save / overwrite template&quot;, &quot;＋ 新規&quot;: &quot;+ New&quot;, &quot;⬇️ ひな形をJSONで書き出し&quot;: &quot;⬇️ Export templates as JSON&quot;, &quot;📥 JSONを取り込み&quot;: &quot;📥 Import JSON&quot;, &quot;🧩 このひな形で日報を生成する&quot;: &quot;🧩 Generate report from this template&quot;, &quot;CSVを読み込む&quot;: &quot;Load CSV&quot;, &quot;Markdownを読み込む&quot;: &quot;Load Markdown&quot;, &quot;.xlsxを読み込む&quot;: &quot;Load .xlsx&quot;, &quot;時間割の保存ログから取り込む&quot;: &quot;Import from timetable log&quot;, &quot;↓ 貼り付け分を統合に追加&quot;: &quot;↓ Add pasted memo to hub&quot;, &quot;🗑 統合データをクリア&quot;: &quot;🗑 Clear hub data&quot;, &quot;📋 月末報告書に送って生成（時間計算）&quot;: &quot;📋 Send to monthly report (time calc)&quot;, &quot;📊 月末報告書をExcelで出力&quot;: &quot;📊 Export monthly report to Excel&quot;, &quot;📐 スキルシートの下書きに送る&quot;: &quot;📐 Send to skill sheet draft&quot;, &quot;📋 今日の日報&quot;: &quot;📋 Today’s report&quot;, &quot;🗓 週次振り返り&quot;: &quot;🗓 Weekly review&quot;, &quot;🛠 カイゼンMTG&quot;: &quot;🛠 Kaizen MTG&quot;, &quot;📋 月末報告書&quot;: &quot;📋 Monthly report&quot;, &quot;🔄 一人MTG&quot;: &quot;🔄 Solo MTG&quot;, &quot;🎯 一人MTG2&quot;: &quot;🎯 Solo MTG 2&quot;, &quot;📐 スキルシート&quot;: &quot;📐 Skill sheet&quot;, &quot;🧩 ひな形日報&quot;: &quot;🧩 Template report&quot;, &quot;📋 コピー&quot;: &quot;📋 Copy&quot;, &quot;⬇️ テキスト保存(.txt)&quot;: &quot;⬇️ Save text (.txt)&quot;, &quot;⬇️ マークダウン保存(.md)&quot;: &quot;⬇️ Save Markdown (.md)&quot;, &quot;🗑 クリア&quot;: &quot;🗑 Clear&quot;, &quot;対面&quot;: &quot;In person&quot;, &quot;リモート&quot;: &quot;Remote&quot;, &quot;在宅&quot;: &quot;WFH&quot;, &quot;ハイブリッド&quot;: &quot;Hybrid&quot;, &quot;IT研修講師&quot;: &quot;IT Trainer&quot;, &quot;社内SE&quot;: &quot;Internal SE&quot;, &quot;IT営業&quot;: &quot;IT Sales&quot;, &quot;A：相談（判断を仰ぐ）&quot;: &quot;A: Consult (ask for a decision)&quot;, &quot;B：質問（教えてほしい）&quot;: &quot;B: Question (need info)&quot;, &quot;C：レビュー依頼&quot;: &quot;C: Review request&quot;, &quot;D：即時報告（障害／クレーム）&quot;: &quot;D: Urgent report (incident/complaint)&quot;, &quot;E：連絡（返信不要）&quot;: &quot;E: Notice (no reply needed)&quot;, &quot;F：他の人と相談したい（巻き込み）&quot;: &quot;F: Loop others in&quot;, &quot;G：朝会・夕会の簡易日報&quot;: &quot;G: Stand-up quick report&quot;, &quot;H：営業向け お礼＋次アクション&quot;: &quot;H: Sales thank-you + next steps&quot;, &quot;I：進捗報告（ステータス・％／1分・3分・5分・PREP）&quot;: &quot;I: Progress report (status/% ; 1/3/5 min, PREP)&quot;, &quot;ザッと見でOK&quot;: &quot;Quick look is fine&quot;, &quot;詳細指摘歓迎&quot;: &quot;Detailed feedback welcome&quot;, &quot;どちらでも&quot;: &quot;Either&quot;, &quot;軽微&quot;: &quot;Minor&quot;, &quot;なし&quot;: &quot;None&quot;, &quot;グループMTG&quot;: &quot;Group meeting&quot;, &quot;非同期スレッド&quot;: &quot;Async thread&quot;, &quot;本日中&quot;: &quot;Today&quot;, &quot;今週中&quot;: &quot;This week&quot;, &quot;来週前半&quot;: &quot;Early next week&quot;, &quot;PREP（結論→理由→例→結論）&quot;: &quot;PREP (point→reason→example→point)&quot;, &quot;1分（廊下でサッと）&quot;: &quot;1 min (quick)&quot;, &quot;3分（定例向け）&quot;: &quot;3 min (for meetings)&quot;, &quot;5分（しっかり）&quot;: &quot;5 min (full)&quot;, &quot;🟢 順調&quot;: &quot;🟢 On track&quot;, &quot;🟡 やや遅延&quot;: &quot;🟡 Slightly behind&quot;, &quot;🔴 要対応&quot;: &quot;🔴 Needs attention&quot;, &quot;✅ 完了&quot;: &quot;✅ Done&quot;, &quot;☀️ 快調&quot;: &quot;☀️ Great&quot;, &quot;⛅ ふつう&quot;: &quot;⛅ OK&quot;, &quot;🌧 いまいち&quot;: &quot;🌧 Not great&quot;, &quot;5分単位&quot;: &quot;5-min unit&quot;, &quot;10分単位&quot;: &quot;10-min unit&quot;, &quot;15分単位&quot;: &quot;15-min unit&quot;, &quot;30分単位&quot;: &quot;30-min unit&quot;, &quot;1時間単位&quot;: &quot;1-hour unit&quot;, &quot;四捨五入（最も近い単位）&quot;: &quot;Round (nearest unit)&quot;, &quot;切り上げ（単位を必ず確保）&quot;: &quot;Round up (always reserve a unit)&quot;, &quot;タスクごとに 状態・目的・所要時間 を入力。状態は 完了／対応中／未完了。&quot;: &quot;Enter status, purpose and time per task. Status: Done / In progress / Not done.&quot;, &quot;該当しない欄は空のままでOK（空欄は出力されません）。&quot;: &quot;Leave fields blank if not relevant (blanks are not output).&quot;, &quot;1行ずつ自由記入（例：09:00-10:00 ｜ 朝会・メール処理）。空なら標準枠を出力します。&quot;: &quot;One per line (e.g. 09:00-10:00 | stand-up, email). Blank uses a default schedule.&quot;, &quot;1行＝1項目。チェックボックス [ ] が自動で付きます。&quot;: &quot;One item per line. Checkboxes [ ] are added automatically.&quot;, &quot;朝に「予定」を埋める → 夕方に「実績」と達成度を入れる。予定時間と達成は下で自動計算します。&quot;: &quot;Fill “Plan” in the morning, then “Actual” and rating in the evening. Time and rating are auto-calculated below.&quot;, &quot;💡 予定・実績に #資料作成 のように # でタグを書くと、タグごとの時間を積み上げ集計します（月末報告書にも反映）。&quot;: &quot;💡 Add #tags (e.g. #docs) in Plan/Actual to total time per tag (also shown in the monthly report).&quot;, &quot;職務経歴書の案件欄サイズ感をガイド表示します。1案件ずつ書いて「この案件を保存」で30件までためられます。公開・提出時は、企業名やシステム名など特定につながる表現は避けてください。&quot;: &quot;Shows recommended sizes for a resume project entry. Write one project at a time and save up to 30. For publishing or submitting, avoid wording that identifies a company or system.&quot;, &quot;ソース別に選べます。列名が違っても「日付・タスク・時間・タグ」を自動で見分けます。時間は （90分）90分1h1:302時間 などに対応。&quot;: &quot;Choose by source. It detects Date/Task/Time/Tag even if column names differ. Time formats like (90min), 90min, 1h, 1:30, 2h are supported.&quot;, &quot;💡 メモ版は「テキスト保存」で罫線レイアウト版、「マークダウン保存」で見出し・チェックボックス付きのMarkdown版を保存します。&quot;: &quot;💡 For the memo: “Save text” gives a ruled layout; “Save Markdown” gives headings and checkboxes.&quot;, &quot;🏷 よく使うタグ（タップで挿入）&quot;: &quot;🏷 Frequent tags (tap to insert)&quot;, &quot;📝 メモから月末報告書を作る（30日分を一括貼り付け）&quot;: &quot;📝 Make a monthly report from memos (paste 30 days)&quot;, &quot;🗓 30日分から下書きを作る（1か月→スキルシート）&quot;: &quot;🗓 Draft from 30 days (month → skill sheet)&quot;, &quot;タイトル&quot;: &quot;Title&quot;, &quot;■システム内容&quot;: &quot;■ System overview&quot;, &quot;■対応工程&quot;: &quot;■ Phases&quot;, &quot;■担当業務&quot;: &quot;■ Responsibilities&quot;, &quot;■作業内容（・箇条書き）&quot;: &quot;■ Work details (bullets)&quot;, &quot;■成果物&quot;: &quot;■ Deliverables&quot;, &quot;① 取り込み（ソースを選んで読み込み）&quot;: &quot;1. Import (choose a source)&quot;, &quot;② 統合プレビュー&quot;: &quot;2. Merged preview&quot;, &quot;③ 統合データを活用&quot;: &quot;3. Use merged data&quot;};
Object.assign(UI_DICT,{&quot;🔗 退勤前報告・月末報告書に時間割（予定／実績）を連携する&quot;: &quot;🔗 Link timetable (plan/actual) to report &amp; monthly report&quot;});
Object.assign(UI_DICT,{&quot;完了&quot;: &quot;Done&quot;, &quot;対応中&quot;: &quot;In progress&quot;, &quot;未完了&quot;: &quot;Not done&quot;, &quot;⏸ 未着手&quot;: &quot;⏸ Not started&quot;, &quot;授業&quot;: &quot;Class&quot;, &quot;会議&quot;: &quot;Meeting&quot;, &quot;作業&quot;: &quot;Work&quot;, &quot;休憩&quot;: &quot;Break&quot;, &quot;その他&quot;: &quot;Other&quot;, &quot;時刻&quot;: &quot;Time&quot;, &quot;めあて&quot;: &quot;Goal&quot;, &quot;今日やったこと&quot;: &quot;What I did today&quot;, &quot;できたこと&quot;: &quot;What went well&quot;, &quot;課題&quot;: &quot;Issues&quot;, &quot;明日の予定&quot;: &quot;Plan for tomorrow&quot;, &quot;「この日を保存」で日付ごとに記録され、ブラウザ内に貯まります（最大表示30日）。貯めた記録はExcel(.xlsx)とCSVで書き出し、CSVから取り込めます。データは端末内のみで外部送信しません。&quot;: &quot;“Save this day” records each date in your browser (up to 30 shown). Export to Excel (.xlsx) and CSV, and import from CSV. Data stays on your device.&quot;, &quot;保存した日々のログから、区分別の時間集計（時間割で選んだ丸め単位）と「やったこと／達成したこと／課題／リーダーに伝えたいこと」をまとめた報告書を生成します。期間を空にすると保存した全件が対象です。&quot;: &quot;Builds a report from your saved logs: time by category (using the rounding unit you chose) plus What you did / Achieved / Issues / Message to your lead. Leave the period blank to include all saved days.&quot;, &quot;1か月ぶんのメモをまとめて貼り付け、または複数のメモCSV/テキストを読み込んで月末報告書を作れます。各行に （90分） や 90分・1h・1:30 のような時間、#タグ を書くと、タスクごと・タグごとの時間も集計します。日付行（例：2026/05/01）で日を区切れます。&quot;: &quot;Paste a month of memos, or load several memo CSV/text files, to build a monthly report. Add times like (90min), 90min, 1h, 1:30 and #tags on each line to total time per task and per tag. Use a date line (e.g. 2026/05/01) to separate days.&quot;, &quot;自分ひとりの改善ミーティング用。保存した日々のKeep・Problem・Try・達成度を集めて、KPTC（続ける／試す／やめる・変える）に整理します。趣味枠とChangeは手入力で足せます。&quot;: &quot;A solo improvement meeting. It gathers Keep / Problem / Try and ratings from your saved days into KPTC (keep / try / stop-change). Personal items and Change are added by hand.&quot;, &quot;1か月ぶんの日報メモを集めて、スキルシートの素材に変換します。① 時間割タブの30日ログから、または ② メモ版日報のテキスト/CSVを貼り付け・読み込み のどちらからでもOK。&quot;: &quot;Turns a month of report memos into skill-sheet material. Use either (1) the 30-day timetable log, or (2) pasted/loaded memo text/CSV.&quot;, &quot;「この案件を保存」で1件ずつ貯まります（最大30件表示）。Excel(.xlsx)・CSVで書き出し、CSVから取り込めます。データは端末内のみで外部送信しません。&quot;: &quot;“Save this project” stores them one by one (up to 30 shown). Export to Excel (.xlsx) / CSV and import from CSV. Data stays on your device.&quot;, &quot;ひとりで回す改善ミーティング。各ステップに時間を区切って集中できます。「▶ MTG開始」で Plan→Do→Check→Act を自動で進めます。データは端末内のみ。&quot;: &quot;A solo improvement meeting. Time-box each step to stay focused. “Start MTG” runs Plan→Do→Check→Act automatically. Data stays on your device.&quot;, &quot;「最低限の目標」と「最高の目標」を期日・時間つきで立て、Keep / Problem / Try ＋ Change でふりかえる、ひとり作戦会議です。データは端末内のみ。&quot;: &quot;A solo planning session: set a minimum goal and a best-case goal with due date and time, then reflect with Keep / Problem / Try + Change. Data stays on your device.&quot;, &quot;あなたの日報フォーマットを自由に登録して使えます。本文の中に {{案件名}} のように {{ }} で差し込み欄を書くと、下に入力欄が自動で出ます。埋めて「生成」すると差し込み済みの日報が出力されます。複数のひな形を保存・切替でき、JSONで書き出し／取り込みもできます。データは端末内のみ。&quot;: &quot;Register your own report format. Write fields like {{project}} with {{ }} and input boxes appear below. Fill them and “Generate” to output the completed report. Save and switch multiple templates, and export/import as JSON. Data stays on your device.&quot;, &quot;1か月ぶん（最大31日）のメモを、Excel(CSV)・Notion(CSV/Markdown)・貼り付けから取り込み、ひとつに統合します。統合した素材は、そのまま月末報告書（タスク工数の時間計算）にもスキルシート（作業内容の下書き）にも送れます。データは端末内のみ。&quot;: &quot;Import up to 31 days of memos from Excel (CSV), Notion (CSV/Markdown) or paste, and merge them. Send the merged material straight to the monthly report (task time calc) or the skill sheet (work-detail draft). Data stays on your device.&quot;});
Object.assign(UI_DICT,{&quot;📋 退勤前報告（業務日報）&quot;: &quot;📋 End-of-day Report&quot;, &quot;📝 メモ版 日報・進捗&quot;: &quot;📝 Memo / Progress&quot;, &quot;💬 相談チャットテンプレ&quot;: &quot;💬 Chat Templates&quot;, &quot;🏫 時間割（HR学校風）&quot;: &quot;🏫 Timetable&quot;, &quot;📐 スキルシート（案件欄）&quot;: &quot;📐 Skill Sheet&quot;, &quot;🔄 一人MTG（PDCA）&quot;: &quot;🔄 Solo MTG (PDCA)&quot;, &quot;🎯 一人MTG2（目標・KPT）&quot;: &quot;🎯 Solo MTG 2 (Goals &amp; KPT)&quot;, &quot;🧩 自由ひな形（日報）&quot;: &quot;🧩 Custom Template&quot;, &quot;🗂 月次データ統合&quot;: &quot;🗂 Monthly Data Hub&quot;});
var LANG_KEY=&quot;usausa_lang_v1&quot;;
var currentLang=&quot;jp&quot;;
// 翻訳対象セレクタ（UI要素）
var I18N_SEL=&quot;header.hero h1, header.hero p, .tab, h2, h3, label, button, option, p.hint, .bk-title, .tt-head>div, .tpl-chip&quot;;
// 元の日本語を保持してから英訳。日本語に戻すときは原文へ。
// 重要：子要素を持つ要素（例：<label><input>…</label>）は textContent 書換で
// 子（チェックボックス等）が消えるため対象外にする。テキストのみの要素だけ翻訳する。
function i18nTranslatable(el){
  // 子要素を含む場合は除外（テキストノードのみ＝childElementCount===0）
  return el.childElementCount===0;
}
// 子要素を持つ要素（例：<label><input>テキスト</label>）の直下テキストノードだけを翻訳。
// 子要素（checkbox等）は一切触らないので消えない。
function i18nTranslateChildText(el, lang){
  [].slice.call(el.childNodes).forEach(function(node){
    if(node.nodeType!==3) return; // テキストノードのみ
    var raw=node.nodeValue;
    var key=(raw||&quot;&quot;).trim();
    if(!key) return;
    // 原文保存（ノードに属性は付けられないので、要素にまとめて保存）
    var store=el.getAttribute(&quot;data-jp-textnodes&quot;);
    if(store==null){ // 初回スナップショット
      // 各テキストノードの原文を順序付きで保存
      var arr=[].slice.call(el.childNodes).filter(function(n){return n.nodeType===3;}).map(function(n){return n.nodeValue;});
      el.setAttribute(&quot;data-jp-textnodes&quot;, JSON.stringify(arr));
    }
    if(lang===&quot;en&quot;){
      var en=(typeof UI_DICT!==&quot;undefined&quot; &amp;&amp; UI_DICT[key]!=null) ? UI_DICT[key] : null;
      if(en!=null){ node.nodeValue=raw.replace(key,en); }
    } else {
      // 日本語へ戻す：保存した原文から対応するノードを復元
      try{
        var saved=JSON.parse(el.getAttribute(&quot;data-jp-textnodes&quot;)||&quot;[]&quot;);
        var textNodes=[].slice.call(el.childNodes).filter(function(n){return n.nodeType===3;});
        var idx=textNodes.indexOf(node);
        if(idx>=0 &amp;&amp; saved[idx]!=null){ node.nodeValue=saved[idx]; }
      }catch(e){}
    }
  });
}
function i18nSnapshot(){
  [].slice.call(document.querySelectorAll(I18N_SEL)).forEach(function(el){
    if(!i18nTranslatable(el)) return;
    if(el.getAttribute(&quot;data-jp&quot;)==null){ el.setAttribute(&quot;data-jp&quot;, el.textContent); }
  });
}
function applyLangText(lang){
  i18nSnapshot();
  [].slice.call(document.querySelectorAll(I18N_SEL)).forEach(function(el){
    // 子要素を持つ要素（checkbox入りlabel等）は、末尾テキストノードだけ翻訳して子は保護
    if(!i18nTranslatable(el)){
      i18nTranslateChildText(el, lang);
      return;
    }
    var jp=el.getAttribute(&quot;data-jp&quot;); if(jp==null) return;
    var key=jp.trim();
    if(lang===&quot;en&quot;){
      var en=(typeof UI_DICT!==&quot;undefined&quot; &amp;&amp; UI_DICT[key]!=null) ? UI_DICT[key] : null;
      if(en!=null){
        // 元テキストの前後空白を保ったまま中身を差し替え
        el.textContent = jp.replace(key, en);
      }
    } else {
      el.textContent = jp; // 原文（日本語）へ戻す
    }
  });
  // ヘッダのtitle/subtitleはI18Nで明示上書き（data-i18n優先）
  var dict=I18N[lang]||I18N.jp;
  [].slice.call(document.querySelectorAll(&quot;[data-i18n]&quot;)).forEach(function(el){
    var k=el.getAttribute(&quot;data-i18n&quot;); if(dict[k]!=null) el.textContent=dict[k];
  });
}
function setLang(lang){
  if(lang!==&quot;jp&quot; &amp;&amp; lang!==&quot;en&quot;) lang=&quot;jp&quot;;
  currentLang=lang;
  document.body.classList.remove(&quot;theme-jp&quot;,&quot;theme-uk&quot;);
  document.body.classList.add(lang===&quot;en&quot; ? &quot;theme-uk&quot; : &quot;theme-jp&quot;);
  applyLangText(lang);
  var jp=document.getElementById(&quot;langJp&quot;), en=document.getElementById(&quot;langEn&quot;);
  if(jp&amp;&amp;en){ jp.classList.toggle(&quot;active&quot;, lang===&quot;jp&quot;); en.classList.toggle(&quot;active&quot;, lang===&quot;en&quot;); }
  document.documentElement.lang = (lang===&quot;en&quot;?&quot;en&quot;:&quot;ja&quot;);
  if(lsAvailable()){ try{ window.localStorage.setItem(LANG_KEY, lang); }catch(e){} }
}
function initLang(){
  var saved=&quot;jp&quot;;
  if(lsAvailable()){ try{ saved=window.localStorage.getItem(LANG_KEY)||&quot;jp&quot;; }catch(e){} }
  setLang(saved);
}
// 動的に要素を足したあと、現在の言語を再適用する（英語なら新規要素も英訳）
function i18nRefresh(){ if(currentLang===&quot;en&quot;){ applyLangText(&quot;en&quot;); } }

// 生成結果を txt / md の2形式で保持（ダウンロード時に出し分け）
var lastOut = { txt:&quot;&quot;, md:&quot;&quot; };

/* ---- helpers ---- */
function v(id){ var el=document.getElementById(id); return el ? (el.value||&quot;&quot;).trim() : &quot;&quot;; }
function linesOf(id){
  var el=document.getElementById(id); if(!el) return [];
  return (el.value||&quot;&quot;).split(&quot;\n&quot;).map(function(s){return s.trim();}).filter(Boolean);
}
function block(label, items, mark){
  // returns lines: each item prefixed with mark; empty -> nothing
  if(!items.length) return &quot;&quot;;
  return items.map(function(s){ return mark + s; }).join(&quot;\n&quot;);
}
function today(){
  var d=new Date(), z=function(n){return (n<10?&quot;0&quot;:&quot;&quot;)+n;};
  return d.getFullYear()+z(d.getMonth()+1)+z(d.getDate());
}
// 曜日つき日付・時刻ヘルパ（自由ひな形の初期テンプレ用）
function nowParts(){
  var d=new Date(), z=function(n){return (n<10?&quot;0&quot;:&quot;&quot;)+n;};
  var w=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  return {
    date: d.getFullYear()+&quot;/&quot;+z(d.getMonth()+1)+&quot;/&quot;+z(d.getDate())+&quot;（&quot;+w+&quot;）&quot;, // 2026/05/21（木）
    dateJp: d.getFullYear()+&quot;年&quot;+(d.getMonth()+1)+&quot;月&quot;+d.getDate()+&quot;日（&quot;+w+&quot;）&quot;,
    weekday: w+&quot;曜日&quot;,
    time: z(d.getHours())+&quot;:&quot;+z(d.getMinutes()),
    datetime: d.getFullYear()+&quot;/&quot;+z(d.getMonth()+1)+&quot;/&quot;+z(d.getDate())+&quot;（&quot;+w+&quot;） &quot;+z(d.getHours())+&quot;:&quot;+z(d.getMinutes())
  };
}

/* ---- tabs ---- */
document.querySelectorAll(&quot;.tab&quot;).forEach(function(t){
  t.addEventListener(&quot;click&quot;, function(){
    document.querySelectorAll(&quot;.tab&quot;).forEach(function(x){x.classList.remove(&quot;active&quot;);});
    document.querySelectorAll(&quot;.panel&quot;).forEach(function(x){x.classList.remove(&quot;active&quot;);});
    t.classList.add(&quot;active&quot;);
    currentTab = t.dataset.tab;
    document.getElementById(&quot;panel-&quot;+currentTab).classList.add(&quot;active&quot;);
    document.getElementById(&quot;mdNote&quot;).style.display = (currentTab===&quot;memo&quot;||currentTab===&quot;timetable&quot;||currentTab===&quot;skill&quot;||currentTab===&quot;pdca&quot;||currentTab===&quot;mtg2&quot;) ? &quot;block&quot; : &quot;none&quot;;
  });
});

/* ---- collapsibles ---- */
function bindToggle(cbId, wrapId){
  var cb=document.getElementById(cbId);
  cb.addEventListener(&quot;change&quot;, function(){
    document.getElementById(wrapId).classList.toggle(&quot;open&quot;, cb.checked);
  });
}
bindToggle(&quot;m_tt_on&quot;,&quot;m_tt_wrap&quot;);
bindToggle(&quot;m_wk_on&quot;,&quot;m_wk_wrap&quot;);
bindToggle(&quot;m_mo_on&quot;,&quot;m_mo_wrap&quot;);

/* ---- TAB1 dynamic tasks ---- */
function addTask(){
  var row=document.createElement(&quot;div&quot;);
  row.className=&quot;task-row&quot;;
  var name=document.createElement(&quot;input&quot;); name.className=&quot;t-name&quot;; name.placeholder=&quot;タスク名&quot;;
  var sel=document.createElement(&quot;select&quot;); sel.className=&quot;t-status&quot;;
  [&quot;完了&quot;,&quot;対応中&quot;,&quot;未完了&quot;].forEach(function(s){var o=document.createElement(&quot;option&quot;);o.textContent=s;sel.appendChild(o);});
  var pur=document.createElement(&quot;input&quot;); pur.className=&quot;t-purpose&quot;; pur.placeholder=&quot;目的（〜のため）&quot;;
  var tim=document.createElement(&quot;input&quot;); tim.className=&quot;t-time&quot;; tim.placeholder=&quot;所要時間 例:09:00~12:00&quot;;
  var del=document.createElement(&quot;button&quot;); del.type=&quot;button&quot;; del.className=&quot;del&quot;; del.textContent=&quot;×&quot;;
  del.onclick=function(){ row.remove(); };
  row.appendChild(name); row.appendChild(sel); row.appendChild(pur); row.appendChild(tim); row.appendChild(del);
  document.getElementById(&quot;taskList&quot;).appendChild(row);
}
function readTasks(){
  return [].slice.call(document.querySelectorAll(&quot;#taskList .task-row&quot;)).map(function(r){
    return {
      name:r.querySelector(&quot;.t-name&quot;).value.trim(),
      status:r.querySelector(&quot;.t-status&quot;).value,
      purpose:r.querySelector(&quot;.t-purpose&quot;).value.trim(),
      time:r.querySelector(&quot;.t-time&quot;).value.trim()
    };
  }).filter(function(t){return t.name;});
}

/* ---- TAB1 build: 退勤前報告（：は残す・記号は消す） ---- */
function buildReport(){
  currentTab=&quot;report&quot;;
  var o=[];
  o.push(&quot;① 基本情報&quot;);
  o.push(&quot;・日付：&quot;+v(&quot;r_date&quot;));
  o.push(&quot;・氏名：&quot;+v(&quot;r_name&quot;));
  o.push(&quot;・場所：&quot;+v(&quot;r_place&quot;));
  var wt=v(&quot;r_time&quot;), wh=v(&quot;r_hours&quot;);
  o.push(&quot;・勤務時間：&quot;+wt+(wh?(&quot;(&quot;+wh+&quot;)&quot;):&quot;&quot;));
  o.push(&quot;&quot;);

  var tasks=readTasks();
  o.push(&quot;② 本日の業務内容&quot;);
  if(tasks.length){
    tasks.forEach(function(t,i){ o.push((i+1)+&quot;．&quot;+t.name+&quot;：&quot;+t.status); });
    var purposes=tasks.filter(function(t){return t.purpose;});
    if(purposes.length){
      o.push(&quot;&quot;); o.push(&quot;各タスクの目的&quot;);
      tasks.forEach(function(t,i){ if(t.purpose) o.push((i+1)+&quot;．&quot;+t.purpose); });
    }
    var times=tasks.filter(function(t){return t.time;});
    if(times.length){
      o.push(&quot;&quot;); o.push(&quot;所要時間&quot;);
      tasks.forEach(function(t,i){ if(t.time) o.push((i+1)+&quot;．&quot;+t.time); });
    }
  }
  // 時間割の連携（ON時）：今の時間割の実績コマを差し込む
  if(typeof isTtLink===&quot;function&quot; &amp;&amp; isTtLink()){
    var ttr=ttLinkRows();
    if(ttr.length){
      o.push(&quot;&quot;); o.push(&quot;〔時間割より〕&quot;);
      ttr.forEach(function(r){
        var t=(r.s&amp;&amp;r.e)?(r.s+&quot;-&quot;+r.e+&quot; &quot;):&quot;&quot;;
        o.push(&quot;・&quot;+t+r.text+&quot;（&quot;+r.kindLabel+(r.dur?(&quot; &quot;+r.dur+&quot;分&quot;):&quot;&quot;)+(r.planned?&quot;・予定&quot;:&quot;&quot;)+&quot;）&quot;+(r.status&amp;&amp;r.status!==&quot;—&quot;?(&quot; &quot;+r.status):&quot;&quot;));
      });
      var sum=(typeof recalcTT===&quot;function&quot;)?recalcTT():null;
      if(sum){ o.push(&quot;予定 &quot;+fmtHM(sum.planMin)+&quot; ／ 実績相当 &quot;+fmtHM(sum.actMin)+&quot; ／ 達成率 &quot;+sum.rate+&quot;%&quot;); }
    }
  }
  o.push(&quot;&quot;);

  o.push(&quot;③ 成果・進捗&quot;);
  o.push(&quot;今日の成果物：&quot;+v(&quot;r_deliver&quot;));
  o.push(&quot;進捗率：&quot;+v(&quot;r_rate&quot;));
  o.push(&quot;KPIに対する進捗：&quot;+v(&quot;r_kpi&quot;));
  o.push(&quot;&quot;);

  o.push(&quot;④ 課題・問題点&quot;);
  var probs=[
    [&quot;発生した問題&quot;, v(&quot;r_p1&quot;)],[&quot;前提・背景&quot;, v(&quot;r_p2&quot;)],[&quot;やりたいこと&quot;, v(&quot;r_p3&quot;)],
    [&quot;解決方法&quot;, v(&quot;r_p4&quot;)],[&quot;環境&quot;, v(&quot;r_p5&quot;)],[&quot;原因（仮説）&quot;, v(&quot;r_p6&quot;)],[&quot;影響範囲&quot;, v(&quot;r_p7&quot;)]
  ].filter(function(p){return p[1];});
  if(probs.length){ probs.forEach(function(p,i){ o.push((i+1)+&quot;．&quot;+p[0]+&quot;：&quot;+p[1]); }); }
  else { o.push(&quot;特になし&quot;); }
  o.push(&quot;&quot;);

  o.push(&quot;⑤ 対応・アクション&quot;);
  o.push(&quot;明日の対応予定：&quot;+v(&quot;r_action&quot;));
  o.push(&quot;&quot;);

  o.push(&quot;⑥ 学び・気づき&quot;);
  o.push(&quot;今日の学び：&quot;+v(&quot;r_learn&quot;));
  o.push(&quot;次に活かすこと：&quot;+v(&quot;r_next&quot;));
  o.push(&quot;&quot;);

  o.push(&quot;⑦ 共有事項（上長・関係者向け）&quot;);
  o.push(&quot;報告事項：&quot;+v(&quot;r_share&quot;));
  o.push(&quot;相談事項：&quot;+v(&quot;r_consult&quot;));
  o.push(&quot;支援依頼：&quot;+v(&quot;r_help&quot;));
  o.push(&quot;&quot;);

  o.push(&quot;⑧ 明日の予定&quot;);
  o.push(&quot;タスク：&quot;+v(&quot;r_tmtask&quot;));
  o.push(&quot;想定時間：&quot;+v(&quot;r_tmtime&quot;));
  o.push(&quot;優先順位：&quot;+v(&quot;r_tmprio&quot;));

  /* ===== Markdown版（記号は使うが内容は同一） ===== */
  var m=[];
  m.push(&quot;# 業務日報&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;## ① 基本情報&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;- 日付：&quot;+v(&quot;r_date&quot;));
  m.push(&quot;- 氏名：&quot;+v(&quot;r_name&quot;));
  m.push(&quot;- 場所：&quot;+v(&quot;r_place&quot;));
  m.push(&quot;- 勤務時間：&quot;+wt+(wh?(&quot;（&quot;+wh+&quot;）&quot;):&quot;&quot;));
  m.push(&quot;&quot;);
  m.push(&quot;## ② 本日の業務内容&quot;);
  m.push(&quot;&quot;);
  if(tasks.length){
    tasks.forEach(function(t,i){ m.push((i+1)+&quot;. &quot;+t.name+&quot;：&quot;+t.status); });
    var purM=tasks.filter(function(t){return t.purpose;});
    if(purM.length){
      m.push(&quot;&quot;); m.push(&quot;### 各タスクの目的&quot;);
      tasks.forEach(function(t,i){ if(t.purpose) m.push((i+1)+&quot;. &quot;+t.purpose); });
    }
    var timM=tasks.filter(function(t){return t.time;});
    if(timM.length){
      m.push(&quot;&quot;); m.push(&quot;### 所要時間&quot;);
      tasks.forEach(function(t,i){ if(t.time) m.push((i+1)+&quot;. &quot;+t.time); });
    }
  }
  // 時間割の連携（ON時）
  if(typeof isTtLink===&quot;function&quot; &amp;&amp; isTtLink()){
    var ttrM=ttLinkRows();
    if(ttrM.length){
      m.push(&quot;&quot;); m.push(&quot;### 時間割より&quot;);
      ttrM.forEach(function(r){
        var t=(r.s&amp;&amp;r.e)?(r.s+&quot;-&quot;+r.e+&quot; &quot;):&quot;&quot;;
        m.push(&quot;- &quot;+t+r.text+&quot;（&quot;+r.kindLabel+(r.dur?(&quot; &quot;+r.dur+&quot;分&quot;):&quot;&quot;)+(r.planned?&quot;・予定&quot;:&quot;&quot;)+&quot;）&quot;+(r.status&amp;&amp;r.status!==&quot;—&quot;?(&quot; &quot;+r.status):&quot;&quot;));
      });
      var sumM=(typeof recalcTT===&quot;function&quot;)?recalcTT():null;
      if(sumM){ m.push(&quot;&quot;); m.push(&quot;予定 &quot;+fmtHM(sumM.planMin)+&quot; ／ 実績相当 &quot;+fmtHM(sumM.actMin)+&quot; ／ 達成率 &quot;+sumM.rate+&quot;%&quot;); }
    }
  }
  m.push(&quot;&quot;);
  m.push(&quot;## ③ 成果・進捗&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;- 今日の成果物：&quot;+v(&quot;r_deliver&quot;));
  m.push(&quot;- 進捗率：&quot;+v(&quot;r_rate&quot;));
  m.push(&quot;- KPIに対する進捗：&quot;+v(&quot;r_kpi&quot;));
  m.push(&quot;&quot;);
  m.push(&quot;## ④ 課題・問題点&quot;);
  m.push(&quot;&quot;);
  if(probs.length){ probs.forEach(function(p,i){ m.push((i+1)+&quot;. **&quot;+p[0]+&quot;**：&quot;+p[1]); }); }
  else { m.push(&quot;特になし&quot;); }
  m.push(&quot;&quot;);
  m.push(&quot;## ⑤ 対応・アクション&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;- 明日の対応予定：&quot;+v(&quot;r_action&quot;));
  m.push(&quot;&quot;);
  m.push(&quot;## ⑥ 学び・気づき&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;- 今日の学び：&quot;+v(&quot;r_learn&quot;));
  m.push(&quot;- 次に活かすこと：&quot;+v(&quot;r_next&quot;));
  m.push(&quot;&quot;);
  m.push(&quot;## ⑦ 共有事項（上長・関係者向け）&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;- 報告事項：&quot;+v(&quot;r_share&quot;));
  m.push(&quot;- 相談事項：&quot;+v(&quot;r_consult&quot;));
  m.push(&quot;- 支援依頼：&quot;+v(&quot;r_help&quot;));
  m.push(&quot;&quot;);
  m.push(&quot;## ⑧ 明日の予定&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;- タスク：&quot;+v(&quot;r_tmtask&quot;));
  m.push(&quot;- 想定時間：&quot;+v(&quot;r_tmtime&quot;));
  m.push(&quot;- 優先順位：&quot;+v(&quot;r_tmprio&quot;));

  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- TAB2 build: メモ版 ---- */
function memoSection(title, pairs){
  // pairs: [labelOrNull, lines[]] ; lines already prefixed
  var has=pairs.some(function(p){return p[1] &amp;&amp; p[1].length;});
  if(!has) return &quot;&quot;;
  var s=[BAR, title, BAR];
  pairs.forEach(function(p){
    if(!(p[1] &amp;&amp; p[1].length)) return;
    if(p[0]) s.push(&quot;▼ &quot;+p[0]);
    s.push(p[1].join(&quot;\n&quot;));
    s.push(&quot;&quot;);
  });
  return s.join(&quot;\n&quot;).replace(/\n+$/,&quot;&quot;)+&quot;\n&quot;;
}
function chk(id){ return linesOf(id).map(function(s){return &quot;[ ] &quot;+s;}); }
function dot(id){ return linesOf(id).map(function(s){return &quot;・&quot;+s;}); }
// Markdown用：チェックリスト項目 / 箇条書き項目
function chkMd(id){ return linesOf(id).map(function(s){return &quot;- [ ] &quot;+s;}); }
function dotMd(id){ return linesOf(id).map(function(s){return &quot;- &quot;+s;}); }

// Markdown版セクション：見出し＋小見出し＋本文
function memoSectionMd(title, pairs){
  var has=pairs.some(function(p){return p[1] &amp;&amp; p[1].length;});
  if(!has) return &quot;&quot;;
  var s=[&quot;## &quot;+title, &quot;&quot;];
  pairs.forEach(function(p){
    if(!(p[1] &amp;&amp; p[1].length)) return;
    if(p[0]) s.push(&quot;### &quot;+p[0]);
    s.push(p[1].join(&quot;\n&quot;));
    s.push(&quot;&quot;);
  });
  return s.join(&quot;\n&quot;).replace(/\n+$/,&quot;&quot;)+&quot;\n&quot;;
}

function buildMemo(){
  currentTab=&quot;memo&quot;;
  var ttOn=document.getElementById(&quot;m_tt_on&quot;).checked;
  var wkOn=document.getElementById(&quot;m_wk_on&quot;).checked;
  var moOn=document.getElementById(&quot;m_mo_on&quot;).checked;

  /* ===== プレーンテキスト版（罫線レイアウト） ===== */
  var o=[];
  o.push(BAR); o.push(&quot;📝 日報・進捗・チェックリスト&quot;); o.push(BAR);
  o.push(&quot;日付  : &quot;+v(&quot;m_date&quot;));
  o.push(&quot;役割  : &quot;+v(&quot;m_role&quot;));
  o.push(&quot;気分  : &quot;+v(&quot;m_mood&quot;));
  o.push(&quot;一言  : 「&quot;+v(&quot;m_word&quot;)+&quot;」&quot;);
  o.push(&quot;&quot;);

  if(ttOn){
    o.push(BAR2); o.push(&quot;🕘 タイムテーブル&quot;); o.push(BAR2);
    var tt=linesOf(&quot;m_tt&quot;);
    if(tt.length){ o.push(tt.join(&quot;\n&quot;)); }
    else {
      o.push(&quot;09:00-10:00 │&quot;);o.push(&quot;10:00-11:00 │&quot;);o.push(&quot;11:00-12:00 │&quot;);
      o.push(&quot;12:00-13:00 │ 🍱 昼休憩&quot;);o.push(&quot;13:00-14:00 │&quot;);o.push(&quot;14:00-15:00 │&quot;);
      o.push(&quot;15:00-15:10 │ ☕ 10分：社内記事ドラフト1段落&quot;);o.push(&quot;15:10-16:00 │&quot;);
      o.push(&quot;16:00-17:00 │&quot;);o.push(&quot;17:00-18:00 │&quot;);o.push(&quot;18:00       │ 🏁 定時退社チェック&quot;);
    }
    o.push(&quot;&quot;);
  }

  var todo=memoSection(&quot;✅ 今日すること&quot;, [
    [&quot;メイン業務&quot;, chk(&quot;m_today_main&quot;)],
    [&quot;メイン業務以外（学習・整備・社内貢献）&quot;, chk(&quot;m_today_sub&quot;)],
    [&quot;趣味枠（個人開発・記事・インプット）&quot;, chk(&quot;m_today_hobby&quot;)],
    [&quot;今日 口頭・チャットで相談すること&quot;, chk(&quot;m_today_talk&quot;)]
  ]);
  if(todo) o.push(todo);

  var prog=[BAR2,&quot;📊 作業進捗&quot;,BAR2];
  var done=dot(&quot;m_done&quot;), wip=dot(&quot;m_wip&quot;);
  var hasProg=false;
  if(done.length){ prog.push(&quot;▼ ✓ 完了したこと&quot;); prog.push(done.join(&quot;\n&quot;)); prog.push(&quot;&quot;); hasProg=true; }
  if(wip.length){ prog.push(&quot;▼ → 着手中・持ち越し&quot;); prog.push(wip.join(&quot;\n&quot;)); prog.push(&quot;&quot;); hasProg=true; }
  if(v(&quot;m_bl_what&quot;)){
    hasProg=true;
    prog.push(&quot;▼ ⚠ ブロッカー / 詰まり&quot;);
    prog.push(&quot;・内容：&quot;+v(&quot;m_bl_what&quot;));
    prog.push(&quot;影響：&quot;+v(&quot;m_bl_eff&quot;));
    prog.push(&quot;必要なアクション：&quot;+v(&quot;m_bl_act&quot;));
    prog.push(&quot;相手：&quot;+v(&quot;m_bl_who&quot;));
    prog.push(&quot;&quot;);
  }
  if(hasProg) o.push(prog.join(&quot;\n&quot;).replace(/\n+$/,&quot;&quot;)+&quot;\n&quot;);

  var req=memoSection(&quot;🚩 依頼・相談 一覧&quot;, [
    [&quot;📨 サポート依頼（手を貸してほしい）&quot;, chk(&quot;m_req_sup&quot;)],
    [&quot;🔍 レビュー依頼（成果物を見てほしい）&quot;, chk(&quot;m_req_rev&quot;)],
    [&quot;👥 他の人と相談が必要&quot;, chk(&quot;m_req_talk&quot;)],
    [&quot;💭 その他・気になっていること&quot;, dot(&quot;m_req_etc&quot;)]
  ]);
  if(req) o.push(req);

  var tmr=memoSection(&quot;📅 明日すること&quot;, [
    [&quot;メイン業務&quot;, chk(&quot;m_tm_main&quot;)],
    [&quot;メイン業務以外&quot;, chk(&quot;m_tm_sub&quot;)],
    [&quot;趣味枠&quot;, chk(&quot;m_tm_hobby&quot;)],
    [&quot;明日 口頭・チャットで相談すること&quot;, chk(&quot;m_tm_talk&quot;)]
  ]);
  if(tmr) o.push(tmr);

  if(wkOn){
    var wk=memoSection(&quot;🗓 今週すること（残り）&quot;, [
      [&quot;メイン業務&quot;, chk(&quot;m_wk_main&quot;)],[&quot;メイン業務以外・趣味&quot;, chk(&quot;m_wk_sub&quot;)]
    ]);
    if(wk) o.push(wk);
    var nw=memoSection(&quot;🗓 来週すること&quot;, [
      [&quot;メイン業務&quot;, chk(&quot;m_nw_main&quot;)],[&quot;メイン業務以外・趣味&quot;, chk(&quot;m_nw_sub&quot;)]
    ]);
    if(nw) o.push(nw);
  }
  if(moOn){
    var mo=memoSection(&quot;📆 今月すること&quot;, [
      [&quot;メイン業務（月次目標）&quot;, chk(&quot;m_mo_main&quot;)],[&quot;メイン業務以外・趣味&quot;, chk(&quot;m_mo_sub&quot;)]
    ]);
    if(mo) o.push(mo);
    var nm=memoSection(&quot;📆 来月すること&quot;, [[&quot;メイン業務&quot;, chk(&quot;m_nm_main&quot;)]]);
    if(nm) o.push(nm);
  }

  var habitsAll=[].slice.call(document.querySelectorAll(&quot;#m_habits input&quot;)).map(function(c){return (c.checked?&quot;[x] &quot;:&quot;[ ] &quot;)+c.value;});
  o.push(BAR); o.push(&quot;🩺 デイリー習慣（毎日チェック）&quot;); o.push(BAR);
  o.push(habitsAll.join(&quot;\n&quot;)); o.push(&quot;&quot;);

  var selfAll=[].slice.call(document.querySelectorAll(&quot;#m_self input&quot;)).map(function(c){return (c.checked?&quot;[x] &quot;:&quot;[ ] &quot;)+c.value;});
  o.push(BAR); o.push(&quot;🧠 退社前 1分セルフチェック&quot;); o.push(BAR);
  o.push(selfAll.join(&quot;\n&quot;));

  var txt=o.join(&quot;\n&quot;);

  /* ===== Markdown版（見出し・チェックボックス） ===== */
  var m=[];
  m.push(&quot;# 📝 日報・進捗・チェックリスト&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;| 項目 | 内容 |&quot;);
  m.push(&quot;|---|---|&quot;);
  m.push(&quot;| 日付 | &quot;+v(&quot;m_date&quot;)+&quot; |&quot;);
  m.push(&quot;| 役割 | &quot;+v(&quot;m_role&quot;)+&quot; |&quot;);
  m.push(&quot;| 気分 | &quot;+v(&quot;m_mood&quot;)+&quot; |&quot;);
  m.push(&quot;| 一言 | 「&quot;+v(&quot;m_word&quot;)+&quot;」 |&quot;);
  m.push(&quot;&quot;);

  if(ttOn){
    m.push(&quot;## 🕘 タイムテーブル&quot;); m.push(&quot;&quot;);
    var ttm=linesOf(&quot;m_tt&quot;);
    m.push(&quot;```&quot;);
    if(ttm.length){ m.push(ttm.join(&quot;\n&quot;)); }
    else {
      m.push(&quot;09:00-10:00 │&quot;);m.push(&quot;10:00-11:00 │&quot;);m.push(&quot;11:00-12:00 │&quot;);
      m.push(&quot;12:00-13:00 │ 🍱 昼休憩&quot;);m.push(&quot;13:00-14:00 │&quot;);m.push(&quot;14:00-15:00 │&quot;);
      m.push(&quot;15:00-15:10 │ ☕ 10分：社内記事ドラフト1段落&quot;);m.push(&quot;15:10-16:00 │&quot;);
      m.push(&quot;16:00-17:00 │&quot;);m.push(&quot;17:00-18:00 │&quot;);m.push(&quot;18:00       │ 🏁 定時退社チェック&quot;);
    }
    m.push(&quot;```&quot;); m.push(&quot;&quot;);
  }

  var todoM=memoSectionMd(&quot;✅ 今日すること&quot;, [
    [&quot;メイン業務&quot;, chkMd(&quot;m_today_main&quot;)],
    [&quot;メイン業務以外（学習・整備・社内貢献）&quot;, chkMd(&quot;m_today_sub&quot;)],
    [&quot;趣味枠（個人開発・記事・インプット）&quot;, chkMd(&quot;m_today_hobby&quot;)],
    [&quot;今日 口頭・チャットで相談すること&quot;, chkMd(&quot;m_today_talk&quot;)]
  ]);
  if(todoM) m.push(todoM);

  var doneM=dotMd(&quot;m_done&quot;), wipM=dotMd(&quot;m_wip&quot;);
  var progM=[&quot;## 📊 作業進捗&quot;,&quot;&quot;], hasProgM=false;
  if(doneM.length){ progM.push(&quot;### ✓ 完了したこと&quot;); progM.push(doneM.join(&quot;\n&quot;)); progM.push(&quot;&quot;); hasProgM=true; }
  if(wipM.length){ progM.push(&quot;### → 着手中・持ち越し&quot;); progM.push(wipM.join(&quot;\n&quot;)); progM.push(&quot;&quot;); hasProgM=true; }
  if(v(&quot;m_bl_what&quot;)){
    hasProgM=true;
    progM.push(&quot;### ⚠ ブロッカー / 詰まり&quot;);
    progM.push(&quot;- **内容**：&quot;+v(&quot;m_bl_what&quot;));
    progM.push(&quot;- **影響**：&quot;+v(&quot;m_bl_eff&quot;));
    progM.push(&quot;- **必要なアクション**：&quot;+v(&quot;m_bl_act&quot;));
    progM.push(&quot;- **相手**：&quot;+v(&quot;m_bl_who&quot;));
    progM.push(&quot;&quot;);
  }
  if(hasProgM) m.push(progM.join(&quot;\n&quot;).replace(/\n+$/,&quot;&quot;)+&quot;\n&quot;);

  var reqM=memoSectionMd(&quot;🚩 依頼・相談 一覧&quot;, [
    [&quot;📨 サポート依頼（手を貸してほしい）&quot;, chkMd(&quot;m_req_sup&quot;)],
    [&quot;🔍 レビュー依頼（成果物を見てほしい）&quot;, chkMd(&quot;m_req_rev&quot;)],
    [&quot;👥 他の人と相談が必要&quot;, chkMd(&quot;m_req_talk&quot;)],
    [&quot;💭 その他・気になっていること&quot;, dotMd(&quot;m_req_etc&quot;)]
  ]);
  if(reqM) m.push(reqM);

  var tmrM=memoSectionMd(&quot;📅 明日すること&quot;, [
    [&quot;メイン業務&quot;, chkMd(&quot;m_tm_main&quot;)],
    [&quot;メイン業務以外&quot;, chkMd(&quot;m_tm_sub&quot;)],
    [&quot;趣味枠&quot;, chkMd(&quot;m_tm_hobby&quot;)],
    [&quot;明日 口頭・チャットで相談すること&quot;, chkMd(&quot;m_tm_talk&quot;)]
  ]);
  if(tmrM) m.push(tmrM);

  if(wkOn){
    var wkM=memoSectionMd(&quot;🗓 今週すること（残り）&quot;, [
      [&quot;メイン業務&quot;, chkMd(&quot;m_wk_main&quot;)],[&quot;メイン業務以外・趣味&quot;, chkMd(&quot;m_wk_sub&quot;)]
    ]);
    if(wkM) m.push(wkM);
    var nwM=memoSectionMd(&quot;🗓 来週すること&quot;, [
      [&quot;メイン業務&quot;, chkMd(&quot;m_nw_main&quot;)],[&quot;メイン業務以外・趣味&quot;, chkMd(&quot;m_nw_sub&quot;)]
    ]);
    if(nwM) m.push(nwM);
  }
  if(moOn){
    var moM=memoSectionMd(&quot;📆 今月すること&quot;, [
      [&quot;メイン業務（月次目標）&quot;, chkMd(&quot;m_mo_main&quot;)],[&quot;メイン業務以外・趣味&quot;, chkMd(&quot;m_mo_sub&quot;)]
    ]);
    if(moM) m.push(moM);
    var nmM=memoSectionMd(&quot;📆 来月すること&quot;, [[&quot;メイン業務&quot;, chkMd(&quot;m_nm_main&quot;)]]);
    if(nmM) m.push(nmM);
  }

  var habitsMd=[].slice.call(document.querySelectorAll(&quot;#m_habits input&quot;)).map(function(c){return (c.checked?&quot;- [x] &quot;:&quot;- [ ] &quot;)+c.value;});
  m.push(&quot;## 🩺 デイリー習慣（毎日チェック）&quot;); m.push(&quot;&quot;);
  m.push(habitsMd.join(&quot;\n&quot;)); m.push(&quot;&quot;);

  var selfMd=[].slice.call(document.querySelectorAll(&quot;#m_self input&quot;)).map(function(c){return (c.checked?&quot;- [x] &quot;:&quot;- [ ] &quot;)+c.value;});
  m.push(&quot;## 🧠 退社前 1分セルフチェック&quot;); m.push(&quot;&quot;);
  m.push(selfMd.join(&quot;\n&quot;));

  var md=m.join(&quot;\n&quot;);

  setOut(txt, md);
}

/* ---- TAB3 build: 相談チャット ---- */
function switchTpl(){
  var t=document.getElementById(&quot;c_tpl&quot;).value;
  document.querySelectorAll(&quot;.tpl&quot;).forEach(function(d){
    d.style.display = (d.dataset.tpl===t) ? &quot;block&quot; : &quot;none&quot;;
  });
}

/* 進捗報告（I）：タスク行 */
function ciAddTask(data){
  data=data||{name:&quot;&quot;,status:&quot;ontrack&quot;,pct:&quot;&quot;,note:&quot;&quot;};
  var wrap=document.getElementById(&quot;cI_taskList&quot;);
  var row=document.createElement(&quot;div&quot;); row.className=&quot;ci-row&quot;;
  var name=document.createElement(&quot;input&quot;); name.className=&quot;ci-name&quot;; name.placeholder=&quot;タスク名&quot;; name.value=data.name;
  var st=document.createElement(&quot;select&quot;); st.className=&quot;ci-status&quot;;
  // value属性を固定（英訳してもvalueは不変→ロジックが壊れない）
  [[&quot;🟢 順調&quot;,&quot;ontrack&quot;],[&quot;🟡 やや遅延&quot;,&quot;behind&quot;],[&quot;🔴 要対応&quot;,&quot;attention&quot;],[&quot;✅ 完了&quot;,&quot;done&quot;],[&quot;⏸ 未着手&quot;,&quot;todo&quot;]].forEach(function(s){var o=document.createElement(&quot;option&quot;);o.textContent=s[0];o.value=s[1];st.appendChild(o);});
  st.value=data.status;
  var pct=document.createElement(&quot;input&quot;); pct.className=&quot;ci-pct&quot;; pct.placeholder=&quot;%&quot;; pct.inputMode=&quot;numeric&quot;; pct.value=data.pct;
  var note=document.createElement(&quot;input&quot;); note.className=&quot;ci-note&quot;; note.placeholder=&quot;補足（任意）&quot;; note.value=data.note;
  var del=document.createElement(&quot;button&quot;); del.type=&quot;button&quot;; del.className=&quot;del&quot;; del.textContent=&quot;×&quot;;
  del.onclick=function(){ row.remove(); };
  // 完了を選んだら%を100に補完
  st.addEventListener(&quot;change&quot;, function(){ if(st.value===&quot;done&quot; &amp;&amp; !pct.value) pct.value=&quot;100&quot;; if(st.value===&quot;todo&quot; &amp;&amp; !pct.value) pct.value=&quot;0&quot;; });
  row.appendChild(name); row.appendChild(st); row.appendChild(pct); row.appendChild(note); row.appendChild(del);
  wrap.appendChild(row);
  i18nRefresh();
}
function ciReadTasks(){
  return [].slice.call(document.querySelectorAll(&quot;#cI_taskList .ci-row&quot;)).map(function(r){
    var sel=r.querySelector(&quot;.ci-status&quot;);
    var label=sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].textContent : sel.value;
    return {
      name:r.querySelector(&quot;.ci-name&quot;).value.trim(),
      status:label,            // 表示用（🟢 順調 / 🟢 On track）
      statusKey:sel.value,     // 判定用（ontrack/done/todo…）
      pct:r.querySelector(&quot;.ci-pct&quot;).value.trim(),
      note:r.querySelector(&quot;.ci-note&quot;).value.trim()
    };
  }).filter(function(t){return t.name;});
}
// 進捗報告の本文を長さ別に組み立て
function buildProgress(){
  var len=v(&quot;cI_len&quot;)||&quot;prep&quot;;
  var topic=v(&quot;cI_topic&quot;)||&quot;（案件名）&quot;;
  var status=v(&quot;cI_status&quot;);
  var tasks=ciReadTasks();
  // 全体％：未入力ならタスク％の平均で補完
  var pct=v(&quot;cI_pct&quot;);
  if(!pct &amp;&amp; tasks.length){
    var nums=tasks.map(function(t){return parseInt(t.pct,10);}).filter(function(n){return !isNaN(n);});
    if(nums.length){ pct=String(Math.round(nums.reduce(function(a,b){return a+b;},0)/nums.length)); }
  }
  var pctTxt = pct? (pct+&quot;%&quot;) : &quot;&quot;;
  var due=v(&quot;cI_due&quot;);
  var nexts=lines(v(&quot;cI_next&quot;));
  var risk=v(&quot;cI_risk&quot;);
  var head = topic + &quot;：&quot; + status + (pctTxt?(&quot; &quot;+pctTxt):&quot;&quot;) + (due?(&quot;（期限 &quot;+due+&quot;）&quot;):&quot;&quot;);

  var o=[];
  if(len===&quot;1&quot;){
    // 1分：1行結論＋次アクション1つ
    o.push(&quot;【進捗1分】&quot;+head);
    if(nexts.length) o.push(&quot;次：&quot;+nexts[0]);
    if(risk) o.push(&quot;⚠ &quot;+risk);
  } else if(len===&quot;3&quot;){
    // 3分：結論＋主要タスク数件＋次アクション
    o.push(&quot;【進捗3分】&quot;+head); o.push(&quot;&quot;);
    if(tasks.length){
      o.push(&quot;■タスク&quot;);
      tasks.forEach(function(t){ o.push(&quot;・&quot;+t.status+&quot; &quot;+t.name+(t.pct?(&quot; &quot;+t.pct+&quot;%&quot;):&quot;&quot;)+(t.note?(&quot;（&quot;+t.note+&quot;）&quot;):&quot;&quot;)); });
      o.push(&quot;&quot;);
    }
    if(nexts.length){ o.push(&quot;■次のアクション&quot;); nexts.forEach(function(x){o.push(&quot;・&quot;+x);}); o.push(&quot;&quot;); }
    if(risk){ o.push(&quot;■リスク・相談&quot;); o.push(&quot;・&quot;+risk); }
  } else if(len===&quot;5&quot;){
    // 5分：見出し付きでフル
    o.push(&quot;【進捗報告】&quot;+topic); o.push(&quot;&quot;);
    o.push(&quot;■全体ステータス：&quot;+status+(pctTxt?(&quot; / &quot;+pctTxt):&quot;&quot;)+(due?(&quot; / 期限 &quot;+due):&quot;&quot;)); o.push(&quot;&quot;);
    if(tasks.length){
      o.push(&quot;■タスク別の状況&quot;);
      tasks.forEach(function(t){ o.push(&quot;・&quot;+t.status+&quot; &quot;+t.name+(t.pct?(&quot; &quot;+t.pct+&quot;%&quot;):&quot;&quot;)+(t.note?(&quot;：&quot; +t.note):&quot;&quot;)); });
      o.push(&quot;&quot;);
    }
    if(nexts.length){ o.push(&quot;■次のアクション&quot;); nexts.forEach(function(x){o.push(&quot;・&quot;+x);}); o.push(&quot;&quot;); }
    if(risk){ o.push(&quot;■リスク・困りごと&quot;); o.push(&quot;・&quot;+risk); o.push(&quot;&quot;); }
    o.push(&quot;以上、ご確認よろしくお願いします。&quot;);
  } else {
    // PREP：結論→理由→具体例→結論
    o.push(&quot;【進捗報告（PREP）】&quot;+topic); o.push(&quot;&quot;);
    o.push(&quot;◆結論（Point）&quot;);
    o.push(status+(pctTxt?(&quot;、現在 &quot;+pctTxt):&quot;&quot;)+&quot;です。&quot;+(due?(&quot;期限は &quot;+due+&quot;。&quot;):&quot;&quot;)); o.push(&quot;&quot;);
    o.push(&quot;◆理由（Reason）&quot;);
    if(risk){ o.push(risk); } else { o.push(&quot;予定どおりタスクを消化できているためです。&quot;); } o.push(&quot;&quot;);
    o.push(&quot;◆具体例（Example）&quot;);
    if(tasks.length){ tasks.forEach(function(t){ o.push(&quot;・&quot;+t.status+&quot; &quot;+t.name+(t.pct?(&quot; &quot;+t.pct+&quot;%&quot;):&quot;&quot;)+(t.note?(&quot;（&quot;+t.note+&quot;）&quot;):&quot;&quot;)); }); }
    else { o.push(&quot;（タスク未入力）&quot;); } o.push(&quot;&quot;);
    o.push(&quot;◆まとめ（Point）&quot;);
    o.push(&quot;引き続き&quot;+(nexts.length?(&quot;「&quot;+nexts[0]+&quot;」&quot;):&quot;次のアクション&quot;)+&quot;を進めます。&quot;+(nexts.length>1?(&quot;ほか：&quot;+nexts.slice(1).join(&quot;、&quot;)):&quot;&quot;));
  }
  var txt=o.join(&quot;\n&quot;);

  // Markdown版
  var m=[];
  var title = (len===&quot;prep&quot;) ? &quot;進捗報告（PREP）&quot; : (len===&quot;1&quot;?&quot;進捗（1分）&quot;:(len===&quot;3&quot;?&quot;進捗（3分）&quot;:(len===&quot;5&quot;?&quot;進捗報告（5分）&quot;:&quot;進捗報告&quot;)));
  m.push(&quot;### &quot;+title+&quot;：&quot;+topic);
  m.push(&quot;&quot;);
  m.push(&quot;- **ステータス**：&quot;+status+(pctTxt?(&quot; / &quot;+pctTxt):&quot;&quot;)+(due?(&quot; / 期限 &quot;+due):&quot;&quot;));
  if(tasks.length){
    m.push(&quot;&quot;);
    m.push(&quot;| タスク | 状態 | 進捗 | 補足 |&quot;);
    m.push(&quot;|---|---|---:|---|&quot;);
    tasks.forEach(function(t){ m.push(&quot;| &quot;+t.name+&quot; | &quot;+t.status+&quot; | &quot;+(t.pct?t.pct+&quot;%&quot;:&quot;&quot;)+&quot; | &quot;+(t.note||&quot;&quot;)+&quot; |&quot;); });
  }
  if(nexts.length){ m.push(&quot;&quot;); m.push(&quot;**次のアクション**&quot;); nexts.forEach(function(x){m.push(&quot;- &quot;+x);}); }
  if(risk){ m.push(&quot;&quot;); m.push(&quot;**リスク・相談**：&quot; + risk); }
  var md=m.join(&quot;\n&quot;);

  return {txt:txt, md:md};
}

function buildChat(){
  currentTab=&quot;chat&quot;;
  var t=document.getElementById(&quot;c_tpl&quot;).value, o=[];
  if(t===&quot;A&quot;){
    o.push(&quot;お疲れ様です。&quot;);
    o.push(&quot;ご相談です（5分ほどお時間いただけますか／チャットでも結構です）。&quot;);
    o.push(&quot;&quot;);
    o.push(&quot;▼ 状況&quot;); o.push(&quot;・&quot;+v(&quot;cA_sit&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ 検討した選択肢&quot;); o.push(&quot;・A：&quot;+v(&quot;cA_a&quot;)); o.push(&quot;・B：&quot;+v(&quot;cA_b&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ 私の推し案&quot;); o.push(&quot;・&quot;+v(&quot;cA_push&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ ほしい判断&quot;); o.push(&quot;・&quot;+v(&quot;cA_want&quot;));
  } else if(t===&quot;B&quot;){
    o.push(&quot;お疲れ様です、&quot;+v(&quot;cB_name&quot;)+&quot;です。&quot;);
    o.push(v(&quot;cB_topic&quot;)+&quot;について教えてください。&quot;);
    o.push(&quot;&quot;);
    o.push(&quot;▼ 何が分からないか&quot;); o.push(&quot;・&quot;+v(&quot;cB_q&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ 自分で確認したこと&quot;); o.push(&quot;・&quot;+v(&quot;cB_done&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ いつまでに方針が欲しいか&quot;); o.push(&quot;・&quot;+v(&quot;cB_due&quot;)+&quot;（業務影響：&quot;+v(&quot;cB_eff&quot;)+&quot;）&quot;);
  } else if(t===&quot;C&quot;){
    o.push(&quot;レビューお願いします🙏&quot;); o.push(&quot;&quot;);
    o.push(&quot;▼ 対象&quot;); o.push(&quot;・URL：&quot;+v(&quot;cC_url&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ 見てほしい観点&quot;); o.push(&quot;・1）&quot;+v(&quot;cC_p1&quot;)); o.push(&quot;・2）&quot;+v(&quot;cC_p2&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ 期限&quot;); o.push(&quot;・&quot;+v(&quot;cC_due&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ 補足&quot;); o.push(&quot;・&quot;+v(&quot;cC_note&quot;));
  } else if(t===&quot;D&quot;){
    o.push(&quot;【至急共有】&quot;+(v(&quot;cD_fact&quot;)?&quot;&quot;:&quot;&quot;)+&quot;事象が発生しました。&quot;); o.push(&quot;&quot;);
    o.push(&quot;▼ 事実&quot;); o.push(&quot;・&quot;+v(&quot;cD_fact&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ 影響範囲&quot;); o.push(&quot;・&quot;+v(&quot;cD_eff&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ 現在の対応&quot;); o.push(&quot;・&quot;+v(&quot;cD_act&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ 判断ほしい点&quot;); o.push(&quot;・&quot;+v(&quot;cD_want&quot;));
  } else if(t===&quot;E&quot;){
    o.push(&quot;連絡共有です（返信不要）。&quot;); o.push(&quot;&quot;);
    o.push(&quot;・&quot;+v(&quot;cE_what&quot;));
    o.push(&quot;・関連URL：&quot;+v(&quot;cE_url&quot;));
    o.push(&quot;・影響：&quot;+v(&quot;cE_eff&quot;));
  } else if(t===&quot;F&quot;){
    o.push(&quot;お疲れ様です。&quot;);
    o.push(&quot;下記の件で △△さん・□□さん にも入っていただけませんか。&quot;); o.push(&quot;&quot;);
    o.push(&quot;▼ 議題&quot;); o.push(&quot;・&quot;+v(&quot;cF_topic&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ なぜその二人が必要か&quot;); o.push(&quot;・△△さん：&quot;+v(&quot;cF_p1&quot;)); o.push(&quot;・□□さん：&quot;+v(&quot;cF_p2&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ 形式&quot;); o.push(&quot;・&quot;+v(&quot;cF_form&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ いつ頃&quot;); o.push(&quot;・&quot;+v(&quot;cF_when&quot;));
  } else if(t===&quot;G&quot;){
    o.push(&quot;*【日報】&quot;+v(&quot;cG_date&quot;)+&quot;*&quot;);
    o.push(&quot;昨日：&quot;+v(&quot;cG_y&quot;));
    o.push(&quot;今日：&quot;+v(&quot;cG_t&quot;));
    o.push(&quot;ブロッカー：&quot;+(v(&quot;cG_block&quot;)||&quot;なし&quot;));
    o.push(&quot;相談：&quot;+v(&quot;cG_consult&quot;));
  } else if(t===&quot;H&quot;){
    o.push(&quot;本日はお時間いただきありがとうございました。&quot;); o.push(&quot;&quot;);
    o.push(&quot;▼ 本日の合意事項&quot;);
    var ag=linesOf(&quot;cH_agree&quot;); (ag.length?ag:[&quot;&quot;]).forEach(function(s){o.push(&quot;・&quot;+s);}); o.push(&quot;&quot;);
    o.push(&quot;▼ 次回までのアクション&quot;); o.push(&quot;・弊社：&quot;+v(&quot;cH_us&quot;)); o.push(&quot;・貴社：&quot;+v(&quot;cH_you&quot;)); o.push(&quot;&quot;);
    o.push(&quot;▼ 次回予定&quot;); o.push(&quot;・&quot;+v(&quot;cH_next&quot;)+(v(&quot;cH_cand&quot;)?(&quot;（候補：&quot;+v(&quot;cH_cand&quot;)+&quot;）&quot;):&quot;&quot;)); o.push(&quot;&quot;);
    o.push(&quot;引き続きどうぞよろしくお願いいたします。&quot;);
  } else if(t===&quot;I&quot;){
    var pr=buildProgress();
    setOut(pr.txt, pr.md);
    return;
  }
  setOut(o.join(&quot;\n&quot;));
}

/* ---- TAB4: 時間割（HR学校風） ---- */
// 既定の学校風時間割（08:00〜18:00）。kind: lesson(授業)/meeting(会議)/work(作業)/break(休憩)
var TT_DEFAULT = [
  {label:&quot;朝のHR&quot;, s:&quot;08:00&quot;, e:&quot;08:30&quot;, kind:&quot;meeting&quot;},
  {label:&quot;1限&quot;,   s:&quot;08:30&quot;, e:&quot;09:20&quot;, kind:&quot;lesson&quot;},
  {label:&quot;2限&quot;,   s:&quot;09:30&quot;, e:&quot;10:20&quot;, kind:&quot;lesson&quot;},
  {label:&quot;3限&quot;,   s:&quot;10:30&quot;, e:&quot;11:20&quot;, kind:&quot;lesson&quot;},
  {label:&quot;4限&quot;,   s:&quot;11:30&quot;, e:&quot;12:20&quot;, kind:&quot;lesson&quot;},
  {label:&quot;昼休み&quot;, s:&quot;12:20&quot;, e:&quot;13:10&quot;, kind:&quot;break&quot;},
  {label:&quot;5限&quot;,   s:&quot;13:10&quot;, e:&quot;14:00&quot;, kind:&quot;lesson&quot;},
  {label:&quot;6限&quot;,   s:&quot;14:10&quot;, e:&quot;15:00&quot;, kind:&quot;work&quot;},
  {label:&quot;小休止&quot;, s:&quot;15:00&quot;, e:&quot;15:10&quot;, kind:&quot;break&quot;},
  {label:&quot;7限&quot;,   s:&quot;15:10&quot;, e:&quot;16:00&quot;, kind:&quot;work&quot;},
  {label:&quot;8限&quot;,   s:&quot;16:10&quot;, e:&quot;17:00&quot;, kind:&quot;work&quot;},
  {label:&quot;帰りのHR&quot;,s:&quot;17:00&quot;, e:&quot;18:00&quot;, kind:&quot;meeting&quot;}
];
var KIND_LABEL = {lesson:&quot;授業&quot;, meeting:&quot;会議&quot;, work:&quot;作業&quot;, break:&quot;休憩&quot;};

function toMin(t){
  var m=/^(\d{1,2}):(\d{2})$/.exec((t||&quot;&quot;).trim());
  if(!m) return null;
  return parseInt(m[1],10)*60+parseInt(m[2],10);
}
// ===== 丸め設定（画面で選択） =====
var ROUND_UNIT = 15;        // 15 / 30 / 60（分）
var ROUND_MODE = &quot;round&quot;;   // &quot;round&quot;=四捨五入 / &quot;ceil&quot;=切り上げ
function applyRound(min){
  if(min==null) return null;
  var u=ROUND_UNIT||15;
  return (ROUND_MODE===&quot;ceil&quot; ? Math.ceil(min/u) : Math.round(min/u)) * u;
}
// 後方互換：旧名 round15 は現在の設定で丸める
function round15(min){ return applyRound(min); }
function unitLabel(){ return ROUND_UNIT===60 ? &quot;1時間単位&quot; : (ROUND_UNIT+&quot;分単位&quot;); }
function modeLabel(){ return ROUND_MODE===&quot;ceil&quot; ? &quot;切り上げ&quot; : &quot;四捨五入&quot;; }
// 丸め設定の変更を反映して再計算
function onRoundChange(){
  var u=document.getElementById(&quot;round_unit&quot;), m=document.getElementById(&quot;round_mode&quot;);
  if(u) ROUND_UNIT=parseInt(u.value,10)||15;
  if(m) ROUND_MODE=(m.value===&quot;ceil&quot;?&quot;ceil&quot;:&quot;round&quot;);
  recalcTT();
}

/* ===== 時間割の連携 ON/OFF ===== */
var TT_LINK_KEY=&quot;usausa_tt_link_v1&quot;;
var ttLink=true; // 既定ON
function isTtLink(){ var el=document.getElementById(&quot;tt_link&quot;); return el ? el.checked : ttLink; }
function onTtLinkChange(){
  ttLink=isTtLink();
  var hint=document.getElementById(&quot;tt_link_hint&quot;);
  if(hint) hint.textContent = ttLink
    ? &quot;ONのとき、退勤前報告の「本日の業務内容」に今の時間割の実績コマを差し込み、月末報告書に区分別・タグ別の時間集計を載せます。OFFにすると連携しません。&quot;
    : &quot;OFF：退勤前報告・月末報告書は時間割と連携しません（それぞれ単体で生成されます）。&quot;;
  if(lsAvailable()){ try{ window.localStorage.setItem(TT_LINK_KEY, ttLink?&quot;1&quot;:&quot;0&quot;); }catch(e){} }
  toast(ttLink ? &quot;時間割の連携をONにしました&quot; : &quot;時間割の連携をOFFにしました&quot;);
}
function initTtLink(){
  var saved=null;
  if(lsAvailable()){ try{ saved=window.localStorage.getItem(TT_LINK_KEY); }catch(e){} }
  ttLink = (saved===null) ? true : (saved===&quot;1&quot;);
  var el=document.getElementById(&quot;tt_link&quot;); if(el) el.checked=ttLink;
  onTtLinkChange===onTtLinkChange; // no-op
  var hint=document.getElementById(&quot;tt_link_hint&quot;);
  if(hint) hint.textContent = ttLink
    ? &quot;ONのとき、退勤前報告の「本日の業務内容」に今の時間割の実績コマを差し込み、月末報告書に区分別・タグ別の時間集計を載せます。OFFにすると連携しません。&quot;
    : &quot;OFF：退勤前報告・月末報告書は時間割と連携しません（それぞれ単体で生成されます）。&quot;;
}
// 現在の時間割フォームから、実績（または予定）コマを「日報差し込み用」に取り出す
function ttLinkRows(){
  var rows=(typeof readPeriods===&quot;function&quot;) ? readPeriods() : [];
  return rows.filter(function(r){
    if(r.kind===&quot;break&quot;||r.isBreak) return false;
    return (r.actual||r.plan); // 何か書かれているコマだけ
  }).map(function(r){
    return {
      label:r.label, kindLabel:r.kindLabel, s:r.s, e:r.e, dur:r.dur,
      text:(r.actual||r.plan), status:r.status, isInsert:r.isInsert,
      planned:!r.actual // 実績が無く予定のみか
    };
  });
}

function fmtHM(min){
  if(min<=0) return &quot;0:00&quot;;
  var h=Math.floor(min/60), m=min%60;
  return h+&quot;:&quot;+(m<10?&quot;0&quot;:&quot;&quot;)+m;
}
// 単位コマ表記（例：1:30（90分／6コマ）。コマ＝現在の丸め単位）
function fmt15(min){
  var u=ROUND_UNIT||15;
  var q=Math.round(min/u);
  return fmtHM(min)+&quot;（&quot;+min+&quot;分／&quot;+q+&quot;コマ）&quot;;
}

function addPeriod(data, insertAfterRow){
  data = data || {label:&quot;&quot;, s:&quot;&quot;, e:&quot;&quot;, kind:&quot;work&quot;};
  if(typeof data.brk===&quot;boolean&quot; &amp;&amp; !data.kind){ data.kind = data.brk ? &quot;break&quot; : &quot;work&quot;; } // 後方互換
  var kind = data.kind || &quot;work&quot;;
  var isBreak = (kind===&quot;break&quot;);
  var isInsert = !!data.isInsert; // 差し込み（割込）コマか
  var row=document.createElement(&quot;div&quot;);
  row.className=&quot;tt-row kind-&quot;+kind+(isBreak?&quot; brk&quot;:&quot;&quot;)+(isInsert?&quot; insert&quot;:&quot;&quot;);

  var lab=document.createElement(&quot;input&quot;); lab.className=&quot;tt-label&quot;; lab.placeholder=&quot;時限&quot;; lab.value=data.label;

  var kindSel=document.createElement(&quot;select&quot;); kindSel.className=&quot;tt-kind&quot;;
  [[&quot;lesson&quot;,&quot;授業&quot;],[&quot;meeting&quot;,&quot;会議&quot;],[&quot;work&quot;,&quot;作業&quot;],[&quot;break&quot;,&quot;休憩&quot;],[&quot;other&quot;,&quot;その他&quot;]].forEach(function(p){
    var o=document.createElement(&quot;option&quot;); o.value=p[0]; o.textContent=p[1]; kindSel.appendChild(o);
  });
  kindSel.value=kind;
  // その他用カスタムラベル（kind===&quot;other&quot;のとき表示）
  var custom=document.createElement(&quot;input&quot;); custom.className=&quot;tt-custom&quot;; custom.placeholder=&quot;区分名&quot;;
  custom.value=data.customLabel||&quot;&quot;;
  custom.style.display = (kind===&quot;other&quot;) ? &quot;block&quot; : &quot;none&quot;;
  custom.addEventListener(&quot;input&quot;, recalcTT);

  var st=document.createElement(&quot;input&quot;); st.className=&quot;tt-start&quot;; st.placeholder=&quot;08:00&quot;; st.value=data.s;
  var en=document.createElement(&quot;input&quot;); en.className=&quot;tt-end&quot;; en.placeholder=&quot;08:50&quot;; en.value=data.e;
  var plan=document.createElement(&quot;input&quot;); plan.className=&quot;tt-plan&quot;; plan.placeholder=&quot;予定（やること）&quot;;
  var act=document.createElement(&quot;input&quot;); act.className=&quot;tt-actual&quot;; act.placeholder=&quot;実績（やったこと）&quot;;
  if(data.plan) plan.value=data.plan;
  if(data.actual) act.value=data.actual;
  // タグ挿入先として、最後にフォーカスした欄を記憶
  [plan,act].forEach(function(el){ el.addEventListener(&quot;focus&quot;, function(){ window.__lastTagTarget=el; }); });
  var stat=document.createElement(&quot;select&quot;); stat.className=&quot;tt-status&quot;;
  [&quot;◎&quot;,&quot;○&quot;,&quot;△&quot;,&quot;—&quot;].forEach(function(s){var o=document.createElement(&quot;option&quot;);o.textContent=s;stat.appendChild(o);});
  stat.value = data.status || (isBreak ? &quot;—&quot; : &quot;◎&quot;);
  // 差込フラグ（チェックボックス）
  var insWrap=document.createElement(&quot;label&quot;); insWrap.className=&quot;tt-ins&quot;; insWrap.title=&quot;差し込み（割込）対応のコマ&quot;;
  var insChk=document.createElement(&quot;input&quot;); insChk.type=&quot;checkbox&quot;; insChk.className=&quot;tt-insflag&quot;; insChk.checked=isInsert;
  var insTxt=document.createElement(&quot;span&quot;); insTxt.textContent=&quot;⚡&quot;;
  insWrap.appendChild(insChk); insWrap.appendChild(insTxt);
  insChk.addEventListener(&quot;change&quot;, function(){
    row.classList.toggle(&quot;insert&quot;, insChk.checked);
    recalcTT();
  });
  var min=document.createElement(&quot;div&quot;); min.className=&quot;tt-min&quot;; min.textContent=&quot;-&quot;;
  // この行の直後に差込コマを挿入するボタン
  var insBtn=document.createElement(&quot;button&quot;); insBtn.type=&quot;button&quot;; insBtn.className=&quot;ins-btn&quot;; insBtn.textContent=&quot;⤵&quot;; insBtn.title=&quot;この下に差し込みコマを追加&quot;;
  insBtn.onclick=function(){ addPeriod({label:&quot;割込&quot;, kind:&quot;other&quot;, customLabel:&quot;割込&quot;, isInsert:true}, row); };
  var del=document.createElement(&quot;button&quot;); del.type=&quot;button&quot;; del.className=&quot;del&quot;; del.textContent=&quot;×&quot;;
  del.onclick=function(){ row.remove(); recalcTT(); };

  // 区分を変えたら行の色クラスを張り替え、休憩なら達成度を—に寄せる
  kindSel.addEventListener(&quot;change&quot;, function(){
    var k=kindSel.value;
    row.className=&quot;tt-row kind-&quot;+k+(k===&quot;break&quot;?&quot; brk&quot;:&quot;&quot;)+(insChk.checked?&quot; insert&quot;:&quot;&quot;);
    custom.style.display = (k===&quot;other&quot;) ? &quot;block&quot; : &quot;none&quot;;
    if(k===&quot;break&quot;){ stat.value=&quot;—&quot;; }
    else if(stat.value===&quot;—&quot;){ stat.value=&quot;◎&quot;; }
    recalcTT();
  });

  [st,en,stat].forEach(function(el){ el.addEventListener(&quot;input&quot;, recalcTT); el.addEventListener(&quot;change&quot;, recalcTT); });

  row.appendChild(lab); row.appendChild(kindSel); row.appendChild(custom); row.appendChild(st); row.appendChild(en);
  row.appendChild(plan); row.appendChild(act); row.appendChild(stat);
  row.appendChild(insWrap); row.appendChild(min); row.appendChild(insBtn); row.appendChild(del);

  var list=document.getElementById(&quot;ttList&quot;);
  if(insertAfterRow &amp;&amp; insertAfterRow.parentNode===list){
    list.insertBefore(row, insertAfterRow.nextSibling); // 指定行の直後に挿入
  } else {
    list.appendChild(row);
  }
  recalcTT();
  i18nRefresh();
  return row;
}

function readPeriods(){
  return [].slice.call(document.querySelectorAll(&quot;#ttList .tt-row&quot;)).map(function(r){
    var s=r.querySelector(&quot;.tt-start&quot;).value, e=r.querySelector(&quot;.tt-end&quot;).value;
    var sm=toMin(s), em=toMin(e);
    var raw=(sm!=null &amp;&amp; em!=null &amp;&amp; em>sm) ? (em-sm) : 0;
    var dur=round15(raw); // 15分単位に丸める
    var status=r.querySelector(&quot;.tt-status&quot;).value;
    var kind=r.querySelector(&quot;.tt-kind&quot;).value;
    var customEl=r.querySelector(&quot;.tt-custom&quot;);
    var customLabel=customEl ? customEl.value.trim() : &quot;&quot;;
    var kindLabel = (kind===&quot;other&quot;) ? (customLabel||&quot;その他&quot;) : (KIND_LABEL[kind]||&quot;作業&quot;);
    var insEl=r.querySelector(&quot;.tt-insflag&quot;);
    return {
      label:r.querySelector(&quot;.tt-label&quot;).value.trim(),
      kind:kind, kindLabel:kindLabel, customLabel:customLabel,
      s:s.trim(), e:e.trim(), dur:dur,
      plan:r.querySelector(&quot;.tt-plan&quot;).value.trim(),
      actual:r.querySelector(&quot;.tt-actual&quot;).value.trim(),
      status:status,
      isBreak:(kind===&quot;break&quot;),
      isInsert:!!(insEl&amp;&amp;insEl.checked)
    };
  });
}

// ===== よく使うタグ（ワンタップ挿入） =====
var QTAG_KEY=&quot;usausa_quicktags_v1&quot;;
var QTAG_DEFAULT=[&quot;資料作成&quot;,&quot;会議&quot;,&quot;レビュー&quot;,&quot;メール&quot;,&quot;質問対応&quot;,&quot;学習&quot;,&quot;休憩&quot;];
function loadQuickTags(){
  if(!lsAvailable()) return (window.__memQTags||QTAG_DEFAULT.slice());
  try{ var s=window.localStorage.getItem(QTAG_KEY); return s?JSON.parse(s):QTAG_DEFAULT.slice(); }catch(e){ return QTAG_DEFAULT.slice(); }
}
function storeQuickTags(arr){
  if(lsAvailable()){ try{ window.localStorage.setItem(QTAG_KEY, JSON.stringify(arr)); }catch(e){} }
  window.__memQTags=arr;
}
function renderQuickTags(){
  var wrap=document.getElementById(&quot;tagButtons&quot;); if(!wrap) return;
  var tags=loadQuickTags();
  wrap.innerHTML=&quot;&quot;;
  if(!tags.length){ wrap.innerHTML='<span class=&quot;hint&quot; style=&quot;margin:0;&quot;>タグ未登録。下の欄から追加できます。</span>'; return; }
  tags.forEach(function(t){
    var b=document.createElement(&quot;span&quot;); b.className=&quot;tag-btn&quot;;
    var lbl=document.createElement(&quot;span&quot;); lbl.textContent=&quot;#&quot;+t;
    lbl.onclick=function(){ insertTag(t); };
    var x=document.createElement(&quot;span&quot;); x.className=&quot;x&quot;; x.textContent=&quot;×&quot;; x.title=&quot;このタグを一覧から削除&quot;;
    x.onclick=function(ev){ ev.stopPropagation(); removeQuickTag(t); };
    b.appendChild(lbl); b.appendChild(x);
    wrap.appendChild(b);
  });
}
function addQuickTag(){
  var inp=document.getElementById(&quot;newTag&quot;); if(!inp) return;
  var t=(inp.value||&quot;&quot;).trim().replace(/^[#＃]/,&quot;&quot;);
  if(!t){ return; }
  var tags=loadQuickTags();
  if(tags.indexOf(t)<0){ tags.push(t); storeQuickTags(tags); renderQuickTags(); }
  inp.value=&quot;&quot;; inp.focus();
}
function removeQuickTag(t){
  var tags=loadQuickTags().filter(function(x){return x!==t;});
  storeQuickTags(tags); renderQuickTags();
}
// 最後にフォーカスした予定/実績欄にタグを挿入（無ければ最初の予定欄）
function insertTag(t){
  var el=window.__lastTagTarget;
  if(!el || !document.body.contains(el)){
    el=document.querySelector(&quot;#ttList .tt-plan&quot;);
  }
  if(!el){ toast(&quot;挿入先の欄がありません&quot;); return; }
  var tag=&quot;#&quot;+t;
  var cur=el.value||&quot;&quot;;
  el.value = cur ? (cur.replace(/\s+$/,&quot;&quot;)+&quot; &quot;+tag+&quot; &quot;) : (tag+&quot; &quot;);
  el.focus();
  window.__lastTagTarget=el;
  recalcTT();
}

// 予定/実績テキストから #タグ を抽出（#のあと空白・全角空白・改行・カンマ・読点まで）
function extractTags(text){
  if(!text) return [];
  var out=[], re=/[#＃]([^\s,、，\/／]+)/g, m;
  while((m=re.exec(text))!==null){ if(m[1]) out.push(m[1]); }
  return out;
}
// コマ配列から、タグごとの予定時間（分）を積み上げる。タグはplan+actual両方から拾い重複排除
function tagMinutesFromPeriods(periods){
  var tagMin={};
  (periods||[]).forEach(function(p){
    if(p.kind===&quot;break&quot;||p.isBreak) return;
    var dur=p.dur||0; if(!dur) return;
    var tags=extractTags((p.plan||&quot;&quot;)+&quot; &quot;+(p.actual||&quot;&quot;));
    // 同一コマ内の重複タグは1回に
    var uniqT={}; tags.forEach(function(t){ uniqT[t]=1; });
    Object.keys(uniqT).forEach(function(t){ tagMin[t]=(tagMin[t]||0)+dur; });
  });
  return tagMin;
}

// 達成率に応じた励ましコメント（うさうさ先生）
function cheerFor(rate, slots){
  if(slots<=0) return {lv:&quot;ok&quot;, emoji:&quot;📝&quot;, title:&quot;まずは時間割を組もう&quot;, msg:&quot;コマに達成度を入れると、ここに先生からの一言が出ます🐰&quot;};
  if(rate>=90) return {lv:&quot;hanamaru&quot;, emoji:&quot;🌸&quot;, title:&quot;花丸！よくがんばりました&quot;, msg:&quot;今日の予定をほぼやり切りました。この調子を覚えておいて、明日の自分に渡してあげましょう。&quot;};
  if(rate>=75) return {lv:&quot;great&quot;, emoji:&quot;🌟&quot;, title:&quot;とても良い一日&quot;, msg:&quot;大事なところはしっかり押さえられました。残せた分は明日のTryに回せばOKです。&quot;};
  if(rate>=50) return {lv:&quot;good&quot;, emoji:&quot;💪&quot;, title:&quot;半分以上やれた、上出来&quot;, msg:&quot;ペースは悪くありません。終わらなかったコマは「なぜ」を一つだけメモすると次に活きます。&quot;};
  if(rate>=25) return {lv:&quot;ok&quot;, emoji:&quot;🌱&quot;, title:&quot;進んだ事実を認めよう&quot;, msg:&quot;思うように進まなくても、ゼロではありません。明日は難所を午前のコマに置いてみましょう。&quot;};
  return {lv:&quot;ok&quot;, emoji:&quot;☕&quot;, title:&quot;おつかれさま。今日はここまで&quot;, msg:&quot;うまくいかない日もあります。Tryに小さな一歩を1つだけ書いて、もう店じまいにしましょう🐰&quot;};
}
function renderCheer(rate, slots){
  var c=cheerFor(rate, slots);
  var card=document.getElementById(&quot;cheerCard&quot;);
  card.className=&quot;cheer-card show lv-&quot;+c.lv;
  document.getElementById(&quot;cheerEmoji&quot;).textContent=c.emoji;
  document.getElementById(&quot;cheerTitle&quot;).textContent=c.emoji+&quot; &quot;+c.title+&quot;（達成率 &quot;+rate+&quot;%）&quot;;
  document.getElementById(&quot;cheerMsg&quot;).textContent=c.msg;
  return c;
}

function recalcTT(){
  var rows=readPeriods();
  var domRows=document.querySelectorAll(&quot;#ttList .tt-row&quot;);
  var slots=0, planMin=0, actMin=0, cO=0,cMaru=0,cTri=0,cBrk=0;
  var kindMin={lesson:0,meeting:0,work:0}; // 固定区分の予定稼働時間
  var customMin={}; // カスタム区分名ごとの予定稼働時間
  var insCount=0, insMin=0; // 差し込み（割込）コマ数・時間
  rows.forEach(function(r,i){
    var dur=r.dur;
    if(domRows[i]) domRows[i].querySelector(&quot;.tt-min&quot;).textContent = dur? dur+&quot;分&quot; : &quot;-&quot;;
    if(r.kind===&quot;break&quot;){ cBrk++; return; }
    slots++; planMin+=dur;
    if(r.isInsert){ insCount++; insMin+=dur; }
    if(r.kind===&quot;other&quot;){ var nm=r.kindLabel||&quot;その他&quot;; customMin[nm]=(customMin[nm]||0)+dur; }
    else if(kindMin[r.kind]!=null){ kindMin[r.kind]+=dur; }
    if(r.status===&quot;◎&quot;){ cO++; actMin+=dur; }
    else if(r.status===&quot;○&quot;){ cMaru++; actMin+=dur*0.5; }
    else if(r.status===&quot;△&quot;){ cTri++; }
  });
  var rate = planMin>0 ? Math.round(actMin/planMin*100) : 0;
  document.getElementById(&quot;c_slots&quot;).textContent=slots;
  document.getElementById(&quot;c_plan&quot;).textContent=fmtHM(planMin);
  document.getElementById(&quot;c_actual&quot;).textContent=fmtHM(Math.round(actMin));
  document.getElementById(&quot;c_rate&quot;).textContent=rate+&quot;%&quot;;
  document.getElementById(&quot;c_barfill&quot;).style.width=Math.min(rate,100)+&quot;%&quot;;
  document.getElementById(&quot;c_breakdown&quot;).textContent=&quot;◎&quot;+cO+&quot; ／ ○&quot;+cMaru+&quot; ／ △&quot;+cTri+&quot; ／ 休憩&quot;+cBrk+(insCount?(&quot; ／ ⚡差込&quot;+insCount):&quot;&quot;);

  // 区分別 内訳バー
  var kb=document.getElementById(&quot;c_kindbar&quot;);
  if(kb){
    kb.innerHTML=&quot;&quot;;
    [[&quot;lesson&quot;,&quot;kb-lesson&quot;],[&quot;meeting&quot;,&quot;kb-meeting&quot;],[&quot;work&quot;,&quot;kb-work&quot;]].forEach(function(p){
      var w=planMin>0 ? (kindMin[p[0]]/planMin*100) : 0;
      if(w>0){ var sp=document.createElement(&quot;span&quot;); sp.className=p[1]; sp.style.width=w+&quot;%&quot;; kb.appendChild(sp); }
    });
    var custTxt=Object.keys(customMin).map(function(k){return k+&quot; &quot;+fmtHM(customMin[k]);}).join(&quot; ／ &quot;);
    document.getElementById(&quot;c_kindlabel&quot;).textContent=
      &quot;区分別 予定時間（&quot;+unitLabel()+&quot;／&quot;+modeLabel()+&quot;）：授業 &quot;+fmtHM(kindMin.lesson)+&quot; ／ 会議 &quot;+fmtHM(kindMin.meeting)+&quot; ／ 作業 &quot;+fmtHM(kindMin.work)+(custTxt?(&quot; ／ &quot;+custTxt):&quot;&quot;);
  }

  // タグ別 時間集計（#タグ）
  var tagMin=tagMinutesFromPeriods(rows);
  var tagKeys=Object.keys(tagMin).sort(function(a,b){return tagMin[b]-tagMin[a];});
  var tl=document.getElementById(&quot;c_taglabel&quot;);
  if(tl){
    var parts=[];
    if(tagKeys.length){ parts.push(&quot;タグ別 時間：&quot; + tagKeys.map(function(k){return &quot;#&quot;+k+&quot; &quot;+fmtHM(tagMin[k]);}).join(&quot; ／ &quot;)); }
    if(insCount){ parts.push(&quot;⚡差し込み対応：&quot;+insCount+&quot;件・&quot;+fmtHM(insMin)); }
    if(parts.length){ tl.style.display=&quot;block&quot;; tl.textContent=parts.join(&quot;　|　&quot;); }
    else { tl.style.display=&quot;none&quot;; }
  }

  renderCheer(rate, slots);

  return {slots:slots,planMin:planMin,actMin:Math.round(actMin),rate:rate,
    cO:cO,cMaru:cMaru,cTri:cTri,cBrk:cBrk,kindMin:kindMin,customMin:customMin,tagMin:tagMin,
    insCount:insCount,insMin:insMin};
}

function buildTimetable(){
  currentTab=&quot;timetable&quot;;
  var rows=readPeriods();
  var sum=recalcTT();

  /* ===== テキスト版 ===== */
  var o=[];
  o.push(BAR); o.push(&quot;🏫 今日の時間割・HR（&quot;+v(&quot;tt_date&quot;)+&quot;）&quot;); o.push(BAR);
  o.push(&quot;天気（気分）：&quot;+v(&quot;tt_mood&quot;));
  o.push(&quot;出席（勤務地）：&quot;+v(&quot;tt_place&quot;));
  o.push(&quot;今日のめあて：&quot;+v(&quot;tt_goal&quot;));
  o.push(&quot;一言：「&quot;+v(&quot;tt_word&quot;)+&quot;」&quot;);
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;🕘 時間割&quot;); o.push(BAR2);
  rows.forEach(function(r){
    var time=(r.s&amp;&amp;r.e)?(r.s+&quot;-&quot;+r.e):&quot;&quot;;
    var head=time+&quot; [&quot;+r.kindLabel+&quot;] &quot;+r.label;
    var body=r.isBreak ? &quot;（休憩）&quot; : (r.status+&quot; 予定：&quot;+(r.plan||&quot;-&quot;)+&quot; ／ 実績：&quot;+(r.actual||&quot;-&quot;));
    o.push(head.trim()+&quot; │ &quot;+body);
  });
  o.push(&quot;&quot;);
  o.push(BAR2); o.push(&quot;📊 予定 vs 実績&quot;); o.push(BAR2);
  o.push(&quot;稼働コマ：&quot;+sum.slots+&quot;コマ&quot;);
  o.push(&quot;予定 稼働時間：&quot;+fmtHM(sum.planMin));
  o.push(&quot;実績（達成換算）：&quot;+fmtHM(sum.actMin));
  o.push(&quot;達成率：&quot;+sum.rate+&quot;%&quot;);
  o.push(&quot;内訳：◎&quot;+sum.cO+&quot; ／ ○&quot;+sum.cMaru+&quot; ／ △&quot;+sum.cTri+&quot; ／ 休憩&quot;+sum.cBrk);
  o.push(&quot;区分別 予定時間：授業 &quot;+fmtHM(sum.kindMin.lesson)+&quot; ／ 会議 &quot;+fmtHM(sum.kindMin.meeting)+&quot; ／ 作業 &quot;+fmtHM(sum.kindMin.work));
  o.push(&quot;&quot;);
  var cheer=cheerFor(sum.rate, sum.slots);
  o.push(BAR); o.push(&quot;🏁 帰りのHR（振り返り）&quot;); o.push(BAR);
  o.push(cheer.emoji+&quot; &quot;+cheer.title+&quot;（達成率 &quot;+sum.rate+&quot;%）&quot;);
  o.push(cheer.msg);
  o.push(&quot;&quot;);
  o.push(&quot;できたこと(Keep)：&quot;+v(&quot;tt_keep&quot;));
  o.push(&quot;課題(Problem)：&quot;+v(&quot;tt_problem&quot;));
  o.push(&quot;明日へ(Try)：&quot;+v(&quot;tt_try&quot;));
  o.push(&quot;先生から一言：&quot;+v(&quot;tt_teacher&quot;));
  var txt=o.join(&quot;\n&quot;);

  /* ===== Markdown版 ===== */
  var m=[];
  m.push(&quot;# 🏫 今日の時間割・HR（&quot;+v(&quot;tt_date&quot;)+&quot;）&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;- 天気（気分）：&quot;+v(&quot;tt_mood&quot;));
  m.push(&quot;- 出席（勤務地）：&quot;+v(&quot;tt_place&quot;));
  m.push(&quot;- **今日のめあて**：&quot;+v(&quot;tt_goal&quot;));
  m.push(&quot;- 一言：「&quot;+v(&quot;tt_word&quot;)+&quot;」&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;## 🕘 時間割&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;| 時限 | 区分 | 時間 | 予定 | 実績 | 達成 | 予定分 |&quot;);
  m.push(&quot;|---|---|---|---|---|:---:|---:|&quot;);
  rows.forEach(function(r){
    var time=(r.s&amp;&amp;r.e)?(r.s+&quot;–&quot;+r.e):&quot;&quot;;
    if(r.isBreak){
      m.push(&quot;| &quot;+r.label+&quot; | &quot;+r.kindLabel+&quot; | &quot;+time+&quot; | （休憩） | | — | |&quot;);
    } else {
      m.push(&quot;| &quot;+r.label+&quot; | &quot;+r.kindLabel+&quot; | &quot;+time+&quot; | &quot;+(r.plan||&quot;&quot;)+&quot; | &quot;+(r.actual||&quot;&quot;)+&quot; | &quot;+r.status+&quot; | &quot;+(r.dur?r.dur+&quot;分&quot;:&quot;&quot;)+&quot; |&quot;);
    }
  });
  m.push(&quot;&quot;);
  m.push(&quot;## 📊 予定 vs 実績&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;| 指標 | 値 |&quot;);
  m.push(&quot;|---|---|&quot;);
  m.push(&quot;| 稼働コマ | &quot;+sum.slots+&quot;コマ |&quot;);
  m.push(&quot;| 予定 稼働時間 | &quot;+fmtHM(sum.planMin)+&quot; |&quot;);
  m.push(&quot;| 実績（達成換算） | &quot;+fmtHM(sum.actMin)+&quot; |&quot;);
  m.push(&quot;| 達成率 | &quot;+sum.rate+&quot;% |&quot;);
  m.push(&quot;| 内訳 | ◎&quot;+sum.cO+&quot; ／ ○&quot;+sum.cMaru+&quot; ／ △&quot;+sum.cTri+&quot; ／ 休憩&quot;+sum.cBrk+&quot; |&quot;);
  m.push(&quot;| 区分別 予定時間 | 授業 &quot;+fmtHM(sum.kindMin.lesson)+&quot; ／ 会議 &quot;+fmtHM(sum.kindMin.meeting)+&quot; ／ 作業 &quot;+fmtHM(sum.kindMin.work)+&quot; |&quot;);
  m.push(&quot;&quot;);
  var cheerM=cheerFor(sum.rate, sum.slots);
  m.push(&quot;## 🏁 帰りのHR（振り返り）&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;> &quot;+cheerM.emoji+&quot; **&quot;+cheerM.title+&quot;（達成率 &quot;+sum.rate+&quot;%）**  &quot;);
  m.push(&quot;> &quot;+cheerM.msg);
  m.push(&quot;&quot;);
  m.push(&quot;- **できたこと（Keep）**：&quot;+v(&quot;tt_keep&quot;));
  m.push(&quot;- **課題（Problem）**：&quot;+v(&quot;tt_problem&quot;));
  m.push(&quot;- **明日へ（Try）**：&quot;+v(&quot;tt_try&quot;));
  m.push(&quot;- 先生から一言：&quot;+v(&quot;tt_teacher&quot;));
  var md=m.join(&quot;\n&quot;);

  setOut(txt, md);
}

/* ============ 30日ログ（保存・Excel入出力・区分集計） ============ */
var DAYS_KEY = &quot;usausa_tt_days_v1&quot;;

// localStorage（ローカル実行時のみ・claude.ai内プレビューでは無効化）
function lsAvailable(){
  try{ var k=&quot;__t&quot;; window.localStorage.setItem(k,&quot;1&quot;); window.localStorage.removeItem(k); return true; }
  catch(e){ return false; }
}
function loadDays(){
  if(!lsAvailable()) return (window.__memDays||[]);
  try{ return JSON.parse(window.localStorage.getItem(DAYS_KEY)||&quot;[]&quot;); }catch(e){ return []; }
}
function storeDays(arr){
  if(lsAvailable()){ try{ window.localStorage.setItem(DAYS_KEY, JSON.stringify(arr)); }catch(e){} }
  window.__memDays = arr; // フォールバック（メモリ保持）
}

// 現在の入力から1日分のデータを作る
function currentDayRecord(){
  var rows=readPeriods();
  var sum=recalcTT();
  return {
    date: v(&quot;tt_date&quot;) || &quot;(日付未設定)&quot;,
    mood: v(&quot;tt_mood&quot;), place: v(&quot;tt_place&quot;),
    goal: v(&quot;tt_goal&quot;), word: v(&quot;tt_word&quot;),
    keep: v(&quot;tt_keep&quot;), problem: v(&quot;tt_problem&quot;), tryv: v(&quot;tt_try&quot;), teacher: v(&quot;tt_teacher&quot;),
    slots: sum.slots, planMin: sum.planMin, actMin: sum.actMin, rate: sum.rate,
    cO: sum.cO, cMaru: sum.cMaru, cTri: sum.cTri, cBrk: sum.cBrk,
    kindMin: sum.kindMin,
    customMin: sum.customMin||{},
    breakMin: rows.filter(function(r){return r.isBreak;}).reduce(function(a,r){return a+r.dur;},0),
    periods: rows.map(function(r){
      return {label:r.label, kind:r.kind, kindLabel:r.kindLabel, customLabel:r.customLabel||&quot;&quot;, s:r.s, e:r.e, dur:r.dur,
        plan:r.plan, actual:r.actual, status:r.status, isInsert:!!r.isInsert};
    })
  };
}

function saveDay(){
  var rec=currentDayRecord();
  if(!rec.date || rec.date===&quot;(日付未設定)&quot;){ toast(&quot;日付を入れてください&quot;); return; }
  var days=loadDays();
  var idx=days.findIndex(function(d){return d.date===rec.date;});
  if(idx>=0){ days[idx]=rec; } else { days.push(rec); }
  days.sort(function(a,b){ return a.date<b.date?-1:(a.date>b.date?1:0); });
  storeDays(days);
  renderDayList();
  toast(idx>=0 ? &quot;上書き保存しました&quot; : &quot;保存しました&quot;);
}
function deleteDay(date){
  var days=loadDays().filter(function(d){return d.date!==date;});
  storeDays(days); renderDayList(); toast(&quot;削除しました&quot;);
}
function clearAllDays(){
  if(!loadDays().length){ toast(&quot;保存データはありません&quot;); return; }
  if(window.confirm &amp;&amp; !window.confirm(&quot;保存した全ての日を消去します。よろしいですか？&quot;)) return;
  storeDays([]); renderDayList(); toast(&quot;全消去しました&quot;);
}
function loadDayToForm(date){
  var rec=loadDays().find(function(d){return d.date===date;});
  if(!rec) return;
  document.getElementById(&quot;tt_date&quot;).value=rec.date;
  if(rec.mood) document.getElementById(&quot;tt_mood&quot;).value=rec.mood;
  if(rec.place) document.getElementById(&quot;tt_place&quot;).value=rec.place;
  document.getElementById(&quot;tt_goal&quot;).value=rec.goal||&quot;&quot;;
  document.getElementById(&quot;tt_word&quot;).value=rec.word||&quot;&quot;;
  document.getElementById(&quot;tt_keep&quot;).value=rec.keep||&quot;&quot;;
  document.getElementById(&quot;tt_problem&quot;).value=rec.problem||&quot;&quot;;
  document.getElementById(&quot;tt_try&quot;).value=rec.tryv||&quot;&quot;;
  document.getElementById(&quot;tt_teacher&quot;).value=rec.teacher||&quot;&quot;;
  document.getElementById(&quot;ttList&quot;).innerHTML=&quot;&quot;;
  (rec.periods||[]).forEach(function(p){
    addPeriod({label:p.label, s:p.s, e:p.e, kind:p.kind, customLabel:p.customLabel||&quot;&quot;, isInsert:!!p.isInsert});
  });
  // 達成度・予定・実績を流し込む
  var rowsEl=document.querySelectorAll(&quot;#ttList .tt-row&quot;);
  (rec.periods||[]).forEach(function(p,i){
    var r=rowsEl[i]; if(!r) return;
    r.querySelector(&quot;.tt-plan&quot;).value=p.plan||&quot;&quot;;
    r.querySelector(&quot;.tt-actual&quot;).value=p.actual||&quot;&quot;;
    r.querySelector(&quot;.tt-status&quot;).value=p.status||&quot;◎&quot;;
    var ins=r.querySelector(&quot;.tt-insflag&quot;); if(ins){ ins.checked=!!p.isInsert; r.classList.toggle(&quot;insert&quot;, !!p.isInsert); }
  });
  recalcTT();
  toast(rec.date+&quot; を読み込みました&quot;);
  document.querySelector(&quot;#panel-timetable&quot;).scrollIntoView&amp;&amp;document.querySelector(&quot;#panel-timetable&quot;).scrollIntoView({behavior:&quot;smooth&quot;});
}

function aggregateDays(){
  var days=loadDays();
  var agg={lesson:0,meeting:0,work:0,brk:0}, rateSum=0;
  days.forEach(function(d){
    agg.lesson += (d.kindMin&amp;&amp;d.kindMin.lesson)||0;
    agg.meeting+= (d.kindMin&amp;&amp;d.kindMin.meeting)||0;
    agg.work   += (d.kindMin&amp;&amp;d.kindMin.work)||0;
    agg.brk    += d.breakMin||0;
    rateSum += d.rate||0;
  });
  return {days:days, count:days.length, agg:agg, avgRate: days.length? Math.round(rateSum/days.length):0};
}

/* ---- 月末報告書（期間集計＋やったこと/達成/課題/リーダー） ---- */
// 日付文字列を比較可能なキーに（&quot;2026/05/01&quot; や &quot;2026/5/1（水）&quot; を 20260501 に）
function dateKey(s){
  var m=/(\d{4})\D+(\d{1,2})\D+(\d{1,2})/.exec(s||&quot;&quot;);
  if(!m) return null;
  return parseInt(m[1],10)*10000+parseInt(m[2],10)*100+parseInt(m[3],10);
}
function daysInRange(from, to){
  var fk=dateKey(from), tk=dateKey(to);
  return loadDays().filter(function(d){
    var k=dateKey(d.date); if(k==null) return (!fk&amp;&amp;!tk); // 日付不明は無期間時のみ含める
    if(fk &amp;&amp; k<fk) return false;
    if(tk &amp;&amp; k>tk) return false;
    return true;
  });
}
// 生成結果ボタン用：どのタブからでも月末報告書を生成（時間割タブへ切替）
function monthlyReportFromOutput(){
  if(!loadDays().length){ toast(&quot;先に時間割タブで日々を保存してください&quot;); return; }
  var tab=[].slice.call(document.querySelectorAll(&quot;.tab&quot;)).filter(function(t){return t.dataset.tab===&quot;timetable&quot;;})[0];
  if(tab) tab.click();
  buildMonthlyReport();
}
// 生成結果ボタン用：今日の日報（退勤前報告タブへ切替して生成）
function reportFromOutput(){
  var tab=[].slice.call(document.querySelectorAll(&quot;.tab&quot;)).filter(function(t){return t.dataset.tab===&quot;report&quot;;})[0];
  if(tab) tab.click();
  buildReport();
}
// 生成結果ボタン用：スキルシート（スキルシートタブへ切替して生成）
function skillFromOutput(){
  var tab=[].slice.call(document.querySelectorAll(&quot;.tab&quot;)).filter(function(t){return t.dataset.tab===&quot;skill&quot;;})[0];
  if(tab) tab.click();
  buildSkill();
}
// 生成結果ボタン用：週次振り返り（時間割タブへ切替して生成）
function weeklyReviewFromOutput(){
  if(!loadDays().length){ toast(&quot;先に時間割タブで日々を保存してください&quot;); return; }
  var tab=[].slice.call(document.querySelectorAll(&quot;.tab&quot;)).filter(function(t){return t.dataset.tab===&quot;timetable&quot;;})[0];
  if(tab) tab.click();
  buildWeeklyReview();
}
// 生成結果ボタン用：個人用カイゼンMTG（時間割タブへ切替して生成）
function kaizenMTGFromOutput(){
  if(!loadDays().length &amp;&amp; !v(&quot;kz_hobby&quot;) &amp;&amp; !v(&quot;kz_change&quot;)){ toast(&quot;先に時間割タブで日々を保存するか、趣味枠/Changeを入力してください&quot;); return; }
  var tab=[].slice.call(document.querySelectorAll(&quot;.tab&quot;)).filter(function(t){return t.dataset.tab===&quot;timetable&quot;;})[0];
