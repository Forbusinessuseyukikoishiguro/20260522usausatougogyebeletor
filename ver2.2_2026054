/* ===================================================== */
/* ============== 共通：コピー処理 ===================== */
/* ===================================================== */
function copyTo(outputId, btnId){
  const text = document.getElementById(outputId).textContent;
  navigator.clipboard.writeText(text).then(()=>{
    const btn = document.getElementById(btnId);
    const orig = btn.innerHTML;
    btn.innerHTML = '✓ コピー完了';
    btn.classList.add('copied');
    setTimeout(()=>{
      btn.innerHTML = orig;
      btn.classList.remove('copied');
    }, 2000);
  });
}

/* ===================================================== */
/* ============== 共通：Markdownダウンロード =========== */
/* ===================================================== */
function downloadMarkdown(outputId, prefix, btn){
  const text = document.getElementById(outputId).textContent;
  if (!text || !text.trim()) { alert('先に「生成」してから保存してください'); return; }
  // ファイル名：プレフィックス＋日付（YYYYMMDD）＋時刻
  const now = new Date();
  const pad = n => String(n).padStart(2,'0');
  const stamp = `${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}`;
  const filename = `${prefix}_${stamp}.md`;
  // BOM付きUTF-8でNotion/各種エディタの文字化けを防ぐ
  const blob = new Blob(['\uFEFF' + text], {type: 'text/markdown;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(url), 1000);
  // ボタンフィードバック
  if (btn){
    const orig = btn.innerHTML;
    btn.innerHTML = '✓ 保存しました';
    btn.classList.add('copied');
    setTimeout(()=>{ btn.innerHTML = orig; btn.classList.remove('copied'); }, 2000);
  }
}
// data-out / data-prefix を持つダウンロードボタンに一括バインド
document.querySelectorAll('[id$=&quot;dl-btn&quot;][data-out]').forEach(btn => {
  btn.addEventListener('click', () => {
    downloadMarkdown(btn.dataset.out, btn.dataset.prefix, btn);
  });
});

