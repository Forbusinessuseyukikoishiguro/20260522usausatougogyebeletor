document.getElementById('m_date').value = todayStr;

/* ===================================================== */
/* ============== 共通：対象者ラベル =================== */
/* ===================================================== */
function audLabel(){
  return {newbie:'🌱 非エンジニア研修生向け', eng:'🛠 エンジニア研修生向け', se:'🏢 社内SE / 実務者向け'}[audience];
}
function audTone(){
  // 対象者ごとの冒頭注記
  if (audience === 'newbie') return '> 💡 **この文書は非エンジニア研修生向けに丁寧な表現で作成されています。専門用語には注釈が付きます。**';
  if (audience === 'eng')    return '> 🛠 **この文書はエンジニア研修生向けに、技術的正確性を保ちつつ手順を明示しています。**';
  if (audience === 'se')     return '> 🏢 **本書は社内SE向け正式文書です。ISO 9001 / ISO/IEC 27001 準拠様式に従い記載されています。**';
}
function isoSection(docno, rev, conf, relate, author, checker, approver, created){
  return `## 📐 ISO文書管理情報

| 項目 | 内容 |
|------|------|
| 文書番号 | ${docno || '（未採番）'} |
| 版数 | ${rev || 'Rev.1.0'} |
| 機密区分 | ${conf || '社内限'} |
| 制定日 | ${created || todayStr} |
| 最終改訂日 | ${created || todayStr} |
| 作成者 | ${author || '未記入'} |
| 確認者 | ${checker || '未記入'} |
| 承認者 | ${approver || '未記入'} |
| 関連文書 | ${relate || 'なし'} |

### 改訂履歴

| 版数 | 日付 | 改訂内容 | 改訂者 |
|------|------|----------|--------|
| ${rev || 'Rev.1.0'} | ${created || todayStr} | 初版作成 | ${author || '未記入'} |`;
}

/* ===================================================== */
/* ============== タブ1：作業手順書生成 ================ */
/* ===================================================== */
document.getElementById('gen-btn').addEventListener('click', () => {
  const v = id => document.getElementById(id).value.trim();
  const title = v('title') || '無題の作業手順書';
  const assignee = v('assignee') || '未設定';
  const created = v('created') || todayStr;
  const deadline = v('deadline') || '未設定';
  const done_cond = v('done_cond') || '未設定';
  const purpose = v('purpose') || '記載なし';
  const scope = v('scope') || '記載なし';
  const caution = v('caution');
  const rollback = v('rollback');
  const emergency = sel['emergency'] || '未設定';
  const priority = sel['priority'] || '未設定';
  const status = sel['status'] || '未設定';

  const docno = v('t_docno');
  const rev = v('t_rev');
  const conf = document.getElementById('t_conf').value;
  const relate = v('t_relate');
  const author = v('t_author');
  const checker = v('t_checker');
  const approver = v('t_approver');

  const stepInputs = stepsContainer.querySelectorAll('input[type=text]');
  const steps = [...stepInputs].map((s,i) => {
    const t = s.value.trim();
    if (!t) return null;
    return `- [ ] **Step ${i+1}** ${t}`;
  }).filter(Boolean);

  const cautionLines = caution ? caution.split('\n').map(l=>l.startsWith('-')?l:'- '+l).join('\n') : '- 特記事項なし';
  const rollbackLines = rollback ? rollback.split('\n').map((l,i)=>{
    const clean = l.replace(/^\d+[\.\)]\s*/,'');
    return `${i+1}. ${clean}`;
  }).join('\n') : '1. ロールバック手順未記載';

  // 対象者別の追加セクション
  let auxSection = '';
  if (audience === 'newbie') {
    auxSection = `\n---\n\n## 📚 用語メモ（非エンジニア研修生向け）\n\n> このセクションは作業中に出てきた専門用語を後で記入する欄です。\n\n| 用語 | 意味（自分の言葉で） |\n|------|----------------------|\n|  |  |\n|  |  |\n`;
  } else if (audience === 'eng') {
    auxSection = `\n---\n\n## 🧪 検証コマンド・確認観点\n\n\`\`\`bash\n# 例：ヘルスチェック\n# curl -s http://localhost:8080/health | jq\n\`\`\`\n\n- [ ] 想定通りのレスポンスコードか\n- [ ] エラーログが出ていないか\n- [ ] パフォーマンス劣化がないか\n`;
  } else if (audience === 'se') {
    auxSection = `\n---\n\n## 🔒 セキュリティ・コンプライアンス確認（ISO/IEC 27001）\n\n- [ ] 機密区分に応じたアクセス制御を確認した\n- [ ] 監査ログ取得設定を確認した\n- [ ] 個人情報・機密情報の取扱いに問題ないことを確認した\n- [ ] 関連規程（${relate || '関連文書未設定'}）と矛盾しないことを確認した\n`;
  }

  const md = `${audTone()}

# 📋 ${title}

${isoSection(docno, rev, conf, relate, author, checker, approver, created)}

---

${buildPrinciplesMarkdown()}

---

## 🏷 タスク基本情報

| 項目 | 内容 |
|------|------|
| 担当者 | ${assignee} |
| 作成日 | ${created} |
| 期限 | ${deadline} |
| 緊急度 | ${emergency} |
| 優先度 | ${priority} |
| ステータス | ${status} |
| 完了条件 | ${done_cond} |
| 対象者 | ${audLabel()} |

---

## 🎯 目的・背景

${purpose}

**影響範囲：** ${scope}

---

## ✅ 作業ステップ

${steps.length > 0 ? steps.join('\n') : '- [ ] ステップが未入力です'}

---

## ⚠️ 注意事項

${cautionLines}

---

## 🔁 ロールバック手順

${rollbackLines}
${auxSection}
---

## 📝 作業ログ（実施時に記入）

| 日時 | 担当 | 内容 | 結果 |
|------|------|------|------|
|  |  |  |  |

---

## ✍️ 承認サイン

| 区分 | 氏名 | 日付 | 印 |
|------|------|------|----|
| 作成 | ${author || ''} | ${created} |  |
| 確認 | ${checker || ''} |  |  |
| 承認 | ${approver || ''} |  |  |

---

> 🐰 *Generated by うさうさ式 IT現場ジェネレーター v2 ─ 面白きこともなき世を面白く*
> *本手順書は ${created} 時点の情報をもとに作成されました。*`;

  document.getElementById('output').textContent = md;
  document.getElementById('output-card').style.display='block';
  document.getElementById('output-card').scrollIntoView({behavior:'smooth',block:'nearest'});
});

document.getElementById('copy-btn').addEventListener('click', () => {
  copyTo('output', 'copy-btn');
});

/* ===================================================== */
/* ============== タブ2：報連相生成 ==================== */
/* ===================================================== */
const PATTERN_META = {
  A: {icon:'🚨', name:'緊急報告', urgency:'🚨 緊急対応要', tip:'即時の判断・指示を仰ぐ報告です。事実→影響→現在対応中の内容→必要な判断、の順で簡潔に。'},
  B: {icon:'💡', name:'相談',     urgency:'⚠️ 判断仰ぐ', tip:'判断を仰ぐ相談です。選択肢を整理して提示し、自分の推奨案も添えると意思決定が早まります。'},
  C: {icon:'📢', name:'連絡',     urgency:'ℹ️ 情報共有', tip:'返答は基本不要の情報共有です。「何を」「いつから」「誰に影響するか」を明確に。'},
  D: {icon:'📊', name:'進捗報告', urgency:'ℹ️ 定期報告', tip:'タスクの状態共有です。完了/進行中/未着手・課題・次のアクションを構造化して報告。'},
  E: {icon:'❓', name:'質問・確認', urgency:'ℹ️ 回答待ち', tip:'質問です。自分で調べた結果と、どこで詰まったかを必ず添えること（丸投げ防止）。'}
};

document.getElementById('h_gen-btn').addEventListener('click', () => {
  const v = id => document.getElementById(id).value.trim();
  if (!pattern) { alert('報連相パターン（A〜E）を選択してください'); return; }

  const meta = PATTERN_META[pattern];
  const from = v('h_from') || '未設定';
  const to = v('h_to') || '未設定';
  const title = v('h_title') || '（件名未入力）';
  const date = v('h_date') || todayStr;
  const time = v('h_time') || '';
  const ch = document.getElementById('h_channel').value;

  const when = v('h_when'), where = v('h_where'), who = v('h_who'), what = v('h_what'), how = v('h_how');
  const impression = v('h_impression');
  const request = v('h_request');
  const whenNeed = v('h_when_need');
  const selfAction = v('h_self_action');
  const options = v('h_options');

  const docno = v('h_docno');
  const rev = v('h_rev');
  const conf = document.getElementById('h_conf').value;
  const relate = v('h_relate');

  // パターン別の構成
  const factSection = `## ① 事実（FACT）

| 5W2H | 内容 |
|------|------|
| いつ（When） | ${when || '未記入'} |
| どこで（Where） | ${where || '未記入'} |
| 誰が（Who） | ${who || '未記入'} |
| 何を（What） | ${what || '未記入'} |

**どのように／観察内容（How）：**

${how || '（記載なし）'}`;

  const impSection = impression ? `## ② 所感・推測（IMPRESSION）

> ⚠️ 以下は推測・仮説であり、確定事実ではありません。

${impression}` : '';

  const optSection = (pattern === 'B' &amp;&amp; options) ? `## 📊 選択肢の提示

${options.split('\n').map(l=>l.trim()).filter(Boolean).map((l,i)=>`**案${i+1}**：${l.replace(/^案\d+[：:]\s*/,'')}`).join('\n\n')}` : '';

  const reqSection = `## ③ 依頼事項（REQUEST）

**お願いしたいこと：**

${request || '（記載なし）'}

**いつまでに：** ${whenNeed || '未設定'}

**自分で取った／取る予定の対応：**

${selfAction || '（記載なし）'}`;

  // 対象者別の冒頭ガイド
  let toneNote = '';
  if (audience === 'newbie') {
    toneNote = `\n> 🌱 **非エンジニア研修生向けメモ**：報連相は「事実 → 所感 → 依頼」の3つを分けて伝えるのがコツです。「思います」「気がします」は所感セクションに入れましょう。\n`;
  } else if (audience === 'se') {
    toneNote = `\n> 🏢 **社内SE向けメモ**：本連絡は ISO/IEC 27001 上の事象記録としても扱われる可能性があるため、事実は時刻・対象システム・観測値を必ず明記してください。\n`;
  }

  const md = `${audTone()}

# ${meta.icon} 【報連相 / パターン${pattern}：${meta.name}】${title}

${isoSection(docno, rev, conf, relate, from, '', '', date)}

---

${buildPrinciplesMarkdown()}

---

## 📨 基本情報

| 項目 | 内容 |
|------|------|
| パターン | **${pattern}：${meta.icon} ${meta.name}** |
| 緊急度 | ${meta.urgency} |
| 発信者 | ${from} |
| 宛先 | ${to} |
| 発生日時 | ${date} ${time} |
| 連絡手段 | ${ch} |
| 対象者 | ${audLabel()} |

> 💬 **このパターンの使い方：** ${meta.tip}
${toneNote}
---

${factSection}

---

${impSection}

${impSection ? '---\n' : ''}${optSection ? optSection + '\n\n---\n\n' : ''}${reqSection}

---

## 📝 受領確認（受信側が記入）

| 確認者 | 受領日時 | 判断・指示内容 |
|--------|----------|----------------|
|  |  |  |

---

> 🐰 *Generated by うさうさ式 IT現場ジェネレーター v2 ─ 事実と所感を分ける*`;

  document.getElementById('h_output').textContent = md;
  document.getElementById('h_output-card').style.display='block';
  document.getElementById('h_output-card').scrollIntoView({behavior:'smooth',block:'nearest'});
});

document.getElementById('h_copy-btn').addEventListener('click', () => {
  copyTo('h_output', 'h_copy-btn');
});

/* ===================================================== */
/* ============== タブ3：認識・理解確認生成 ============ */
/* ===================================================== */
document.getElementById('c_gen-btn').addEventListener('click', () => {
  const v = id => document.getElementById(id).value.trim();

  const self = v('c_self') || '未設定';
  const giver = v('c_giver') || '未設定';
  const date = v('c_date') || todayStr;
  const title = v('c_title') || '（タスク名未入力）';
  const via = document.getElementById('c_via').value;

  const instruction = v('c_instruction') || '（記載なし）';
  const def = v('c_def');
  const metaphor = v('c_metaphor');
  const detail = v('c_detail');
  const summary = v('c_summary');
  const output = v('c_output_form');
  const submit = v('c_submit');
  const dod = v('c_dod');
  const dueact = v('c_dueact');
  const unclear = v('c_unclear');
  const plan = v('c_plan');
  const risk = v('c_risk');

  const docno = v('c_docno');
  const rev = v('c_rev');
  const conf = document.getElementById('c_conf').value;
  const relate = v('c_relate');

  // 対象者別の問いかけ
  let askLine = '';
  if (audience === 'newbie') {
    askLine = `**この理解で進めて問題ないでしょうか？** 1点でもズレや追加情報があればご指摘ください。私の理解不足の可能性が高いため、遠慮なくご指導いただけると助かります。`;
  } else if (audience === 'eng') {
    askLine = `**この認識で進行してよろしいでしょうか？** 認識相違があればご指摘ください。Q1〜の不明点について先にご回答いただけますと、手戻りなく着手できます。`;
  } else if (audience === 'se') {
    askLine = `**本認識票の内容にて作業着手の承認をお願いいたします。** 認識齟齬がある場合は本書を改訂のうえ再提出いたします。ISO 9001 8.2項（顧客要求事項のレビュー）に基づき、着手前承認をいただきたく存じます。`;
  }

  const md = `${audTone()}

# ✅ 認識・理解確認書：${title}

${isoSection(docno, rev, conf, relate, self, giver, '', date)}

---

${buildPrinciplesMarkdown()}

---

## 📨 基本情報

| 項目 | 内容 |
