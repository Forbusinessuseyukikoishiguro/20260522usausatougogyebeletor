/* ===================================================== */
/* ============== タブ12：育成＆社内SE ================= */
/* ===================================================== */

let growMode = 'mentor';
const GROW_MODE_META = {
  mentor: {icon:'👩‍🏫', name:'メンター育成計画'},
  mentee: {icon:'🌱', name:'メンティー成長記録'},
  se:     {icon:'🏢', name:'社内SE ISO式業務記録'},
  delegate: {icon:'📤', name:'業務移譲＆フォロー設計'}
};

document.querySelectorAll('.pattern-card[data-gmode]').forEach(p => {
  p.addEventListener('click', () => {
    document.querySelectorAll('.pattern-card[data-gmode]').forEach(x => x.classList.remove('active'));
    p.classList.add('active');
    growMode = p.dataset.gmode;
    document.querySelectorAll('.gmode-block').forEach(b => {
      b.style.display = (b.dataset.gmodeTarget === growMode) ? 'block' : 'none';
    });
  });
});
document.querySelector('.pattern-card[data-gmode=&quot;mentor&quot;]').classList.add('active');

(function(){ const el = document.getElementById('g_se_date'); if (el &amp;&amp; !el.value) el.value = todayStr; })();

/* --- メンター育成ステップ --- */
const gmtSteps = document.getElementById('g_mt_steps');
let gmtStepCount = 0;
function addGmtStep(period='', goal='', method=''){
  gmtStepCount++;
  const row = document.createElement('div');
  row.className = 'ticket-item';
  row.innerHTML = `
    <div class=&quot;ticket-head&quot;>
      <span class=&quot;ticket-type story&quot;>STEP ${gmtStepCount}</span>
      <input type=&quot;text&quot; class=&quot;gmt-period&quot; value=&quot;${period.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;時期（例：1ヶ月目）&quot; style=&quot;flex:1;min-width:120px;font-size:13px&quot;>
      <button class=&quot;btn-mini&quot; onclick=&quot;this.closest('.ticket-item').remove()&quot;>🗑</button>
    </div>
    <div class=&quot;ticket-row&quot;>
      <div style=&quot;grid-column:span 1&quot;><label>到達目標</label><input type=&quot;text&quot; class=&quot;gmt-goal&quot; value=&quot;${goal.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;例：基本コマンドを自力で使える&quot;></div>
      <div style=&quot;grid-column:span 2&quot;><label>育成方法・課題</label><input type=&quot;text&quot; class=&quot;gmt-method&quot; value=&quot;${method.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;例：実機演習＋週1レビュー&quot;></div>
    </div>`;
  gmtSteps.appendChild(row);
}
document.getElementById('g_mt_addstep').addEventListener('click', () => addGmtStep());
document.getElementById('g_mt_clearstep').addEventListener('click', () => { if(confirm('ステップをすべて削除しますか？')){gmtSteps.innerHTML='';gmtStepCount=0;} });
addGmtStep('1ヶ月目', '基礎の定着', '実機演習中心・成功体験を積む');
addGmtStep('2ヶ月目', '自力での問題解決', '30分ルールで自走を促す');
addGmtStep('3ヶ月目', '応用・後輩サポート', '小さなタスクを任せる');

/* --- 社内SE 実施手順 --- */
const gseSteps = document.getElementById('g_se_steps');
let gseStepCount = 0;
function addGseStep(actor='', action='', evidence=''){
  gseStepCount++;
  const row = document.createElement('div');
  row.className = 'ticket-item';
  row.innerHTML = `
    <div class=&quot;ticket-head&quot;>
      <span class=&quot;ticket-type sub&quot;>手順 ${gseStepCount}</span>
      <button class=&quot;btn-mini&quot; onclick=&quot;this.closest('.ticket-item').remove()&quot; style=&quot;margin-left:auto&quot;>🗑</button>
    </div>
    <div class=&quot;ticket-row&quot;>
      <div><label>誰が</label><input type=&quot;text&quot; class=&quot;gse-actor&quot; value=&quot;${actor.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;例：担当者&quot;></div>
      <div style=&quot;grid-column:span 1&quot;><label>何をする</label><input type=&quot;text&quot; class=&quot;gse-action&quot; value=&quot;${action.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;例：対象アカウントを無効化&quot;></div>
      <div><label>証跡</label><input type=&quot;text&quot; class=&quot;gse-evidence&quot; value=&quot;${evidence.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;例：操作ログ&quot;></div>
    </div>`;
  gseSteps.appendChild(row);
}
document.getElementById('g_se_addstep').addEventListener('click', () => addGseStep());
document.getElementById('g_se_clearstep').addEventListener('click', () => { if(confirm('手順をすべて削除しますか？')){gseSteps.innerHTML='';gseStepCount=0;} });
addGseStep('担当者', '変更内容を確認し承認を得る', '承認記録');
addGseStep('担当者', '作業を実施', '操作ログ');
addGseStep('担当者', '結果を検証', '検証記録');

/* --- 業務移譲：渡す情報＋理由 --- */
const gdlInfos = document.getElementById('g_dl_infos');
let gdlInfoCount = 0;
function addGdlInfo(info='', reason=''){
  gdlInfoCount++;
  const row = document.createElement('div');
  row.className = 'ticket-item';
  row.innerHTML = `
    <div class=&quot;ticket-head&quot;>
      <span class=&quot;ticket-type story&quot;>情報 ${gdlInfoCount}</span>
      <button class=&quot;btn-mini&quot; onclick=&quot;this.closest('.ticket-item').remove()&quot; style=&quot;margin-left:auto&quot;>🗑</button>
    </div>
    <div class=&quot;ticket-row&quot;>
      <div style=&quot;grid-column:span 1&quot;><label>📦 渡す情報</label><input type=&quot;text&quot; class=&quot;gdl-info&quot; value=&quot;${info.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;例：受講生の島分け表&quot;></div>
      <div style=&quot;grid-column:span 2&quot;><label>💡 なぜ渡すか（理由）</label><input type=&quot;text&quot; class=&quot;gdl-reason&quot; value=&quot;${reason.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;例：誰が支援を要するか事前に把握して動けるように&quot;></div>
    </div>`;
  gdlInfos.appendChild(row);
}
document.getElementById('g_dl_addinfo').addEventListener('click', () => addGdlInfo());
document.getElementById('g_dl_clearinfo').addEventListener('click', () => { if(confirm('情報をすべて削除しますか？')){gdlInfos.innerHTML='';gdlInfoCount=0;} });
addGdlInfo('受講生の島分け表', '誰が支援を要するか事前に把握して動けるように');
addGdlInfo('演習の想定つまずきポイント', '先回りしてヒントを準備できるように');
(function(){ const el = document.getElementById('g_dl_date'); if (el &amp;&amp; !el.value) el.value = todayStr; })();

/* --- 生成 --- */
document.getElementById('g_gen-btn').addEventListener('click', () => {
  const v = id => (document.getElementById(id)?.value || '').trim();
  const meta = GROW_MODE_META[growMode];
  const docno = v('g_docno'), rev = v('g_rev');
  const conf = document.getElementById('g_conf').value;
  const relate = v('g_relate');
  let titleLine, body, isoAuthor = '', isoChecker = '', isoDate = todayStr;

  if (growMode === 'mentor') {
    const mentor = v('g_mt_mentor') || '未設定';
    const mentee = v('g_mt_mentee') || '未設定';
    isoAuthor = mentor; isoChecker = mentee;
    const steps = [...gmtSteps.querySelectorAll('.ticket-item')].map((r,i) => {
      const period = r.querySelector('.gmt-period').value.trim();
      const goal = r.querySelector('.gmt-goal').value.trim();
      const method = r.querySelector('.gmt-method').value.trim();
      if (!period &amp;&amp; !goal) return null;
      return `| ${i+1} | ${period || '—'} | ${goal || '—'} | ${method || '—'} |`;
    }).filter(Boolean).join('\n');
    titleLine = `# 👩‍🏫 育成計画：${mentee}`;
    body = `## 📨 基本情報

| 項目 | 内容 |
|------|------|
| メンター | ${mentor} |
| メンティー | ${mentee} |
| 育成期間 | ${v('g_mt_period') || '—'} |

---

## ① 現状把握（3信号評価）

| スキル領域 | 評価 |
|-----------|------|
| 📝 知識・基礎 | ${document.getElementById('g_mt_skill_w').value} |
| 🛠 実務・実装 | ${document.getElementById('g_mt_skill_p').value} |
| 🗣 説明・報連相 | ${document.getElementById('g_mt_skill_o').value} |

**👀 現状の事実：**

${v('g_mt_fact') || '_（未記入）_'}

**💭 所感（推測・方針仮説）：**

${v('g_mt_impression') || '_（未記入）_'}

---

## ② 育成ゴール

${v('g_mt_goal') || '_（未記入）_'}

---

## ③ 育成ステップ

| # | 時期 | 到達目標 | 育成方法 |
|---|------|----------|----------|
${steps || '|  |  |  |  |'}

---

## ④ 支援設計・関わり方

**🤝 メンターの関わり方：**

${v('g_mt_support') || '_（未記入）_'}

**⚠️ 気を付けること：**

${v('g_mt_caution') || '_（未記入）_'}

---

> 🐰 育成の鉄則：答えでなくヒントを。できた事実を承認し、過干渉で自走の芽を摘まない。`;

  } else if (growMode === 'mentee') {
    const self = v('g_me_self') || '未設定';
    isoAuthor = self; isoChecker = v('g_me_mentor');
    titleLine = `# 🌱 成長記録：${v('g_me_period') || '記録'}`;
    body = `## 📨 基本情報

| 項目 | 内容 |
|------|------|
| 記入者 | ${self} |
| メンター | ${v('g_me_mentor') || '—'} |
| 対象期間 | ${v('g_me_period') || '—'} |

---

## ① 学んだこと・できるようになったこと

**📚 学んだこと：**

${v('g_me_learned') || '_（未記入）_'}

**✅ できるようになったこと：**

${v('g_me_can') || '_（未記入）_'}

---

## ② つまずき・課題

**🤔 つまずいたこと：**

${v('g_me_stuck') || '_（未記入）_'}

**💡 乗り越え方：**

${v('g_me_overcome') || '_（未記入）_'}

---

## ③ 次の目標・相談

**🎯 次の目標：**

${v('g_me_next') || '_（未記入）_'}

**🙋 相談したいこと：**

${v('g_me_consult') || '_（未記入）_'}

${v('g_me_mood') ? `> 😊 ${v('g_me_mood')}` : ''}

---

> 🐰 小さな「できた」の積み重ねが自走への道。記録は未来の自分への財産です。`;

  } else if (growMode === 'se') {
    const type = document.getElementById('g_se_type').value;
    const author = v('g_se_author') || '未設定';
    const approver = v('g_se_approver');
    isoAuthor = author; isoChecker = approver;
    isoDate = v('g_se_date') || todayStr;
    const steps = [...gseSteps.querySelectorAll('.ticket-item')].map((r,i) => {
      const actor = r.querySelector('.gse-actor').value.trim();
      const action = r.querySelector('.gse-action').value.trim();
      const ev = r.querySelector('.gse-evidence').value.trim();
      if (!action) return null;
      return `| ${i+1} | ${actor || '—'} | ${action} | ${ev || '—'} | ☐ |`;
    }).filter(Boolean).join('\n');
    titleLine = `# 🏢 ISO式業務記録【${type}】：${v('g_se_system') || '対象システム'}`;
    body = `## 📨 業務記録 基本情報

| 項目 | 内容 |
|------|------|
| 業務種別 | ${type} |
| 対象システム | ${v('g_se_system') || '—'} |
| 担当者 | ${author} |
| 承認者 | ${approver || '—'} |
| 実施日 | ${isoDate} |
| リスクレベル | ${document.getElementById('g_se_risk').value} |

---

## ① 目的・背景（ISO 9001：要求事項）

**🎯 目的・要求事項：**

${v('g_se_purpose') || '_（未記入）_'}

**📋 背景・トリガー：**

${v('g_se_background') || '_（未記入）_'}

---

## ② 実施手順（トレーサビリティ）

| # | 誰が | 何をする | 証跡 | 完了 |
|---|------|----------|------|------|
${steps || '|  |  |  |  | ☐ |'}

---

## ③ リスク・セキュリティ（ISO/IEC 27001）

**⚠️ 想定リスク・影響範囲：**

${v('g_se_risk_detail') || '_（未記入）_'}

**🔒 セキュリティ・コンプライアンス確認：**

${v('g_se_security') || '_（未記入）_'}

**🔁 ロールバック手順：**

${v('g_se_rollback') || '_（未記入）_'}

---

## ④ 完了確認・是正処置

**✅ 完了条件・検証結果：**

${v('g_se_verify') || '_（未記入）_'}

**📊 是正・予防処置（再発防止）：**

${v('g_se_capa') || '_（未記入）_'}

---

## ✍️ 承認記録

| 区分 | 氏名 | 日付 |
|------|------|------|
| 実施 | ${author} | ${isoDate} |
| 承認 | ${approver || ''} |  |

---

> 🐰 ISO式の鉄則：誰が・いつ・何を・なぜを残す。証跡（ログ）を確保し、是正処置で再発を防ぐ。`;
  } else { // delegate
    const giver = v('g_dl_giver') || '未設定';
    const to = v('g_dl_to') || '未設定';
    isoAuthor = giver; isoChecker = to;
    isoDate = v('g_dl_date') || todayStr;
    const infos = [...gdlInfos.querySelectorAll('.ticket-item')].map((r,i) => {
      const info = r.querySelector('.gdl-info').value.trim();
      if (!info) return null;
      const reason = r.querySelector('.gdl-reason').value.trim();
      return `| ${i+1} | ${info} | ${reason || '—'} |`;
    }).filter(Boolean).join('\n');
    const understand = document.getElementById('g_dl_understand').value;
    const agree = document.getElementById('g_dl_agree').value;
    const follow = document.getElementById('g_dl_follow').value;
    // フォロー要否の自動アドバイス
    let followAdvice = '';
    if (understand.startsWith('🔴') || agree.startsWith('🔴')) {
      followAdvice = '> ⚠️ **理解度または納得度が低い状態です。** 渡す前にもう一度すり合わせるか、密着フォローを推奨します。納得しないまま進むと手戻りや離脱のリスクがあります。';
    } else if (understand.startsWith('🟡') || agree.startsWith('🟡')) {
      followAdvice = '> 💡 **やや不安が残る状態です。** 要所での軽めフォローを入れ、序盤に一度様子を見ると安心です。';
    } else {
      followAdvice = '> ✅ **理解・納得ともに良好です。** 任せきりにして、完了時の振り返りに集中できます。自走を尊重しましょう。';
    }
    titleLine = `# 📤 業務移譲＆フォロー設計：${v('g_dl_task') || 'タスク'}`;
    body = `## 📨 基本情報

| 項目 | 内容 |
|------|------|
| 渡す人（メンター） | ${giver} |
| 渡す相手 | ${to} |
| 移譲日 | ${isoDate} |
| 渡す仕事 | ${v('g_dl_task') || '—'} |

---

## ① なぜこの人に渡すのか

**🎯 選んだ理由：**

${v('g_dl_why') || '_（未記入）_'}

**🌱 得てほしい成長・経験：**

${v('g_dl_growth') || '_（未記入）_'}

---

## ② 渡す情報（情報＋なぜ渡すか）

| # | 渡す情報 | なぜ渡すか（理由） |
|---|----------|---------------------|
${infos || '|  |  |  |'}

> 🐰 情報には必ず「なぜ」を添える。理由が分かると相手は自分で判断できるようになります。

---

## ③ ゴールと任せる範囲

**🎯 ゴール：**

${v('g_dl_goal') || '_（未記入）_'}

**🤲 任せる範囲・判断してよいこと：**

${v('g_dl_scope') || '_（未記入）_'}

---

## ④ 納得確認

| 項目 | 状態 |
|------|------|
| 🤝 相手の理解度 | ${understand} |
| 💚 相手の納得度 | ${agree} |

**💬 相手からの反応・質問・懸念：**

${v('g_dl_response') || '_（未記入）_'}

**📝 渡した補足・回答：**

${v('g_dl_reply') || '_（未記入）_'}

---

## ⑤ フォロー要否の判断

| 項目 | 内容 |
|------|------|
| 🚦 フォロー方針 | ${follow} |
| ⏰ タイミング・頻度 | ${v('g_dl_follow_when') || '—'} |
| 🤝 完了後の振り返り | ${v('g_dl_retro') || '—'} |

**👀 観察ポイント：**

${v('g_dl_watch') || '_（未記入）_'}

**🆘 介入トリガー（こうなったら入る）：**

${v('g_dl_trigger') || '_（未記入）_'}

${followAdvice}

---

> 🐰 移譲の鉄則：丸投げでも抱え込みでもなく、「なぜ」を添えて納得して渡す。フォロー要否を最初に決めて、放置も過干渉も避ける。`;
  }

  const md = `${audTone()}

${titleLine}

${isoSection(docno, rev, conf, relate, isoAuthor || '未設定', isoChecker || '', '', isoDate)}

---

${buildPrinciplesMarkdown()}

---

${body}

---

> 🐰 *Generated by うさうさ式 IT現場ジェネレーター v2 ─ ${meta.icon} ${meta.name}*`;

  document.getElementById('g_output').textContent = md;
  document.getElementById('g_output-card').style.display = 'block';
  document.getElementById('g_output-card').scrollIntoView({behavior:'smooth', block:'nearest'});
});

document.getElementById('g_copy-btn').addEventListener('click', () => {
  copyTo('g_output', 'g_copy-btn');
});

/* ===================================================== */
/* ============== タブ13：README風 生成 =============== */
/* ===================================================== */
let readmeMode = 'tool'; // tool / material / project

document.querySelectorAll('.pattern-card[data-rmode]').forEach(p => {
  p.addEventListener('click', () => {
    document.querySelectorAll('.pattern-card[data-rmode]').forEach(x => x.classList.remove('active'));
    p.classList.add('active');
    readmeMode = p.dataset.rmode;
  });
});

document.getElementById('rm_gen-btn').addEventListener('click', () => {
  const v = id => document.getElementById(id).value.trim();
  const name = v('rm_name') || '無題のREADME';
  const cat = v('rm_catch');
  const ver = v('rm_ver');
  const license = document.getElementById('rm_license').value;
  const why = v('rm_why');
  const whatRaw = v('rm_what');
  const howRaw = v('rm_how');
  const env = v('rm_env');
  const note = v('rm_note');
  const author = v('rm_author');

  // WHAT：1行=1項目の箇条書き（先頭の - は重複させない）
  const whatList = whatRaw
    ? whatRaw.split('\n').map(l => l.trim()).filter(Boolean)
        .map(l => l.replace(/^[-・*]\s*/, '')).map(l => `- ${l}`).join('\n')
    : '- （内容を記入してください）';

  // HOW：1行=1ステップの番号付きリスト
  const howList = howRaw
    ? howRaw.split('\n').map(l => l.trim()).filter(Boolean)
        .map(l => l.replace(/^\d+[\.\)]\s*/, ''))
        .map((l, i) => `${i + 1}. ${l}`).join('\n')
    : '1. （手順を記入してください）';

  // モード別のセクション見出し
  const META = {
    tool:     { icon: '🛠', why: '概要',         what: '主な機能',   how: '使い方',   extra: '動作環境' },
    material: { icon: '📚', why: 'この教材について', what: '学べること', how: '進め方',   extra: '対象者・前提' },
    project:  { icon: '📦', why: 'プロジェクト概要', what: '機能',       how: 'セットアップと使い方', extra: '動作環境' }
  };
  const m = META[readmeMode];

  const titleLine = `# ${m.icon} ${name}`;
  const catchLine = cat ? `\n> ${cat}\n` : '';
  const verLine = ver ? `\n\`${ver}\`${license ? ` ・ ${license}` : ''}\n` : '';

  const envSection = env
    ? `\n## ${readmeMode === 'material' ? '🎯' : '💻'} ${m.extra}\n\n${env.split('\n').map(l => l.trim()).filter(Boolean).map(l => `- ${l.replace(/^[-・*]\s*/, '')}`).join('\n')}\n`
    : '';

  const noteSection = note
    ? `\n## ⚠️ 注意点・制限\n\n${note.split('\n').map(l => l.trim()).filter(Boolean).map(l => `- ${l.replace(/^[-・*]\s*/, '')}`).join('\n')}\n`
    : '';

  const licenseSection = license &amp;&amp; license !== '記載なし'
    ? `\n## 📄 ライセンス\n\n${license}\n`
    : '';

  const authorLine = author ? `\n---\n\n> 🐰 **${author}**　\`面白きこともなき世を面白く\`` : `\n---\n\n> 🐰 \`面白きこともなき世を面白く\``;

  const md = `${audTone()}

${titleLine}
${catchLine}${verLine}
## 📌 ${m.why}

${why || '（背景・目的を記入してください）'}

## ✨ ${m.what}

${whatList}

## 🚀 ${m.how}

${howList}
${envSection}${noteSection}${licenseSection}${authorLine}`;

  document.getElementById('rm_output').textContent = md;
  document.getElementById('rm_output-card').style.display = 'block';
  copyTo('rm_output', 'rm_copy-btn');
});

</script>

</html>"></iframe>
    <iframe id="frm-quiz" title="作問スタジオ" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>🐰 うさうさ作問スタジオ / Usausa Quiz Studio</title>
<style>
  :root{
    --mono:&quot;SFMono-Regular&quot;,Consolas,&quot;Liberation Mono&quot;,Menlo,monospace;
    --sans:&quot;Hiragino Kaku Gothic ProN&quot;,&quot;Yu Gothic&quot;,Meiryo,system-ui,sans-serif;
    --serif:Georgia,&quot;Times New Roman&quot;,serif;
  }
  /* ===== 日本語テーマ：ジャパンブルー（水色ペール＋濃い青ベース） ===== */
  body.theme-ja{
    --brand:#15568a; --brand-d:#0e3c63; --accent:#5fa8d3; --accent-t:#0c2f50;
    --bg-1:#f3f8fc; --bg-2:#e3eef7; --card:#ffffff;
    --ink:#15293c; --ink-2:#5f7589; --line:#dde8f2; --line-2:#c4d6e6;
    --ok:#2f8b6c; --ok-bg:#e7f5ef; --ng:#d05a52; --ng-bg:#fbe9e7;
    --info:#15568a; --info-bg:#e3eef7;
    --pageglow-1:#e2eef8; --pageglow-2:#d4e6f4;
    --shadow:rgba(21,86,138,.20); --shadow-soft:rgba(21,86,138,.10);
    --display:var(--sans);
  }
  /* ===== 英語テーマ：イギリス国旗風ペール ===== */
  body.theme-en{
    --brand:#4a5f86; --brand-d:#36486b; --accent:#b56576; --accent-t:#5a2733;
    --bg-1:#f7f4ef; --bg-2:#eceef4; --card:#ffffff;
    --ink:#2c3242; --ink-2:#7c8295; --line:#e6e3da; --line-2:#cfd6e3;
    --ok:#4f8a78; --ok-bg:#e8f1ed; --ng:#b56576; --ng-bg:#f5e7ea;
    --info:#4a5f86; --info-bg:#e8ecf4;
    --pageglow-1:#e6ebf5; --pageglow-2:#f3e6e9;
    --shadow:rgba(54,72,107,.20); --shadow-soft:rgba(54,72,107,.10);
    --display:var(--serif);
  }

  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:var(--sans);color:var(--ink);line-height:1.6;min-height:100vh;
    background:
      radial-gradient(1200px 420px at 90% -5%, var(--pageglow-1) 0%, transparent 60%),
      radial-gradient(900px 380px at -5% 110%, var(--pageglow-2) 0%, transparent 55%),
      var(--bg-1);
    transition:background .3s;}
  .app{max-width:1280px;margin:0 auto;padding:18px 18px 60px;}

  /* theme ribbon */
  .ribbon{height:6px;border-radius:6px;margin-bottom:14px;}
  body.theme-ja .ribbon{background:linear-gradient(90deg,var(--accent),var(--brand),var(--brand-d));}
  body.theme-en .ribbon{background:linear-gradient(90deg,#36486b 0 33%,#f7f4ef 33% 66%,#b56576 66% 100%);}

  header.hd{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:14px;}
  .logo{font-size:30px;}
  /* ===== ユニオンジャック紋章（英語モードのみ・ペール） ===== */
  .ujack{display:none;width:46px;height:28px;border-radius:3px;flex:none;vertical-align:middle;opacity:.92;
    border:1px solid var(--line-2);box-shadow:0 2px 8px var(--shadow-soft);
    --ub:#5a6e95;--uw:#f4efe6;--ur:#bf8794;
    background:
      linear-gradient(var(--ur) 0 0) center/5px 100% no-repeat,
      linear-gradient(var(--ur) 0 0) center/100% 5px no-repeat,
      linear-gradient(var(--uw) 0 0) center/10px 100% no-repeat,
      linear-gradient(var(--uw) 0 0) center/100% 10px no-repeat,
      linear-gradient(to bottom right,#0000 calc(50% - 1.6px),var(--ur) calc(50% - 1.6px),var(--ur) calc(50% + 1.6px),#0000 calc(50% + 1.6px)),
      linear-gradient(to bottom left,#0000 calc(50% - 1.6px),var(--ur) calc(50% - 1.6px),var(--ur) calc(50% + 1.6px),#0000 calc(50% + 1.6px)),
      linear-gradient(to bottom right,#0000 calc(50% - 3.6px),var(--uw) calc(50% - 3.6px),var(--uw) calc(50% + 3.6px),#0000 calc(50% + 3.6px)),
      linear-gradient(to bottom left,#0000 calc(50% - 3.6px),var(--uw) calc(50% - 3.6px),var(--uw) calc(50% + 3.6px),#0000 calc(50% + 3.6px)),
      var(--ub);}
  body.theme-en .ujack{display:inline-block;}
  .foot .ujack{width:36px;height:22px;margin:0 7px;vertical-align:-5px;}
  .umemon{display:none;width:46px;height:28px;border-radius:3px;flex:none;vertical-align:middle;opacity:.95;
    border:1px solid var(--line-2);box-shadow:0 2px 8px var(--shadow-soft);
    background:url(&quot;data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2722%27%20height%3D%2722%27%20viewBox%3D%270%200%2024%2024%27%3E%3Cg%20fill%3D%27%23ffffff%27%3E%3Ccircle%20cx%3D%2712%27%20cy%3D%277%27%20r%3D%273.7%27%2F%3E%3Ccircle%20cx%3D%2716.76%27%20cy%3D%2710.45%27%20r%3D%273.7%27%2F%3E%3Ccircle%20cx%3D%2714.94%27%20cy%3D%2716.05%27%20r%3D%273.7%27%2F%3E%3Ccircle%20cx%3D%279.06%27%20cy%3D%2716.05%27%20r%3D%273.7%27%2F%3E%3Ccircle%20cx%3D%277.24%27%20cy%3D%2710.45%27%20r%3D%273.7%27%2F%3E%3Ccircle%20cx%3D%2712%27%20cy%3D%2712%27%20r%3D%273%27%2F%3E%3C%2Fg%3E%3Cg%20stroke%3D%27%2315568a%27%20stroke-width%3D%270.7%27%20stroke-linecap%3D%27round%27%3E%3Cline%20x1%3D%2712%27%20y1%3D%2712%27%20x2%3D%2712%27%20y2%3D%279%27%2F%3E%3Cline%20x1%3D%2712%27%20y1%3D%2712%27%20x2%3D%2714.85%27%20y2%3D%2711.07%27%2F%3E%3Cline%20x1%3D%2712%27%20y1%3D%2712%27%20x2%3D%2713.76%27%20y2%3D%2714.43%27%2F%3E%3Cline%20x1%3D%2712%27%20y1%3D%2712%27%20x2%3D%2710.24%27%20y2%3D%2714.43%27%2F%3E%3Cline%20x1%3D%2712%27%20y1%3D%2712%27%20x2%3D%279.15%27%20y2%3D%2711.07%27%2F%3E%3C%2Fg%3E%3Ccircle%20cx%3D%2712%27%20cy%3D%2712%27%20r%3D%271%27%20fill%3D%27%2315568a%27%2F%3E%3C%2Fsvg%3E&quot;) 0 0/20px 20px repeat,#15568a;}
  body.theme-ja .umemon{display:inline-block;}
  .foot .umemon{width:36px;height:22px;margin:0 7px;vertical-align:-5px;}
  .ttl h1{font-size:20px;font-weight:800;letter-spacing:.01em;font-family:var(--display);}
  .ttl p{font-size:12px;color:var(--ink-2);margin-top:1px;}

  /* language toggle */
  .lang{margin-left:auto;display:inline-flex;border-radius:12px;overflow:hidden;border:1px solid var(--line-2);
    box-shadow:0 4px 14px var(--shadow-soft);background:var(--card);}
  .lang button{appearance:none;border:0;background:transparent;font-family:var(--sans);font-size:13px;font-weight:800;
    padding:9px 16px;cursor:pointer;color:var(--ink-2);display:flex;align-items:center;gap:7px;transition:.15s;}
  .lang button.on{background:linear-gradient(180deg,var(--brand),var(--brand-d));color:#fff;}

  .course{display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line-2);
    border-radius:12px;padding:7px 13px;box-shadow:0 4px 14px var(--shadow-soft);width:100%;max-width:430px;}
  .course label{font-size:11px;color:var(--ink-2);white-space:nowrap;}
  .course input{border:0;font-size:14px;font-weight:700;color:var(--ink);background:transparent;flex:1;font-family:var(--sans);}
  .course input:focus{outline:none;}

  /* tabs */
  .tabs{display:flex;gap:8px;margin:14px 0;flex-wrap:wrap;}
  .tab{appearance:none;border:1px solid var(--line-2);background:var(--card);color:var(--ink-2);
    font-family:var(--sans);font-size:13px;font-weight:800;padding:10px 18px;border-radius:12px;cursor:pointer;
    display:flex;align-items:center;gap:7px;transition:.15s;box-shadow:0 3px 9px var(--shadow-soft);}
  .tab:hover{transform:translateY(-1px);box-shadow:0 6px 14px var(--shadow-soft);}
  .tab.on{background:linear-gradient(180deg,var(--brand),var(--brand-d));color:#fff;border-color:var(--brand-d);
    box-shadow:0 6px 18px var(--shadow);}
  .tab .badge{background:rgba(255,255,255,.32);border-radius:8px;padding:0 8px;font-size:11px;}
  .tab:not(.on) .badge{background:var(--bg-2);}

  .pane{display:none;}
  .pane.on{display:block;}
  .grid{display:grid;grid-template-columns:1fr;gap:16px;}
  @media(min-width:980px){.grid{grid-template-columns:minmax(380px,520px) 1fr;}}

  .panel{background:var(--card);border:1px solid var(--line);border-radius:16px;
    box-shadow:0 8px 30px var(--shadow-soft);overflow:hidden;}
  .panel-hd{padding:13px 16px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px;flex-wrap:wrap;
    background:linear-gradient(180deg,#ffffff, color-mix(in srgb,var(--bg-2) 55%,#fff));}
  .panel-hd h2{font-size:14px;font-weight:800;font-family:var(--display);}
  .panel-hd .sub{font-size:11px;color:var(--ink-2);}
  .panel-bd{padding:15px 16px;}

  /* ===== buttons with depth/shadow ===== */
  .toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:11px;}
  .btn{appearance:none;font-family:var(--sans);font-size:12px;font-weight:800;cursor:pointer;border-radius:11px;
    padding:9px 14px;border:1px solid var(--line-2);background:var(--card);color:var(--ink);
    display:inline-flex;align-items:center;gap:6px;transition:.13s;
    box-shadow:0 3px 0 var(--line-2), 0 6px 14px var(--shadow-soft);}
  .btn:hover{transform:translateY(-1px);box-shadow:0 4px 0 var(--line-2), 0 9px 18px var(--shadow-soft);}
  .btn:focus-visible{outline:none;box-shadow:0 3px 0 var(--line-2), 0 0 0 3px var(--shadow);}
  /* ▼ 押した瞬間がはっきり分かる：段差がつぶれて沈み込み＋押下グロー */
  .btn:active{transform:translateY(4px) scale(.97);filter:brightness(.93);
    box-shadow:0 0 0 var(--line-2), inset 0 3px 7px var(--shadow), 0 1px 3px var(--shadow-soft) !important;}
  .btn.pri{background:linear-gradient(180deg,var(--brand),var(--brand-d));color:#fff;border-color:var(--brand-d);
    box-shadow:0 4px 0 var(--brand-d), 0 8px 18px var(--shadow);}
  .btn.pri:hover{box-shadow:0 5px 0 var(--brand-d), 0 12px 22px var(--shadow);}
  .btn.pri:active{transform:translateY(4px) scale(.97);filter:brightness(.9);
    box-shadow:inset 0 3px 8px rgba(0,0,0,.28), 0 1px 3px var(--shadow) !important;}
  .btn.gold{background:linear-gradient(180deg,var(--accent),color-mix(in srgb,var(--accent) 80%,#000));
    color:var(--accent-t);border-color:var(--accent);
    box-shadow:0 4px 0 color-mix(in srgb,var(--accent) 70%,#000), 0 8px 18px var(--shadow);}
  .btn.gold:active{transform:translateY(4px) scale(.97);filter:brightness(.9);
    box-shadow:inset 0 3px 8px rgba(0,0,0,.2), 0 1px 3px var(--shadow) !important;}

  .fmt-row{display:flex;gap:6px;align-items:center;margin-bottom:9px;flex-wrap:wrap;}
  .fmt-row .lbl{font-size:11px;color:var(--ink-2);}
  .seg{display:inline-flex;border:1px solid var(--line-2);border-radius:10px;overflow:hidden;box-shadow:0 3px 9px var(--shadow-soft);}
  .seg button{appearance:none;border:0;background:var(--card);font-family:var(--sans);font-size:11px;font-weight:800;
    padding:6px 12px;cursor:pointer;color:var(--ink-2);}
  .seg button.on{background:var(--info-bg);color:var(--info);}
  .seg button:active{filter:brightness(.9);transform:translateY(1px);}

  /* ▼ クラス（基礎／応用）絞り込みバー */
  .class-bar{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-bottom:10px;}
  .class-bar.hidden{display:none;}
  .class-bar .cl-lbl{font-size:11px;font-weight:800;color:var(--ink-2);}
  .cl-chip{appearance:none;font-family:var(--sans);font-size:12px;font-weight:800;cursor:pointer;border-radius:20px;
    padding:6px 14px;border:1.5px solid var(--line-2);background:var(--card);color:var(--ink-2);
    box-shadow:0 3px 0 var(--line-2),0 5px 12px var(--shadow-soft);transition:.13s;}
  .cl-chip:hover{transform:translateY(-1px);}
  .cl-chip:active{transform:translateY(3px) scale(.97);filter:brightness(.93);box-shadow:inset 0 2px 6px var(--shadow);}
  .cl-chip.on{background:linear-gradient(180deg,var(--brand),var(--brand-d));color:#fff;border-color:var(--brand-d);
    box-shadow:0 4px 0 var(--brand-d),0 7px 16px var(--shadow);}
  .cl-chip .n{opacity:.75;font-weight:700;margin-left:4px;}

  /* ▼ 入力（インポート）ゾーン：枠線＋影でひと目で分かるように */  .input-zone{border:2px solid var(--brand);border-radius:14px;background:var(--card);
    box-shadow:0 8px 26px var(--shadow), inset 0 1px 0 #fff;overflow:hidden;transition:.15s;}
  .input-zone:focus-within{box-shadow:0 0 0 4px var(--shadow), 0 10px 30px var(--shadow);}
  .iz-label{display:flex;align-items:center;gap:8px;padding:9px 13px;font-size:12px;font-weight:800;color:#fff;
    background:linear-gradient(180deg,var(--brand),var(--brand-d));border-bottom:2px solid var(--brand-d);}
  .iz-label .dot{width:9px;height:9px;border-radius:50%;background:#fff;box-shadow:0 0 0 3px rgba(255,255,255,.35);}
  textarea#src{width:100%;min-height:430px;resize:vertical;border:0;border-radius:0;display:block;
    padding:13px 14px;font-family:var(--mono);font-size:13px;line-height:1.7;color:var(--ink);
    background:color-mix(in srgb,var(--bg-1) 55%,#fff);tab-size:2;}
  textarea#src:focus{outline:none;}
  textarea#src::placeholder{color:var(--ink-2);opacity:.8;}

  .status{margin-top:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
  .pill{border-radius:20px;padding:4px 12px;font-weight:800;font-size:11px;box-shadow:0 3px 9px var(--shadow-soft);}
  .pill.ok{background:var(--ok-bg);color:var(--ok);}
  .pill.warn{background:#fdf3df;color:#9a6a00;}
  .pill.err{background:var(--ng-bg);color:var(--ng);}
  .status .msg{color:var(--ink-2);font-size:11px;}

  details.cheat{margin-bottom:11px;border:1px dashed var(--line-2);border-radius:12px;
    background:color-mix(in srgb,var(--bg-1) 60%,#fff);}
  details.cheat>summary{cursor:pointer;list-style:none;padding:10px 13px;font-size:12px;font-weight:800;color:var(--info);}
  details.cheat>summary::-webkit-details-marker{display:none;}
  details.cheat>summary::before{content:&quot;▶ &quot;;font-size:9px;}
  details.cheat[open]>summary::before{content:&quot;▼ &quot;;}
  .cheat-bd{padding:0 14px 14px;font-size:12px;color:var(--ink);}
  .cheat-bd pre{background:var(--bg-2);border:1px solid var(--line);border-radius:9px;padding:10px 12px;
    font-family:var(--mono);font-size:11.5px;line-height:1.65;overflow-x:auto;white-space:pre;margin:6px 0;}
  .cheat-bd code{background:var(--bg-2);border:1px solid var(--line);border-radius:5px;padding:1px 5px;font-family:var(--mono);font-size:11px;}
  .cheat-bd table{border-collapse:collapse;width:100%;font-size:11.5px;margin:6px 0;}
  .cheat-bd th,.cheat-bd td{border:1px solid var(--line);padding:5px 8px;text-align:left;}
  .cheat-bd th{background:var(--bg-2);}

  .preview-wrap{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--bg-1);min-height:520px;
    box-shadow:inset 0 2px 8px var(--shadow-soft);}
  iframe.pv{width:100%;height:78vh;min-height:520px;border:0;display:block;background:transparent;}
  .empty{padding:60px 20px;text-align:center;color:var(--ink-2);}
  .empty .e-emoji{font-size:42px;}
  .hint{font-size:11px;color:var(--ink-2);margin-top:9px;}
  .hidden{display:none !important;}
  .foot{margin-top:18px;text-align:center;font-size:11px;color:var(--ink-2);}

  /* ===== how-to pane ===== */
  .howto{max-width:980px;}
  .steps{display:grid;grid-template-columns:1fr;gap:14px;margin-bottom:8px;}
  @media(min-width:720px){.steps{grid-template-columns:1fr 1fr;}}
  .step{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 17px;
    box-shadow:0 6px 20px var(--shadow-soft);position:relative;overflow:hidden;}
  .step::before{content:attr(data-n);position:absolute;top:-14px;right:-6px;font-size:74px;font-weight:900;
    font-family:var(--display);color:var(--bg-2);line-height:1;}
  .step .sh{display:flex;align-items:center;gap:9px;margin-bottom:7px;position:relative;}
  .step .si{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;
    background:linear-gradient(180deg,var(--brand),var(--brand-d));color:#fff;box-shadow:0 4px 10px var(--shadow);}
  .step h3{font-size:14px;font-weight:800;position:relative;}
  .step p{font-size:12.5px;color:var(--ink-2);position:relative;line-height:1.75;}
  .step code{background:var(--bg-2);border:1px solid var(--line);border-radius:5px;padding:1px 5px;font-family:var(--mono);font-size:11px;color:var(--info);}
  .note{background:var(--info-bg);border:1px solid var(--line-2);border-radius:13px;padding:14px 16px;font-size:12.5px;
    color:var(--ink);line-height:1.85;box-shadow:0 5px 16px var(--shadow-soft);}
  .note h4{font-size:13px;font-weight:800;color:var(--info);margin-bottom:5px;}
  .note code{background:var(--card);border:1px solid var(--line);border-radius:5px;padding:1px 5px;font-family:var(--mono);font-size:11px;}
  .howto h2.sec{font-size:15px;font-weight:800;margin:20px 0 10px;font-family:var(--display);}

  /* ===== スマホ最適化（〜600px） ===== */
  @media(max-width:600px){
    .app{padding:12px 12px 48px;}
    .ribbon{margin-bottom:10px;}
    header.hd{gap:10px;}
    .logo{font-size:26px;}
    .ttl h1{font-size:17px;}
    .ttl p{font-size:11px;}
    .lang{width:100%;margin-left:0;}
    .lang button{flex:1;justify-content:center;padding:10px 12px;}
    .course{max-width:none;}
    .tabs{gap:6px;}
    .tab{flex:1;justify-content:center;padding:11px 8px;font-size:12px;}
    .tab .badge{display:none;}
    .panel-bd{padding:12px 12px;}
    .panel-hd{padding:11px 12px;}
    .toolbar{gap:7px;}
    .btn{font-size:12px;padding:10px 12px;flex:1 1 calc(50% - 4px);justify-content:center;}
    .btn.pri,.btn.gold{flex-basis:100%;}
    .seg{width:100%;}
    .seg button{flex:1;text-align:center;padding:9px 6px;}
    textarea#src{min-height:300px;font-size:14px;}
    iframe.pv{height:68vh;min-height:380px;}
    #pv2{height:72vh !important;}
    .cl-chip{flex:1 1 calc(50% - 5px);text-align:center;}
    .step::before{font-size:58px;}
    .foot{font-size:10px;}
  }
  /* タップ操作の最適化（PC/スマホ共通） */
  button,.opt,.tab,.cl-chip{touch-action:manipulation;-webkit-tap-highlight-color:transparent;}

.lang-switch{display:none !important;}
</style>
</head>
<body class=&quot;theme-ja&quot;>
<div class=&quot;app&quot;>
  <div class=&quot;ribbon&quot;></div>

  <header class=&quot;hd&quot;>
    <div class=&quot;logo&quot;>🐰</div>
    <span class=&quot;ujack&quot; aria-hidden=&quot;true&quot; title=&quot;English mode&quot;></span>
    <span class=&quot;umemon&quot; aria-hidden=&quot;true&quot; title=&quot;日本語モード&quot;></span>
    <div class=&quot;ttl&quot;>
      <h1 data-i18n=&quot;appTitle&quot;>うさうさ作問スタジオ</h1>
      <p data-i18n=&quot;appTag&quot;>メモ・Excelで書く → 受講生用の演習に → 配布用HTMLを書き出し</p>
    </div>
    <div class=&quot;lang&quot;>
      <button id=&quot;lng-ja&quot; class=&quot;on&quot; onclick=&quot;setLang('ja')&quot;>🇯🇵 日本語</button>
      <button id=&quot;lng-en&quot; onclick=&quot;setLang('en')&quot;>🇬🇧 English</button>
    </div>
  </header>

  <div style=&quot;margin-bottom:6px&quot;>
    <div class=&quot;course&quot;>
      <label data-i18n=&quot;courseLabel&quot;>講座名</label>
      <input id=&quot;courseTitle&quot; type=&quot;text&quot; value=&quot;LPIC-1 101 試験対策&quot;>
    </div>
  </div>

  <div class=&quot;tabs&quot;>
    <button class=&quot;tab on&quot; id=&quot;tab-edit&quot; onclick=&quot;switchTab('edit')&quot;><span>✏️</span><span data-i18n=&quot;tabEdit&quot;>作問・編集</span></button>
    <button class=&quot;tab&quot; id=&quot;tab-prev&quot; onclick=&quot;switchTab('prev')&quot;><span>📝</span><span data-i18n=&quot;tabPrev&quot;>演習プレビュー</span> <span class=&quot;badge&quot; id=&quot;qcount&quot;>0</span></button>
    <button class=&quot;tab&quot; id=&quot;tab-howto&quot; onclick=&quot;switchTab('howto')&quot;><span>📘</span><span data-i18n=&quot;tabHow&quot;>使い方</span></button>
  </div>

  <!-- ===== EDIT ===== -->
  <div class=&quot;pane on&quot; id=&quot;pane-edit&quot;>
    <div class=&quot;grid&quot;>
      <div class=&quot;panel&quot;>
        <div class=&quot;panel-hd&quot;>
          <h2 data-i18n=&quot;edTitle&quot;>📥 問題を入力</h2>
          <span class=&quot;sub&quot; data-i18n=&quot;edSub&quot;>入力すると右に即反映</span>
        </div>
        <div class=&quot;panel-bd&quot;>
          <div class=&quot;toolbar&quot;>
            <button class=&quot;btn pri&quot; onclick=&quot;loadSample()&quot;><span>📋</span><span data-i18n=&quot;bSample&quot;>サンプル読込</span></button>
            <button class=&quot;btn&quot; onclick=&quot;clearSrc()&quot;><span>🧹</span><span data-i18n=&quot;bClear&quot;>クリア</span></button>
            <button class=&quot;btn gold&quot; onclick=&quot;exportStudentHTML()&quot;><span>🎁</span><span data-i18n=&quot;bStudent&quot;>受講生用HTMLを書き出す</span></button>
            <button class=&quot;btn gold&quot; onclick=&quot;exportByClass()&quot;><span>📦</span><span data-i18n=&quot;bByClass&quot;>クラス別に一括書き出し</span></button>
            <button class=&quot;btn&quot; onclick=&quot;exportJSON()&quot;><span>💾</span><span data-i18n=&quot;bSave&quot;>JSON保存</span></button>
            <button class=&quot;btn&quot; onclick=&quot;document.getElementById('importJson').click()&quot;><span>📂</span><span data-i18n=&quot;bLoad&quot;>JSON読込</span></button>
            <button class=&quot;btn&quot; onclick=&quot;exportExcelTemplate()&quot;><span>📊</span><span data-i18n=&quot;bExcel&quot;>Excelテンプレ</span></button>
            <input type=&quot;file&quot; id=&quot;importJson&quot; accept=&quot;.json&quot; class=&quot;hidden&quot; onchange=&quot;importJSON(event)&quot;>
          </div>

          <div class=&quot;fmt-row&quot;>
            <span class=&quot;lbl&quot; data-i18n=&quot;fmtLabel&quot;>取込形式：</span>
            <span class=&quot;seg&quot;>
              <button id=&quot;f-auto&quot; class=&quot;on&quot; onclick=&quot;setFmt('auto')&quot; data-i18n=&quot;fmtAuto&quot;>自動判定</button>
              <button id=&quot;f-memo&quot; onclick=&quot;setFmt('memo')&quot; data-i18n=&quot;fmtMemo&quot;>メモ/MD</button>
              <button id=&quot;f-tsv&quot; onclick=&quot;setFmt('tsv')&quot; data-i18n=&quot;fmtTsv&quot;>Excel</button>
            </span>
            <span class=&quot;lbl&quot; id=&quot;fmt-detected&quot;></span>
          </div>

          <details class=&quot;cheat&quot;>
            <summary data-i18n=&quot;cheatSum&quot;>📖 書き方ガイド（クリックで開く）</summary>
            <div class=&quot;cheat-bd&quot; id=&quot;cheat-body&quot;></div>
          </details>

          <div class=&quot;class-bar&quot; id=&quot;class-bar&quot;></div>

          <div class=&quot;input-zone&quot;>
            <div class=&quot;iz-label&quot;><span class=&quot;dot&quot;></span><span data-i18n=&quot;izLabel&quot;>📥 ここに問題を入力／Excelからコピー＆貼り付け</span></div>
            <textarea id=&quot;src&quot; spellcheck=&quot;false&quot; data-i18n-ph=&quot;izPh&quot;></textarea>
          </div>

          <div class=&quot;status&quot;>
            <span class=&quot;pill ok&quot; id=&quot;st-pill&quot;>0</span>
            <span class=&quot;msg&quot; id=&quot;st-msg&quot;></span>
          </div>
          <p class=&quot;hint&quot; data-i18n=&quot;hintSave&quot;>💡 入力はこのブラウザに自動保存されます。保管は「JSON保存」を。</p>
        </div>
      </div>

      <div class=&quot;panel&quot;>
        <div class=&quot;panel-hd&quot;>
          <h2 data-i18n=&quot;pvTitle&quot;>👀 受講生から見える画面</h2>
          <span class=&quot;sub&quot; data-i18n=&quot;pvSub&quot;>この通りに配布されます</span>
        </div>
        <div class=&quot;panel-bd&quot;>
          <div class=&quot;preview-wrap&quot;>
            <div class=&quot;empty&quot; id=&quot;pvEmpty&quot;>
              <div class=&quot;e-emoji&quot;>🍜</div>
              <p style=&quot;margin-top:8px;font-weight:800;color:var(--ink)&quot; data-i18n=&quot;pvEmpty1&quot;>まだ問題がありません</p>
              <p data-i18n=&quot;pvEmpty2&quot;>左に入力すると、ここに演習画面が表示されます</p>
            </div>
            <iframe id=&quot;pv&quot; class=&quot;pv hidden&quot; title=&quot;preview&quot;></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== PREVIEW (large) ===== -->
  <div class=&quot;pane&quot; id=&quot;pane-prev&quot;>
    <div class=&quot;panel&quot;>
      <div class=&quot;panel-hd&quot;>
        <h2 data-i18n=&quot;pvBig&quot;>📝 演習プレビュー（受講生モード）</h2>
        <span class=&quot;sub&quot; id=&quot;prev-sub&quot;></span>
        <button class=&quot;btn gold&quot; style=&quot;margin-left:auto&quot; onclick=&quot;exportStudentHTML()&quot;><span>🎁</span><span data-i18n=&quot;bStudent2&quot;>このまま配布用に書き出す</span></button>
      </div>
      <div class=&quot;panel-bd&quot;>
        <div class=&quot;preview-wrap&quot;>
          <iframe id=&quot;pv2&quot; class=&quot;pv&quot; style=&quot;height:82vh&quot; title=&quot;preview-large&quot;></iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== HOW-TO ===== -->
  <div class=&quot;pane&quot; id=&quot;pane-howto&quot;>
    <div class=&quot;panel howto&quot;>
      <div class=&quot;panel-hd&quot;><h2 data-i18n=&quot;howTitle&quot;>📘 使い方</h2></div>
      <div class=&quot;panel-bd&quot; id=&quot;howto-body&quot;></div>
    </div>
  </div>

  <p class=&quot;foot&quot;><span class=&quot;ujack&quot; aria-hidden=&quot;true&quot;></span><span class=&quot;umemon&quot; aria-hidden=&quot;true&quot;></span><span data-i18n=&quot;foot&quot;>🐰 うさうさ先生の作問スタジオ ／ 完全オフライン・単一HTMLで動作します</span><span class=&quot;umemon&quot; aria-hidden=&quot;true&quot;></span><span class=&quot;ujack&quot; aria-hidden=&quot;true&quot;></span></p>
</div>


<!-- ===== quiz engine CSS (stored as plain text) ===== -->
<script type=&quot;text/plain&quot; id=&quot;quiz-css&quot;>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --mono:&quot;SFMono-Regular&quot;,Consolas,&quot;Liberation Mono&quot;,Menlo,monospace;
  --sans:&quot;Hiragino Kaku Gothic ProN&quot;,&quot;Yu Gothic&quot;,Meiryo,system-ui,sans-serif;
  --serif:Georgia,&quot;Times New Roman&quot;,serif;
}
body.theme-ja{
  --brand:#15568a;--brand-d:#0e3c63;--accent:#5fa8d3;
  --bg-1:#f3f8fc;--bg-2:#e3eef7;--card:#fff;
  --ink:#15293c;--ink-2:#5f7589;--line:#dde8f2;--line-2:#c4d6e6;
  --ok:#2f8b6c;--ok-bg:#e7f5ef;--ng:#d05a52;--ng-bg:#fbe9e7;
  --info:#15568a;--info-bg:#e3eef7;--shadow:rgba(21,86,138,.20);--shadow-soft:rgba(21,86,138,.10);
  --display:var(--sans);
}
body.theme-en{
  --brand:#4a5f86;--brand-d:#36486b;--accent:#b56576;
  --bg-1:#f7f4ef;--bg-2:#eceef4;--card:#fff;
  --ink:#2c3242;--ink-2:#7c8295;--line:#e6e3da;--line-2:#cfd6e3;
  --ok:#4f8a78;--ok-bg:#e8f1ed;--ng:#b56576;--ng-bg:#f5e7ea;
  --info:#4a5f86;--info-bg:#e8ecf4;--shadow:rgba(54,72,107,.20);--shadow-soft:rgba(54,72,107,.10);
  --display:var(--serif);
}
body{font-family:var(--sans);color:var(--ink);background:var(--bg-1);line-height:1.6;}
.wrap{max-width:860px;margin:0 auto;padding:16px 14px 50px;}
.qhd{display:flex;align-items:center;gap:11px;flex-wrap:wrap;margin-bottom:14px;}
.qhd .mark{font-size:24px;}
.ujack{display:none;width:42px;height:26px;border-radius:3px;flex:none;opacity:.92;border:1px solid var(--line-2);
  box-shadow:0 2px 8px var(--shadow-soft);--ub:#5a6e95;--uw:#f4efe6;--ur:#bf8794;
  background:
    linear-gradient(var(--ur) 0 0) center/5px 100% no-repeat,
    linear-gradient(var(--ur) 0 0) center/100% 5px no-repeat,
    linear-gradient(var(--uw) 0 0) center/9px 100% no-repeat,
    linear-gradient(var(--uw) 0 0) center/100% 9px no-repeat,
    linear-gradient(to bottom right,#0000 calc(50% - 1.5px),var(--ur) calc(50% - 1.5px),var(--ur) calc(50% + 1.5px),#0000 calc(50% + 1.5px)),
    linear-gradient(to bottom left,#0000 calc(50% - 1.5px),var(--ur) calc(50% - 1.5px),var(--ur) calc(50% + 1.5px),#0000 calc(50% + 1.5px)),
    linear-gradient(to bottom right,#0000 calc(50% - 3.3px),var(--uw) calc(50% - 3.3px),var(--uw) calc(50% + 3.3px),#0000 calc(50% + 3.3px)),
    linear-gradient(to bottom left,#0000 calc(50% - 3.3px),var(--uw) calc(50% - 3.3px),var(--uw) calc(50% + 3.3px),#0000 calc(50% + 3.3px)),
    var(--ub);}
body.theme-en .ujack{display:inline-block;}
.umemon{display:none;width:42px;height:26px;border-radius:3px;flex:none;opacity:.95;border:1px solid var(--line-2);
  box-shadow:0 2px 8px var(--shadow-soft);background:url(&quot;data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2722%27%20height%3D%2722%27%20viewBox%3D%270%200%2024%2024%27%3E%3Cg%20fill%3D%27%23ffffff%27%3E%3Ccircle%20cx%3D%2712%27%20cy%3D%277%27%20r%3D%273.7%27%2F%3E%3Ccircle%20cx%3D%2716.76%27%20cy%3D%2710.45%27%20r%3D%273.7%27%2F%3E%3Ccircle%20cx%3D%2714.94%27%20cy%3D%2716.05%27%20r%3D%273.7%27%2F%3E%3Ccircle%20cx%3D%279.06%27%20cy%3D%2716.05%27%20r%3D%273.7%27%2F%3E%3Ccircle%20cx%3D%277.24%27%20cy%3D%2710.45%27%20r%3D%273.7%27%2F%3E%3Ccircle%20cx%3D%2712%27%20cy%3D%2712%27%20r%3D%273%27%2F%3E%3C%2Fg%3E%3Cg%20stroke%3D%27%2315568a%27%20stroke-width%3D%270.7%27%20stroke-linecap%3D%27round%27%3E%3Cline%20x1%3D%2712%27%20y1%3D%2712%27%20x2%3D%2712%27%20y2%3D%279%27%2F%3E%3Cline%20x1%3D%2712%27%20y1%3D%2712%27%20x2%3D%2714.85%27%20y2%3D%2711.07%27%2F%3E%3Cline%20x1%3D%2712%27%20y1%3D%2712%27%20x2%3D%2713.76%27%20y2%3D%2714.43%27%2F%3E%3Cline%20x1%3D%2712%27%20y1%3D%2712%27%20x2%3D%2710.24%27%20y2%3D%2714.43%27%2F%3E%3Cline%20x1%3D%2712%27%20y1%3D%2712%27%20x2%3D%279.15%27%20y2%3D%2711.07%27%2F%3E%3C%2Fg%3E%3Ccircle%20cx%3D%2712%27%20cy%3D%2712%27%20r%3D%271%27%20fill%3D%27%2315568a%27%2F%3E%3C%2Fsvg%3E&quot;) 0 0/19px 19px repeat,#15568a;}
body.theme-ja .umemon{display:inline-block;}
.qhd .qt{font-size:18px;font-weight:800;font-family:var(--display);}
.qhd .qt small{display:block;font-size:11px;font-weight:600;color:var(--ink-2);}
.reset{margin-left:auto;border:1px solid var(--line-2);background:var(--card);border-radius:11px;padding:7px 14px;
  font-size:12px;font-weight:800;cursor:pointer;color:var(--ink-2);font-family:var(--sans);
  box-shadow:0 3px 0 var(--line-2),0 6px 12px var(--shadow-soft);transition:.12s;}
.reset:hover{transform:translateY(-1px);}
.reset:active{transform:translateY(4px) scale(.97);filter:brightness(.93);box-shadow:inset 0 3px 7px var(--shadow);}
.stats{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;}
.stat{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:8px 15px;font-size:12px;color:var(--ink-2);min-width:78px;box-shadow:0 4px 12px var(--shadow-soft);}
.stat b{display:block;font-size:21px;font-weight:800;color:var(--ink);}
.prog{height:9px;background:var(--bg-2);border-radius:5px;overflow:hidden;margin-bottom:16px;border:1px solid var(--line);}
.prog>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent),var(--brand));transition:width .35s;}
.filters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:18px;align-items:center;}
.filters .fl{font-size:12px;color:var(--ink-2);margin-right:2px;}
.fb{border:1px solid var(--line-2);background:var(--card);border-radius:20px;padding:6px 14px;font-size:12px;font-weight:800;
  cursor:pointer;color:var(--ink-2);font-family:var(--sans);box-shadow:0 3px 8px var(--shadow-soft);transition:.12s;}
.fb:hover{transform:translateY(-1px);}
.fb:active{transform:translateY(2px) scale(.97);filter:brightness(.92);box-shadow:inset 0 2px 5px var(--shadow);}
.fb.on{background:var(--info-bg);border-color:var(--brand);color:var(--info);}
.card{background:var(--card);border:1px solid var(--line);border-radius:15px;padding:16px 17px;margin-bottom:13px;
  box-shadow:0 5px 20px var(--shadow-soft);border-left:4px solid var(--line-2);}
.card.right{border-left-color:var(--ok);}
.card.wrong{border-left-color:var(--ng);}
.c-head{display:flex;align-items:flex-start;gap:10px;margin-bottom:12px;flex-wrap:wrap;}
.qnum{border-radius:9px;padding:3px 10px;font-size:12px;font-weight:800;white-space:nowrap;margin-top:1px;}
.qtype{font-size:10px;font-weight:800;color:var(--ink-2);border:1px solid var(--line-2);border-radius:7px;padding:1px 7px;margin-top:3px;white-space:nowrap;}
.qtext{font-size:14.5px;line-height:1.75;font-weight:600;flex:1;min-width:200px;}
.opts{display:flex;flex-direction:column;gap:7px;}
.opt{display:flex;align-items:flex-start;gap:9px;padding:9px 12px;border-radius:11px;border:1px solid var(--line-2);
  cursor:pointer;font-size:13.5px;background:var(--card);transition:.12s;box-shadow:0 2px 6px var(--shadow-soft);}
.opt:hover{background:var(--bg-2);}
.opt.sel{border-color:var(--brand);background:var(--info-bg);}
.opt.correct{border-color:var(--ok);background:var(--ok-bg);}
.opt.wrongsel{border-color:var(--ng);background:var(--ng-bg);}
.mk{width:19px;height:19px;border-radius:50%;border:1.5px solid var(--line-2);flex-shrink:0;margin-top:1px;
  display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;}
.opt.sel .mk{border-color:var(--brand);color:var(--brand);}
.opt.correct .mk{border-color:var(--ok);color:var(--ok);background:#fff;}
.opt.wrongsel .mk{border-color:var(--ng);color:var(--ng);background:#fff;}
.inp{width:100%;padding:10px 12px;border-radius:11px;border:1px solid var(--line-2);font-size:13.5px;
  font-family:var(--mono);background:var(--bg-1);color:var(--ink);}
.inp:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px var(--shadow);}
.check{margin-top:11px;border:1px solid var(--brand-d);border-radius:11px;padding:8px 18px;font-size:12.5px;
  font-weight:800;cursor:pointer;background:linear-gradient(180deg,var(--brand),var(--brand-d));color:#fff;font-family:var(--sans);
  box-shadow:0 4px 0 var(--brand-d),0 8px 16px var(--shadow);transition:.12s;}
.check:hover{transform:translateY(-1px);}
.check:active{transform:translateY(4px) scale(.97);filter:brightness(.9);box-shadow:inset 0 3px 8px rgba(0,0,0,.28);}
.badge{display:inline-block;border-radius:9px;padding:4px 12px;font-size:12px;font-weight:800;margin-left:10px;}
.badge.ok{background:var(--ok-bg);color:var(--ok);}
.badge.ng{background:var(--ng-bg);color:var(--ng);}
.explain{margin-top:13px;padding:13px 15px;background:color-mix(in srgb,var(--bg-2) 55%,#fff);border:1px solid var(--line);border-radius:12px;
  font-size:13px;line-height:1.85;color:var(--ink);}
.explain .etl{font-weight:800;color:var(--info);margin-bottom:5px;display:flex;align-items:center;gap:6px;}
.explain code{background:var(--card);border:1px solid var(--line);border-radius:5px;padding:1px 5px;font-family:var(--mono);font-size:12px;color:var(--info);}
.done{margin-top:22px;padding:24px;text-align:center;background:var(--card);border:1px dashed var(--accent);border-radius:15px;box-shadow:0 6px 20px var(--shadow-soft);}
.done .big{font-size:34px;}
.done .sc{font-size:22px;font-weight:800;margin:6px 0;font-family:var(--display);}
.empty{padding:60px 20px;text-align:center;color:var(--ink-2);}
.namebar{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:12px;background:var(--card);
  border:1px solid var(--line);border-radius:12px;padding:9px 13px;box-shadow:0 4px 14px var(--shadow-soft);}
.namebar span{font-size:12px;font-weight:800;color:var(--ink-2);white-space:nowrap;}
.namebar input{flex:1;min-width:140px;border:1px solid var(--line-2);border-radius:9px;padding:8px 11px;
  font-size:14px;font-family:var(--sans);color:var(--ink);background:var(--bg-1);}
.namebar input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px var(--shadow);}
.scorebar{margin-top:18px;background:var(--card);border:1px solid var(--line-2);border-radius:14px;padding:15px 16px;
  box-shadow:0 6px 22px var(--shadow-soft);}
.sb-title{font-size:13px;font-weight:800;color:var(--info);margin-bottom:10px;font-family:var(--display);}
.sb-btns{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
.sb-btn{appearance:none;font-family:var(--sans);font-size:12.5px;font-weight:800;cursor:pointer;border-radius:11px;
  padding:10px 14px;border:1px solid var(--brand-d);color:#fff;background:linear-gradient(180deg,var(--brand),var(--brand-d));
  box-shadow:0 4px 0 var(--brand-d),0 8px 16px var(--shadow);transition:.12s;}
.sb-btn:hover{transform:translateY(-1px);}
.sb-btn:active{transform:translateY(4px) scale(.97);filter:brightness(.9);box-shadow:inset 0 3px 8px rgba(0,0,0,.28);}
.sb-toast{font-size:12px;font-weight:800;color:var(--ok);opacity:0;transition:opacity .2s;margin-left:4px;}
@media(max-width:600px){
  .wrap{padding:14px 11px 44px;}
  .qhd .qt{font-size:16px;}
  .stat{flex:1;min-width:0;padding:8px 8px;}
  .stat b{font-size:18px;}
  .card{padding:14px 13px;}
  .qtext{font-size:14px;}
  .opt{font-size:14px;padding:11px 12px;}
  .check{padding:11px 18px;font-size:13.5px;width:100%;}
  .inp{font-size:15px;}
  .fb,.reset{padding:8px 13px;}
  .sb-btn{flex:1 1 100%;padding:12px 14px;}
  .namebar input{font-size:15px;}
}
button,.opt,.fb,.reset{touch-action:manipulation;-webkit-tap-highlight-color:transparent;}
</script>

<!-- ===== quiz engine JS (stored as plain text) ===== -->
<script type=&quot;text/plain&quot; id=&quot;quiz-js&quot;>
var QS=(window.QUIZ_DATA||[]).map(function(q,i){q.n=i+1;return q;});
var META=window.QUIZ_META||{title:&quot;Quiz&quot;,lang:&quot;ja&quot;};
var EN=META.lang===&quot;en&quot;;
var L=EN?{answered:&quot;Answered&quot;,correct:&quot;Correct&quot;,wrong:&quot;Wrong&quot;,cat:&quot;Category&quot;,all:&quot;All&quot;,reset:&quot;Restart&quot;,
  tMulti:&quot;Multiple&quot;,tInput:&quot;Text&quot;,tSingle:&quot;Single&quot;,multiHint:&quot;(select all that apply)&quot;,answer:&quot;Answer&quot;,
  okBadge:&quot;Correct&quot;,ngBadge:&quot;Incorrect — answer: &quot;,explain:&quot;Explanation&quot;,ph:&quot;Type your answer…&quot;,
  none:&quot;No questions match.&quot;,total:function(n,c){return n+&quot; questions&quot;+(c?&quot; / &quot;+c+&quot; categories&quot;:&quot;&quot;);},
  done:function(ok,n,p){return ok+&quot; / &quot;+n+&quot; correct (&quot;+p+&quot;%)&quot;;},
  msg:function(p){return p>=80?&quot;Excellent — you're in the pass range!&quot;:p>=60?&quot;Almost there. Review the explanations.&quot;:&quot;Let's review together 🐰&quot;;},
  nameLabel:&quot;Name&quot;,namePh:&quot;Type your name&quot;,scoreTitle:&quot;📤 Export your score&quot;,
  exMemo:&quot;📝 Copy memo&quot;,exCsv:&quot;📊 Save Excel (CSV)&quot;,exNotion:&quot;📔 Copy for Notion&quot;,copied:&quot;Copied!&quot;,saved:&quot;Saved&quot;,
  fName:&quot;Name&quot;,fDate:&quot;Date&quot;,fTime:&quot;Time&quot;,fCourse:&quot;Course&quot;,fScore:&quot;Score&quot;,fRate:&quot;Accuracy&quot;,fByCat:&quot;By category&quot;,fEnterName:&quot;(enter your name)&quot;,fTotal:&quot;Total&quot;,scoreHeading:&quot;Score&quot;}
:{answered:&quot;回答済み&quot;,correct:&quot;正解&quot;,wrong:&quot;不正解&quot;,cat:&quot;カテゴリ&quot;,all:&quot;すべて&quot;,reset:&quot;最初からやり直す&quot;,
  tMulti:&quot;複数選択&quot;,tInput:&quot;記述&quot;,tSingle:&quot;単一選択&quot;,multiHint:&quot;（複数選択）&quot;,answer:&quot;回答する&quot;,
  okBadge:&quot;正解&quot;,ngBadge:&quot;不正解 — 正解例: &quot;,explain:&quot;解説&quot;,ph:&quot;答えを入力…&quot;,
  none:&quot;該当する問題がありません&quot;,total:function(n,c){return &quot;全&quot;+n+&quot;問&quot;+(c?&quot; ／ &quot;+c+&quot;カテゴリ&quot;:&quot;&quot;);},
  done:function(ok,n,p){return ok+&quot; / &quot;+n+&quot;問 正解（&quot;+p+&quot;%）&quot;;},
  msg:function(p){return p>=80?&quot;お見事！合格圏です&quot;:p>=60?&quot;あと一歩、解説を復習しましょう&quot;:&quot;うさうさ先生と一緒に復習しましょう🐰&quot;;},
  nameLabel:&quot;お名前&quot;,namePh:&quot;氏名を入力&quot;,scoreTitle:&quot;📤 スコアを出力&quot;,
  exMemo:&quot;📝 メモをコピー&quot;,exCsv:&quot;📊 Excel(CSV)保存&quot;,exNotion:&quot;📔 Notion用にコピー&quot;,copied:&quot;コピーしました&quot;,saved:&quot;保存しました&quot;,
  fName:&quot;名前&quot;,fDate:&quot;日付&quot;,fTime:&quot;時間&quot;,fCourse:&quot;講座&quot;,fScore:&quot;得点&quot;,fRate:&quot;正答率&quot;,fByCat:&quot;カテゴリ別&quot;,fEnterName:&quot;（氏名を入力してください）&quot;,fTotal:&quot;総数&quot;,scoreHeading:&quot;スコア&quot;};
var CATS=[];QS.forEach(function(q){if(q.cat&amp;&amp;CATS.indexOf(q.cat)<0)CATS.push(q.cat);});
var PALETTE=[[&quot;#fdf0df&quot;,&quot;#c96a0c&quot;],[&quot;#e7f5ef&quot;,&quot;#0f6e56&quot;],[&quot;#faeeda&quot;,&quot;#854f0b&quot;],[&quot;#eeedfe&quot;,&quot;#3c3489&quot;],
  [&quot;#fbeaf0&quot;,&quot;#993556&quot;],[&quot;#e1f5ee&quot;,&quot;#0f6e56&quot;],[&quot;#faece7&quot;,&quot;#993c1d&quot;],[&quot;#eef6e0&quot;,&quot;#4a6b15&quot;]];
function catColor(c){var i=Math.max(0,CATS.indexOf(c));return PALETTE[i%PALETTE.length];}
function esc(s){return String(s==null?&quot;&quot;:s).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;);}
function nl2br(s){return esc(s).replace(/\n/g,&quot;<br>&quot;);}
var state={},curCat=&quot;all&quot;;
document.getElementById(&quot;course-title&quot;).textContent=META.title||&quot;Quiz&quot;;
document.getElementById(&quot;course-sub&quot;).textContent=L.total(QS.length,CATS.length);
document.getElementById(&quot;lbl-done&quot;).textContent=L.answered;
document.getElementById(&quot;lbl-ok&quot;).textContent=L.correct;
document.getElementById(&quot;lbl-ng&quot;).textContent=L.wrong;
function getFiltered(){return curCat===&quot;all&quot;?QS:QS.filter(function(q){return q.cat===curCat;});}
function renderFilters(){
  var el=document.getElementById(&quot;filters&quot;);if(!CATS.length){el.innerHTML=&quot;&quot;;return;}
  var h='<span class=&quot;fl&quot;>'+L.cat+'：</span><button class=&quot;fb on&quot; onclick=&quot;filt(\'all\',this)&quot;>'+L.all+'</button>';
  CATS.forEach(function(c){h+='<button class=&quot;fb&quot; data-c=&quot;'+esc(c)+'&quot; onclick=&quot;filt(this.dataset.c,this)&quot;>'+esc(c)+'</button>';});
  el.innerHTML=h;
}
function filt(c,btn){curCat=c;var bs=document.querySelectorAll(&quot;.fb&quot;);for(var i=0;i<bs.length;i++)bs[i].classList.remove(&quot;on&quot;);btn.classList.add(&quot;on&quot;);renderList();}
function renderStats(){
  var done=0,ok=0;QS.forEach(function(q){if(state[&quot;r&quot;+q.n]){done++;if(state[q.n])ok++;}});
  document.getElementById(&quot;s-done&quot;).textContent=done;
  document.getElementById(&quot;s-ok&quot;).textContent=ok;
  document.getElementById(&quot;s-ng&quot;).textContent=done-ok;
  document.getElementById(&quot;prog-i&quot;).style.width=(QS.length?Math.round(done/QS.length*100):0)+&quot;%&quot;;
  var dn=document.getElementById(&quot;done-box&quot;);
  if(done===QS.length&amp;&amp;QS.length>0){dn.style.display=&quot;block&quot;;var pct=Math.round(ok/QS.length*100);
    var emo=pct>=80?&quot;🎉&quot;:pct>=60?&quot;👍&quot;:&quot;🍜&quot;;
    dn.innerHTML='<div class=&quot;big&quot;>'+emo+'</div><div class=&quot;sc&quot;>'+L.done(ok,QS.length,pct)+'</div>'
      +'<div style=&quot;color:var(--ink-2);font-size:13px&quot;>'+L.msg(pct)+'</div>';
  } else dn.style.display=&quot;none&quot;;
}
function renderList(){
  var qs=getFiltered(),el=document.getElementById(&quot;qlist&quot;);
  if(!qs.length){el.innerHTML='<div class=&quot;empty&quot;>'+L.none+'</div>';return;}
  el.innerHTML=qs.map(buildCard).join(&quot;&quot;);
  qs.forEach(function(q){if(q.type===&quot;input&quot;){var inp=document.getElementById(&quot;inp-&quot;+q.n);if(inp&amp;&amp;state[&quot;v&quot;+q.n]!=null)inp.value=state[&quot;v&quot;+q.n];}});
}
function buildCard(q){
  var s=state[q.n],cls=state[&quot;r&quot;+q.n]?(s?&quot;right&quot;:&quot;wrong&quot;):&quot;&quot;,col=catColor(q.cat),rev=!!state[&quot;r&quot;+q.n];
  var typeLabel=q.type===&quot;multi&quot;?L.tMulti:q.type===&quot;input&quot;?L.tInput:L.tSingle,body=&quot;&quot;;
  if(q.type===&quot;single&quot;||q.type===&quot;multi&quot;){
    var sel=state[&quot;s&quot;+q.n]||[];
    body='<div class=&quot;opts&quot;>'+q.opts.map(function(o,i){
      var c2=&quot;&quot;;if(rev){if(q.ans.indexOf(i)>=0)c2=&quot;correct&quot;;else if(sel.indexOf(i)>=0)c2=&quot;wrongsel&quot;;}else if(sel.indexOf(i)>=0)c2=&quot;sel&quot;;
      var mk=rev?(q.ans.indexOf(i)>=0?&quot;✓&quot;:(sel.indexOf(i)>=0?&quot;✗&quot;:&quot;&quot;)):(sel.indexOf(i)>=0?(q.type===&quot;multi&quot;?&quot;✓&quot;:&quot;●&quot;):&quot;&quot;);
      return '<div class=&quot;opt '+c2+'&quot; onclick=&quot;pick('+q.n+','+i+','+(q.type===&quot;multi&quot;)+')&quot;><span class=&quot;mk&quot;>'+mk+'</span><span>'+esc(o)+'</span></div>';
    }).join(&quot;&quot;)+'</div>';
    if(!rev)body+='<button class=&quot;check&quot; onclick=&quot;checkChoice('+q.n+')&quot;>'+L.answer+'</button>';
  } else {
    body='<input class=&quot;inp&quot; id=&quot;inp-'+q.n+'&quot; type=&quot;text&quot; placeholder=&quot;'+L.ph+'&quot; '+(rev?&quot;disabled&quot;:&quot;&quot;)+'>';
    if(!rev)body+='<button class=&quot;check&quot; onclick=&quot;checkInput('+q.n+')&quot;>'+L.answer+'</button>';
    else body+= s?'<span class=&quot;badge ok&quot;>'+L.okBadge+'</span>':'<span class=&quot;badge ng&quot;>'+L.ngBadge+esc(q.ans.join(&quot; / &quot;))+'</span>';
  }
  var exp=(rev&amp;&amp;q.explain)?'<div class=&quot;explain&quot;><div class=&quot;etl&quot;>🐰 '+L.explain+'</div>'+q.explain+'</div>':&quot;&quot;;
  var catTag=q.cat?'<span class=&quot;qnum&quot; style=&quot;background:'+col[0]+';color:'+col[1]+'&quot;>'+esc(q.cat)+'</span>':'';
  return '<div class=&quot;card '+cls+'&quot; id=&quot;card-'+q.n+'&quot;><div class=&quot;c-head&quot;>'
    +'<span class=&quot;qnum&quot; style=&quot;background:var(--bg-2);color:var(--ink-2)&quot;>Q'+q.n+'</span>'+catTag
    +'<span class=&quot;qtype&quot;>'+typeLabel+'</span>'
    +'<div class=&quot;qtext&quot;>'+nl2br(q.text)+(q.type===&quot;multi&quot;?' <span style=&quot;font-size:11px;color:var(--ink-2)&quot;>'+L.multiHint+'</span>':'')+'</div>'
    +'</div>'+body+exp+'</div>';
}
function pick(n,i,multi){if(state[&quot;r&quot;+n])return;if(!state[&quot;s&quot;+n])state[&quot;s&quot;+n]=[];
  if(multi){var p=state[&quot;s&quot;+n].indexOf(i);if(p>=0)state[&quot;s&quot;+n].splice(p,1);else state[&quot;s&quot;+n].push(i);}else state[&quot;s&quot;+n]=[i];refresh(n);}
function checkChoice(n){var q=QS[n-1];if(!q||q.type===&quot;input&quot;||state[&quot;r&quot;+n])return;var sel=(state[&quot;s&quot;+n]||[]).slice().sort(function(a,b){return a-b;}),ans=q.ans.slice().sort(function(a,b){return a-b;});
  state[&quot;r&quot;+n]=true;state[n]=(sel.join(&quot;,&quot;)===ans.join(&quot;,&quot;));renderStats();refresh(n);}
function norm(s){return String(s).trim().toLowerCase().replace(/\s+/g,&quot; &quot;);}
function checkInput(n){var q=QS[n-1];if(!q||q.type!==&quot;input&quot;||state[&quot;r&quot;+n])return;var v=(document.getElementById(&quot;inp-&quot;+n).value||&quot;&quot;);state[&quot;v&quot;+n]=v;
  state[&quot;r&quot;+n]=true;state[n]=q.ans.some(function(a){return norm(a)===norm(v);});renderStats();refresh(n);}
function refresh(n){var q=QS[n-1],old=document.getElementById(&quot;card-&quot;+n);if(!old)return;
  var tmp=document.createElement(&quot;div&quot;);tmp.innerHTML=buildCard(q);old.replaceWith(tmp.firstChild);
  if(q.type===&quot;input&quot;&amp;&amp;state[&quot;v&quot;+n]!=null){var inp=document.getElementById(&quot;inp-&quot;+n);if(inp)inp.value=state[&quot;v&quot;+n];}}
function resetAll(){state={};renderStats();renderList();}
document.getElementById(&quot;reset-btn&quot;).textContent=L.reset;
/* ===== スコア出力（名前・日付・時間つき） ===== */
document.getElementById(&quot;name-label&quot;).textContent=L.nameLabel+&quot;：&quot;;
document.getElementById(&quot;stu-name&quot;).setAttribute(&quot;placeholder&quot;,L.namePh);
document.getElementById(&quot;sb-title&quot;).textContent=L.scoreTitle;
document.getElementById(&quot;sb-memo&quot;).textContent=L.exMemo;
document.getElementById(&quot;sb-csv&quot;).textContent=L.exCsv;
document.getElementById(&quot;sb-notion&quot;).textContent=L.exNotion;
try{var sv=localStorage.getItem(&quot;usausa_stu_name&quot;);if(sv)document.getElementById(&quot;stu-name&quot;).value=sv;}catch(e){}
document.getElementById(&quot;stu-name&quot;).addEventListener(&quot;input&quot;,function(){try{localStorage.setItem(&quot;usausa_stu_name&quot;,this.value);}catch(e){}});
function pad2(n){return (n<10?&quot;0&quot;:&quot;&quot;)+n;}
function nowParts(){var d=new Date();return {date:d.getFullYear()+&quot;-&quot;+pad2(d.getMonth()+1)+&quot;-&quot;+pad2(d.getDate()),time:pad2(d.getHours())+&quot;:&quot;+pad2(d.getMinutes())};}
function scoreData(){
  var ok=0,done=0;QS.forEach(function(q){if(state[&quot;r&quot;+q.n]){done++;if(state[q.n])ok++;}});
  var pct=QS.length?Math.round(ok/QS.length*100):0;
  var byCat=CATS.map(function(c){var qs=QS.filter(function(q){return q.cat===c;});var co=qs.filter(function(q){return state[q.n];}).length;return {cat:c,ok:co,total:qs.length};});
  var nm=(document.getElementById(&quot;stu-name&quot;).value||&quot;&quot;).trim()||L.fEnterName;
  var np=nowParts();
  return {name:nm,date:np.date,time:np.time,course:META.title||&quot;&quot;,ok:ok,total:QS.length,pct:pct,byCat:byCat};
}
function buildMemo(){var s=scoreData();
  var t=&quot;■ &quot;+s.course+&quot; &quot;+L.scoreHeading+&quot;\n&quot;;
  t+=L.fName+&quot;：&quot;+s.name+&quot;\n&quot;+L.fDate+&quot;：&quot;+s.date+&quot;\n&quot;+L.fTime+&quot;：&quot;+s.time+&quot;\n&quot;;
  t+=L.fScore+&quot;：&quot;+s.ok+&quot; / &quot;+s.total+&quot;（&quot;+s.pct+&quot;%）\n&quot;;
  if(s.byCat.length){t+=L.fByCat+&quot;：\n&quot;;s.byCat.forEach(function(b){t+=&quot;・&quot;+b.cat+&quot; &quot;+b.ok+&quot;/&quot;+b.total+&quot;\n&quot;;});}
  return t.replace(/\n+$/,&quot;&quot;);
}
function buildCsv(){var s=scoreData();
  var head=[L.fName,L.fDate,L.fTime,L.fCourse,L.fScore,L.fTotal,L.fRate];
  var row=[s.name,s.date,s.time,s.course,s.ok,s.total,s.pct+&quot;%&quot;];
  function cell(c){c=String(c);return /[&quot;,\n]/.test(c)?'&quot;'+c.replace(/&quot;/g,'&quot;&quot;')+'&quot;':c;}
  return &quot;\ufeff&quot;+head.map(cell).join(&quot;,&quot;)+&quot;\r\n&quot;+row.map(cell).join(&quot;,&quot;);
}
function buildNotion(){var s=scoreData();
  var t=&quot;| &quot;+L.fName+&quot; | &quot;+L.fDate+&quot; | &quot;+L.fTime+&quot; | &quot;+L.fCourse+&quot; | &quot;+L.fScore+&quot; | &quot;+L.fRate+&quot; |\n&quot;;
  t+=&quot;| --- | --- | --- | --- | --- | --- |\n&quot;;
  t+=&quot;| &quot;+s.name+&quot; | &quot;+s.date+&quot; | &quot;+s.time+&quot; | &quot;+s.course+&quot; | &quot;+s.ok+&quot;/&quot;+s.total+&quot; | &quot;+s.pct+&quot;% |&quot;;
  if(s.byCat.length){t+=&quot;\n\n&quot;+L.fByCat+&quot;\n| &quot;+L.cat+&quot; | &quot;+L.fScore+&quot; |\n| --- | --- |\n&quot;;
    s.byCat.forEach(function(b){t+=&quot;| &quot;+b.cat+&quot; | &quot;+b.ok+&quot;/&quot;+b.total+&quot; |\n&quot;;});t=t.replace(/\n$/,&quot;&quot;);}
  return t;
}
function copyText(txt,msg){
  function done(){toast(msg);}
  try{if(navigator.clipboard&amp;&amp;navigator.clipboard.writeText){navigator.clipboard.writeText(txt).then(done,function(){legacy();});return;}}catch(e){}
  legacy();
  function legacy(){var ta=document.createElement(&quot;textarea&quot;);ta.value=txt;ta.style.position=&quot;fixed&quot;;ta.style.opacity=&quot;0&quot;;document.body.appendChild(ta);ta.select();try{document.execCommand(&quot;copy&quot;);done();}catch(e){toast(txt);}document.body.removeChild(ta);}
}
function dlFile(name,txt,mime){try{var b=new Blob([txt],{type:mime});var a=document.createElement(&quot;a&quot;);a.href=URL.createObjectURL(b);a.download=name;document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},800);toast(L.saved);}catch(e){copyText(txt,L.copied);}}
function safeNm(s){return String(s||&quot;score&quot;).replace(/[\\/:*?&quot;<>|]/g,&quot;_&quot;).slice(0,40);}
function toast(m){var el=document.getElementById(&quot;sb-toast&quot;);el.textContent=m;el.style.opacity=&quot;1&quot;;clearTimeout(toast._t);toast._t=setTimeout(function(){el.style.opacity=&quot;0&quot;;},2200);}
function exMemo(){copyText(buildMemo(),L.copied);}
function exNotion(){copyText(buildNotion(),L.copied);}
function exCsv(){var s=scoreData();dlFile(safeNm(s.course)+&quot;_&quot;+safeNm(s.name)+&quot;_&quot;+s.date+&quot;.csv&quot;,buildCsv(),&quot;text/csv;charset=utf-8&quot;);}
renderFilters();renderStats();renderList();
</script>

<!-- ===== quiz engine body HTML (stored as plain text) ===== -->
<script type=&quot;text/plain&quot; id=&quot;quiz-body&quot;>
<div class=&quot;wrap&quot;>
  <div class=&quot;qhd&quot;>
    <span class=&quot;mark&quot;>🐰</span>
    <span class=&quot;ujack&quot; aria-hidden=&quot;true&quot;></span>
    <span class=&quot;umemon&quot; aria-hidden=&quot;true&quot;></span>
    <div class=&quot;qt&quot;><span id=&quot;course-title&quot;>Quiz</span><small id=&quot;course-sub&quot;></small></div>
    <button class=&quot;reset&quot; id=&quot;reset-btn&quot; onclick=&quot;resetAll()&quot;>Restart</button>
  </div>
  <div class=&quot;namebar&quot;>
    <span id=&quot;name-label&quot;>Name:</span>
    <input id=&quot;stu-name&quot; type=&quot;text&quot; autocomplete=&quot;name&quot; placeholder=&quot;Type your name&quot;>
  </div>
  <div class=&quot;stats&quot;>
    <div class=&quot;stat&quot;><b id=&quot;s-done&quot;>0</b><span id=&quot;lbl-done&quot;>Answered</span></div>
    <div class=&quot;stat&quot;><b id=&quot;s-ok&quot; style=&quot;color:var(--ok)&quot;>0</b><span id=&quot;lbl-ok&quot;>Correct</span></div>
    <div class=&quot;stat&quot;><b id=&quot;s-ng&quot; style=&quot;color:var(--ng)&quot;>0</b><span id=&quot;lbl-ng&quot;>Wrong</span></div>
  </div>
  <div class=&quot;prog&quot;><i id=&quot;prog-i&quot;></i></div>
  <div class=&quot;filters&quot; id=&quot;filters&quot;></div>
  <div id=&quot;qlist&quot;></div>
  <div class=&quot;done&quot; id=&quot;done-box&quot; style=&quot;display:none&quot;></div>
  <div class=&quot;scorebar&quot;>
    <div class=&quot;sb-title&quot; id=&quot;sb-title&quot;>📤 Export your score</div>
    <div class=&quot;sb-btns&quot;>
      <button class=&quot;sb-btn&quot; id=&quot;sb-memo&quot; onclick=&quot;exMemo()&quot;>📝 Copy memo</button>
      <button class=&quot;sb-btn&quot; id=&quot;sb-csv&quot; onclick=&quot;exCsv()&quot;>📊 Save Excel (CSV)</button>
      <button class=&quot;sb-btn&quot; id=&quot;sb-notion&quot; onclick=&quot;exNotion()&quot;>📔 Copy for Notion</button>
      <span class=&quot;sb-toast&quot; id=&quot;sb-toast&quot;></span>
    </div>
  </div>
</div>
</script>


<!-- ===== parent app JS ===== -->
<script>
&quot;use strict&quot;;
var fmt=&quot;auto&quot;,LANG=&quot;ja&quot;,lastData=[],curClass=&quot;all&quot;,SAVE_KEY=&quot;usausa_quiz_src_v2&quot;;

/* ---------------- i18n ---------------- */
var T={
ja:{appTitle:&quot;うさうさ作問スタジオ&quot;,appTag:&quot;メモ・Excelで書く → 受講生用の演習に → 配布用HTMLを書き出し&quot;,
 courseLabel:&quot;講座名&quot;,tabEdit:&quot;作問・編集&quot;,tabPrev:&quot;演習プレビュー&quot;,tabHow:&quot;使い方&quot;,
 izLabel:&quot;📥 ここに問題を入力／Excelからコピー＆貼り付け&quot;,
 izPh:&quot;ここに入力、または Excel のセルをコピーして貼り付け。\n「📋 サンプル読込」で書き方を確認できます。&quot;,
 edTitle:&quot;📥 問題を入力&quot;,edSub:&quot;入力すると右に即反映&quot;,
 bSample:&quot;サンプル読込&quot;,bClear:&quot;クリア&quot;,bStudent:&quot;受講生用HTMLを書き出す&quot;,bSave:&quot;JSON保存&quot;,bLoad:&quot;JSON読込&quot;,bExcel:&quot;Excelテンプレ&quot;,
 bByClass:&quot;クラス別に一括書き出し&quot;,classLabel:&quot;クラス：&quot;,classAll:&quot;すべて&quot;,
 byClassNone:&quot;クラス（@class）が未設定のため、1ファイルにまとめて書き出しました。&quot;,
 byClassDone:function(n){return n+&quot;クラス分のファイルを書き出しました。&quot;;},
 fmtLabel:&quot;取込形式：&quot;,fmtAuto:&quot;自動判定&quot;,fmtMemo:&quot;メモ/MD&quot;,fmtTsv:&quot;Excel&quot;,
 cheatSum:&quot;📖 書き方ガイド（クリックで開く）&quot;,
 hintSave:&quot;💡 入力はこのブラウザに自動保存されます。保管は「JSON保存」を。&quot;,
 pvTitle:&quot;👀 受講生から見える画面&quot;,pvSub:&quot;この通りに配布されます&quot;,
 pvEmpty1:&quot;まだ問題がありません&quot;,pvEmpty2:&quot;左に入力すると、ここに演習画面が表示されます&quot;,
 pvBig:&quot;📝 演習プレビュー（受講生モード）&quot;,bStudent2:&quot;このまま配布用に書き出す&quot;,
 howTitle:&quot;📘 使い方&quot;,foot:&quot;🐰 うさうさ先生の作問スタジオ ／ 完全オフライン・単一HTMLで動作します&quot;,
 detPrefix:&quot;判定: &quot;,detMemo:&quot;メモ/Markdown&quot;,detTsv:&quot;Excel/表形式&quot;,
 stReady:&quot;サンプルを読み込むか、問題を入力してください。&quot;,
 stNone:&quot;問題を認識できませんでした。書き方ガイドをご確認ください。&quot;,
 stWarn:function(w){return w+&quot;問に「正解未指定」または「選択肢不足」があります（要確認）。&quot;;},
 stOk:&quot;すべて正常に認識できました。&quot;,stErr:function(m){return &quot;解析エラー: &quot;+m;},
 qUnit:&quot;問&quot;,warnUnit:function(w){return &quot;（要確認 &quot;+w+&quot;）&quot;;},
 noData:&quot;先に問題を入力してください。&quot;,confirmClear:&quot;入力内容をすべて消去します。よろしいですか？&quot;,
 importErr:function(m){return &quot;JSONの読み込みに失敗しました: &quot;+m;},
 courseDefault:&quot;LPIC-1 101 試験対策&quot;,sampleTitle:&quot;LPIC-1 101 試験対策（サンプル）&quot;,
 subTotal:function(t,n){return t+&quot; ／ 全&quot;+n+&quot;問&quot;;},
 lng:&quot;🇯🇵 日本語&quot;},
en:{appTitle:&quot;Usausa Quiz Studio&quot;,appTag:&quot;Write in notes/Excel → student practice → export a shareable HTML&quot;,
 courseLabel:&quot;Course&quot;,tabEdit:&quot;Author&quot;,tabPrev:&quot;Preview&quot;,tabHow:&quot;How to use&quot;,
 izLabel:&quot;📥 Type here, or copy &amp; paste cells from Excel&quot;,
 izPh:&quot;Type here, or copy and paste cells from Excel.\nClick “📋 Load sample” to see how it works.&quot;,
 edTitle:&quot;📥 Enter questions&quot;,edSub:&quot;Updates the preview instantly&quot;,
 bSample:&quot;Load sample&quot;,bClear:&quot;Clear&quot;,bStudent:&quot;Export student HTML&quot;,bSave:&quot;Save JSON&quot;,bLoad:&quot;Load JSON&quot;,bExcel:&quot;Excel template&quot;,
 bByClass:&quot;Export each class&quot;,classLabel:&quot;Class:&quot;,classAll:&quot;All&quot;,
 byClassNone:&quot;No class (@class) set, so everything was exported as one file.&quot;,
 byClassDone:function(n){return &quot;Exported &quot;+n+&quot; class file(s).&quot;;},
 fmtLabel:&quot;Input format:&quot;,fmtAuto:&quot;Auto&quot;,fmtMemo:&quot;Notes/MD&quot;,fmtTsv:&quot;Excel&quot;,
 cheatSum:&quot;📖 Formatting guide (click to open)&quot;,
 hintSave:&quot;💡 Your input is auto-saved in this browser. Use “Save JSON” to keep a copy.&quot;,
 pvTitle:&quot;👀 What students see&quot;,pvSub:&quot;Distributed exactly like this&quot;,
 pvEmpty1:&quot;No questions yet&quot;,pvEmpty2:&quot;Type on the left and the practice screen appears here&quot;,
 pvBig:&quot;📝 Practice preview (student mode)&quot;,bStudent2:&quot;Export this as a student file&quot;,
 howTitle:&quot;📘 How to use&quot;,foot:&quot;🐰 Usausa Quiz Studio · Fully offline · single HTML file&quot;,
 detPrefix:&quot;Detected: &quot;,detMemo:&quot;Notes/Markdown&quot;,detTsv:&quot;Excel/table&quot;,
 stReady:&quot;Load the sample or type your questions.&quot;,
 stNone:&quot;No questions detected. Please check the formatting guide.&quot;,
 stWarn:function(w){return w+&quot; question(s) have no marked answer or too few options (please check).&quot;;},
 stOk:&quot;All questions parsed correctly.&quot;,stErr:function(m){return &quot;Parse error: &quot;+m;},
 qUnit:&quot;Q&quot;,warnUnit:function(w){return &quot; (&quot;+w+&quot; to check)&quot;;},
 noData:&quot;Please enter questions first.&quot;,confirmClear:&quot;This will clear all input. Continue?&quot;,
 importErr:function(m){return &quot;Failed to load JSON: &quot;+m;},
 courseDefault:&quot;LPIC-1 101 Exam Prep&quot;,sampleTitle:&quot;LPIC-1 101 Exam Prep (sample)&quot;,
 subTotal:function(t,n){return t+&quot; / &quot;+n+&quot; questions&quot;;},
 lng:&quot;🇬🇧 English&quot;}
};

var CHEAT={
ja:'<p>「メモ感覚」で速く書けます。記号は半角。<code>*</code> を付けた選択肢が正解です。</p>'
 +'<pre>@class 基礎クラス          ← クラス（基礎／応用などで問題を分ける・省略可）\n@cat コマンド基礎          ← カテゴリ（以降の問に適用・省略可）\n\n'
 +'# manでセクション1を表示するのは？   ← 「#」で問題開始\n- man command(1)\n- *man 1 command           ← 行頭「*」が正解\n- man -s 1 command\n'
 +'> manは「: セクション番号 → コマンド名」の順。  ← 「>」で解説（複数行OK）\n\n'
 +'# [複数] 有効なリダイレクト演算子は？  ← [複数]で複数選択\n- *2&amp;gt;&amp;amp;1\n- *&amp;lt;\n- %&amp;gt;\n\n'
 +'# [記述] locateのDBを更新するコマンドは？  ← [記述]で入力式\n= updatedb                 ← 「=」が正解（複数行=で別解も可）\n> findと違い事前DBを検索。</pre>'
 +'<p style=&quot;margin-top:8px&quot;><b>ルール早見表</b></p><table><tr><th>記号</th><th>意味</th></tr>'
 +'<tr><td><code>@class 名前</code></td><td>クラス分け（基礎／応用など）</td></tr><tr><td><code>@cat 名前</code></td><td>カテゴリ指定</td></tr><tr><td><code># 問題文</code></td><td>問題の開始</td></tr>'
 +'<tr><td><code>- 選択肢</code></td><td>選択肢（<code>*</code>付き=正解）</td></tr><tr><td><code>= 答え</code></td><td>記述式の正解（複数=で別解）</td></tr>'
 +'<tr><td><code>&amp;gt; 解説</code></td><td>解説（省略可・複数行可）</td></tr><tr><td><code>[複数] [記述] [単一]</code></td><td>種別を明示（省略時は自動判定）</td></tr></table>'
 +'<p style=&quot;margin-top:8px&quot;><b>Excelから貼る場合</b>：列順 <code>カテゴリ / 種別 / 問題文 / 選択肢1〜5 / 正解 / 解説</code> でセルをコピペ（タブ区切りを自動認識）。正解は番号（例 <code>2</code> や <code>1,3</code>）、記述式は答えの文字（別解は <code>;</code> 区切り）。「📊 Excelテンプレ」で雛形CSVを書き出せます。</p>',
en:'<p>Write quickly like plain notes. Use half-width symbols. An option marked with <code>*</code> is correct.</p>'
 +'<pre>@class Basic               ← class/cohort (split into Basic / Advanced, optional)\n@cat Commands             ← category (applies to following questions, optional)\n\n'
 +'# Which shows section 1 of the man page?   ← &quot;#&quot; starts a question\n- man command(1)\n- *man 1 command           ← &quot;*&quot; marks the correct option\n- man -s 1 command\n'
 +'> man uses &quot;man [section] command&quot;.  ← &quot;>&quot; adds an explanation (multi-line OK)\n\n'
 +'# [multi] Which are valid redirection operators?  ← [multi] = multiple choice\n- *2&amp;gt;&amp;amp;1\n- *&amp;lt;\n- %&amp;gt;\n\n'
 +'# [input] Which program updates the locate database?  ← [input] = free text\n= updatedb                 ← &quot;=&quot; is the answer (more &quot;=&quot; lines = alt answers)\n> locate searches a prebuilt DB.</pre>'
 +'<p style=&quot;margin-top:8px&quot;><b>Symbol reference</b></p><table><tr><th>Symbol</th><th>Meaning</th></tr>'
 +'<tr><td><code>@class Name</code></td><td>Split by class (Basic / Advanced…)</td></tr><tr><td><code>@cat Name</code></td><td>Set category</td></tr><tr><td><code># text</code></td><td>Start a question</td></tr>'
 +'<tr><td><code>- option</code></td><td>Option (<code>*</code> = correct)</td></tr><tr><td><code>= answer</code></td><td>Free-text answer (more lines = alternatives)</td></tr>'
 +'<tr><td><code>&amp;gt; text</code></td><td>Explanation (optional, multi-line)</td></tr><tr><td><code>[multi] [input] [single]</code></td><td>Force the type (otherwise auto)</td></tr></table>'
 +'<p style=&quot;margin-top:8px&quot;><b>Pasting from Excel</b>: copy cells in column order <code>Category / Type / Question / Option1–5 / Answer / Explanation</code> (tabs are auto-detected). Answer = option number (e.g. <code>2</code> or <code>1,3</code>); for free text use the text itself (alternatives separated by <code>;</code>). Use “📊 Excel template” to download a starter CSV.</p>'
};

var HOWTO={
ja:'<div class=&quot;steps&quot;>'
 +'<div class=&quot;step&quot; data-n=&quot;1&quot;><div class=&quot;sh&quot;><div class=&quot;si&quot;>✏️</div><h3>問題を書く</h3></div><p>左の入力欄に<b>メモ感覚</b>で書くか、<b>Excel</b>からセルをコピペします。<code>#</code>で問題、<code>-</code>で選択肢、正解は行頭<code>*</code>、<code>=</code>で記述式、<code>></code>で解説。詳しくは作問画面の「書き方ガイド」を開いてください。</p></div>'
 +'<div class=&quot;step&quot; data-n=&quot;2&quot;><div class=&quot;sh&quot;><div class=&quot;si&quot;>👀</div><h3>プレビューで確認</h3></div><p>右側に<b>受講生が解く画面</b>がそのまま表示されます。種別（単一／複数／記述）は自動判定。<code>[複数]</code>などで明示もできます。「要確認」が出たら正解の<code>*</code>付け忘れがないか確認を。</p></div>'
 +'<div class=&quot;step&quot; data-n=&quot;3&quot;><div class=&quot;sh&quot;><div class=&quot;si&quot;>🎁</div><h3>受講生用に書き出す</h3></div><p>「<b>受講生用HTMLを書き出す</b>」を押すと、<b>完全オフラインの単一HTML</b>が保存されます。ネット不要・インストール不要で、ダブルクリックで開けます。</p></div>'
 +'<div class=&quot;step&quot; data-n=&quot;4&quot;><div class=&quot;sh&quot;><div class=&quot;si&quot;>📤</div><h3>受講生に配布</h3></div><p>そのHTMLを<b>共有・配布</b>するだけ。受講生は解いて即採点＆解説が見られます。途中経過はブラウザに保存されます。</p></div>'
 +'</div>'
 +'<h2 class=&quot;sec&quot;>🔁 作った問題を再編集するには</h2>'
 +'<div class=&quot;note&quot;><h4>JSONで保存・読込</h4>「<code>💾 JSON保存</code>」で作問データを書き出し → 次回「<code>📂 JSON読込</code>」で読み込めば、入力内容ごと復元して編集を続けられます。チームでの引き継ぎや版管理にも便利です。</div>'
 +'<h2 class=&quot;sec&quot;>💡 ちょっとしたコツ</h2>'
 +'<div class=&quot;note&quot;><h4>速く・崩さず作る</h4>・<code>@class 基礎クラス</code>／<code>@class 応用クラス</code> で問題を分けると、上部に絞り込みが出て、<b>「📦 クラス別に一括書き出し」</b>で基礎用・応用用のファイルを一度に作れます。<br>・<code>@cat</code> でカテゴリを切り替えると、受講生画面に色付きフィルタが自動生成されます。<br>・Excel貼り付けは<b>セルをコピー（タブ区切り）</b>が最も安全。CSVは解説中の読点で崩れることがあります。<br>・言語は右上で切替。<b>日本語＝オレンジ／英語＝イギリス調ペール</b>に配色が変わり、書き出すHTMLも選んだ言語・配色になります。</div>',
en:'<div class=&quot;steps&quot;>'
 +'<div class=&quot;step&quot; data-n=&quot;1&quot;><div class=&quot;sh&quot;><div class=&quot;si&quot;>✏️</div><h3>Write questions</h3></div><p>Type on the left <b>like plain notes</b>, or paste cells from <b>Excel</b>. <code>#</code> starts a question, <code>-</code> is an option, <code>*</code> marks the correct one, <code>=</code> is a free-text answer, <code>></code> is an explanation. See the “Formatting guide” on the Author screen for details.</p></div>'
 +'<div class=&quot;step&quot; data-n=&quot;2&quot;><div class=&quot;sh&quot;><div class=&quot;si&quot;>👀</div><h3>Check the preview</h3></div><p>The right side shows <b>exactly what students see</b>. The type (single / multiple / text) is auto-detected; you can force it with <code>[multi]</code> etc. If a “to check” warning appears, make sure you didn\'t forget a <code>*</code> on the correct option.</p></div>'
 +'<div class=&quot;step&quot; data-n=&quot;3&quot;><div class=&quot;sh&quot;><div class=&quot;si&quot;>🎁</div><h3>Export for students</h3></div><p>Click “<b>Export student HTML</b>” to save a <b>fully offline single HTML file</b>. No internet, no install — students just double-click to open it.</p></div>'
 +'<div class=&quot;step&quot; data-n=&quot;4&quot;><div class=&quot;sh&quot;><div class=&quot;si&quot;>📤</div><h3>Distribute</h3></div><p>Simply <b>share that HTML file</b>. Students answer and get instant scoring and explanations. Their progress is saved in the browser.</p></div>'
 +'</div>'
 +'<h2 class=&quot;sec&quot;>🔁 Re-editing your questions</h2>'
 +'<div class=&quot;note&quot;><h4>Save &amp; load JSON</h4>Click “<code>💾 Save JSON</code>” to export your authoring data, then “<code>📂 Load JSON</code>” next time to restore everything and keep editing. Handy for handover and version control.</div>'
 +'<h2 class=&quot;sec&quot;>💡 Tips</h2>'
 +'<div class=&quot;note&quot;><h4>Fast and clean</h4>· Split questions with <code>@class Basic</code> / <code>@class Advanced</code>; a class filter appears at the top and <b>“📦 Export each class”</b> creates one file per class at once.<br>· Switching categories with <code>@cat</code> auto-generates colored filters in the student view.<br>· For Excel, <b>copying cells (tab-separated)</b> is safest; CSV can break on commas inside explanations.<br>· Switch language at the top right. <b>Japanese = orange / English = British pale</b>, and the exported HTML follows the chosen language and palette.</div>'
};

function tt(k){var v=T[LANG][k];return typeof v===&quot;function&quot;?v:v;}
function applyLang(){
  document.body.className=&quot;theme-&quot;+LANG;
  document.documentElement.lang=LANG;
  document.getElementById(&quot;lng-ja&quot;).classList.toggle(&quot;on&quot;,LANG===&quot;ja&quot;);
  document.getElementById(&quot;lng-en&quot;).classList.toggle(&quot;on&quot;,LANG===&quot;en&quot;);
  var nodes=document.querySelectorAll(&quot;[data-i18n]&quot;);
  for(var i=0;i<nodes.length;i++){var k=nodes[i].getAttribute(&quot;data-i18n&quot;);if(T[LANG][k]!=null&amp;&amp;typeof T[LANG][k]===&quot;string&quot;)nodes[i].textContent=T[LANG][k];}
  var phs=document.querySelectorAll(&quot;[data-i18n-ph]&quot;);
  for(var j=0;j<phs.length;j++){var pk=phs[j].getAttribute(&quot;data-i18n-ph&quot;);if(T[LANG][pk]!=null)phs[j].setAttribute(&quot;placeholder&quot;,T[LANG][pk]);}
  document.getElementById(&quot;cheat-body&quot;).innerHTML=CHEAT[LANG];
  document.getElementById(&quot;howto-body&quot;).innerHTML=HOWTO[LANG];
}
function setLang(l){LANG=l;applyLang();render();save();}

/* ---------------- parser (verified) ---------------- */
function detectFormat(text){
  var lines=text.split(/\r?\n/).filter(function(l){return l.trim()!==&quot;&quot;;});
  if(!lines.length)return &quot;memo&quot;;
  var tabbed=lines.filter(function(l){return l.indexOf(&quot;\t&quot;)>=0;}).length;
  if(tabbed>=Math.max(1,Math.floor(lines.length*0.6)))return &quot;tsv&quot;;
  var first=lines[0];
  if(/問題|Question|Type/i.test(first)&amp;&amp;first.indexOf(&quot;,&quot;)>=0&amp;&amp;first.indexOf(&quot;\t&quot;)<0)return &quot;tsv&quot;;
  return &quot;memo&quot;;
}
function mdInline(s){s=String(s).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;);
  s=s.replace(/`([^`]+)`/g,'<code>$1</code>');s=s.replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>');return s;}
function parseMemo(text){
  var lines=text.split(/\r?\n/),out=[],cur=null,curCat=&quot;&quot;,curClass=&quot;&quot;;
  function commit(){if(cur){finalize(cur);out.push(cur);cur=null;}}
  function finalize(q){
    if(q.answers.length){q.type=&quot;input&quot;;q.ans=q.answers.slice();}
    else{var correct=[];q.opts.forEach(function(o,i){if(o.correct)correct.push(i);});
      if(q.forced===&quot;multi&quot;)q.type=&quot;multi&quot;;else if(q.forced===&quot;single&quot;)q.type=&quot;single&quot;;else q.type=correct.length>=2?&quot;multi&quot;:&quot;single&quot;;
      q.ans=correct;q.opts=q.opts.map(function(o){return o.text;});}
    q.text=q.text.trim();
    q.explain=q.explain.trim()?q.explain.trim().split(/\n/).map(function(l){return mdInline(l);}).join(&quot;<br>&quot;):&quot;&quot;;
  }
  for(var i=0;i<lines.length;i++){var t=lines[i].trim();if(t===&quot;&quot;)continue;
    var mClass=t.match(/^[@＠](?:class|クラス)\s+(.+)$/i);if(mClass){commit();curClass=mClass[1].trim();continue;}
    var mCat=t.match(/^[@＠]cat\s+(.+)$/);if(mCat){commit();curCat=mCat[1].trim();continue;}
    if(/^#/.test(t)){commit();var qt=t.replace(/^#+\s?/,&quot;&quot;),forced=null;
      var fm=qt.match(/^\[(複数|単一|記述|multi|single|input)\]\s*/i);
      if(fm){var f=fm[1].toLowerCase();forced=(f===&quot;複数&quot;||f===&quot;multi&quot;)?&quot;multi&quot;:(f===&quot;記述&quot;||f===&quot;input&quot;)?&quot;input&quot;:&quot;single&quot;;qt=qt.slice(fm[0].length);}
      cur={cls:curClass,cat:curCat,text:qt,type:&quot;single&quot;,forced:forced,opts:[],answers:[],ans:[],explain:&quot;&quot;};if(forced===&quot;input&quot;)cur.type=&quot;input&quot;;continue;}
    if(cur){
      if(/^[\-・]\s*/.test(t)&amp;&amp;cur.forced!==&quot;input&quot;&amp;&amp;!cur.answers.length){var correct=false,body=t.replace(/^[\-・]\s*/,&quot;&quot;);
        if(/^\*/.test(body)){correct=true;body=body.replace(/^\*\s*/,&quot;&quot;);}cur.opts.push({text:body.trim(),correct:correct});continue;}
      if(/^=\s*/.test(t)){cur.answers.push(t.replace(/^=\s*/,&quot;&quot;).trim());continue;}
      if(/^>\s?/.test(t)){cur.explain+=(cur.explain?&quot;\n&quot;:&quot;&quot;)+t.replace(/^>\s?/,&quot;&quot;);continue;}
      if(!cur.opts.length&amp;&amp;!cur.answers.length){cur.text+=&quot;\n&quot;+t;}else{cur.explain+=(cur.explain?&quot;\n&quot;:&quot;&quot;)+t;}
    }
  }
  commit();return out;
}
function splitTabOrCsv(line){if(line.indexOf(&quot;\t&quot;)>=0)return line.split(&quot;\t&quot;);
  var res=[],cur=&quot;&quot;,q=false;for(var i=0;i<line.length;i++){var c=line[i];
    if(c==='&quot;'){if(q&amp;&amp;line[i+1]==='&quot;'){cur+='&quot;';i++;}else q=!q;}else if(c===&quot;,&quot;&amp;&amp;!q){res.push(cur);cur=&quot;&quot;;}else cur+=c;}
  res.push(cur);return res;}
function parseTSV(text){
  var rows=text.split(/\r?\n/).filter(function(l){return l.trim()!==&quot;&quot;;}).map(splitTabOrCsv);if(!rows.length)return [];
  var head=rows[0].map(function(c){return c.trim();});
  var hasHeader=head.some(function(c){return c===&quot;問題文&quot;||c===&quot;カテゴリ&quot;||c===&quot;種別&quot;||c===&quot;クラス&quot;||/^選択肢/.test(c)||c===&quot;正解&quot;||c===&quot;解説&quot;||/^Question$/i.test(c)||/^Category$/i.test(c)||/^Type$/i.test(c)||/^Class$/i.test(c)||/^Level$/i.test(c)||/^Option/i.test(c)||/^Answer$/i.test(c)||/^Explanation$/i.test(c);});
  var idx,dataRows;
  if(hasHeader){idx={cls:-1,cat:-1,type:-1,text:-1,opts:[],ans:-1,exp:-1};
    head.forEach(function(c,i){
      if(/^クラス$|^Class$|^Level$|レベル/i.test(c))idx.cls=i;
      else if(/カテゴリ|分類|Category/i.test(c))idx.cat=i;
      else if(/種別|タイプ|形式|Type/i.test(c))idx.type=i;
      else if(/問題文|問題|Question/i.test(c))idx.text=i;
      else if(/選択肢|選択|Option/i.test(c))idx.opts.push(i);
      else if(/正解|解答|答え|Answer/i.test(c))idx.ans=i;
      else if(/解説|説明|Explanation/i.test(c))idx.exp=i;});
    dataRows=rows.slice(1);}
  else{idx={cls:-1,cat:0,type:1,text:2,opts:[3,4,5,6,7],ans:8,exp:9};dataRows=rows;}
  var out=[];
  dataRows.forEach(function(r){function g(i){return(i>=0&amp;&amp;i<r.length)?String(r[i]).trim():&quot;&quot;;}
    var text=g(idx.text);if(!text)return;
    var typeStr=g(idx.type),cat=g(idx.cat),cls=g(idx.cls),exp=g(idx.exp),opts=idx.opts.map(g).filter(function(x){return x!==&quot;&quot;;}),ansStr=g(idx.ans),type;
    if(/記述|input|記入|text/i.test(typeStr))type=&quot;input&quot;;
    else if(/複数|multi/i.test(typeStr))type=&quot;multi&quot;;
    else if(/単一|single/i.test(typeStr))type=&quot;single&quot;;
    else type=opts.length?(/[,、]/.test(ansStr)?&quot;multi&quot;:&quot;single&quot;):&quot;input&quot;;
    var q={cls:cls,cat:cat,text:text,type:type,opts:[],ans:[],explain:exp?mdInline(exp):&quot;&quot;};
    if(type===&quot;input&quot;){q.ans=ansStr.split(/[;；]/).map(function(s){return s.trim();}).filter(Boolean);if(!q.ans.length&amp;&amp;ansStr)q.ans=[ansStr];}
    else{q.opts=opts;q.ans=ansStr.split(/[,、\s]+/).map(function(s){return parseInt(s,10)-1;}).filter(function(n){return n>=0&amp;&amp;n<opts.length;});}
    out.push(q);});
  return out;
}
function parse(text){var f=fmt;if(f===&quot;auto&quot;)f=detectFormat(text);
  document.getElementById(&quot;fmt-detected&quot;).textContent= text.trim()?(tt(&quot;detPrefix&quot;)+(f===&quot;tsv&quot;?tt(&quot;detTsv&quot;):tt(&quot;detMemo&quot;))):&quot;&quot;;
  return f===&quot;tsv&quot;?parseTSV(text):parseMemo(text);}

/* ---------------- build student HTML ---------------- */
function escAttr(s){return String(s==null?&quot;&quot;:s).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;).replace(/&quot;/g,&quot;&amp;quot;&quot;);}
function buildQuizHTML(data,meta){
  var css=document.getElementById(&quot;quiz-css&quot;).textContent;
  var js=document.getElementById(&quot;quiz-js&quot;).textContent;
  var body=document.getElementById(&quot;quiz-body&quot;).textContent;
  var theme=meta.lang===&quot;en&quot;?&quot;en&quot;:&quot;ja&quot;;
  var p=[];
  p.push('<!DOCTYPE html><html lang=&quot;'+(meta.lang||&quot;ja&quot;)+'&quot;><head><meta charset=&quot;UTF-8&quot;>');
  p.push('<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>');
  p.push('<title>'+escAttr(meta.title)+'</title><style>'+css+'</style></head>');
  p.push('<body class=&quot;theme-'+theme+'&quot;>'+body);
  p.push('<scr'+'ipt>window.QUIZ_DATA='+JSON.stringify(data)+';window.QUIZ_META='+JSON.stringify(meta)+';\n'+js+'</scr'+'ipt>');
  p.push('</body></html>');
  return p.join(&quot;&quot;);
}

/* ---------------- render ---------------- */
function classesOf(data){var seen=[];data.forEach(function(q){var c=q.cls&amp;&amp;q.cls.trim();if(c&amp;&amp;seen.indexOf(c)<0)seen.push(c);});return seen;}
function classFiltered(data,cls){if(!cls||cls===&quot;all&quot;)return data;return data.filter(function(q){return (q.cls&amp;&amp;q.cls.trim())===cls;});}
function metaFor(cls){
  var base=document.getElementById(&quot;courseTitle&quot;).value.trim()||(LANG===&quot;en&quot;?&quot;Quiz&quot;:&quot;演習&quot;);
  var title=base;
  if(cls&amp;&amp;cls!==&quot;all&quot;)title=LANG===&quot;en&quot;?(base+&quot; — &quot;+cls):(base+&quot;【&quot;+cls+&quot;】&quot;);
  return {title:title,lang:LANG};
}
function getMeta(){return metaFor(curClass);}
function renderClassBar(classes){
  var bar=document.getElementById(&quot;class-bar&quot;);
  if(!classes.length){bar.className=&quot;class-bar hidden&quot;;bar.innerHTML=&quot;&quot;;if(curClass!==&quot;all&quot;)curClass=&quot;all&quot;;return;}
  if(curClass!==&quot;all&quot;&amp;&amp;classes.indexOf(curClass)<0)curClass=&quot;all&quot;;
  var counts={};lastData.forEach(function(q){var c=(q.cls&amp;&amp;q.cls.trim())||&quot;&quot;;if(c)counts[c]=(counts[c]||0)+1;});
  var h='<span class=&quot;cl-lbl&quot;>'+tt(&quot;classLabel&quot;)+'</span>';
  h+='<button class=&quot;cl-chip '+(curClass===&quot;all&quot;?&quot;on&quot;:&quot;&quot;)+'&quot; onclick=&quot;setClass(\'all\')&quot;>'+tt(&quot;classAll&quot;)+'<span class=&quot;n&quot;>'+lastData.length+'</span></button>';
  classes.forEach(function(c){
    h+='<button class=&quot;cl-chip '+(curClass===c?&quot;on&quot;:&quot;&quot;)+'&quot; onclick=&quot;setClass(this.dataset.c)&quot; data-c=&quot;'+c.replace(/&quot;/g,&quot;&amp;quot;&quot;)+'&quot;>'+c+'<span class=&quot;n&quot;>'+(counts[c]||0)+'</span></button>';
  });
  bar.className=&quot;class-bar&quot;;bar.innerHTML=h;
}
function setClass(c){curClass=c;render();}
function render(){
  var text=document.getElementById(&quot;src&quot;).value,data;
  try{data=parse(text);}catch(e){lastData=[];showStatus(&quot;err&quot;,tt(&quot;stErr&quot;)(e.message),0,0);return;}
  lastData=data;
  var classes=classesOf(data);
  renderClassBar(classes);
  var warn=0;
  data.forEach(function(q){
    if((q.type===&quot;single&quot;||q.type===&quot;multi&quot;)&amp;&amp;(!q.ans||!q.ans.length))warn++;
    if(q.type===&quot;input&quot;&amp;&amp;(!q.ans||!q.ans.length))warn++;
    if((q.type===&quot;single&quot;||q.type===&quot;multi&quot;)&amp;&amp;q.opts.length<2)warn++;});
  var shown=classFiltered(data,curClass);
  var html=shown.length?buildQuizHTML(shown,metaFor(curClass)):&quot;&quot;;
  var pv=document.getElementById(&quot;pv&quot;),pv2=document.getElementById(&quot;pv2&quot;),empty=document.getElementById(&quot;pvEmpty&quot;);
  if(shown.length){empty.classList.add(&quot;hidden&quot;);pv.classList.remove(&quot;hidden&quot;);pv.srcdoc=html;pv2.srcdoc=html;}
  else{empty.classList.remove(&quot;hidden&quot;);pv.classList.add(&quot;hidden&quot;);pv2.srcdoc=&quot;&quot;;}
  document.getElementById(&quot;qcount&quot;).textContent=shown.length;
  document.getElementById(&quot;prev-sub&quot;).textContent=tt(&quot;subTotal&quot;)(metaFor(curClass).title,shown.length);
  // class breakdown string
  var brk=&quot;&quot;;
  if(classes.length){var counts={};data.forEach(function(q){var c=(q.cls&amp;&amp;q.cls.trim())||&quot;&quot;;if(c)counts[c]=(counts[c]||0)+1;});
    brk=&quot; ／ &quot;+classes.map(function(c){return c+&quot;:&quot;+counts[c];}).join(LANG===&quot;en&quot;?&quot;, &quot;:&quot;、&quot;);}
  if(!text.trim())showStatus(&quot;ok&quot;,tt(&quot;stReady&quot;),0,0);
  else if(!data.length)showStatus(&quot;warn&quot;,tt(&quot;stNone&quot;),0,warn);
  else if(warn)showStatus(&quot;warn&quot;,tt(&quot;stWarn&quot;)(warn)+brk,data.length,warn);
  else showStatus(&quot;ok&quot;,tt(&quot;stOk&quot;)+brk,data.length,warn);
  save();
}
function showStatus(kind,msg,count,warn){
  var pill=document.getElementById(&quot;st-pill&quot;);
  pill.className=&quot;pill &quot;+(kind===&quot;err&quot;?&quot;err&quot;:kind===&quot;warn&quot;?&quot;warn&quot;:&quot;ok&quot;);
  pill.textContent=count+&quot; &quot;+tt(&quot;qUnit&quot;)+(warn?tt(&quot;warnUnit&quot;)(warn):&quot;&quot;);
  document.getElementById(&quot;st-msg&quot;).textContent=msg;
}

/* ---------------- toolbar ---------------- */
function setFmt(f){fmt=f;[&quot;auto&quot;,&quot;memo&quot;,&quot;tsv&quot;].forEach(function(x){document.getElementById(&quot;f-&quot;+x).classList.toggle(&quot;on&quot;,x===f);});render();}
function switchTab(t){[&quot;edit&quot;,&quot;prev&quot;,&quot;howto&quot;].forEach(function(x){
  document.getElementById(&quot;tab-&quot;+x).classList.toggle(&quot;on&quot;,x===t);
  document.getElementById(&quot;pane-&quot;+x).classList.toggle(&quot;on&quot;,x===t);});}
function clearSrc(){if(confirm(tt(&quot;confirmClear&quot;))){document.getElementById(&quot;src&quot;).value=&quot;&quot;;render();}}
function download(filename,text,mime){var blob=new Blob([text],{type:mime||&quot;text/plain;charset=utf-8&quot;});
  var a=document.createElement(&quot;a&quot;);a.href=URL.createObjectURL(blob);a.download=filename;
  document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},800);}
function safeName(s){return (s||&quot;quiz&quot;).replace(/[\\/:*?&quot;<>|]/g,&quot;_&quot;).slice(0,50);}
function exportStudentHTML(){if(!lastData.length){alert(tt(&quot;noData&quot;));return;}
  var shown=classFiltered(lastData,curClass);if(!shown.length){alert(tt(&quot;noData&quot;));return;}
  var meta=metaFor(curClass);
  var prefix=LANG===&quot;en&quot;?&quot;[Student] &quot;:&quot;【受講生用】&quot;;var suffix=LANG===&quot;en&quot;?&quot;_practice.html&quot;:&quot;_演習.html&quot;;
  download(prefix+safeName(meta.title)+suffix,buildQuizHTML(shown,meta),&quot;text/html;charset=utf-8&quot;);}
function exportByClass(){
  if(!lastData.length){alert(tt(&quot;noData&quot;));return;}
  var classes=classesOf(lastData);
  var prefix=LANG===&quot;en&quot;?&quot;[Student] &quot;:&quot;【受講生用】&quot;;var suffix=LANG===&quot;en&quot;?&quot;_practice.html&quot;:&quot;_演習.html&quot;;
  if(!classes.length){ // クラス未設定 → 1ファイルだけ
    var m0=metaFor(&quot;all&quot;);download(prefix+safeName(m0.title)+suffix,buildQuizHTML(lastData,m0),&quot;text/html;charset=utf-8&quot;);
    alert(tt(&quot;byClassNone&quot;));return;}
  classes.forEach(function(c,i){
    var data=classFiltered(lastData,c);if(!data.length)return;var m=metaFor(c);
    setTimeout(function(){download(prefix+safeName(m.title)+suffix,buildQuizHTML(data,m),&quot;text/html;charset=utf-8&quot;);},i*350);
  });
  setTimeout(function(){alert(tt(&quot;byClassDone&quot;)(classes.length));},classes.length*350+100);
}
function exportJSON(){var payload={app:&quot;usausa_quiz_maker&quot;,version:2,lang:LANG,curClass:curClass,meta:metaFor(&quot;all&quot;),format:fmt,source:document.getElementById(&quot;src&quot;).value,data:lastData};
  download(safeName(metaFor(&quot;all&quot;).title)+(LANG===&quot;en&quot;?&quot;_quiz.json&quot;:&quot;_作問データ.json&quot;),JSON.stringify(payload,null,2),&quot;application/json&quot;);}
function importJSON(ev){var file=ev.target.files[0];if(!file)return;var r=new FileReader();
  r.onload=function(){try{var p=JSON.parse(r.result);
    if(p.lang){LANG=p.lang;applyLang();}
    if(p.curClass)curClass=p.curClass;
    if(p.meta&amp;&amp;p.meta.title)document.getElementById(&quot;courseTitle&quot;).value=p.meta.title;
    if(p.format)setFmt(p.format);
    document.getElementById(&quot;src&quot;).value=p.source||&quot;&quot;;render();
  }catch(e){alert(tt(&quot;importErr&quot;)(e.message));}};r.readAsText(file);ev.target.value=&quot;&quot;;}
function exportExcelTemplate(){
  var rows=LANG===&quot;en&quot;?[
    [&quot;Class&quot;,&quot;Category&quot;,&quot;Type&quot;,&quot;Question&quot;,&quot;Option1&quot;,&quot;Option2&quot;,&quot;Option3&quot;,&quot;Option4&quot;,&quot;Option5&quot;,&quot;Answer&quot;,&quot;Explanation&quot;],
    [&quot;Basic&quot;,&quot;Commands&quot;,&quot;single&quot;,&quot;Which shows section 1 of the man page?&quot;,&quot;man command(1)&quot;,&quot;man 1 command&quot;,&quot;man -s 1 command&quot;,&quot;&quot;,&quot;&quot;,&quot;2&quot;,&quot;Section number comes first.&quot;],
    [&quot;Basic&quot;,&quot;Redirection&quot;,&quot;multi&quot;,&quot;Which are valid redirection operators? (2)&quot;,&quot;2>&amp;1&quot;,&quot;%>&quot;,&quot;<&quot;,&quot;>>>&quot;,&quot;&quot;,&quot;1,3&quot;,&quot;2>&amp;1 = stderr to stdout / < = stdin.&quot;],
    [&quot;Advanced&quot;,&quot;Commands&quot;,&quot;input&quot;,&quot;Which command updates the locate DB?&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;updatedb&quot;,&quot;Run by cron automatically.&quot;]
  ]:[
    [&quot;クラス&quot;,&quot;カテゴリ&quot;,&quot;種別&quot;,&quot;問題文&quot;,&quot;選択肢1&quot;,&quot;選択肢2&quot;,&quot;選択肢3&quot;,&quot;選択肢4&quot;,&quot;選択肢5&quot;,&quot;正解&quot;,&quot;解説&quot;],
    [&quot;基礎クラス&quot;,&quot;コマンド基礎&quot;,&quot;単一&quot;,&quot;manでセクション1を表示するコマンドは？&quot;,&quot;man command(1)&quot;,&quot;man 1 command&quot;,&quot;man -s 1 command&quot;,&quot;&quot;,&quot;&quot;,&quot;2&quot;,&quot;セクション番号が先。&quot;],
    [&quot;基礎クラス&quot;,&quot;リダイレクト&quot;,&quot;複数&quot;,&quot;有効なリダイレクト演算子は？（2つ）&quot;,&quot;2>&amp;1&quot;,&quot;%>&quot;,&quot;<&quot;,&quot;>>>&quot;,&quot;&quot;,&quot;1,3&quot;,&quot;2>&amp;1=stderrをstdoutへ / <=標準入力。&quot;],
    [&quot;応用クラス&quot;,&quot;コマンド基礎&quot;,&quot;記述&quot;,&quot;locateのDBを更新するコマンドは？&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;updatedb&quot;,&quot;cronで自動実行。&quot;]
  ];
  var csv=rows.map(function(r){return r.map(function(c){c=String(c);return /[&quot;,\n]/.test(c)?'&quot;'+c.replace(/&quot;/g,'&quot;&quot;')+'&quot;':c;}).join(&quot;,&quot;);}).join(&quot;\r\n&quot;);
  download((LANG===&quot;en&quot;?&quot;usausa_template.csv&quot;:&quot;うさうさ作問テンプレート.csv&quot;),&quot;\ufeff&quot;+csv,&quot;text/csv;charset=utf-8&quot;);}

/* ---------------- sample ---------------- */
var SAMPLE_JA=
&quot;@class 基礎クラス\n@cat コマンド基礎\n\n# manコマンドでセクション1のマニュアルを表示するのはどれ？\n- man command(1)\n- *man 1 command\n- man -s 1 command\n- man command@1\n> manは `man [セクション番号] コマンド名` の順。\n> 1=ユーザーコマンド / 5=設定ファイル / 8=管理コマンド。\n\n&quot;+
&quot;# [記述] locateコマンドが使うデータベースを更新するプログラムは？\n= updatedb\n> **find** はリアルタイム走査、**locate** は事前DBを高速検索。DB更新は `updatedb`。\n\n&quot;+
&quot;@cat リダイレクト\n\n# fooの出力を画面に出しつつ /tmp/foodata にも書き込むのは？\n- foo | cp /tmp/foodata\n- *foo | tee /tmp/foodata\n- foo > /tmp/foodata\n> `tee` はT字管。標準入力を「画面」と「ファイル」の両方へ。追記は `tee -a`。\n\n&quot;+
&quot;@class 応用クラス\n@cat リダイレクト\n\n# [複数] bashで有効なリダイレクト演算子はどれ？（2つ選択）\n- *2>&amp;1\n- %>\n- *<\n- >>>\n- #>\n> `2>&amp;1`=標準エラーを標準出力へ。`<`=標準入力。`%> >>> #>` は無効。\n\n&quot;+
&quot;@cat viエディタ\n\n# viで現在行と次の行の2行を削除するコマンドは？\n- 2d\n- *2dd\n- dd2\n> 数字は「コマンドの前」。`2dd`=2行削除、`2yy`=2行コピー。&quot;;
var SAMPLE_EN=
&quot;@class Basic\n@cat Commands\n\n# Which command shows section 1 of the man page?\n- man command(1)\n- *man 1 command\n- man -s 1 command\n- man command@1\n> man uses `man [section] command`.\n> 1=user commands / 5=config files / 8=admin commands.\n\n&quot;+
&quot;# [input] Which program updates the database used by locate?\n= updatedb\n> **find** scans in real time; **locate** searches a prebuilt DB. Update it with `updatedb`.\n\n&quot;+
&quot;@cat Redirection\n\n# Which writes foo's output to screen AND /tmp/foodata at the same time?\n- foo | cp /tmp/foodata\n- *foo | tee /tmp/foodata\n- foo > /tmp/foodata\n> `tee` is a T-pipe: send stdin to both screen and file. Append with `tee -a`.\n\n&quot;+
&quot;@class Advanced\n@cat Redirection\n\n# [multi] Which are valid redirection operators in bash? (choose 2)\n- *2>&amp;1\n- %>\n- *<\n- >>>\n- #>\n> `2>&amp;1` sends stderr to stdout. `<` is stdin. `%> >>> #>` are invalid.\n\n&quot;+
&quot;@cat vi editor\n\n# Which command deletes the current line and the next (2 lines)?\n- 2d\n- *2dd\n- dd2\n> The count goes BEFORE the command. `2dd` deletes 2 lines, `2yy` yanks 2.&quot;;
function loadSample(){setFmt(&quot;memo&quot;);
  document.getElementById(&quot;courseTitle&quot;).value=tt(&quot;sampleTitle&quot;);
  document.getElementById(&quot;src&quot;).value=LANG===&quot;en&quot;?SAMPLE_EN:SAMPLE_JA;render();}

/* ---------------- autosave ---------------- */
function save(){try{localStorage.setItem(SAVE_KEY,JSON.stringify({t:document.getElementById(&quot;courseTitle&quot;).value,f:fmt,l:LANG,c:curClass,s:document.getElementById(&quot;src&quot;).value}));}catch(e){}}
function load(){try{var p=JSON.parse(localStorage.getItem(SAVE_KEY)||&quot;null&quot;);if(p){if(p.l)LANG=p.l;if(p.c)curClass=p.c;if(p.t)document.getElementById(&quot;courseTitle&quot;).value=p.t;if(p.f)fmt=p.f;document.getElementById(&quot;src&quot;).value=p.s||&quot;&quot;;}}catch(e){}}

/* ---------------- boot ---------------- */
load();
applyLang();
[&quot;auto&quot;,&quot;memo&quot;,&quot;tsv&quot;].forEach(function(x){document.getElementById(&quot;f-&quot;+x).classList.toggle(&quot;on&quot;,x===fmt);});
document.getElementById(&quot;src&quot;).addEventListener(&quot;input&quot;,render);
document.getElementById(&quot;courseTitle&quot;).addEventListener(&quot;input&quot;,render);
if(!document.getElementById(&quot;src&quot;).value.trim()){loadSample();}else{render();}
</script>
</body>
</html>
"></iframe>
  </div>
<script>
function resizeFrame(id){
  try{
    var f=document.getElementById(id);
    var d=f.contentDocument;
    if(d&&d.body){ f.style.height=Math.max(d.body.scrollHeight, d.documentElement.scrollHeight)+40+"px"; }
  }catch(e){}
}
function switchMode(mode){
  var tabs=document.querySelectorAll(".modetab");
  for(var i=0;i<tabs.length;i++){ tabs[i].classList.toggle("active", tabs[i].getAttribute("data-mode")===mode); }
  document.getElementById("frm-nip").classList.toggle("active", mode==="nip");
  document.getElementById("frm-fact").classList.toggle("active", mode==="fact");
  document.getElementById("frm-qa").classList.toggle("active", mode==="qa");
  document.getElementById("frm-v26").classList.toggle("active", mode==="v26");
  document.getElementById("frm-quiz").classList.toggle("active", mode==="quiz");
  document.getElementById("frm-web").classList.toggle("active", mode==="web");
  document.getElementById("frm-intake").classList.toggle("active", mode==="intake");
  document.getElementById("frm-sensei").classList.toggle("active", mode==="sensei");
  document.getElementById("frm-biz").classList.toggle("active", mode==="biz");
  document.getElementById("frm-nav").classList.toggle("active", mode==="nav");
  document.getElementById("frm-fuwa").classList.toggle("active", mode==="fuwa");
  document.getElementById("frm-subt").classList.toggle("active", mode==="subt");
  document.getElementById("frm-senseiapi").classList.toggle("active", mode==="senseiapi");
  document.getElementById("frm-jira").classList.toggle("active", mode==="jira");
  document.getElementById("frm-deleg").classList.toggle("active", mode==="deleg");
  document.getElementById("frm-delegapi").classList.toggle("active", mode==="delegapi");
  document.getElementById("frm-horenso").classList.toggle("active", mode==="horenso");
  document.getElementById("frm-horensoapi").classList.toggle("active", mode==="horensoapi");
  document.getElementById("frm-timer30").classList.toggle("active", mode==="timer30");
  document.getElementById("frm-script").classList.toggle("active", mode==="script");
  document.getElementById("frm-scriptapi").classList.toggle("active", mode==="scriptapi");
  document.getElementById("frm-zenn").classList.toggle("active", mode==="zenn");
  document.getElementById("frm-exam").classList.toggle("active", mode==="exam");
  document.getElementById("frm-examapi").classList.toggle("active", mode==="examapi");
  document.getElementById("frm-facili").classList.toggle("active", mode==="facili");
  document.getElementById("frm-faciliapi").classList.toggle("active", mode==="faciliapi");
  document.getElementById("frm-consul").classList.toggle("active", mode==="consul");
  document.getElementById("frm-consulapi").classList.toggle("active", mode==="consulapi");
  document.getElementById("frm-kotei").classList.toggle("active", mode==="kotei");
  document.getElementById("frm-koteiapi").classList.toggle("active", mode==="koteiapi");
  resizeFrame("frm-"+mode);
}
// 目次から各ツールを開く
function openTool(mode){
  var home=document.getElementById("homeScreen");
  var wrap=document.getElementById("frameWrap");
  var hb=document.getElementById("homeBtn");
  if(home) home.style.display="none";
  if(wrap) wrap.classList.add("show");
  if(hb) hb.classList.add("show");
  switchMode(mode);
  window.scrollTo(0,0);
}
// 目次（ホーム）に戻る
function goHome(){
  var home=document.getElementById("homeScreen");
  var wrap=document.getElementById("frameWrap");
  var hb=document.getElementById("homeBtn");
  if(home) home.style.display="block";
  if(wrap) wrap.classList.remove("show");
  if(hb) hb.classList.remove("show");
  window.scrollTo(0,0);
}
// トップヘッダー右上の日付・時計（毎秒更新）
function tickClock(){
  var d=new Date();
  var wd=["日","月","火","水","木","金","土"][d.getDay()];
  var y=d.getFullYear(), mo=("0"+(d.getMonth()+1)).slice(-2), da=("0"+d.getDate()).slice(-2);
  var hh=("0"+d.getHours()).slice(-2), mi=("0"+d.getMinutes()).slice(-2), ss=("0"+d.getSeconds()).slice(-2);
  var cd=document.getElementById("clockDate"), ct=document.getElementById("clockTime");
  if(cd) cd.textContent=y+"年"+mo+"月"+da+"日（"+wd+"）";
  if(ct) ct.textContent=hh+":"+mi+":"+ss;
}
tickClock();
setInterval(tickClock, 1000);
// 各iframeのロード後に高さ調整。中身が動的に伸びるので定期的にも調整。
window.addEventListener("load", function(){
  ["frm-nip","frm-qa","frm-v26","frm-quiz","frm-web","frm-intake","frm-sensei","frm-biz","frm-nav","frm-fuwa","frm-subt","frm-senseiapi","frm-jira","frm-deleg","frm-delegapi","frm-horenso","frm-horensoapi","frm-timer30","frm-script","frm-scriptapi","frm-zenn","frm-exam","frm-examapi","frm-facili","frm-faciliapi","frm-consul","frm-consulapi","frm-kotei","frm-koteiapi","frm-fact"].forEach(function(id){ var f=document.getElementById(id); if(f) f.addEventListener("load", function(){ resizeFrame(id); }); });
  setInterval(function(){
    var act=document.querySelector("iframe.active"); if(act) resizeFrame(act.id);
  }, 800);
});
</script>
</body>
</html>
