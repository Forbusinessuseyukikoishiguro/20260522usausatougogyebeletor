> 🐰 *Generated by うさうさ式 IT現場ジェネレーター v2 ─ ${meta.icon} ${meta.name}*`;

  document.getElementById('k_output').textContent = md;
  document.getElementById('k_output-card').style.display = 'block';
  document.getElementById('k_output-card').scrollIntoView({behavior:'smooth', block:'nearest'});
});

