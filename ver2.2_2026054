  skParsePaste();
}

/* ===== .xlsx 最小リーダー（DecompressionStream利用・先頭シートのみ） ===== */
// 注意：書き込み用の _u16/_u32（数値→バイト配列）と名前が衝突しないよう別名にする
function _ru16(b,o){ return b[o]|(b[o+1]<<8); }
function _ru32(b,o){ return (b[o]|(b[o+1]<<8)|(b[o+2]<<16)|(b[o+3]<<24))>>>0; }
async function _inflateRaw(bytes){
  var ds=new window.DecompressionStream(&quot;deflate-raw&quot;);
  var w=ds.writable.getWriter(); w.write(bytes); w.close();
  var ab=await new Response(ds.readable).arrayBuffer();
  return new Uint8Array(ab);
}
// ZIPのローカルエントリを走査して {name: Uint8Array} を返す（STORED/deflate対応）
async function _unzip(bytes){
  var files={}, i=0, n=bytes.length;
  while(i+4<=n &amp;&amp; _ru32(bytes,i)===0x04034b50){
    var method=_ru16(bytes,i+8);
    var compSize=_ru32(bytes,i+18);
    var nameLen=_ru16(bytes,i+26);
    var extraLen=_ru16(bytes,i+28);
    var nameStart=i+30;
    var name=new TextDecoder().decode(bytes.subarray(nameStart, nameStart+nameLen));
    var dataStart=nameStart+nameLen+extraLen;
    var comp=bytes.subarray(dataStart, dataStart+compSize);
    var data;
    if(method===0){ data=comp; }
    else if(method===8){ try{ data=await _inflateRaw(comp); }catch(e){ data=null; } }
    else { data=null; }
    if(data) files[name]=data;
    i=dataStart+compSize;
  }
  return files;
}
function _xmlText(s){
  s=s.replace(/&amp;#x([0-9a-fA-F]+);/g,function(_,h){return String.fromCodePoint(parseInt(h,16));})
     .replace(/&amp;#(\d+);/g,function(_,d){return String.fromCodePoint(parseInt(d,10));});
  return s.replace(/&amp;lt;/g,&quot;<&quot;).replace(/&amp;gt;/g,&quot;>&quot;).replace(/&amp;quot;/g,'&quot;').replace(/&amp;apos;/g,&quot;'&quot;).replace(/&amp;amp;/g,&quot;&amp;&quot;);
}
async function _xlsxToRows(bytes){
  var files=await _unzip(bytes);
  if(!files[&quot;xl/worksheets/sheet1.xml&quot;]) return [];
  var dec=new TextDecoder();
  // sharedStrings
  var shared=[];
  if(files[&quot;xl/sharedStrings.xml&quot;]){
    var sx=dec.decode(files[&quot;xl/sharedStrings.xml&quot;]);
    sx.replace(/<si>([\s\S]*?)<\/si>/g, function(_,inner){
      var txt=&quot;&quot;; inner.replace(/<t[^>]*>([\s\S]*?)<\/t>/g, function(__,t){ txt+=t; return &quot;&quot;; });
      shared.push(_xmlText(txt)); return &quot;&quot;;
    });
  }
  var sheet=dec.decode(files[&quot;xl/worksheets/sheet1.xml&quot;]);
  var rows=[];
  sheet.replace(/<row[^>]*>([\s\S]*?)<\/row>/g, function(_,rowXml){
    var cells=[];
    rowXml.replace(/<c([^>]*)>([\s\S]*?)<\/c>/g, function(__,attr,cv){
      var tMatch=/t=&quot;([^&quot;]+)&quot;/.exec(attr);
      var t=tMatch?tMatch[1]:&quot;&quot;;
      var val=&quot;&quot;;
      if(t===&quot;inlineStr&quot;){
        // <is><t>...</t></is>（複数tも連結）
        cv.replace(/<t[^>]*>([\s\S]*?)<\/t>/g, function(_2,tt){ val+=tt; return &quot;&quot;; });
        val=_xmlText(val);
      } else {
        var vMatch=/<v>([\s\S]*?)<\/v>/.exec(cv);
        val=vMatch?vMatch[1]:&quot;&quot;;
        if(t===&quot;s&quot;){ val=shared[parseInt(val,10)]||&quot;&quot;; }
        else { val=_xmlText(val); }
      }
      cells.push(val);
      return &quot;&quot;;
    });
    rows.push(cells);
    return &quot;&quot;;
  });
  return rows;
}

function _parseCsv(text){
  text=text.replace(/^\uFEFF/,&quot;&quot;);
  var rows=[], row=[], cur=&quot;&quot;, inq=false;
  for(var i=0;i<text.length;i++){
    var ch=text[i];
    if(inq){
      if(ch==='&quot;'){ if(text[i+1]==='&quot;'){ cur+='&quot;'; i++; } else { inq=false; } }
      else { cur+=ch; }
    } else {
      if(ch==='&quot;'){ inq=true; }
      else if(ch===','){ row.push(cur); cur=&quot;&quot;; }
      else if(ch==='\n'){ row.push(cur); rows.push(row); row=[]; cur=&quot;&quot;; }
      else if(ch==='\r'){ /* skip */ }
      else { cur+=ch; }
    }
  }
  if(cur.length||row.length){ row.push(cur); rows.push(row); }
  return rows.filter(function(r){ return r.some(function(c){return c!==&quot;&quot;;}); });
}
var KIND_FROM_LABEL={&quot;授業&quot;:&quot;lesson&quot;,&quot;会議&quot;:&quot;meeting&quot;,&quot;作業&quot;:&quot;work&quot;,&quot;休憩&quot;:&quot;break&quot;};
function importCsv(input){
  var file=input.files&amp;&amp;input.files[0];
  if(!file){ return; }
  var reader=new FileReader();
  reader.onload=function(){
    try{
      var rows=_parseCsv(String(reader.result));
      if(rows.length<2){ toast(&quot;データが見つかりません&quot;); return; }
      var header=rows[0].map(function(s){return s.trim();});
      var ix={};
      [&quot;日付&quot;,&quot;時限&quot;,&quot;区分&quot;,&quot;開始&quot;,&quot;終了&quot;,&quot;予定分&quot;,&quot;予定&quot;,&quot;実績&quot;,&quot;達成&quot;].forEach(function(h){ ix[h]=header.indexOf(h); });
      if(ix[&quot;日付&quot;]<0){ toast(&quot;ヘッダに「日付」がありません&quot;); return; }
      var byDate={};
      rows.slice(1).forEach(function(r){
        var date=(r[ix[&quot;日付&quot;]]||&quot;&quot;).trim(); if(!date) return;
        if(!byDate[date]) byDate[date]={date:date, periods:[]};
        var kindLabel=(ix[&quot;区分&quot;]>=0?(r[ix[&quot;区分&quot;]]||&quot;&quot;).trim():&quot;作業&quot;);
        var kind=KIND_FROM_LABEL[kindLabel];
        var customLabel=&quot;&quot;;
        if(!kind){ kind=&quot;other&quot;; customLabel=kindLabel||&quot;その他&quot;; } // 未知ラベルはその他
        byDate[date].periods.push({
          label:(ix[&quot;時限&quot;]>=0?r[ix[&quot;時限&quot;]]:&quot;&quot;)||&quot;&quot;,
          kind:kind, kindLabel:kindLabel||&quot;その他&quot;, customLabel:customLabel,
          s:(ix[&quot;開始&quot;]>=0?r[ix[&quot;開始&quot;]]:&quot;&quot;)||&quot;&quot;, e:(ix[&quot;終了&quot;]>=0?r[ix[&quot;終了&quot;]]:&quot;&quot;)||&quot;&quot;,
          plan:(ix[&quot;予定&quot;]>=0?r[ix[&quot;予定&quot;]]:&quot;&quot;)||&quot;&quot;, actual:(ix[&quot;実績&quot;]>=0?r[ix[&quot;実績&quot;]]:&quot;&quot;)||&quot;&quot;,
          status:((ix[&quot;達成&quot;]>=0?r[ix[&quot;達成&quot;]]:&quot;&quot;)||&quot;◎&quot;)||&quot;◎&quot;
        });
      });
      // 各日の集計を再計算してレコード化
      var days=Object.keys(byDate).map(function(date){ return recomputeRecord(byDate[date]); });
      days.sort(function(a,b){ return a.date<b.date?-1:(a.date>b.date?1:0); });
      // 既存とマージ（同日付は上書き）
      var existing=loadDays();
      var map={}; existing.forEach(function(d){ map[d.date]=d; });
      days.forEach(function(d){ map[d.date]=d; });
      var merged=Object.keys(map).map(function(k){return map[k];}).sort(function(a,b){return a.date<b.date?-1:(a.date>b.date?1:0);});
      storeDays(merged);
      renderDayList();
      // 最新日をフォームへ
      if(merged.length){ loadDayToForm(merged[merged.length-1].date); }
      toast(days.length+&quot;日分を取り込みました&quot;);
    }catch(e){ toast(&quot;読み込みに失敗しました&quot;); }
    input.value=&quot;&quot;;
  };
  reader.readAsText(file,&quot;UTF-8&quot;);
}
// periods配列だけのオブジェクトから、集計込みのレコードを再構築
function recomputeRecord(obj){
  var kindMin={lesson:0,meeting:0,work:0}, customMin={}, breakMin=0, slots=0, planMin=0, actMin=0, cO=0,cMaru=0,cTri=0,cBrk=0;
  (obj.periods||[]).forEach(function(p){
    var dur=p.dur;
    if(dur==null||dur===&quot;&quot;){ var sm=toMin(p.s), em=toMin(p.e); dur=(sm!=null&amp;&amp;em!=null&amp;&amp;em>sm)?(em-sm):0; }
    dur=round15(parseInt(dur,10)||0); p.dur=dur; // 15分丸め
    if(p.kind===&quot;break&quot;){ cBrk++; breakMin+=dur; return; }
    slots++; planMin+=dur;
    if(p.kind===&quot;other&quot;){ var nm=p.customLabel||p.kindLabel||&quot;その他&quot;; customMin[nm]=(customMin[nm]||0)+dur; }
    else if(kindMin[p.kind]!=null){ kindMin[p.kind]+=dur; }
    if(p.status===&quot;◎&quot;){ cO++; actMin+=dur; }
    else if(p.status===&quot;○&quot;){ cMaru++; actMin+=dur*0.5; }
    else if(p.status===&quot;△&quot;){ cTri++; }
  });
  return {
    date:obj.date, mood:obj.mood||&quot;&quot;, place:obj.place||&quot;&quot;, goal:obj.goal||&quot;&quot;, word:obj.word||&quot;&quot;,
    keep:obj.keep||&quot;&quot;, problem:obj.problem||&quot;&quot;, tryv:obj.tryv||&quot;&quot;, teacher:obj.teacher||&quot;&quot;,
    slots:slots, planMin:planMin, actMin:Math.round(actMin),
    rate: planMin>0?Math.round(actMin/planMin*100):0,
    cO:cO,cMaru:cMaru,cTri:cTri,cBrk:cBrk, kindMin:kindMin, customMin:customMin, breakMin:breakMin,
    periods:obj.periods||[]
  };
}
function _saveBlob(blob, name){
  var a=document.createElement(&quot;a&quot;);
  a.href=URL.createObjectURL(blob); a.download=name;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(a.href);
}

/* ============ スキルシート（案件欄・30日スタック） ============ */
var SK_KEY=&quot;usausa_skill_v1&quot;;
function skLoad(){
  if(!lsAvailable()) return (window.__memSkill||[]);
  try{ return JSON.parse(window.localStorage.getItem(SK_KEY)||&quot;[]&quot;); }catch(e){ return []; }
}
function skStore(arr){
  if(lsAvailable()){ try{ window.localStorage.setItem(SK_KEY, JSON.stringify(arr)); }catch(e){} }
  window.__memSkill=arr;
}
function jlen(s){ return (s||&quot;&quot;).trim().length; } // 文字数（前後空白除く）
function lines(s){ return (s||&quot;&quot;).split(&quot;\n&quot;).map(function(x){return x.trim();}).filter(Boolean); }

function skAddWork(val){
  var wrap=document.getElementById(&quot;sk_workList&quot;);
  var row=document.createElement(&quot;div&quot;); row.className=&quot;work-row&quot;;
  var idx=document.createElement(&quot;span&quot;); idx.className=&quot;idx&quot;;
  var inp=document.createElement(&quot;input&quot;); inp.className=&quot;sk-work&quot;; inp.placeholder=&quot;例：基本設計、詳細設計及び設計書作成&quot;;
  inp.value=val||&quot;&quot;; inp.addEventListener(&quot;input&quot;, skCount);
  var del=document.createElement(&quot;button&quot;); del.type=&quot;button&quot;; del.className=&quot;del&quot;; del.textContent=&quot;×&quot;;
  del.onclick=function(){ row.remove(); skRenumber(); skCount(); };
  row.appendChild(idx); row.appendChild(inp); row.appendChild(del);
  wrap.appendChild(row);
  skRenumber();
}
function skRenumber(){
  [].slice.call(document.querySelectorAll(&quot;#sk_workList .work-row .idx&quot;)).forEach(function(el,i){ el.textContent=(i+1)+&quot;.&quot;; });
}
function skReadWork(){
  return [].slice.call(document.querySelectorAll(&quot;#sk_workList .sk-work&quot;)).map(function(i){return i.value.trim();}).filter(Boolean);
}

/* ============ 30日分から下書きを作る ============ */
var SK_DRAFT={ items:[], dates:[], goals:[], kindMin:{lesson:0,meeting:0,work:0}, custom:{} };

// 作業項目の正規化：先頭の記号・チェックボックス・状態語を落とし、動詞語尾に寄せる
function normWorkItem(s){
  if(!s) return &quot;&quot;;
  s=s.replace(/^[\s　]*([\-・*※▼●□■◆◎○△➡→\u2022]|\[[ xX]?\]|\d+[\.\)）]|[#＃]\S+)\s*/,&quot;&quot;);
  s=s.replace(/[#＃]\S+/g,&quot;&quot;).trim();       // 文中タグ除去
  s=s.replace(/^(完了|対応中|未着手|未完了|done|完了：|実績：|予定：)\s*/i,&quot;&quot;);
  s=s.replace(/（[^）]*\d{1,2}:\d{2}[^）]*）/g,&quot;&quot;); // 時刻括弧除去
  s=s.replace(/[。\.]$/,&quot;&quot;).trim();
  return s;
}
function isMeaningful(s){
  if(!s) return false;
  s=s.trim();
  if(s.length<2) return false;                 // 1文字は除外（2文字の業務名「採点」「設計」等は許容）
  if(/^[\d\s:：.、,。]+$/.test(s)) return false;  // 数字・記号だけは除外
  if(/^(なし|特になし|無し|特に無し|休憩|昼休み|昼食|ー|-|—|・|済|完了|なんとなく)$/.test(s)) return false; // ノイズ語
  return true;
}

// 30日ログ（時間割保存データ）から候補を集める
function skCollectFromLog(){
  var days=loadDays();
  var items=[], dates=[], goals=[], kindMin={lesson:0,meeting:0,work:0}, custom={};
  days.forEach(function(d){
    if(d.date) dates.push(d.date);
    if(d.goal) goals.push(d.goal);
    if(d.kindMin){ kindMin.lesson+=d.kindMin.lesson||0; kindMin.meeting+=d.kindMin.meeting||0; kindMin.work+=d.kindMin.work||0; }
    if(d.customMin){ Object.keys(d.customMin).forEach(function(k){ custom[k]=(custom[k]||0)+d.customMin[k]; }); }
    (d.periods||[]).forEach(function(p){
      if(p.kind===&quot;break&quot;||p.isBreak) return;
      [p.actual,p.plan].forEach(function(txt){
        var n=normWorkItem(txt);
        if(isMeaningful(n)) items.push(n);
      });
    });
  });
  return {items:items, dates:dates, goals:goals, kindMin:kindMin, custom:custom};
}

// 自由テキスト/CSVから候補を集める（行ベース）
function skCollectFromText(text){
  var items=[], dates=[];
  (text||&quot;&quot;).split(/\r?\n/).forEach(function(raw){
    var line=raw.trim(); if(!line) return;
    // 日付行を拾う
    var dm=/(\d{4})\D+(\d{1,2})\D+(\d{1,2})/.exec(line);
    if(dm &amp;&amp; line.replace(/[\d\/\-\.年月日（）\(\)月火水木金土曜\s]/g,&quot;&quot;).length<=2){
      dates.push(line); return;
    }
    // CSVっぽい場合はカンマ分割して各セルも候補に
    var cells = line.indexOf(&quot;,&quot;)>=0 ? line.split(&quot;,&quot;) : [line];
    cells.forEach(function(c){
      var n=normWorkItem(c);
      if(isMeaningful(n)) items.push(n);
    });
  });
  return {items:items, dates:dates, goals:[], kindMin:{lesson:0,meeting:0,work:0}, custom:{}};
}

// 候補の集約：正規化して重複は回数カウント、頻度順
function skAggregate(collected){
  var map={}; // text -> count
  collected.items.forEach(function(t){ map[t]=(map[t]||0)+1; });
  var uniq=Object.keys(map).sort(function(a,b){ return map[b]-map[a] || a.localeCompare(b); });
  SK_DRAFT={ items:uniq, counts:map, dates:collected.dates||[], goals:collected.goals||[],
    kindMin:collected.kindMin||{lesson:0,meeting:0,work:0}, custom:collected.custom||{} };
  skRenderCandidates();
}

function skRenderCandidates(){
  var box=document.getElementById(&quot;sk_candidates&quot;);
  var panel=document.getElementById(&quot;skDraftPanel&quot;);
  if(!SK_DRAFT.items.length){
    panel.style.display=&quot;block&quot;;
    box.innerHTML='<span class=&quot;hint&quot; style=&quot;margin:0;&quot;>候補が見つかりませんでした。メモの書式（・や[ ]で始まる行）をご確認ください。</span>';
    document.getElementById(&quot;sk_draftMeta&quot;).textContent=&quot;&quot;;
    return;
  }
  panel.style.display=&quot;block&quot;;
  var nDays = SK_DRAFT.dates.length;
  document.getElementById(&quot;sk_draftMeta&quot;).textContent =
    &quot;取り込み：&quot;+(nDays?nDays+&quot;日分／&quot;:&quot;&quot;) + SK_DRAFT.items.length + &quot;種類の作業候補（よく出る順）&quot;;
  var html=&quot;&quot;;
  SK_DRAFT.items.forEach(function(t,i){
    var cnt=SK_DRAFT.counts[t]||1;
    var checked = (i<11) ? &quot;checked&quot; : &quot;&quot;; // 上位11件を既定ON（PDFの作業内容10〜12目安）
    html+='<label><input type=&quot;checkbox&quot; value=&quot;'+_xmlEsc(t)+'&quot; '+checked+'> '+_xmlEsc(t)+(cnt>1?(' <span class=&quot;meta&quot; style=&quot;color:var(--ink-soft);font-size:.74rem;&quot;>×'+cnt+'</span>'):'')+'</label>';
  });
  box.innerHTML=html;
}
function skCheckAllCand(on){
  [].slice.call(document.querySelectorAll(&quot;#sk_candidates input&quot;)).forEach(function(c){ c.checked=!!on; });
}
function skApplyCandidates(){
  var picked=[].slice.call(document.querySelectorAll(&quot;#sk_candidates input:checked&quot;)).map(function(c){return c.value;});
  if(!picked.length){ toast(&quot;候補をチェックしてください&quot;); return; }
  document.getElementById(&quot;sk_workList&quot;).innerHTML=&quot;&quot;;
  picked.forEach(function(t){ skAddWork(t); });
  skCount();
  toast(picked.length+&quot;件を作業内容に入れました&quot;);
  document.getElementById(&quot;sk_workList&quot;).scrollIntoView&amp;&amp;document.getElementById(&quot;sk_workList&quot;).scrollIntoView({behavior:&quot;smooth&quot;,block:&quot;center&quot;});
}

// 期間・対応工程・担当業務・成果物のたたきを下書き
function skFillDraftMeta(){
  var dks=SK_DRAFT.dates.map(dateKey).filter(function(x){return x!=null;}).sort(function(a,b){return a-b;});
  if(dks.length){
    function fmt(k){ var y=Math.floor(k/10000), mo=Math.floor(k/100)%100, da=k%100; return y+&quot;/&quot;+(&quot;0&quot;+mo).slice(-2)+&quot;/&quot;+(&quot;0&quot;+da).slice(-2); }
    var first=fmt(dks[0]), last=fmt(dks[dks.length-1]);
    if(!v(&quot;sk_period&quot;)) document.getElementById(&quot;sk_period&quot;).value=first.replace(/\//g,&quot;/&quot;)+&quot;〜&quot;+last;
    if(!v(&quot;sk_proc&quot;)) document.getElementById(&quot;sk_proc&quot;).value=&quot;対応〜（&quot;+first+&quot;〜&quot;+last+&quot;）&quot;;
  }
  // 区分時間からヒント（多い区分を担当業務に）
  var km=SK_DRAFT.kindMin||{};
  if(!v(&quot;sk_duty&quot;)){
    var hints=[];
    if((km.work||0)>0) hints.push(&quot;各種開発・作業対応&quot;);
    if((km.meeting||0)>0) hints.push(&quot;打合せ・調整&quot;);
    if((km.lesson||0)>0) hints.push(&quot;研修・指導&quot;);
    Object.keys(SK_DRAFT.custom||{}).forEach(function(k){ hints.push(k); });
    if(hints.length) document.getElementById(&quot;sk_duty&quot;).value=&quot;担当としてPJに参画\n&quot;+hints.join(&quot;、&quot;)+&quot;を担当&quot;;
  }
  if(!v(&quot;sk_sys&quot;) &amp;&amp; SK_DRAFT.goals.length){
    document.getElementById(&quot;sk_sys&quot;).value=SK_DRAFT.goals[0]; // めあての先頭を仮置き
  }
  if(!v(&quot;sk_out&quot;)) document.getElementById(&quot;sk_out&quot;).value=&quot;（各種ドキュメント・成果物。可能なら数字を入れる）&quot;;
  skCount();
  toast(&quot;期間・対応工程などを下書きしました（要編集）&quot;);
}

// ボタン：時間割30日ログから
function skFromLog(){
  var c=skCollectFromLog();
  if(!c.items.length &amp;&amp; !c.dates.length){ toast(&quot;時間割の30日ログに保存データがありません&quot;); return; }
  skAggregate(c);
  toast(&quot;30日ログから取り込みました&quot;);
}
// ボタン：貼り付けメモから
function skParsePaste(){
  var text=v(&quot;sk_memoPaste&quot;);
  if(!text){ toast(&quot;メモを貼り付けてください&quot;); return; }
  skAggregate(skCollectFromText(text));
}
// ファイル：メモCSV/テキスト読み込み
function skMemoImport(input){
  var file=input.files&amp;&amp;input.files[0]; if(!file) return;
  var reader=new FileReader();
  reader.onload=function(){
    var text=String(reader.result||&quot;&quot;).replace(/^\uFEFF/,&quot;&quot;);
    if(!text){ toast(&quot;読み込めませんでした&quot;); input.value=&quot;&quot;; return; }
    skAggregate(skCollectFromText(text));
    toast(&quot;ファイルから取り込みました&quot;);
    input.value=&quot;&quot;;
  };
  reader.readAsText(file,&quot;UTF-8&quot;);
}

function _setCount(id, n, lo, hi, unit){
  var el=document.getElementById(id); if(!el) return;
  el.textContent=n+(unit||&quot;字&quot;);
  el.className=&quot;sk-count&quot;+(n===0?&quot;&quot;:(n>=lo&amp;&amp;n<=hi?&quot; okc&quot;:&quot; warn&quot;));
}
function skCount(){
  _setCount(&quot;sk_c_title&quot;, jlen(v(&quot;sk_title&quot;)),15,25);
  _setCount(&quot;sk_c_sys&quot;,   jlen(v(&quot;sk_sys&quot;)),15,25);
  var proc=lines(v(&quot;sk_proc&quot;)); document.getElementById(&quot;sk_c_proc&quot;).textContent=proc.join(&quot;&quot;).length+&quot;字 / &quot;+proc.length+&quot;行&quot;;
  document.getElementById(&quot;sk_c_proc&quot;).className=&quot;sk-count&quot;+(proc.length>=2&amp;&amp;proc.length<=3?&quot; okc&quot;:(proc.length?&quot; warn&quot;:&quot;&quot;));
  var duty=lines(v(&quot;sk_duty&quot;)); document.getElementById(&quot;sk_c_duty&quot;).textContent=duty.join(&quot;&quot;).length+&quot;字 / &quot;+duty.length+&quot;行&quot;;
  document.getElementById(&quot;sk_c_duty&quot;).className=&quot;sk-count&quot;+(duty.length>=2&amp;&amp;duty.length<=3?&quot; okc&quot;:(duty.length?&quot; warn&quot;:&quot;&quot;));
  var work=skReadWork(); var wl=work.length;
  document.getElementById(&quot;sk_c_work&quot;).textContent=wl+&quot;項目&quot;;
  document.getElementById(&quot;sk_c_work&quot;).className=&quot;sk-count&quot;+(wl===0?&quot;&quot;:(wl>=10&amp;&amp;wl<=12?&quot; okc&quot;:&quot; warn&quot;));
  var out=lines(v(&quot;sk_out&quot;)); document.getElementById(&quot;sk_c_out&quot;).textContent=out.join(&quot;&quot;).length+&quot;字 / &quot;+out.length+&quot;行&quot;;
  document.getElementById(&quot;sk_c_out&quot;).className=&quot;sk-count&quot;+(out.length>=1&amp;&amp;out.length<=2?&quot; okc&quot;:(out.length?&quot; warn&quot;:&quot;&quot;));

  // 本文セル合計＝システム内容+対応工程+担当業務+作業内容+成果物
  var total = jlen(v(&quot;sk_sys&quot;)) + proc.join(&quot;&quot;).length + duty.join(&quot;&quot;).length + work.join(&quot;&quot;).length + out.join(&quot;&quot;).length;
  document.getElementById(&quot;sk_total&quot;).textContent=total;
  var c=document.getElementById(&quot;sk_case&quot;);
  if(total===0){ c.textContent=&quot;—&quot;; }
  else if(total>=220){ c.textContent=&quot;A（長期・約300字）&quot;; }
  else if(total>=100){ c.textContent=&quot;B（中期・約100〜150字）&quot;; }
  else { c.textContent=&quot;C（短期・約100字）&quot;; }
}

function skCurrentRecord(){
  return {
    no:v(&quot;sk_no&quot;), industry:v(&quot;sk_industry&quot;), role:v(&quot;sk_role&quot;),
    period:v(&quot;sk_period&quot;), scale:v(&quot;sk_scale&quot;),
    lang:v(&quot;sk_lang&quot;), db:v(&quot;sk_db&quot;), os:v(&quot;sk_os&quot;), mw:v(&quot;sk_mw&quot;), phase:v(&quot;sk_phase&quot;),
    title:v(&quot;sk_title&quot;), sys:v(&quot;sk_sys&quot;), proc:v(&quot;sk_proc&quot;), duty:v(&quot;sk_duty&quot;),
    work:skReadWork(), out:v(&quot;sk_out&quot;)
  };
}

function buildSkill(){
  currentTab=&quot;skill&quot;;
  var r=skCurrentRecord();
  /* テキスト版（提出用・ガイドなし） */
  var o=[];
  o.push(r.title || &quot;（企業・プロジェクト名）&quot;);
  o.push(&quot;&quot;);
  o.push(&quot;■システム内容&quot;); if(r.sys) o.push(r.sys);
  o.push(&quot;&quot;);
  o.push(&quot;■対応工程&quot;); lines(r.proc).forEach(function(l){o.push(l);});
  o.push(&quot;&quot;);
  o.push(&quot;■担当業務&quot;); lines(r.duty).forEach(function(l){o.push(l);});
  o.push(&quot;&quot;);
  o.push(&quot;■作業内容&quot;); r.work.forEach(function(w){o.push(&quot;・&quot;+w);});
  o.push(&quot;&quot;);
  o.push(&quot;■成果物&quot;); lines(r.out).forEach(function(l){o.push(l);});
  var txt=o.join(&quot;\n&quot;);

  /* Markdown版 */
  var m=[];
  m.push(&quot;### &quot;+(r.title||&quot;（企業・プロジェクト名）&quot;));
  m.push(&quot;&quot;);
  var meta=[];
  if(r.no) meta.push(&quot;No &quot;+r.no); if(r.industry) meta.push(&quot;業種 &quot;+r.industry);
  if(r.role) meta.push(&quot;役割 &quot;+r.role); if(r.period) meta.push(&quot;期間 &quot;+r.period);
  if(r.scale) meta.push(&quot;規模 &quot;+r.scale);
  if(meta.length){ m.push(&quot;> &quot;+meta.join(&quot; ／ &quot;)); m.push(&quot;&quot;); }
  if(r.lang||r.db||r.os||r.mw){
    m.push(&quot;- 言語／ツール：&quot;+r.lang);
    m.push(&quot;- DB：&quot;+r.db+&quot; ／ サーバ・OS：&quot;+r.os+&quot; ／ 環境：&quot;+r.mw);
    m.push(&quot;&quot;);
  }
  m.push(&quot;**■システム内容**  &quot;); m.push(r.sys||&quot;&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;**■対応工程**  &quot;); lines(r.proc).forEach(function(l){m.push(&quot;- &quot;+l);});
  m.push(&quot;&quot;);
  m.push(&quot;**■担当業務**  &quot;); lines(r.duty).forEach(function(l){m.push(&quot;- &quot;+l);});
  m.push(&quot;&quot;);
  m.push(&quot;**■作業内容**  &quot;); r.work.forEach(function(w){m.push(&quot;- &quot;+w);});
  m.push(&quot;&quot;);
  m.push(&quot;**■成果物**  &quot;); lines(r.out).forEach(function(l){m.push(&quot;- &quot;+l);});
  var md=m.join(&quot;\n&quot;);

  setOut(txt, md);
}

/* ---- 保存・一覧 ---- */
function skSave(){
  var r=skCurrentRecord();
  if(!r.title &amp;&amp; !r.sys &amp;&amp; !r.work.length){ toast(&quot;案件名か内容を入れてください&quot;); return; }
  var key = r.no || r.title || (&quot;案件&quot;+(skLoad().length+1));
  r._key=key;
  var arr=skLoad();
  var idx=arr.findIndex(function(x){return x._key===key;});
  if(idx>=0){ arr[idx]=r; } else { arr.push(r); }
  skStore(arr); skRenderList();
  toast(idx>=0 ? &quot;上書き保存しました&quot; : &quot;保存しました（&quot;+arr.length+&quot;件）&quot;);
}
function skDelete(key){
  var arr=skLoad().filter(function(x){return x._key!==key;});
  skStore(arr); skRenderList(); toast(&quot;削除しました&quot;);
}
function skClearAll(){
  if(!skLoad().length){ toast(&quot;保存データはありません&quot;); return; }
  if(window.confirm &amp;&amp; !window.confirm(&quot;保存した全案件を消去します。よろしいですか？&quot;)) return;
  skStore([]); skRenderList(); toast(&quot;全消去しました&quot;);
}
function skLoadToForm(key){
  var r=skLoad().find(function(x){return x._key===key;}); if(!r) return;
  [&quot;no&quot;,&quot;industry&quot;,&quot;role&quot;,&quot;period&quot;,&quot;scale&quot;,&quot;lang&quot;,&quot;db&quot;,&quot;os&quot;,&quot;mw&quot;,&quot;phase&quot;,&quot;title&quot;,&quot;sys&quot;,&quot;proc&quot;,&quot;duty&quot;,&quot;out&quot;].forEach(function(f){
    var el=document.getElementById(&quot;sk_&quot;+f); if(el) el.value=r[f]||&quot;&quot;;
  });
  document.getElementById(&quot;sk_workList&quot;).innerHTML=&quot;&quot;;
  (r.work||[]).forEach(function(w){ skAddWork(w); });
  if(!(r.work||[]).length){ skAddWork(); }
  skCount();
  toast((r.title||r._key)+&quot; を読み込みました&quot;);
}
function skRenderList(){
  var arr=skLoad();
  var list=document.getElementById(&quot;skList&quot;);
  var meta=document.getElementById(&quot;sk_logmeta&quot;);
  if(!arr.length){ list.innerHTML='<div class=&quot;empty&quot;>まだ保存された案件がありません。</div>'; meta.style.display=&quot;none&quot;; return; }
  meta.style.display=&quot;block&quot;; meta.textContent=&quot;保存件数 &quot;+arr.length+&quot;件&quot;;
  var html=&quot;&quot;;
  arr.slice(-30).reverse().forEach(function(r){
    var key=encodeURIComponent(r._key);
    var total=jlen(r.sys)+lines(r.proc).join(&quot;&quot;).length+lines(r.duty).join(&quot;&quot;).length+(r.work||[]).join(&quot;&quot;).length+lines(r.out).join(&quot;&quot;).length;
    html+='<div class=&quot;day-item&quot;>'+
      '<div><strong>'+_xmlEsc(r.title||r._key)+'</strong> <span class=&quot;meta&quot;>'+(r.industry?_xmlEsc(r.industry)+' ／ ':'')+(r.period?_xmlEsc(r.period)+' ／ ':'')+'本文'+total+'字・作業'+((r.work||[]).length)+'項目</span></div>'+
      '<button class=&quot;mini-btn&quot; onclick=&quot;skLoadToForm(decodeURIComponent(\''+key+'\'))&quot;>読込</button>'+
      '<button class=&quot;mini-btn del&quot; onclick=&quot;skDelete(decodeURIComponent(\''+key+'\'))&quot;>削除</button>'+
    '</div>';
  });
  list.innerHTML=html;
}

/* ---- Excel / CSV 入出力 ---- */
function skExportXlsx(){
  var arr=skLoad();
  if(!arr.length){ var c=skCurrentRecord(); if(c.title||c.sys||c.work.length){ c._key=c.no||c.title||&quot;案件1&quot;; arr=[c]; } else { toast(&quot;先に「この案件を保存」してください&quot;); return; } }
  // 一覧シート（1案件1行）
  var s1=[[_S(&quot;No&quot;),_S(&quot;業種&quot;),_S(&quot;役割&quot;),_S(&quot;期間&quot;),_S(&quot;規模&quot;),_S(&quot;言語／ツール&quot;),_S(&quot;DB&quot;),_S(&quot;サーバ／OS&quot;),_S(&quot;環境/MW&quot;),_S(&quot;担当工程&quot;),_S(&quot;企業・PJ名&quot;),_S(&quot;システム内容&quot;),_S(&quot;作業項目数&quot;),_S(&quot;本文文字数&quot;)]];
  arr.forEach(function(r){
    var total=jlen(r.sys)+lines(r.proc).join(&quot;&quot;).length+lines(r.duty).join(&quot;&quot;).length+(r.work||[]).join(&quot;&quot;).length+lines(r.out).join(&quot;&quot;).length;
    s1.push([_S(r.no),_S(r.industry),_S(r.role),_S(r.period),_S(r.scale),_S(r.lang),_S(r.db),_S(r.os),_S(r.mw),_S(r.phase),_S(r.title),_S(r.sys),_N((r.work||[]).length),_N(total)]);
  });
  // 明細シート（5ブロックを縦持ち＝再インポート可能）
  var s2=[[_S(&quot;No&quot;),_S(&quot;企業・PJ名&quot;),_S(&quot;ブロック&quot;),_S(&quot;行番号&quot;),_S(&quot;内容&quot;)]];
  arr.forEach(function(r){
    function push(block, items){ items.forEach(function(t,i){ s2.push([_S(r.no),_S(r.title),_S(block),_N(i+1),_S(t)]); }); }
    push(&quot;システム内容&quot;, lines(r.sys));
    push(&quot;対応工程&quot;, lines(r.proc));
    push(&quot;担当業務&quot;, lines(r.duty));
    push(&quot;作業内容&quot;, (r.work||[]));
    push(&quot;成果物&quot;, lines(r.out));
  });
  var buf=_buildXlsx([{name:&quot;案件一覧&quot;,rows:s1},{name:&quot;案件明細&quot;,rows:s2}]);
  _saveBlob(new Blob([buf],{type:&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet&quot;}), &quot;スキルシート_&quot;+today()+&quot;.xlsx&quot;);
  toast(&quot;Excelを書き出しました（&quot;+arr.length+&quot;件）&quot;);
}

// CSVは「メタ＋5ブロックを1行に畳む」形式（再インポートで完全復元）
var SK_FIELDS=[&quot;No&quot;,&quot;業種&quot;,&quot;役割&quot;,&quot;期間&quot;,&quot;規模&quot;,&quot;言語ツール&quot;,&quot;DB&quot;,&quot;サーバOS&quot;,&quot;環境MW&quot;,&quot;担当工程&quot;,&quot;企業PJ名&quot;,&quot;システム内容&quot;,&quot;対応工程&quot;,&quot;担当業務&quot;,&quot;作業内容&quot;,&quot;成果物&quot;];
function skExportCsv(){
  var arr=skLoad();
  if(!arr.length){ var c=skCurrentRecord(); if(c.title||c.sys||c.work.length){ c._key=c.no||c.title||&quot;案件1&quot;; arr=[c]; } else { toast(&quot;先に「この案件を保存」してください&quot;); return; } }
  var rows=[SK_FIELDS.slice()];
  arr.forEach(function(r){
    rows.push([r.no,r.industry,r.role,r.period,r.scale,r.lang,r.db,r.os,r.mw,r.phase,
      r.title,r.sys, lines(r.proc).join(&quot;\n&quot;), lines(r.duty).join(&quot;\n&quot;), (r.work||[]).join(&quot;\n&quot;), lines(r.out).join(&quot;\n&quot;)]);
  });
  var csv=rows.map(function(r){return r.map(_csvCell).join(&quot;,&quot;);}).join(&quot;\r\n&quot;);
  _saveBlob(new Blob([&quot;\uFEFF&quot;+csv],{type:&quot;text/csv;charset=utf-8&quot;}), &quot;スキルシート_&quot;+today()+&quot;.csv&quot;);
  toast(&quot;CSVを書き出しました&quot;);
}
function skImportCsv(input){
  var file=input.files&amp;&amp;input.files[0]; if(!file) return;
  var reader=new FileReader();
  reader.onload=function(){
    try{
      var rows=_parseCsv(String(reader.result));
      if(rows.length<2){ toast(&quot;データが見つかりません&quot;); return; }
      var h=rows[0].map(function(s){return s.trim();});
      var ix={}; SK_FIELDS.forEach(function(f){ ix[f]=h.indexOf(f); });
      function g(r,f){ return ix[f]>=0 ? (r[ix[f]]||&quot;&quot;) : &quot;&quot;; }
      var imported=rows.slice(1).map(function(r){
        var rec={
          no:g(r,&quot;No&quot;),industry:g(r,&quot;業種&quot;),role:g(r,&quot;役割&quot;),period:g(r,&quot;期間&quot;),scale:g(r,&quot;規模&quot;),
          lang:g(r,&quot;言語ツール&quot;),db:g(r,&quot;DB&quot;),os:g(r,&quot;サーバOS&quot;),mw:g(r,&quot;環境MW&quot;),phase:g(r,&quot;担当工程&quot;),
          title:g(r,&quot;企業PJ名&quot;),sys:g(r,&quot;システム内容&quot;),proc:g(r,&quot;対応工程&quot;),duty:g(r,&quot;担当業務&quot;),
          work:lines(g(r,&quot;作業内容&quot;)), out:g(r,&quot;成果物&quot;)
        };
        rec._key=rec.no||rec.title||(&quot;案件&quot;);
        return rec;
      }).filter(function(rec){ return rec.title||rec.sys||rec.work.length; });
      // 既存とマージ（_keyで上書き）
      var map={}; skLoad().forEach(function(x){ map[x._key]=x; });
      imported.forEach(function(x){ map[x._key]=x; });
      var merged=Object.keys(map).map(function(k){return map[k];});
      skStore(merged); skRenderList();
      if(merged.length){ skLoadToForm(merged[merged.length-1]._key); }
      toast(imported.length+&quot;件を取り込みました&quot;);
    }catch(e){ toast(&quot;読み込みに失敗しました&quot;); }
    input.value=&quot;&quot;;
  };
  reader.readAsText(file,&quot;UTF-8&quot;);
}

/* ---- output ---- */
function setOut(text, md){
  lastOut.txt = text;
  lastOut.md  = (typeof md===&quot;string&quot; &amp;&amp; md.length) ? md : text;
  document.getElementById(&quot;output&quot;).value=text;
  var ow=document.querySelector(&quot;.outwrap&quot;);
  if(ow &amp;&amp; ow.scrollIntoView){ ow.scrollIntoView({behavior:&quot;smooth&quot;,block:&quot;start&quot;}); }
}
function toast(msg){
  var t=document.getElementById(&quot;toast&quot;); t.textContent=msg; t.classList.add(&quot;show&quot;);
  setTimeout(function(){ t.classList.remove(&quot;show&quot;); },1600);
}
function copyOut(){
  var text=document.getElementById(&quot;output&quot;).value;
  if(!text){ toast(&quot;先に生成してください&quot;); return; }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){
    navigator.clipboard.writeText(text).then(function(){toast(&quot;コピーしました&quot;);},function(){fallbackCopy(text);});
  } else { fallbackCopy(text); }
}
function fallbackCopy(text){
  var ta=document.getElementById(&quot;output&quot;); ta.select();
  try{ document.execCommand(&quot;copy&quot;); toast(&quot;コピーしました&quot;); }catch(e){ toast(&quot;コピーできませんでした&quot;); }
}
function downloadOut(fmt){
  fmt = (fmt===&quot;md&quot;) ? &quot;md&quot; : &quot;txt&quot;;
  var text = (fmt===&quot;md&quot;) ? lastOut.md : lastOut.txt;
  if(!text){ text=document.getElementById(&quot;output&quot;).value; } // 念のためのフォールバック
  if(!text){ toast(&quot;先に生成してください&quot;); return; }
  var names={report:&quot;日報&quot;,memo:&quot;メモ日報&quot;,chat:&quot;相談テンプレ&quot;,timetable:&quot;時間割HR&quot;,skill:&quot;スキルシート&quot;,pdca:&quot;一人MTG_PDCA&quot;,mtg2:&quot;一人MTG2_目標KPT&quot;,tpl:&quot;ひな形日報&quot;};
  var mime=(fmt===&quot;md&quot;) ? &quot;text/markdown;charset=utf-8&quot; : &quot;text/plain;charset=utf-8&quot;;
  var blob=new Blob([&quot;\uFEFF&quot;+text],{type:mime});
  var a=document.createElement(&quot;a&quot;);
  a.href=URL.createObjectURL(blob);
  a.download=(names[currentTab]||&quot;出力&quot;)+&quot;_&quot;+today()+&quot;.&quot;+fmt;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(a.href);
  toast((fmt===&quot;md&quot;?&quot;マークダウン&quot;:&quot;テキスト&quot;)+&quot;を保存しました&quot;);
}

/* ---- init ---- */
(function init(){
  addTask(); addTask();
  var d=new Date(), w=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var jp=d.getFullYear()+&quot;年&quot;+(d.getMonth()+1)+&quot;月&quot;+d.getDate()+&quot;日(&quot;+w+&quot;)&quot;;
  var slash=d.getFullYear()+&quot;/&quot;+(&quot;0&quot;+(d.getMonth()+1)).slice(-2)+&quot;/&quot;+(&quot;0&quot;+d.getDate()).slice(-2)+&quot;（&quot;+w+&quot;）&quot;;
  document.getElementById(&quot;r_date&quot;).value=jp;
  document.getElementById(&quot;m_date&quot;).value=slash;
  document.getElementById(&quot;tt_date&quot;).value=slash;
  // 丸め設定の初期値を変数に合わせる
  var ru=document.getElementById(&quot;round_unit&quot;); if(ru) ru.value=String(ROUND_UNIT);
  var rm=document.getElementById(&quot;round_mode&quot;); if(rm) rm.value=ROUND_MODE;
  TT_DEFAULT.forEach(function(p){ addPeriod(p); });
  recalcTT();
  renderQuickTags();
  renderDayList();
  // スキルシート：作業内容を10行seed、文字数カウンタ初期化、保存リスト描画
  for(var si=0; si<10; si++){ skAddWork(); }
  skCount();
  skRenderList();
  // 進捗報告：タスク2行seed
  ciAddTask(); ciAddTask();
  // 自由ひな形：初回は標準テンプレを登録、その後 一覧と差し込み欄を初期化
  tplSeedDefault();
  tplRenderSaved(); tplScan();
  // 月次データ統合：プレビュー初期化
  hubRender();
  // 言語・テーマ初期化（既定は日本語＝オフホワイト＋ペールレッド）
  initLang();
  // 時間割の連携ON/OFF 初期化（既定ON）
  initTtLink();
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-fact" title="ファクト報告ジェネレーター" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>🐰 うさうさ ファクトベース報告ジェネレーター｜理系新卒研修向け（嘘なし・事実だけ）</title>
<style>
  :root{
    --deep:#2E5E4E; --mid:#6FAE8E; --pale:#DCEFE4; --paleBg:#F2F8F4;
    --accent:#E8A33D; --ink:#2B3A33; --inkSoft:#5C6B63; --white:#FFFFFF;
    --warn:#C0563B; --line:#CFE3D7;
    --fact:#2E5E4E; --num:#1f7a8c; --infer:#9a6b00; --opin:#7a5cc0;
  }
  *{box-sizing:border-box;}
  body{margin:0;font-family:&quot;Hiragino Kaku Gothic ProN&quot;,&quot;Yu Gothic&quot;,Meiryo,sans-serif;
    background:var(--paleBg);color:var(--ink);line-height:1.7;}
  body.theme-jp{}
  .lang-switch{display:none;}
  header{background:var(--deep);color:#fff;padding:18px 22px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;}
  header .bun{font-size:1.6rem;}
  header h1{font-size:1.15rem;margin:0;font-weight:700;}
  header .ver{margin-left:8px;background:var(--accent);color:#1a1a1a;font-size:.7rem;font-weight:700;
    padding:2px 8px;border-radius:5px;vertical-align:middle;}
  header .sub{width:100%;font-size:.8rem;color:var(--pale);margin-top:4px;opacity:.9;}
  .wrap{max-width:1000px;margin:0 auto;padding:18px 16px 60px;}
  .tabs{display:flex;flex-wrap:wrap;gap:6px;margin:18px 0 14px;}
  .tab{background:var(--white);border:1px solid var(--line);color:var(--inkSoft);
    padding:9px 14px;border-radius:8px 8px 0 0;cursor:pointer;font-size:.9rem;font-weight:600;}
  .tab.active{background:var(--deep);color:#fff;border-color:var(--deep);}
  .panel{display:none;background:var(--white);border:1px solid var(--line);border-radius:0 10px 10px 10px;
    padding:20px;box-shadow:0 2px 8px rgba(46,94,78,.06);}
  .panel.active{display:block;}
  h2.sec{font-size:1.05rem;color:var(--deep);margin:0 0 4px;display:flex;align-items:center;gap:8px;}
  .howto{background:var(--pale);border-left:4px solid var(--mid);border-radius:6px;
    padding:10px 14px;margin:0 0 16px;font-size:.84rem;color:var(--ink);}
  .howto b{color:var(--deep);}
  label{display:block;font-size:.82rem;font-weight:700;color:var(--deep);margin:12px 0 4px;}
  .hint{font-weight:400;color:var(--inkSoft);font-size:.78rem;}
  input[type=text],textarea,select{width:100%;padding:9px 11px;border:1px solid var(--line);
    border-radius:7px;font-size:.9rem;font-family:inherit;color:var(--ink);background:#fff;}
  textarea{resize:vertical;min-height:70px;line-height:1.6;}
  textarea.mono{font-family:&quot;SFMono-Regular&quot;,Consolas,&quot;Courier New&quot;,monospace;font-size:.84rem;}
  .row{display:flex;gap:12px;flex-wrap:wrap;}
  .row > div{flex:1;min-width:160px;}
  .grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}
  @media(max-width:760px){.grid4{grid-template-columns:1fr 1fr;}}
  .bucket{border:1px solid var(--line);border-radius:8px;padding:8px;background:#fcfefd;}
  .bucket .bhd{font-size:.78rem;font-weight:700;padding:4px 8px;border-radius:5px;color:#fff;display:inline-block;margin-bottom:6px;}
  .bucket textarea{min-height:120px;}
  .bhd.fact{background:var(--fact);} .bhd.num{background:var(--num);}
  .bhd.infer{background:var(--infer);} .bhd.opin{background:var(--opin);}
  .btnrow{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;}
  button.act{background:var(--deep);color:#fff;border:none;padding:10px 18px;border-radius:8px;
    font-size:.9rem;font-weight:700;cursor:pointer;}
  button.act:hover{background:#264d40;}
  button.ghost{background:#fff;color:var(--deep);border:1px solid var(--deep);}
  button.ghost:hover{background:var(--pale);}
  .out{margin-top:16px;}
  .out textarea{min-height:200px;background:#fbfdfc;}
  .warnbox{background:#fbeeea;border:1px solid #e7c3b8;border-radius:7px;padding:10px 12px;
    margin-top:10px;font-size:.84rem;color:var(--warn);display:none;}
  .warnbox.show{display:block;}
  .warnbox b{color:#9c3d26;}
  table.conv{width:100%;border-collapse:collapse;margin-top:8px;font-size:.85rem;}
  table.conv th,table.conv td{border:1px solid var(--line);padding:8px 10px;text-align:left;vertical-align:top;}
  table.conv th{background:var(--deep);color:#fff;font-size:.8rem;}
  table.conv td:first-child{color:var(--warn);width:38%;}
  table.conv td:nth-child(2){color:var(--deep);font-weight:600;}
  .pill{display:inline-block;background:var(--pale);color:var(--deep);border-radius:20px;
    padding:2px 10px;font-size:.74rem;font-weight:700;margin:2px 4px 2px 0;}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--deep);
    color:#fff;padding:10px 20px;border-radius:8px;font-size:.86rem;opacity:0;pointer-events:none;
    transition:opacity .25s;z-index:99;}
  .toast.show{opacity:1;}
  .foot{text-align:center;color:var(--inkSoft);font-size:.76rem;margin-top:30px;}
  .foot .motto{font-style:italic;color:var(--mid);}
  .principle{background:var(--deep);color:#fff;border-radius:8px;padding:12px 16px;margin-bottom:16px;font-size:.86rem;}
  .principle b{color:var(--accent);}
</style>
</head>
<body class=&quot;theme-jp&quot;>
<div class=&quot;lang-switch&quot;>JP</div>
<header>
  <span class=&quot;bun&quot;>🐰</span>
  <h1>うさうさ ファクトベース報告ジェネレーター<span class=&quot;ver&quot;>v1.0</span></h1>
  <div class=&quot;sub&quot;>理系新卒研修向け／「嘘なし・事実だけ」で書く訓練ツール ・ <span id=&quot;ver_today&quot;></span> ・ データは端末内のみ（外部送信なし）</div>
</header>

<div class=&quot;wrap&quot;>

  <div class=&quot;principle&quot;>
    <b>このツールの原則：</b> 書いていいのは「観測した事実」と「測定した数値」。
    推測には<b>根拠</b>を、解釈には<b>「考察」のラベル</b>を必ず付ける。誇張・断定・盛りは禁止。
  </div>

  <div class=&quot;tabs&quot;>
    <div class=&quot;tab active&quot; data-tab=&quot;sep&quot;>① 事実と所感の分離</div>
    <div class=&quot;tab&quot; data-tab=&quot;log&quot;>② 作業・検証ログ</div>
    <div class=&quot;tab&quot; data-tab=&quot;rep&quot;>③ 技術報告書(IMRAD)</div>
    <div class=&quot;tab&quot; data-tab=&quot;bug&quot;>④ 不具合・調査報告</div>
    <div class=&quot;tab&quot; data-tab=&quot;conv&quot;>⑤ 誇張→事実 言い換え</div>
    <div class=&quot;tab&quot; data-tab=&quot;hub&quot;>⑥ データ保管</div>
  </div>

  <!-- ① 事実と所感の分離 -->
  <div class=&quot;panel active&quot; id=&quot;p-sep&quot;>
    <h2 class=&quot;sec&quot;>① 事実と所感の分離</h2>
    <div class=&quot;howto&quot;>
      <b>使い方：</b> 報告したい内容を4つの箱に仕分けて入力します（1行1項目）。
      ボタンを押すと、種類のラベルを付けた「混ざらない報告文」が出力されます。
      迷ったら「それは見た／測ったことか？それとも自分の考えか？」で判断してください。
    </div>
    <div class=&quot;grid4&quot;>
      <div class=&quot;bucket&quot;>
        <span class=&quot;bhd fact&quot;>事実（観測した）</span>
        <textarea id=&quot;sep_fact&quot; placeholder=&quot;例）ビルドが完了した&amp;#10;例）画面にエラー表示が出た&quot;></textarea>
      </div>
      <div class=&quot;bucket&quot;>
        <span class=&quot;bhd num&quot;>測定値（数えた・計った）</span>
        <textarea id=&quot;sep_num&quot; placeholder=&quot;例）処理時間 3.2秒&amp;#10;例）テスト 28件中 28件成功&quot;></textarea>
      </div>
      <div class=&quot;bucket&quot;>
        <span class=&quot;bhd infer&quot;>推測（根拠あり）</span>
        <textarea id=&quot;sep_infer&quot; placeholder=&quot;例）ログにtimeoutがあるため通信遅延が原因と推定&amp;#10;※「根拠→推測」の形で書く&quot;></textarea>
      </div>
      <div class=&quot;bucket&quot;>
        <span class=&quot;bhd opin&quot;>所感（主観・感想）</span>
        <textarea id=&quot;sep_opin&quot; placeholder=&quot;例）手順が分かりにくいと感じた&amp;#10;例）次回は早めに着手したい&quot;></textarea>
      </div>
    </div>
    <div class=&quot;warnbox&quot; id=&quot;sep_warn&quot;></div>
    <div class=&quot;btnrow&quot;>
      <button class=&quot;act&quot; onclick=&quot;genSep()&quot;>仕分け報告を生成</button>
      <button class=&quot;ghost&quot; onclick=&quot;clearTab('sep')&quot;>この欄をクリア</button>
    </div>
    <div class=&quot;out&quot;>
      <label>出力（コピーして報告に貼り付け）</label>
      <textarea id=&quot;sep_out&quot; class=&quot;mono&quot; readonly></textarea>
      <div class=&quot;btnrow&quot;>
        <button class=&quot;ghost&quot; onclick=&quot;copyOut('sep_out')&quot;>コピー</button>
        <button class=&quot;ghost&quot; onclick=&quot;downloadTxt('sep_out','事実と所感の分離')&quot;>テキスト保存</button>
      </div>
    </div>
  </div>

  <!-- ② 作業・検証ログ -->
  <div class=&quot;panel&quot; id=&quot;p-log&quot;>
    <h2 class=&quot;sec&quot;>② 作業・検証ログ</h2>
    <div class=&quot;howto&quot;>
      <b>使い方：</b> 後から<b>第三者が同じ手順を再現できる</b>ように記録します。
      「やったこと」だけでなく「環境・前提・観測した数値・エラー全文」を残すのが理系の作法です。
      エラーは要約せず<b>原文のまま</b>貼ってください。
    </div>
    <div class=&quot;row&quot;>
      <div><label>日時</label><input type=&quot;text&quot; id=&quot;log_dt&quot;></div>
      <div><label>担当（自分の役割）<span class=&quot;hint&quot;>例：研修生</span></label><input type=&quot;text&quot; id=&quot;log_who&quot; placeholder=&quot;研修生&quot;></div>
    </div>
    <label>目的（何を確かめる作業か）</label>
    <input type=&quot;text&quot; id=&quot;log_goal&quot; placeholder=&quot;例：ログイン処理が指定条件で動作するか確認する&quot;>
    <label>環境 <span class=&quot;hint&quot;>OS・バージョン・ツールなど（再現に必要な情報）</span></label>
    <input type=&quot;text&quot; id=&quot;log_env&quot; placeholder=&quot;例：Ubuntu 22.04 / Python 3.11.4 / ブラウザ Chrome 124&quot;>
    <label>前提条件 <span class=&quot;hint&quot;>この作業の前に成立していた状態（1行1項目）</span></label>
    <textarea id=&quot;log_pre&quot; placeholder=&quot;例：テスト用アカウントを作成済み&amp;#10;例：DBに初期データを投入済み&quot;></textarea>
    <label>実施手順 <span class=&quot;hint&quot;>実際にやった操作を順番に（1行1手順）</span></label>
    <textarea id=&quot;log_steps&quot; class=&quot;mono&quot; placeholder=&quot;1行ずつ。番号は自動で付きます&amp;#10;例）ログイン画面を開く&amp;#10;例）ID/PWを入力して送信&quot;></textarea>
    <label>観測した事実・数値 <span class=&quot;hint&quot;>見た／計った結果のみ（解釈は書かない）</span></label>
    <textarea id=&quot;log_obs&quot; placeholder=&quot;例）3.2秒で画面が遷移した&amp;#10;例）HTTPステータス 200 を確認&quot;></textarea>
    <label>発生したエラー（原文のまま全文）</label>
    <textarea id=&quot;log_err&quot; class=&quot;mono&quot; placeholder=&quot;エラーメッセージ・スタックトレースをそのまま貼る。なければ空欄でOK&quot;></textarea>
    <label>確認できたこと / まだ未確認なこと <span class=&quot;hint&quot;>「確認済」と「未確認」を分けて書く</span></label>
    <textarea id=&quot;log_status&quot; placeholder=&quot;例）確認済：正常系の遷移&amp;#10;例）未確認：パスワード誤り時の挙動&quot;></textarea>
    <div class=&quot;btnrow&quot;>
      <button class=&quot;act&quot; onclick=&quot;genLog()&quot;>ログを生成</button>
      <button class=&quot;ghost&quot; onclick=&quot;setNow('log_dt')&quot;>日時を今に</button>
      <button class=&quot;ghost&quot; onclick=&quot;clearTab('log')&quot;>この欄をクリア</button>
    </div>
    <div class=&quot;out&quot;>
      <label>出力</label>
      <textarea id=&quot;log_out&quot; class=&quot;mono&quot; readonly></textarea>
      <div class=&quot;btnrow&quot;>
        <button class=&quot;ghost&quot; onclick=&quot;copyOut('log_out')&quot;>コピー</button>
        <button class=&quot;ghost&quot; onclick=&quot;downloadTxt('log_out','作業検証ログ')&quot;>テキスト保存</button>
      </div>
    </div>
  </div>

  <!-- ③ 技術報告書 IMRAD -->
  <div class=&quot;panel&quot; id=&quot;p-rep&quot;>
    <h2 class=&quot;sec&quot;>③ 技術報告書（IMRAD風）</h2>
    <div class=&quot;howto&quot;>
      <b>使い方：</b> 理系の文章の基本形「背景→目的→方法→結果→考察」で書きます。
      最大のコツは<b>「結果（事実）」と「考察（あなたの解釈）」を絶対に混ぜない</b>こと。
      結果には数値や観測だけを、考察には「〜と考えられる」の形で根拠とともに書きます。
    </div>
    <label>タイトル</label>
    <input type=&quot;text&quot; id=&quot;rep_title&quot; placeholder=&quot;例：ログイン処理の応答時間に関する検証&quot;>
    <label>背景 <span class=&quot;hint&quot;>なぜこの検証が必要か</span></label>
    <textarea id=&quot;rep_bg&quot; placeholder=&quot;例：応答が遅いという報告があり、実測で確認することにした&quot;></textarea>
    <label>目的 <span class=&quot;hint&quot;>この報告で明らかにすること</span></label>
    <textarea id=&quot;rep_goal&quot; placeholder=&quot;例：3つの条件で応答時間を測定し、差を確認する&quot;></textarea>
    <label>方法 <span class=&quot;hint&quot;>第三者が再現できる粒度で（1行1項目）</span></label>
    <textarea id=&quot;rep_method&quot; class=&quot;mono&quot; placeholder=&quot;例）条件A/B/Cで各10回計測&amp;#10;例）計測はブラウザの開発者ツールを使用&quot;></textarea>
    <label>結果【事実のみ】 <span class=&quot;hint&quot;>数値・観測だけ。解釈はここに書かない</span></label>
    <textarea id=&quot;rep_result&quot; placeholder=&quot;例）条件Aの平均は3.2秒、条件Bは1.1秒だった&quot;></textarea>
    <label>考察【解釈・明示】 <span class=&quot;hint&quot;>「根拠 → 〜と考えられる」の形で</span></label>
    <textarea id=&quot;rep_disc&quot; placeholder=&quot;例）条件Aのみログにキャッシュ未使用の記録があったため、これが遅延要因と考えられる&quot;></textarea>
    <label>課題・次アクション</label>
    <textarea id=&quot;rep_next&quot; placeholder=&quot;例）キャッシュ設定を変更して再計測する&quot;></textarea>
    <div class=&quot;warnbox&quot; id=&quot;rep_warn&quot;></div>
    <div class=&quot;btnrow&quot;>
      <button class=&quot;act&quot; onclick=&quot;genRep()&quot;>報告書を生成</button>
      <button class=&quot;ghost&quot; onclick=&quot;clearTab('rep')&quot;>この欄をクリア</button>
    </div>
    <div class=&quot;out&quot;>
      <label>出力</label>
      <textarea id=&quot;rep_out&quot; class=&quot;mono&quot; readonly></textarea>
      <div class=&quot;btnrow&quot;>
        <button class=&quot;ghost&quot; onclick=&quot;copyOut('rep_out')&quot;>コピー</button>
        <button class=&quot;ghost&quot; onclick=&quot;downloadMd('rep_out','技術報告書')&quot;>Markdown保存</button>
      </div>
    </div>
  </div>

  <!-- ④ 不具合・調査報告 -->
  <div class=&quot;panel&quot; id=&quot;p-bug&quot;>
    <h2 class=&quot;sec&quot;>④ 不具合・調査報告</h2>
    <div class=&quot;howto&quot;>
      <b>使い方：</b> 不具合報告でいちばん大事なのは<b>「確定した原因」と「推定の原因」を区別する</b>こと。
      まだ証拠がないものを断定すると、調査が遠回りになります。
      事象・再現条件・期待と実際を事実で埋め、原因は確定／推定に分けて書きましょう。
    </div>
    <label>事象（起きた事実）</label>
    <textarea id=&quot;bug_phen&quot; placeholder=&quot;例）保存ボタンを押すと画面が白くなる&quot;></textarea>
    <label>再現手順 <span class=&quot;hint&quot;>この通りやれば再現する手順（1行1手順）</span></label>
    <textarea id=&quot;bug_repro&quot; class=&quot;mono&quot; placeholder=&quot;例）一覧画面を開く&amp;#10;例）新規作成→保存を押す&quot;></textarea>
    <div class=&quot;row&quot;>
      <div><label>期待される結果</label><textarea id=&quot;bug_expect&quot; placeholder=&quot;例）保存され一覧に戻る&quot;></textarea></div>
      <div><label>実際の結果（事実）</label><textarea id=&quot;bug_actual&quot; placeholder=&quot;例）白画面のまま操作不能&quot;></textarea></div>
    </div>
    <label>影響範囲 <span class=&quot;hint&quot;>分かっている事実の範囲で</span></label>
    <input type=&quot;text&quot; id=&quot;bug_scope&quot; placeholder=&quot;例：新規作成時のみ。編集時は再現しない&quot;>
    <div class=&quot;row&quot;>
      <div><label>原因【確定】<span class=&quot;hint&quot;>証拠で裏付け済みのみ</span></label><textarea id=&quot;bug_cause_fix&quot; placeholder=&quot;例）保存APIが500を返している（ログで確認）&quot;></textarea></div>
      <div><label>原因【推定】<span class=&quot;hint&quot;>未確定。根拠とともに</span></label><textarea id=&quot;bug_cause_guess&quot; placeholder=&quot;例）入力値検証の不足が原因と推定（未確認）&quot;></textarea></div>
    </div>
    <label>エビデンス <span class=&quot;hint&quot;>ログ・エラー全文・スクショの記録など</span></label>
    <textarea id=&quot;bug_evidence&quot; class=&quot;mono&quot; placeholder=&quot;例）サーバログ：500 Internal Server Error at save()&quot;></textarea>
    <div class=&quot;row&quot;>
      <div><label>暫定対応</label><textarea id=&quot;bug_temp&quot; placeholder=&quot;例）該当ボタンを一時非表示&quot;></textarea></div>
      <div><label>恒久対応（案）</label><textarea id=&quot;bug_perm&quot; placeholder=&quot;例）入力値検証を追加し再テスト&quot;></textarea></div>
    </div>
    <div class=&quot;warnbox&quot; id=&quot;bug_warn&quot;></div>
    <div class=&quot;btnrow&quot;>
      <button class=&quot;act&quot; onclick=&quot;genBug()&quot;>調査報告を生成</button>
      <button class=&quot;ghost&quot; onclick=&quot;clearTab('bug')&quot;>この欄をクリア</button>
    </div>
    <div class=&quot;out&quot;>
      <label>出力</label>
      <textarea id=&quot;bug_out&quot; class=&quot;mono&quot; readonly></textarea>
      <div class=&quot;btnrow&quot;>
        <button class=&quot;ghost&quot; onclick=&quot;copyOut('bug_out')&quot;>コピー</button>
        <button class=&quot;ghost&quot; onclick=&quot;downloadMd('bug_out','不具合調査報告')&quot;>Markdown保存</button>
      </div>
    </div>
  </div>

  <!-- ⑤ 誇張→事実 言い換え -->
  <div class=&quot;panel&quot; id=&quot;p-conv&quot;>
    <h2 class=&quot;sec&quot;>⑤ 誇張・主観 → 事実ベース 言い換え</h2>
    <div class=&quot;howto&quot;>
      <b>使い方：</b> 報告でつい使いがちな「ふわっとした言葉」を、事実ベースに直す対応表です。
      下の変換ボックスに自分の文を貼ると、誇張・断定の語を検出して指摘します。
    </div>
    <label>あなたの文をチェック <span class=&quot;hint&quot;>貼り付けて「事実度チェック」を押す</span></label>
    <textarea id=&quot;conv_in&quot; placeholder=&quot;例）たぶん大丈夫です。すごく速くなって、完璧に動きました。&quot;></textarea>
    <div class=&quot;warnbox&quot; id=&quot;conv_warn&quot;></div>
    <div class=&quot;btnrow&quot;>
      <button class=&quot;act&quot; onclick=&quot;checkConv()&quot;>事実度チェック</button>
      <button class=&quot;ghost&quot; onclick=&quot;clearTab('conv')&quot;>クリア</button>
    </div>
    <h2 class=&quot;sec&quot; style=&quot;margin-top:22px;&quot;>言い換え対応表</h2>
    <table class=&quot;conv&quot;>
      <thead><tr><th>つい言いがち（主観・誇張）</th><th>事実ベースの言い換え</th></tr></thead>
      <tbody id=&quot;conv_table&quot;></tbody>
    </table>
  </div>

  <!-- ⑥ hub -->
  <div class=&quot;panel&quot; id=&quot;p-hub&quot;>
    <h2 class=&quot;sec&quot;>⑥ データ保管（JSON）</h2>
    <div class=&quot;howto&quot;>
      <b>使い方：</b> 入力中の全タブの内容を1つのJSONファイルとして保存／復元できます。
      保存先はあなたの端末だけです（どこにも送信されません）。研修の続きや提出前バックアップにどうぞ。
    </div>
    <div class=&quot;btnrow&quot;>
      <button class=&quot;act&quot; onclick=&quot;hubSave()&quot;>すべて保存（JSONダウンロード）</button>
      <button class=&quot;ghost&quot; onclick=&quot;document.getElementById('hub_file').click()&quot;>JSONを読み込む</button>
      <input type=&quot;file&quot; id=&quot;hub_file&quot; accept=&quot;application/json,.json&quot; style=&quot;display:none&quot; onchange=&quot;hubLoad(event)&quot;>
      <button class=&quot;ghost&quot; onclick=&quot;hubClear()&quot;>すべてクリア</button>
    </div>
    <div class=&quot;out&quot;>
      <label>状態</label>
      <textarea id=&quot;hub_out&quot; readonly placeholder=&quot;ここに保存・読み込みの結果が表示されます&quot;></textarea>
    </div>
  </div>

  <div class=&quot;foot&quot;>
    🐰 うさうさエンジニア研究室 ・ <span class=&quot;motto&quot;>面白きこともなき世を面白く</span><br>
    登録不要・インストール不要・完全オフライン動作。入力内容は端末内のみで処理されます。
  </div>
</div>

<div class=&quot;toast&quot; id=&quot;toast&quot;></div>

<script>
/* ===== 共通ユーティリティ ===== */
function nowParts(){
  var d=new Date();
  var wd=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var y=d.getFullYear(), mo=(&quot;0&quot;+(d.getMonth()+1)).slice(-2), da=(&quot;0&quot;+d.getDate()).slice(-2);
  var hh=(&quot;0&quot;+d.getHours()).slice(-2), mi=(&quot;0&quot;+d.getMinutes()).slice(-2);
  return {
    date:y+&quot;/&quot;+mo+&quot;/&quot;+da+&quot;（&quot;+wd+&quot;）&quot;,
    time:hh+&quot;:&quot;+mi,
    datetime:y+&quot;/&quot;+mo+&quot;/&quot;+da+&quot;（&quot;+wd+&quot;） &quot;+hh+&quot;:&quot;+mi
  };
}
function esc(s){ return String(s).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function v(id){ var el=document.getElementById(id); return el? el.value.trim() : &quot;&quot;; }
function lines(id){ return v(id).split(/\r?\n/).map(function(s){return s.trim();}).filter(function(s){return s.length>0;}); }
function toast(msg){
  var t=document.getElementById(&quot;toast&quot;); t.textContent=msg; t.classList.add(&quot;show&quot;);
  setTimeout(function(){ t.classList.remove(&quot;show&quot;); }, 1600);
}
function setOut(id, txt){ document.getElementById(id).value=txt; }
function copyOut(id){
  var el=document.getElementById(id);
  if(!el.value){ toast(&quot;先に生成してください&quot;); return; }
  el.select();
  try{
    if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){
      navigator.clipboard.writeText(el.value).then(function(){toast(&quot;コピーしました&quot;);},function(){ fallbackCopy(el); });
    } else { fallbackCopy(el); }
  }catch(e){ fallbackCopy(el); }
}
function fallbackCopy(el){
  try{ document.execCommand(&quot;copy&quot;); toast(&quot;コピーしました&quot;); }
  catch(e){ toast(&quot;コピーに失敗しました&quot;); }
}
function _saveBlob(text, filename){
  try{
    var blob=new Blob([text],{type:&quot;text/plain;charset=utf-8&quot;});
    var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;);
    a.href=url; a.download=filename;
    document.body.appendChild(a); a.click();
    setTimeout(function(){ document.body.removeChild(a); URL.revokeObjectURL(url); }, 100);
  }catch(e){ toast(&quot;保存に失敗しました&quot;); }
}
function downloadTxt(id, base){
  var t=document.getElementById(id).value;
  if(!t){ toast(&quot;先に生成してください&quot;); return; }
  _saveBlob(t, base+&quot;_&quot;+stamp()+&quot;.txt&quot;); toast(&quot;テキストを保存しました&quot;);
}
function downloadMd(id, base){
  var t=document.getElementById(id).value;
  if(!t){ toast(&quot;先に生成してください&quot;); return; }
  _saveBlob(t, base+&quot;_&quot;+stamp()+&quot;.md&quot;); toast(&quot;Markdownを保存しました&quot;);
}
function stamp(){
  var d=new Date();
  return d.getFullYear()+(&quot;0&quot;+(d.getMonth()+1)).slice(-2)+(&quot;0&quot;+d.getDate()).slice(-2);
}
function setNow(id){ document.getElementById(id).value=nowParts().datetime; }

/* ===== 誇張・断定語の検出 ===== */
var EXAGG=[&quot;たぶん&quot;,&quot;おそらく&quot;,&quot;きっと&quot;,&quot;だいたい&quot;,&quot;ちゃんと&quot;,&quot;しっかり&quot;,&quot;すごく&quot;,&quot;とても&quot;,&quot;かなり&quot;,&quot;めっちゃ&quot;,
  &quot;完璧&quot;,&quot;絶対&quot;,&quot;必ず&quot;,&quot;100%&quot;,&quot;全部&quot;,&quot;すべて完了&quot;,&quot;問題なし&quot;,&quot;バッチリ&quot;,&quot;余裕&quot;,&quot;簡単に&quot;,&quot;一瞬で&quot;,&quot;爆速&quot;,&quot;神&quot;,&quot;最強&quot;];
function findExagg(text){
  var hit=[];
  EXAGG.forEach(function(w){ if(text.indexOf(w)>=0 &amp;&amp; hit.indexOf(w)<0) hit.push(w); });
  return hit;
}
function showWarn(id, hits){
  var box=document.getElementById(id);
  if(hits.length){
    box.innerHTML=&quot;<b>⚠ 誇張・断定の可能性がある語が見つかりました：</b> &quot;+
      hits.map(function(w){return &quot;「&quot;+esc(w)+&quot;」&quot;;}).join(&quot;、&quot;)+
      &quot;<br>本当に事実（測定・観測）で裏付けられますか？ 言い換えタブも参考にしてください。&quot;;
    box.classList.add(&quot;show&quot;);
  } else {
    box.classList.remove(&quot;show&quot;); box.innerHTML=&quot;&quot;;
  }
}

/* ===== ① 事実と所感の分離 ===== */
function genSep(){
  var fact=lines(&quot;sep_fact&quot;), num=lines(&quot;sep_num&quot;), infer=lines(&quot;sep_infer&quot;), opin=lines(&quot;sep_opin&quot;);
  if(!fact.length &amp;&amp; !num.length &amp;&amp; !infer.length &amp;&amp; !opin.length){ toast(&quot;いずれかの箱に入力してください&quot;); return; }
  var L=[];
  L.push(&quot;【報告：&quot;+nowParts().date+&quot;】&quot;); L.push(&quot;&quot;);
  L.push(&quot;■ 事実（観測したこと）&quot;);
  L.push(fact.length? fact.map(function(s){return &quot;・&quot;+s;}).join(&quot;\n&quot;) : &quot;・（なし）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;■ 測定値（数えた・計った数値）&quot;);
  L.push(num.length? num.map(function(s){return &quot;・&quot;+s;}).join(&quot;\n&quot;) : &quot;・（なし）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;■ 推測（※未確定。根拠とともに）&quot;);
  L.push(infer.length? infer.map(function(s){return &quot;・&quot;+s;}).join(&quot;\n&quot;) : &quot;・（なし）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;■ 所感（主観・感想。事実ではない）&quot;);
  L.push(opin.length? opin.map(function(s){return &quot;・&quot;+s;}).join(&quot;\n&quot;) : &quot;・（なし）&quot;);
  setOut(&quot;sep_out&quot;, L.join(&quot;\n&quot;));
  // 事実・測定値の箱に誇張語がないかチェック（事実欄に主観が混ざる典型ミス）
  var hits=findExagg((v(&quot;sep_fact&quot;)+&quot; &quot;+v(&quot;sep_num&quot;)));
  showWarn(&quot;sep_warn&quot;, hits);
  toast(&quot;仕分け報告を生成しました&quot;);
}

/* ===== ② 作業・検証ログ ===== */
function genLog(){
  var dt=v(&quot;log_dt&quot;)||nowParts().datetime;
  var steps=lines(&quot;log_steps&quot;);
  var L=[];
  L.push(&quot;=== 作業・検証ログ ===&quot;);
  L.push(&quot;日時      : &quot;+dt);
  L.push(&quot;担当      : &quot;+(v(&quot;log_who&quot;)||&quot;（未記入）&quot;));
  L.push(&quot;目的      : &quot;+(v(&quot;log_goal&quot;)||&quot;（未記入）&quot;));
  L.push(&quot;環境      : &quot;+(v(&quot;log_env&quot;)||&quot;（未記入）&quot;));
  L.push(&quot;&quot;);
  L.push(&quot;[前提条件]&quot;);
  var pre=lines(&quot;log_pre&quot;);
  L.push(pre.length? pre.map(function(s){return &quot; - &quot;+s;}).join(&quot;\n&quot;) : &quot; - （未記入）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;[実施手順]&quot;);
  L.push(steps.length? steps.map(function(s,i){return &quot; &quot;+(i+1)+&quot;. &quot;+s;}).join(&quot;\n&quot;) : &quot; （未記入）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;[観測した事実・数値]&quot;);
  var obs=lines(&quot;log_obs&quot;);
  L.push(obs.length? obs.map(function(s){return &quot; - &quot;+s;}).join(&quot;\n&quot;) : &quot; - （未記入）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;[発生したエラー（原文）]&quot;);
  L.push(v(&quot;log_err&quot;)? v(&quot;log_err&quot;) : &quot; （なし）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;[確認できたこと / 未確認なこと]&quot;);
  var st=lines(&quot;log_status&quot;);
  L.push(st.length? st.map(function(s){return &quot; - &quot;+s;}).join(&quot;\n&quot;) : &quot; - （未記入）&quot;);
  setOut(&quot;log_out&quot;, L.join(&quot;\n&quot;));
  toast(&quot;ログを生成しました&quot;);
}

/* ===== ③ 技術報告書 IMRAD ===== */
function genRep(){
  var t=v(&quot;rep_title&quot;)||&quot;技術報告書&quot;;
  var L=[];
  L.push(&quot;# &quot;+t);
  L.push(&quot;&quot;);
  L.push(&quot;作成日: &quot;+nowParts().date);
  L.push(&quot;&quot;);
  L.push(&quot;## 1. 背景&quot;);
  L.push(v(&quot;rep_bg&quot;)||&quot;（未記入）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;## 2. 目的&quot;);
  L.push(v(&quot;rep_goal&quot;)||&quot;（未記入）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;## 3. 方法&quot;);
  var m=lines(&quot;rep_method&quot;);
  L.push(m.length? m.map(function(s){return &quot;- &quot;+s;}).join(&quot;\n&quot;) : &quot;（未記入）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;## 4. 結果【事実】&quot;);
  L.push(v(&quot;rep_result&quot;)||&quot;（未記入）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;## 5. 考察【解釈】&quot;);
  L.push(&quot;> ここから下は事実ではなく、書き手の解釈です。&quot;);
  L.push(&quot;&quot;);
  L.push(v(&quot;rep_disc&quot;)||&quot;（未記入）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;## 6. 課題・次アクション&quot;);
  L.push(v(&quot;rep_next&quot;)||&quot;（未記入）&quot;);
  setOut(&quot;rep_out&quot;, L.join(&quot;\n&quot;));
  // 結果欄に誇張語/解釈語が混ざっていないかチェック
  var hits=findExagg(v(&quot;rep_result&quot;));
  if(v(&quot;rep_result&quot;).indexOf(&quot;考えられる&quot;)>=0 || v(&quot;rep_result&quot;).indexOf(&quot;と思&quot;)>=0){ hits.push(&quot;（結果欄に解釈表現）&quot;); }
  showWarn(&quot;rep_warn&quot;, hits);
  toast(&quot;報告書を生成しました&quot;);
}

/* ===== ④ 不具合・調査報告 ===== */
function genBug(){
  var L=[];
  L.push(&quot;# 不具合・調査報告&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;報告日: &quot;+nowParts().date);
  L.push(&quot;&quot;);
  L.push(&quot;## 事象（事実）&quot;);
  L.push(v(&quot;bug_phen&quot;)||&quot;（未記入）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;## 再現手順&quot;);
  var r=lines(&quot;bug_repro&quot;);
  L.push(r.length? r.map(function(s,i){return (i+1)+&quot;. &quot;+s;}).join(&quot;\n&quot;) : &quot;（未記入）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;## 期待される結果 / 実際の結果&quot;);
  L.push(&quot;- 期待: &quot;+(v(&quot;bug_expect&quot;)||&quot;（未記入）&quot;));
  L.push(&quot;- 実際: &quot;+(v(&quot;bug_actual&quot;)||&quot;（未記入）&quot;));
  L.push(&quot;&quot;);
  L.push(&quot;## 影響範囲&quot;);
  L.push(v(&quot;bug_scope&quot;)||&quot;（未記入）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;## 原因&quot;);
  L.push(&quot;- 【確定】&quot;+(v(&quot;bug_cause_fix&quot;)||&quot;（確定なし）&quot;));
  L.push(&quot;- 【推定】&quot;+(v(&quot;bug_cause_guess&quot;)||&quot;（推定なし）&quot;));
  L.push(&quot;&quot;);
  L.push(&quot;## エビデンス&quot;);
  L.push(v(&quot;bug_evidence&quot;)||&quot;（未記入）&quot;);
  L.push(&quot;&quot;);
  L.push(&quot;## 対応&quot;);
  L.push(&quot;- 暫定: &quot;+(v(&quot;bug_temp&quot;)||&quot;（未記入）&quot;));
  L.push(&quot;- 恒久(案): &quot;+(v(&quot;bug_perm&quot;)||&quot;（未記入）&quot;));
  setOut(&quot;bug_out&quot;, L.join(&quot;\n&quot;));
  // 確定原因に誇張語チェック
  var hits=findExagg(v(&quot;bug_cause_fix&quot;));
  showWarn(&quot;bug_warn&quot;, hits);
  toast(&quot;調査報告を生成しました&quot;);
}

/* ===== ⑤ 言い換え ===== */
var CONV=[
  [&quot;たぶん／おそらく 大丈夫&quot;, &quot;○○の条件では動作を確認。△△は未確認&quot;],
  [&quot;ちゃんと動いた&quot;, &quot;テスト◯件中◯件で期待結果と一致&quot;],
  [&quot;すごく速くなった&quot;, &quot;処理時間が X秒 → Y秒（Z%短縮）&quot;],
  [&quot;完璧です／問題なし&quot;, &quot;確認した範囲（項目を列挙）では不具合なし&quot;],
  [&quot;だいたい終わった&quot;, &quot;全◯項目中◯項目が完了。残りは△△&quot;],
  [&quot;急いで直しました&quot;, &quot;◯時に修正、◯◯のテストで確認済み&quot;],
  [&quot;バグが多い&quot;, &quot;確認したバグは◯件（一覧を添付）&quot;],
  [&quot;重いと思う&quot;, &quot;メモリ使用量 ◯◯MB、応答 ◯秒を観測&quot;],
  [&quot;うまくいかない&quot;, &quot;◯◯の操作で△△のエラーが発生（全文を記載）&quot;],
  [&quot;やっておきました&quot;, &quot;◯◯を実施。結果は△△（証跡: ログ/スクショ）&quot;]
];
function buildConvTable(){
  var tb=document.getElementById(&quot;conv_table&quot;);
  tb.innerHTML=&quot;&quot;;
  CONV.forEach(function(pair){
    var tr=document.createElement(&quot;tr&quot;);
    tr.innerHTML=&quot;<td>&quot;+esc(pair[0])+&quot;</td><td>&quot;+esc(pair[1])+&quot;</td>&quot;;
    tb.appendChild(tr);
  });
}
function checkConv(){
  var txt=v(&quot;conv_in&quot;);
  if(!txt){ toast(&quot;文を入力してください&quot;); document.getElementById(&quot;conv_warn&quot;).classList.remove(&quot;show&quot;); return; }
  var hits=findExagg(txt);
  var box=document.getElementById(&quot;conv_warn&quot;);
  if(hits.length){
    box.innerHTML=&quot;<b>⚠ 事実度を下げている語：</b> &quot;+hits.map(function(w){return &quot;「&quot;+esc(w)+&quot;」&quot;;}).join(&quot;、&quot;)+
      &quot;<br>下の対応表を参考に、数値や観測した事実に置き換えましょう。&quot;;
    box.classList.add(&quot;show&quot;);
  } else {
    box.innerHTML=&quot;<b style='color:#2E5E4E'>✔ 誇張・断定の語は見つかりませんでした。</b> 数値や条件が具体的に書けているか最終確認しましょう。&quot;;
    box.classList.add(&quot;show&quot;);
  }
}

/* ===== タブ切替 ===== */
var TABS=[&quot;sep&quot;,&quot;log&quot;,&quot;rep&quot;,&quot;bug&quot;,&quot;conv&quot;,&quot;hub&quot;];
function switchTab(tab){
  document.querySelectorAll(&quot;.tab&quot;).forEach(function(t){ t.classList.toggle(&quot;active&quot;, t.getAttribute(&quot;data-tab&quot;)===tab); });
  TABS.forEach(function(t){
    var pe=document.getElementById(&quot;p-&quot;+t);
    if(pe) pe.classList.toggle(&quot;active&quot;, t===tab);
  });
}
document.querySelectorAll(&quot;.tab&quot;).forEach(function(t){
  t.addEventListener(&quot;click&quot;, function(){ switchTab(t.getAttribute(&quot;data-tab&quot;)); });
});

/* ===== クリア ===== */
var FIELDS={
  sep:[&quot;sep_fact&quot;,&quot;sep_num&quot;,&quot;sep_infer&quot;,&quot;sep_opin&quot;,&quot;sep_out&quot;],
  log:[&quot;log_dt&quot;,&quot;log_who&quot;,&quot;log_goal&quot;,&quot;log_env&quot;,&quot;log_pre&quot;,&quot;log_steps&quot;,&quot;log_obs&quot;,&quot;log_err&quot;,&quot;log_status&quot;,&quot;log_out&quot;],
  rep:[&quot;rep_title&quot;,&quot;rep_bg&quot;,&quot;rep_goal&quot;,&quot;rep_method&quot;,&quot;rep_result&quot;,&quot;rep_disc&quot;,&quot;rep_next&quot;,&quot;rep_out&quot;],
  bug:[&quot;bug_phen&quot;,&quot;bug_repro&quot;,&quot;bug_expect&quot;,&quot;bug_actual&quot;,&quot;bug_scope&quot;,&quot;bug_cause_fix&quot;,&quot;bug_cause_guess&quot;,&quot;bug_evidence&quot;,&quot;bug_temp&quot;,&quot;bug_perm&quot;,&quot;bug_out&quot;],
  conv:[&quot;conv_in&quot;]
};
function clearTab(tab){
  (FIELDS[tab]||[]).forEach(function(id){ var el=document.getElementById(id); if(el) el.value=&quot;&quot;; });
  [&quot;sep_warn&quot;,&quot;rep_warn&quot;,&quot;bug_warn&quot;,&quot;conv_warn&quot;].forEach(function(id){ var b=document.getElementById(id); if(b){b.classList.remove(&quot;show&quot;);b.innerHTML=&quot;&quot;;} });
  toast(&quot;クリアしました&quot;);
}

/* ===== hub: JSON保存/復元/全消去 ===== */
function collectAll(){
  var data={ _tool:&quot;usausa_fact_report&quot;, _ver:&quot;1.0&quot;, _saved:nowParts().datetime, fields:{} };
  Object.keys(FIELDS).forEach(function(tab){
    FIELDS[tab].forEach(function(id){
      if(id.indexOf(&quot;_out&quot;)>=0) return; // 出力欄は保存しない
      var el=document.getElementById(id);
      if(el) data.fields[id]=el.value;
    });
  });
  return data;
}
function applyAll(data){
  if(!data || !data.fields){ throw new Error(&quot;形式が不正です&quot;); }
  Object.keys(data.fields).forEach(function(id){
    var el=document.getElementById(id);
    if(el) el.value=data.fields[id];
  });
}
function hubSave(){
  try{
    var json=JSON.stringify(collectAll(), null, 2);
    _saveBlob(json, &quot;fact_report_保存_&quot;+stamp()+&quot;.json&quot;);
    document.getElementById(&quot;hub_out&quot;).value=&quot;保存しました（&quot;+nowParts().datetime+&quot;）\nファイル名: fact_report_保存_&quot;+stamp()+&quot;.json&quot;;
    toast(&quot;JSONを保存しました&quot;);
  }catch(e){ toast(&quot;保存に失敗しました&quot;); }
}
function hubLoad(ev){
  var file=ev.target.files &amp;&amp; ev.target.files[0];
  if(!file){ return; }
  var reader=new FileReader();
  reader.onload=function(e){
    try{
      var data=JSON.parse(e.target.result);
      applyAll(data);
      document.getElementById(&quot;hub_out&quot;).value=&quot;読み込みました（保存日時: &quot;+(data._saved||&quot;不明&quot;)+&quot;）&quot;;
      toast(&quot;読み込みました&quot;);
    }catch(err){
      document.getElementById(&quot;hub_out&quot;).value=&quot;読み込み失敗: &quot;+err.message;
      toast(&quot;JSONの形式が不正です&quot;);
    }
    ev.target.value=&quot;&quot;;
  };
  reader.onerror=function(){ toast(&quot;ファイルを読めませんでした&quot;); };
  reader.readAsText(file);
}
function hubClear(){
  if(!confirm(&quot;すべてのタブの入力を消去します。よろしいですか？&quot;)) return;
  Object.keys(FIELDS).forEach(function(tab){ clearTabSilent(tab); });
  document.getElementById(&quot;hub_out&quot;).value=&quot;すべてクリアしました（&quot;+nowParts().datetime+&quot;）&quot;;
  toast(&quot;すべてクリアしました&quot;);
}
function clearTabSilent(tab){
  (FIELDS[tab]||[]).forEach(function(id){ var el=document.getElementById(id); if(el) el.value=&quot;&quot;; });
}

/* ===== 初期化 ===== */
(function init(){
  document.getElementById(&quot;ver_today&quot;).textContent=nowParts().date+&quot; 版&quot;;
  setNow(&quot;log_dt&quot;);
  buildConvTable();
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-kotei" title="開発工程APIなし" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 開発工程の教え方ツール 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#3a2a14,#4a3618 55%,#3a2810);color:#f6efe2;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(220,170,90,.5);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.88}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.05);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.09);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#c4a878;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(220,170,90,.22);border-bottom:2px solid #dcaa5a;color:#f0c884;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#c4a878;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(220,170,90,.34);border:1px solid #dcaa5a;color:#f0c884;}
  label{display:block;font-size:12px;font-weight:700;color:#d6c0a0;margin-bottom:6px;}
  textarea,input[type=password],select{width:100%;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.12);
    border-radius:8px;padding:10px 12px;color:#f6efe2;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#dcaa5a,#b97f2f);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>🥞</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#f0c884,#dcaa5a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>開発工程の教え方ツール</h1>
      <p style=&quot;margin:0;font-size:11px;color:#c4a878;&quot; id=&quot;subtitle&quot;>【APIキーなし版】完全オフライン。手動プロンプト→JSON取り込み。文系=ホットケーキ／理系=原理原則</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 設定</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>📖 教材</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0;font-size:12px;color:#d6c0a0;line-height:1.7;&quot;>🥞 工程と対象を選ぶと、教材を作ります。<b style=&quot;color:#f0c884;&quot;>文系新卒にはホットケーキ作りのたとえ</b>で、<b style=&quot;color:#f0c884;&quot;>理系新卒には原理原則のみ</b>で説明します。</p>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #dcaa5a;&quot;>
        <label>🔧 教える工程</label>
        <select id=&quot;f_phase&quot;><option value=&quot;要求定義&quot;>要求定義（何がしたいか）</option><option value=&quot;要件定義&quot;>要件定義（何を作るか決める）</option><option value=&quot;実装&quot;>実装（実際に作る）</option><option value=&quot;テスト&quot;>テスト（ちゃんと動くか確認）</option><option value=&quot;全工程まとめて&quot;>全工程まとめて（流れ全体）</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #d49e4a;&quot;>
        <label>🎓 対象（説明スタイルが変わります）</label>
        <select id=&quot;f_audience&quot;><option value=&quot;文系新卒&quot;>文系新卒（🥞 ホットケーキで例える）</option><option value=&quot;理系新卒&quot;>理系新卒（📐 原理原則のみ）</option></select>
      </div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;border-left:3px solid #c8923f;&quot;>
      <label>📦 題材（任意・何の開発を例にするか）</label>
      <input id=&quot;f_subject&quot; placeholder=&quot;例：勤怠管理アプリ／社内の問い合わせ管理システム（空ならツール側で例を用意）&quot;>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>📝 補足（受講生の理解度・盛り込みたい観点など・任意）</label>
      <textarea id=&quot;f_note&quot; placeholder=&quot;プログラミング未経験。まず全体像をつかませたい。専門用語は最後に正式名称を添える程度で。&quot;></textarea>
    </div>

    

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#d6c0a0;&quot;>🛠 使い方（3ステップ）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#9c8460;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(220,170,90,.2);border:1px solid #dcaa5a;border-radius:8px;padding:7px 14px;color:#f0c884;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:7px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで教材を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#d6c0a0;&quot;>✨ 生成されるもの</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#8a7250;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>🥞</div>
      <p>「設定」タブで工程と対象を選んでください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:14px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;metaLine&quot; style=&quot;font-size:11px;color:#c4a878;margin-bottom:14px;&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「IT開発工程の研修講師」です。新卒に、要求定義→要件定義→実装→テストの工程をやさしく教える教材を作ります。
工程の本質：要求定義＝利用者が「何をしたい・困っている」かを引き出す。要件定義＝それを実現するために「何を作るか」を具体的に決める。実装＝決めたものを実際に作る。テスト＝意図どおり動くか確認する。
対象による説明スタイルの切り替え（重要）：
- 対象が「文系新卒」の場合：ホットケーキ作りのたとえで説明する。要求定義＝「ふわふわで甘いホットケーキが食べたい」という願いを聞く / 要件定義＝レシピと分量・焼き時間を決める（直径15cm・きつね色・3枚 等）/ 実装＝実際に生地を混ぜて焼く / テスト＝味見して焼け具合・甘さを確認する。専門用語は最後に正式名称を一言添える程度にし、まずイメージで理解させる。
- 対象が「理系新卒」の場合：たとえは使わず、原理原則のみで説明する。各工程の定義・入力（インプット）・出力（アウトプット）・なぜ必要か・典型的な失敗（手戻りの原因）を簡潔に。論理的・構造的に。
共通：誇張しない。個人名・会社名は出さない。
ユーザーの条件（工程/対象/題材/補足）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;meta&quot;: {&quot;phase&quot;: &quot;工程&quot;, &quot;audience&quot;: &quot;対象&quot;, &quot;subject&quot;: &quot;題材&quot;},
  &quot;overview&quot;: &quot;この工程は何か（1〜2文・対象に合わせた言葉で）&quot;,
  &quot;explain&quot;: &quot;本文の説明（文系はやさしく具体イメージ、理系は原理原則・構造的に）&quot;,
  &quot;analogy&quot;: &quot;文系の場合：ホットケーキのたとえで具体的に。理系の場合：たとえではなく『原理原則の要点』を箇条書き的に（## 不要、文章で）&quot;,
  &quot;keypoints&quot;: [&quot;押さえるべきポイントを3〜5個&quot;],
  &quot;fieldMeaning&quot;: &quot;現場・実務でこの工程がどう効いてくるか（手を抜くと何が起きるか）&quot;,
  &quot;check&quot;: [
    {&quot;q&quot;: &quot;理解度チェックの問い&quot;, &quot;a&quot;: &quot;答え・解説&quot;}
  ]
}
注意：対象が文系ならanalogyは必ずホットケーキのたとえにする。理系ならanalogyにたとえを入れず原理原則の要点にする。checkは2〜3問。`;

var FIELD_TAGS=[&quot;📖 説明&quot;,&quot;🥞 たとえ／📐 原理&quot;,&quot;💼 現場での意味&quot;,&quot;✅ 理解チェック&quot;];
var result=null, tab=&quot;input&quot;, viewTab=&quot;explain&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }
function isBunkei(){ var a=(result&amp;&amp;result.meta&amp;&amp;result.meta.audience)||$(&quot;f_audience&quot;).value; return (a||&quot;&quot;).indexOf(&quot;文系&quot;)>=0; }
function readForm(){
  return { phase:$(&quot;f_phase&quot;).value, audience:$(&quot;f_audience&quot;).value, subject:($(&quot;f_subject&quot;).value||&quot;&quot;).trim(), note:($(&quot;f_note&quot;).value||&quot;&quot;).trim() };
}
function buildUserMsg(){
  var f=readForm();
  return [&quot;## 開発工程の教材の条件&quot;,
    &quot;【教える工程】&quot;+f.phase,
    &quot;【対象】&quot;+f.audience,
    &quot;【題材】&quot;+(f.subject||&quot;指定なし（適切な例を用意）&quot;),
    &quot;【補足】&quot;+(f.note||&quot;なし&quot;)].join(&quot;\n&quot;);
}

function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(220,170,90,.16);border:1px solid rgba(220,170,90,.32);border-radius:20px;padding:3px 11px;font-size:11px;color:#f0c884;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}

function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}

function importJson(){
  setErr(&quot;&quot;);
  try{
    var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}

function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function copyBtn(btn, text){ copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000); }

function subLabel(){ return isBunkei()?&quot;🥞 たとえ（ホットケーキ）&quot;:&quot;📐 原理原則&quot;; }
var SUBKEYS=[&quot;explain&quot;,&quot;analogy&quot;,&quot;field&quot;,&quot;check&quot;];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var labels={explain:&quot;📖 説明&quot;, analogy:subLabel(), field:&quot;💼 現場での意味&quot;, check:&quot;✅ 理解チェック&quot;};
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBKEYS.forEach(function(k){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===k?&quot; active&quot;:&quot;&quot;); b.textContent=labels[k];
    b.onclick=function(){ viewTab=k; renderResult(); };
    st.appendChild(b);
  });
  var meta=result.meta||{};
  $(&quot;metaLine&quot;).textContent=[meta.phase,meta.audience,meta.subject].filter(Boolean).join(&quot;　/　&quot;);
  var v=$(&quot;resultView&quot;); v.innerHTML=renderView();
  [].slice.call(v.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); }); });
  [].slice.call(v.querySelectorAll(&quot;[data-reveal]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ var t=document.getElementById(b.getAttribute(&quot;data-reveal&quot;)); if(t) t.style.display=(t.style.display===&quot;none&quot;?&quot;block&quot;:&quot;none&quot;); }); });
}
function card(inner){ return '<div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;explain&quot;) return viewExplain();
  if(viewTab===&quot;analogy&quot;) return viewAnalogy();
  if(viewTab===&quot;field&quot;) return viewField();
  if(viewTab===&quot;check&quot;) return viewCheck();
  return &quot;&quot;;
}
function viewExplain(){
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#d6c0a0;font-weight:700;&quot;>📖 説明</h3>';
  if(result.overview){ h+=card('<p style=&quot;margin:0;font-size:13px;color:#f0c884;font-weight:700;line-height:1.8;&quot;>'+esc(result.overview)+'</p>'); }
  var kp=(result.keypoints||[]).map(function(p){return '<li style=&quot;margin:4px 0;&quot;>'+esc(p)+'</li>';}).join(&quot;&quot;);
  h+=card('<div style=&quot;white-space:pre-wrap;font-size:13px;color:#f6efe2;line-height:1.95;&quot;>'+esc(result.explain||&quot;（未入力）&quot;)+'</div>'+
    (kp?'<div style=&quot;margin-top:12px;border-top:1px solid rgba(255,255,255,.08);padding-top:10px;&quot;><p style=&quot;margin:0 0 4px;font-size:11px;font-weight:700;color:#c4a878;&quot;>📌 ポイント</p><ul style=&quot;margin:0;padding-left:18px;font-size:12px;color:#d6c0a0;&quot;>'+kp+'</ul></div>':''));
  return h;
}
function viewAnalogy(){
  var bunkei=isBunkei();
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#d6c0a0;font-weight:700;&quot;>'+(bunkei?&quot;🥞 ホットケーキで例えると&quot;:&quot;📐 原理原則&quot;)+'</h3>';
  var body=result.analogy||&quot;&quot;;
  if(!body) return h+card('<p style=&quot;color:#8a7250;font-size:12px;&quot;>データがありません</p>');
  var border=bunkei?&quot;#dcaa5a&quot;:&quot;#7fa8d9&quot;;
  h+=card('<div style=&quot;white-space:pre-wrap;font-size:13px;color:#f6efe2;line-height:1.95;border-left:3px solid '+border+';padding-left:12px;&quot;>'+esc(body)+'</div>');
  return h;
}
function viewField(){
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#d6c0a0;font-weight:700;&quot;>💼 現場での意味</h3>';
  h+=card('<div style=&quot;white-space:pre-wrap;font-size:13px;color:#f6efe2;line-height:1.95;&quot;>'+esc(result.fieldMeaning||&quot;（未入力）&quot;)+'</div>');
  return h;
}
function viewCheck(){
  var arr=result.check||[];
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#d6c0a0;font-weight:700;&quot;>✅ 理解チェック</h3>';
  if(!arr.length) return h+card('<p style=&quot;color:#8a7250;font-size:12px;&quot;>問題がありません</p>');
  arr.forEach(function(x,i){
    var aid=&quot;chk_&quot;+i;
    h+=card('<p style=&quot;margin:0 0 8px;font-size:13px;color:#f6efe2;font-weight:700;&quot;>Q'+(i+1)+'. '+esc(x.q||&quot;&quot;)+'</p>'+
      '<button class=&quot;btn&quot; data-reveal=&quot;'+aid+'&quot; style=&quot;background:rgba(220,170,90,.2);border:1px solid #dcaa5a;border-radius:8px;padding:5px 12px;color:#f0c884;font-size:11px;cursor:pointer;font-weight:600;&quot;>💡 答えを見る</button>'+
      '<div id=&quot;'+aid+'&quot; style=&quot;display:none;margin-top:8px;padding:10px;background:rgba(31,157,107,.12);border-left:3px solid #1f9d6b;border-radius:6px;font-size:13px;color:#7fd9b3;line-height:1.85;&quot;>'+esc(x.a||&quot;&quot;)+'</div>');
  });
  return h;
}

renderTags();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-koteiapi" title="開発工程APIあり" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 開発工程の教え方ツール 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#3a2a14,#4a3618 55%,#3a2810);color:#f6efe2;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(220,170,90,.5);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.88}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.05);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.09);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#c4a878;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(220,170,90,.22);border-bottom:2px solid #dcaa5a;color:#f0c884;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#c4a878;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(220,170,90,.34);border:1px solid #dcaa5a;color:#f0c884;}
  label{display:block;font-size:12px;font-weight:700;color:#d6c0a0;margin-bottom:6px;}
  textarea,input[type=password],select{width:100%;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.12);
    border-radius:8px;padding:10px 12px;color:#f6efe2;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#dcaa5a,#b97f2f);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>🥞</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#f0c884,#dcaa5a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>開発工程の教え方ツール</h1>
      <p style=&quot;margin:0;font-size:11px;color:#c4a878;&quot; id=&quot;subtitle&quot;>【APIキー版】キーを入れると教材を自動生成。文系=ホットケーキ／理系=原理原則</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 設定</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>📖 教材</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0;font-size:12px;color:#d6c0a0;line-height:1.7;&quot;>🥞 工程と対象を選ぶと、教材を作ります。<b style=&quot;color:#f0c884;&quot;>文系新卒にはホットケーキ作りのたとえ</b>で、<b style=&quot;color:#f0c884;&quot;>理系新卒には原理原則のみ</b>で説明します。</p>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #dcaa5a;&quot;>
        <label>🔧 教える工程</label>
        <select id=&quot;f_phase&quot;><option value=&quot;要求定義&quot;>要求定義（何がしたいか）</option><option value=&quot;要件定義&quot;>要件定義（何を作るか決める）</option><option value=&quot;実装&quot;>実装（実際に作る）</option><option value=&quot;テスト&quot;>テスト（ちゃんと動くか確認）</option><option value=&quot;全工程まとめて&quot;>全工程まとめて（流れ全体）</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #d49e4a;&quot;>
        <label>🎓 対象（説明スタイルが変わります）</label>
        <select id=&quot;f_audience&quot;><option value=&quot;文系新卒&quot;>文系新卒（🥞 ホットケーキで例える）</option><option value=&quot;理系新卒&quot;>理系新卒（📐 原理原則のみ）</option></select>
      </div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;border-left:3px solid #c8923f;&quot;>
      <label>📦 題材（任意・何の開発を例にするか）</label>
      <input id=&quot;f_subject&quot; placeholder=&quot;例：勤怠管理アプリ／社内の問い合わせ管理システム（空ならツール側で例を用意）&quot;>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>📝 補足（受講生の理解度・盛り込みたい観点など・任意）</label>
      <textarea id=&quot;f_note&quot; placeholder=&quot;プログラミング未経験。まず全体像をつかませたい。専門用語は最後に正式名称を添える程度で。&quot;></textarea>
    </div>

    <div class=&quot;card&quot; id=&quot;apiKeyCard&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>🔑 Anthropic APIキー（任意・入れると自動生成）</label>
      <input type=&quot;password&quot; id=&quot;apiKey&quot; placeholder=&quot;sk-ant-... （未入力なら下の手動コピーを使用）&quot;>
      <p style=&quot;margin:6px 0 0;font-size:10px;color:#9c8460;&quot;>※キーはこの画面内だけで使われ、保存も外部送信もされません（Anthropic API以外には送りません）。</p>
    </div>

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    <button class=&quot;btn&quot; id=&quot;analyzeBtn&quot; onclick=&quot;handleAnalyze()&quot; style=&quot;width:100%;padding:15px;background:linear-gradient(135deg,#b97f2f,#925f1f);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;&quot;>🥞 教材を生成する</button>

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#d6c0a0;&quot;>🛠 APIキーがない場合（手動）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#9c8460;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(220,170,90,.2);border:1px solid #dcaa5a;border-radius:8px;padding:7px 14px;color:#f0c884;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:7px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで教材を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#d6c0a0;&quot;>✨ 生成されるもの</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#8a7250;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>🥞</div>
      <p>「設定」タブで工程と対象を選んでください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:14px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;metaLine&quot; style=&quot;font-size:11px;color:#c4a878;margin-bottom:14px;&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「IT開発工程の研修講師」です。新卒に、要求定義→要件定義→実装→テストの工程をやさしく教える教材を作ります。
工程の本質：要求定義＝利用者が「何をしたい・困っている」かを引き出す。要件定義＝それを実現するために「何を作るか」を具体的に決める。実装＝決めたものを実際に作る。テスト＝意図どおり動くか確認する。
対象による説明スタイルの切り替え（重要）：
- 対象が「文系新卒」の場合：ホットケーキ作りのたとえで説明する。要求定義＝「ふわふわで甘いホットケーキが食べたい」という願いを聞く / 要件定義＝レシピと分量・焼き時間を決める（直径15cm・きつね色・3枚 等）/ 実装＝実際に生地を混ぜて焼く / テスト＝味見して焼け具合・甘さを確認する。専門用語は最後に正式名称を一言添える程度にし、まずイメージで理解させる。
- 対象が「理系新卒」の場合：たとえは使わず、原理原則のみで説明する。各工程の定義・入力（インプット）・出力（アウトプット）・なぜ必要か・典型的な失敗（手戻りの原因）を簡潔に。論理的・構造的に。
共通：誇張しない。個人名・会社名は出さない。
ユーザーの条件（工程/対象/題材/補足）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;meta&quot;: {&quot;phase&quot;: &quot;工程&quot;, &quot;audience&quot;: &quot;対象&quot;, &quot;subject&quot;: &quot;題材&quot;},
  &quot;overview&quot;: &quot;この工程は何か（1〜2文・対象に合わせた言葉で）&quot;,
  &quot;explain&quot;: &quot;本文の説明（文系はやさしく具体イメージ、理系は原理原則・構造的に）&quot;,
  &quot;analogy&quot;: &quot;文系の場合：ホットケーキのたとえで具体的に。理系の場合：たとえではなく『原理原則の要点』を箇条書き的に（## 不要、文章で）&quot;,
  &quot;keypoints&quot;: [&quot;押さえるべきポイントを3〜5個&quot;],
  &quot;fieldMeaning&quot;: &quot;現場・実務でこの工程がどう効いてくるか（手を抜くと何が起きるか）&quot;,
  &quot;check&quot;: [
    {&quot;q&quot;: &quot;理解度チェックの問い&quot;, &quot;a&quot;: &quot;答え・解説&quot;}
  ]
}
注意：対象が文系ならanalogyは必ずホットケーキのたとえにする。理系ならanalogyにたとえを入れず原理原則の要点にする。checkは2〜3問。`;

var FIELD_TAGS=[&quot;📖 説明&quot;,&quot;🥞 たとえ／📐 原理&quot;,&quot;💼 現場での意味&quot;,&quot;✅ 理解チェック&quot;];
var result=null, tab=&quot;input&quot;, viewTab=&quot;explain&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }
function isBunkei(){ var a=(result&amp;&amp;result.meta&amp;&amp;result.meta.audience)||$(&quot;f_audience&quot;).value; return (a||&quot;&quot;).indexOf(&quot;文系&quot;)>=0; }
function readForm(){
  return { phase:$(&quot;f_phase&quot;).value, audience:$(&quot;f_audience&quot;).value, subject:($(&quot;f_subject&quot;).value||&quot;&quot;).trim(), note:($(&quot;f_note&quot;).value||&quot;&quot;).trim() };
}
function buildUserMsg(){
  var f=readForm();
  return [&quot;## 開発工程の教材の条件&quot;,
    &quot;【教える工程】&quot;+f.phase,
    &quot;【対象】&quot;+f.audience,
    &quot;【題材】&quot;+(f.subject||&quot;指定なし（適切な例を用意）&quot;),
    &quot;【補足】&quot;+(f.note||&quot;なし&quot;)].join(&quot;\n&quot;);
}

function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(220,170,90,.16);border:1px solid rgba(220,170,90,.32);border-radius:20px;padding:3px 11px;font-size:11px;color:#f0c884;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}

function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}

function handleAnalyze(){
  var f=readForm();
  var key=$(&quot;apiKey&quot;)?$(&quot;apiKey&quot;).value.trim():&quot;&quot;;
  if(!key){ setErr(&quot;APIキーが未入力です。下の「手動プロンプトをコピー」を使うか、APIキーを入力してください。&quot;); return; }
  setErr(&quot;&quot;);
  var btn=$(&quot;analyzeBtn&quot;); btn.disabled=true; btn.innerHTML='<span class=&quot;pulse&quot;>🥞</span> 生成中…';
  fetch(&quot;https://api.anthropic.com/v1/messages&quot;,{
    method:&quot;POST&quot;,
    headers:{ &quot;Content-Type&quot;:&quot;application/json&quot;,&quot;anthropic-version&quot;:&quot;2023-06-01&quot;,&quot;anthropic-dangerous-direct-browser-access&quot;:&quot;true&quot;,&quot;x-api-key&quot;:key },
    body:JSON.stringify({ model:&quot;claude-sonnet-4-5&quot;, max_tokens:4000, system:SYSTEM_PROMPT, messages:[{role:&quot;user&quot;,content:buildUserMsg()}] })
  }).then(function(res){ return res.json().then(function(data){ return {ok:res.ok,status:res.status,data:data}; }); })
   .then(function(r){
     if(!r.ok || r.data.error) throw new Error((r.data.error&amp;&amp;r.data.error.message)||(&quot;HTTP &quot;+r.status));
     var raw=(r.data.content||[]).map(function(c){return c.text||&quot;&quot;;}).join(&quot;&quot;);
     var m=raw.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりませんでした&quot;);
     result=JSON.parse(m[0]); setTab(&quot;result&quot;);
   }).catch(function(e){ setErr(&quot;生成に失敗しました: &quot;+e.message+&quot;（CORSやAPIキーをご確認ください。手動コピーも使えます）&quot;); })
   .then(function(){ btn.disabled=false; btn.innerHTML=&quot;🥞 教材を生成する&quot;; });
}

function importJson(){
  setErr(&quot;&quot;);
  try{
    var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}

function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function copyBtn(btn, text){ copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000); }

function subLabel(){ return isBunkei()?&quot;🥞 たとえ（ホットケーキ）&quot;:&quot;📐 原理原則&quot;; }
var SUBKEYS=[&quot;explain&quot;,&quot;analogy&quot;,&quot;field&quot;,&quot;check&quot;];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var labels={explain:&quot;📖 説明&quot;, analogy:subLabel(), field:&quot;💼 現場での意味&quot;, check:&quot;✅ 理解チェック&quot;};
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBKEYS.forEach(function(k){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===k?&quot; active&quot;:&quot;&quot;); b.textContent=labels[k];
    b.onclick=function(){ viewTab=k; renderResult(); };
    st.appendChild(b);
  });
  var meta=result.meta||{};
  $(&quot;metaLine&quot;).textContent=[meta.phase,meta.audience,meta.subject].filter(Boolean).join(&quot;　/　&quot;);
  var v=$(&quot;resultView&quot;); v.innerHTML=renderView();
  [].slice.call(v.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); }); });
  [].slice.call(v.querySelectorAll(&quot;[data-reveal]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ var t=document.getElementById(b.getAttribute(&quot;data-reveal&quot;)); if(t) t.style.display=(t.style.display===&quot;none&quot;?&quot;block&quot;:&quot;none&quot;); }); });
}
function card(inner){ return '<div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;explain&quot;) return viewExplain();
  if(viewTab===&quot;analogy&quot;) return viewAnalogy();
  if(viewTab===&quot;field&quot;) return viewField();
  if(viewTab===&quot;check&quot;) return viewCheck();
  return &quot;&quot;;
}
function viewExplain(){
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#d6c0a0;font-weight:700;&quot;>📖 説明</h3>';
  if(result.overview){ h+=card('<p style=&quot;margin:0;font-size:13px;color:#f0c884;font-weight:700;line-height:1.8;&quot;>'+esc(result.overview)+'</p>'); }
  var kp=(result.keypoints||[]).map(function(p){return '<li style=&quot;margin:4px 0;&quot;>'+esc(p)+'</li>';}).join(&quot;&quot;);
  h+=card('<div style=&quot;white-space:pre-wrap;font-size:13px;color:#f6efe2;line-height:1.95;&quot;>'+esc(result.explain||&quot;（未入力）&quot;)+'</div>'+
    (kp?'<div style=&quot;margin-top:12px;border-top:1px solid rgba(255,255,255,.08);padding-top:10px;&quot;><p style=&quot;margin:0 0 4px;font-size:11px;font-weight:700;color:#c4a878;&quot;>📌 ポイント</p><ul style=&quot;margin:0;padding-left:18px;font-size:12px;color:#d6c0a0;&quot;>'+kp+'</ul></div>':''));
  return h;
}
function viewAnalogy(){
  var bunkei=isBunkei();
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#d6c0a0;font-weight:700;&quot;>'+(bunkei?&quot;🥞 ホットケーキで例えると&quot;:&quot;📐 原理原則&quot;)+'</h3>';
  var body=result.analogy||&quot;&quot;;
  if(!body) return h+card('<p style=&quot;color:#8a7250;font-size:12px;&quot;>データがありません</p>');
  var border=bunkei?&quot;#dcaa5a&quot;:&quot;#7fa8d9&quot;;
  h+=card('<div style=&quot;white-space:pre-wrap;font-size:13px;color:#f6efe2;line-height:1.95;border-left:3px solid '+border+';padding-left:12px;&quot;>'+esc(body)+'</div>');
  return h;
}
function viewField(){
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#d6c0a0;font-weight:700;&quot;>💼 現場での意味</h3>';
  h+=card('<div style=&quot;white-space:pre-wrap;font-size:13px;color:#f6efe2;line-height:1.95;&quot;>'+esc(result.fieldMeaning||&quot;（未入力）&quot;)+'</div>');
  return h;
}
function viewCheck(){
  var arr=result.check||[];
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#d6c0a0;font-weight:700;&quot;>✅ 理解チェック</h3>';
  if(!arr.length) return h+card('<p style=&quot;color:#8a7250;font-size:12px;&quot;>問題がありません</p>');
  arr.forEach(function(x,i){
    var aid=&quot;chk_&quot;+i;
    h+=card('<p style=&quot;margin:0 0 8px;font-size:13px;color:#f6efe2;font-weight:700;&quot;>Q'+(i+1)+'. '+esc(x.q||&quot;&quot;)+'</p>'+
      '<button class=&quot;btn&quot; data-reveal=&quot;'+aid+'&quot; style=&quot;background:rgba(220,170,90,.2);border:1px solid #dcaa5a;border-radius:8px;padding:5px 12px;color:#f0c884;font-size:11px;cursor:pointer;font-weight:600;&quot;>💡 答えを見る</button>'+
      '<div id=&quot;'+aid+'&quot; style=&quot;display:none;margin-top:8px;padding:10px;background:rgba(31,157,107,.12);border-left:3px solid #1f9d6b;border-radius:6px;font-size:13px;color:#7fd9b3;line-height:1.85;&quot;>'+esc(x.a||&quot;&quot;)+'</div>');
  });
  return h;
}

renderTags();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-consul" title="ITコンサルAPIなし" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ ITコンサル法人練習ツール 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#1a2233,#212d44 55%,#19222f);color:#e9eef6;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(110,150,210,.5);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.88}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.05);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.09);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#8ea0bd;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(90,140,220,.2);border-bottom:2px solid #5a8cdc;color:#a9c5f0;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#8ea0bd;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(90,140,220,.32);border:1px solid #5a8cdc;color:#a9c5f0;}
  label{display:block;font-size:12px;font-weight:700;color:#aebfd8;margin-bottom:6px;}
  textarea,input[type=password],select{width:100%;background:rgba(0,0,0,.24);border:1px solid rgba(255,255,255,.12);
    border-radius:8px;padding:10px 12px;color:#e9eef6;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#5a8cdc,#2f5aa0);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>💼</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#a9c5f0,#5a8cdc);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>ITコンサル法人練習ツール</h1>
      <p style=&quot;margin:0;font-size:11px;color:#8ea0bd;&quot; id=&quot;subtitle&quot;>【APIキーなし版】完全オフライン。業界テンプレ・費用感・英語モード対応。手動→JSON取り込み</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 設定</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>🎭 練習</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0;font-size:12px;color:#aebfd8;line-height:1.7;&quot;>💼 クライアント像と練習したい場面を設定すると、<b style=&quot;color:#a9c5f0;&quot;>ロールプレイ台本・想定問答・提案の型・自己評価観点</b>を作ります。商談・提案の練習に。</p>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #5a8cdc;&quot;>
        <label>🏢 想定クライアント（業界・規模）</label>
        <input id=&quot;f_client&quot; placeholder=&quot;例：中堅製造業（従業員300名）の情報システム部&quot;>
        <div style=&quot;display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;align-items:center;&quot;>
          <select id=&quot;f_industryTpl&quot; style=&quot;flex:1;min-width:120px;&quot;><option value=&quot;&quot;>業界別テンプレを選ぶ…</option><option value=&quot;製造業&quot;>製造業</option><option value=&quot;小売・流通&quot;>小売・流通</option><option value=&quot;金融&quot;>金融</option><option value=&quot;医療・ヘルスケア&quot;>医療・ヘルスケア</option><option value=&quot;物流・運輸&quot;>物流・運輸</option><option value=&quot;官公庁・自治体&quot;>官公庁・自治体</option><option value=&quot;教育&quot;>教育</option><option value=&quot;建設・不動産&quot;>建設・不動産</option></select>
          <button type=&quot;button&quot; class=&quot;btn&quot; onclick=&quot;applyIndustryTpl()&quot; style=&quot;background:rgba(90,140,210,.2);border:1px solid #5a8cd2;border-radius:8px;padding:8px 12px;color:#a3c4ea;font-size:12px;cursor:pointer;font-weight:600;white-space:nowrap;&quot;>📋 典型課題を入れる</button>
        </div>
        <p style=&quot;margin:6px 0 0;font-size:10px;color:#6f86a4;&quot;>選ぶと、その業界でよくある課題が想定クライアント欄と補足に入ります（後から自由に編集可）。</p>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #5586d0;&quot;>
        <label>📦 案件タイプ</label>
        <select id=&quot;f_case&quot;><option value=&quot;システム開発&quot;>システム開発</option><option value=&quot;DX推進&quot;>DX推進</option><option value=&quot;インフラ刷新&quot;>インフラ刷新</option><option value=&quot;セキュリティ強化&quot;>セキュリティ強化</option><option value=&quot;IT研修・人材育成の導入&quot;>IT研修・人材育成の導入</option><option value=&quot;クラウド移行&quot;>クラウド移行</option></select>
      </div>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #4f80ca;&quot;>
        <label>🧑‍💼 自分の立場</label>
        <select id=&quot;f_role&quot;><option value=&quot;若手コンサル&quot;>若手コンサル</option><option value=&quot;提案担当&quot;>提案担当</option><option value=&quot;研修講師として提案&quot;>研修講師として提案</option><option value=&quot;プリセールス&quot;>プリセールス</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #4a7ac4;&quot;>
        <label>🎬 練習したい場面</label>
        <select id=&quot;f_scene&quot;><option value=&quot;ヒアリング（課題の引き出し）&quot;>ヒアリング（課題の引き出し）</option><option value=&quot;提案プレゼン&quot;>提案プレゼン</option><option value=&quot;見積もり・費用の説明&quot;>見積もり・費用の説明</option><option value=&quot;反論・懸念への対応&quot;>反論・懸念への対応</option><option value=&quot;クロージング（次のステップ合意）&quot;>クロージング（次のステップ合意）</option></select>
      </div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;border-left:3px solid #4072c0;&quot;>
      <label>🌐 商談の言語</label>
      <select id=&quot;f_lang&quot;><option value=&quot;ja&quot;>日本語</option><option value=&quot;en&quot;>英語（English business meeting）</option><option value=&quot;both&quot;>日本語＋英語（対訳）</option></select>
      <p style=&quot;margin:6px 0 0;font-size:10px;color:#6f86a4;&quot;>英語を選ぶと、ロールプレイ台本・想定問答が英語（または対訳）で生成されます。外資・海外クライアント想定の練習に。</p>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>📝 補足（クライアントの事情・難易度・盛り込みたい論点など・任意）</label>
      <textarea id=&quot;f_note&quot; placeholder=&quot;予算に厳しい。情シス担当はIT知識があるが、決裁者は非IT。費用対効果を重視したい。&quot;></textarea>
    </div>

    

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#aebfd8;&quot;>🛠 使い方（3ステップ）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#6e7e96;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(90,140,220,.2);border:1px solid #5a8cdc;border-radius:8px;padding:7px 14px;color:#a9c5f0;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:7px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで練習を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#aebfd8;&quot;>✨ 生成されるもの</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#5a6b85;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>💼</div>
      <p>「設定」タブでクライアント像を入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:14px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;metaLine&quot; style=&quot;font-size:11px;color:#8ea0bd;margin-bottom:14px;&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「ITコンサルティングの商談トレーナー」です。法人クライアント向けのIT提案・商談を練習するための教材を作ります。
方針：クライアントは実在しない架空の法人として描く。決裁者が非ITの場合は専門用語をかみくだく前提を入れる。費用対効果・課題解決にフォーカス。誇大な断定や効果保証はしない。個人名・実在企業名は出さない（役職名・業種で表す）。
言語：条件に「言語=英語」があれば、roleplayのdialogueとqaを英語（自然なビジネス英語）で書く。「言語=対訳」なら各セリフ・各回答を「英語（改行）日本語訳」の形にする。「言語=日本語」なら日本語で書く。
費用感：proposalには費用の目安を必ず「幅（最小〜最大）」で示す。確定金額として断定せず、前提（規模・期間）を添える。実際の金額は案件で変わる旨を明記する。
ユーザーの条件（想定クライアント/案件タイプ/自分の立場/練習場面/言語/補足）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;meta&quot;: {&quot;client&quot;: &quot;クライアント像&quot;, &quot;case&quot;: &quot;案件タイプ&quot;, &quot;role&quot;: &quot;自分の立場&quot;, &quot;scene&quot;: &quot;練習場面&quot;},
  &quot;roleplay&quot;: {
    &quot;persona&quot;: &quot;クライアント担当者の人物像（役職・関心・懸念）&quot;,
    &quot;scene&quot;: &quot;商談の状況設定（背景・前提）&quot;,
    &quot;dialogue&quot;: [
      {&quot;who&quot;: &quot;クライアント&quot;, &quot;line&quot;: &quot;クライアントのセリフ（指定言語で）&quot;},
      {&quot;who&quot;: &quot;あなた&quot;, &quot;line&quot;: &quot;コンサル側の応答例（指定言語で）&quot;}
    ]
  },
  &quot;qa&quot;: [
    {&quot;q&quot;: &quot;クライアントから来そうな質問・懸念（指定言語で）&quot;, &quot;model&quot;: &quot;模範回答（話し言葉・指定言語で）&quot;, &quot;tip&quot;: &quot;答えるときのコツ（日本語でOK）&quot;}
  ],
  &quot;proposal&quot;: {
    &quot;structure&quot;: [&quot;課題の整理&quot;, &quot;提案内容&quot;, &quot;期待効果&quot;, &quot;費用感・進め方&quot;],
    &quot;example&quot;: &quot;提案を口頭で述べる例文（結論先出し・非ITにも分かる言葉）&quot;,
    &quot;costRange&quot;: [
      {&quot;item&quot;: &quot;費用項目（例：初期構築／月額運用／研修）&quot;, &quot;low&quot;: &quot;最小目安&quot;, &quot;high&quot;: &quot;最大目安&quot;, &quot;note&quot;: &quot;前提・内訳の補足&quot;}
    ]
  },
  &quot;feedback&quot;: [&quot;練習後の自己評価の観点を4〜5個（できた/改善で振り返れる形）&quot;]
}
注意：dialogueは4〜6往復、qaは3問程度。場面に合った内容にする（ヒアリングなら質問中心、反論対応なら懸念への切り返し中心）。costRangeは2〜4項目、金額は「約◯◯万円」のような幅で、必ず目安と明記する。`;

var FIELD_TAGS=[&quot;🎭 ロールプレイ台本&quot;,&quot;❓ 想定問答&quot;,&quot;💡 提案の型&quot;,&quot;🪞 自己評価観点&quot;];
var result=null, viewTab=&quot;roleplay&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function toast(m){
  var t=document.getElementById(&quot;__toast&quot;);
  if(!t){ t=document.createElement(&quot;div&quot;); t.id=&quot;__toast&quot;; t.style.cssText=&quot;position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#0e1a2e;color:#e8eef7;padding:10px 18px;border-radius:999px;font-size:13px;z-index:9999;border:1px solid rgba(90,140,210,.4);opacity:0;transition:opacity .25s;pointer-events:none;&quot;; document.body.appendChild(t); }
  t.textContent=m; t.style.opacity=&quot;0.97&quot;; setTimeout(function(){ t.style.opacity=&quot;0&quot;; },1600);
}
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }
function readForm(){
  return { client:($(&quot;f_client&quot;).value||&quot;&quot;).trim(), cas:$(&quot;f_case&quot;).value, role:$(&quot;f_role&quot;).value, scene:$(&quot;f_scene&quot;).value, lang:($(&quot;f_lang&quot;)?$(&quot;f_lang&quot;).value:&quot;ja&quot;), note:($(&quot;f_note&quot;).value||&quot;&quot;).trim() };
}
function buildUserMsg(){
  var f=readForm();
  var langLabel=(f.lang===&quot;en&quot;?&quot;英語&quot;:(f.lang===&quot;both&quot;?&quot;対訳（英語＋日本語）&quot;:&quot;日本語&quot;));
  return [&quot;## ITコンサル練習の条件&quot;,
    &quot;【想定クライアント】&quot;+(f.client||&quot;未入力&quot;),
    &quot;【案件タイプ】&quot;+f.cas,
    &quot;【自分の立場】&quot;+f.role,
    &quot;【練習場面】&quot;+f.scene,
    &quot;【言語】&quot;+langLabel,
    &quot;【補足】&quot;+(f.note||&quot;なし&quot;)].join(&quot;\n&quot;);
}
// 業界別 典型課題テンプレ
var INDUSTRY_TPL={
  &quot;製造業&quot;:{client:&quot;中堅製造業（従業員300名規模）の情報システム部&quot;, note:&quot;生産管理が紙とExcel中心で属人化。工場ごとに数字がバラバラ。設備保全の記録もアナログ。DXしたいが現場のITリテラシーに不安。&quot;},
  &quot;小売・流通&quot;:{client:&quot;複数店舗を持つ小売チェーン（年商50億規模）の本部&quot;, note:&quot;在庫がリアルタイムで見えず欠品と過剰在庫が同時発生。店舗とECの在庫が分断。POSデータを分析に活かせていない。&quot;},
  &quot;金融&quot;:{client:&quot;地方銀行・信用金庫の事務統括部門&quot;, note:&quot;レガシーシステムが多く改修コストが高い。規制対応・セキュリティ要件が厳しい。ペーパーレス化と窓口業務の効率化が課題。&quot;},
  &quot;医療・ヘルスケア&quot;:{client:&quot;地域中核病院（300床規模）の事務部門&quot;, note:&quot;電子カルテと各部門システムが連携しておらず二重入力が多い。個人情報保護が最優先。現場（医師・看護）は多忙でIT教育の時間が取りにくい。&quot;},
  &quot;物流・運輸&quot;:{client:&quot;中堅物流会社（拠点10箇所）の運行管理部門&quot;, note:&quot;配車・運行管理が電話とFAX中心。ドライバー不足。荷主からのトレーサビリティ要求が増えている。&quot;},
  &quot;官公庁・自治体&quot;:{client:&quot;地方自治体の情報政策課&quot;, note:&quot;申請手続きが紙中心で来庁が必要。住民サービスのオンライン化が遅れている。予算と調達プロセスが厳格で意思決定に時間がかかる。&quot;},
  &quot;教育&quot;:{client:&quot;私立学校法人・専門学校の事務局&quot;, note:&quot;学籍・成績管理が個別Excel。保護者連絡が紙とメール混在。教職員のIT習熟度に差が大きく、定着には研修が要る。&quot;},
  &quot;建設・不動産&quot;:{client:&quot;中堅ゼネコン・不動産管理会社の管理部門&quot;, note:&quot;現場と本社の情報連携が遅い。図面・契約書類が紙。協力会社とのやりとりが電話中心で記録が残らない。&quot;}
};
function applyIndustryTpl(){
  var sel=$(&quot;f_industryTpl&quot;); if(!sel||!sel.value) return;
  var tpl=INDUSTRY_TPL[sel.value]; if(!tpl) return;
  if($(&quot;f_client&quot;)) $(&quot;f_client&quot;).value=tpl.client;
  if($(&quot;f_note&quot;)){ var cur=$(&quot;f_note&quot;).value.trim(); $(&quot;f_note&quot;).value=(cur? (cur+&quot;\n&quot;):&quot;&quot;)+tpl.note; }
  toast(&quot;「&quot;+sel.value+&quot;」の典型課題を入れました&quot;);
}
function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(90,140,220,.16);border:1px solid rgba(90,140,220,.32);border-radius:20px;padding:3px 11px;font-size:11px;color:#a9c5f0;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}
function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}
var tab=&quot;input&quot;;

function importJson(){
  setErr(&quot;&quot;);
  try{ var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}
function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function copyBtn(btn, text){ copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000); }

var SUBTABS=[[&quot;roleplay&quot;,&quot;🎭 台本&quot;],[&quot;qa&quot;,&quot;❓ 想定問答&quot;],[&quot;proposal&quot;,&quot;💡 提案の型&quot;],[&quot;feedback&quot;,&quot;🪞 自己評価&quot;]];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBTABS.forEach(function(p){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===p[0]?&quot; active&quot;:&quot;&quot;); b.textContent=p[1];
    b.onclick=function(){ viewTab=p[0]; renderResult(); };
    st.appendChild(b);
  });
  var meta=result.meta||{};
  $(&quot;metaLine&quot;).textContent=[meta.client,meta.case,meta.role,meta.scene].filter(Boolean).join(&quot;　/　&quot;);
  var vw=$(&quot;resultView&quot;); vw.innerHTML=renderView();
  [].slice.call(vw.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); }); });
  [].slice.call(vw.querySelectorAll(&quot;[data-reveal]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ var t=document.getElementById(b.getAttribute(&quot;data-reveal&quot;)); if(t) t.style.display=(t.style.display===&quot;none&quot;?&quot;block&quot;:&quot;none&quot;); }); });
}
function rcard(inner){ return '<div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;roleplay&quot;) return viewRoleplay();
  if(viewTab===&quot;qa&quot;) return viewQa();
  if(viewTab===&quot;proposal&quot;) return viewProposal();
  if(viewTab===&quot;feedback&quot;) return viewFeedback();
  return &quot;&quot;;
}
function viewRoleplay(){
  var r=result.roleplay||{};
  var dlg=(r.dialogue||[]).map(function(d){
    var isClient=(d.who===&quot;クライアント&quot;);
    var color=isClient?&quot;#a9c5f0&quot;:&quot;#7fd9b3&quot;;
    return '<div style=&quot;margin:8px 0;&quot;><span style=&quot;font-size:11px;font-weight:700;color:'+color+';&quot;>'+esc(d.who||&quot;&quot;)+'</span>'+
      '<div style=&quot;font-size:13px;color:#e9eef6;line-height:1.8;background:rgba(0,0,0,.18);border-radius:8px;padding:8px 11px;margin-top:2px;border-left:3px solid '+color+';&quot;>'+esc(d.line||&quot;&quot;)+'</div></div>';
  }).join(&quot;&quot;);
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#aebfd8;font-weight:700;&quot;>🎭 ロールプレイ台本</h3>';
  h+=rcard((r.persona?'<p style=&quot;margin:0 0 6px;font-size:12px;color:#a9c5f0;font-weight:700;&quot;>👤 クライアント像</p><p style=&quot;margin:0 0 10px;font-size:13px;color:#e9eef6;&quot;>'+esc(r.persona)+'</p>':'')+
    (r.scene?'<p style=&quot;margin:0 0 6px;font-size:12px;color:#a9c5f0;font-weight:700;&quot;>🎬 状況設定</p><p style=&quot;margin:0;font-size:13px;color:#e9eef6;&quot;>'+esc(r.scene)+'</p>':''));
  if(dlg) h+=rcard('<p style=&quot;margin:0 0 6px;font-size:12px;color:#aebfd8;font-weight:700;&quot;>会話例</p>'+dlg);
  return h;
}
function viewQa(){
  var arr=result.qa||[];
  var txt=arr.map(function(q,i){return &quot;Q&quot;+(i+1)+&quot;：&quot;+(q.q||&quot;&quot;)+&quot;\n模範回答：&quot;+(q.model||&quot;&quot;)+(q.tip?(&quot;\nコツ：&quot;+q.tip):&quot;&quot;);}).join(&quot;\n\n&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#aebfd8;font-weight:700;&quot;>❓ 想定問答</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(txt)+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 まとめてコピー</button></div>';
  if(!arr.length) return h+rcard('<p style=&quot;color:#5a6b85;font-size:12px;&quot;>データがありません</p>');
  arr.forEach(function(q,i){
    var aid=&quot;qa_&quot;+i;
    h+=rcard('<p style=&quot;margin:0 0 8px;font-size:13px;color:#e9eef6;font-weight:700;&quot;>❓ '+esc(q.q||&quot;&quot;)+'</p>'+
      '<button class=&quot;btn&quot; data-reveal=&quot;'+aid+'&quot; style=&quot;background:rgba(90,140,220,.2);border:1px solid #5a8cdc;border-radius:8px;padding:5px 12px;color:#a9c5f0;font-size:11px;cursor:pointer;font-weight:600;&quot;>💡 模範回答を見る</button>'+
      '<div id=&quot;'+aid+'&quot; style=&quot;display:none;margin-top:8px;&quot;>'+
      '<div style=&quot;padding:10px;background:rgba(31,157,107,.12);border-left:3px solid #1f9d6b;border-radius:6px;font-size:13px;color:#7fd9b3;&quot;>'+esc(q.model||&quot;&quot;)+'</div>'+
      (q.tip?'<div style=&quot;margin-top:6px;font-size:12px;color:#8ea0bd;&quot;>💬 コツ：'+esc(q.tip)+'</div>':'')+'</div>');
  });
  return h;
}
function viewProposal(){
  var p=result.proposal||{};
  var steps=(p.structure||[]).map(function(s,i){ return '<div style=&quot;display:flex;gap:8px;align-items:center;margin:5px 0;&quot;><span style=&quot;width:22px;height:22px;border-radius:50%;background:rgba(90,140,220,.25);color:#a9c5f0;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex:0 0 22px;&quot;>'+(i+1)+'</span><span style=&quot;font-size:13px;color:#e9eef6;&quot;>'+esc(s)+'</span></div>'; }).join(&quot;&quot;);
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#aebfd8;font-weight:700;&quot;>💡 提案の型</h3>';
  h+=rcard('<p style=&quot;margin:0 0 8px;font-size:12px;color:#aebfd8;font-weight:700;&quot;>組み立て</p>'+(steps||'<p style=&quot;color:#5a6b85;font-size:12px;&quot;>—</p>'));
  if(p.example){
    h+='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin:12px 0 6px;&quot;>'+
      '<p style=&quot;margin:0;font-size:12px;color:#aebfd8;font-weight:700;&quot;>例文（口頭）</p>'+
      '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(p.example)+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:4px 11px;color:#7fd9b3;font-size:11px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
    h+=rcard('<div style=&quot;white-space:pre-wrap;font-size:13px;color:#e9eef6;line-height:1.9;&quot;>'+esc(p.example)+'</div>');
  }
  var cr=p.costRange||[];
  if(cr.length){
    h+='<p style=&quot;margin:14px 0 6px;font-size:12px;color:#aebfd8;font-weight:700;&quot;>💰 費用感の幅（目安）</p>';
    var rows='<table style=&quot;width:100%;border-collapse:collapse;font-size:12px;&quot;>'+
      '<tr style=&quot;color:#aebfd8;&quot;><th style=&quot;text-align:left;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.12);&quot;>項目</th><th style=&quot;text-align:right;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.12);&quot;>最小</th><th style=&quot;text-align:right;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.12);&quot;>最大</th></tr>';
    cr.forEach(function(c){
      rows+='<tr><td style=&quot;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.06);color:#e9eef6;&quot;>'+esc(c.item||&quot;&quot;)+(c.note?'<br><span style=&quot;font-size:10px;color:#7e93b2;&quot;>'+esc(c.note)+'</span>':'')+'</td>'+
        '<td style=&quot;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.06);text-align:right;color:#a9c5f0;&quot;>'+esc(c.low||&quot;&quot;)+'</td>'+
        '<td style=&quot;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.06);text-align:right;color:#a9c5f0;&quot;>'+esc(c.high||&quot;&quot;)+'</td></tr>';
    });
    rows+='</table>';
    h+=rcard(rows+'<p style=&quot;margin:8px 0 0;font-size:10px;color:#7e93b2;&quot;>※あくまで練習用の目安です。実際の費用は規模・期間・要件で変わります。</p>');
  }
  return h;
}
function viewFeedback(){
  var arr=result.feedback||[];
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#aebfd8;font-weight:700;&quot;>🪞 自己評価観点（練習後の振り返り）</h3>';
  if(!arr.length) return h+rcard('<p style=&quot;color:#5a6b85;font-size:12px;&quot;>データがありません</p>');
  h+='<div class=&quot;card&quot;>';
  arr.forEach(function(x){ h+='<div style=&quot;display:flex;gap:8px;align-items:center;margin:6px 0;&quot;><div style=&quot;width:14px;height:14px;border:2px solid #5a8cdc;border-radius:4px;flex:0 0 14px;&quot;></div><span style=&quot;font-size:13px;color:#e9eef6;&quot;>'+esc(x)+'</span></div>'; });
  h+='</div>';
  return h;
}

renderTags();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-consulapi" title="ITコンサルAPIあり" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ ITコンサル法人練習ツール 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#1a2233,#212d44 55%,#19222f);color:#e9eef6;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(110,150,210,.5);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.88}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.05);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.09);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#8ea0bd;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(90,140,220,.2);border-bottom:2px solid #5a8cdc;color:#a9c5f0;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#8ea0bd;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(90,140,220,.32);border:1px solid #5a8cdc;color:#a9c5f0;}
  label{display:block;font-size:12px;font-weight:700;color:#aebfd8;margin-bottom:6px;}
  textarea,input[type=password],select{width:100%;background:rgba(0,0,0,.24);border:1px solid rgba(255,255,255,.12);
    border-radius:8px;padding:10px 12px;color:#e9eef6;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#5a8cdc,#2f5aa0);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>💼</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#a9c5f0,#5a8cdc);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>ITコンサル法人練習ツール</h1>
      <p style=&quot;margin:0;font-size:11px;color:#8ea0bd;&quot; id=&quot;subtitle&quot;>【APIキー版】キーを入れると商談シナリオを自動生成。業界テンプレ・費用感・英語モード対応</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 設定</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>🎭 練習</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0;font-size:12px;color:#aebfd8;line-height:1.7;&quot;>💼 クライアント像と練習したい場面を設定すると、<b style=&quot;color:#a9c5f0;&quot;>ロールプレイ台本・想定問答・提案の型・自己評価観点</b>を作ります。商談・提案の練習に。</p>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #5a8cdc;&quot;>
        <label>🏢 想定クライアント（業界・規模）</label>
        <input id=&quot;f_client&quot; placeholder=&quot;例：中堅製造業（従業員300名）の情報システム部&quot;>
        <div style=&quot;display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;align-items:center;&quot;>
          <select id=&quot;f_industryTpl&quot; style=&quot;flex:1;min-width:120px;&quot;><option value=&quot;&quot;>業界別テンプレを選ぶ…</option><option value=&quot;製造業&quot;>製造業</option><option value=&quot;小売・流通&quot;>小売・流通</option><option value=&quot;金融&quot;>金融</option><option value=&quot;医療・ヘルスケア&quot;>医療・ヘルスケア</option><option value=&quot;物流・運輸&quot;>物流・運輸</option><option value=&quot;官公庁・自治体&quot;>官公庁・自治体</option><option value=&quot;教育&quot;>教育</option><option value=&quot;建設・不動産&quot;>建設・不動産</option></select>
          <button type=&quot;button&quot; class=&quot;btn&quot; onclick=&quot;applyIndustryTpl()&quot; style=&quot;background:rgba(90,140,210,.2);border:1px solid #5a8cd2;border-radius:8px;padding:8px 12px;color:#a3c4ea;font-size:12px;cursor:pointer;font-weight:600;white-space:nowrap;&quot;>📋 典型課題を入れる</button>
        </div>
        <p style=&quot;margin:6px 0 0;font-size:10px;color:#6f86a4;&quot;>選ぶと、その業界でよくある課題が想定クライアント欄と補足に入ります（後から自由に編集可）。</p>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #5586d0;&quot;>
        <label>📦 案件タイプ</label>
        <select id=&quot;f_case&quot;><option value=&quot;システム開発&quot;>システム開発</option><option value=&quot;DX推進&quot;>DX推進</option><option value=&quot;インフラ刷新&quot;>インフラ刷新</option><option value=&quot;セキュリティ強化&quot;>セキュリティ強化</option><option value=&quot;IT研修・人材育成の導入&quot;>IT研修・人材育成の導入</option><option value=&quot;クラウド移行&quot;>クラウド移行</option></select>
      </div>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #4f80ca;&quot;>
        <label>🧑‍💼 自分の立場</label>
        <select id=&quot;f_role&quot;><option value=&quot;若手コンサル&quot;>若手コンサル</option><option value=&quot;提案担当&quot;>提案担当</option><option value=&quot;研修講師として提案&quot;>研修講師として提案</option><option value=&quot;プリセールス&quot;>プリセールス</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #4a7ac4;&quot;>
        <label>🎬 練習したい場面</label>
        <select id=&quot;f_scene&quot;><option value=&quot;ヒアリング（課題の引き出し）&quot;>ヒアリング（課題の引き出し）</option><option value=&quot;提案プレゼン&quot;>提案プレゼン</option><option value=&quot;見積もり・費用の説明&quot;>見積もり・費用の説明</option><option value=&quot;反論・懸念への対応&quot;>反論・懸念への対応</option><option value=&quot;クロージング（次のステップ合意）&quot;>クロージング（次のステップ合意）</option></select>
      </div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;border-left:3px solid #4072c0;&quot;>
      <label>🌐 商談の言語</label>
      <select id=&quot;f_lang&quot;><option value=&quot;ja&quot;>日本語</option><option value=&quot;en&quot;>英語（English business meeting）</option><option value=&quot;both&quot;>日本語＋英語（対訳）</option></select>
      <p style=&quot;margin:6px 0 0;font-size:10px;color:#6f86a4;&quot;>英語を選ぶと、ロールプレイ台本・想定問答が英語（または対訳）で生成されます。外資・海外クライアント想定の練習に。</p>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>📝 補足（クライアントの事情・難易度・盛り込みたい論点など・任意）</label>
      <textarea id=&quot;f_note&quot; placeholder=&quot;予算に厳しい。情シス担当はIT知識があるが、決裁者は非IT。費用対効果を重視したい。&quot;></textarea>
    </div>

    <div class=&quot;card&quot; id=&quot;apiKeyCard&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>🔑 Anthropic APIキー（任意・入れると自動生成）</label>
      <input type=&quot;password&quot; id=&quot;apiKey&quot; placeholder=&quot;sk-ant-... （未入力なら下の手動コピーを使用）&quot;>
      <p style=&quot;margin:6px 0 0;font-size:10px;color:#6e7e96;&quot;>※キーはこの画面内だけで使われ、保存も外部送信もされません（Anthropic API以外には送りません）。</p>
    </div>

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    <button class=&quot;btn&quot; id=&quot;analyzeBtn&quot; onclick=&quot;handleAnalyze()&quot; style=&quot;width:100%;padding:15px;background:linear-gradient(135deg,#2f5aa0,#1f4080);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;&quot;>💼 練習セットを生成する</button>

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#aebfd8;&quot;>🛠 APIキーがない場合（手動）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#6e7e96;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(90,140,220,.2);border:1px solid #5a8cdc;border-radius:8px;padding:7px 14px;color:#a9c5f0;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:7px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで練習を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#aebfd8;&quot;>✨ 生成されるもの</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#5a6b85;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>💼</div>
      <p>「設定」タブでクライアント像を入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:14px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;metaLine&quot; style=&quot;font-size:11px;color:#8ea0bd;margin-bottom:14px;&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「ITコンサルティングの商談トレーナー」です。法人クライアント向けのIT提案・商談を練習するための教材を作ります。
方針：クライアントは実在しない架空の法人として描く。決裁者が非ITの場合は専門用語をかみくだく前提を入れる。費用対効果・課題解決にフォーカス。誇大な断定や効果保証はしない。個人名・実在企業名は出さない（役職名・業種で表す）。
言語：条件に「言語=英語」があれば、roleplayのdialogueとqaを英語（自然なビジネス英語）で書く。「言語=対訳」なら各セリフ・各回答を「英語（改行）日本語訳」の形にする。「言語=日本語」なら日本語で書く。
費用感：proposalには費用の目安を必ず「幅（最小〜最大）」で示す。確定金額として断定せず、前提（規模・期間）を添える。実際の金額は案件で変わる旨を明記する。
ユーザーの条件（想定クライアント/案件タイプ/自分の立場/練習場面/言語/補足）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;meta&quot;: {&quot;client&quot;: &quot;クライアント像&quot;, &quot;case&quot;: &quot;案件タイプ&quot;, &quot;role&quot;: &quot;自分の立場&quot;, &quot;scene&quot;: &quot;練習場面&quot;},
  &quot;roleplay&quot;: {
    &quot;persona&quot;: &quot;クライアント担当者の人物像（役職・関心・懸念）&quot;,
    &quot;scene&quot;: &quot;商談の状況設定（背景・前提）&quot;,
    &quot;dialogue&quot;: [
      {&quot;who&quot;: &quot;クライアント&quot;, &quot;line&quot;: &quot;クライアントのセリフ（指定言語で）&quot;},
      {&quot;who&quot;: &quot;あなた&quot;, &quot;line&quot;: &quot;コンサル側の応答例（指定言語で）&quot;}
    ]
  },
  &quot;qa&quot;: [
    {&quot;q&quot;: &quot;クライアントから来そうな質問・懸念（指定言語で）&quot;, &quot;model&quot;: &quot;模範回答（話し言葉・指定言語で）&quot;, &quot;tip&quot;: &quot;答えるときのコツ（日本語でOK）&quot;}
  ],
  &quot;proposal&quot;: {
    &quot;structure&quot;: [&quot;課題の整理&quot;, &quot;提案内容&quot;, &quot;期待効果&quot;, &quot;費用感・進め方&quot;],
    &quot;example&quot;: &quot;提案を口頭で述べる例文（結論先出し・非ITにも分かる言葉）&quot;,
    &quot;costRange&quot;: [
      {&quot;item&quot;: &quot;費用項目（例：初期構築／月額運用／研修）&quot;, &quot;low&quot;: &quot;最小目安&quot;, &quot;high&quot;: &quot;最大目安&quot;, &quot;note&quot;: &quot;前提・内訳の補足&quot;}
    ]
  },
  &quot;feedback&quot;: [&quot;練習後の自己評価の観点を4〜5個（できた/改善で振り返れる形）&quot;]
}
注意：dialogueは4〜6往復、qaは3問程度。場面に合った内容にする（ヒアリングなら質問中心、反論対応なら懸念への切り返し中心）。costRangeは2〜4項目、金額は「約◯◯万円」のような幅で、必ず目安と明記する。`;

var FIELD_TAGS=[&quot;🎭 ロールプレイ台本&quot;,&quot;❓ 想定問答&quot;,&quot;💡 提案の型&quot;,&quot;🪞 自己評価観点&quot;];
var result=null, viewTab=&quot;roleplay&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function toast(m){
  var t=document.getElementById(&quot;__toast&quot;);
  if(!t){ t=document.createElement(&quot;div&quot;); t.id=&quot;__toast&quot;; t.style.cssText=&quot;position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#0e1a2e;color:#e8eef7;padding:10px 18px;border-radius:999px;font-size:13px;z-index:9999;border:1px solid rgba(90,140,210,.4);opacity:0;transition:opacity .25s;pointer-events:none;&quot;; document.body.appendChild(t); }
  t.textContent=m; t.style.opacity=&quot;0.97&quot;; setTimeout(function(){ t.style.opacity=&quot;0&quot;; },1600);
}
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }
function readForm(){
  return { client:($(&quot;f_client&quot;).value||&quot;&quot;).trim(), cas:$(&quot;f_case&quot;).value, role:$(&quot;f_role&quot;).value, scene:$(&quot;f_scene&quot;).value, lang:($(&quot;f_lang&quot;)?$(&quot;f_lang&quot;).value:&quot;ja&quot;), note:($(&quot;f_note&quot;).value||&quot;&quot;).trim() };
}
function buildUserMsg(){
  var f=readForm();
  var langLabel=(f.lang===&quot;en&quot;?&quot;英語&quot;:(f.lang===&quot;both&quot;?&quot;対訳（英語＋日本語）&quot;:&quot;日本語&quot;));
  return [&quot;## ITコンサル練習の条件&quot;,
    &quot;【想定クライアント】&quot;+(f.client||&quot;未入力&quot;),
    &quot;【案件タイプ】&quot;+f.cas,
    &quot;【自分の立場】&quot;+f.role,
    &quot;【練習場面】&quot;+f.scene,
    &quot;【言語】&quot;+langLabel,
    &quot;【補足】&quot;+(f.note||&quot;なし&quot;)].join(&quot;\n&quot;);
}
// 業界別 典型課題テンプレ
var INDUSTRY_TPL={
  &quot;製造業&quot;:{client:&quot;中堅製造業（従業員300名規模）の情報システム部&quot;, note:&quot;生産管理が紙とExcel中心で属人化。工場ごとに数字がバラバラ。設備保全の記録もアナログ。DXしたいが現場のITリテラシーに不安。&quot;},
  &quot;小売・流通&quot;:{client:&quot;複数店舗を持つ小売チェーン（年商50億規模）の本部&quot;, note:&quot;在庫がリアルタイムで見えず欠品と過剰在庫が同時発生。店舗とECの在庫が分断。POSデータを分析に活かせていない。&quot;},
  &quot;金融&quot;:{client:&quot;地方銀行・信用金庫の事務統括部門&quot;, note:&quot;レガシーシステムが多く改修コストが高い。規制対応・セキュリティ要件が厳しい。ペーパーレス化と窓口業務の効率化が課題。&quot;},
  &quot;医療・ヘルスケア&quot;:{client:&quot;地域中核病院（300床規模）の事務部門&quot;, note:&quot;電子カルテと各部門システムが連携しておらず二重入力が多い。個人情報保護が最優先。現場（医師・看護）は多忙でIT教育の時間が取りにくい。&quot;},
  &quot;物流・運輸&quot;:{client:&quot;中堅物流会社（拠点10箇所）の運行管理部門&quot;, note:&quot;配車・運行管理が電話とFAX中心。ドライバー不足。荷主からのトレーサビリティ要求が増えている。&quot;},
  &quot;官公庁・自治体&quot;:{client:&quot;地方自治体の情報政策課&quot;, note:&quot;申請手続きが紙中心で来庁が必要。住民サービスのオンライン化が遅れている。予算と調達プロセスが厳格で意思決定に時間がかかる。&quot;},
  &quot;教育&quot;:{client:&quot;私立学校法人・専門学校の事務局&quot;, note:&quot;学籍・成績管理が個別Excel。保護者連絡が紙とメール混在。教職員のIT習熟度に差が大きく、定着には研修が要る。&quot;},
  &quot;建設・不動産&quot;:{client:&quot;中堅ゼネコン・不動産管理会社の管理部門&quot;, note:&quot;現場と本社の情報連携が遅い。図面・契約書類が紙。協力会社とのやりとりが電話中心で記録が残らない。&quot;}
};
function applyIndustryTpl(){
  var sel=$(&quot;f_industryTpl&quot;); if(!sel||!sel.value) return;
  var tpl=INDUSTRY_TPL[sel.value]; if(!tpl) return;
  if($(&quot;f_client&quot;)) $(&quot;f_client&quot;).value=tpl.client;
  if($(&quot;f_note&quot;)){ var cur=$(&quot;f_note&quot;).value.trim(); $(&quot;f_note&quot;).value=(cur? (cur+&quot;\n&quot;):&quot;&quot;)+tpl.note; }
  toast(&quot;「&quot;+sel.value+&quot;」の典型課題を入れました&quot;);
}
function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(90,140,220,.16);border:1px solid rgba(90,140,220,.32);border-radius:20px;padding:3px 11px;font-size:11px;color:#a9c5f0;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}
function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}
var tab=&quot;input&quot;;

function handleAnalyze(){
  var f=readForm();
  if(!f.client){ setErr(&quot;「想定クライアント」を入力してください&quot;); return; }
  var key=$(&quot;apiKey&quot;)?$(&quot;apiKey&quot;).value.trim():&quot;&quot;;
  if(!key){ setErr(&quot;APIキーが未入力です。下の「手動プロンプトをコピー」を使うか、APIキーを入力してください。&quot;); return; }
  setErr(&quot;&quot;);
  var btn=$(&quot;analyzeBtn&quot;); btn.disabled=true; btn.innerHTML='<span class=&quot;pulse&quot;>💼</span> 生成中…';
  fetch(&quot;https://api.anthropic.com/v1/messages&quot;,{
    method:&quot;POST&quot;,
    headers:{ &quot;Content-Type&quot;:&quot;application/json&quot;,&quot;anthropic-version&quot;:&quot;2023-06-01&quot;,&quot;anthropic-dangerous-direct-browser-access&quot;:&quot;true&quot;,&quot;x-api-key&quot;:key },
    body:JSON.stringify({ model:&quot;claude-sonnet-4-5&quot;, max_tokens:4000, system:SYSTEM_PROMPT, messages:[{role:&quot;user&quot;,content:buildUserMsg()}] })
  }).then(function(res){ return res.json().then(function(data){ return {ok:res.ok,status:res.status,data:data}; }); })
   .then(function(r){
     if(!r.ok || r.data.error) throw new Error((r.data.error&amp;&amp;r.data.error.message)||(&quot;HTTP &quot;+r.status));
     var raw=(r.data.content||[]).map(function(c){return c.text||&quot;&quot;;}).join(&quot;&quot;);
     var m=raw.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりませんでした&quot;);
     result=JSON.parse(m[0]); setTab(&quot;result&quot;);
   }).catch(function(e){ setErr(&quot;生成に失敗しました: &quot;+e.message+&quot;（CORSやAPIキーをご確認ください。手動コピーも使えます）&quot;); })
   .then(function(){ btn.disabled=false; btn.innerHTML=&quot;💼 練習セットを生成する&quot;; });
}
function importJson(){
  setErr(&quot;&quot;);
  try{ var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}
function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function copyBtn(btn, text){ copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000); }

var SUBTABS=[[&quot;roleplay&quot;,&quot;🎭 台本&quot;],[&quot;qa&quot;,&quot;❓ 想定問答&quot;],[&quot;proposal&quot;,&quot;💡 提案の型&quot;],[&quot;feedback&quot;,&quot;🪞 自己評価&quot;]];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBTABS.forEach(function(p){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===p[0]?&quot; active&quot;:&quot;&quot;); b.textContent=p[1];
    b.onclick=function(){ viewTab=p[0]; renderResult(); };
    st.appendChild(b);
  });
  var meta=result.meta||{};
  $(&quot;metaLine&quot;).textContent=[meta.client,meta.case,meta.role,meta.scene].filter(Boolean).join(&quot;　/　&quot;);
  var vw=$(&quot;resultView&quot;); vw.innerHTML=renderView();
  [].slice.call(vw.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); }); });
  [].slice.call(vw.querySelectorAll(&quot;[data-reveal]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ var t=document.getElementById(b.getAttribute(&quot;data-reveal&quot;)); if(t) t.style.display=(t.style.display===&quot;none&quot;?&quot;block&quot;:&quot;none&quot;); }); });
}
function rcard(inner){ return '<div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;roleplay&quot;) return viewRoleplay();
  if(viewTab===&quot;qa&quot;) return viewQa();
  if(viewTab===&quot;proposal&quot;) return viewProposal();
  if(viewTab===&quot;feedback&quot;) return viewFeedback();
  return &quot;&quot;;
}
function viewRoleplay(){
  var r=result.roleplay||{};
  var dlg=(r.dialogue||[]).map(function(d){
    var isClient=(d.who===&quot;クライアント&quot;);
    var color=isClient?&quot;#a9c5f0&quot;:&quot;#7fd9b3&quot;;
    return '<div style=&quot;margin:8px 0;&quot;><span style=&quot;font-size:11px;font-weight:700;color:'+color+';&quot;>'+esc(d.who||&quot;&quot;)+'</span>'+
      '<div style=&quot;font-size:13px;color:#e9eef6;line-height:1.8;background:rgba(0,0,0,.18);border-radius:8px;padding:8px 11px;margin-top:2px;border-left:3px solid '+color+';&quot;>'+esc(d.line||&quot;&quot;)+'</div></div>';
  }).join(&quot;&quot;);
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#aebfd8;font-weight:700;&quot;>🎭 ロールプレイ台本</h3>';
  h+=rcard((r.persona?'<p style=&quot;margin:0 0 6px;font-size:12px;color:#a9c5f0;font-weight:700;&quot;>👤 クライアント像</p><p style=&quot;margin:0 0 10px;font-size:13px;color:#e9eef6;&quot;>'+esc(r.persona)+'</p>':'')+
    (r.scene?'<p style=&quot;margin:0 0 6px;font-size:12px;color:#a9c5f0;font-weight:700;&quot;>🎬 状況設定</p><p style=&quot;margin:0;font-size:13px;color:#e9eef6;&quot;>'+esc(r.scene)+'</p>':''));
  if(dlg) h+=rcard('<p style=&quot;margin:0 0 6px;font-size:12px;color:#aebfd8;font-weight:700;&quot;>会話例</p>'+dlg);
  return h;
}
function viewQa(){
  var arr=result.qa||[];
  var txt=arr.map(function(q,i){return &quot;Q&quot;+(i+1)+&quot;：&quot;+(q.q||&quot;&quot;)+&quot;\n模範回答：&quot;+(q.model||&quot;&quot;)+(q.tip?(&quot;\nコツ：&quot;+q.tip):&quot;&quot;);}).join(&quot;\n\n&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#aebfd8;font-weight:700;&quot;>❓ 想定問答</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(txt)+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 まとめてコピー</button></div>';
  if(!arr.length) return h+rcard('<p style=&quot;color:#5a6b85;font-size:12px;&quot;>データがありません</p>');
  arr.forEach(function(q,i){
    var aid=&quot;qa_&quot;+i;
    h+=rcard('<p style=&quot;margin:0 0 8px;font-size:13px;color:#e9eef6;font-weight:700;&quot;>❓ '+esc(q.q||&quot;&quot;)+'</p>'+
      '<button class=&quot;btn&quot; data-reveal=&quot;'+aid+'&quot; style=&quot;background:rgba(90,140,220,.2);border:1px solid #5a8cdc;border-radius:8px;padding:5px 12px;color:#a9c5f0;font-size:11px;cursor:pointer;font-weight:600;&quot;>💡 模範回答を見る</button>'+
      '<div id=&quot;'+aid+'&quot; style=&quot;display:none;margin-top:8px;&quot;>'+
      '<div style=&quot;padding:10px;background:rgba(31,157,107,.12);border-left:3px solid #1f9d6b;border-radius:6px;font-size:13px;color:#7fd9b3;&quot;>'+esc(q.model||&quot;&quot;)+'</div>'+
      (q.tip?'<div style=&quot;margin-top:6px;font-size:12px;color:#8ea0bd;&quot;>💬 コツ：'+esc(q.tip)+'</div>':'')+'</div>');
  });
  return h;
}
function viewProposal(){
  var p=result.proposal||{};
  var steps=(p.structure||[]).map(function(s,i){ return '<div style=&quot;display:flex;gap:8px;align-items:center;margin:5px 0;&quot;><span style=&quot;width:22px;height:22px;border-radius:50%;background:rgba(90,140,220,.25);color:#a9c5f0;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex:0 0 22px;&quot;>'+(i+1)+'</span><span style=&quot;font-size:13px;color:#e9eef6;&quot;>'+esc(s)+'</span></div>'; }).join(&quot;&quot;);
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#aebfd8;font-weight:700;&quot;>💡 提案の型</h3>';
  h+=rcard('<p style=&quot;margin:0 0 8px;font-size:12px;color:#aebfd8;font-weight:700;&quot;>組み立て</p>'+(steps||'<p style=&quot;color:#5a6b85;font-size:12px;&quot;>—</p>'));
  if(p.example){
    h+='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin:12px 0 6px;&quot;>'+
      '<p style=&quot;margin:0;font-size:12px;color:#aebfd8;font-weight:700;&quot;>例文（口頭）</p>'+
      '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(p.example)+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:4px 11px;color:#7fd9b3;font-size:11px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
    h+=rcard('<div style=&quot;white-space:pre-wrap;font-size:13px;color:#e9eef6;line-height:1.9;&quot;>'+esc(p.example)+'</div>');
  }
  var cr=p.costRange||[];
  if(cr.length){
    h+='<p style=&quot;margin:14px 0 6px;font-size:12px;color:#aebfd8;font-weight:700;&quot;>💰 費用感の幅（目安）</p>';
    var rows='<table style=&quot;width:100%;border-collapse:collapse;font-size:12px;&quot;>'+
      '<tr style=&quot;color:#aebfd8;&quot;><th style=&quot;text-align:left;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.12);&quot;>項目</th><th style=&quot;text-align:right;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.12);&quot;>最小</th><th style=&quot;text-align:right;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.12);&quot;>最大</th></tr>';
    cr.forEach(function(c){
      rows+='<tr><td style=&quot;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.06);color:#e9eef6;&quot;>'+esc(c.item||&quot;&quot;)+(c.note?'<br><span style=&quot;font-size:10px;color:#7e93b2;&quot;>'+esc(c.note)+'</span>':'')+'</td>'+
        '<td style=&quot;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.06);text-align:right;color:#a9c5f0;&quot;>'+esc(c.low||&quot;&quot;)+'</td>'+
        '<td style=&quot;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.06);text-align:right;color:#a9c5f0;&quot;>'+esc(c.high||&quot;&quot;)+'</td></tr>';
    });
    rows+='</table>';
    h+=rcard(rows+'<p style=&quot;margin:8px 0 0;font-size:10px;color:#7e93b2;&quot;>※あくまで練習用の目安です。実際の費用は規模・期間・要件で変わります。</p>');
  }
  return h;
}
function viewFeedback(){
  var arr=result.feedback||[];
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#aebfd8;font-weight:700;&quot;>🪞 自己評価観点（練習後の振り返り）</h3>';
  if(!arr.length) return h+rcard('<p style=&quot;color:#5a6b85;font-size:12px;&quot;>データがありません</p>');
  h+='<div class=&quot;card&quot;>';
  arr.forEach(function(x){ h+='<div style=&quot;display:flex;gap:8px;align-items:center;margin:6px 0;&quot;><div style=&quot;width:14px;height:14px;border:2px solid #5a8cdc;border-radius:4px;flex:0 0 14px;&quot;></div><span style=&quot;font-size:13px;color:#e9eef6;&quot;>'+esc(x)+'</span></div>'; });
  h+='</div>';
  return h;
}

renderTags();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-facili" title="ファシリAPIなし" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ ファシリテーション・議論サポート 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:#1d3026;color:#f3f6ee;}
  /* 黒板風 */
  body{background:
    radial-gradient(ellipse at 30% 20%, rgba(255,255,255,.03), transparent 60%),
    linear-gradient(135deg,#22382b,#1a2c21 60%,#203429);}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(240,235,200,.4);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.9}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:980px;margin:0 auto;}
  .wrapB{max-width:980px;margin:0 auto;padding:20px 28px 60px;}
  .card{background:rgba(255,255,255,0.045);border-radius:12px;padding:18px;border:1px solid rgba(240,235,200,0.13);}
  .chalkframe{border:2px solid rgba(240,235,200,.35);border-radius:10px;}
  .toptab{padding:9px 16px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#a9bba2;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(240,235,200,.14);border-bottom:2px solid #f0ebc8;color:#f6f2d6;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#a9bba2;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(240,235,200,.22);border:1px solid #f0ebc8;color:#f6f2d6;}
  label{display:block;font-size:12px;font-weight:700;color:#c7d4bf;margin-bottom:6px;}
  textarea,input[type=password],input[type=text],input[type=number],input:not([type]),select{width:100%;background:rgba(0,0,0,.26);border:1px solid rgba(240,235,200,.2);
    border-radius:8px;padding:10px 12px;color:#f3f6ee;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
  h1.chalk{font-family:&quot;Yu Gothic&quot;,&quot;Hiragino Sans&quot;,sans-serif;}
  /* タイマー */
  .bigtimer{text-align:center;}
  .phase-name{font-size:1.2rem;font-weight:800;color:#f6f2d6;}
  .phase-sub{font-size:.82rem;color:#a9bba2;margin-top:2px;min-height:1.1em;}
  .clock-big{font-size:3.6rem;font-weight:800;letter-spacing:.04em;font-variant-numeric:tabular-nums;margin:6px 0;color:#fdfbe8;}
  .clock-big.warn{color:#f4c451;}
  .progress{height:8px;background:rgba(0,0,0,.3);border-radius:999px;overflow:hidden;margin:14px 0 0;}
  .progress > div{height:100%;background:linear-gradient(90deg,#86c98e,#5aa86a);width:0%;transition:width .3s;}
  .controls{display:flex;gap:10px;justify-content:center;margin-top:16px;flex-wrap:wrap;}
  .controls button{border:1px solid rgba(240,235,200,.3);border-radius:11px;padding:11px 20px;font-size:.92rem;font-weight:800;cursor:pointer;background:rgba(255,255,255,.06);color:#f3f6ee;}
  .controls .btn-start{background:linear-gradient(135deg,#5aa86a,#3f8350);border-color:transparent;color:#fff;}
  .prow{display:flex;align-items:center;gap:10px;padding:8px 11px;border:1px solid rgba(240,235,200,.18);border-radius:10px;margin:6px 0;}
  .prow.active{background:rgba(240,235,200,.12);border-color:#f0ebc8;}
  .prow.done{opacity:.45;}
  .prow .pi{font-size:1.05rem;width:1.6em;text-align:center;}
  .prow .pn{font-weight:800;font-size:.9rem;min-width:7em;}
  .prow .pd{font-size:.74rem;color:#a9bba2;flex:1;}
  .prow input{width:54px;text-align:right;}
  .preset{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0 12px;}
  .preset button{border:1px solid rgba(240,235,200,.25);background:rgba(255,255,255,.05);border-radius:999px;padding:6px 12px;font-size:.78rem;font-weight:700;color:#d8e2d0;cursor:pointer;}
  .totalbar{display:flex;justify-content:space-between;margin-top:10px;padding:9px 12px;background:rgba(0,0,0,.22);border-radius:9px;font-weight:800;font-size:.88rem;}
  .outwrap{margin-top:16px;background:rgba(0,0,0,.22);border:1px solid rgba(240,235,200,.18);border-radius:12px;padding:14px;}
  pre.out{white-space:pre-wrap;word-break:break-word;background:rgba(0,0,0,.25);border:1px solid rgba(240,235,200,.16);border-radius:9px;padding:12px;font-size:.85rem;max-height:420px;overflow:auto;color:#f3f6ee;font-family:&quot;SF Mono&quot;,&quot;Consolas&quot;,monospace;}
  .outbtns{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
  .outbtns button{border:1px solid rgba(240,235,200,.25);background:rgba(255,255,255,.05);color:#f3f6ee;border-radius:9px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.83rem;}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#0e1812;color:#fdfbe8;padding:10px 18px;border-radius:999px;font-size:.85rem;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50;border:1px solid rgba(240,235,200,.3);}
  .toast.show{opacity:.97;}
  .row{display:flex;gap:8px;align-items:flex-start;margin:6px 0;}
  .row>*{margin:0;}
  .addbtn{margin-top:8px;background:rgba(240,235,200,.12);border:1px solid rgba(240,235,200,.3);color:#f6f2d6;border-radius:8px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.83rem;}
  .del{background:rgba(0,0,0,.2);border:1px solid rgba(240,150,140,.4);color:#f0a59f;border-radius:7px;padding:6px 9px;cursor:pointer;font-weight:700;}
  @media (max-width:560px){ .grid{grid-template-columns:1fr;} .clock-big{font-size:2.8rem;} }
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#5aa86a,#3f8350);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>🎤</div>
    <div>
      <h1 class=&quot;chalk&quot; style=&quot;margin:0;font-size:18px;font-weight:900;color:#f6f2d6;&quot;>ファシリテーション・議論サポート</h1>
      <p style=&quot;margin:0;font-size:11px;color:#a9bba2;&quot; id=&quot;subtitle&quot;>【APIキーなし版】完全オフライン。手動プロンプト→JSON取り込み＋タイマー＋結論シート</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:2px;margin-top:18px;border-bottom:1px solid rgba(240,235,200,.18);flex-wrap:wrap;&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 設計</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>📋 進行プラン</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-timer&quot; onclick=&quot;setTab('timer')&quot;>⏱ 議論タイマー</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-sheet&quot; onclick=&quot;setTab('sheet')&quot;>✅ 結論・宿題シート</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <!-- ① 設計 -->
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div class=&quot;card chalkframe&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0;font-size:12px;color:#c7d4bf;line-height:1.7;&quot;>🏫 議題と時間・人数を入れると、AIが<b style=&quot;color:#f6f2d6;&quot;>進行台本・問いかけ・役割分担・まとめ方</b>を提案します。タイマーと結論シートはAIなしでも使えます。</p>
    </div>
    <div class=&quot;grid&quot; style=&quot;margin-bottom:12px;&quot;>
      <div class=&quot;card&quot;><label>🗣 議題（テーマ）</label><input id=&quot;f_topic&quot; placeholder=&quot;例：研修の振り返りと来週の改善点&quot;></div>
      <div class=&quot;card&quot;><label>🎯 議論のゴール</label><input id=&quot;f_goal&quot; placeholder=&quot;来週の改善アクションを3つ決める&quot;></div>
    </div>
    <div class=&quot;grid&quot; style=&quot;margin-bottom:12px;&quot;>
      <div class=&quot;card&quot;><label>⏱ 持ち時間（分）</label><input id=&quot;f_time&quot; type=&quot;number&quot; value=&quot;30&quot;></div>
      <div class=&quot;card&quot;><label>👥 人数</label><input id=&quot;f_people&quot; type=&quot;number&quot; value=&quot;5&quot;></div>
    </div>
    <div class=&quot;grid&quot; style=&quot;margin-bottom:12px;&quot;>
      <div class=&quot;card&quot;><label>🧩 形式</label><select id=&quot;f_format&quot;><option value=&quot;グループディスカッション&quot;>グループディスカッション</option><option value=&quot;振り返り会（KPT等）&quot;>振り返り会（KPT等）</option><option value=&quot;ブレスト&quot;>ブレスト</option><option value=&quot;意思決定会議&quot;>意思決定会議</option><option value=&quot;1on1&quot;>1on1</option></select></div>
      <div class=&quot;card&quot;><label>🌡 場の状態</label><select id=&quot;f_mood&quot;><option value=&quot;発言が少なめ&quot;>発言が少なめ（引き出したい）</option><option value=&quot;活発だが脱線しがち&quot;>活発だが脱線しがち</option><option value=&quot;ふつう&quot;>ふつう</option><option value=&quot;初対面で緊張&quot;>初対面で緊張ぎみ</option></select></div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;><label>📝 補足（参加者の背景・決めたいこと・制約など・任意）</label><textarea id=&quot;f_note&quot; placeholder=&quot;文系新卒中心。結論は必ず1つに絞りたい。最後に宿題を割り振りたい。&quot;></textarea></div>

    

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#c7d4bf;&quot;>🛠 使い方（3ステップ）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#7e8d77;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(240,235,200,.12);border:1px solid rgba(240,235,200,.3);border-radius:8px;padding:7px 14px;color:#f6f2d6;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(90,168,106,.2);border:1px solid #5aa86a;border-radius:8px;padding:7px 14px;color:#9cdca8;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んでプランを表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#c7d4bf;&quot;>✨ 生成されるもの</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <!-- ② 進行プラン -->
  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#6d7d66;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>🎤</div>
      <p>「設計」タブで議題を入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:14px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>

  <!-- ③ 議論タイマー -->
  <div id=&quot;view-timer&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div class=&quot;card chalkframe bigtimer&quot; style=&quot;margin-bottom:14px;&quot;>
      <div class=&quot;phase-name&quot; id=&quot;phaseName&quot;>準備OK</div>
      <div class=&quot;phase-sub&quot; id=&quot;phaseSub&quot;>開始ボタンで最初のフェーズが始まります</div>
      <div class=&quot;clock-big&quot; id=&quot;clockBig&quot;>30:00</div>
      <div style=&quot;font-size:.82rem;color:#a9bba2;&quot; id=&quot;totalLine&quot;>全体の残り：30:00 / 30:00</div>
      <div class=&quot;progress&quot;><div id=&quot;progBar&quot;></div></div>
      <div class=&quot;controls&quot;>
        <button class=&quot;btn-start&quot; id=&quot;startBtn&quot; onclick=&quot;startTimer()&quot;>▶ 開始</button>
        <button id=&quot;pauseBtn&quot; onclick=&quot;pauseTimer()&quot; style=&quot;display:none;&quot;>⏸ 一時停止</button>
        <button onclick=&quot;skipPhase()&quot;>⏭ 次へ</button>
        <button onclick=&quot;resetTimer()&quot;>⟲ リセット</button>
      </div>
    </div>
    <div class=&quot;card&quot;>
      <p style=&quot;margin:0 0 4px;font-size:13px;font-weight:800;color:#f6f2d6;&quot;>📋 フェーズ配分</p>
      <div class=&quot;preset&quot;>
        <button type=&quot;button&quot; onclick=&quot;applyPreset('std')&quot;>標準（5/5/15/5）</button>
        <button type=&quot;button&quot; onclick=&quot;applyPreset('retro')&quot;>振り返り（3/4/15/8）</button>
        <button type=&quot;button&quot; onclick=&quot;applyPreset('brain')&quot;>ブレスト（5/15/7/3）</button>
      </div>
      <div id=&quot;phaseList&quot;></div>
      <div class=&quot;totalbar&quot;><span>合計</span><span id=&quot;totalMin&quot;>30分</span></div>
      <div style=&quot;display:flex;align-items:center;gap:8px;margin-top:10px;font-size:.84rem;color:#a9bba2;&quot;><label style=&quot;margin:0;&quot;><input type=&quot;checkbox&quot; id=&quot;optSound&quot; checked style=&quot;width:auto;&quot;> フェーズ切替で合図音</label></div>
    </div>
  </div>

  <!-- ④ 結論・宿題シート -->
  <div id=&quot;view-sheet&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div class=&quot;card chalkframe&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0;font-size:12px;color:#c7d4bf;line-height:1.7;&quot;>🏫 議論の最後に、<b style=&quot;color:#f6f2d6;&quot;>結論・決めたこと・宿題</b>を記録します。「学級だより」風のまとめが作れます。</p>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;><label>🗣 議題</label><input id=&quot;s_topic&quot; placeholder=&quot;研修の振り返りと来週の改善点&quot;></div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;><label>🎯 結論（1文で）</label><input id=&quot;s_concl&quot; placeholder=&quot;演習の説明時間を増やし、補足資料を事前配布する&quot;></div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;><label>✅ 決めたこと（1行ずつ）</label><textarea id=&quot;s_decided&quot; placeholder=&quot;演習前に5分の概要説明を入れる&amp;#10;補足資料は前日までに共有する&quot;></textarea></div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;><label>📚 宿題・次回までにやること（「やること｜担当(役職)｜期限」を1行ずつ）</label><textarea id=&quot;s_homework&quot; placeholder=&quot;補足資料を作る｜メイン講師｜金曜まで&amp;#10;アンケート集計｜サブ講師｜水曜まで&quot;></textarea></div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;><label>➡ 次回の議題（任意）</label><input id=&quot;s_next&quot; placeholder=&quot;改善策の効果確認&quot;></div>
    <button class=&quot;btn&quot; onclick=&quot;buildSheet()&quot; style=&quot;width:100%;padding:14px;background:linear-gradient(135deg,#3f8350,#2c6038);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:900;cursor:pointer;&quot;>✅ まとめシートを作る</button>
  </div>

  <!-- 共通出力 -->
  <div class=&quot;outwrap&quot; id=&quot;outArea&quot; style=&quot;display:none;&quot;>
    <p style=&quot;margin:0 0 8px;font-size:13px;font-weight:800;color:#f6f2d6;&quot;>📄 出力</p>
    <pre class=&quot;out&quot; id=&quot;out&quot;></pre>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;copyOut()&quot;>📋 コピー</button>
      <button onclick=&quot;downloadOut('md')&quot;>📝 Markdown保存</button>
      <button onclick=&quot;clearOut()&quot;>クリア</button>
    </div>
  </div>
</div>
<div class=&quot;toast&quot; id=&quot;toast&quot;></div>
<script>
&quot;use strict&quot;;
function $(id){ return document.getElementById(id); }
function v(id){ var el=$(id); return el?(el.value||&quot;&quot;).trim():&quot;&quot;; }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function lines(s){ return (s||&quot;&quot;).split(/\n+/).map(function(x){return x.trim();}).filter(Boolean); }
function cols(s,n){ var a=s.split(&quot;｜&quot;).map(function(x){return x.trim();}); while(a.length<n) a.push(&quot;&quot;); return a; }
function toast(m){ var t=$(&quot;toast&quot;); if(!t)return; t.textContent=m; t.classList.add(&quot;show&quot;); setTimeout(function(){t.classList.remove(&quot;show&quot;);},1600); }
function nowParts(){
  var d=new Date(), wd=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var mm=(&quot;0&quot;+(d.getMonth()+1)).slice(-2), dd=(&quot;0&quot;+d.getDate()).slice(-2);
  return { date:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;）&quot;, iso:d.getFullYear()+&quot;-&quot;+mm+&quot;-&quot;+dd };
}
function stamp(){ return nowParts().iso.replace(/-/g,&quot;&quot;); }
function fmt(sec){ sec=Math.max(0,Math.round(sec)); var m=Math.floor(sec/60), s=sec%60; return (&quot;0&quot;+m).slice(-2)+&quot;:&quot;+(&quot;0&quot;+s).slice(-2); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }

/* ===== 出力エリア共通 ===== */
var lastOut=&quot;&quot;;
function showOut(md){ lastOut=md||&quot;&quot;; var o=$(&quot;out&quot;); if(o) o.textContent=lastOut; $(&quot;outArea&quot;).style.display=&quot;block&quot;; }
function clearOut(){ lastOut=&quot;&quot;; $(&quot;out&quot;).textContent=&quot;&quot;; $(&quot;outArea&quot;).style.display=&quot;none&quot;; toast(&quot;クリアしました&quot;); }
function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyOut(){ if(!lastOut){ toast(&quot;出力がありません&quot;); return; } copyToClip(lastOut); toast(&quot;コピーしました&quot;); }
function downloadOut(){
  if(!lastOut){ toast(&quot;出力がありません&quot;); return; }
  try{ var blob=new Blob([lastOut],{type:&quot;text/markdown;charset=utf-8&quot;}); var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=&quot;facili_&quot;+stamp()+&quot;.md&quot;; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(url);},500); }catch(e){ toast(&quot;保存に失敗&quot;); }
}
function copyBtn(btn, text){ copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000); }

/* ===== AI生成（設計→進行プラン） ===== */
var SYSTEM_PROMPT = `あなたは「議論ファシリテーションの支援者」です。研修や会議の進行を、議題・時間・人数・形式・場の状態に合わせて設計します。
方針：時間内に結論まで導く。発言が少ない場では問いかけで引き出し、脱線しがちな場では論点を戻す。最後に必ず結論・決めたこと・宿題（担当と期限）を残す。個人名・会社名は出さず役職名で書く。
ユーザーの条件（議題/ゴール/時間/人数/形式/場の状態/補足）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;meta&quot;: {&quot;topic&quot;: &quot;議題&quot;, &quot;goal&quot;: &quot;ゴール&quot;, &quot;time&quot;: 30, &quot;people&quot;: 5},
  &quot;agenda&quot;: [
    {&quot;phase&quot;: &quot;導入&quot;, &quot;min&quot;: 5, &quot;script&quot;: &quot;ファシリが話すセリフ（話し言葉）&quot;, &quot;purpose&quot;: &quot;この時間の狙い&quot;}
  ],
  &quot;prompts&quot;: [&quot;発言を引き出す問いかけを3〜5個&quot;],
  &quot;roles&quot;: [
    {&quot;role&quot;: &quot;ファシリテーター&quot;, &quot;task&quot;: &quot;役割の仕事内容&quot;}
  ],
  &quot;wrapup&quot;: {&quot;how&quot;: &quot;結論・決めたこと・宿題を引き出すまとめ方の指針&quot;, &quot;checklist&quot;: [&quot;結論を1文にする&quot;, &quot;決めたことを箇条書き&quot;, &quot;宿題に担当と期限をつける&quot;]}
}
注意：agendaは導入→本題→まとめの流れで時間配分が合計と概ね一致するように。rolesは人数に応じてファシリ/書記/タイムキーパー/発表者など。`;

var FIELD_TAGS=[&quot;🎤 進行台本&quot;,&quot;💬 問いかけ集&quot;,&quot;🧩 役割分担&quot;,&quot;✅ まとめ方&quot;];
var result=null, viewTab=&quot;agenda&quot;;

function readForm(){
  return { topic:v(&quot;f_topic&quot;), goal:v(&quot;f_goal&quot;), time:v(&quot;f_time&quot;), people:v(&quot;f_people&quot;), format:$(&quot;f_format&quot;).value, mood:$(&quot;f_mood&quot;).value, note:v(&quot;f_note&quot;) };
}
function buildUserMsg(){
  var f=readForm();
  return [&quot;## 議論の条件&quot;,
    &quot;【議題】&quot;+(f.topic||&quot;未入力&quot;),
    &quot;【ゴール】&quot;+(f.goal||&quot;未入力&quot;),
    &quot;【持ち時間】&quot;+(f.time||&quot;30&quot;)+&quot;分&quot;,
    &quot;【人数】&quot;+(f.people||&quot;-&quot;)+&quot;人&quot;,
    &quot;【形式】&quot;+f.format,
    &quot;【場の状態】&quot;+f.mood,
    &quot;【補足】&quot;+(f.note||&quot;なし&quot;)].join(&quot;\n&quot;);
}
function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(240,235,200,.12);border:1px solid rgba(240,235,200,.3);border-radius:20px;padding:3px 11px;font-size:11px;color:#f6f2d6;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}
function importJson(){
  setErr(&quot;&quot;);
  try{ var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}

var SUBTABS=[[&quot;agenda&quot;,&quot;🎤 進行台本&quot;],[&quot;prompts&quot;,&quot;💬 問いかけ集&quot;],[&quot;roles&quot;,&quot;🧩 役割分担&quot;],[&quot;wrapup&quot;,&quot;✅ まとめ方&quot;]];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBTABS.forEach(function(p){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===p[0]?&quot; active&quot;:&quot;&quot;); b.textContent=p[1];
    b.onclick=function(){ viewTab=p[0]; renderResult(); };
    st.appendChild(b);
  });
  var vw=$(&quot;resultView&quot;); vw.innerHTML=renderView();
  [].slice.call(vw.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); }); });
}
function rcard(inner){ return '<div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;agenda&quot;) return viewAgenda();
  if(viewTab===&quot;prompts&quot;) return viewPrompts();
  if(viewTab===&quot;roles&quot;) return viewRoles();
  if(viewTab===&quot;wrapup&quot;) return viewWrapup();
  return &quot;&quot;;
}
function viewAgenda(){
  var arr=result.agenda||[];
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#f6f2d6;font-weight:700;&quot;>🎤 進行台本</h3>';
  if(!arr.length) return h+rcard('<p style=&quot;color:#6d7d66;font-size:12px;&quot;>データがありません</p>');
  arr.forEach(function(a,i){
    h+=rcard('<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;&quot;>'+
      '<span style=&quot;font-weight:800;font-size:13px;color:#f6f2d6;&quot;>'+(i+1)+'. '+esc(a.phase||&quot;&quot;)+'</span>'+
      '<span style=&quot;background:rgba(240,235,200,.14);border:1px solid rgba(240,235,200,.3);border-radius:20px;padding:2px 10px;font-size:11px;color:#f6f2d6;&quot;>'+esc(String(a.min||&quot;-&quot;))+'分</span></div>'+
      (a.purpose?'<p style=&quot;margin:0 0 6px;font-size:11px;color:#a9bba2;&quot;>🎯 '+esc(a.purpose)+'</p>':'')+
      '<div style=&quot;white-space:pre-wrap;font-size:13px;color:#f3f6ee;line-height:1.85;&quot;>'+esc(a.script||&quot;&quot;)+'</div>');
  });
  return h;
}
function viewPrompts(){
  var arr=result.prompts||[];
  var txt=arr.map(function(p,i){return (i+1)+&quot;. &quot;+p;}).join(&quot;\n&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#f6f2d6;font-weight:700;&quot;>💬 問いかけ集</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(txt)+'&quot; style=&quot;background:rgba(90,168,106,.2);border:1px solid #5aa86a;border-radius:8px;padding:5px 13px;color:#9cdca8;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  if(!arr.length) return h+rcard('<p style=&quot;color:#6d7d66;font-size:12px;&quot;>データがありません</p>');
  h+='<div class=&quot;card&quot;>';
  arr.forEach(function(p){ h+='<div style=&quot;display:flex;gap:8px;margin:7px 0;&quot;><span style=&quot;color:#86c98e;&quot;>💬</span><span style=&quot;font-size:13px;color:#f3f6ee;&quot;>'+esc(p)+'</span></div>'; });
  h+='</div>';
  return h;
}
function viewRoles(){
  var arr=result.roles||[];
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#f6f2d6;font-weight:700;&quot;>🧩 役割分担</h3>';
  if(!arr.length) return h+rcard('<p style=&quot;color:#6d7d66;font-size:12px;&quot;>データがありません</p>');
  arr.forEach(function(r){
    h+=rcard('<div style=&quot;font-weight:800;font-size:13px;color:#f6f2d6;margin-bottom:4px;&quot;>'+esc(r.role||&quot;&quot;)+'</div><div style=&quot;font-size:12px;color:#c7d4bf;&quot;>'+esc(r.task||&quot;&quot;)+'</div>');
  });
  return h;
}
function viewWrapup(){
  var w=result.wrapup||{};
  var ck=(w.checklist||[]).map(function(c){return '<div style=&quot;display:flex;gap:8px;align-items:center;margin:5px 0;&quot;><div style=&quot;width:14px;height:14px;border:2px solid #86c98e;border-radius:4px;flex:0 0 14px;&quot;></div><span style=&quot;font-size:12px;color:#f3f6ee;&quot;>'+esc(c)+'</span></div>';}).join(&quot;&quot;);
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#f6f2d6;font-weight:700;&quot;>✅ まとめ方（結論・決めたこと・宿題）</h3>';
  h+=rcard((w.how?'<p style=&quot;margin:0 0 12px;font-size:13px;color:#f3f6ee;line-height:1.85;&quot;>'+esc(w.how)+'</p>':'')+
    (ck?'<p style=&quot;margin:0 0 6px;font-size:11px;font-weight:700;color:#a9bba2;&quot;>締めのチェックリスト</p>'+ck:''))+
    rcard('<p style=&quot;margin:0;font-size:12px;color:#a9bba2;&quot;>👉 そのまま「✅ 結論・宿題シート」タブで記録できます。</p>');
  return h;
}

/* ===== タイマー ===== */
var T_PHASES=[
  {key:&quot;intro&quot;, icon:&quot;🚪&quot;, name:&quot;導入&quot;, sub:&quot;目的とゴールの共有&quot;, min:5},
  {key:&quot;ice&quot;, icon:&quot;🤝&quot;, name:&quot;アイスブレイク&quot;, sub:&quot;発言しやすい空気づくり&quot;, min:5},
  {key:&quot;discuss&quot;, icon:&quot;💬&quot;, name:&quot;議論&quot;, sub:&quot;本題・意見出し&quot;, min:15},
  {key:&quot;wrap&quot;, icon:&quot;✅&quot;, name:&quot;まとめ&quot;, sub:&quot;結論・決めたこと・宿題&quot;, min:5}
];
var T_PRESETS={ std:[5,5,15,5], retro:[3,4,15,8], brain:[5,15,7,3] };
var timer={ running:false, idx:-1, remain:0, intervalId:null };
function renderPhaseList(){
  var box=$(&quot;phaseList&quot;); box.innerHTML=&quot;&quot;;
  T_PHASES.forEach(function(p,i){
    var row=document.createElement(&quot;div&quot;);
    row.className=&quot;prow&quot;+(i===timer.idx?&quot; active&quot;:&quot;&quot;)+(timer.idx>i?&quot; done&quot;:&quot;&quot;); row.id=&quot;prow_&quot;+i;
    row.innerHTML='<span class=&quot;pi&quot;>'+p.icon+'</span><span class=&quot;pn&quot;>'+p.name+'</span><span class=&quot;pd&quot;>'+p.sub+'</span><span><input type=&quot;number&quot; min=&quot;0&quot; max=&quot;120&quot; value=&quot;'+p.min+'&quot;><span style=&quot;font-size:.74rem;color:#a9bba2;&quot;> 分</span></span>';
    box.appendChild(row);
    (function(idx){ row.querySelector(&quot;input&quot;).addEventListener(&quot;change&quot;, function(){ onMinChange(idx,this.value); }); })(i);
  });
  updateTotal();
}
function onMinChange(i,val){ var n=parseInt(val,10); if(isNaN(n)||n<0)n=0; if(n>120)n=120; T_PHASES[i].min=n; renderPhaseList(); if(!timer.running&amp;&amp;timer.idx<0) updateDisplay(); }
function totalMin(){ return T_PHASES.reduce(function(a,p){return a+p.min;},0); }
function updateTotal(){ var t=totalMin(); var el=$(&quot;totalMin&quot;); if(el){ el.textContent=t+&quot;分&quot;; el.style.color=(t>0?&quot;#f6f2d6&quot;:&quot;#f4c451&quot;); } }
function applyPreset(name){ var arr=T_PRESETS[name]; if(!arr)return; T_PHASES.forEach(function(p,i){p.min=arr[i];}); renderPhaseList(); if(!timer.running) resetTimer(true); toast(&quot;配分を適用（合計&quot;+totalMin()+&quot;分）&quot;); }
var audioCtx=null;
function beep(times){
  if(!$(&quot;optSound&quot;).checked) return;
  try{ if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)();
    var n=times||1;
    for(var i=0;i<n;i++){ var t=audioCtx.currentTime+i*0.18; var o=audioCtx.createOscillator(), g=audioCtx.createGain();
      o.frequency.value=880; o.type=&quot;sine&quot;; g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(0.25,t+0.02); g.gain.exponentialRampToValueAtTime(0.0001,t+0.16);
      o.connect(g); g.connect(audioCtx.destination); o.start(t); o.stop(t+0.17); }
  }catch(e){}
}
function totalRemainSec(){ var s=0; if(timer.idx<0){ s=totalMin()*60; } else { s=timer.remain; for(var i=timer.idx+1;i<T_PHASES.length;i++){ s+=T_PHASES[i].min*60; } } return s; }
function updateDisplay(){
  var clock=$(&quot;clockBig&quot;);
  if(timer.idx<0){ $(&quot;phaseName&quot;).textContent=&quot;準備OK&quot;; $(&quot;phaseSub&quot;).textContent=&quot;開始ボタンで最初のフェーズが始まります&quot;; clock.textContent=fmt(totalMin()*60); clock.classList.remove(&quot;warn&quot;); $(&quot;progBar&quot;).style.width=&quot;0%&quot;; }
  else { var p=T_PHASES[timer.idx]; $(&quot;phaseName&quot;).textContent=p.icon+&quot; &quot;+p.name+&quot;（&quot;+(timer.idx+1)+&quot;/&quot;+T_PHASES.length+&quot;）&quot;; $(&quot;phaseSub&quot;).textContent=p.sub; clock.textContent=fmt(timer.remain); clock.classList.toggle(&quot;warn&quot;, timer.remain<=10); var pt=p.min*60||1; $(&quot;progBar&quot;).style.width=Math.min(100,Math.max(0,(pt-timer.remain)/pt*100))+&quot;%&quot;; }
  $(&quot;totalLine&quot;).textContent=&quot;全体の残り：&quot;+fmt(totalRemainSec())+&quot; / &quot;+fmt(totalMin()*60);
  T_PHASES.forEach(function(p,i){ var row=$(&quot;prow_&quot;+i); if(row){ row.classList.toggle(&quot;active&quot;, i===timer.idx); row.classList.toggle(&quot;done&quot;, timer.idx>i); } });
}
function allRestZero(from){ for(var i=from;i<T_PHASES.length;i++){ if(T_PHASES[i].min>0) return false; } return true; }
function enterPhase(i){ while(i<T_PHASES.length &amp;&amp; T_PHASES[i].min<=0){ i++; } if(i>=T_PHASES.length){ finishAll(); return; } timer.idx=i; timer.remain=T_PHASES[i].min*60; updateDisplay(); }
function tick(){ if(!timer.running) return; timer.remain--; if(timer.remain<=0){ beep(timer.idx>=T_PHASES.length-1?3:2); var nx=timer.idx+1; if(nx>=T_PHASES.length||allRestZero(nx)){ finishAll(); return; } enterPhase(nx); } else { updateDisplay(); } }
function startTimer(){ if(totalMin()<=0){ toast(&quot;分数を設定してください&quot;); return; } if(timer.idx<0) enterPhase(0); timer.running=true; $(&quot;startBtn&quot;).style.display=&quot;none&quot;; $(&quot;pauseBtn&quot;).style.display=&quot;inline-block&quot;; clearInterval(timer.intervalId); timer.intervalId=setInterval(tick,1000); try{ if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)(); if(audioCtx.state===&quot;suspended&quot;) audioCtx.resume(); }catch(e){} updateDisplay(); }
function pauseTimer(){ timer.running=false; clearInterval(timer.intervalId); $(&quot;startBtn&quot;).style.display=&quot;inline-block&quot;; $(&quot;startBtn&quot;).textContent=&quot;▶ 再開&quot;; $(&quot;pauseBtn&quot;).style.display=&quot;none&quot;; }
function skipPhase(){ if(timer.idx<0){ enterPhase(0); return; } beep(1); var nx=timer.idx+1; if(nx>=T_PHASES.length||allRestZero(nx)){ finishAll(); return; } enterPhase(nx); }
function finishAll(){ timer.running=false; clearInterval(timer.intervalId); timer.idx=T_PHASES.length; $(&quot;phaseName&quot;).textContent=&quot;🎉 終了！&quot;; $(&quot;phaseSub&quot;).textContent=&quot;議論おつかれさまでした。結論・宿題シートへ&quot;; $(&quot;clockBig&quot;).textContent=&quot;00:00&quot;; $(&quot;clockBig&quot;).classList.remove(&quot;warn&quot;); $(&quot;progBar&quot;).style.width=&quot;100%&quot;; $(&quot;totalLine&quot;).textContent=&quot;全体の残り：00:00 / &quot;+fmt(totalMin()*60); $(&quot;startBtn&quot;).style.display=&quot;inline-block&quot;; $(&quot;startBtn&quot;).textContent=&quot;▶ 開始&quot;; $(&quot;pauseBtn&quot;).style.display=&quot;none&quot;; T_PHASES.forEach(function(p,i){ var row=$(&quot;prow_&quot;+i); if(row){ row.classList.remove(&quot;active&quot;); row.classList.add(&quot;done&quot;); } }); beep(3); }
function resetTimer(silent){ timer.running=false; clearInterval(timer.intervalId); timer.idx=-1; timer.remain=0; $(&quot;startBtn&quot;).style.display=&quot;inline-block&quot;; $(&quot;startBtn&quot;).textContent=&quot;▶ 開始&quot;; $(&quot;pauseBtn&quot;).style.display=&quot;none&quot;; renderPhaseList(); updateDisplay(); if(!silent) toast(&quot;リセットしました&quot;); }

/* ===== 結論・宿題シート（学級だより風） ===== */
function buildSheet(){
  var topic=v(&quot;s_topic&quot;)||&quot;（議題未入力）&quot;;
  var decided=lines(v(&quot;s_decided&quot;)), hw=lines(v(&quot;s_homework&quot;));
  var m=[];
  m.push(&quot;# 🏫 議論まとめ &quot;+nowParts().date);
  m.push(&quot;&quot;);
  m.push(&quot;## 🗣 議題&quot;);
  m.push(topic);
  m.push(&quot;&quot;);
  m.push(&quot;## 🎯 結論&quot;);
  m.push(&quot;> &quot;+(v(&quot;s_concl&quot;)||&quot;（結論未入力）&quot;));
  m.push(&quot;&quot;);
  m.push(&quot;## ✅ 決めたこと&quot;);
  if(decided.length){ decided.forEach(function(x){ m.push(&quot;- &quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;);
  m.push(&quot;## 📚 宿題・次回までにやること&quot;);
  if(hw.length){
    m.push(&quot;| やること | 担当 | 期限 |&quot;);
    m.push(&quot;|---|---|---|&quot;);
    hw.forEach(function(x){ var c=cols(x,3); m.push(&quot;| &quot;+(c[0]||&quot;&quot;)+&quot; | &quot;+(c[1]||&quot;—&quot;)+&quot; | &quot;+(c[2]||&quot;—&quot;)+&quot; |&quot;); });
  } else { m.push(&quot;- （宿題なし）&quot;); }
  m.push(&quot;&quot;);
  if(v(&quot;s_next&quot;)){ m.push(&quot;## ➡ 次回の議題&quot;); m.push(v(&quot;s_next&quot;)); m.push(&quot;&quot;); }
  m.push(&quot;---&quot;);
  m.push(&quot;記録：石黒 友季子&quot;);
  showOut(m.join(&quot;\n&quot;));
  toast(&quot;まとめシートを作りました&quot;);
}

/* ===== タブ切替 ===== */
function setTab(t){
  [&quot;input&quot;,&quot;result&quot;,&quot;timer&quot;,&quot;sheet&quot;].forEach(function(x){
    var btn=$(&quot;tt-&quot;+x), view=$(&quot;view-&quot;+x);
    if(btn) btn.classList.toggle(&quot;active&quot;, x===t);
    if(view) view.style.display=(x===t?&quot;block&quot;:&quot;none&quot;);
  });
  if(t===&quot;result&quot;) renderResult();
}

/* ===== init ===== */
(function(){
  renderTags();
  renderPhaseList(); updateDisplay();
  setTab(&quot;input&quot;);
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-faciliapi" title="ファシリAPIあり" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ ファシリテーション・議論サポート 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:#1d3026;color:#f3f6ee;}
  /* 黒板風 */
  body{background:
    radial-gradient(ellipse at 30% 20%, rgba(255,255,255,.03), transparent 60%),
    linear-gradient(135deg,#22382b,#1a2c21 60%,#203429);}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(240,235,200,.4);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.9}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:980px;margin:0 auto;}
  .wrapB{max-width:980px;margin:0 auto;padding:20px 28px 60px;}
  .card{background:rgba(255,255,255,0.045);border-radius:12px;padding:18px;border:1px solid rgba(240,235,200,0.13);}
  .chalkframe{border:2px solid rgba(240,235,200,.35);border-radius:10px;}
  .toptab{padding:9px 16px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#a9bba2;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(240,235,200,.14);border-bottom:2px solid #f0ebc8;color:#f6f2d6;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#a9bba2;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(240,235,200,.22);border:1px solid #f0ebc8;color:#f6f2d6;}
  label{display:block;font-size:12px;font-weight:700;color:#c7d4bf;margin-bottom:6px;}
  textarea,input[type=password],input[type=text],input[type=number],input:not([type]),select{width:100%;background:rgba(0,0,0,.26);border:1px solid rgba(240,235,200,.2);
    border-radius:8px;padding:10px 12px;color:#f3f6ee;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
  h1.chalk{font-family:&quot;Yu Gothic&quot;,&quot;Hiragino Sans&quot;,sans-serif;}
  /* タイマー */
  .bigtimer{text-align:center;}
  .phase-name{font-size:1.2rem;font-weight:800;color:#f6f2d6;}
  .phase-sub{font-size:.82rem;color:#a9bba2;margin-top:2px;min-height:1.1em;}
  .clock-big{font-size:3.6rem;font-weight:800;letter-spacing:.04em;font-variant-numeric:tabular-nums;margin:6px 0;color:#fdfbe8;}
  .clock-big.warn{color:#f4c451;}
  .progress{height:8px;background:rgba(0,0,0,.3);border-radius:999px;overflow:hidden;margin:14px 0 0;}
  .progress > div{height:100%;background:linear-gradient(90deg,#86c98e,#5aa86a);width:0%;transition:width .3s;}
  .controls{display:flex;gap:10px;justify-content:center;margin-top:16px;flex-wrap:wrap;}
  .controls button{border:1px solid rgba(240,235,200,.3);border-radius:11px;padding:11px 20px;font-size:.92rem;font-weight:800;cursor:pointer;background:rgba(255,255,255,.06);color:#f3f6ee;}
  .controls .btn-start{background:linear-gradient(135deg,#5aa86a,#3f8350);border-color:transparent;color:#fff;}
  .prow{display:flex;align-items:center;gap:10px;padding:8px 11px;border:1px solid rgba(240,235,200,.18);border-radius:10px;margin:6px 0;}
  .prow.active{background:rgba(240,235,200,.12);border-color:#f0ebc8;}
  .prow.done{opacity:.45;}
  .prow .pi{font-size:1.05rem;width:1.6em;text-align:center;}
  .prow .pn{font-weight:800;font-size:.9rem;min-width:7em;}
  .prow .pd{font-size:.74rem;color:#a9bba2;flex:1;}
  .prow input{width:54px;text-align:right;}
  .preset{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0 12px;}
  .preset button{border:1px solid rgba(240,235,200,.25);background:rgba(255,255,255,.05);border-radius:999px;padding:6px 12px;font-size:.78rem;font-weight:700;color:#d8e2d0;cursor:pointer;}
  .totalbar{display:flex;justify-content:space-between;margin-top:10px;padding:9px 12px;background:rgba(0,0,0,.22);border-radius:9px;font-weight:800;font-size:.88rem;}
  .outwrap{margin-top:16px;background:rgba(0,0,0,.22);border:1px solid rgba(240,235,200,.18);border-radius:12px;padding:14px;}
  pre.out{white-space:pre-wrap;word-break:break-word;background:rgba(0,0,0,.25);border:1px solid rgba(240,235,200,.16);border-radius:9px;padding:12px;font-size:.85rem;max-height:420px;overflow:auto;color:#f3f6ee;font-family:&quot;SF Mono&quot;,&quot;Consolas&quot;,monospace;}
  .outbtns{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
  .outbtns button{border:1px solid rgba(240,235,200,.25);background:rgba(255,255,255,.05);color:#f3f6ee;border-radius:9px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.83rem;}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#0e1812;color:#fdfbe8;padding:10px 18px;border-radius:999px;font-size:.85rem;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50;border:1px solid rgba(240,235,200,.3);}
  .toast.show{opacity:.97;}
  .row{display:flex;gap:8px;align-items:flex-start;margin:6px 0;}
  .row>*{margin:0;}
  .addbtn{margin-top:8px;background:rgba(240,235,200,.12);border:1px solid rgba(240,235,200,.3);color:#f6f2d6;border-radius:8px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.83rem;}
  .del{background:rgba(0,0,0,.2);border:1px solid rgba(240,150,140,.4);color:#f0a59f;border-radius:7px;padding:6px 9px;cursor:pointer;font-weight:700;}
  @media (max-width:560px){ .grid{grid-template-columns:1fr;} .clock-big{font-size:2.8rem;} }
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#5aa86a,#3f8350);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>🎤</div>
    <div>
      <h1 class=&quot;chalk&quot; style=&quot;margin:0;font-size:18px;font-weight:900;color:#f6f2d6;&quot;>ファシリテーション・議論サポート</h1>
      <p style=&quot;margin:0;font-size:11px;color:#a9bba2;&quot; id=&quot;subtitle&quot;>【APIキー版】キーを入れると進行プランを自動生成。タイマー・結論シートも</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:2px;margin-top:18px;border-bottom:1px solid rgba(240,235,200,.18);flex-wrap:wrap;&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 設計</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>📋 進行プラン</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-timer&quot; onclick=&quot;setTab('timer')&quot;>⏱ 議論タイマー</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-sheet&quot; onclick=&quot;setTab('sheet')&quot;>✅ 結論・宿題シート</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <!-- ① 設計 -->
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div class=&quot;card chalkframe&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0;font-size:12px;color:#c7d4bf;line-height:1.7;&quot;>🏫 議題と時間・人数を入れると、AIが<b style=&quot;color:#f6f2d6;&quot;>進行台本・問いかけ・役割分担・まとめ方</b>を提案します。タイマーと結論シートはAIなしでも使えます。</p>
    </div>
    <div class=&quot;grid&quot; style=&quot;margin-bottom:12px;&quot;>
      <div class=&quot;card&quot;><label>🗣 議題（テーマ）</label><input id=&quot;f_topic&quot; placeholder=&quot;例：研修の振り返りと来週の改善点&quot;></div>
      <div class=&quot;card&quot;><label>🎯 議論のゴール</label><input id=&quot;f_goal&quot; placeholder=&quot;来週の改善アクションを3つ決める&quot;></div>
    </div>
    <div class=&quot;grid&quot; style=&quot;margin-bottom:12px;&quot;>
      <div class=&quot;card&quot;><label>⏱ 持ち時間（分）</label><input id=&quot;f_time&quot; type=&quot;number&quot; value=&quot;30&quot;></div>
      <div class=&quot;card&quot;><label>👥 人数</label><input id=&quot;f_people&quot; type=&quot;number&quot; value=&quot;5&quot;></div>
    </div>
    <div class=&quot;grid&quot; style=&quot;margin-bottom:12px;&quot;>
      <div class=&quot;card&quot;><label>🧩 形式</label><select id=&quot;f_format&quot;><option value=&quot;グループディスカッション&quot;>グループディスカッション</option><option value=&quot;振り返り会（KPT等）&quot;>振り返り会（KPT等）</option><option value=&quot;ブレスト&quot;>ブレスト</option><option value=&quot;意思決定会議&quot;>意思決定会議</option><option value=&quot;1on1&quot;>1on1</option></select></div>
      <div class=&quot;card&quot;><label>🌡 場の状態</label><select id=&quot;f_mood&quot;><option value=&quot;発言が少なめ&quot;>発言が少なめ（引き出したい）</option><option value=&quot;活発だが脱線しがち&quot;>活発だが脱線しがち</option><option value=&quot;ふつう&quot;>ふつう</option><option value=&quot;初対面で緊張&quot;>初対面で緊張ぎみ</option></select></div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;><label>📝 補足（参加者の背景・決めたいこと・制約など・任意）</label><textarea id=&quot;f_note&quot; placeholder=&quot;文系新卒中心。結論は必ず1つに絞りたい。最後に宿題を割り振りたい。&quot;></textarea></div>

    <div class=&quot;card&quot; id=&quot;apiKeyCard&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>🔑 Anthropic APIキー（任意・入れると自動生成）</label>
      <input type=&quot;password&quot; id=&quot;apiKey&quot; placeholder=&quot;sk-ant-... （未入力なら下の手動コピーを使用）&quot;>
      <p style=&quot;margin:6px 0 0;font-size:10px;color:#7e8d77;&quot;>※キーはこの画面内だけで使われ、保存も外部送信もされません（Anthropic API以外には送りません）。</p>
    </div>

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    <button class=&quot;btn&quot; id=&quot;analyzeBtn&quot; onclick=&quot;handleAnalyze()&quot; style=&quot;width:100%;padding:15px;background:linear-gradient(135deg,#3f8350,#2c6038);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;&quot;>🎤 進行プランを生成する</button>

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#c7d4bf;&quot;>🛠 APIキーがない場合（手動）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#7e8d77;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(240,235,200,.12);border:1px solid rgba(240,235,200,.3);border-radius:8px;padding:7px 14px;color:#f6f2d6;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(90,168,106,.2);border:1px solid #5aa86a;border-radius:8px;padding:7px 14px;color:#9cdca8;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んでプランを表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#c7d4bf;&quot;>✨ 生成されるもの</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <!-- ② 進行プラン -->
  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#6d7d66;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>🎤</div>
      <p>「設計」タブで議題を入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:14px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>

  <!-- ③ 議論タイマー -->
  <div id=&quot;view-timer&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div class=&quot;card chalkframe bigtimer&quot; style=&quot;margin-bottom:14px;&quot;>
      <div class=&quot;phase-name&quot; id=&quot;phaseName&quot;>準備OK</div>
      <div class=&quot;phase-sub&quot; id=&quot;phaseSub&quot;>開始ボタンで最初のフェーズが始まります</div>
      <div class=&quot;clock-big&quot; id=&quot;clockBig&quot;>30:00</div>
      <div style=&quot;font-size:.82rem;color:#a9bba2;&quot; id=&quot;totalLine&quot;>全体の残り：30:00 / 30:00</div>
      <div class=&quot;progress&quot;><div id=&quot;progBar&quot;></div></div>
      <div class=&quot;controls&quot;>
        <button class=&quot;btn-start&quot; id=&quot;startBtn&quot; onclick=&quot;startTimer()&quot;>▶ 開始</button>
        <button id=&quot;pauseBtn&quot; onclick=&quot;pauseTimer()&quot; style=&quot;display:none;&quot;>⏸ 一時停止</button>
        <button onclick=&quot;skipPhase()&quot;>⏭ 次へ</button>
        <button onclick=&quot;resetTimer()&quot;>⟲ リセット</button>
      </div>
    </div>
    <div class=&quot;card&quot;>
      <p style=&quot;margin:0 0 4px;font-size:13px;font-weight:800;color:#f6f2d6;&quot;>📋 フェーズ配分</p>
      <div class=&quot;preset&quot;>
        <button type=&quot;button&quot; onclick=&quot;applyPreset('std')&quot;>標準（5/5/15/5）</button>
        <button type=&quot;button&quot; onclick=&quot;applyPreset('retro')&quot;>振り返り（3/4/15/8）</button>
        <button type=&quot;button&quot; onclick=&quot;applyPreset('brain')&quot;>ブレスト（5/15/7/3）</button>
      </div>
      <div id=&quot;phaseList&quot;></div>
      <div class=&quot;totalbar&quot;><span>合計</span><span id=&quot;totalMin&quot;>30分</span></div>
      <div style=&quot;display:flex;align-items:center;gap:8px;margin-top:10px;font-size:.84rem;color:#a9bba2;&quot;><label style=&quot;margin:0;&quot;><input type=&quot;checkbox&quot; id=&quot;optSound&quot; checked style=&quot;width:auto;&quot;> フェーズ切替で合図音</label></div>
    </div>
  </div>

  <!-- ④ 結論・宿題シート -->
  <div id=&quot;view-sheet&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div class=&quot;card chalkframe&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0;font-size:12px;color:#c7d4bf;line-height:1.7;&quot;>🏫 議論の最後に、<b style=&quot;color:#f6f2d6;&quot;>結論・決めたこと・宿題</b>を記録します。「学級だより」風のまとめが作れます。</p>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;><label>🗣 議題</label><input id=&quot;s_topic&quot; placeholder=&quot;研修の振り返りと来週の改善点&quot;></div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;><label>🎯 結論（1文で）</label><input id=&quot;s_concl&quot; placeholder=&quot;演習の説明時間を増やし、補足資料を事前配布する&quot;></div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;><label>✅ 決めたこと（1行ずつ）</label><textarea id=&quot;s_decided&quot; placeholder=&quot;演習前に5分の概要説明を入れる&amp;#10;補足資料は前日までに共有する&quot;></textarea></div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;><label>📚 宿題・次回までにやること（「やること｜担当(役職)｜期限」を1行ずつ）</label><textarea id=&quot;s_homework&quot; placeholder=&quot;補足資料を作る｜メイン講師｜金曜まで&amp;#10;アンケート集計｜サブ講師｜水曜まで&quot;></textarea></div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;><label>➡ 次回の議題（任意）</label><input id=&quot;s_next&quot; placeholder=&quot;改善策の効果確認&quot;></div>
    <button class=&quot;btn&quot; onclick=&quot;buildSheet()&quot; style=&quot;width:100%;padding:14px;background:linear-gradient(135deg,#3f8350,#2c6038);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:900;cursor:pointer;&quot;>✅ まとめシートを作る</button>
  </div>

  <!-- 共通出力 -->
  <div class=&quot;outwrap&quot; id=&quot;outArea&quot; style=&quot;display:none;&quot;>
    <p style=&quot;margin:0 0 8px;font-size:13px;font-weight:800;color:#f6f2d6;&quot;>📄 出力</p>
    <pre class=&quot;out&quot; id=&quot;out&quot;></pre>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;copyOut()&quot;>📋 コピー</button>
      <button onclick=&quot;downloadOut('md')&quot;>📝 Markdown保存</button>
      <button onclick=&quot;clearOut()&quot;>クリア</button>
    </div>
  </div>
</div>
<div class=&quot;toast&quot; id=&quot;toast&quot;></div>
<script>
&quot;use strict&quot;;
function $(id){ return document.getElementById(id); }
function v(id){ var el=$(id); return el?(el.value||&quot;&quot;).trim():&quot;&quot;; }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function lines(s){ return (s||&quot;&quot;).split(/\n+/).map(function(x){return x.trim();}).filter(Boolean); }
function cols(s,n){ var a=s.split(&quot;｜&quot;).map(function(x){return x.trim();}); while(a.length<n) a.push(&quot;&quot;); return a; }
function toast(m){ var t=$(&quot;toast&quot;); if(!t)return; t.textContent=m; t.classList.add(&quot;show&quot;); setTimeout(function(){t.classList.remove(&quot;show&quot;);},1600); }
function nowParts(){
  var d=new Date(), wd=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var mm=(&quot;0&quot;+(d.getMonth()+1)).slice(-2), dd=(&quot;0&quot;+d.getDate()).slice(-2);
  return { date:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;）&quot;, iso:d.getFullYear()+&quot;-&quot;+mm+&quot;-&quot;+dd };
}
function stamp(){ return nowParts().iso.replace(/-/g,&quot;&quot;); }
function fmt(sec){ sec=Math.max(0,Math.round(sec)); var m=Math.floor(sec/60), s=sec%60; return (&quot;0&quot;+m).slice(-2)+&quot;:&quot;+(&quot;0&quot;+s).slice(-2); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }

/* ===== 出力エリア共通 ===== */
var lastOut=&quot;&quot;;
function showOut(md){ lastOut=md||&quot;&quot;; var o=$(&quot;out&quot;); if(o) o.textContent=lastOut; $(&quot;outArea&quot;).style.display=&quot;block&quot;; }
function clearOut(){ lastOut=&quot;&quot;; $(&quot;out&quot;).textContent=&quot;&quot;; $(&quot;outArea&quot;).style.display=&quot;none&quot;; toast(&quot;クリアしました&quot;); }
function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyOut(){ if(!lastOut){ toast(&quot;出力がありません&quot;); return; } copyToClip(lastOut); toast(&quot;コピーしました&quot;); }
function downloadOut(){
  if(!lastOut){ toast(&quot;出力がありません&quot;); return; }
  try{ var blob=new Blob([lastOut],{type:&quot;text/markdown;charset=utf-8&quot;}); var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=&quot;facili_&quot;+stamp()+&quot;.md&quot;; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(url);},500); }catch(e){ toast(&quot;保存に失敗&quot;); }
}
function copyBtn(btn, text){ copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000); }

/* ===== AI生成（設計→進行プラン） ===== */
var SYSTEM_PROMPT = `あなたは「議論ファシリテーションの支援者」です。研修や会議の進行を、議題・時間・人数・形式・場の状態に合わせて設計します。
方針：時間内に結論まで導く。発言が少ない場では問いかけで引き出し、脱線しがちな場では論点を戻す。最後に必ず結論・決めたこと・宿題（担当と期限）を残す。個人名・会社名は出さず役職名で書く。
ユーザーの条件（議題/ゴール/時間/人数/形式/場の状態/補足）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;meta&quot;: {&quot;topic&quot;: &quot;議題&quot;, &quot;goal&quot;: &quot;ゴール&quot;, &quot;time&quot;: 30, &quot;people&quot;: 5},
  &quot;agenda&quot;: [
    {&quot;phase&quot;: &quot;導入&quot;, &quot;min&quot;: 5, &quot;script&quot;: &quot;ファシリが話すセリフ（話し言葉）&quot;, &quot;purpose&quot;: &quot;この時間の狙い&quot;}
  ],
  &quot;prompts&quot;: [&quot;発言を引き出す問いかけを3〜5個&quot;],
  &quot;roles&quot;: [
    {&quot;role&quot;: &quot;ファシリテーター&quot;, &quot;task&quot;: &quot;役割の仕事内容&quot;}
  ],
  &quot;wrapup&quot;: {&quot;how&quot;: &quot;結論・決めたこと・宿題を引き出すまとめ方の指針&quot;, &quot;checklist&quot;: [&quot;結論を1文にする&quot;, &quot;決めたことを箇条書き&quot;, &quot;宿題に担当と期限をつける&quot;]}
}
注意：agendaは導入→本題→まとめの流れで時間配分が合計と概ね一致するように。rolesは人数に応じてファシリ/書記/タイムキーパー/発表者など。`;

var FIELD_TAGS=[&quot;🎤 進行台本&quot;,&quot;💬 問いかけ集&quot;,&quot;🧩 役割分担&quot;,&quot;✅ まとめ方&quot;];
var result=null, viewTab=&quot;agenda&quot;;

function readForm(){
  return { topic:v(&quot;f_topic&quot;), goal:v(&quot;f_goal&quot;), time:v(&quot;f_time&quot;), people:v(&quot;f_people&quot;), format:$(&quot;f_format&quot;).value, mood:$(&quot;f_mood&quot;).value, note:v(&quot;f_note&quot;) };
}
function buildUserMsg(){
  var f=readForm();
  return [&quot;## 議論の条件&quot;,
    &quot;【議題】&quot;+(f.topic||&quot;未入力&quot;),
    &quot;【ゴール】&quot;+(f.goal||&quot;未入力&quot;),
    &quot;【持ち時間】&quot;+(f.time||&quot;30&quot;)+&quot;分&quot;,
    &quot;【人数】&quot;+(f.people||&quot;-&quot;)+&quot;人&quot;,
    &quot;【形式】&quot;+f.format,
    &quot;【場の状態】&quot;+f.mood,
    &quot;【補足】&quot;+(f.note||&quot;なし&quot;)].join(&quot;\n&quot;);
}
function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(240,235,200,.12);border:1px solid rgba(240,235,200,.3);border-radius:20px;padding:3px 11px;font-size:11px;color:#f6f2d6;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}
function handleAnalyze(){
  var f=readForm();
  if(!f.topic){ setErr(&quot;「議題」を入力してください&quot;); return; }
  var key=$(&quot;apiKey&quot;)?$(&quot;apiKey&quot;).value.trim():&quot;&quot;;
  if(!key){ setErr(&quot;APIキーが未入力です。下の「手動プロンプトをコピー」を使うか、APIキーを入力してください。&quot;); return; }
  setErr(&quot;&quot;);
  var btn=$(&quot;analyzeBtn&quot;); btn.disabled=true; btn.innerHTML='<span class=&quot;pulse&quot;>🎤</span> 生成中…';
  fetch(&quot;https://api.anthropic.com/v1/messages&quot;,{
    method:&quot;POST&quot;,
    headers:{ &quot;Content-Type&quot;:&quot;application/json&quot;,&quot;anthropic-version&quot;:&quot;2023-06-01&quot;,&quot;anthropic-dangerous-direct-browser-access&quot;:&quot;true&quot;,&quot;x-api-key&quot;:key },
    body:JSON.stringify({ model:&quot;claude-sonnet-4-5&quot;, max_tokens:4000, system:SYSTEM_PROMPT, messages:[{role:&quot;user&quot;,content:buildUserMsg()}] })
  }).then(function(res){ return res.json().then(function(data){ return {ok:res.ok,status:res.status,data:data}; }); })
   .then(function(r){
     if(!r.ok || r.data.error) throw new Error((r.data.error&amp;&amp;r.data.error.message)||(&quot;HTTP &quot;+r.status));
     var raw=(r.data.content||[]).map(function(c){return c.text||&quot;&quot;;}).join(&quot;&quot;);
     var m=raw.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりませんでした&quot;);
     result=JSON.parse(m[0]); setTab(&quot;result&quot;);
   }).catch(function(e){ setErr(&quot;生成に失敗しました: &quot;+e.message+&quot;（CORSやAPIキーをご確認ください。手動コピーも使えます）&quot;); })
   .then(function(){ btn.disabled=false; btn.innerHTML=&quot;🎤 進行プランを生成する&quot;; });
}
function importJson(){
  setErr(&quot;&quot;);
  try{ var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}

var SUBTABS=[[&quot;agenda&quot;,&quot;🎤 進行台本&quot;],[&quot;prompts&quot;,&quot;💬 問いかけ集&quot;],[&quot;roles&quot;,&quot;🧩 役割分担&quot;],[&quot;wrapup&quot;,&quot;✅ まとめ方&quot;]];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBTABS.forEach(function(p){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===p[0]?&quot; active&quot;:&quot;&quot;); b.textContent=p[1];
    b.onclick=function(){ viewTab=p[0]; renderResult(); };
    st.appendChild(b);
  });
  var vw=$(&quot;resultView&quot;); vw.innerHTML=renderView();
  [].slice.call(vw.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); }); });
}
function rcard(inner){ return '<div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;agenda&quot;) return viewAgenda();
  if(viewTab===&quot;prompts&quot;) return viewPrompts();
  if(viewTab===&quot;roles&quot;) return viewRoles();
  if(viewTab===&quot;wrapup&quot;) return viewWrapup();
  return &quot;&quot;;
}
function viewAgenda(){
  var arr=result.agenda||[];
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#f6f2d6;font-weight:700;&quot;>🎤 進行台本</h3>';
  if(!arr.length) return h+rcard('<p style=&quot;color:#6d7d66;font-size:12px;&quot;>データがありません</p>');
  arr.forEach(function(a,i){
    h+=rcard('<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;&quot;>'+
      '<span style=&quot;font-weight:800;font-size:13px;color:#f6f2d6;&quot;>'+(i+1)+'. '+esc(a.phase||&quot;&quot;)+'</span>'+
      '<span style=&quot;background:rgba(240,235,200,.14);border:1px solid rgba(240,235,200,.3);border-radius:20px;padding:2px 10px;font-size:11px;color:#f6f2d6;&quot;>'+esc(String(a.min||&quot;-&quot;))+'分</span></div>'+
      (a.purpose?'<p style=&quot;margin:0 0 6px;font-size:11px;color:#a9bba2;&quot;>🎯 '+esc(a.purpose)+'</p>':'')+
      '<div style=&quot;white-space:pre-wrap;font-size:13px;color:#f3f6ee;line-height:1.85;&quot;>'+esc(a.script||&quot;&quot;)+'</div>');
  });
  return h;
}
function viewPrompts(){
  var arr=result.prompts||[];
  var txt=arr.map(function(p,i){return (i+1)+&quot;. &quot;+p;}).join(&quot;\n&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#f6f2d6;font-weight:700;&quot;>💬 問いかけ集</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(txt)+'&quot; style=&quot;background:rgba(90,168,106,.2);border:1px solid #5aa86a;border-radius:8px;padding:5px 13px;color:#9cdca8;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  if(!arr.length) return h+rcard('<p style=&quot;color:#6d7d66;font-size:12px;&quot;>データがありません</p>');
  h+='<div class=&quot;card&quot;>';
  arr.forEach(function(p){ h+='<div style=&quot;display:flex;gap:8px;margin:7px 0;&quot;><span style=&quot;color:#86c98e;&quot;>💬</span><span style=&quot;font-size:13px;color:#f3f6ee;&quot;>'+esc(p)+'</span></div>'; });
  h+='</div>';
  return h;
}
function viewRoles(){
  var arr=result.roles||[];
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#f6f2d6;font-weight:700;&quot;>🧩 役割分担</h3>';
  if(!arr.length) return h+rcard('<p style=&quot;color:#6d7d66;font-size:12px;&quot;>データがありません</p>');
  arr.forEach(function(r){
    h+=rcard('<div style=&quot;font-weight:800;font-size:13px;color:#f6f2d6;margin-bottom:4px;&quot;>'+esc(r.role||&quot;&quot;)+'</div><div style=&quot;font-size:12px;color:#c7d4bf;&quot;>'+esc(r.task||&quot;&quot;)+'</div>');
  });
  return h;
}
function viewWrapup(){
  var w=result.wrapup||{};
  var ck=(w.checklist||[]).map(function(c){return '<div style=&quot;display:flex;gap:8px;align-items:center;margin:5px 0;&quot;><div style=&quot;width:14px;height:14px;border:2px solid #86c98e;border-radius:4px;flex:0 0 14px;&quot;></div><span style=&quot;font-size:12px;color:#f3f6ee;&quot;>'+esc(c)+'</span></div>';}).join(&quot;&quot;);
  var h='<h3 style=&quot;margin:0 0 12px;font-size:15px;color:#f6f2d6;font-weight:700;&quot;>✅ まとめ方（結論・決めたこと・宿題）</h3>';
  h+=rcard((w.how?'<p style=&quot;margin:0 0 12px;font-size:13px;color:#f3f6ee;line-height:1.85;&quot;>'+esc(w.how)+'</p>':'')+
    (ck?'<p style=&quot;margin:0 0 6px;font-size:11px;font-weight:700;color:#a9bba2;&quot;>締めのチェックリスト</p>'+ck:''))+
    rcard('<p style=&quot;margin:0;font-size:12px;color:#a9bba2;&quot;>👉 そのまま「✅ 結論・宿題シート」タブで記録できます。</p>');
  return h;
}

/* ===== タイマー ===== */
var T_PHASES=[
  {key:&quot;intro&quot;, icon:&quot;🚪&quot;, name:&quot;導入&quot;, sub:&quot;目的とゴールの共有&quot;, min:5},
  {key:&quot;ice&quot;, icon:&quot;🤝&quot;, name:&quot;アイスブレイク&quot;, sub:&quot;発言しやすい空気づくり&quot;, min:5},
  {key:&quot;discuss&quot;, icon:&quot;💬&quot;, name:&quot;議論&quot;, sub:&quot;本題・意見出し&quot;, min:15},
  {key:&quot;wrap&quot;, icon:&quot;✅&quot;, name:&quot;まとめ&quot;, sub:&quot;結論・決めたこと・宿題&quot;, min:5}
];
var T_PRESETS={ std:[5,5,15,5], retro:[3,4,15,8], brain:[5,15,7,3] };
var timer={ running:false, idx:-1, remain:0, intervalId:null };
function renderPhaseList(){
  var box=$(&quot;phaseList&quot;); box.innerHTML=&quot;&quot;;
  T_PHASES.forEach(function(p,i){
    var row=document.createElement(&quot;div&quot;);
    row.className=&quot;prow&quot;+(i===timer.idx?&quot; active&quot;:&quot;&quot;)+(timer.idx>i?&quot; done&quot;:&quot;&quot;); row.id=&quot;prow_&quot;+i;
    row.innerHTML='<span class=&quot;pi&quot;>'+p.icon+'</span><span class=&quot;pn&quot;>'+p.name+'</span><span class=&quot;pd&quot;>'+p.sub+'</span><span><input type=&quot;number&quot; min=&quot;0&quot; max=&quot;120&quot; value=&quot;'+p.min+'&quot;><span style=&quot;font-size:.74rem;color:#a9bba2;&quot;> 分</span></span>';
    box.appendChild(row);
    (function(idx){ row.querySelector(&quot;input&quot;).addEventListener(&quot;change&quot;, function(){ onMinChange(idx,this.value); }); })(i);
  });
  updateTotal();
}
function onMinChange(i,val){ var n=parseInt(val,10); if(isNaN(n)||n<0)n=0; if(n>120)n=120; T_PHASES[i].min=n; renderPhaseList(); if(!timer.running&amp;&amp;timer.idx<0) updateDisplay(); }
function totalMin(){ return T_PHASES.reduce(function(a,p){return a+p.min;},0); }
function updateTotal(){ var t=totalMin(); var el=$(&quot;totalMin&quot;); if(el){ el.textContent=t+&quot;分&quot;; el.style.color=(t>0?&quot;#f6f2d6&quot;:&quot;#f4c451&quot;); } }
function applyPreset(name){ var arr=T_PRESETS[name]; if(!arr)return; T_PHASES.forEach(function(p,i){p.min=arr[i];}); renderPhaseList(); if(!timer.running) resetTimer(true); toast(&quot;配分を適用（合計&quot;+totalMin()+&quot;分）&quot;); }
var audioCtx=null;
function beep(times){
  if(!$(&quot;optSound&quot;).checked) return;
  try{ if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)();
    var n=times||1;
    for(var i=0;i<n;i++){ var t=audioCtx.currentTime+i*0.18; var o=audioCtx.createOscillator(), g=audioCtx.createGain();
      o.frequency.value=880; o.type=&quot;sine&quot;; g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(0.25,t+0.02); g.gain.exponentialRampToValueAtTime(0.0001,t+0.16);
      o.connect(g); g.connect(audioCtx.destination); o.start(t); o.stop(t+0.17); }
  }catch(e){}
}
function totalRemainSec(){ var s=0; if(timer.idx<0){ s=totalMin()*60; } else { s=timer.remain; for(var i=timer.idx+1;i<T_PHASES.length;i++){ s+=T_PHASES[i].min*60; } } return s; }
function updateDisplay(){
  var clock=$(&quot;clockBig&quot;);
  if(timer.idx<0){ $(&quot;phaseName&quot;).textContent=&quot;準備OK&quot;; $(&quot;phaseSub&quot;).textContent=&quot;開始ボタンで最初のフェーズが始まります&quot;; clock.textContent=fmt(totalMin()*60); clock.classList.remove(&quot;warn&quot;); $(&quot;progBar&quot;).style.width=&quot;0%&quot;; }
  else { var p=T_PHASES[timer.idx]; $(&quot;phaseName&quot;).textContent=p.icon+&quot; &quot;+p.name+&quot;（&quot;+(timer.idx+1)+&quot;/&quot;+T_PHASES.length+&quot;）&quot;; $(&quot;phaseSub&quot;).textContent=p.sub; clock.textContent=fmt(timer.remain); clock.classList.toggle(&quot;warn&quot;, timer.remain<=10); var pt=p.min*60||1; $(&quot;progBar&quot;).style.width=Math.min(100,Math.max(0,(pt-timer.remain)/pt*100))+&quot;%&quot;; }
  $(&quot;totalLine&quot;).textContent=&quot;全体の残り：&quot;+fmt(totalRemainSec())+&quot; / &quot;+fmt(totalMin()*60);
  T_PHASES.forEach(function(p,i){ var row=$(&quot;prow_&quot;+i); if(row){ row.classList.toggle(&quot;active&quot;, i===timer.idx); row.classList.toggle(&quot;done&quot;, timer.idx>i); } });
}
function allRestZero(from){ for(var i=from;i<T_PHASES.length;i++){ if(T_PHASES[i].min>0) return false; } return true; }
function enterPhase(i){ while(i<T_PHASES.length &amp;&amp; T_PHASES[i].min<=0){ i++; } if(i>=T_PHASES.length){ finishAll(); return; } timer.idx=i; timer.remain=T_PHASES[i].min*60; updateDisplay(); }
function tick(){ if(!timer.running) return; timer.remain--; if(timer.remain<=0){ beep(timer.idx>=T_PHASES.length-1?3:2); var nx=timer.idx+1; if(nx>=T_PHASES.length||allRestZero(nx)){ finishAll(); return; } enterPhase(nx); } else { updateDisplay(); } }
function startTimer(){ if(totalMin()<=0){ toast(&quot;分数を設定してください&quot;); return; } if(timer.idx<0) enterPhase(0); timer.running=true; $(&quot;startBtn&quot;).style.display=&quot;none&quot;; $(&quot;pauseBtn&quot;).style.display=&quot;inline-block&quot;; clearInterval(timer.intervalId); timer.intervalId=setInterval(tick,1000); try{ if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)(); if(audioCtx.state===&quot;suspended&quot;) audioCtx.resume(); }catch(e){} updateDisplay(); }
function pauseTimer(){ timer.running=false; clearInterval(timer.intervalId); $(&quot;startBtn&quot;).style.display=&quot;inline-block&quot;; $(&quot;startBtn&quot;).textContent=&quot;▶ 再開&quot;; $(&quot;pauseBtn&quot;).style.display=&quot;none&quot;; }
function skipPhase(){ if(timer.idx<0){ enterPhase(0); return; } beep(1); var nx=timer.idx+1; if(nx>=T_PHASES.length||allRestZero(nx)){ finishAll(); return; } enterPhase(nx); }
function finishAll(){ timer.running=false; clearInterval(timer.intervalId); timer.idx=T_PHASES.length; $(&quot;phaseName&quot;).textContent=&quot;🎉 終了！&quot;; $(&quot;phaseSub&quot;).textContent=&quot;議論おつかれさまでした。結論・宿題シートへ&quot;; $(&quot;clockBig&quot;).textContent=&quot;00:00&quot;; $(&quot;clockBig&quot;).classList.remove(&quot;warn&quot;); $(&quot;progBar&quot;).style.width=&quot;100%&quot;; $(&quot;totalLine&quot;).textContent=&quot;全体の残り：00:00 / &quot;+fmt(totalMin()*60); $(&quot;startBtn&quot;).style.display=&quot;inline-block&quot;; $(&quot;startBtn&quot;).textContent=&quot;▶ 開始&quot;; $(&quot;pauseBtn&quot;).style.display=&quot;none&quot;; T_PHASES.forEach(function(p,i){ var row=$(&quot;prow_&quot;+i); if(row){ row.classList.remove(&quot;active&quot;); row.classList.add(&quot;done&quot;); } }); beep(3); }
function resetTimer(silent){ timer.running=false; clearInterval(timer.intervalId); timer.idx=-1; timer.remain=0; $(&quot;startBtn&quot;).style.display=&quot;inline-block&quot;; $(&quot;startBtn&quot;).textContent=&quot;▶ 開始&quot;; $(&quot;pauseBtn&quot;).style.display=&quot;none&quot;; renderPhaseList(); updateDisplay(); if(!silent) toast(&quot;リセットしました&quot;); }

/* ===== 結論・宿題シート（学級だより風） ===== */
function buildSheet(){
  var topic=v(&quot;s_topic&quot;)||&quot;（議題未入力）&quot;;
  var decided=lines(v(&quot;s_decided&quot;)), hw=lines(v(&quot;s_homework&quot;));
  var m=[];
  m.push(&quot;# 🏫 議論まとめ &quot;+nowParts().date);
  m.push(&quot;&quot;);
  m.push(&quot;## 🗣 議題&quot;);
  m.push(topic);
  m.push(&quot;&quot;);
  m.push(&quot;## 🎯 結論&quot;);
  m.push(&quot;> &quot;+(v(&quot;s_concl&quot;)||&quot;（結論未入力）&quot;));
  m.push(&quot;&quot;);
  m.push(&quot;## ✅ 決めたこと&quot;);
  if(decided.length){ decided.forEach(function(x){ m.push(&quot;- &quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;);
  m.push(&quot;## 📚 宿題・次回までにやること&quot;);
  if(hw.length){
    m.push(&quot;| やること | 担当 | 期限 |&quot;);
    m.push(&quot;|---|---|---|&quot;);
    hw.forEach(function(x){ var c=cols(x,3); m.push(&quot;| &quot;+(c[0]||&quot;&quot;)+&quot; | &quot;+(c[1]||&quot;—&quot;)+&quot; | &quot;+(c[2]||&quot;—&quot;)+&quot; |&quot;); });
  } else { m.push(&quot;- （宿題なし）&quot;); }
  m.push(&quot;&quot;);
  if(v(&quot;s_next&quot;)){ m.push(&quot;## ➡ 次回の議題&quot;); m.push(v(&quot;s_next&quot;)); m.push(&quot;&quot;); }
  m.push(&quot;---&quot;);
  m.push(&quot;記録：石黒 友季子&quot;);
  showOut(m.join(&quot;\n&quot;));
  toast(&quot;まとめシートを作りました&quot;);
}

/* ===== タブ切替 ===== */
function setTab(t){
  [&quot;input&quot;,&quot;result&quot;,&quot;timer&quot;,&quot;sheet&quot;].forEach(function(x){
    var btn=$(&quot;tt-&quot;+x), view=$(&quot;view-&quot;+x);
    if(btn) btn.classList.toggle(&quot;active&quot;, x===t);
    if(view) view.style.display=(x===t?&quot;block&quot;:&quot;none&quot;);
  });
  if(t===&quot;result&quot;) renderResult();
}

/* ===== init ===== */
(function(){
  renderTags();
  renderPhaseList(); updateDisplay();
  setTab(&quot;input&quot;);
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-exam" title="試験クイズAPIなし" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 試験・クイズ作成ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#2a1228,#3a163a 55%,#28122a);color:#f3e8f0;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(190,90,160,.5);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.88}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.05);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.09);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#b48ca8;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(190,90,160,.22);border-bottom:2px solid #c45a9c;color:#e8a3d0;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#b48ca8;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(190,90,160,.34);border:1px solid #c45a9c;color:#e8a3d0;}
  label{display:block;font-size:12px;font-weight:700;color:#ccb0c4;margin-bottom:6px;}
  textarea,input[type=password],select{width:100%;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.12);
    border-radius:8px;padding:10px 12px;color:#f3e8f0;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#c45a9c,#8c2f6a);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>📝</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#e8a3d0,#c45a9c);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>試験・クイズ作成ジェネレーター</h1>
      <p style=&quot;margin:0;font-size:11px;color:#b48ca8;&quot; id=&quot;subtitle&quot;>【APIキーなし版】完全オフライン。手動プロンプト→AIに貼付→JSON取り込み</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 入力</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>📊 問題</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0;font-size:12px;color:#ccb0c4;line-height:1.7;&quot;>💡 レベル目安（うさうさ式3段階）：<b style=&quot;color:#e8a3d0;&quot;>Lv.1＝用語を思い出せる / Lv.3＝業務の文脈で説明できる / Lv.5＝トラブル対応・応用ができる</b></p>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #c45a9c;&quot;>
        <label>🏫 クラス</label>
        <select id=&quot;f_class&quot;><option value=&quot;基礎クラス&quot;>基礎クラス</option><option value=&quot;応用クラス&quot;>応用クラス</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #bf5a9c;&quot;>
        <label>🎓 受講生の背景</label>
        <select id=&quot;f_back&quot;><option value=&quot;文系・新卒&quot;>文系・新卒</option><option value=&quot;理系・新卒&quot;>理系・新卒</option><option value=&quot;文系・第二新卒&quot;>文系・第二新卒</option><option value=&quot;理系・第二新卒&quot;>理系・第二新卒</option><option value=&quot;混在&quot;>混在クラス</option></select>
      </div>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #b85a9a;&quot;>
        <label>📊 到達レベル</label>
        <select id=&quot;f_level&quot;><option value=&quot;Lv.1（記憶・用語）&quot;>Lv.1（記憶・用語が言える）</option><option value=&quot;Lv.3（業務文脈で説明）&quot; selected>Lv.3（業務文脈で説明できる）</option><option value=&quot;Lv.5（トラブル対応・応用）&quot;>Lv.5（トラブル対応・応用できる）</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #b05a98;&quot;>
        <label>📚 テーマ・単元</label>
        <input id=&quot;f_topic&quot; placeholder=&quot;例：Linuxのファイルパーミッション（chmod）&quot;>
      </div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>📝 補足（含めたい観点・難易度調整・出題数など・任意）</label>
      <textarea id=&quot;f_note&quot; placeholder=&quot;文系新卒なので専門用語はかみくだいて。クイズは3問、筆記は記述2問＋穴埋め1問にしたい。&quot;></textarea>
    </div>

    

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#ccb0c4;&quot;>🛠 使い方（3ステップ）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#8a6f82;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(190,90,160,.2);border:1px solid #c45a9c;border-radius:8px;padding:7px 14px;color:#e8a3d0;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:7px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで問題を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#ccb0c4;&quot;>✨ 生成される3形式</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#7a5a72;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>📝</div>
      <p>「入力」タブでテーマを入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:14px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;metaLine&quot; style=&quot;font-size:11px;color:#b48ca8;margin-bottom:14px;&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「IT研修の試験・クイズ作成者」です。受講生の到達度を測る問題を、クラス・背景・レベルに合わせて作ります。
レベル定義（うさうさ式3段階）：Lv.1＝用語や定義を思い出せる。Lv.3＝業務の文脈で自分の言葉で説明できる。Lv.5＝トラブル対応や応用ができる。
方針：背景（文系/理系・新卒/第二新卒）に応じて言葉づかいと前提知識を調整する（文系・新卒には専門用語をかみくだく）。基礎クラスは素直な確認中心、応用クラスはひねり・実務適用を含める。個人名・会社名は出さない。
ユーザーの条件（クラス/背景/レベル/テーマ/補足）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;meta&quot;: {&quot;class&quot;: &quot;クラス&quot;, &quot;background&quot;: &quot;背景&quot;, &quot;level&quot;: &quot;レベル&quot;, &quot;topic&quot;: &quot;テーマ&quot;},
  &quot;oral&quot;: [
    {&quot;q&quot;: &quot;口頭試問の問い&quot;, &quot;model&quot;: &quot;模範解答（要点）&quot;, &quot;followup&quot;: &quot;理解を深掘りする追加質問&quot;}
  ],
  &quot;written&quot;: [
    {&quot;type&quot;: &quot;記述 or 穴埋め&quot;, &quot;q&quot;: &quot;筆記問題文&quot;, &quot;points&quot;: 10, &quot;rubric&quot;: &quot;採点ポイント・正答の要素&quot;}
  ],
  &quot;quiz&quot;: [
    {&quot;q&quot;: &quot;3択クイズの問題文&quot;, &quot;choices&quot;: [&quot;選択肢A&quot;, &quot;選択肢B&quot;, &quot;選択肢C&quot;], &quot;answer&quot;: 0, &quot;explain&quot;: &quot;なぜそれが正解かの短い解説&quot;}
  ]
}
注意：quizのanswerは正解の選択肢の番号（0始まり）。oralは2〜3問、writtenは2〜3問、quizは3問程度。レベルが上がるほど応用・実務寄りにする。`;

var FIELD_TAGS=[&quot;🗣 口頭試問&quot;,&quot;📝 筆記試験&quot;,&quot;⚡ プチ理解度クイズ&quot;];
var result=null, tab=&quot;input&quot;, viewTab=&quot;oral&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }
function readForm(){
  return { cls:$(&quot;f_class&quot;).value, back:$(&quot;f_back&quot;).value, level:$(&quot;f_level&quot;).value,
    topic:($(&quot;f_topic&quot;).value||&quot;&quot;).trim(), note:($(&quot;f_note&quot;).value||&quot;&quot;).trim() };
}
function buildUserMsg(){
  var f=readForm();
  return [&quot;## 試験・クイズの条件&quot;,
    &quot;【クラス】&quot;+f.cls,
    &quot;【受講生の背景】&quot;+f.back,
    &quot;【到達レベル】&quot;+f.level,
    &quot;【テーマ・単元】&quot;+(f.topic||&quot;未入力&quot;),
    &quot;【補足】&quot;+(f.note||&quot;なし&quot;)].join(&quot;\n&quot;);
}

function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(190,90,160,.16);border:1px solid rgba(190,90,160,.32);border-radius:20px;padding:3px 11px;font-size:11px;color:#e8a3d0;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}

function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}

function importJson(){
  setErr(&quot;&quot;);
  try{
    var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}

function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function copyBtn(btn, text){ copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000); }

var SUBTABS=[[&quot;oral&quot;,&quot;🗣 口頭試問&quot;],[&quot;written&quot;,&quot;📝 筆記試験&quot;],[&quot;quiz&quot;,&quot;⚡ クイズ&quot;]];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBTABS.forEach(function(p){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===p[0]?&quot; active&quot;:&quot;&quot;); b.textContent=p[1];
    b.onclick=function(){ viewTab=p[0]; renderResult(); };
    st.appendChild(b);
  });
  var meta=result.meta||{};
  $(&quot;metaLine&quot;).textContent=[meta.class,meta.background,meta.level,meta.topic].filter(Boolean).join(&quot;　/　&quot;);
  var v=$(&quot;resultView&quot;); v.innerHTML=renderView();
  [].slice.call(v.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); }); });
  [].slice.call(v.querySelectorAll(&quot;[data-reveal]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ var t=document.getElementById(b.getAttribute(&quot;data-reveal&quot;)); if(t) t.style.display=(t.style.display===&quot;none&quot;?&quot;block&quot;:&quot;none&quot;); }); });
}
function card(inner){ return '<div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;oral&quot;) return viewOral();
  if(viewTab===&quot;written&quot;) return viewWritten();
  if(viewTab===&quot;quiz&quot;) return viewQuiz();
  return &quot;&quot;;
}
function copyAllText(kind){
  if(kind===&quot;oral&quot;){ return (result.oral||[]).map(function(o,i){ return &quot;口頭試問&quot;+(i+1)+&quot;：&quot;+(o.q||&quot;&quot;)+&quot;\n模範解答：&quot;+(o.model||&quot;&quot;)+(o.followup?(&quot;\n深掘り：&quot;+o.followup):&quot;&quot;); }).join(&quot;\n\n&quot;); }
  if(kind===&quot;written&quot;){ return (result.written||[]).map(function(w,i){ return &quot;問&quot;+(i+1)+&quot;（&quot;+(w.type||&quot;&quot;)+&quot;・&quot;+(w.points||&quot;&quot;)+&quot;点）：&quot;+(w.q||&quot;&quot;)+&quot;\n採点ポイント：&quot;+(w.rubric||&quot;&quot;); }).join(&quot;\n\n&quot;); }
  if(kind===&quot;quiz&quot;){ return (result.quiz||[]).map(function(q,i){ var ch=(q.choices||[]).map(function(c,j){return &quot;  &quot;+String.fromCharCode(65+j)+&quot;. &quot;+c;}).join(&quot;\n&quot;); return &quot;Q&quot;+(i+1)+&quot;：&quot;+(q.q||&quot;&quot;)+&quot;\n&quot;+ch+&quot;\n正解：&quot;+String.fromCharCode(65+(q.answer||0))+&quot;／&quot;+(q.explain||&quot;&quot;); }).join(&quot;\n\n&quot;); }
  return &quot;&quot;;
}
function viewOral(){
  var arr=result.oral||[];
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#ccb0c4;font-weight:700;&quot;>🗣 口頭試問</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(copyAllText(&quot;oral&quot;))+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 まとめてコピー</button></div>';
  if(!arr.length) return h+card('<p style=&quot;color:#7a5a72;font-size:12px;&quot;>データがありません</p>');
  arr.forEach(function(o,i){
    var aid=&quot;oral_&quot;+i;
    h+=card('<p style=&quot;margin:0 0 8px;font-size:13px;color:#f3e8f0;font-weight:700;&quot;>Q'+(i+1)+'. '+esc(o.q||&quot;&quot;)+'</p>'+
      '<button class=&quot;btn&quot; data-reveal=&quot;'+aid+'&quot; style=&quot;background:rgba(190,90,160,.2);border:1px solid #c45a9c;border-radius:8px;padding:5px 12px;color:#e8a3d0;font-size:11px;cursor:pointer;font-weight:600;&quot;>💡 模範解答を見る</button>'+
      '<div id=&quot;'+aid+'&quot; style=&quot;display:none;margin-top:8px;&quot;>'+
      '<div style=&quot;padding:10px;background:rgba(31,157,107,.12);border-left:3px solid #1f9d6b;border-radius:6px;font-size:13px;color:#7fd9b3;&quot;>✅ '+esc(o.model||&quot;&quot;)+'</div>'+
      (o.followup?'<div style=&quot;margin-top:6px;font-size:12px;color:#b48ca8;&quot;>↪ 深掘り：'+esc(o.followup)+'</div>':'')+'</div>');
  });
  return h;
}
function viewWritten(){
  var arr=result.written||[];
  var total=arr.reduce(function(a,w){ var p=parseFloat(w.points); return a+(isNaN(p)?0:p); },0);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#ccb0c4;font-weight:700;&quot;>📝 筆記試験'+(total>0?'（計'+total+'点）':'')+'</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(copyAllText(&quot;written&quot;))+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 まとめてコピー</button></div>';
  if(!arr.length) return h+card('<p style=&quot;color:#7a5a72;font-size:12px;&quot;>データがありません</p>');
  arr.forEach(function(w,i){
    var rid=&quot;rub_&quot;+i;
    h+=card('<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;&quot;>'+
      '<span style=&quot;background:rgba(190,90,160,.18);border:1px solid rgba(190,90,160,.34);border-radius:20px;padding:2px 10px;font-size:11px;color:#e8a3d0;&quot;>'+esc(w.type||&quot;問題&quot;)+(w.points?'・'+esc(String(w.points))+'点':'')+'</span></div>'+
      '<p style=&quot;margin:0 0 8px;font-size:13px;color:#f3e8f0;font-weight:700;&quot;>問'+(i+1)+'. '+esc(w.q||&quot;&quot;)+'</p>'+
      '<button class=&quot;btn&quot; data-reveal=&quot;'+rid+'&quot; style=&quot;background:rgba(190,90,160,.2);border:1px solid #c45a9c;border-radius:8px;padding:5px 12px;color:#e8a3d0;font-size:11px;cursor:pointer;font-weight:600;&quot;>📑 採点ポイントを見る</button>'+
      '<div id=&quot;'+rid+'&quot; style=&quot;display:none;margin-top:8px;padding:10px;background:rgba(31,157,107,.12);border-left:3px solid #1f9d6b;border-radius:6px;font-size:12px;color:#7fd9b3;&quot;>'+esc(w.rubric||&quot;&quot;)+'</div>');
  });
  return h;
}
function viewQuiz(){
  var arr=result.quiz||[];
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#ccb0c4;font-weight:700;&quot;>⚡ プチ理解度クイズ</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(copyAllText(&quot;quiz&quot;))+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 まとめてコピー</button></div>';
  if(!arr.length) return h+card('<p style=&quot;color:#7a5a72;font-size:12px;&quot;>データがありません</p>');
  arr.forEach(function(q,i){
    var aid=&quot;quiz_&quot;+i;
    var choices=(q.choices||[]).map(function(c,j){ return '<div style=&quot;padding:7px 10px;margin:4px 0;background:rgba(0,0,0,.18);border-radius:7px;font-size:12px;color:#f3e8f0;&quot;>'+String.fromCharCode(65+j)+'. '+esc(c)+'</div>'; }).join(&quot;&quot;);
    var ans=String.fromCharCode(65+(typeof q.answer===&quot;number&quot;?q.answer:0));
    h+=card('<p style=&quot;margin:0 0 8px;font-size:13px;color:#f3e8f0;font-weight:700;&quot;>Q'+(i+1)+'. '+esc(q.q||&quot;&quot;)+'</p>'+choices+
      '<button class=&quot;btn&quot; data-reveal=&quot;'+aid+'&quot; style=&quot;margin-top:6px;background:rgba(190,90,160,.2);border:1px solid #c45a9c;border-radius:8px;padding:5px 12px;color:#e8a3d0;font-size:11px;cursor:pointer;font-weight:600;&quot;>💡 正解・解説を見る</button>'+
      '<div id=&quot;'+aid+'&quot; style=&quot;display:none;margin-top:8px;padding:10px;background:rgba(31,157,107,.12);border-left:3px solid #1f9d6b;border-radius:6px;font-size:13px;color:#7fd9b3;&quot;>正解：'+ans+'　'+esc(q.explain||&quot;&quot;)+'</div>');
  });
  return h;
}

renderTags();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-examapi" title="試験クイズAPIあり" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 試験・クイズ作成ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#2a1228,#3a163a 55%,#28122a);color:#f3e8f0;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(190,90,160,.5);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.88}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.05);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.09);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#b48ca8;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(190,90,160,.22);border-bottom:2px solid #c45a9c;color:#e8a3d0;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#b48ca8;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(190,90,160,.34);border:1px solid #c45a9c;color:#e8a3d0;}
  label{display:block;font-size:12px;font-weight:700;color:#ccb0c4;margin-bottom:6px;}
  textarea,input[type=password],select{width:100%;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.12);
    border-radius:8px;padding:10px 12px;color:#f3e8f0;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#c45a9c,#8c2f6a);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>📝</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#e8a3d0,#c45a9c);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>試験・クイズ作成ジェネレーター</h1>
      <p style=&quot;margin:0;font-size:11px;color:#b48ca8;&quot; id=&quot;subtitle&quot;>【APIキー版】キーを入れると、口頭試問・筆記試験・クイズを自動生成します</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 入力</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>📊 問題</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0;font-size:12px;color:#ccb0c4;line-height:1.7;&quot;>💡 レベル目安（うさうさ式3段階）：<b style=&quot;color:#e8a3d0;&quot;>Lv.1＝用語を思い出せる / Lv.3＝業務の文脈で説明できる / Lv.5＝トラブル対応・応用ができる</b></p>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #c45a9c;&quot;>
        <label>🏫 クラス</label>
        <select id=&quot;f_class&quot;><option value=&quot;基礎クラス&quot;>基礎クラス</option><option value=&quot;応用クラス&quot;>応用クラス</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #bf5a9c;&quot;>
        <label>🎓 受講生の背景</label>
        <select id=&quot;f_back&quot;><option value=&quot;文系・新卒&quot;>文系・新卒</option><option value=&quot;理系・新卒&quot;>理系・新卒</option><option value=&quot;文系・第二新卒&quot;>文系・第二新卒</option><option value=&quot;理系・第二新卒&quot;>理系・第二新卒</option><option value=&quot;混在&quot;>混在クラス</option></select>
      </div>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #b85a9a;&quot;>
        <label>📊 到達レベル</label>
        <select id=&quot;f_level&quot;><option value=&quot;Lv.1（記憶・用語）&quot;>Lv.1（記憶・用語が言える）</option><option value=&quot;Lv.3（業務文脈で説明）&quot; selected>Lv.3（業務文脈で説明できる）</option><option value=&quot;Lv.5（トラブル対応・応用）&quot;>Lv.5（トラブル対応・応用できる）</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #b05a98;&quot;>
        <label>📚 テーマ・単元</label>
        <input id=&quot;f_topic&quot; placeholder=&quot;例：Linuxのファイルパーミッション（chmod）&quot;>
      </div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>📝 補足（含めたい観点・難易度調整・出題数など・任意）</label>
      <textarea id=&quot;f_note&quot; placeholder=&quot;文系新卒なので専門用語はかみくだいて。クイズは3問、筆記は記述2問＋穴埋め1問にしたい。&quot;></textarea>
    </div>

    <div class=&quot;card&quot; id=&quot;apiKeyCard&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>🔑 Anthropic APIキー（任意・入れると自動生成）</label>
      <input type=&quot;password&quot; id=&quot;apiKey&quot; placeholder=&quot;sk-ant-... （未入力なら下の手動コピーを使用）&quot;>
      <p style=&quot;margin:6px 0 0;font-size:10px;color:#8a6f82;&quot;>※キーはこの画面内だけで使われ、保存も外部送信もされません（Anthropic API以外には送りません）。</p>
    </div>

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    <button class=&quot;btn&quot; id=&quot;analyzeBtn&quot; onclick=&quot;handleAnalyze()&quot; style=&quot;width:100%;padding:15px;background:linear-gradient(135deg,#8c2f6a,#6a1f50);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;&quot;>📝 試験・クイズを生成する</button>

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#ccb0c4;&quot;>🛠 APIキーがない場合（手動）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#8a6f82;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(190,90,160,.2);border:1px solid #c45a9c;border-radius:8px;padding:7px 14px;color:#e8a3d0;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:7px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで問題を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#ccb0c4;&quot;>✨ 生成される3形式</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#7a5a72;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>📝</div>
      <p>「入力」タブでテーマを入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:14px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;metaLine&quot; style=&quot;font-size:11px;color:#b48ca8;margin-bottom:14px;&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「IT研修の試験・クイズ作成者」です。受講生の到達度を測る問題を、クラス・背景・レベルに合わせて作ります。
レベル定義（うさうさ式3段階）：Lv.1＝用語や定義を思い出せる。Lv.3＝業務の文脈で自分の言葉で説明できる。Lv.5＝トラブル対応や応用ができる。
方針：背景（文系/理系・新卒/第二新卒）に応じて言葉づかいと前提知識を調整する（文系・新卒には専門用語をかみくだく）。基礎クラスは素直な確認中心、応用クラスはひねり・実務適用を含める。個人名・会社名は出さない。
ユーザーの条件（クラス/背景/レベル/テーマ/補足）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;meta&quot;: {&quot;class&quot;: &quot;クラス&quot;, &quot;background&quot;: &quot;背景&quot;, &quot;level&quot;: &quot;レベル&quot;, &quot;topic&quot;: &quot;テーマ&quot;},
  &quot;oral&quot;: [
    {&quot;q&quot;: &quot;口頭試問の問い&quot;, &quot;model&quot;: &quot;模範解答（要点）&quot;, &quot;followup&quot;: &quot;理解を深掘りする追加質問&quot;}
  ],
  &quot;written&quot;: [
    {&quot;type&quot;: &quot;記述 or 穴埋め&quot;, &quot;q&quot;: &quot;筆記問題文&quot;, &quot;points&quot;: 10, &quot;rubric&quot;: &quot;採点ポイント・正答の要素&quot;}
  ],
  &quot;quiz&quot;: [
    {&quot;q&quot;: &quot;3択クイズの問題文&quot;, &quot;choices&quot;: [&quot;選択肢A&quot;, &quot;選択肢B&quot;, &quot;選択肢C&quot;], &quot;answer&quot;: 0, &quot;explain&quot;: &quot;なぜそれが正解かの短い解説&quot;}
  ]
}
注意：quizのanswerは正解の選択肢の番号（0始まり）。oralは2〜3問、writtenは2〜3問、quizは3問程度。レベルが上がるほど応用・実務寄りにする。`;

var FIELD_TAGS=[&quot;🗣 口頭試問&quot;,&quot;📝 筆記試験&quot;,&quot;⚡ プチ理解度クイズ&quot;];
var result=null, tab=&quot;input&quot;, viewTab=&quot;oral&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }
function readForm(){
  return { cls:$(&quot;f_class&quot;).value, back:$(&quot;f_back&quot;).value, level:$(&quot;f_level&quot;).value,
    topic:($(&quot;f_topic&quot;).value||&quot;&quot;).trim(), note:($(&quot;f_note&quot;).value||&quot;&quot;).trim() };
}
function buildUserMsg(){
  var f=readForm();
  return [&quot;## 試験・クイズの条件&quot;,
    &quot;【クラス】&quot;+f.cls,
    &quot;【受講生の背景】&quot;+f.back,
    &quot;【到達レベル】&quot;+f.level,
    &quot;【テーマ・単元】&quot;+(f.topic||&quot;未入力&quot;),
    &quot;【補足】&quot;+(f.note||&quot;なし&quot;)].join(&quot;\n&quot;);
}

function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(190,90,160,.16);border:1px solid rgba(190,90,160,.32);border-radius:20px;padding:3px 11px;font-size:11px;color:#e8a3d0;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}

function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}

function handleAnalyze(){
  var f=readForm();
  if(!f.topic){ setErr(&quot;「テーマ・単元」を入力してください&quot;); return; }
  var key=$(&quot;apiKey&quot;)?$(&quot;apiKey&quot;).value.trim():&quot;&quot;;
  if(!key){ setErr(&quot;APIキーが未入力です。下の「手動プロンプトをコピー」を使うか、APIキーを入力してください。&quot;); return; }
  setErr(&quot;&quot;);
  var btn=$(&quot;analyzeBtn&quot;); btn.disabled=true; btn.innerHTML='<span class=&quot;pulse&quot;>📝</span> 生成中…';
  fetch(&quot;https://api.anthropic.com/v1/messages&quot;,{
    method:&quot;POST&quot;,
    headers:{ &quot;Content-Type&quot;:&quot;application/json&quot;,&quot;anthropic-version&quot;:&quot;2023-06-01&quot;,&quot;anthropic-dangerous-direct-browser-access&quot;:&quot;true&quot;,&quot;x-api-key&quot;:key },
    body:JSON.stringify({ model:&quot;claude-sonnet-4-5&quot;, max_tokens:4000, system:SYSTEM_PROMPT, messages:[{role:&quot;user&quot;,content:buildUserMsg()}] })
  }).then(function(res){ return res.json().then(function(data){ return {ok:res.ok,status:res.status,data:data}; }); })
   .then(function(r){
     if(!r.ok || r.data.error) throw new Error((r.data.error&amp;&amp;r.data.error.message)||(&quot;HTTP &quot;+r.status));
     var raw=(r.data.content||[]).map(function(c){return c.text||&quot;&quot;;}).join(&quot;&quot;);
     var m=raw.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりませんでした&quot;);
     result=JSON.parse(m[0]); setTab(&quot;result&quot;);
   }).catch(function(e){ setErr(&quot;生成に失敗しました: &quot;+e.message+&quot;（CORSやAPIキーをご確認ください。手動コピーも使えます）&quot;); })
   .then(function(){ btn.disabled=false; btn.innerHTML=&quot;📝 試験・クイズを生成する&quot;; });
}

function importJson(){
  setErr(&quot;&quot;);
  try{
    var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}

function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function copyBtn(btn, text){ copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000); }

var SUBTABS=[[&quot;oral&quot;,&quot;🗣 口頭試問&quot;],[&quot;written&quot;,&quot;📝 筆記試験&quot;],[&quot;quiz&quot;,&quot;⚡ クイズ&quot;]];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBTABS.forEach(function(p){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===p[0]?&quot; active&quot;:&quot;&quot;); b.textContent=p[1];
    b.onclick=function(){ viewTab=p[0]; renderResult(); };
    st.appendChild(b);
  });
  var meta=result.meta||{};
  $(&quot;metaLine&quot;).textContent=[meta.class,meta.background,meta.level,meta.topic].filter(Boolean).join(&quot;　/　&quot;);
  var v=$(&quot;resultView&quot;); v.innerHTML=renderView();
  [].slice.call(v.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); }); });
  [].slice.call(v.querySelectorAll(&quot;[data-reveal]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ var t=document.getElementById(b.getAttribute(&quot;data-reveal&quot;)); if(t) t.style.display=(t.style.display===&quot;none&quot;?&quot;block&quot;:&quot;none&quot;); }); });
}
function card(inner){ return '<div class=&quot;card&quot; style=&quot;margin-bottom:12px;&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;oral&quot;) return viewOral();
  if(viewTab===&quot;written&quot;) return viewWritten();
  if(viewTab===&quot;quiz&quot;) return viewQuiz();
  return &quot;&quot;;
}
function copyAllText(kind){
  if(kind===&quot;oral&quot;){ return (result.oral||[]).map(function(o,i){ return &quot;口頭試問&quot;+(i+1)+&quot;：&quot;+(o.q||&quot;&quot;)+&quot;\n模範解答：&quot;+(o.model||&quot;&quot;)+(o.followup?(&quot;\n深掘り：&quot;+o.followup):&quot;&quot;); }).join(&quot;\n\n&quot;); }
  if(kind===&quot;written&quot;){ return (result.written||[]).map(function(w,i){ return &quot;問&quot;+(i+1)+&quot;（&quot;+(w.type||&quot;&quot;)+&quot;・&quot;+(w.points||&quot;&quot;)+&quot;点）：&quot;+(w.q||&quot;&quot;)+&quot;\n採点ポイント：&quot;+(w.rubric||&quot;&quot;); }).join(&quot;\n\n&quot;); }
  if(kind===&quot;quiz&quot;){ return (result.quiz||[]).map(function(q,i){ var ch=(q.choices||[]).map(function(c,j){return &quot;  &quot;+String.fromCharCode(65+j)+&quot;. &quot;+c;}).join(&quot;\n&quot;); return &quot;Q&quot;+(i+1)+&quot;：&quot;+(q.q||&quot;&quot;)+&quot;\n&quot;+ch+&quot;\n正解：&quot;+String.fromCharCode(65+(q.answer||0))+&quot;／&quot;+(q.explain||&quot;&quot;); }).join(&quot;\n\n&quot;); }
  return &quot;&quot;;
}
function viewOral(){
  var arr=result.oral||[];
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#ccb0c4;font-weight:700;&quot;>🗣 口頭試問</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(copyAllText(&quot;oral&quot;))+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 まとめてコピー</button></div>';
  if(!arr.length) return h+card('<p style=&quot;color:#7a5a72;font-size:12px;&quot;>データがありません</p>');
  arr.forEach(function(o,i){
    var aid=&quot;oral_&quot;+i;
    h+=card('<p style=&quot;margin:0 0 8px;font-size:13px;color:#f3e8f0;font-weight:700;&quot;>Q'+(i+1)+'. '+esc(o.q||&quot;&quot;)+'</p>'+
      '<button class=&quot;btn&quot; data-reveal=&quot;'+aid+'&quot; style=&quot;background:rgba(190,90,160,.2);border:1px solid #c45a9c;border-radius:8px;padding:5px 12px;color:#e8a3d0;font-size:11px;cursor:pointer;font-weight:600;&quot;>💡 模範解答を見る</button>'+
      '<div id=&quot;'+aid+'&quot; style=&quot;display:none;margin-top:8px;&quot;>'+
      '<div style=&quot;padding:10px;background:rgba(31,157,107,.12);border-left:3px solid #1f9d6b;border-radius:6px;font-size:13px;color:#7fd9b3;&quot;>✅ '+esc(o.model||&quot;&quot;)+'</div>'+
      (o.followup?'<div style=&quot;margin-top:6px;font-size:12px;color:#b48ca8;&quot;>↪ 深掘り：'+esc(o.followup)+'</div>':'')+'</div>');
  });
  return h;
}
function viewWritten(){
  var arr=result.written||[];
  var total=arr.reduce(function(a,w){ var p=parseFloat(w.points); return a+(isNaN(p)?0:p); },0);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#ccb0c4;font-weight:700;&quot;>📝 筆記試験'+(total>0?'（計'+total+'点）':'')+'</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(copyAllText(&quot;written&quot;))+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 まとめてコピー</button></div>';
  if(!arr.length) return h+card('<p style=&quot;color:#7a5a72;font-size:12px;&quot;>データがありません</p>');
  arr.forEach(function(w,i){
    var rid=&quot;rub_&quot;+i;
    h+=card('<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;&quot;>'+
      '<span style=&quot;background:rgba(190,90,160,.18);border:1px solid rgba(190,90,160,.34);border-radius:20px;padding:2px 10px;font-size:11px;color:#e8a3d0;&quot;>'+esc(w.type||&quot;問題&quot;)+(w.points?'・'+esc(String(w.points))+'点':'')+'</span></div>'+
      '<p style=&quot;margin:0 0 8px;font-size:13px;color:#f3e8f0;font-weight:700;&quot;>問'+(i+1)+'. '+esc(w.q||&quot;&quot;)+'</p>'+
      '<button class=&quot;btn&quot; data-reveal=&quot;'+rid+'&quot; style=&quot;background:rgba(190,90,160,.2);border:1px solid #c45a9c;border-radius:8px;padding:5px 12px;color:#e8a3d0;font-size:11px;cursor:pointer;font-weight:600;&quot;>📑 採点ポイントを見る</button>'+
      '<div id=&quot;'+rid+'&quot; style=&quot;display:none;margin-top:8px;padding:10px;background:rgba(31,157,107,.12);border-left:3px solid #1f9d6b;border-radius:6px;font-size:12px;color:#7fd9b3;&quot;>'+esc(w.rubric||&quot;&quot;)+'</div>');
  });
  return h;
}
function viewQuiz(){
  var arr=result.quiz||[];
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#ccb0c4;font-weight:700;&quot;>⚡ プチ理解度クイズ</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(copyAllText(&quot;quiz&quot;))+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 まとめてコピー</button></div>';
  if(!arr.length) return h+card('<p style=&quot;color:#7a5a72;font-size:12px;&quot;>データがありません</p>');
  arr.forEach(function(q,i){
    var aid=&quot;quiz_&quot;+i;
    var choices=(q.choices||[]).map(function(c,j){ return '<div style=&quot;padding:7px 10px;margin:4px 0;background:rgba(0,0,0,.18);border-radius:7px;font-size:12px;color:#f3e8f0;&quot;>'+String.fromCharCode(65+j)+'. '+esc(c)+'</div>'; }).join(&quot;&quot;);
    var ans=String.fromCharCode(65+(typeof q.answer===&quot;number&quot;?q.answer:0));
    h+=card('<p style=&quot;margin:0 0 8px;font-size:13px;color:#f3e8f0;font-weight:700;&quot;>Q'+(i+1)+'. '+esc(q.q||&quot;&quot;)+'</p>'+choices+
      '<button class=&quot;btn&quot; data-reveal=&quot;'+aid+'&quot; style=&quot;margin-top:6px;background:rgba(190,90,160,.2);border:1px solid #c45a9c;border-radius:8px;padding:5px 12px;color:#e8a3d0;font-size:11px;cursor:pointer;font-weight:600;&quot;>💡 正解・解説を見る</button>'+
      '<div id=&quot;'+aid+'&quot; style=&quot;display:none;margin-top:8px;padding:10px;background:rgba(31,157,107,.12);border-left:3px solid #1f9d6b;border-radius:6px;font-size:13px;color:#7fd9b3;&quot;>正解：'+ans+'　'+esc(q.explain||&quot;&quot;)+'</div>');
  });
  return h;
}

renderTags();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-zenn" title="Zenn風記事テンプレ" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ Zenn風 記事テンプレジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  :root{ --radius:12px; }
  body.theme-jp{
    --paper:#ffffff; --bg:#f1f5fb; --bg2:#e9f1fb; --ink:#1a2733; --ink-soft:#5a6b7b;
    --line:#dbe6f2; --line-soft:#eaf2fb; --ok:#16a34a; --ng:#dc4b46;
    --accent:#3ea8ff; --accent-deep:#1f7fe0; --accent-soft:#e3f1ff;
    --shadow:0 1px 3px rgba(26,39,51,.05),0 6px 20px rgba(26,39,51,.06);
  }
  body{margin:0;font-family:&quot;Hiragino Sans&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;color:var(--ink);
    background:var(--bg);min-height:100vh;line-height:1.7;}
  .wrap{max-width:1000px;margin:0 auto;padding:18px 16px 80px;}
  header.hero{position:relative;margin-top:20px;background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:22px 26px;box-shadow:var(--shadow);}
  header.hero h1{margin:0 0 4px;font-size:1.22rem;font-weight:800;display:flex;align-items:center;gap:9px;}
  header.hero h1 .ic{width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:1rem;}
  header.hero p{margin:0;color:var(--ink-soft);font-size:.88rem;}
  .ver-badge{display:flex;gap:8px;align-items:center;margin:6px 0 0;flex-wrap:wrap;}
  .ver-pill{display:inline-block;background:var(--accent);color:#fff;font-weight:700;font-size:.7rem;padding:2px 9px;border-radius:999px;}
  .ver-date,.ver-today{color:var(--ink-soft);font-size:.72rem;}
  .ver-today:not(:empty)::before{content:&quot;｜ 今日 &quot;;opacity:.8;}
  .bunny{position:absolute;top:18px;right:22px;font-size:24px;}
  .lang-switch{display:none;}
  .tabs{display:flex;gap:6px;margin:16px 0;flex-wrap:wrap;}
  .tab{flex:1 1 auto;min-width:150px;text-align:center;cursor:pointer;border:1px solid var(--line);background:var(--paper);border-radius:10px;padding:9px 11px;font-weight:700;font-size:.85rem;color:var(--ink-soft);transition:all .12s;}
  .tab:hover{border-color:var(--accent);color:var(--accent);}
  .tab.active{background:var(--accent);color:#fff;border-color:var(--accent);box-shadow:0 2px 8px rgba(62,168,255,.3);}
  .panel{display:none;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:22px;box-shadow:var(--shadow);}
  .panel.active{display:block;}
  h2{font-size:1.05rem;margin:0 0 6px;}
  h3{font-size:.92rem;margin:16px 0 6px;color:var(--accent-deep);}
  label{display:block;font-size:.78rem;font-weight:700;color:var(--ink-soft);margin:8px 0 3px;}
  input,select,textarea{width:100%;border:1px solid var(--line);border-radius:8px;padding:9px 11px;font-size:.9rem;font-family:inherit;color:var(--ink);background:var(--paper);transition:border .12s,box-shadow .12s;}
  input:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft);}
  textarea{min-height:60px;resize:vertical;}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
  .hint{font-size:.77rem;color:var(--ink-soft);margin:4px 0 0;}
  code{background:var(--bg2);padding:1px 5px;border-radius:5px;font-size:.85em;}
  .howto{background:var(--accent-soft);border:1px solid #cfe6ff;border-left:4px solid var(--accent);border-radius:10px;padding:10px 14px;margin:0 0 14px;font-size:.83rem;color:#1c5a9c;}
  .howto b{color:var(--accent-deep);}
  .howto ol{margin:6px 0 0;padding-left:20px;}
  .howto li{margin:2px 0;}
  .sec{border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin:10px 0;background:var(--bg);}
  .sec h3{margin:0 0 6px;}
  button{transition:transform .08s,box-shadow .12s,filter .12s,background .12s;}
  .gen{margin-top:18px;width:100%;background:var(--accent);color:#fff;border:none;border-radius:10px;padding:13px;font-size:.98rem;font-weight:800;cursor:pointer;box-shadow:0 2px 8px rgba(62,168,255,.3);}
  .gen:hover{background:var(--accent-deep);transform:translateY(-1px);}
  .gen:active{transform:translateY(1px) scale(.99);}
  .addbtn{margin-top:8px;background:var(--accent-soft);border:1px solid #cfe6ff;color:var(--accent-deep);border-radius:8px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.83rem;}
  .addbtn:hover{transform:translateY(-1px);background:#dbecff;}
  .addbtn:active{transform:translateY(1px) scale(.99);}
  .del{background:#fff;border:1px solid var(--line);color:var(--ng);border-radius:7px;padding:6px 9px;cursor:pointer;font-weight:700;}
  .row{display:flex;gap:8px;align-items:flex-start;margin:6px 0;}
  .row>*{margin:0;}
  .outwrap{margin-top:18px;background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:14px;}
  .outwrap h3{margin-top:0;}
  pre.out{white-space:pre-wrap;word-break:break-word;background:var(--paper);border:1px solid var(--line);border-radius:9px;padding:12px;font-size:.85rem;max-height:480px;overflow:auto;font-family:&quot;SF Mono&quot;,&quot;Consolas&quot;,monospace;}
  .outbtns{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
  .outbtns button{border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:9px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.83rem;}
  .outbtns button:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-1px);}
  .outbtns button:active{transform:translateY(1px) scale(.99);}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:999px;font-size:.85rem;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50;}
  .toast.show{opacity:.96;}
  @media (max-width:560px){ .grid,.grid3{grid-template-columns:1fr;} }
  /* スニペット集 */
  .snip-bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px;}
  .snip-seg{display:inline-flex;border:1px solid var(--line);border-radius:9px;overflow:hidden;}
  .snip-seg button{border:none;background:var(--paper);color:var(--ink-soft);padding:8px 16px;font-weight:700;font-size:.85rem;cursor:pointer;}
  .snip-seg button.on{background:var(--accent);color:#fff;}
  .snip{border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin:10px 0;background:var(--bg);}
  .snip-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:7px;}
  .snip-title{font-weight:800;font-size:.9rem;color:var(--ink);}
  .snip-tag{font-size:.68rem;font-weight:700;padding:2px 8px;border-radius:999px;margin-left:8px;}
  .snip-tag.both{background:#e8f5e9;color:#1f7d3f;}
  .snip-tag.zenn{background:#e3f1ff;color:#1f7fe0;}
  .snip-tag.qiita{background:#e9f7e0;color:#4c9a2a;}
  .snip-desc{font-size:.76rem;color:var(--ink-soft);margin-bottom:7px;}
  .snip-code{white-space:pre-wrap;word-break:break-word;background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:10px;font-size:.82rem;font-family:&quot;SF Mono&quot;,&quot;Consolas&quot;,monospace;color:var(--ink);}
  .snip-copy{border:1px solid var(--accent);background:var(--accent-soft);color:var(--accent-deep);border-radius:8px;padding:6px 13px;font-weight:700;font-size:.78rem;cursor:pointer;white-space:nowrap;}
  .snip-copy:hover{background:#dbecff;transform:translateY(-1px);}
  .snip-copy:active{transform:translateY(1px) scale(.99);}
</style>
</head>
<body class=&quot;theme-jp&quot;>
<div class=&quot;wrap&quot;>
  <header class=&quot;hero&quot;>
    <div class=&quot;bunny&quot;>🐰</div>
    <h1><span class=&quot;ic&quot;>✍️</span> うさうさ Zenn風 記事テンプレジェネレーター</h1>
    <p>コミュニティ限定記事を、整ったMarkdownで生成します。①やってよかったこと型 ②気づき・次に活かせること型。データは端末内のみ・外部送信なし。</p>
    <div class=&quot;ver-badge&quot;><span class=&quot;ver-pill&quot;>v1.0</span><span class=&quot;ver-date&quot;>2026-05-22</span><span class=&quot;ver-today&quot; id=&quot;ver_today&quot;></span></div>
  </header>

  <div class=&quot;tabs&quot; id=&quot;tabs&quot;>
    <div class=&quot;tab active&quot; data-tab=&quot;good&quot;>⭐ やってよかったこと記事</div>
    <div class=&quot;tab&quot; data-tab=&quot;learn&quot;>💡 気づき・次に活かせること記事</div>
    <div class=&quot;tab&quot; data-tab=&quot;meta&quot;>🧾 メタ情報だけ</div>
    <div class=&quot;tab&quot; data-tab=&quot;header&quot;>🏷 Qiita/Zenn 投稿ヘッダー</div>
    <div class=&quot;tab&quot; data-tab=&quot;snippets&quot;>📚 記法スニペット集</div>
  </div>

  <!-- 共通メタ情報（両記事で使用） -->
  <div class=&quot;panel active&quot; id=&quot;panel-good&quot;>
    <h2>⭐ やってよかったこと記事</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>各欄を埋める（〇〇△△のまま残してもOK。後でZenn上で直せます）</li>
      <li>「記事Markdownを生成する」で、貼り付けられる記事ができます</li>
      <li>会社名は出さず、チーム名・役職名でOK。「ALJ流」という表現は使えます</li>
    </ol></div>

    <div class=&quot;sec&quot;><h3>🧾 メタ情報</h3>
      <div class=&quot;grid&quot;><div><label>記事タイトル</label><input id=&quot;g_title&quot; placeholder=&quot;Markdown運用に切り替えてよかったこと&quot;></div>
      <div><label>著者 / チーム名</label><input id=&quot;g_author&quot; placeholder=&quot;石黒 友季子 / 研修チーム&quot;></div></div>
      <div class=&quot;grid3&quot;><div><label>公開日</label><input id=&quot;g_date&quot; placeholder=&quot;2026-05-22&quot;></div>
      <div><label>読了時間（分）</label><input id=&quot;g_read&quot; placeholder=&quot;5&quot;></div>
      <div><label>タグ（スペース区切り）</label><input id=&quot;g_tags&quot; placeholder=&quot;markdown ツール 生産性&quot;></div></div>
    </div>

    <div class=&quot;sec&quot;><h3>🎯 対象読者</h3>
      <div><label>この記事は誰向けか</label><input id=&quot;g_for&quot; placeholder=&quot;ドキュメント運用に課題を感じているチーム&quot;></div>
      <div class=&quot;grid&quot;><div><label>向いている人（1行ずつ）</label><textarea id=&quot;g_fit&quot; placeholder=&quot;〇〇に課題を感じているエンジニア&amp;#10;〇〇導入を迷っているリーダー&quot;></textarea></div>
      <div><label>向いていない人（1行ずつ）</label><textarea id=&quot;g_unfit&quot; placeholder=&quot;すでに〇〇を使いこなしている方&quot;></textarea></div></div>
    </div>

    <div class=&quot;sec&quot;><h3>📝 書いた背景（課題）</h3>
      <div><label>抱えていた課題（✗で始まる課題・1行ずつ）</label><textarea id=&quot;g_problems&quot; placeholder=&quot;〇〇が毎回手間で時間がかかっていた&amp;#10;ツールがバラバラで情報が散在していた&amp;#10;レビューのたびにフォーマット指摘が来ていた&quot;></textarea></div>
    </div>

    <div class=&quot;sec&quot;><h3>✅ これを読むと解決できること（1行ずつ）</h3>
      <div><textarea id=&quot;g_solve&quot; placeholder=&quot;〇〇の手間を60分→20分に短縮できる&amp;#10;ドキュメントのフォーマット統一ができる&amp;#10;Gitとの連携でレビューが楽になる&quot;></textarea></div>
      <div><label>ひとことまとめ</label><input id=&quot;g_oneline&quot; placeholder=&quot;〇〇に悩んでいるなら、まず△△だけ試してみてください&quot;></div>
    </div>

    <div class=&quot;sec&quot;><h3>🛠 やったこと・やってよかったこと</h3>
      <div><label>取り組み（「タイトル｜何をしたか｜なぜよかったか」を1行ずつ）</label><textarea id=&quot;g_did&quot; placeholder=&quot;Markdown運用｜△△の運用をMarkdownに切替｜書くハードルが下がりレビューが速くなった&amp;#10;CIでlint｜フォーマットを自動チェック｜人によるばらつきが消えた&quot;></textarea></div>
      <div class=&quot;grid&quot;><div><label>Before（1行ずつ）</label><textarea id=&quot;g_before&quot; placeholder=&quot;ファイルが複数バージョンあって混乱&amp;#10;フォーマットが人によってバラバラ&quot;></textarea></div>
      <div><label>After（1行ずつ）</label><textarea id=&quot;g_after&quot; placeholder=&quot;単一ファイルでバージョン管理&amp;#10;CIでlintをかけてフォーマット統一&quot;></textarea></div></div>
    </div>

    <div class=&quot;sec&quot;><h3>📊 数字で見る効果（「指標｜導入前｜導入後」を1行ずつ）</h3>
      <div><textarea id=&quot;g_numbers&quot; placeholder=&quot;ドキュメント作成時間｜60分｜20分&amp;#10;フォーマット指摘件数/月｜15件｜2件&amp;#10;オンボーディング時間｜2日｜半日&quot;></textarea></div>
    </div>

    <div class=&quot;sec&quot;><h3>⚠️ 注意点・ハマったこと（「ハマりポイント｜対応策」を1行ずつ）</h3>
      <div><textarea id=&quot;g_traps&quot; placeholder=&quot;レンダリングがツールで違う｜〇〇を使うと統一できた&amp;#10;表の書き方を覚えるのが地味にしんどい｜VSCode拡張が便利&quot;></textarea></div>
    </div>

    <div class=&quot;sec&quot;><h3>🐰 まとめ</h3>
      <div><label>やってよかった理由（3行・1行ずつ）</label><textarea id=&quot;g_sum&quot; placeholder=&quot;〇〇が改善した&amp;#10;△△が楽になった&amp;#10;チーム全体の生産性が上がった&quot;></textarea></div>
      <div><label>一番伝えたいこと</label><input id=&quot;g_key&quot; placeholder=&quot;〇〇は完璧ではないが、□□な状況なら確実に効果がある&quot;></div>
      <div><label>次のアクション（1行ずつ）</label><textarea id=&quot;g_next&quot; placeholder=&quot;〇〇を手元で試してみる（所要5分）&amp;#10;チームにSlackでシェアする&quot;></textarea></div>
    </div>
    <button class=&quot;gen&quot; onclick=&quot;buildGood()&quot;>記事Markdownを生成する</button>
  </div>

  <!-- 気づき記事 -->
  <div class=&quot;panel&quot; id=&quot;panel-learn&quot;>
    <h2>💡 気づき・次に活かせること記事</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>「失敗」ではなく「見えていなかったこと」として前向きに整理する型です</li>
      <li>各欄を埋めて「記事Markdownを生成する」</li>
      <li>会社名・個人名（自社/他社）は出さず、役職名・チーム名で書きましょう</li>
    </ol></div>

    <div class=&quot;sec&quot;><h3>🧾 メタ情報</h3>
      <div class=&quot;grid&quot;><div><label>記事タイトル</label><input id=&quot;l_title&quot; placeholder=&quot;リリース対応で気づいたこと・次に活かせること&quot;></div>
      <div><label>著者 / チーム名</label><input id=&quot;l_author&quot; placeholder=&quot;石黒 友季子 / 研修チーム&quot;></div></div>
      <div class=&quot;grid3&quot;><div><label>公開日</label><input id=&quot;l_date&quot; placeholder=&quot;2026-05-22&quot;></div>
      <div><label>読了時間（分）</label><input id=&quot;l_read&quot; placeholder=&quot;6&quot;></div>
      <div><label>タグ（スペース区切り）</label><input id=&quot;l_tags&quot; placeholder=&quot;振り返り 改善 ノウハウ&quot;></div></div>
    </div>

    <div class=&quot;sec&quot;><h3>📝 書いた背景</h3>
      <div><label>どんな状況だったか</label><input id=&quot;l_bg&quot; placeholder=&quot;〇〇プロジェクトで△△の対応をしていたとき、想定と異なる展開になった&quot;></div>
      <div><label>当時の状況（1行ずつ）</label><textarea id=&quot;l_situation&quot; placeholder=&quot;〇〇を前提に設計を進めていた&amp;#10;チェックを△△のタイミングで行っていた&amp;#10;〇〇は後回しにしていた&quot;></textarea></div>
      <div><label>結果として起きたこと</label><input id=&quot;l_result&quot; placeholder=&quot;□□が起きた&quot;></div>
    </div>

    <div class=&quot;sec&quot;><h3>📖 これを読むと得られること（1行ずつ）</h3>
      <div><textarea id=&quot;l_gain&quot; placeholder=&quot;〇〇の落とし穴を事前に知ることができる&amp;#10;△△の確認タイミングの判断基準がわかる&amp;#10;同じ状況で迷わず動ける&quot;></textarea></div>
    </div>

    <div class=&quot;sec&quot;><h3>🔍 何が起きたか（タイムライン：「時期｜出来事」を1行ずつ）</h3>
      <div><textarea id=&quot;l_timeline&quot; placeholder=&quot;〇月〇日｜〇〇を開始。△△を前提に進める&amp;#10;〇月〇日｜□□の兆候に気づく&amp;#10;〇月〇日｜原因を特定。〇〇が根本と判明&amp;#10;〇月〇日｜対応完了。振り返り開始&quot;></textarea></div>
    </div>

    <div class=&quot;sec&quot;><h3>🪞 見えていなかった点（「見出し｜当時の判断｜実際には｜次に活かすなら」を1行ずつ）</h3>
      <div><textarea id=&quot;l_blind&quot; placeholder=&quot;前提確認｜問題ないと見ていた｜△△の条件が加わっていた｜△△の有無を最初に確認する&amp;#10;確認タイミング｜後でまとめて確認すればよいと判断｜手戻りコストが大きくなった｜段階ごとにチェックポイントを設ける&quot;></textarea></div>
      <p class=&quot;hint&quot;>「悪かった」ではなく「見えていなかった」として前向きに整理します。</p>
    </div>

    <div class=&quot;sec&quot;><h3>🔧 対応した内容・結果</h3>
      <div><label>取った対応（1行ずつ）</label><textarea id=&quot;l_action&quot; placeholder=&quot;〇〇の状態を確認し□□を特定&amp;#10;△△チームと連携して暫定対応&amp;#10;根本対応として〇〇のフローを見直し&quot;></textarea></div>
      <div><label>結果（「✅ or ⚠️｜内容」を1行ずつ）</label><textarea id=&quot;l_outcome&quot; placeholder=&quot;✅｜〇〇は解消した&amp;#10;✅｜再発防止の仕組みができた&amp;#10;⚠️｜□□は引き続き観察中&quot;></textarea></div>
    </div>

    <div class=&quot;sec&quot;><h3>🤝 チームに提案したこと（「提案｜状態」を1行ずつ）</h3>
      <div><textarea id=&quot;l_propose&quot; placeholder=&quot;〇〇チェックをオンボーディングに追加｜✅採用&amp;#10;△△ドキュメントを更新｜🔄対応中&amp;#10;□□をチームで議論｜📅次回MTG&quot;></textarea></div>
    </div>

    <div class=&quot;sec&quot;><h3>💡 まとめ</h3>
      <div><label>一番伝えたいこと</label><input id=&quot;l_key&quot; placeholder=&quot;△△の確認を先に行うだけで結果が大きく変わる&quot;></div>
      <div><label>同じ状況になったら</label><input id=&quot;l_same&quot; placeholder=&quot;まず□□を確認してから進める&quot;></div>
      <div><label>次のアクション（1行ずつ）</label><textarea id=&quot;l_next&quot; placeholder=&quot;確認フローを自分のチームに当てはめてみる&amp;#10;似た経験を #知見共有 にコメント&quot;></textarea></div>
    </div>
    <button class=&quot;gen&quot; onclick=&quot;buildLearn()&quot;>記事Markdownを生成する</button>
  </div>

  <!-- メタ情報だけ -->
  <div class=&quot;panel&quot; id=&quot;panel-meta&quot;>
    <h2>🧾 メタ情報ブロックだけ生成</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>記事冒頭に貼る「メタ情報テーブル」だけを作ります</li>
      <li>複数記事で使い回せます</li>
    </ol></div>
    <div class=&quot;grid&quot;><div><label>著者 / チーム名</label><input id=&quot;m_author&quot; placeholder=&quot;石黒 友季子 / 研修チーム&quot;></div>
    <div><label>公開日</label><input id=&quot;m_date&quot; placeholder=&quot;2026-05-22&quot;></div></div>
    <div class=&quot;grid3&quot;><div><label>最終更新</label><input id=&quot;m_update&quot; placeholder=&quot;2026-05-22&quot;></div>
    <div><label>読了時間（分）</label><input id=&quot;m_read&quot; placeholder=&quot;5&quot;></div>
    <div><label>本文字数（任意）</label><input id=&quot;m_chars&quot; placeholder=&quot;3000&quot;></div></div>
    <div class=&quot;grid&quot;><div><label>添付資料</label><select id=&quot;m_attach&quot;><option value=&quot;なし&quot;>なし</option><option value=&quot;あり&quot;>あり ✅</option></select></div>
    <div><label>タグ（スペース区切り）</label><input id=&quot;m_tags&quot; placeholder=&quot;markdown 振り返り 改善&quot;></div></div>
    <button class=&quot;gen&quot; onclick=&quot;buildMeta()&quot;>メタ情報を生成する</button>
  </div>

  <!-- Qiita/Zenn 投稿ヘッダー -->
  <div class=&quot;panel&quot; id=&quot;panel-header&quot;>
    <h2>🏷 Qiita / Zenn 投稿用ヘッダー</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>投稿先（Qiita / Zenn）を選び、タイトル・タグ・絵文字などを入れる</li>
      <li>「ヘッダーを生成する」で、記事の先頭に貼るFront Matter＋独自記法ひな形が出ます</li>
      <li>これを①②で作った本文の前に貼れば、そのまま投稿できます</li>
    </ol></div>
    <div class=&quot;grid&quot;>
      <div><label>投稿先</label><select id=&quot;h_platform&quot; onchange=&quot;onPlatformChange()&quot;><option value=&quot;zenn&quot;>Zenn</option><option value=&quot;qiita&quot;>Qiita</option></select></div>
      <div><label>記事タイトル</label><input id=&quot;h_title&quot; placeholder=&quot;Markdown運用にしてよかったこと&quot;></div>
    </div>
    <div class=&quot;grid&quot;>
      <div id=&quot;h_emoji_box&quot;><label>アイキャッチ絵文字（Zenn・1文字）</label><input id=&quot;h_emoji&quot; placeholder=&quot;🐰&quot; maxlength=&quot;4&quot;></div>
      <div id=&quot;h_type_box&quot;><label>記事タイプ（Zenn）</label><select id=&quot;h_type&quot;><option value=&quot;tech&quot;>tech（技術記事）</option><option value=&quot;idea&quot;>idea（アイデア・ポエム）</option></select></div>
    </div>
    <div><label>タグ（スペース区切り・最大5）<span id=&quot;h_tag_hint&quot; class=&quot;hint&quot; style=&quot;display:inline&quot;>／Zennは小文字推奨、Qiitaは先頭大文字慣習</span></label><input id=&quot;h_tags&quot; placeholder=&quot;linux markdown 生産性&quot;></div>
    <div class=&quot;grid&quot;>
      <div><label id=&quot;h_pub_label&quot;>公開状態</label><select id=&quot;h_pub&quot;><option value=&quot;public&quot;>公開する</option><option value=&quot;draft&quot;>下書き（非公開）</option></select></div>
      <div><label>独自記法のひな形を付ける</label><select id=&quot;h_snippets&quot;><option value=&quot;yes&quot;>付ける（message/note・details 等）</option><option value=&quot;no&quot;>付けない</option></select></div>
    </div>
    <button class=&quot;gen&quot; onclick=&quot;buildHeader()&quot;>ヘッダーを生成する</button>
    <p class=&quot;hint&quot; id=&quot;h_note&quot; style=&quot;margin-top:10px;&quot;></p>
  </div>

  <!-- 記法スニペット集 -->
  <div class=&quot;panel&quot; id=&quot;panel-snippets&quot;>
    <h2>🧩 Qiita / Zenn 記法スニペット集</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>投稿先（Zenn / Qiita）を選ぶと、その記法に合わせたスニペットが並びます</li>
      <li>各スニペットの「コピー」を押して、本文に貼り付けてください</li>
      <li>🟢共通＝どちらでも使える／🔵Zenn専用／🟢Qiita専用 のタグで区別できます</li>
    </ol></div>
    <div class=&quot;snip-bar&quot;>
      <span style=&quot;font-size:.82rem;font-weight:700;color:var(--ink-soft);&quot;>投稿先：</span>
      <div class=&quot;snip-seg&quot;>
        <button id=&quot;seg-zenn&quot; class=&quot;on&quot; onclick=&quot;setSnipPlatform('zenn')&quot;>Zenn</button>
        <button id=&quot;seg-qiita&quot; onclick=&quot;setSnipPlatform('qiita')&quot;>Qiita</button>
      </div>
    </div>
    <div id=&quot;snipList&quot;></div>
  </div>

  <div class=&quot;outwrap&quot;>
    <h3>生成結果（Markdown）</h3>
    <pre class=&quot;out&quot; id=&quot;out&quot;>ここに生成結果が表示されます。各タブの「生成する」を押してください。</pre>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;copyOut()&quot;>📋 コピー</button>
      <button onclick=&quot;downloadOut('md')&quot;>📝 Markdown保存</button>
      <button onclick=&quot;downloadOut('txt')&quot;>📄 テキスト保存</button>
      <button onclick=&quot;clearOut()&quot;>クリア</button>
    </div>
  </div>
</div>
<div class=&quot;toast&quot; id=&quot;toast&quot;></div>
<script>
&quot;use strict&quot;;
function $(id){ return document.getElementById(id); }
function v(id){ var el=$(id); return el?(el.value||&quot;&quot;).trim():&quot;&quot;; }
function lines(s){ return (s||&quot;&quot;).split(/\n+/).map(function(x){return x.trim();}).filter(Boolean); }
function cols(s,n){ var a=s.split(&quot;｜&quot;).map(function(x){return x.trim();}); while(a.length<n) a.push(&quot;&quot;); return a; }
function toast(m){ var t=$(&quot;toast&quot;); if(!t)return; t.textContent=m; t.classList.add(&quot;show&quot;); setTimeout(function(){t.classList.remove(&quot;show&quot;);},1600); }
function lsAvailable(){ try{ var k=&quot;__t&quot;+Math.random(); window.localStorage.setItem(k,&quot;1&quot;); window.localStorage.removeItem(k); return true; }catch(e){ return false; } }
function nowParts(){
  var d=new Date(), wd=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var mm=(&quot;0&quot;+(d.getMonth()+1)).slice(-2), dd=(&quot;0&quot;+d.getDate()).slice(-2);
  return { date:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;）&quot;, iso:d.getFullYear()+&quot;-&quot;+mm+&quot;-&quot;+dd };
}
function todayIso(){ return nowParts().iso; }
function stamp(){ return nowParts().iso.replace(/-/g,&quot;&quot;); }

var lastOut={txt:&quot;&quot;,md:&quot;&quot;};
function setOut(md){ lastOut.md=md||&quot;&quot;; lastOut.txt=md||&quot;&quot;; var o=$(&quot;out&quot;); if(o) o.textContent=lastOut.md; }
function clearOut(){ setOut(&quot;&quot;); var o=$(&quot;out&quot;); if(o) o.textContent=&quot;&quot;; toast(&quot;クリアしました&quot;); }
function copyOut(){
  var t=lastOut.md||&quot;&quot;; if(!t){ toast(&quot;生成結果がありません&quot;); return; }
  try{ navigator.clipboard.writeText(t); toast(&quot;コピーしました&quot;); }
  catch(e){ var ta=document.createElement(&quot;textarea&quot;); ta.value=t; document.body.appendChild(ta); ta.select(); try{document.execCommand(&quot;copy&quot;);}catch(_){} document.body.removeChild(ta); toast(&quot;コピーしました&quot;); }
}
function _saveBlob(text,fname,mime){
  try{ var blob=new Blob([text],{type:mime||&quot;text/plain;charset=utf-8&quot;}); var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=fname; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(url);},500); }catch(e){ toast(&quot;保存に失敗しました&quot;); }
}
function downloadOut(fmt){
  if(!lastOut.md){ toast(&quot;生成結果がありません&quot;); return; }
  var ext=(fmt===&quot;txt&quot;?&quot;txt&quot;:&quot;md&quot;);
  _saveBlob(lastOut.md,&quot;zenn_article_&quot;+stamp()+&quot;.&quot;+ext,(ext===&quot;md&quot;?&quot;text/markdown&quot;:&quot;text/plain&quot;)+&quot;;charset=utf-8&quot;);
}

function metaTable(author,date,update,read,chars,attach,tags){
  var m=[&quot;| 項目 | 内容 |&quot;,&quot;|---|---|&quot;];
  m.push(&quot;| 著者 | &quot;+(author||&quot;石黒 友季子&quot;)+&quot; |&quot;);
  m.push(&quot;| 公開日 | &quot;+(date||todayIso())+&quot; |&quot;);
  m.push(&quot;| 最終更新 | &quot;+(update||date||todayIso())+&quot; |&quot;);
  m.push(&quot;| 読了時間 | 約 &quot;+(read||&quot;〇&quot;)+&quot; 分&quot;+(chars?(&quot;（本文 &quot;+chars+&quot; 字）&quot;):&quot;&quot;)+&quot; |&quot;);
  m.push(&quot;| 添付資料 | &quot;+(attach===&quot;あり&quot;?&quot;あり ✅&quot;:&quot;なし&quot;)+&quot; |&quot;);
  if(tags){ m.push(&quot;| タグ | &quot;+tags.split(/\s+/).map(function(t){return &quot;#&quot;+t;}).join(&quot; &quot;)+&quot; |&quot;); }
  return m.join(&quot;\n&quot;);
}

/* ===== ① やってよかったこと記事 ===== */
function buildGood(){
  var title=v(&quot;g_title&quot;)||&quot;〇〇をやってよかったこと&quot;;
  var m=[];
  m.push(&quot;# &quot;+title);
  m.push(&quot;&quot;);
  m.push(metaTable(v(&quot;g_author&quot;), v(&quot;g_date&quot;), v(&quot;g_date&quot;), v(&quot;g_read&quot;), &quot;&quot;, &quot;&quot;, v(&quot;g_tags&quot;)));
  m.push(&quot;&quot;);
  m.push(&quot;## 対象読者&quot;);
  m.push(&quot;&quot;);
  if(v(&quot;g_for&quot;)) m.push(&quot;この記事は **&quot;+v(&quot;g_for&quot;)+&quot;** に向けて書いています。&quot;);
  m.push(&quot;&quot;);
  var fit=lines(v(&quot;g_fit&quot;)), unfit=lines(v(&quot;g_unfit&quot;));
  if(fit.length){ m.push(&quot;### 向いている人&quot;); fit.forEach(function(x){ m.push(&quot;- &quot;+x); }); m.push(&quot;&quot;); }
  if(unfit.length){ m.push(&quot;### 向いていない人&quot;); unfit.forEach(function(x){ m.push(&quot;- &quot;+x); }); m.push(&quot;&quot;); }
  m.push(&quot;## 書いた背景&quot;);
  m.push(&quot;&quot;);
  var probs=lines(v(&quot;g_problems&quot;));
  if(probs.length){ m.push(&quot;長らく次のような課題を抱えていました。&quot;); m.push(&quot;&quot;); probs.forEach(function(x){ m.push(&quot;- ✗ &quot;+x); }); m.push(&quot;&quot;); }
  m.push(&quot;そこで試してみたところ、想定以上に効果があったので記事にまとめます。&quot;);
  m.push(&quot;&quot;);
  var solve=lines(v(&quot;g_solve&quot;));
  if(solve.length){
    m.push(&quot;## これを読むと解決できること&quot;); m.push(&quot;&quot;);
    m.push(&quot;| # | 解決できること |&quot;); m.push(&quot;|---|---|&quot;);
    solve.forEach(function(x,i){ m.push(&quot;| &quot;+(i+1)+&quot; | &quot;+x+&quot; |&quot;); });
    m.push(&quot;&quot;);
  }
  if(v(&quot;g_oneline&quot;)){ m.push(&quot;> ひとことまとめ：&quot;+v(&quot;g_oneline&quot;)); m.push(&quot;&quot;); }
  m.push(&quot;## やったこと・やってよかったこと&quot;);
  m.push(&quot;&quot;);
  var did=lines(v(&quot;g_did&quot;));
  if(did.length){ did.forEach(function(x,i){ var c=cols(x,3); m.push(&quot;### &quot;+(i+1)+&quot;. &quot;+(c[0]||&quot;取り組み&quot;)); m.push(&quot;&quot;); if(c[1]){ m.push(&quot;**何をしたか**：&quot;+c[1]); m.push(&quot;&quot;); } if(c[2]){ m.push(&quot;**なぜよかったか**：&quot;+c[2]); m.push(&quot;&quot;); } }); }
  var bf=lines(v(&quot;g_before&quot;)), af=lines(v(&quot;g_after&quot;));
  if(bf.length||af.length){
    m.push(&quot;**Before / After**&quot;); m.push(&quot;&quot;); m.push(&quot;```&quot;);
    m.push(&quot;# Before&quot;); bf.forEach(function(x){ m.push(&quot;- &quot;+x); });
    m.push(&quot;&quot;); m.push(&quot;# After&quot;); af.forEach(function(x){ m.push(&quot;- &quot;+x); });
    m.push(&quot;```&quot;); m.push(&quot;&quot;);
  }
  var nums=lines(v(&quot;g_numbers&quot;));
  if(nums.length){
    m.push(&quot;## 数字で見る効果&quot;); m.push(&quot;&quot;);
    m.push(&quot;| 指標 | 導入前 | 導入後 |&quot;); m.push(&quot;|---|---|---|&quot;);
    nums.forEach(function(x){ var c=cols(x,3); m.push(&quot;| &quot;+c[0]+&quot; | &quot;+c[1]+&quot; | &quot;+c[2]+&quot; |&quot;); });
    m.push(&quot;&quot;);
  }
  var traps=lines(v(&quot;g_traps&quot;));
  if(traps.length){
    m.push(&quot;## 注意点・ハマったこと&quot;); m.push(&quot;&quot;);
    m.push(&quot;すべてが順調だったわけではありません。正直に書きます。&quot;); m.push(&quot;&quot;);
    traps.forEach(function(x){ var c=cols(x,2); m.push(&quot;- ⚠️ **&quot;+c[0]+&quot;**&quot;); if(c[1]) m.push(&quot;  - → 対応策：&quot;+c[1]); });
    m.push(&quot;&quot;);
  }
  m.push(&quot;## まとめ&quot;);
  m.push(&quot;&quot;);
  var sum=lines(v(&quot;g_sum&quot;));
  if(sum.length){ m.push(&quot;✅ やってよかった理由：&quot;); sum.forEach(function(x){ m.push(&quot;- &quot;+x); }); m.push(&quot;&quot;); }
  if(v(&quot;g_key&quot;)){ m.push(&quot;> 💡 一番伝えたいこと：&quot;+v(&quot;g_key&quot;)); m.push(&quot;&quot;); }
  var next=lines(v(&quot;g_next&quot;));
  if(next.length){ m.push(&quot;## 次のアクション&quot;); m.push(&quot;&quot;); next.forEach(function(x){ m.push(&quot;- [ ] &quot;+x); }); m.push(&quot;&quot;); }
  m.push(&quot;---&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;質問・指摘は気軽にどうぞ。こうした共有が次の人を助けます🐰&quot;);
  setOut(m.join(&quot;\n&quot;));
}

/* ===== ② 気づき・次に活かせること記事 ===== */
function buildLearn(){
  var title=v(&quot;l_title&quot;)||&quot;〇〇で気づいたこと・次に活かせること&quot;;
  var m=[];
  m.push(&quot;# &quot;+title);
  m.push(&quot;&quot;);
  m.push(metaTable(v(&quot;l_author&quot;), v(&quot;l_date&quot;), v(&quot;l_date&quot;), v(&quot;l_read&quot;), &quot;&quot;, &quot;&quot;, v(&quot;l_tags&quot;)));
  m.push(&quot;&quot;);
  m.push(&quot;## 書いた背景&quot;);
  m.push(&quot;&quot;);
  if(v(&quot;l_bg&quot;)) { m.push(v(&quot;l_bg&quot;)+&quot;。&quot;); m.push(&quot;&quot;); }
  var sit=lines(v(&quot;l_situation&quot;));
  if(sit.length){ m.push(&quot;当時の状況：&quot;); sit.forEach(function(x){ m.push(&quot;- &quot;+x); }); m.push(&quot;&quot;); }
  if(v(&quot;l_result&quot;)){ m.push(&quot;結果として **&quot;+v(&quot;l_result&quot;)+&quot;** ため、この経緯と、そこから見えてきたことを記録します。&quot;); m.push(&quot;&quot;); }
  var gain=lines(v(&quot;l_gain&quot;));
  if(gain.length){
    m.push(&quot;## これを読むと得られること&quot;); m.push(&quot;&quot;);
    m.push(&quot;| # | 得られること |&quot;); m.push(&quot;|---|---|&quot;);
    gain.forEach(function(x,i){ m.push(&quot;| &quot;+(i+1)+&quot; | &quot;+x+&quot; |&quot;); });
    m.push(&quot;&quot;);
  }
  m.push(&quot;> ひとことまとめ：「うまくいかなかった」経験ほど、チームの財産になります。&quot;);
  m.push(&quot;&quot;);
  var tl=lines(v(&quot;l_timeline&quot;));
  if(tl.length){
    m.push(&quot;## 何が起きたか&quot;); m.push(&quot;&quot;);
    m.push(&quot;| 時期 | 出来事 |&quot;); m.push(&quot;|---|---|&quot;);
    tl.forEach(function(x){ var c=cols(x,2); m.push(&quot;| &quot;+c[0]+&quot; | &quot;+c[1]+&quot; |&quot;); });
    m.push(&quot;&quot;);
  }
  var blind=lines(v(&quot;l_blind&quot;));
  if(blind.length){
    m.push(&quot;## 見えていなかったこと&quot;); m.push(&quot;&quot;);
    m.push(&quot;「悪かった」ではなく「見えていなかった」として整理しています。&quot;); m.push(&quot;&quot;);
    blind.forEach(function(x,i){ var c=cols(x,4);
      m.push(&quot;### 見えていなかった点&quot;+(i+1)+&quot;：&quot;+(c[0]||&quot;&quot;));
      m.push(&quot;&quot;);
      if(c[1]){ m.push(&quot;**当時の判断**：&quot;+c[1]); }
      if(c[2]){ m.push(&quot;**実際には**：&quot;+c[2]); }
      if(c[3]){ m.push(&quot;**次に活かすなら**：&quot;+c[3]); }
      m.push(&quot;&quot;);
    });
  }
  var act=lines(v(&quot;l_action&quot;)), out=lines(v(&quot;l_outcome&quot;));
  if(act.length||out.length){
    m.push(&quot;## 対応した内容・結果&quot;); m.push(&quot;&quot;);
    if(act.length){ m.push(&quot;**取った対応**&quot;); m.push(&quot;&quot;); act.forEach(function(x){ m.push(&quot;- &quot;+x); }); m.push(&quot;&quot;); }
    if(out.length){ m.push(&quot;**結果**&quot;); m.push(&quot;&quot;); out.forEach(function(x){ var c=cols(x,2); m.push(&quot;- &quot;+(c[0]||&quot;&quot;)+&quot; &quot;+(c[1]||&quot;&quot;)); }); m.push(&quot;&quot;); }
  }
  var prop=lines(v(&quot;l_propose&quot;));
  if(prop.length){
    m.push(&quot;## チームに提案したこと&quot;); m.push(&quot;&quot;);
    m.push(&quot;| 提案内容 | 状態 |&quot;); m.push(&quot;|---|---|&quot;);
    prop.forEach(function(x){ var c=cols(x,2); m.push(&quot;| &quot;+c[0]+&quot; | &quot;+c[1]+&quot; |&quot;); });
    m.push(&quot;&quot;);
  }
  m.push(&quot;## まとめ&quot;);
  m.push(&quot;&quot;);
  if(v(&quot;l_key&quot;)){ m.push(&quot;> 💡 一番伝えたいこと：&quot;+v(&quot;l_key&quot;)); m.push(&quot;&quot;); }
  if(v(&quot;l_same&quot;)){ m.push(&quot;🔁 同じ状況になったら：&quot;+v(&quot;l_same&quot;)); m.push(&quot;&quot;); }
  var next=lines(v(&quot;l_next&quot;));
  if(next.length){ m.push(&quot;## 次のアクション&quot;); m.push(&quot;&quot;); next.forEach(function(x){ m.push(&quot;- [ ] &quot;+x); }); m.push(&quot;&quot;); }
  m.push(&quot;---&quot;);
  m.push(&quot;&quot;);
  m.push(&quot;似た経験・別の視点があればぜひ教えてください🐰&quot;);
  setOut(m.join(&quot;\n&quot;));
}

/* ===== ③ メタ情報だけ ===== */
function buildMeta(){
  setOut(metaTable(v(&quot;m_author&quot;), v(&quot;m_date&quot;), v(&quot;m_update&quot;), v(&quot;m_read&quot;), v(&quot;m_chars&quot;), v(&quot;m_attach&quot;), v(&quot;m_tags&quot;)));
}

/* ===== ④ Qiita/Zenn 投稿ヘッダー ===== */
function onPlatformChange(){
  var p=v(&quot;h_platform&quot;);
  var isZenn=(p===&quot;zenn&quot;);
  $(&quot;h_emoji_box&quot;).style.display=isZenn?&quot;block&quot;:&quot;none&quot;;
  $(&quot;h_type_box&quot;).style.display=isZenn?&quot;block&quot;:&quot;none&quot;;
  $(&quot;h_pub_label&quot;).textContent=isZenn?&quot;公開状態（published）&quot;:&quot;公開状態（private）&quot;;
  $(&quot;h_tag_hint&quot;).textContent=isZenn?&quot;／Zennは小文字推奨・最大5&quot;:&quot;／Qiitaは先頭大文字慣習・最大5&quot;;
}
function tagList(){ return v(&quot;h_tags&quot;).split(/\s+/).map(function(t){return t.trim();}).filter(Boolean).slice(0,5); }
function buildHeader(){
  var p=v(&quot;h_platform&quot;), title=v(&quot;h_title&quot;)||&quot;記事タイトル&quot;, tags=tagList();
  var withSnip=(v(&quot;h_snippets&quot;)===&quot;yes&quot;);
  var m=[];
  if(p===&quot;zenn&quot;){
    var emoji=v(&quot;h_emoji&quot;)||&quot;🐰&quot;, type=v(&quot;h_type&quot;)||&quot;tech&quot;, pub=(v(&quot;h_pub&quot;)===&quot;public&quot;);
    var topics=tags.length?tags.map(function(t){return '&quot;'+t.toLowerCase()+'&quot;';}):['&quot;markdown&quot;'];
    m.push(&quot;---&quot;);
    m.push('title: &quot;'+title+'&quot;');
    m.push('emoji: &quot;'+emoji+'&quot;');
    m.push('type: &quot;'+type+'&quot;  # tech: 技術記事 / idea: アイデア');
    m.push('topics: ['+topics.join(&quot;, &quot;)+']');
    m.push(&quot;published: &quot;+(pub?&quot;true&quot;:&quot;false&quot;));
    m.push(&quot;---&quot;);
    m.push(&quot;&quot;);
    m.push(&quot;<!-- 著者：石黒 友季子 -->&quot;);
    m.push(&quot;&quot;);
    if(withSnip){
      m.push(&quot;## はじめに&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;:::message&quot;);
      m.push(&quot;この記事は〇〇な人に向けて書いています。&quot;);
      m.push(&quot;:::&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;## 本文&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;（ここに本文。①②タブの記事を貼り付けてもOK）&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;:::message alert&quot;);
      m.push(&quot;注意点やハマりどころはこのボックスで強調できます。&quot;);
      m.push(&quot;:::&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;:::details 折りたたみたい補足（クリックで開く）&quot;);
      m.push(&quot;長いコードや補足はここに入れると読みやすくなります。&quot;);
      m.push(&quot;:::&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;## まとめ&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;- 〇〇&quot;);
    }
    $(&quot;h_note&quot;).textContent=&quot;Zenn形式：Front Matter（YAML）必須。emojiは1文字、topicsは小文字・最大5。:::message / :::details はZenn独自記法です。&quot;;
  } else {
    var priv=(v(&quot;h_pub&quot;)!==&quot;public&quot;);
    var qtags=tags.length?tags:[&quot;Markdown&quot;];
    m.push(&quot;---&quot;);
    m.push(&quot;title: &quot;+title);
    m.push(&quot;tags:&quot;);
    qtags.forEach(function(t){ m.push(&quot;  - &quot;+t); });
    m.push(&quot;private: &quot;+(priv?&quot;true&quot;:&quot;false&quot;));
    m.push(&quot;updated_at: ''&quot;);
    m.push(&quot;id: null&quot;);
    m.push(&quot;organization_url_name: null&quot;);
    m.push(&quot;---&quot;);
    m.push(&quot;&quot;);
    m.push(&quot;<!-- 著者：石黒 友季子 -->&quot;);
    m.push(&quot;&quot;);
    if(withSnip){
      m.push(&quot;## はじめに&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;:::note info&quot;);
      m.push(&quot;この記事は〇〇な人に向けて書いています。&quot;);
      m.push(&quot;:::&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;## 本文&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;（ここに本文。①②タブの記事を貼り付けてもOK）&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;:::note warn&quot;);
      m.push(&quot;注意点やハマりどころはこのボックスで強調できます。&quot;);
      m.push(&quot;:::&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;## まとめ&quot;);
      m.push(&quot;&quot;);
      m.push(&quot;- 〇〇&quot;);
    }
    $(&quot;h_note&quot;).textContent=&quot;Qiita形式：qiita-cli用のFront Matter。tagsは最大5・先頭大文字慣習。:::note info / :::note warn はQiita独自記法です。&quot;;
  }
  setOut(m.join(&quot;\n&quot;));
}

/* ===== ⑤ 記法スニペット集 ===== */
var snipPlatform=&quot;zenn&quot;;
// scope: &quot;both&quot;｜&quot;zenn&quot;｜&quot;qiita&quot;
var SNIPPETS=[
  // --- メッセージ/注釈ボックス ---
  { scope:&quot;zenn&quot;, title:&quot;メッセージ（情報）&quot;, desc:&quot;Zennの情報ボックス。補足や前提を目立たせる。&quot;,
    code:&quot;:::message\nここに伝えたい情報を書きます。\n:::&quot; },
  { scope:&quot;zenn&quot;, title:&quot;メッセージ（警告 alert）&quot;, desc:&quot;Zennの警告ボックス。注意点・ハマりどころに。&quot;,
    code:&quot;:::message alert\n注意：ここは特に気をつけてください。\n:::&quot; },
  { scope:&quot;qiita&quot;, title:&quot;note（info）&quot;, desc:&quot;Qiitaの情報ボックス。&quot;,
    code:&quot;:::note info\n補足情報をここに書きます。\n:::&quot; },
  { scope:&quot;qiita&quot;, title:&quot;note（warn）&quot;, desc:&quot;Qiitaの注意ボックス。&quot;,
    code:&quot;:::note warn\n注意してほしいことをここに書きます。\n:::&quot; },
  { scope:&quot;qiita&quot;, title:&quot;note（alert）&quot;, desc:&quot;Qiitaの警告（最も強い）ボックス。&quot;,
    code:&quot;:::note alert\n重大な警告をここに書きます。\n:::&quot; },
  // --- 折りたたみ ---
  { scope:&quot;zenn&quot;, title:&quot;折りたたみ（details）&quot;, desc:&quot;Zennのアコーディオン。長いコードや補足を隠す。&quot;,
    code:&quot;:::details クリックで開く補足\nここに隠したい内容を書きます。\nコードもOK。\n:::&quot; },
  { scope:&quot;qiita&quot;, title:&quot;折りたたみ（details）&quot;, desc:&quot;QiitaはHTMLのdetailsタグを使います。&quot;,
    code:&quot;<details><summary>クリックで開く補足</summary>\n\nここに隠したい内容を書きます（前後に空行を入れるとMarkdownが効きます）。\n\n</details>&quot; },
  // --- 脚注（共通） ---
  { scope:&quot;both&quot;, title:&quot;脚注&quot;, desc:&quot;本文に注釈番号、末尾に注釈本体。QiitaもZennも共通。&quot;,
    code:&quot;本文中に注釈をつけます[^1]。\n\n[^1]: これが脚注の内容です。&quot; },
  // --- 数式 ---
  { scope:&quot;zenn&quot;, title:&quot;数式（インライン/ブロック）&quot;, desc:&quot;ZennはKaTeX。$で囲むとインライン、$$で囲むとブロック。&quot;,
    code:&quot;インライン数式は $a^2 + b^2 = c^2$ のように書きます。\n\n$$\n\\int_0^1 x^2 \\, dx = \\frac{1}{3}\n$$&quot; },
  { scope:&quot;qiita&quot;, title:&quot;数式（mathブロック）&quot;, desc:&quot;Qiitaは ```math のコードブロックで数式を書きます。&quot;,
    code:&quot;```math\n\\int_0^1 x^2 \\, dx = \\frac{1}{3}\n```&quot; },
  // --- コードブロック ---
  { scope:&quot;both&quot;, title:&quot;コードブロック（言語指定）&quot;, desc:&quot;言語名を付けるとシンタックスハイライトされます。共通。&quot;,
    code:&quot;```python\ndef hello():\n    print(\&quot;Hello\&quot;)\n```&quot; },
  { scope:&quot;both&quot;, title:&quot;差分コード（diff）&quot;, desc:&quot;追加行に+、削除行に-。レビューや変更点の説明に。共通。&quot;,
    code:&quot;```diff\n- old_value = 1\n+ new_value = 2\n```&quot; },
  { scope:&quot;zenn&quot;, title:&quot;コードブロック（ファイル名つき）&quot;, desc:&quot;Zennは言語の後にファイル名を書ける。&quot;,
    code:&quot;```js:src/index.js\nconsole.log(\&quot;hello\&quot;);\n```&quot; },
  // --- リンクカード ---
  { scope:&quot;zenn&quot;, title:&quot;リンクカード&quot;, desc:&quot;Zennは行に単独でURLを書くとカード表示になります。&quot;,
    code:&quot;https://zenn.dev&quot; },
  { scope:&quot;qiita&quot;, title:&quot;リンク&quot;, desc:&quot;QiitaはURLを貼ると自動でカード化されることがあります。通常のMarkdownリンクも可。&quot;,
    code:&quot;[リンクテキスト](https://qiita.com)&quot; },
  // --- 共通：テーブル・チェックリスト・引用・画像 ---
  { scope:&quot;both&quot;, title:&quot;テーブル&quot;, desc:&quot;表組み。共通。&quot;,
    code:&quot;| 項目 | 内容 |\n|---|---|\n| 名前 | 値 |\n| 名前2 | 値2 |&quot; },
  { scope:&quot;both&quot;, title:&quot;チェックリスト&quot;, desc:&quot;タスクリスト。共通。&quot;,
    code:&quot;- [ ] やること1\n- [x] 完了したこと\n- [ ] やること2&quot; },
  { scope:&quot;both&quot;, title:&quot;引用&quot;, desc:&quot;引用ブロック。共通。&quot;,
    code:&quot;> 引用したい文章。\n> 複数行も書けます。&quot; },
  { scope:&quot;both&quot;, title:&quot;画像（altつき）&quot;, desc:&quot;画像。altは読み上げ・SEOにも有効。共通。&quot;,
    code:&quot;![代替テキスト](https://example.com/image.png)&quot; },
  { scope:&quot;both&quot;, title:&quot;見出し&quot;, desc:&quot;## から使うのが一般的（# は記事タイトル扱いになりがち）。共通。&quot;,
    code:&quot;## 大見出し\n\n### 中見出し&quot; },
  // --- 専用：目次 ---
  { scope:&quot;qiita&quot;, title:&quot;目次（TOC）&quot;, desc:&quot;Qiitaは [TOC] で自動目次。Zennは自動で右側に目次が出るため不要。&quot;,
    code:&quot;[TOC]&quot; },
  // --- 追加：折りたたみ（生HTML・両対応） ---
  { scope:&quot;both&quot;, title:&quot;折りたたみ（HTML details）&quot;, desc:&quot;Markdownの:::が使えない場面でも動く、生HTMLの折りたたみ。両対応。&quot;,
    code:&quot;<details>\n<summary>クリックで開く</summary>\n\n中身（コードや長い説明）をここに。空行を1行あけると中でMarkdownが効きます。\n\n</details>&quot; },
  // --- 追加：脚注（複数） ---
  { scope:&quot;both&quot;, title:&quot;脚注（複数）&quot;, desc:&quot;本文に[^id]を置き、下部に定義。番号は自動。両対応。&quot;,
    code:&quot;本文の根拠はここ[^1]。別の補足もある[^note]。\n\n[^1]: 1つ目の脚注の内容。\n[^note]: 名前付きの脚注も使えます。&quot; },
  // --- 追加：数式（番号・複数行） ---
  { scope:&quot;both&quot;, title:&quot;数式（複数行・揃え）&quot;, desc:&quot;alignで複数行をそろえる。KaTeX。両対応（$$で囲む）。&quot;,
    code:&quot;$$\n\\begin{aligned}\na &amp;= b + c \\\\\n  &amp;= d + e\n\\end{aligned}\n$$&quot; },
  // --- 追加：キーボードキー ---
  { scope:&quot;both&quot;, title:&quot;キーボードキー（kbd）&quot;, desc:&quot;ショートカット表記。生HTMLのkbdタグ。両対応。&quot;,
    code:&quot;<kbd>Ctrl</kbd> + <kbd>C</kbd> でコピー&quot; },
  // --- 追加：打ち消し線・装飾 ---
  { scope:&quot;both&quot;, title:&quot;打ち消し線・強調&quot;, desc:&quot;取り消し線・太字・斜体の組み合わせ。両対応。&quot;,
    code:&quot;~~取り消し~~ / **太字** / *斜体* / ***太字斜体***&quot; },
  // --- 追加：ネストリスト・タスク ---
  { scope:&quot;both&quot;, title:&quot;ネストリスト＆タスク&quot;, desc:&quot;入れ子の箇条書きとチェックボックス。両対応。&quot;,
    code:&quot;- 親項目\n  - 子項目\n    - 孫項目\n- [ ] 未完了タスク\n- [x] 完了タスク&quot; },
  // --- 追加：水平線・引用ネスト ---
  { scope:&quot;both&quot;, title:&quot;水平線・引用の入れ子&quot;, desc:&quot;セクション区切りと、引用の中の引用。両対応。&quot;,
    code:&quot;---\n\n> 外側の引用\n>> 内側の引用\n>\n> 続きの引用&quot; },
  // --- 追加：Mermaid 図 ---
  { scope:&quot;both&quot;, title:&quot;Mermaid 図（フロー）&quot;, desc:&quot;```mermaid で図を描ける。Zenn対応、Qiitaも対応。&quot;,
    code:&quot;```mermaid\nflowchart TD\n  A[開始] --> B{条件}\n  B -->|Yes| C[処理1]\n  B -->|No| D[処理2]\n```&quot; },
  // --- 追加：Zenn 画像キャプション ---
  { scope:&quot;zenn&quot;, title:&quot;画像＋キャプション&quot;, desc:&quot;Zennは画像の直後に *斜体* を置くとキャプションになる。&quot;,
    code:&quot;![代替テキスト](https://example.com/img.png)\n*図1：キャプションをここに*&quot; },
  // --- 追加：Zenn リンク埋め込み ---
  { scope:&quot;zenn&quot;, title:&quot;カード/埋め込み（URL単独行）&quot;, desc:&quot;ZennはURLを単独行に置くとカード化。GitHub/X等も埋め込みになる。&quot;,
    code:&quot;https://zenn.dev\n\n（↑URLだけの行にするとカード表示になります）&quot; },
  // --- 追加：Qiita note success ---
  { scope:&quot;qiita&quot;, title:&quot;note（success 成功）&quot;, desc:&quot;Qiitaの成功・ポジティブ通知ボックス。&quot;,
    code:&quot;:::note success\nうまくいったこと・推奨設定をここに。\n:::&quot; },
  // --- 追加：Qiita 折りたたみ（公式） ---
  { scope:&quot;qiita&quot;, title:&quot;折りたたみ（Qiita）&quot;, desc:&quot;Qiitaは<details>で折りたたみ。中でコードも書ける。&quot;,
    code:&quot;<details><summary>詳細を見る</summary>\n\n```js\nconsole.log(\&quot;中身\&quot;);\n```\n\n</details>&quot; },
  // --- 追加：テーブルの寄せ（共通） ---
  { scope:&quot;both&quot;, title:&quot;テーブル（左/中央/右寄せ）&quot;, desc:&quot;区切り行のコロン位置で寄せを指定。:--左 :-:中央 --:右。両対応。&quot;,
    code:&quot;| 左寄せ | 中央 | 右寄せ |\n| :--- | :---: | ---: |\n| a | b | c |\n| 1 | 2 | 3 |&quot; },
  // --- 追加：コード内の行ハイライト（Zenn） ---
  { scope:&quot;zenn&quot;, title:&quot;コード行ハイライト（Zenn）&quot;, desc:&quot;Zennは {1,3-4} で強調する行を指定できる。&quot;,
    code:&quot;```js:example.js {1,3-4}\nconst a = 1;   // 強調される\nconst b = 2;\nconst c = 3;   // 強調される\nconst d = 4;   // 強調される\n```&quot; },
  // --- 追加：絵文字ショートコード（共通） ---
  { scope:&quot;both&quot;, title:&quot;絵文字ショートコード&quot;, desc:&quot;:smile: のような記法。GitHub/Qiita/Zennで使える。両対応。&quot;,
    code:&quot;:bulb: ヒント / :warning: 注意 / :rocket: リリース / :white_check_mark: 完了&quot; },
  // --- 追加：コメントアウト（共通） ---
  { scope:&quot;both&quot;, title:&quot;コメントアウト（非表示メモ）&quot;, desc:&quot;HTMLコメント。プレビューにも記事にも出ない、執筆中のメモに。両対応。&quot;,
    code:&quot;<!-- ここは公開されないメモ。TODOや下書きの覚え書きに。 -->&quot; },
  // --- 追加：文字エスケープ（共通） ---
  { scope:&quot;both&quot;, title:&quot;記号のエスケープ&quot;, desc:&quot;* _ ` # など記法に使う記号を、そのまま文字として表示する。両対応。&quot;,
    code:&quot;\\*アスタリスクを文字として表示\\* / \\`バッククォート\\`&quot; },
  // --- 追加：GitHub埋め込み（Zenn） ---
  { scope:&quot;zenn&quot;, title:&quot;GitHub/Gist 埋め込み（Zenn）&quot;, desc:&quot;ZennはGitHubのファイルURLやGist URLを単独行に置くと埋め込み表示。&quot;,
    code:&quot;https://github.com/owner/repo/blob/main/src/index.js&quot; },
  // --- 追加：X(Twitter)埋め込み（Zenn） ---
  { scope:&quot;zenn&quot;, title:&quot;X(ツイート) 埋め込み（Zenn）&quot;, desc:&quot;ZennはツイートのURLを単独行に置くと埋め込み表示になる。&quot;,
    code:&quot;https://x.com/example/status/1234567890&quot; },
  // --- 追加：Zenn メッセージ内のリンク・装飾 ---
  { scope:&quot;zenn&quot;, title:&quot;メッセージ内に見出し・リスト&quot;, desc:&quot;Zennの:::messageの中にもMarkdownが書ける（リスト・太字など）。&quot;,
    code:&quot;:::message\n**ポイント**\n- 1つ目\n- 2つ目\n:::&quot; },
  // --- 追加：Qiita 注釈（参照）リンク ---
  { scope:&quot;both&quot;, title:&quot;参照リンク（後でまとめて定義）&quot;, desc:&quot;本文では[文言][id]、末尾でidにURLを定義。同じURLを何度も使うときに便利。両対応。&quot;,
    code:&quot;詳しくは[公式ドキュメント][doc]を参照。\n\n[doc]: https://example.com/docs&quot; }
];
function setSnipPlatform(p){
  snipPlatform=p;
  $(&quot;seg-zenn&quot;).classList.toggle(&quot;on&quot;, p===&quot;zenn&quot;);
  $(&quot;seg-qiita&quot;).classList.toggle(&quot;on&quot;, p===&quot;qiita&quot;);
  renderSnippets();
}
function tagLabel(scope){
  if(scope===&quot;both&quot;) return '<span class=&quot;snip-tag both&quot;>🟢 共通</span>';
  if(scope===&quot;zenn&quot;) return '<span class=&quot;snip-tag zenn&quot;>🔵 Zenn専用</span>';
  return '<span class=&quot;snip-tag qiita&quot;>🟢 Qiita専用</span>';
}
function renderSnippets(){
  var box=$(&quot;snipList&quot;); box.innerHTML=&quot;&quot;;
  var list=SNIPPETS.filter(function(s){ return s.scope===&quot;both&quot; || s.scope===snipPlatform; });
  list.forEach(function(s){
    var div=document.createElement(&quot;div&quot;); div.className=&quot;snip&quot;;
    div.innerHTML='<div class=&quot;snip-head&quot;><span class=&quot;snip-title&quot;>'+escH(s.title)+tagLabel(s.scope)+'</span>'+
      '<button class=&quot;snip-copy&quot; type=&quot;button&quot;>📋 コピー</button></div>'+
      '<div class=&quot;snip-desc&quot;>'+escH(s.desc)+'</div>'+
      '<div class=&quot;snip-code&quot;>'+escH(s.code)+'</div>';
    var btn=div.querySelector(&quot;.snip-copy&quot;);
    btn.addEventListener(&quot;click&quot;, function(){
      copySnip(s.code); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },1500);
    });
    box.appendChild(div);
  });
}
function escH(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function copySnip(text){
  function fall(){ var ta=document.createElement(&quot;textarea&quot;); ta.value=text; ta.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(ta); ta.focus(); ta.select(); try{document.execCommand(&quot;copy&quot;);}catch(_){} document.body.removeChild(ta); toast(&quot;コピーしました&quot;); }
  try{
    if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(function(){ toast(&quot;コピーしました&quot;); }).catch(fall);
    } else { fall(); }
  }catch(e){ fall(); }
}

/* ===== タブ ===== */
function switchPanel(tab){
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.classList.toggle(&quot;active&quot;, t.dataset.tab===tab); });
  [].slice.call(document.querySelectorAll(&quot;.panel&quot;)).forEach(function(p){ p.classList.toggle(&quot;active&quot;, p.id===&quot;panel-&quot;+tab); });
  if(tab===&quot;snippets&quot;){ try{ renderSnippets(); }catch(e){} }
}

/* ===== init ===== */
(function(){
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.addEventListener(&quot;click&quot;, function(){ switchPanel(t.dataset.tab); }); });
  // 著者の初期値（石黒 友季子）
  [&quot;g_author&quot;,&quot;l_author&quot;,&quot;m_author&quot;].forEach(function(id){ var el=$(id); if(el&amp;&amp;!el.value) el.value=&quot;石黒 友季子&quot;; });
  // 日付の初期値
  [&quot;g_date&quot;,&quot;l_date&quot;,&quot;m_date&quot;,&quot;m_update&quot;].forEach(function(id){ var el=$(id); if(el&amp;&amp;!el.value) el.value=todayIso(); });
  try{ if($(&quot;h_platform&quot;)) onPlatformChange(); }catch(e){}
  try{ var vt=$(&quot;ver_today&quot;); if(vt) vt.textContent=nowParts().date; }catch(e){}
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-timer30" title="30分説明タイマー" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 30分説明タイマー 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  :root{ --radius:14px; }
  body.theme-jp{
    --paper:#ffffff; --bg:#f1f6f3; --bg2:#e6f0ea; --ink:#1e2b24; --ink-soft:#54675c;
    --line:#d7e7dd; --accent:#3f9d6b; --accent-deep:#2c7350; --accent-soft:#e3f3ea;
    --warn:#e0922f; --shadow:0 8px 26px rgba(47,140,90,.13);
  }
  body{margin:0;font-family:&quot;Hiragino Sans&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;color:var(--ink);
    background:linear-gradient(160deg,#dcefe4,var(--bg) 42%);min-height:100vh;line-height:1.6;}
  .wrap{max-width:920px;margin:0 auto;padding:18px 16px 70px;}
  header.hero{position:relative;margin-top:20px;background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:20px 24px;box-shadow:var(--shadow);}
  header.hero h1{margin:0 0 4px;font-size:1.2rem;font-weight:800;display:flex;align-items:center;gap:8px;}
  header.hero p{margin:0;color:var(--ink-soft);font-size:.86rem;}
  .ver-badge{display:flex;gap:8px;align-items:center;margin:6px 0 0;flex-wrap:wrap;}
  .ver-pill{display:inline-block;background:var(--accent);color:#fff;font-weight:700;font-size:.7rem;padding:2px 9px;border-radius:999px;}
  .ver-date,.ver-today{color:var(--ink-soft);font-size:.72rem;}
  .ver-today:not(:empty)::before{content:&quot;｜ 今日 &quot;;opacity:.8;}
  .bunny{position:absolute;top:18px;right:22px;font-size:24px;}
  .lang-switch{display:none;}
  .howto{background:var(--accent-soft);border:1px solid #c5e6d4;border-left:4px solid var(--accent);border-radius:10px;padding:10px 14px;margin:16px 0;font-size:.83rem;color:#236046;}
  .howto b{color:var(--accent-deep);}
  .howto ol{margin:6px 0 0;padding-left:20px;}

  /* 大きなタイマー表示 */
  .bigtimer{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:var(--shadow);text-align:center;margin-bottom:16px;}
  .phase-name{font-size:1.15rem;font-weight:800;color:var(--accent-deep);}
  .phase-sub{font-size:.8rem;color:var(--ink-soft);margin-top:2px;min-height:1.1em;}
  .clock-big{font-size:4rem;font-weight:800;letter-spacing:.04em;font-variant-numeric:tabular-nums;margin:6px 0;color:var(--ink);}
  .clock-big.warn{color:var(--warn);}
  .total-line{font-size:.82rem;color:var(--ink-soft);}
  .progress{height:8px;background:var(--bg2);border-radius:999px;overflow:hidden;margin:14px 0 0;}
  .progress > div{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-deep));width:0%;transition:width .3s;}
  .controls{display:flex;gap:10px;justify-content:center;margin-top:16px;flex-wrap:wrap;}
  .controls button{border:none;border-radius:11px;padding:12px 22px;font-size:.95rem;font-weight:800;cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,.1);transition:transform .08s,box-shadow .12s,filter .12s;}
  .controls button:active{transform:translateY(1px) scale(.99);}
  .btn-start{background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;}
  .btn-pause{background:#fff;border:1px solid var(--warn)!important;color:var(--warn);}
  .btn-reset{background:#fff;border:1px solid var(--line)!important;color:var(--ink-soft);}
  .btn-skip{background:#fff;border:1px solid var(--line)!important;color:var(--accent-deep);}

  /* フェーズ一覧 */
  .phases{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:18px;box-shadow:var(--shadow);}
  .phases h2{font-size:1rem;margin:0 0 4px;}
  .preset{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0 14px;}
  .preset button{border:1px solid var(--line);background:#fff;border-radius:999px;padding:6px 13px;font-size:.8rem;font-weight:700;color:var(--accent-deep);cursor:pointer;}
  .preset button:hover{background:var(--accent-soft);}
  .prow{display:flex;align-items:center;gap:10px;padding:9px 11px;border:1px solid var(--line);border-radius:10px;margin:7px 0;transition:background .15s,border .15s;}
  .prow.active{background:var(--accent-soft);border-color:var(--accent);}
  .prow.done{opacity:.5;}
  .prow .pi{font-size:1.1rem;width:1.6em;text-align:center;}
  .prow .pn{font-weight:800;font-size:.92rem;flex:0 0 auto;min-width:5em;}
  .prow .pd{font-size:.76rem;color:var(--ink-soft);flex:1;}
  .prow .pmin{display:flex;align-items:center;gap:4px;}
  .prow .pmin input{width:54px;border:1px solid var(--line);border-radius:7px;padding:6px 8px;font-size:.9rem;text-align:right;font-family:inherit;color:var(--ink);}
  .prow .pmin span{font-size:.76rem;color:var(--ink-soft);}
  .totalbar{display:flex;justify-content:space-between;align-items:center;margin-top:12px;padding:10px 12px;background:var(--bg2);border-radius:10px;font-weight:800;font-size:.9rem;}
  .totalbar .ok{color:var(--accent-deep);}
  .totalbar .ng{color:var(--warn);}
  .opt{display:flex;align-items:center;gap:8px;margin-top:12px;font-size:.84rem;color:var(--ink-soft);}
  .opt input{width:auto;}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:999px;font-size:.85rem;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50;}
  .toast.show{opacity:.96;}
  @media (max-width:560px){ .clock-big{font-size:3rem;} .prow{flex-wrap:wrap;} .prow .pd{flex:1 1 100%;order:5;} }
</style>
</head>
<body class=&quot;theme-jp&quot;>
<div class=&quot;wrap&quot;>
  <header class=&quot;hero&quot;>
    <div class=&quot;bunny&quot;>🐰</div>
    <h1>⏱ うさうさ 30分説明タイマー</h1>
    <p>説明を6段階（導入→概要→要点→説明→正式には→補足）に時間配分して、30分で話しきる練習・本番用タイマーです。</p>
    <div class=&quot;ver-badge&quot;><span class=&quot;ver-pill&quot;>v1.0</span><span class=&quot;ver-date&quot;>2026-05-22</span><span class=&quot;ver-today&quot; id=&quot;ver_today&quot;></span></div>
  </header>

  <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
    <li>下のフェーズ表で各段階の分数を決める（プリセットも使えます／合計30分が目安）</li>
    <li>「▶ 開始」を押すと、導入から順にカウントダウン。フェーズ終了時に合図音が鳴ります</li>
    <li>「⏭ 次へ」で早送り、「⏸ 一時停止」「⟲ リセット」も使えます</li>
  </ol></div>

  <div class=&quot;bigtimer&quot;>
    <div class=&quot;phase-name&quot; id=&quot;phaseName&quot;>準備OK</div>
    <div class=&quot;phase-sub&quot; id=&quot;phaseSub&quot;>開始ボタンで「導入」から始まります</div>
    <div class=&quot;clock-big&quot; id=&quot;clockBig&quot;>30:00</div>
    <div class=&quot;total-line&quot; id=&quot;totalLine&quot;>全体の残り：30:00 / 30:00</div>
    <div class=&quot;progress&quot;><div id=&quot;progBar&quot;></div></div>
    <div class=&quot;controls&quot;>
      <button class=&quot;btn-start&quot; id=&quot;startBtn&quot; onclick=&quot;startTimer()&quot;>▶ 開始</button>
      <button class=&quot;btn-pause&quot; id=&quot;pauseBtn&quot; onclick=&quot;pauseTimer()&quot; style=&quot;display:none;&quot;>⏸ 一時停止</button>
      <button class=&quot;btn-skip&quot; onclick=&quot;skipPhase()&quot;>⏭ 次へ</button>
      <button class=&quot;btn-reset&quot; onclick=&quot;resetTimer()&quot;>⟲ リセット</button>
    </div>
  </div>

  <div class=&quot;phases&quot;>
    <h2>📋 フェーズ配分</h2>
    <div class=&quot;preset&quot;>
      <button type=&quot;button&quot; onclick=&quot;applyPreset('std')&quot;>標準（5/5/6/8/3/3）</button>
      <button type=&quot;button&quot; onclick=&quot;applyPreset('lecture')&quot;>説明多め（4/4/5/12/3/2）</button>
      <button type=&quot;button&quot; onclick=&quot;applyPreset('quick')&quot;>要点重視（3/3/10/8/3/3）</button>
    </div>
    <div id=&quot;phaseList&quot;></div>
    <div class=&quot;totalbar&quot;><span>合計</span><span id=&quot;totalMin&quot; class=&quot;ok&quot;>30分</span></div>
    <div class=&quot;opt&quot;><label><input type=&quot;checkbox&quot; id=&quot;optSound&quot; checked> フェーズ切替で合図音を鳴らす</label></div>
  </div>
</div>
<div class=&quot;toast&quot; id=&quot;toast&quot;></div>
<script>
&quot;use strict&quot;;
function $(id){ return document.getElementById(id); }
function toast(m){ var t=$(&quot;toast&quot;); if(!t)return; t.textContent=m; t.classList.add(&quot;show&quot;); setTimeout(function(){t.classList.remove(&quot;show&quot;);},1600); }
function nowParts(){
  var d=new Date(), wd=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var mm=(&quot;0&quot;+(d.getMonth()+1)).slice(-2), dd=(&quot;0&quot;+d.getDate()).slice(-2);
  return { date:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;）&quot; };
}
function fmt(sec){ sec=Math.max(0,Math.round(sec)); var m=Math.floor(sec/60), s=sec%60; return (&quot;0&quot;+m).slice(-2)+&quot;:&quot;+(&quot;0&quot;+s).slice(-2); }

// 6フェーズ定義（うさうさ式6段階フレーム）
var PHASES=[
  {key:&quot;intro&quot;, icon:&quot;🚪&quot;, name:&quot;導入&quot;, sub:&quot;つかみ・今日のゴール提示&quot;, min:5},
  {key:&quot;overview&quot;, icon:&quot;🗺&quot;, name:&quot;概要&quot;, sub:&quot;全体像をざっくり俯瞰&quot;, min:5},
  {key:&quot;point&quot;, icon:&quot;📌&quot;, name:&quot;要点&quot;, sub:&quot;押さえるべきキーワード&quot;, min:6},
  {key:&quot;explain&quot;, icon:&quot;📖&quot;, name:&quot;説明&quot;, sub:&quot;具体的に・たとえで深掘り&quot;, min:8},
  {key:&quot;formal&quot;, icon:&quot;📐&quot;, name:&quot;正式には&quot;, sub:&quot;正確な定義・公式表現&quot;, min:3},
  {key:&quot;supp&quot;, icon:&quot;➕&quot;, name:&quot;補足&quot;, sub:&quot;試験ポイント・まとめ・質疑&quot;, min:3}
];
var PRESETS={
  std:[5,5,6,8,3,3], lecture:[4,4,5,12,3,2], quick:[3,3,10,8,3,3]
};

var timer={ running:false, idx:-1, remain:0, intervalId:null };

function renderPhaseList(){
  var box=$(&quot;phaseList&quot;); box.innerHTML=&quot;&quot;;
  PHASES.forEach(function(p,i){
    var row=document.createElement(&quot;div&quot;);
    row.className=&quot;prow&quot;+(i===timer.idx?&quot; active&quot;:&quot;&quot;)+(timer.idx>i?&quot; done&quot;:&quot;&quot;);
    row.id=&quot;prow_&quot;+i;
    row.innerHTML='<span class=&quot;pi&quot;>'+p.icon+'</span>'+
      '<span class=&quot;pn&quot;>'+p.name+'</span>'+
      '<span class=&quot;pd&quot;>'+p.sub+'</span>'+
      '<span class=&quot;pmin&quot;><input type=&quot;number&quot; min=&quot;0&quot; max=&quot;60&quot; value=&quot;'+p.min+'&quot; id=&quot;min_&quot;+'+'&quot;'+i+'&quot; onchange=&quot;onMinChange('+i+',this.value)&quot;><span>分</span></span>';
    box.appendChild(row);
  });
  // input id修正（テンプレ文字列の都合で再設定）
  PHASES.forEach(function(p,i){ var inp=box.children[i].querySelector(&quot;input&quot;); inp.id=&quot;min_&quot;+i; });
  updateTotal();
}
function onMinChange(i,val){
  var n=parseInt(val,10); if(isNaN(n)||n<0) n=0; if(n>60) n=60;
  PHASES[i].min=n; $(&quot;min_&quot;+i).value=n;
  updateTotal();
  if(!timer.running &amp;&amp; timer.idx<0){ resetDisplay(); }
}
function totalMin(){ return PHASES.reduce(function(a,p){return a+p.min;},0); }
function updateTotal(){
  var t=totalMin();
  var el=$(&quot;totalMin&quot;); el.textContent=t+&quot;分&quot;;
  el.className=(t===30?&quot;ok&quot;:&quot;ng&quot;);
  if(t!==30) el.textContent=t+&quot;分（30分まで &quot;+(30-t>0?(&quot;あと&quot;+(30-t)):(&quot;超過&quot;+(t-30)))+&quot;）&quot;;
}
function applyPreset(name){
  var arr=PRESETS[name]; if(!arr) return;
  PHASES.forEach(function(p,i){ p.min=arr[i]; });
  renderPhaseList();
  if(!timer.running) resetTimer(true);
  toast(&quot;配分を適用しました（合計&quot;+totalMin()+&quot;分）&quot;);
}

// 合図音（Web Audio API）
var audioCtx=null;
function beep(times){
  if(!$(&quot;optSound&quot;).checked) return;
  try{
    if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)();
    var n=times||1;
    for(var i=0;i<n;i++){
      var t=audioCtx.currentTime+i*0.18;
      var o=audioCtx.createOscillator(), g=audioCtx.createGain();
      o.frequency.value=880; o.type=&quot;sine&quot;;
      g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(0.25,t+0.02); g.gain.exponentialRampToValueAtTime(0.0001,t+0.16);
      o.connect(g); g.connect(audioCtx.destination); o.start(t); o.stop(t+0.17);
    }
  }catch(e){}
}

function totalRemainSec(){
  var s=0;
  if(timer.idx<0){ s=totalMin()*60; }
  else {
    s=timer.remain;
    for(var i=timer.idx+1;i<PHASES.length;i++){ s+=PHASES[i].min*60; }
  }
  return s;
}
function updateDisplay(){
  var clock=$(&quot;clockBig&quot;);
  if(timer.idx<0){
    $(&quot;phaseName&quot;).textContent=&quot;準備OK&quot;; $(&quot;phaseSub&quot;).textContent=&quot;開始ボタンで「導入」から始まります&quot;;
    clock.textContent=fmt(totalMin()*60); clock.classList.remove(&quot;warn&quot;);
    $(&quot;progBar&quot;).style.width=&quot;0%&quot;;
  } else {
    var p=PHASES[timer.idx];
    $(&quot;phaseName&quot;).textContent=p.icon+&quot; &quot;+p.name+&quot;（&quot;+(timer.idx+1)+&quot;/&quot;+PHASES.length+&quot;）&quot;;
    $(&quot;phaseSub&quot;).textContent=p.sub;
    clock.textContent=fmt(timer.remain);
    clock.classList.toggle(&quot;warn&quot;, timer.remain<=10);
    var phaseTotal=p.min*60||1;
    var done=phaseTotal-timer.remain;
    $(&quot;progBar&quot;).style.width=Math.min(100,Math.max(0,done/phaseTotal*100))+&quot;%&quot;;
  }
  var tr=totalRemainSec();
  $(&quot;totalLine&quot;).textContent=&quot;全体の残り：&quot;+fmt(tr)+&quot; / &quot;+fmt(totalMin()*60);
  // 行のactive/done更新
  PHASES.forEach(function(p,i){
    var row=$(&quot;prow_&quot;+i); if(!row) return;
    row.classList.toggle(&quot;active&quot;, i===timer.idx);
    row.classList.toggle(&quot;done&quot;, timer.idx>i);
  });
}
function resetDisplay(){ updateDisplay(); }

function enterPhase(i){
  // 分0のフェーズはスキップ
  while(i<PHASES.length &amp;&amp; PHASES[i].min<=0){ i++; }
  if(i>=PHASES.length){ finishAll(); return; }
  timer.idx=i; timer.remain=PHASES[i].min*60;
  updateDisplay();
}
function tick(){
  if(!timer.running) return;
  timer.remain--;
  if(timer.remain<=0){
    beep(timer.idx>=PHASES.length-1?3:2);
    var next=timer.idx+1;
    if(next>=PHASES.length || allRestZero(next)){ finishAll(); return; }
    enterPhase(next);
  } else {
    updateDisplay();
  }
}
function allRestZero(from){ for(var i=from;i<PHASES.length;i++){ if(PHASES[i].min>0) return false; } return true; }
function startTimer(){
  if(totalMin()<=0){ toast(&quot;分数を設定してください&quot;); return; }
  if(timer.idx<0) enterPhase(0);
  timer.running=true;
  $(&quot;startBtn&quot;).style.display=&quot;none&quot;; $(&quot;pauseBtn&quot;).style.display=&quot;inline-block&quot;;
  clearInterval(timer.intervalId); timer.intervalId=setInterval(tick,1000);
  // ユーザー操作起点でAudioContextを起こす
  try{ if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)(); if(audioCtx.state===&quot;suspended&quot;) audioCtx.resume(); }catch(e){}
  updateDisplay();
}
function pauseTimer(){
  timer.running=false; clearInterval(timer.intervalId);
  $(&quot;startBtn&quot;).style.display=&quot;inline-block&quot;; $(&quot;startBtn&quot;).textContent=&quot;▶ 再開&quot;; $(&quot;pauseBtn&quot;).style.display=&quot;none&quot;;
}
function skipPhase(){
  if(timer.idx<0){ enterPhase(0); return; }
  beep(1);
  var next=timer.idx+1;
  if(next>=PHASES.length || allRestZero(next)){ finishAll(); return; }
  enterPhase(next);
}
function finishAll(){
  timer.running=false; clearInterval(timer.intervalId); timer.idx=PHASES.length;
  $(&quot;phaseName&quot;).textContent=&quot;🎉 終了！&quot;; $(&quot;phaseSub&quot;).textContent=&quot;30分の説明、おつかれさまでした&quot;;
  $(&quot;clockBig&quot;).textContent=&quot;00:00&quot;; $(&quot;clockBig&quot;).classList.remove(&quot;warn&quot;);
  $(&quot;progBar&quot;).style.width=&quot;100%&quot;;
  $(&quot;totalLine&quot;).textContent=&quot;全体の残り：00:00 / &quot;+fmt(totalMin()*60);
  $(&quot;startBtn&quot;).style.display=&quot;inline-block&quot;; $(&quot;startBtn&quot;).textContent=&quot;▶ 開始&quot;; $(&quot;pauseBtn&quot;).style.display=&quot;none&quot;;
  PHASES.forEach(function(p,i){ var row=$(&quot;prow_&quot;+i); if(row){ row.classList.remove(&quot;active&quot;); row.classList.add(&quot;done&quot;); } });
  beep(3);
}
function resetTimer(silent){
  timer.running=false; clearInterval(timer.intervalId);
  timer.idx=-1; timer.remain=0;
  $(&quot;startBtn&quot;).style.display=&quot;inline-block&quot;; $(&quot;startBtn&quot;).textContent=&quot;▶ 開始&quot;; $(&quot;pauseBtn&quot;).style.display=&quot;none&quot;;
  renderPhaseList(); updateDisplay();
  if(!silent) toast(&quot;リセットしました&quot;);
}

(function(){
  renderPhaseList(); updateDisplay();
  try{ var vt=$(&quot;ver_today&quot;); if(vt) vt.textContent=nowParts().date; }catch(e){}
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-script" title="説明台本APIなし" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 説明台本ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#15331f,#1c3f28 55%,#13311d);color:#e8f3ea;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(80,180,120,.5);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.88}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.05);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.09);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#7faa86;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(80,180,120,.22);border-bottom:2px solid #50b478;color:#86d9a3;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#7faa86;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(80,180,120,.34);border:1px solid #50b478;color:#86d9a3;}
  label{display:block;font-size:12px;font-weight:700;color:#a9ccb2;margin-bottom:6px;}
  textarea,input[type=password],select{width:100%;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.12);
    border-radius:8px;padding:10px 12px;color:#e8f3ea;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#50b478,#2c7a50);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>🎬</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#86d9a3,#50b478);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>説明台本ジェネレーター</h1>
      <p style=&quot;margin:0;font-size:11px;color:#7faa86;&quot; id=&quot;subtitle&quot;>【APIキーなし版】完全オフライン。手動プロンプト→AIに貼付→JSON取り込み</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 入力</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>🎬 台本</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0;font-size:12px;color:#a9ccb2;line-height:1.7;&quot;>💡 うさうさ式6段階フレーム：<b style=&quot;color:#86d9a3;&quot;>導入 → 概要 → 要点 → 説明（具体的に・たとえ）→ 正式には（正確な定義）→ 補足（試験ポイント・まとめ）</b>で、30分の説明台本を作ります。</p>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;border-left:3px solid #50b478;&quot;>
      <label>📚 説明テーマ</label>
      <input id=&quot;f_topic&quot; placeholder=&quot;例：Linuxのファイルパーミッション（chmod）&quot;>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #5bbf82;&quot;>
        <label>🎓 対象者レベル</label>
        <select id=&quot;f_level&quot;><option value=&quot;初学者（非IT・新卒）&quot;>初学者（非IT・新卒）</option><option value=&quot;初級（学習開始数週間）&quot;>初級（学習開始数週間）</option><option value=&quot;中級（実務少しあり）&quot;>中級（実務少しあり）</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #4a9a6a;&quot;>
        <label>⏱ 持ち時間</label>
        <select id=&quot;f_time&quot;><option value=&quot;30分&quot;>30分</option><option value=&quot;15分&quot;>15分</option><option value=&quot;45分&quot;>45分</option><option value=&quot;60分&quot;>60分</option></select>
      </div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>🔑 含めたい用語・キーワード（任意・カンマ区切り）</label>
      <input id=&quot;f_terms&quot; placeholder=&quot;所有者, グループ, その他, 読み取り, 書き込み, 実行, rwx, 数値表記&quot;>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>📝 補足の希望（たとえ・演習・試験ポイントなど・任意）</label>
      <textarea id=&quot;f_note&quot; placeholder=&quot;うさうさラーメン店のたとえを使いたい／最後に簡単な演習を1問入れたい&quot;></textarea>
    </div>

    

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#a9ccb2;&quot;>🛠 使い方（3ステップ）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#6a8f72;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(80,180,120,.2);border:1px solid #50b478;border-radius:8px;padding:7px 14px;color:#86d9a3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:7px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで台本を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#a9ccb2;&quot;>✨ 生成される6段階</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#5a7a62;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>🎬</div>
      <p>「入力」タブでテーマを入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:10px;flex-wrap:wrap;&quot;>
        <h2 id=&quot;scriptTitle&quot; style=&quot;margin:0;font-size:16px;color:#86d9a3;&quot;></h2>
        <button class=&quot;btn&quot; id=&quot;copyAllBtn&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:6px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 台本全体をコピー</button>
      </div>
      <div id=&quot;scriptView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「IT研修の説明台本ライター」です。講師が話す説明の台本（スクリプト）を、うさうさ式6段階フレームで作ります。
6段階：1.導入（つかみ・今日のゴール）2.概要（全体像）3.要点（押さえるキーワード）4.説明（具体的に・たとえで深掘り）5.正式には（正確な定義・公式表現）6.補足（試験ポイント・まとめ・必要なら演習）。
方針：対象者レベルに合わせた言葉づかい。持ち時間に収まる分量。各段階に「目安時間（分）」と「講師が実際に話すセリフ（です・ます調の話し言葉）」を入れる。専門用語はかみくだく。個人名は出さない。
ユーザーの条件（テーマ/対象者/持ち時間/含めたい用語/補足希望）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;title&quot;: &quot;台本タイトル&quot;,
  &quot;totalMin&quot;: 30,
  &quot;sections&quot;: [
    {&quot;phase&quot;: &quot;導入&quot;, &quot;min&quot;: 5, &quot;script&quot;: &quot;講師が話すセリフ（話し言葉）&quot;, &quot;points&quot;: [&quot;この段階の要点を1〜2個&quot;]},
    {&quot;phase&quot;: &quot;概要&quot;, &quot;min&quot;: 5, &quot;script&quot;: &quot;...&quot;, &quot;points&quot;: [&quot;...&quot;]},
    {&quot;phase&quot;: &quot;要点&quot;, &quot;min&quot;: 6, &quot;script&quot;: &quot;...&quot;, &quot;points&quot;: [&quot;...&quot;]},
    {&quot;phase&quot;: &quot;説明&quot;, &quot;min&quot;: 8, &quot;script&quot;: &quot;...&quot;, &quot;points&quot;: [&quot;...&quot;]},
    {&quot;phase&quot;: &quot;正式には&quot;, &quot;min&quot;: 3, &quot;script&quot;: &quot;...&quot;, &quot;points&quot;: [&quot;...&quot;]},
    {&quot;phase&quot;: &quot;補足&quot;, &quot;min&quot;: 3, &quot;script&quot;: &quot;...&quot;, &quot;points&quot;: [&quot;...&quot;]}
  ]
}`;

var PHASE_ICON={&quot;導入&quot;:&quot;🚪&quot;,&quot;概要&quot;:&quot;🗺&quot;,&quot;要点&quot;:&quot;📌&quot;,&quot;説明&quot;:&quot;📖&quot;,&quot;正式には&quot;:&quot;📐&quot;,&quot;補足&quot;:&quot;➕&quot;};
var FIELD_TAGS=[&quot;🚪 導入&quot;,&quot;🗺 概要&quot;,&quot;📌 要点&quot;,&quot;📖 説明&quot;,&quot;📐 正式には&quot;,&quot;➕ 補足&quot;];
var result=null, tab=&quot;input&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }
function readForm(){
  return { topic:($(&quot;f_topic&quot;).value||&quot;&quot;).trim(), level:$(&quot;f_level&quot;).value, time:$(&quot;f_time&quot;).value,
    terms:($(&quot;f_terms&quot;).value||&quot;&quot;).trim(), note:($(&quot;f_note&quot;).value||&quot;&quot;).trim() };
}
function buildUserMsg(){
  var f=readForm();
  return [&quot;## 説明台本の条件&quot;,
    &quot;【テーマ】&quot;+(f.topic||&quot;未入力&quot;),
    &quot;【対象者レベル】&quot;+f.level,
    &quot;【持ち時間】&quot;+f.time,
    &quot;【含めたい用語】&quot;+(f.terms||&quot;指定なし&quot;),
    &quot;【補足希望】&quot;+(f.note||&quot;なし&quot;)].join(&quot;\n&quot;);
}

function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(80,180,120,.16);border:1px solid rgba(80,180,120,.32);border-radius:20px;padding:3px 11px;font-size:11px;color:#86d9a3;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}

function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}

function importJson(){
  setErr(&quot;&quot;);
  try{
    var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}

function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function scriptToText(){
  if(!result) return &quot;&quot;;
  var lines=[&quot;【&quot;+(result.title||&quot;説明台本&quot;)+&quot;】（合計&quot;+(result.totalMin||&quot;&quot;)+&quot;分）&quot;,&quot;&quot;];
  (result.sections||[]).forEach(function(s){
    lines.push(&quot;■ &quot;+(s.phase||&quot;&quot;)+&quot;（&quot;+(s.min||&quot;-&quot;)+&quot;分）&quot;);
    lines.push(s.script||&quot;&quot;);
    if(s.points&amp;&amp;s.points.length){ lines.push(&quot;　ポイント：&quot;+s.points.join(&quot; / &quot;)); }
    lines.push(&quot;&quot;);
  });
  return lines.join(&quot;\n&quot;);
}

function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  $(&quot;scriptTitle&quot;).textContent=&quot;🎬 &quot;+(result.title||&quot;説明台本&quot;)+&quot;（合計&quot;+(result.totalMin||&quot;&quot;)+&quot;分）&quot;;
  var v=$(&quot;scriptView&quot;); v.innerHTML=(result.sections||[]).map(function(s,i){
    var ic=PHASE_ICON[s.phase]||&quot;▶&quot;;
    var pts=(s.points||[]).map(function(p){return '<li style=&quot;margin:3px 0;&quot;>'+esc(p)+'</li>';}).join(&quot;&quot;);
    return '<div class=&quot;card&quot; style=&quot;margin-bottom:12px;border-left:3px solid #50b478;&quot;>'+
      '<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;&quot;>'+
      '<h3 style=&quot;margin:0;font-size:14px;color:#86d9a3;font-weight:800;&quot;>'+ic+' '+(i+1)+'. '+esc(s.phase||&quot;&quot;)+'</h3>'+
      '<span style=&quot;background:rgba(80,180,120,.18);border:1px solid rgba(80,180,120,.34);border-radius:20px;padding:2px 11px;font-size:11px;color:#86d9a3;&quot;>'+esc(String(s.min||&quot;-&quot;))+'分</span></div>'+
      '<div style=&quot;white-space:pre-wrap;word-break:break-word;font-size:13px;color:#e8f3ea;line-height:1.95;&quot;>'+esc(s.script||&quot;&quot;)+'</div>'+
      (pts?'<div style=&quot;margin-top:10px;border-top:1px solid rgba(255,255,255,.08);padding-top:8px;&quot;><p style=&quot;margin:0 0 4px;font-size:11px;font-weight:700;color:#7faa86;&quot;>📌 ポイント</p><ul style=&quot;margin:0;padding-left:18px;font-size:12px;color:#a9ccb2;&quot;>'+pts+'</ul></div>':'')+
      '</div>';
  }).join(&quot;&quot;);
  var cab=$(&quot;copyAllBtn&quot;);
  cab.onclick=function(){ copyToClip(scriptToText()); var o=cab.textContent; cab.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ cab.textContent=o; },2000); };
}

renderTags();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-scriptapi" title="説明台本APIあり" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 説明台本ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#15331f,#1c3f28 55%,#13311d);color:#e8f3ea;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(80,180,120,.5);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.88}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.05);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.09);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#7faa86;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(80,180,120,.22);border-bottom:2px solid #50b478;color:#86d9a3;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#7faa86;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(80,180,120,.34);border:1px solid #50b478;color:#86d9a3;}
  label{display:block;font-size:12px;font-weight:700;color:#a9ccb2;margin-bottom:6px;}
  textarea,input[type=password],select{width:100%;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.12);
    border-radius:8px;padding:10px 12px;color:#e8f3ea;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#50b478,#2c7a50);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>🎬</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#86d9a3,#50b478);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>説明台本ジェネレーター</h1>
      <p style=&quot;margin:0;font-size:11px;color:#7faa86;&quot; id=&quot;subtitle&quot;>【APIキー版】キーを入れると6段階の説明台本を自動生成します</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 入力</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>🎬 台本</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0;font-size:12px;color:#a9ccb2;line-height:1.7;&quot;>💡 うさうさ式6段階フレーム：<b style=&quot;color:#86d9a3;&quot;>導入 → 概要 → 要点 → 説明（具体的に・たとえ）→ 正式には（正確な定義）→ 補足（試験ポイント・まとめ）</b>で、30分の説明台本を作ります。</p>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;border-left:3px solid #50b478;&quot;>
      <label>📚 説明テーマ</label>
      <input id=&quot;f_topic&quot; placeholder=&quot;例：Linuxのファイルパーミッション（chmod）&quot;>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #5bbf82;&quot;>
        <label>🎓 対象者レベル</label>
        <select id=&quot;f_level&quot;><option value=&quot;初学者（非IT・新卒）&quot;>初学者（非IT・新卒）</option><option value=&quot;初級（学習開始数週間）&quot;>初級（学習開始数週間）</option><option value=&quot;中級（実務少しあり）&quot;>中級（実務少しあり）</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #4a9a6a;&quot;>
        <label>⏱ 持ち時間</label>
        <select id=&quot;f_time&quot;><option value=&quot;30分&quot;>30分</option><option value=&quot;15分&quot;>15分</option><option value=&quot;45分&quot;>45分</option><option value=&quot;60分&quot;>60分</option></select>
      </div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>🔑 含めたい用語・キーワード（任意・カンマ区切り）</label>
      <input id=&quot;f_terms&quot; placeholder=&quot;所有者, グループ, その他, 読み取り, 書き込み, 実行, rwx, 数値表記&quot;>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>📝 補足の希望（たとえ・演習・試験ポイントなど・任意）</label>
      <textarea id=&quot;f_note&quot; placeholder=&quot;うさうさラーメン店のたとえを使いたい／最後に簡単な演習を1問入れたい&quot;></textarea>
    </div>

    <div class=&quot;card&quot; id=&quot;apiKeyCard&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>🔑 Anthropic APIキー（任意・入れると自動生成）</label>
      <input type=&quot;password&quot; id=&quot;apiKey&quot; placeholder=&quot;sk-ant-... （未入力なら下の手動コピーを使用）&quot;>
      <p style=&quot;margin:6px 0 0;font-size:10px;color:#6a8f72;&quot;>※キーはこの画面内だけで使われ、保存も外部送信もされません（Anthropic API以外には送りません）。</p>
    </div>

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    <button class=&quot;btn&quot; id=&quot;analyzeBtn&quot; onclick=&quot;handleAnalyze()&quot; style=&quot;width:100%;padding:15px;background:linear-gradient(135deg,#2c7a50,#1f5d3c);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;&quot;>🎬 説明台本を生成する</button>

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#a9ccb2;&quot;>🛠 APIキーがない場合（手動）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#6a8f72;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(80,180,120,.2);border:1px solid #50b478;border-radius:8px;padding:7px 14px;color:#86d9a3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:7px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで台本を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#a9ccb2;&quot;>✨ 生成される6段階</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#5a7a62;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>🎬</div>
      <p>「入力」タブでテーマを入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:10px;flex-wrap:wrap;&quot;>
        <h2 id=&quot;scriptTitle&quot; style=&quot;margin:0;font-size:16px;color:#86d9a3;&quot;></h2>
        <button class=&quot;btn&quot; id=&quot;copyAllBtn&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:6px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 台本全体をコピー</button>
      </div>
      <div id=&quot;scriptView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「IT研修の説明台本ライター」です。講師が話す説明の台本（スクリプト）を、うさうさ式6段階フレームで作ります。
6段階：1.導入（つかみ・今日のゴール）2.概要（全体像）3.要点（押さえるキーワード）4.説明（具体的に・たとえで深掘り）5.正式には（正確な定義・公式表現）6.補足（試験ポイント・まとめ・必要なら演習）。
方針：対象者レベルに合わせた言葉づかい。持ち時間に収まる分量。各段階に「目安時間（分）」と「講師が実際に話すセリフ（です・ます調の話し言葉）」を入れる。専門用語はかみくだく。個人名は出さない。
ユーザーの条件（テーマ/対象者/持ち時間/含めたい用語/補足希望）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;title&quot;: &quot;台本タイトル&quot;,
  &quot;totalMin&quot;: 30,
  &quot;sections&quot;: [
    {&quot;phase&quot;: &quot;導入&quot;, &quot;min&quot;: 5, &quot;script&quot;: &quot;講師が話すセリフ（話し言葉）&quot;, &quot;points&quot;: [&quot;この段階の要点を1〜2個&quot;]},
    {&quot;phase&quot;: &quot;概要&quot;, &quot;min&quot;: 5, &quot;script&quot;: &quot;...&quot;, &quot;points&quot;: [&quot;...&quot;]},
    {&quot;phase&quot;: &quot;要点&quot;, &quot;min&quot;: 6, &quot;script&quot;: &quot;...&quot;, &quot;points&quot;: [&quot;...&quot;]},
    {&quot;phase&quot;: &quot;説明&quot;, &quot;min&quot;: 8, &quot;script&quot;: &quot;...&quot;, &quot;points&quot;: [&quot;...&quot;]},
    {&quot;phase&quot;: &quot;正式には&quot;, &quot;min&quot;: 3, &quot;script&quot;: &quot;...&quot;, &quot;points&quot;: [&quot;...&quot;]},
    {&quot;phase&quot;: &quot;補足&quot;, &quot;min&quot;: 3, &quot;script&quot;: &quot;...&quot;, &quot;points&quot;: [&quot;...&quot;]}
  ]
}`;

var PHASE_ICON={&quot;導入&quot;:&quot;🚪&quot;,&quot;概要&quot;:&quot;🗺&quot;,&quot;要点&quot;:&quot;📌&quot;,&quot;説明&quot;:&quot;📖&quot;,&quot;正式には&quot;:&quot;📐&quot;,&quot;補足&quot;:&quot;➕&quot;};
var FIELD_TAGS=[&quot;🚪 導入&quot;,&quot;🗺 概要&quot;,&quot;📌 要点&quot;,&quot;📖 説明&quot;,&quot;📐 正式には&quot;,&quot;➕ 補足&quot;];
var result=null, tab=&quot;input&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }
function readForm(){
  return { topic:($(&quot;f_topic&quot;).value||&quot;&quot;).trim(), level:$(&quot;f_level&quot;).value, time:$(&quot;f_time&quot;).value,
    terms:($(&quot;f_terms&quot;).value||&quot;&quot;).trim(), note:($(&quot;f_note&quot;).value||&quot;&quot;).trim() };
}
function buildUserMsg(){
  var f=readForm();
  return [&quot;## 説明台本の条件&quot;,
    &quot;【テーマ】&quot;+(f.topic||&quot;未入力&quot;),
    &quot;【対象者レベル】&quot;+f.level,
    &quot;【持ち時間】&quot;+f.time,
    &quot;【含めたい用語】&quot;+(f.terms||&quot;指定なし&quot;),
    &quot;【補足希望】&quot;+(f.note||&quot;なし&quot;)].join(&quot;\n&quot;);
}

function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(80,180,120,.16);border:1px solid rgba(80,180,120,.32);border-radius:20px;padding:3px 11px;font-size:11px;color:#86d9a3;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}

function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}

function handleAnalyze(){
  var f=readForm();
  if(!f.topic){ setErr(&quot;「説明テーマ」を入力してください&quot;); return; }
  var key=$(&quot;apiKey&quot;)?$(&quot;apiKey&quot;).value.trim():&quot;&quot;;
  if(!key){ setErr(&quot;APIキーが未入力です。下の「手動プロンプトをコピー」を使うか、APIキーを入力してください。&quot;); return; }
  setErr(&quot;&quot;);
  var btn=$(&quot;analyzeBtn&quot;); btn.disabled=true; btn.innerHTML='<span class=&quot;pulse&quot;>🎬</span> 生成中…';
  fetch(&quot;https://api.anthropic.com/v1/messages&quot;,{
    method:&quot;POST&quot;,
    headers:{ &quot;Content-Type&quot;:&quot;application/json&quot;,&quot;anthropic-version&quot;:&quot;2023-06-01&quot;,&quot;anthropic-dangerous-direct-browser-access&quot;:&quot;true&quot;,&quot;x-api-key&quot;:key },
    body:JSON.stringify({ model:&quot;claude-sonnet-4-5&quot;, max_tokens:4000, system:SYSTEM_PROMPT, messages:[{role:&quot;user&quot;,content:buildUserMsg()}] })
  }).then(function(res){ return res.json().then(function(data){ return {ok:res.ok,status:res.status,data:data}; }); })
   .then(function(r){
     if(!r.ok || r.data.error) throw new Error((r.data.error&amp;&amp;r.data.error.message)||(&quot;HTTP &quot;+r.status));
     var raw=(r.data.content||[]).map(function(c){return c.text||&quot;&quot;;}).join(&quot;&quot;);
     var m=raw.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりませんでした&quot;);
     result=JSON.parse(m[0]); setTab(&quot;result&quot;);
   }).catch(function(e){ setErr(&quot;生成に失敗しました: &quot;+e.message+&quot;（CORSやAPIキーをご確認ください。手動コピーも使えます）&quot;); })
   .then(function(){ btn.disabled=false; btn.innerHTML=&quot;🎬 説明台本を生成する&quot;; });
}

function importJson(){
  setErr(&quot;&quot;);
  try{
    var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}

function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function scriptToText(){
  if(!result) return &quot;&quot;;
  var lines=[&quot;【&quot;+(result.title||&quot;説明台本&quot;)+&quot;】（合計&quot;+(result.totalMin||&quot;&quot;)+&quot;分）&quot;,&quot;&quot;];
  (result.sections||[]).forEach(function(s){
    lines.push(&quot;■ &quot;+(s.phase||&quot;&quot;)+&quot;（&quot;+(s.min||&quot;-&quot;)+&quot;分）&quot;);
    lines.push(s.script||&quot;&quot;);
    if(s.points&amp;&amp;s.points.length){ lines.push(&quot;　ポイント：&quot;+s.points.join(&quot; / &quot;)); }
    lines.push(&quot;&quot;);
  });
  return lines.join(&quot;\n&quot;);
}

function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  $(&quot;scriptTitle&quot;).textContent=&quot;🎬 &quot;+(result.title||&quot;説明台本&quot;)+&quot;（合計&quot;+(result.totalMin||&quot;&quot;)+&quot;分）&quot;;
  var v=$(&quot;scriptView&quot;); v.innerHTML=(result.sections||[]).map(function(s,i){
    var ic=PHASE_ICON[s.phase]||&quot;▶&quot;;
    var pts=(s.points||[]).map(function(p){return '<li style=&quot;margin:3px 0;&quot;>'+esc(p)+'</li>';}).join(&quot;&quot;);
    return '<div class=&quot;card&quot; style=&quot;margin-bottom:12px;border-left:3px solid #50b478;&quot;>'+
      '<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;&quot;>'+
      '<h3 style=&quot;margin:0;font-size:14px;color:#86d9a3;font-weight:800;&quot;>'+ic+' '+(i+1)+'. '+esc(s.phase||&quot;&quot;)+'</h3>'+
      '<span style=&quot;background:rgba(80,180,120,.18);border:1px solid rgba(80,180,120,.34);border-radius:20px;padding:2px 11px;font-size:11px;color:#86d9a3;&quot;>'+esc(String(s.min||&quot;-&quot;))+'分</span></div>'+
      '<div style=&quot;white-space:pre-wrap;word-break:break-word;font-size:13px;color:#e8f3ea;line-height:1.95;&quot;>'+esc(s.script||&quot;&quot;)+'</div>'+
      (pts?'<div style=&quot;margin-top:10px;border-top:1px solid rgba(255,255,255,.08);padding-top:8px;&quot;><p style=&quot;margin:0 0 4px;font-size:11px;font-weight:700;color:#7faa86;&quot;>📌 ポイント</p><ul style=&quot;margin:0;padding-left:18px;font-size:12px;color:#a9ccb2;&quot;>'+pts+'</ul></div>':'')+
      '</div>';
  }).join(&quot;&quot;);
  var cab=$(&quot;copyAllBtn&quot;);
  cab.onclick=function(){ copyToClip(scriptToText()); var o=cab.textContent; cab.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ cab.textContent=o; },2000); };
}

renderTags();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-horenso" title="報連相APIなし" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 報連相・敬語ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#102a2e,#143a3a 55%,#0f2a30);color:#eaf3f1;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(70,170,160,.5);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.88}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.05);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.09);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#7faaa3;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(70,170,160,.22);border-bottom:2px solid #46aaa0;color:#7fd9cc;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#7faaa3;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(70,170,160,.34);border:1px solid #46aaa0;color:#7fd9cc;}
  label{display:block;font-size:12px;font-weight:700;color:#a9ccc6;margin-bottom:6px;}
  textarea,input[type=password],select{width:100%;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.12);
    border-radius:8px;padding:10px 12px;color:#eaf3f1;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#46aaa0,#2c7a72);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>💬</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#7fd9cc,#46aaa0);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>報連相・敬語ジェネレーター</h1>
      <p style=&quot;margin:0;font-size:11px;color:#7faaa3;&quot; id=&quot;subtitle&quot;>【APIキーなし版】完全オフライン。手動プロンプト→AIに貼付→JSON取り込み</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 入力</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>📊 結果</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #46aaa0;&quot;>
        <label>🗂 場面</label>
        <select id=&quot;f_scene&quot;><option value=&quot;報告&quot;>報告（結果を伝える）</option><option value=&quot;連絡&quot;>連絡（情報を共有）</option><option value=&quot;相談&quot;>相談（判断を仰ぐ）</option><option value=&quot;MTG調整&quot;>MTG調整（日程・議題）</option><option value=&quot;交渉・提案&quot;>交渉・提案</option><option value=&quot;認識合わせ&quot;>認識合わせ（確認）</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #5bbcae;&quot;>
        <label>👤 相手（役職名）</label>
        <select id=&quot;f_to&quot;><option value=&quot;上長&quot;>上長</option><option value=&quot;メイン講師&quot;>メイン講師</option><option value=&quot;サブ講師&quot;>サブ講師</option><option value=&quot;人事担当&quot;>人事担当</option><option value=&quot;社外担当者&quot;>社外担当者</option><option value=&quot;チーム全体&quot;>チーム全体</option></select>
      </div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>📨 伝えたい内容（メモ・カジュアルでOK）</label>
      <textarea id=&quot;f_content&quot; placeholder=&quot;例：今日の研修、演習2でつまずく人が多かった。明日は補足資料を足したい。確認してほしい。&quot;></textarea>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #4a9aa0;&quot;>
        <label>🎚 丁寧度</label>
        <select id=&quot;f_tone&quot;><option value=&quot;丁寧（フォーマル）&quot;>丁寧（フォーマル・上長/社外向け）</option><option value=&quot;標準（ていねい敬語）&quot; selected>標準（ていねい敬語・同僚向け）</option><option value=&quot;ややカジュアル&quot;>ややカジュアル（親しい間柄）</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #3f8f8a;&quot;>
        <label>🛠 ツール（任意）</label>
        <select id=&quot;f_channel&quot;><option value=&quot;チャット（Slack/Teams）&quot;>チャット（Slack/Teams）</option><option value=&quot;メール&quot;>メール</option><option value=&quot;口頭・対面&quot;>口頭・対面</option></select>
      </div>
    </div>

    

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#a9ccc6;&quot;>🛠 使い方（3ステップ）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#6a8f8a;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(70,170,160,.2);border:1px solid #46aaa0;border-radius:8px;padding:7px 14px;color:#7fd9cc;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:7px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで結果を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#a9ccc6;&quot;>✨ 生成されるもの</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#5a7a74;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>💬</div>
      <p>「入力」タブで場面と内容を入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:20px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「ビジネスコミュニケーション・敬語コーチ」です。報告・連絡・相談・MTG調整・交渉提案・認識合わせの場面で、適切なチャット/メール文と敬語を整えます。
方針：結論先出し、相手が判断しやすい形、必要なら認識合わせはYES/NOで答えられる形にする。指定された丁寧度に語調を合わせる。個人名は出さず役職名のみ。
ユーザーの状況（場面/相手/伝えたい内容/丁寧度/ツール）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;template&quot;: {
    &quot;channel&quot;: &quot;ツール&quot;,
    &quot;subject&quot;: &quot;件名（メールのとき。チャットなら空でよい）&quot;,
    &quot;body&quot;: &quot;整えた本文（結論先出し・丁寧度に合わせる）&quot;
  },
  &quot;keigo&quot;: {
    &quot;points&quot;: [&quot;この場面の敬語のポイントを2〜3個&quot;],
    &quot;fixes&quot;: [{&quot;ng&quot;: &quot;ありがちなカジュアル/誤った表現&quot;, &quot;ok&quot;: &quot;推奨する敬語表現&quot;}]
  },
  &quot;alignment&quot;: {
    &quot;intro&quot;: &quot;認識合わせの一言&quot;,
    &quot;questions&quot;: [&quot;YES/NOで答えられる確認文を2〜3個&quot;]
  },
  &quot;practice&quot;: [
    {&quot;casual&quot;: &quot;カジュアルな言い方&quot;, &quot;answer&quot;: &quot;敬語に直した模範解答&quot;}
  ]
}`;

var FIELD_TAGS=[&quot;💬 チャットテンプレ&quot;,&quot;🙇 敬語チェック&quot;,&quot;✅ 認識合わせ&quot;,&quot;📝 敬語練習&quot;];
var result=null, tab=&quot;input&quot;, viewTab=&quot;template&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }
function readForm(){
  return { scene:$(&quot;f_scene&quot;).value, to:$(&quot;f_to&quot;).value, content:($(&quot;f_content&quot;).value||&quot;&quot;).trim(),
    tone:($(&quot;f_tone&quot;)?$(&quot;f_tone&quot;).value:&quot;標準（ていねい敬語）&quot;), channel:$(&quot;f_channel&quot;).value };
}
function buildUserMsg(){
  var f=readForm();
  return [&quot;## コミュニケーションの状況&quot;,
    &quot;【場面】&quot;+f.scene,
    &quot;【相手】&quot;+f.to,
    &quot;【伝えたい内容】&quot;+(f.content||&quot;未入力&quot;),
    &quot;【丁寧度】&quot;+f.tone,
    &quot;【ツール】&quot;+f.channel].join(&quot;\n&quot;);
}

function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(70,170,160,.16);border:1px solid rgba(70,170,160,.32);border-radius:20px;padding:3px 11px;font-size:11px;color:#7fd9cc;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}

function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}

function importJson(){
  setErr(&quot;&quot;);
  try{
    var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}

function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function copyBtn(btn, text){ copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000); }

var SUBTABS=[[&quot;template&quot;,&quot;💬 チャットテンプレ&quot;],[&quot;keigo&quot;,&quot;🙇 敬語チェック&quot;],[&quot;alignment&quot;,&quot;✅ 認識合わせ&quot;],[&quot;practice&quot;,&quot;📝 敬語練習&quot;]];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBTABS.forEach(function(p){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===p[0]?&quot; active&quot;:&quot;&quot;); b.textContent=p[1];
    b.onclick=function(){ viewTab=p[0]; renderResult(); };
    st.appendChild(b);
  });
  var v=$(&quot;resultView&quot;); v.innerHTML=renderView();
  [].slice.call(v.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); }); });
  [].slice.call(v.querySelectorAll(&quot;[data-reveal]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ var t=document.getElementById(b.getAttribute(&quot;data-reveal&quot;)); if(t) t.style.display=(t.style.display===&quot;none&quot;?&quot;block&quot;:&quot;none&quot;); }); });
}
function card(inner){ return '<div class=&quot;card&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;template&quot;) return viewTemplate();
  if(viewTab===&quot;keigo&quot;) return viewKeigo();
  if(viewTab===&quot;alignment&quot;) return viewAlignment();
  if(viewTab===&quot;practice&quot;) return viewPractice();
  return &quot;&quot;;
}
function viewTemplate(){
  var t=result.template||{};
  var full=(t.subject?(&quot;件名：&quot;+t.subject+&quot;\n\n&quot;):&quot;&quot;)+(t.body||&quot;&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#a9ccc6;font-weight:700;&quot;>💬 チャット/メール テンプレ'+(t.channel?'（'+esc(t.channel)+'）':'')+'</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(full)+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  h+=card((t.subject?'<p style=&quot;margin:0 0 10px;font-size:12px;color:#7faaa3;&quot;>件名：'+esc(t.subject)+'</p>':'')+
    '<div style=&quot;white-space:pre-wrap;word-break:break-word;font-size:13px;color:#eaf3f1;line-height:1.9;&quot;>'+esc(t.body||&quot;（未入力）&quot;)+'</div>');
  return h;
}
function viewKeigo(){
  var k=result.keigo||{};
  var pts=(k.points||[]).map(function(p){return '<li style=&quot;margin:4px 0;&quot;>'+esc(p)+'</li>';}).join(&quot;&quot;);
  var fixes=(k.fixes||[]).map(function(fx){
    return '<div style=&quot;display:flex;gap:10px;align-items:flex-start;margin:8px 0;padding:10px;background:rgba(0,0,0,.18);border-radius:8px;&quot;>'+
      '<div style=&quot;flex:1;&quot;><div style=&quot;font-size:11px;color:#e8928a;margin-bottom:2px;&quot;>✗ '+esc(fx.ng)+'</div>'+
      '<div style=&quot;font-size:13px;color:#7fd9b3;&quot;>○ '+esc(fx.ok)+'</div></div></div>';
  }).join(&quot;&quot;);
  var h='<h3 style=&quot;margin:0 0 14px;font-size:15px;color:#a9ccc6;font-weight:700;&quot;>🙇 敬語のポイント＆言い換え</h3>';
  h+=card((pts?'<p style=&quot;margin:0 0 6px;font-size:12px;font-weight:700;color:#7faaa3;&quot;>📌 ポイント</p><ul style=&quot;margin:0 0 12px;padding-left:18px;font-size:12px;color:#a9ccc6;&quot;>'+pts+'</ul>':'')+
    (fixes?'<p style=&quot;margin:0 0 4px;font-size:12px;font-weight:700;color:#7faaa3;&quot;>🔁 言い換え（✗→○）</p>'+fixes:'<p style=&quot;color:#5a7a74;font-size:12px;&quot;>言い換えデータがありません</p>'));
  return h;
}
function viewAlignment(){
  var a=result.alignment||{};
  var qs=(a.questions||[]).map(function(q,i){return '<div style=&quot;display:flex;gap:8px;align-items:flex-start;margin:6px 0;&quot;><span style=&quot;color:#46aaa0;font-weight:700;&quot;>'+(i+1)+'.</span><span style=&quot;font-size:13px;color:#eaf3f1;&quot;>'+esc(q)+'</span></div>';}).join(&quot;&quot;);
  var copyText=(a.intro||&quot;&quot;)+&quot;\n\n&quot;+(a.questions||[]).map(function(q,i){return (i+1)+&quot;. &quot;+q;}).join(&quot;\n&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#a9ccc6;font-weight:700;&quot;>✅ 認識合わせ（YES/NOで確認）</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(copyText)+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  h+=card((a.intro?'<p style=&quot;margin:0 0 10px;font-size:13px;color:#eaf3f1;&quot;>'+esc(a.intro)+'</p>':'')+(qs||'<p style=&quot;color:#5a7a74;font-size:12px;&quot;>確認文がありません</p>'));
  return h;
}
function viewPractice(){
  var pr=result.practice||[];
  var h='<h3 style=&quot;margin:0 0 14px;font-size:15px;color:#a9ccc6;font-weight:700;&quot;>📝 敬語練習（カジュアル→敬語に直す）</h3>';
  if(!pr.length) return h+card('<p style=&quot;color:#5a7a74;font-size:12px;&quot;>練習問題がありません</p>');
  h+='<div style=&quot;display:flex;flex-direction:column;gap:10px;&quot;>';
  pr.forEach(function(p,i){
    var aid=&quot;ans_&quot;+i;
    h+=card('<p style=&quot;margin:0 0 8px;font-size:13px;color:#eaf3f1;&quot;><span style=&quot;color:#7faaa3;font-weight:700;&quot;>Q'+(i+1)+'.</span> 「'+esc(p.casual)+'」を敬語に直すと？</p>'+
      '<button class=&quot;btn&quot; data-reveal=&quot;'+aid+'&quot; style=&quot;background:rgba(70,170,160,.2);border:1px solid #46aaa0;border-radius:8px;padding:5px 12px;color:#7fd9cc;font-size:11px;cursor:pointer;font-weight:600;&quot;>💡 模範解答を見る</button>'+
      '<div id=&quot;'+aid+'&quot; style=&quot;display:none;margin-top:8px;padding:10px;background:rgba(31,157,107,.12);border-left:3px solid #1f9d6b;border-radius:6px;font-size:13px;color:#7fd9b3;&quot;>'+esc(p.answer)+'</div>');
  });
  h+='</div>';
  return h;
}

renderTags();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-horensoapi" title="報連相APIあり" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 報連相・敬語ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#102a2e,#143a3a 55%,#0f2a30);color:#eaf3f1;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(70,170,160,.5);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.88}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.05);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.09);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#7faaa3;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(70,170,160,.22);border-bottom:2px solid #46aaa0;color:#7fd9cc;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#7faaa3;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(70,170,160,.34);border:1px solid #46aaa0;color:#7fd9cc;}
  label{display:block;font-size:12px;font-weight:700;color:#a9ccc6;margin-bottom:6px;}
  textarea,input[type=password],select{width:100%;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.12);
    border-radius:8px;padding:10px 12px;color:#eaf3f1;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#46aaa0,#2c7a72);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>💬</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#7fd9cc,#46aaa0);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>報連相・敬語ジェネレーター</h1>
      <p style=&quot;margin:0;font-size:11px;color:#7faaa3;&quot; id=&quot;subtitle&quot;>【APIキー版】キーを入れると自動分析。報連相・MTG・交渉・認識合わせの文章と敬語練習</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 入力</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>📊 結果</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #46aaa0;&quot;>
        <label>🗂 場面</label>
        <select id=&quot;f_scene&quot;><option value=&quot;報告&quot;>報告（結果を伝える）</option><option value=&quot;連絡&quot;>連絡（情報を共有）</option><option value=&quot;相談&quot;>相談（判断を仰ぐ）</option><option value=&quot;MTG調整&quot;>MTG調整（日程・議題）</option><option value=&quot;交渉・提案&quot;>交渉・提案</option><option value=&quot;認識合わせ&quot;>認識合わせ（確認）</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #5bbcae;&quot;>
        <label>👤 相手（役職名）</label>
        <select id=&quot;f_to&quot;><option value=&quot;上長&quot;>上長</option><option value=&quot;メイン講師&quot;>メイン講師</option><option value=&quot;サブ講師&quot;>サブ講師</option><option value=&quot;人事担当&quot;>人事担当</option><option value=&quot;社外担当者&quot;>社外担当者</option><option value=&quot;チーム全体&quot;>チーム全体</option></select>
      </div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>📨 伝えたい内容（メモ・カジュアルでOK）</label>
      <textarea id=&quot;f_content&quot; placeholder=&quot;例：今日の研修、演習2でつまずく人が多かった。明日は補足資料を足したい。確認してほしい。&quot;></textarea>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #4a9aa0;&quot;>
        <label>🎚 丁寧度</label>
        <select id=&quot;f_tone&quot;><option value=&quot;丁寧（フォーマル）&quot;>丁寧（フォーマル・上長/社外向け）</option><option value=&quot;標準（ていねい敬語）&quot; selected>標準（ていねい敬語・同僚向け）</option><option value=&quot;ややカジュアル&quot;>ややカジュアル（親しい間柄）</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #3f8f8a;&quot;>
        <label>🛠 ツール（任意）</label>
        <select id=&quot;f_channel&quot;><option value=&quot;チャット（Slack/Teams）&quot;>チャット（Slack/Teams）</option><option value=&quot;メール&quot;>メール</option><option value=&quot;口頭・対面&quot;>口頭・対面</option></select>
      </div>
    </div>

    <div class=&quot;card&quot; id=&quot;apiKeyCard&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>🔑 Anthropic APIキー（任意・入れると自動分析）</label>
      <input type=&quot;password&quot; id=&quot;apiKey&quot; placeholder=&quot;sk-ant-... （未入力なら下の手動コピーを使用）&quot;>
      <p style=&quot;margin:6px 0 0;font-size:10px;color:#6a8f8a;&quot;>※キーはこの画面内だけで使われ、保存も外部送信もされません（Anthropic API以外には送りません）。</p>
    </div>

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    <button class=&quot;btn&quot; id=&quot;analyzeBtn&quot; onclick=&quot;handleAnalyze()&quot; style=&quot;width:100%;padding:15px;background:linear-gradient(135deg,#2c7a72,#1f5d57);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;&quot;>💬 文章と敬語練習を生成する</button>

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#a9ccc6;&quot;>🛠 APIキーがない場合（手動）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#6a8f8a;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(70,170,160,.2);border:1px solid #46aaa0;border-radius:8px;padding:7px 14px;color:#7fd9cc;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:7px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで結果を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#a9ccc6;&quot;>✨ 生成されるもの</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#5a7a74;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>💬</div>
      <p>「入力」タブで場面と内容を入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:20px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「ビジネスコミュニケーション・敬語コーチ」です。報告・連絡・相談・MTG調整・交渉提案・認識合わせの場面で、適切なチャット/メール文と敬語を整えます。
方針：結論先出し、相手が判断しやすい形、必要なら認識合わせはYES/NOで答えられる形にする。指定された丁寧度に語調を合わせる。個人名は出さず役職名のみ。
ユーザーの状況（場面/相手/伝えたい内容/丁寧度/ツール）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;template&quot;: {
    &quot;channel&quot;: &quot;ツール&quot;,
    &quot;subject&quot;: &quot;件名（メールのとき。チャットなら空でよい）&quot;,
    &quot;body&quot;: &quot;整えた本文（結論先出し・丁寧度に合わせる）&quot;
  },
  &quot;keigo&quot;: {
    &quot;points&quot;: [&quot;この場面の敬語のポイントを2〜3個&quot;],
    &quot;fixes&quot;: [{&quot;ng&quot;: &quot;ありがちなカジュアル/誤った表現&quot;, &quot;ok&quot;: &quot;推奨する敬語表現&quot;}]
  },
  &quot;alignment&quot;: {
    &quot;intro&quot;: &quot;認識合わせの一言&quot;,
    &quot;questions&quot;: [&quot;YES/NOで答えられる確認文を2〜3個&quot;]
  },
  &quot;practice&quot;: [
    {&quot;casual&quot;: &quot;カジュアルな言い方&quot;, &quot;answer&quot;: &quot;敬語に直した模範解答&quot;}
  ]
}`;

var FIELD_TAGS=[&quot;💬 チャットテンプレ&quot;,&quot;🙇 敬語チェック&quot;,&quot;✅ 認識合わせ&quot;,&quot;📝 敬語練習&quot;];
var result=null, tab=&quot;input&quot;, viewTab=&quot;template&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }
function readForm(){
  return { scene:$(&quot;f_scene&quot;).value, to:$(&quot;f_to&quot;).value, content:($(&quot;f_content&quot;).value||&quot;&quot;).trim(),
    tone:($(&quot;f_tone&quot;)?$(&quot;f_tone&quot;).value:&quot;標準（ていねい敬語）&quot;), channel:$(&quot;f_channel&quot;).value };
}
function buildUserMsg(){
  var f=readForm();
  return [&quot;## コミュニケーションの状況&quot;,
    &quot;【場面】&quot;+f.scene,
    &quot;【相手】&quot;+f.to,
    &quot;【伝えたい内容】&quot;+(f.content||&quot;未入力&quot;),
    &quot;【丁寧度】&quot;+f.tone,
    &quot;【ツール】&quot;+f.channel].join(&quot;\n&quot;);
}

function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(70,170,160,.16);border:1px solid rgba(70,170,160,.32);border-radius:20px;padding:3px 11px;font-size:11px;color:#7fd9cc;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}

function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}

function handleAnalyze(){
  var f=readForm();
  if(!f.content){ setErr(&quot;「伝えたい内容」を入力してください&quot;); return; }
  var key=$(&quot;apiKey&quot;)?$(&quot;apiKey&quot;).value.trim():&quot;&quot;;
  if(!key){ setErr(&quot;APIキーが未入力です。下の「手動プロンプトをコピー」を使うか、APIキーを入力してください。&quot;); return; }
  setErr(&quot;&quot;);
  var btn=$(&quot;analyzeBtn&quot;); btn.disabled=true; btn.innerHTML='<span class=&quot;pulse&quot;>💬</span> 生成中…';
  fetch(&quot;https://api.anthropic.com/v1/messages&quot;,{
    method:&quot;POST&quot;,
    headers:{ &quot;Content-Type&quot;:&quot;application/json&quot;,&quot;anthropic-version&quot;:&quot;2023-06-01&quot;,&quot;anthropic-dangerous-direct-browser-access&quot;:&quot;true&quot;,&quot;x-api-key&quot;:key },
    body:JSON.stringify({ model:&quot;claude-sonnet-4-5&quot;, max_tokens:4000, system:SYSTEM_PROMPT, messages:[{role:&quot;user&quot;,content:buildUserMsg()}] })
  }).then(function(res){ return res.json().then(function(data){ return {ok:res.ok,status:res.status,data:data}; }); })
   .then(function(r){
     if(!r.ok || r.data.error) throw new Error((r.data.error&amp;&amp;r.data.error.message)||(&quot;HTTP &quot;+r.status));
     var raw=(r.data.content||[]).map(function(c){return c.text||&quot;&quot;;}).join(&quot;&quot;);
     var m=raw.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりませんでした&quot;);
     result=JSON.parse(m[0]); setTab(&quot;result&quot;);
   }).catch(function(e){ setErr(&quot;生成に失敗しました: &quot;+e.message+&quot;（CORSやAPIキーをご確認ください。手動コピーも使えます）&quot;); })
   .then(function(){ btn.disabled=false; btn.innerHTML=&quot;💬 文章と敬語練習を生成する&quot;; });
}

function importJson(){
  setErr(&quot;&quot;);
  try{
    var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}

function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function copyBtn(btn, text){ copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000); }

var SUBTABS=[[&quot;template&quot;,&quot;💬 チャットテンプレ&quot;],[&quot;keigo&quot;,&quot;🙇 敬語チェック&quot;],[&quot;alignment&quot;,&quot;✅ 認識合わせ&quot;],[&quot;practice&quot;,&quot;📝 敬語練習&quot;]];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBTABS.forEach(function(p){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===p[0]?&quot; active&quot;:&quot;&quot;); b.textContent=p[1];
    b.onclick=function(){ viewTab=p[0]; renderResult(); };
    st.appendChild(b);
  });
  var v=$(&quot;resultView&quot;); v.innerHTML=renderView();
  [].slice.call(v.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); }); });
  [].slice.call(v.querySelectorAll(&quot;[data-reveal]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ var t=document.getElementById(b.getAttribute(&quot;data-reveal&quot;)); if(t) t.style.display=(t.style.display===&quot;none&quot;?&quot;block&quot;:&quot;none&quot;); }); });
}
function card(inner){ return '<div class=&quot;card&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;template&quot;) return viewTemplate();
  if(viewTab===&quot;keigo&quot;) return viewKeigo();
  if(viewTab===&quot;alignment&quot;) return viewAlignment();
  if(viewTab===&quot;practice&quot;) return viewPractice();
  return &quot;&quot;;
}
function viewTemplate(){
  var t=result.template||{};
  var full=(t.subject?(&quot;件名：&quot;+t.subject+&quot;\n\n&quot;):&quot;&quot;)+(t.body||&quot;&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#a9ccc6;font-weight:700;&quot;>💬 チャット/メール テンプレ'+(t.channel?'（'+esc(t.channel)+'）':'')+'</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(full)+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  h+=card((t.subject?'<p style=&quot;margin:0 0 10px;font-size:12px;color:#7faaa3;&quot;>件名：'+esc(t.subject)+'</p>':'')+
    '<div style=&quot;white-space:pre-wrap;word-break:break-word;font-size:13px;color:#eaf3f1;line-height:1.9;&quot;>'+esc(t.body||&quot;（未入力）&quot;)+'</div>');
  return h;
}
function viewKeigo(){
  var k=result.keigo||{};
  var pts=(k.points||[]).map(function(p){return '<li style=&quot;margin:4px 0;&quot;>'+esc(p)+'</li>';}).join(&quot;&quot;);
  var fixes=(k.fixes||[]).map(function(fx){
    return '<div style=&quot;display:flex;gap:10px;align-items:flex-start;margin:8px 0;padding:10px;background:rgba(0,0,0,.18);border-radius:8px;&quot;>'+
      '<div style=&quot;flex:1;&quot;><div style=&quot;font-size:11px;color:#e8928a;margin-bottom:2px;&quot;>✗ '+esc(fx.ng)+'</div>'+
      '<div style=&quot;font-size:13px;color:#7fd9b3;&quot;>○ '+esc(fx.ok)+'</div></div></div>';
  }).join(&quot;&quot;);
  var h='<h3 style=&quot;margin:0 0 14px;font-size:15px;color:#a9ccc6;font-weight:700;&quot;>🙇 敬語のポイント＆言い換え</h3>';
  h+=card((pts?'<p style=&quot;margin:0 0 6px;font-size:12px;font-weight:700;color:#7faaa3;&quot;>📌 ポイント</p><ul style=&quot;margin:0 0 12px;padding-left:18px;font-size:12px;color:#a9ccc6;&quot;>'+pts+'</ul>':'')+
    (fixes?'<p style=&quot;margin:0 0 4px;font-size:12px;font-weight:700;color:#7faaa3;&quot;>🔁 言い換え（✗→○）</p>'+fixes:'<p style=&quot;color:#5a7a74;font-size:12px;&quot;>言い換えデータがありません</p>'));
  return h;
}
function viewAlignment(){
  var a=result.alignment||{};
  var qs=(a.questions||[]).map(function(q,i){return '<div style=&quot;display:flex;gap:8px;align-items:flex-start;margin:6px 0;&quot;><span style=&quot;color:#46aaa0;font-weight:700;&quot;>'+(i+1)+'.</span><span style=&quot;font-size:13px;color:#eaf3f1;&quot;>'+esc(q)+'</span></div>';}).join(&quot;&quot;);
  var copyText=(a.intro||&quot;&quot;)+&quot;\n\n&quot;+(a.questions||[]).map(function(q,i){return (i+1)+&quot;. &quot;+q;}).join(&quot;\n&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#a9ccc6;font-weight:700;&quot;>✅ 認識合わせ（YES/NOで確認）</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(copyText)+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  h+=card((a.intro?'<p style=&quot;margin:0 0 10px;font-size:13px;color:#eaf3f1;&quot;>'+esc(a.intro)+'</p>':'')+(qs||'<p style=&quot;color:#5a7a74;font-size:12px;&quot;>確認文がありません</p>'));
  return h;
}
function viewPractice(){
  var pr=result.practice||[];
  var h='<h3 style=&quot;margin:0 0 14px;font-size:15px;color:#a9ccc6;font-weight:700;&quot;>📝 敬語練習（カジュアル→敬語に直す）</h3>';
  if(!pr.length) return h+card('<p style=&quot;color:#5a7a74;font-size:12px;&quot;>練習問題がありません</p>');
  h+='<div style=&quot;display:flex;flex-direction:column;gap:10px;&quot;>';
  pr.forEach(function(p,i){
    var aid=&quot;ans_&quot;+i;
    h+=card('<p style=&quot;margin:0 0 8px;font-size:13px;color:#eaf3f1;&quot;><span style=&quot;color:#7faaa3;font-weight:700;&quot;>Q'+(i+1)+'.</span> 「'+esc(p.casual)+'」を敬語に直すと？</p>'+
      '<button class=&quot;btn&quot; data-reveal=&quot;'+aid+'&quot; style=&quot;background:rgba(70,170,160,.2);border:1px solid #46aaa0;border-radius:8px;padding:5px 12px;color:#7fd9cc;font-size:11px;cursor:pointer;font-weight:600;&quot;>💡 模範解答を見る</button>'+
      '<div id=&quot;'+aid+'&quot; style=&quot;display:none;margin-top:8px;padding:10px;background:rgba(31,157,107,.12);border-left:3px solid #1f9d6b;border-radius:6px;font-size:13px;color:#7fd9b3;&quot;>'+esc(p.answer)+'</div>');
  });
  h+='</div>';
  return h;
}

renderTags();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-deleg" title="業務委譲APIなし" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 業務委譲・交渉ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#2a1530,#3a2018 55%,#241526);color:#f3ece2;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(230,150,90,.5);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.88}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.05);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.09);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#a98c72;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(230,150,90,.22);border-bottom:2px solid #e6965a;color:#f0b483;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#a98c72;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(230,150,90,.34);border:1px solid #e6965a;color:#f0b483;}
  label{display:block;font-size:12px;font-weight:700;color:#cbb39c;margin-bottom:6px;}
  textarea,input[type=password],select{width:100%;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.12);
    border-radius:8px;padding:10px 12px;color:#f3ece2;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#e6965a,#c4612f);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>🤝</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#f0b483,#e6965a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>業務委譲・交渉ジェネレーター</h1>
      <p style=&quot;margin:0;font-size:11px;color:#a98c72;&quot; id=&quot;subtitle&quot;>【APIキーなし版】完全オフライン。手動プロンプト→AIに貼付→JSON取り込み</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 委譲設計</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>📊 結果</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;color:#cbb39c;line-height:1.7;&quot;>💡 鉄則：<b style=&quot;color:#f0b483;&quot;>「受講生の成長」と「マニュアルの定型化」をセットで交渉</b>すると通りやすい。コア業務（登壇・講義）に集中するため、役割を切り分けます。</p>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #e6965a;&quot;>
        <label>👤 誰に振る？</label>
        <select id=&quot;f_to&quot;><option value=&quot;サブ講師・アシスタント&quot;>サブ講師・アシスタント</option><option value=&quot;運営事務・サポートスタッフ&quot;>運営事務・サポートスタッフ</option><option value=&quot;同僚の講師&quot;>同僚の講師</option><option value=&quot;その他&quot;>その他</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #d8a05a;&quot;>
        <label>📦 手放したい業務</label>
        <input id=&quot;f_task&quot; placeholder=&quot;演習の個別質問対応とコードレビュー&quot;>
      </div>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #c4884a;&quot;>
        <label>🚧 一番のボトルネック</label>
        <select id=&quot;f_bottleneck&quot;><option value=&quot;時間が足りない&quot;>時間が足りない</option><option value=&quot;相手のスキルが不安&quot;>相手のスキルが不安</option><option value=&quot;頼みづらい&quot;>頼みづらい</option><option value=&quot;属人化していて渡せない&quot;>属人化していて渡せない</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #b8743a;&quot;>
        <label>🎁 相手に提示できるメリット</label>
        <input id=&quot;f_merit&quot; placeholder=&quot;将来メイン登壇を目指すスキルアップ&quot;>
      </div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;border-left:3px solid #a8632f;&quot;>
      <label>🎚 交渉文のトーン（丁寧度）</label>
      <select id=&quot;f_tone&quot;><option value=&quot;丁寧（フォーマル）&quot;>丁寧（フォーマル・上長/社外向け）</option><option value=&quot;標準（ていねい敬語）&quot; selected>標準（ていねい敬語・同僚向け）</option><option value=&quot;カジュアル（やわらかい）&quot;>カジュアル（やわらかい・親しいサブ講師向け）</option></select>
      <p style=&quot;margin:6px 0 0;font-size:10px;color:#8a7058;&quot;>相手との関係性に合わせて、交渉メッセージの言い回しが変わります。</p>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>📝 補足（背景・関係性・期日など）</label>
      <textarea id=&quot;f_note&quot; placeholder=&quot;来期から新カリキュラム開発に注力したい。相手は半年目のサブ講師。&quot;></textarea>
    </div>

    <!-- APIキー（任意）：apikey版でのみ表示 -->
    

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#cbb39c;&quot;>🛠 使い方（3ステップ）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#8a7058;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(230,150,90,.2);border:1px solid #e6965a;border-radius:8px;padding:7px 14px;color:#f0b483;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:7px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで結果を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#cbb39c;&quot;>✨ 生成されるもの</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#7a6450;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>🤝</div>
      <p>「委譲設計」タブで状況を入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:20px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「業務委譲・交渉アドバイザー」です。忙しいIT研修講師が仕事を上手に振る（委譲する）のを助けます。
鉄則：「受講生の成長」と「マニュアルの定型化」をセットで交渉する。コア業務（登壇・講義）に集中するため役割を切り分ける。
重要：ユーザーが指定する「トーン（丁寧度）」に合わせて、negotiation.message の言い回しを調整してください。「丁寧（フォーマル）」なら最敬語・クッション言葉多め、「標準」なら一般的なていねい敬語、「カジュアル」なら親しみのあるやわらかい口調にします。内容や鉄則は変えず、語調だけ変えます。
ユーザーの状況（誰に振る/手放したい業務/ボトルネック/相手メリット/トーン/補足）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;negotiation&quot;: {
    &quot;to&quot;: &quot;委譲先&quot;,
    &quot;message&quot;: &quot;相手に送る交渉メッセージ本文（相手メリットを先に提示し、YES/NOで答えられる形）&quot;,
    &quot;tips&quot;: [&quot;交渉のコツを2〜3個&quot;]
  },
  &quot;manual&quot;: {
    &quot;title&quot;: &quot;定型化・手順書のタイトル&quot;,
    &quot;steps&quot;: [&quot;手順書/チェックリストにする項目を3〜6個&quot;],
    &quot;why&quot;: &quot;なぜ定型化するか1文&quot;
  },
  &quot;breakdown&quot;: [
    {&quot;task&quot;: &quot;切り出すタスク名&quot;, &quot;owner&quot;: &quot;担当（役職名）&quot;, &quot;note&quot;: &quot;渡し方のポイント&quot;}
  ],
  &quot;tradeoff&quot;: {
    &quot;situation&quot;: &quot;トレードオフが必要な状況&quot;,
    &quot;proposal&quot;: &quot;優先順位を変える交渉案（納期後ろ倒し/他講師調整 等）&quot;,
    &quot;merit&quot;: &quot;これで防げるリスク&quot;
  }
}`;

var FIELD_TAGS=[&quot;🤝 交渉メッセージ&quot;,&quot;📋 手順書・定型化&quot;,&quot;🧩 タスク分解&quot;,&quot;⚖️ トレードオフ案&quot;];
var form={};
var result=null, tab=&quot;input&quot;, viewTab=&quot;negotiation&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }
function readForm(){
  return { to:$(&quot;f_to&quot;).value, task:($(&quot;f_task&quot;).value||&quot;&quot;).trim(), bottleneck:$(&quot;f_bottleneck&quot;).value, merit:($(&quot;f_merit&quot;).value||&quot;&quot;).trim(), tone:($(&quot;f_tone&quot;)?$(&quot;f_tone&quot;).value:&quot;標準（ていねい敬語）&quot;), note:($(&quot;f_note&quot;).value||&quot;&quot;).trim() };
}
function buildUserMsg(){
  var f=readForm();
  return [&quot;## 委譲したい状況&quot;,
    &quot;【誰に振る】&quot;+f.to,
    &quot;【手放したい業務】&quot;+(f.task||&quot;未入力&quot;),
    &quot;【ボトルネック】&quot;+f.bottleneck,
    &quot;【相手メリット】&quot;+(f.merit||&quot;未入力&quot;),
    &quot;【トーン（丁寧度）】&quot;+f.tone,
    &quot;【補足】&quot;+(f.note||&quot;なし&quot;)].join(&quot;\n&quot;);
}

function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(230,150,90,.16);border:1px solid rgba(230,150,90,.32);border-radius:20px;padding:3px 11px;font-size:11px;color:#f0b483;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}

function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}

function importJson(){
  setErr(&quot;&quot;);
  try{
    var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}

function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function copyBtn(btn, text){ copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000); }

var SUBTABS=[[&quot;negotiation&quot;,&quot;🤝 交渉文&quot;],[&quot;manual&quot;,&quot;📋 手順書&quot;],[&quot;breakdown&quot;,&quot;🧩 タスク分解&quot;],[&quot;tradeoff&quot;,&quot;⚖️ トレードオフ&quot;]];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBTABS.forEach(function(p){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===p[0]?&quot; active&quot;:&quot;&quot;); b.textContent=p[1];
    b.onclick=function(){ viewTab=p[0]; renderResult(); };
    st.appendChild(b);
  });
  var v=$(&quot;resultView&quot;); v.innerHTML=renderView();
  [].slice.call(v.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); }); });
}
function card(inner){ return '<div class=&quot;card&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;negotiation&quot;) return viewNegotiation();
  if(viewTab===&quot;manual&quot;) return viewManual();
  if(viewTab===&quot;breakdown&quot;) return viewBreakdown();
  if(viewTab===&quot;tradeoff&quot;) return viewTradeoff();
  return &quot;&quot;;
}
function viewNegotiation(){
  var n=result.negotiation||{};
  var tips=(n.tips||[]).map(function(t){return '<li style=&quot;margin:4px 0;&quot;>'+esc(t)+'</li>';}).join(&quot;&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#cbb39c;font-weight:700;&quot;>🤝 交渉メッセージ'+(n.to?'（→ '+esc(n.to)+'）':'')+'</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(n.message||&quot;&quot;)+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  h+=card('<div style=&quot;white-space:pre-wrap;word-break:break-word;font-size:13px;color:#f3ece2;line-height:1.9;&quot;>'+esc(n.message||&quot;（未入力）&quot;)+'</div>'+
    (tips?'<div style=&quot;margin-top:14px;border-top:1px solid rgba(255,255,255,.08);padding-top:12px;&quot;><p style=&quot;margin:0 0 6px;font-size:12px;font-weight:700;color:#a98c72;&quot;>💡 交渉のコツ</p><ul style=&quot;margin:0;padding-left:18px;font-size:12px;color:#cbb39c;&quot;>'+tips+'</ul></div>':''));
  return h;
}
function viewManual(){
  var m=result.manual||{};
  var steps=(m.steps||[]).map(function(s){return '<div style=&quot;display:flex;gap:8px;align-items:center;margin:5px 0;&quot;><div style=&quot;width:14px;height:14px;border:2px solid #e6965a;border-radius:4px;flex:0 0 14px;&quot;></div><span style=&quot;font-size:12px;color:#f3ece2;&quot;>'+esc(s)+'</span></div>';}).join(&quot;&quot;);
  var mdSteps=(m.steps||[]).map(function(s){return &quot;- [ ] &quot;+s;}).join(&quot;\n&quot;);
  var md=&quot;# &quot;+(m.title||&quot;手順書&quot;)+&quot;\n\n&quot;+(m.why?(&quot;> &quot;+m.why+&quot;\n\n&quot;):&quot;&quot;)+mdSteps;
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#cbb39c;font-weight:700;&quot;>📋 手順書・定型化</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(md)+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  h+=card('<h4 style=&quot;margin:0 0 4px;color:#f0b483;font-size:16px;&quot;>'+esc(m.title||&quot;手順書&quot;)+'</h4>'+(m.why?'<p style=&quot;margin:0 0 12px;color:#a98c72;font-size:12px;&quot;>🎯 '+esc(m.why)+'</p>':'')+steps);
  return h;
}
function viewBreakdown(){
  var bd=result.breakdown||[];
  var h='<h3 style=&quot;margin:0 0 14px;font-size:15px;color:#cbb39c;font-weight:700;&quot;>🧩 タスク分解（切り出すもの）</h3>';
  if(!bd.length) return h+card('<p style=&quot;color:#7a6450;font-size:12px;&quot;>データがありません</p>');
  h+='<div style=&quot;display:flex;flex-direction:column;gap:10px;&quot;>';
  bd.forEach(function(b){
    h+=card('<div style=&quot;display:flex;justify-content:space-between;align-items:flex-start;gap:10px;&quot;><div style=&quot;font-weight:700;font-size:13px;color:#f3ece2;&quot;>'+esc(b.task)+'</div>'+(b.owner?'<span style=&quot;background:rgba(230,150,90,.18);border:1px solid rgba(230,150,90,.34);border-radius:20px;padding:2px 10px;font-size:11px;color:#f0b483;white-space:nowrap;&quot;>'+esc(b.owner)+'</span>':'')+'</div>'+(b.note?'<p style=&quot;margin:6px 0 0;font-size:11px;color:#a98c72;&quot;>💬 '+esc(b.note)+'</p>':''));
  });
  h+='</div>';
  return h;
}
function viewTradeoff(){
  var t=result.tradeoff||{};
  var h='<h3 style=&quot;margin:0 0 14px;font-size:15px;color:#cbb39c;font-weight:700;&quot;>⚖️ トレードオフ案</h3>';
  h+=card('<p style=&quot;margin:0 0 10px;font-size:12px;color:#a98c72;&quot;>状況：'+esc(t.situation||&quot;—&quot;)+'</p>'+
    '<div style=&quot;background:rgba(0,0,0,.2);border-radius:8px;padding:12px;border-left:3px solid #e6965a;margin-bottom:10px;&quot;><p style=&quot;margin:0;font-size:13px;color:#f3ece2;line-height:1.8;&quot;>'+esc(t.proposal||&quot;—&quot;)+'</p></div>'+
    (t.merit?'<p style=&quot;margin:0;font-size:12px;color:#7fd9b3;&quot;>✅ '+esc(t.merit)+'</p>':''));
  return h;
}

renderTags();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-delegapi" title="業務委譲APIあり" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 業務委譲・交渉ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#2a1530,#3a2018 55%,#241526);color:#f3ece2;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(230,150,90,.5);border-radius:3px}
  textarea,input,select{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.88}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.05);border-radius:12px;padding:18px;border:1px solid rgba(255,255,255,0.09);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#a98c72;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(230,150,90,.22);border-bottom:2px solid #e6965a;color:#f0b483;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#a98c72;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(230,150,90,.34);border:1px solid #e6965a;color:#f0b483;}
  label{display:block;font-size:12px;font-weight:700;color:#cbb39c;margin-bottom:6px;}
  textarea,input[type=password],select{width:100%;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.12);
    border-radius:8px;padding:10px 12px;color:#f3ece2;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#e6965a,#c4612f);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>🤝</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#f0b483,#e6965a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>業務委譲・交渉ジェネレーター</h1>
      <p style=&quot;margin:0;font-size:11px;color:#a98c72;&quot; id=&quot;subtitle&quot;>【APIキー版】キーを入れると自動分析。仕事を上手に振る交渉文を作ります</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 委譲設計</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>📊 結果</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;color:#cbb39c;line-height:1.7;&quot;>💡 鉄則：<b style=&quot;color:#f0b483;&quot;>「受講生の成長」と「マニュアルの定型化」をセットで交渉</b>すると通りやすい。コア業務（登壇・講義）に集中するため、役割を切り分けます。</p>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #e6965a;&quot;>
        <label>👤 誰に振る？</label>
        <select id=&quot;f_to&quot;><option value=&quot;サブ講師・アシスタント&quot;>サブ講師・アシスタント</option><option value=&quot;運営事務・サポートスタッフ&quot;>運営事務・サポートスタッフ</option><option value=&quot;同僚の講師&quot;>同僚の講師</option><option value=&quot;その他&quot;>その他</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #d8a05a;&quot;>
        <label>📦 手放したい業務</label>
        <input id=&quot;f_task&quot; placeholder=&quot;演習の個別質問対応とコードレビュー&quot;>
      </div>
    </div>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;&quot;>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #c4884a;&quot;>
        <label>🚧 一番のボトルネック</label>
        <select id=&quot;f_bottleneck&quot;><option value=&quot;時間が足りない&quot;>時間が足りない</option><option value=&quot;相手のスキルが不安&quot;>相手のスキルが不安</option><option value=&quot;頼みづらい&quot;>頼みづらい</option><option value=&quot;属人化していて渡せない&quot;>属人化していて渡せない</option></select>
      </div>
      <div class=&quot;card&quot; style=&quot;border-left:3px solid #b8743a;&quot;>
        <label>🎁 相手に提示できるメリット</label>
        <input id=&quot;f_merit&quot; placeholder=&quot;将来メイン登壇を目指すスキルアップ&quot;>
      </div>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;border-left:3px solid #a8632f;&quot;>
      <label>🎚 交渉文のトーン（丁寧度）</label>
      <select id=&quot;f_tone&quot;><option value=&quot;丁寧（フォーマル）&quot;>丁寧（フォーマル・上長/社外向け）</option><option value=&quot;標準（ていねい敬語）&quot; selected>標準（ていねい敬語・同僚向け）</option><option value=&quot;カジュアル（やわらかい）&quot;>カジュアル（やわらかい・親しいサブ講師向け）</option></select>
      <p style=&quot;margin:6px 0 0;font-size:10px;color:#8a7058;&quot;>相手との関係性に合わせて、交渉メッセージの言い回しが変わります。</p>
    </div>
    <div class=&quot;card&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>📝 補足（背景・関係性・期日など）</label>
      <textarea id=&quot;f_note&quot; placeholder=&quot;来期から新カリキュラム開発に注力したい。相手は半年目のサブ講師。&quot;></textarea>
    </div>

    <!-- APIキー（任意）：apikey版でのみ表示 -->
    <div class=&quot;card&quot; id=&quot;apiKeyCard&quot; style=&quot;margin-bottom:14px;&quot;>
      <label>🔑 Anthropic APIキー（任意・入れると自動分析）</label>
      <input type=&quot;password&quot; id=&quot;apiKey&quot; placeholder=&quot;sk-ant-... （未入力なら下の手動コピーを使用）&quot;>
      <p style=&quot;margin:6px 0 0;font-size:10px;color:#8a7058;&quot;>※キーはこの画面内だけで使われ、保存も外部送信もされません（Anthropic API以外には送りません）。</p>
    </div>

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(224,82,75,.16);border:1px solid rgba(224,82,75,.32);border-radius:8px;padding:10px 14px;color:#f0a59f;margin-bottom:14px;font-size:13px;&quot;></div>

    <button class=&quot;btn&quot; id=&quot;analyzeBtn&quot; onclick=&quot;handleAnalyze()&quot; style=&quot;width:100%;padding:15px;background:linear-gradient(135deg,#c4612f,#9c4a1f);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;&quot;>🤝 委譲プランを生成する</button>

    <div class=&quot;card&quot; id=&quot;manualCard&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#cbb39c;&quot;>🛠 APIキーがない場合（手動）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#8a7058;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(230,150,90,.2);border:1px solid #e6965a;border-radius:8px;padding:7px 14px;color:#f0b483;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:7px 14px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで結果を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#cbb39c;&quot;>✨ 生成されるもの</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#7a6450;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>🤝</div>
      <p>「委譲設計」タブで状況を入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:20px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「業務委譲・交渉アドバイザー」です。忙しいIT研修講師が仕事を上手に振る（委譲する）のを助けます。
鉄則：「受講生の成長」と「マニュアルの定型化」をセットで交渉する。コア業務（登壇・講義）に集中するため役割を切り分ける。
重要：ユーザーが指定する「トーン（丁寧度）」に合わせて、negotiation.message の言い回しを調整してください。「丁寧（フォーマル）」なら最敬語・クッション言葉多め、「標準」なら一般的なていねい敬語、「カジュアル」なら親しみのあるやわらかい口調にします。内容や鉄則は変えず、語調だけ変えます。
ユーザーの状況（誰に振る/手放したい業務/ボトルネック/相手メリット/トーン/補足）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;negotiation&quot;: {
    &quot;to&quot;: &quot;委譲先&quot;,
    &quot;message&quot;: &quot;相手に送る交渉メッセージ本文（相手メリットを先に提示し、YES/NOで答えられる形）&quot;,
    &quot;tips&quot;: [&quot;交渉のコツを2〜3個&quot;]
  },
  &quot;manual&quot;: {
    &quot;title&quot;: &quot;定型化・手順書のタイトル&quot;,
    &quot;steps&quot;: [&quot;手順書/チェックリストにする項目を3〜6個&quot;],
    &quot;why&quot;: &quot;なぜ定型化するか1文&quot;
  },
  &quot;breakdown&quot;: [
    {&quot;task&quot;: &quot;切り出すタスク名&quot;, &quot;owner&quot;: &quot;担当（役職名）&quot;, &quot;note&quot;: &quot;渡し方のポイント&quot;}
  ],
  &quot;tradeoff&quot;: {
    &quot;situation&quot;: &quot;トレードオフが必要な状況&quot;,
    &quot;proposal&quot;: &quot;優先順位を変える交渉案（納期後ろ倒し/他講師調整 等）&quot;,
    &quot;merit&quot;: &quot;これで防げるリスク&quot;
  }
}`;

var FIELD_TAGS=[&quot;🤝 交渉メッセージ&quot;,&quot;📋 手順書・定型化&quot;,&quot;🧩 タスク分解&quot;,&quot;⚖️ トレードオフ案&quot;];
var form={};
var result=null, tab=&quot;input&quot;, viewTab=&quot;negotiation&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }
function readForm(){
  return { to:$(&quot;f_to&quot;).value, task:($(&quot;f_task&quot;).value||&quot;&quot;).trim(), bottleneck:$(&quot;f_bottleneck&quot;).value, merit:($(&quot;f_merit&quot;).value||&quot;&quot;).trim(), tone:($(&quot;f_tone&quot;)?$(&quot;f_tone&quot;).value:&quot;標準（ていねい敬語）&quot;), note:($(&quot;f_note&quot;).value||&quot;&quot;).trim() };
}
function buildUserMsg(){
  var f=readForm();
  return [&quot;## 委譲したい状況&quot;,
    &quot;【誰に振る】&quot;+f.to,
    &quot;【手放したい業務】&quot;+(f.task||&quot;未入力&quot;),
    &quot;【ボトルネック】&quot;+f.bottleneck,
    &quot;【相手メリット】&quot;+(f.merit||&quot;未入力&quot;),
    &quot;【トーン（丁寧度）】&quot;+f.tone,
    &quot;【補足】&quot;+(f.note||&quot;なし&quot;)].join(&quot;\n&quot;);
}

function renderTags(){
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  FIELD_TAGS.forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(230,150,90,.16);border:1px solid rgba(230,150,90,.32);border-radius:20px;padding:3px 11px;font-size:11px;color:#f0b483;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}

function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}

function handleAnalyze(){
  var f=readForm();
  if(!f.task){ setErr(&quot;「手放したい業務」を入力してください&quot;); return; }
  var key=$(&quot;apiKey&quot;)?$(&quot;apiKey&quot;).value.trim():&quot;&quot;;
  if(!key){ setErr(&quot;APIキーが未入力です。下の「手動プロンプトをコピー」を使うか、APIキーを入力してください。&quot;); return; }
  setErr(&quot;&quot;);
  var btn=$(&quot;analyzeBtn&quot;); btn.disabled=true; btn.innerHTML='<span class=&quot;pulse&quot;>🤝</span> 生成中…';
  fetch(&quot;https://api.anthropic.com/v1/messages&quot;,{
    method:&quot;POST&quot;,
    headers:{ &quot;Content-Type&quot;:&quot;application/json&quot;,&quot;anthropic-version&quot;:&quot;2023-06-01&quot;,&quot;anthropic-dangerous-direct-browser-access&quot;:&quot;true&quot;,&quot;x-api-key&quot;:key },
    body:JSON.stringify({ model:&quot;claude-sonnet-4-5&quot;, max_tokens:4000, system:SYSTEM_PROMPT, messages:[{role:&quot;user&quot;,content:buildUserMsg()}] })
  }).then(function(res){ return res.json().then(function(data){ return {ok:res.ok,status:res.status,data:data}; }); })
   .then(function(r){
     if(!r.ok || r.data.error) throw new Error((r.data.error&amp;&amp;r.data.error.message)||(&quot;HTTP &quot;+r.status));
     var raw=(r.data.content||[]).map(function(c){return c.text||&quot;&quot;;}).join(&quot;&quot;);
     var m=raw.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりませんでした&quot;);
     result=JSON.parse(m[0]); setTab(&quot;result&quot;);
   }).catch(function(e){ setErr(&quot;生成に失敗しました: &quot;+e.message+&quot;（CORSやAPIキーをご確認ください。手動コピーも使えます）&quot;); })
   .then(function(){ btn.disabled=false; btn.innerHTML=&quot;🤝 委譲プランを生成する&quot;; });
}

function importJson(){
  setErr(&quot;&quot;);
  try{
    var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}

function copyToClip(text){
  function fall(){ var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;; document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el); }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function copyBtn(btn, text){ copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000); }

var SUBTABS=[[&quot;negotiation&quot;,&quot;🤝 交渉文&quot;],[&quot;manual&quot;,&quot;📋 手順書&quot;],[&quot;breakdown&quot;,&quot;🧩 タスク分解&quot;],[&quot;tradeoff&quot;,&quot;⚖️ トレードオフ&quot;]];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBTABS.forEach(function(p){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===p[0]?&quot; active&quot;:&quot;&quot;); b.textContent=p[1];
    b.onclick=function(){ viewTab=p[0]; renderResult(); };
    st.appendChild(b);
  });
  var v=$(&quot;resultView&quot;); v.innerHTML=renderView();
  [].slice.call(v.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){ b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); }); });
}
function card(inner){ return '<div class=&quot;card&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;negotiation&quot;) return viewNegotiation();
  if(viewTab===&quot;manual&quot;) return viewManual();
  if(viewTab===&quot;breakdown&quot;) return viewBreakdown();
  if(viewTab===&quot;tradeoff&quot;) return viewTradeoff();
  return &quot;&quot;;
}
function viewNegotiation(){
  var n=result.negotiation||{};
  var tips=(n.tips||[]).map(function(t){return '<li style=&quot;margin:4px 0;&quot;>'+esc(t)+'</li>';}).join(&quot;&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#cbb39c;font-weight:700;&quot;>🤝 交渉メッセージ'+(n.to?'（→ '+esc(n.to)+'）':'')+'</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(n.message||&quot;&quot;)+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  h+=card('<div style=&quot;white-space:pre-wrap;word-break:break-word;font-size:13px;color:#f3ece2;line-height:1.9;&quot;>'+esc(n.message||&quot;（未入力）&quot;)+'</div>'+
    (tips?'<div style=&quot;margin-top:14px;border-top:1px solid rgba(255,255,255,.08);padding-top:12px;&quot;><p style=&quot;margin:0 0 6px;font-size:12px;font-weight:700;color:#a98c72;&quot;>💡 交渉のコツ</p><ul style=&quot;margin:0;padding-left:18px;font-size:12px;color:#cbb39c;&quot;>'+tips+'</ul></div>':''));
  return h;
}
function viewManual(){
  var m=result.manual||{};
  var steps=(m.steps||[]).map(function(s){return '<div style=&quot;display:flex;gap:8px;align-items:center;margin:5px 0;&quot;><div style=&quot;width:14px;height:14px;border:2px solid #e6965a;border-radius:4px;flex:0 0 14px;&quot;></div><span style=&quot;font-size:12px;color:#f3ece2;&quot;>'+esc(s)+'</span></div>';}).join(&quot;&quot;);
  var mdSteps=(m.steps||[]).map(function(s){return &quot;- [ ] &quot;+s;}).join(&quot;\n&quot;);
  var md=&quot;# &quot;+(m.title||&quot;手順書&quot;)+&quot;\n\n&quot;+(m.why?(&quot;> &quot;+m.why+&quot;\n\n&quot;):&quot;&quot;)+mdSteps;
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;&quot;>'+
    '<h3 style=&quot;margin:0;font-size:15px;color:#cbb39c;font-weight:700;&quot;>📋 手順書・定型化</h3>'+
    '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(md)+'&quot; style=&quot;background:rgba(31,157,107,.2);border:1px solid #1f9d6b;border-radius:8px;padding:5px 13px;color:#7fd9b3;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  h+=card('<h4 style=&quot;margin:0 0 4px;color:#f0b483;font-size:16px;&quot;>'+esc(m.title||&quot;手順書&quot;)+'</h4>'+(m.why?'<p style=&quot;margin:0 0 12px;color:#a98c72;font-size:12px;&quot;>🎯 '+esc(m.why)+'</p>':'')+steps);
  return h;
}
function viewBreakdown(){
  var bd=result.breakdown||[];
  var h='<h3 style=&quot;margin:0 0 14px;font-size:15px;color:#cbb39c;font-weight:700;&quot;>🧩 タスク分解（切り出すもの）</h3>';
  if(!bd.length) return h+card('<p style=&quot;color:#7a6450;font-size:12px;&quot;>データがありません</p>');
  h+='<div style=&quot;display:flex;flex-direction:column;gap:10px;&quot;>';
  bd.forEach(function(b){
    h+=card('<div style=&quot;display:flex;justify-content:space-between;align-items:flex-start;gap:10px;&quot;><div style=&quot;font-weight:700;font-size:13px;color:#f3ece2;&quot;>'+esc(b.task)+'</div>'+(b.owner?'<span style=&quot;background:rgba(230,150,90,.18);border:1px solid rgba(230,150,90,.34);border-radius:20px;padding:2px 10px;font-size:11px;color:#f0b483;white-space:nowrap;&quot;>'+esc(b.owner)+'</span>':'')+'</div>'+(b.note?'<p style=&quot;margin:6px 0 0;font-size:11px;color:#a98c72;&quot;>💬 '+esc(b.note)+'</p>':''));
  });
  h+='</div>';
  return h;
}
function viewTradeoff(){
  var t=result.tradeoff||{};
  var h='<h3 style=&quot;margin:0 0 14px;font-size:15px;color:#cbb39c;font-weight:700;&quot;>⚖️ トレードオフ案</h3>';
  h+=card('<p style=&quot;margin:0 0 10px;font-size:12px;color:#a98c72;&quot;>状況：'+esc(t.situation||&quot;—&quot;)+'</p>'+
    '<div style=&quot;background:rgba(0,0,0,.2);border-radius:8px;padding:12px;border-left:3px solid #e6965a;margin-bottom:10px;&quot;><p style=&quot;margin:0;font-size:13px;color:#f3ece2;line-height:1.8;&quot;>'+esc(t.proposal||&quot;—&quot;)+'</p></div>'+
    (t.merit?'<p style=&quot;margin:0;font-size:12px;color:#7fd9b3;&quot;>✅ '+esc(t.merit)+'</p>':''));
  return h;
}

renderTags();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-jira" title="Jiraタスク作成" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>Jiraタスク作成ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;}
  :root{ --radius:12px; }
  body.theme-jp{
    --paper:#ffffff; --bg:#f4f6fa; --bg2:#eef2f8; --ink:#1b2733; --ink-soft:#5a6b7b;
    --line:#e1e7f0; --line-soft:#eef2f8; --ok:#1f9d6b; --ng:#e0524b; --warn:#e8923a;
    --accent:#2c66f0; --accent-deep:#1d4fcc; --accent-soft:#e7eeff;
    --shadow:0 1px 3px rgba(27,39,51,.06),0 6px 20px rgba(27,39,51,.06);
  }
  body{margin:0;font-family:&quot;Inter&quot;,&quot;Hiragino Sans&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;color:var(--ink);
    background:var(--bg);min-height:100vh;line-height:1.65;}
  .wrap{max-width:1000px;margin:0 auto;padding:18px 16px 80px;}
  header.hero{position:relative;margin-top:20px;background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:22px 26px;box-shadow:var(--shadow);}
  header.hero h1{margin:0 0 4px;font-size:1.22rem;font-weight:800;display:flex;align-items:center;gap:9px;}
  header.hero h1 .ic{width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:1rem;}
  header.hero p{margin:0;color:var(--ink-soft);font-size:.88rem;}
  .ver-badge{display:flex;gap:8px;align-items:center;margin:6px 0 0;flex-wrap:wrap;}
  .ver-pill{display:inline-block;background:var(--accent);color:#fff;font-weight:700;font-size:.7rem;padding:2px 9px;border-radius:999px;}
  .ver-date,.ver-today{color:var(--ink-soft);font-size:.72rem;}
  .ver-today:not(:empty)::before{content:&quot;｜ 今日 &quot;;opacity:.8;}
  .bunny{position:absolute;top:18px;right:22px;font-size:24px;}
  .lang-switch{display:none;}
  .tabs{display:flex;gap:6px;margin:16px 0;flex-wrap:wrap;}
  .tab{flex:1 1 auto;min-width:130px;text-align:center;cursor:pointer;border:1px solid var(--line);background:var(--paper);border-radius:10px;padding:9px 11px;font-weight:700;font-size:.85rem;color:var(--ink-soft);transition:all .12s;}
  .tab:hover{border-color:var(--accent);color:var(--accent);}
  .tab.active{background:var(--accent);color:#fff;border-color:var(--accent);box-shadow:0 2px 8px rgba(44,102,240,.3);}
  .panel{display:none;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:22px;box-shadow:var(--shadow);}
  .panel.active{display:block;}
  h2{font-size:1.05rem;margin:0 0 6px;}
  h3{font-size:.92rem;margin:16px 0 6px;color:var(--accent-deep);}
  label{display:block;font-size:.78rem;font-weight:700;color:var(--ink-soft);margin:8px 0 3px;}
  input,select,textarea{width:100%;border:1px solid var(--line);border-radius:8px;padding:9px 11px;font-size:.9rem;font-family:inherit;color:var(--ink);background:var(--paper);transition:border .12s,box-shadow .12s;}
  input:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft);}
  textarea{min-height:60px;resize:vertical;}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
  .hint{font-size:.77rem;color:var(--ink-soft);margin:4px 0 0;}
  code{background:var(--bg2);padding:1px 5px;border-radius:5px;font-size:.85em;}
  .howto{background:var(--accent-soft);border:1px solid #cfddff;border-left:4px solid var(--accent);border-radius:10px;padding:10px 14px;margin:0 0 14px;font-size:.83rem;color:#2b4a8c;}
  .howto b{color:var(--accent-deep);}
  .howto ol{margin:6px 0 0;padding-left:20px;}
  .howto li{margin:2px 0;}
  .badge{display:inline-block;padding:2px 9px;border-radius:6px;font-size:.74rem;font-weight:700;margin-right:6px;}
  .b-story{background:#e3f2e9;color:#1f7d53;} .b-task{background:#e7eeff;color:#2c66f0;} .b-bug{background:#fde7e6;color:#d23a33;} .b-epic{background:#efe6fb;color:#7a44c4;}
  button{transition:transform .08s,box-shadow .12s,filter .12s,background .12s;}
  .gen{margin-top:18px;width:100%;background:var(--accent);color:#fff;border:none;border-radius:10px;padding:13px;font-size:.98rem;font-weight:800;cursor:pointer;box-shadow:0 2px 8px rgba(44,102,240,.3);}
  .gen:hover{background:var(--accent-deep);transform:translateY(-1px);}
  .gen:active{transform:translateY(1px) scale(.99);}
  .addbtn{margin-top:8px;background:var(--accent-soft);border:1px solid #cfddff;color:var(--accent-deep);border-radius:8px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.83rem;}
  .addbtn:hover{transform:translateY(-1px);background:#dbe6ff;}
  .addbtn:active{transform:translateY(1px) scale(.99);}
  .del{background:#fff;border:1px solid var(--line);color:var(--ng);border-radius:7px;padding:6px 9px;cursor:pointer;font-weight:700;}
  .row{display:flex;gap:8px;align-items:flex-start;margin:6px 0;}
  .row>*{margin:0;}
  .outwrap{margin-top:18px;background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:14px;}
  .outwrap h3{margin-top:0;}
  pre.out{white-space:pre-wrap;word-break:break-word;background:var(--paper);border:1px solid var(--line);border-radius:9px;padding:12px;font-size:.85rem;max-height:440px;overflow:auto;font-family:&quot;SF Mono&quot;,&quot;Consolas&quot;,monospace;}
  .outbtns{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
  .outbtns button{border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:9px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.83rem;}
  .outbtns button:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-1px);}
  .outbtns button:active{transform:translateY(1px) scale(.99);}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:999px;font-size:.85rem;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50;}
  .toast.show{opacity:.96;}
  .prev{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin-top:12px;}
  .prev .pkey{font-size:.74rem;color:var(--ink-soft);font-weight:700;letter-spacing:.04em;}
  .prev .psum{font-size:1.02rem;font-weight:800;margin:3px 0 8px;}
  .prev .meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;}
  .prev .chip{background:var(--bg2);border:1px solid var(--line);border-radius:999px;padding:3px 10px;font-size:.74rem;color:var(--ink-soft);}
  @media (max-width:560px){ .grid,.grid3{grid-template-columns:1fr;} }
</style>
</head>
<body class=&quot;theme-jp&quot;>
<div class=&quot;wrap&quot;>
  <header class=&quot;hero&quot;>
    <div class=&quot;bunny&quot;>🐰</div>
    <h1><span class=&quot;ic&quot;>📋</span> Jiraタスク作成ジェネレーター</h1>
    <p>Jiraに貼れる形で、課題（チケット）をきれいに整えます。チケット作成・説明テンプレ・サブタスク分解・一括起票（CSV）まで。データは端末内のみ・外部送信なし。</p>
    <div class=&quot;ver-badge&quot;><span class=&quot;ver-pill&quot;>v1.0</span><span class=&quot;ver-date&quot;>2026-05-22</span><span class=&quot;ver-today&quot; id=&quot;ver_today&quot;></span></div>
  </header>

  <div class=&quot;tabs&quot; id=&quot;tabs&quot;>
    <div class=&quot;tab active&quot; data-tab=&quot;ticket&quot;>🎫 チケット作成</div>
    <div class=&quot;tab&quot; data-tab=&quot;desc&quot;>📝 説明テンプレ</div>
    <div class=&quot;tab&quot; data-tab=&quot;subtask&quot;>🧩 サブタスク分解</div>
    <div class=&quot;tab&quot; data-tab=&quot;bulk&quot;>📦 一括起票（CSV）</div>
    <div class=&quot;tab&quot; data-tab=&quot;hub&quot;>🗂 データ統合</div>
  </div>

  <!-- チケット作成 -->
  <div class=&quot;panel active&quot; id=&quot;panel-ticket&quot;>
    <h2>チケット作成</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>課題タイプ・要約・説明・受け入れ条件などを埋める</li>
      <li>「チケットを生成する」で、Jiraに貼り付けやすい整形テキストができます</li>
      <li>下にプレビューも表示されます</li>
    </ol></div>
    <div class=&quot;grid3&quot;>
      <div><label>課題タイプ</label><select id=&quot;tk_type&quot;><option value=&quot;ストーリー&quot;>ストーリー</option><option value=&quot;タスク&quot;>タスク</option><option value=&quot;バグ&quot;>バグ</option><option value=&quot;エピック&quot;>エピック</option></select></div>
      <div><label>優先度</label><select id=&quot;tk_pri&quot;><option>Highest</option><option>High</option><option selected>Medium</option><option>Low</option><option>Lowest</option></select></div>
      <div><label>ストーリーポイント</label><input id=&quot;tk_sp&quot; placeholder=&quot;3&quot;></div>
    </div>
    <div><label>要約（タイトル）</label><input id=&quot;tk_sum&quot; placeholder=&quot;ログイン画面にパスワード表示トグルを追加する&quot;></div>
    <div><label>説明</label><textarea id=&quot;tk_desc&quot; placeholder=&quot;背景・目的・やることを記述（②説明テンプレで雛形を作れます）&quot;></textarea></div>
    <div><label>受け入れ条件（1行＝1条件）</label><textarea id=&quot;tk_ac&quot; placeholder=&quot;トグルでパスワードの表示/非表示が切り替わる&amp;#10;初期状態は非表示&amp;#10;モバイルでも崩れない&quot;></textarea></div>
    <div class=&quot;grid3&quot;>
      <div><label>担当者（役職名）</label><input id=&quot;tk_assignee&quot; placeholder=&quot;開発担当&quot;></div>
      <div><label>期日</label><input id=&quot;tk_due&quot; placeholder=&quot;2026/06/10&quot;></div>
      <div><label>エピック/親</label><input id=&quot;tk_epic&quot; placeholder=&quot;認証まわり改善&quot;></div>
    </div>
    <div><label>ラベル（カンマ区切り）</label><input id=&quot;tk_labels&quot; placeholder=&quot;frontend, auth, ux&quot;></div>
    <button class=&quot;gen&quot; onclick=&quot;buildTicket()&quot;>チケットを生成する</button>
    <div id=&quot;tkPreview&quot;></div>
  </div>

  <!-- 説明テンプレ -->
  <div class=&quot;panel&quot; id=&quot;panel-desc&quot;>
    <h2>説明テンプレ（説明欄の定番フォーマット）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>背景・目的・やること・完了条件・補足を埋める</li>
      <li>「説明文を生成する」で、Jira説明欄に貼れる整形文ができます</li>
      <li>①チケット作成の「説明」欄にコピペして使えます</li>
    </ol></div>
    <div><label>背景（なぜ必要か）</label><textarea id=&quot;ds_bg&quot; placeholder=&quot;ユーザーからパスワード入力ミスが多いとの声&quot;></textarea></div>
    <div><label>目的（何を達成するか）</label><textarea id=&quot;ds_goal&quot; placeholder=&quot;入力ミスを減らし、ログイン成功率を上げる&quot;></textarea></div>
    <div><label>やること（1行ずつ）</label><textarea id=&quot;ds_todo&quot; placeholder=&quot;表示/非表示トグルUIを追加&amp;#10;アクセシビリティ属性を付与&quot;></textarea></div>
    <div><label>完了条件（1行ずつ）</label><textarea id=&quot;ds_dod&quot; placeholder=&quot;トグルが動作する&amp;#10;テストが通る&quot;></textarea></div>
    <div><label>補足・参考リンク</label><textarea id=&quot;ds_note&quot; placeholder=&quot;デザイン: （社内Figma）&quot;></textarea></div>
    <button class=&quot;gen&quot; onclick=&quot;buildDesc()&quot;>説明文を生成する</button>
  </div>

  <!-- サブタスク分解 -->
  <div class=&quot;panel&quot; id=&quot;panel-subtask&quot;>
    <h2>サブタスク分解</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>親タスク（要約）を入れ、子タスクを1行ずつ追加</li>
      <li>担当・見積をつけられます</li>
      <li>「サブタスクを生成する」で、親子構造の一覧になります</li>
    </ol></div>
    <div><label>親タスク（要約）</label><input id=&quot;st_parent&quot; placeholder=&quot;認証まわり改善&quot;></div>
    <h3>子タスク（要約＋担当＋見積h）</h3>
    <div id=&quot;stList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;stAdd()&quot;>＋ サブタスクを追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildSubtask()&quot;>サブタスクを生成する</button>
  </div>

  <!-- 一括起票 -->
  <div class=&quot;panel&quot; id=&quot;panel-bulk&quot;>
    <h2>一括起票（CSV）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>複数のチケットを行ごとに入力（タイプ・要約・担当・SP）</li>
      <li>「一覧を生成する」で確認、「CSVを書き出す」でJira一括取込用CSVを保存</li>
      <li>CSVのヘッダーは Issue Type, Summary, Assignee, Story Points です</li>
    </ol></div>
    <div id=&quot;bulkList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;bulkAdd()&quot;>＋ 行を追加</button>
    <div class=&quot;outbtns&quot; style=&quot;margin-top:10px;&quot;>
      <button onclick=&quot;buildBulk()&quot;>📋 一覧を生成する</button>
      <button onclick=&quot;bulkExportCsv()&quot;>📄 CSVを書き出す</button>
    </div>
  </div>

  <!-- データ統合 -->
  <div class=&quot;panel&quot; id=&quot;panel-hub&quot;>
    <h2>データ統合（保存・取り込み）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>「JSON保存」で全タブの入力を1ファイルに保存</li>
      <li>「JSON取り込み」で復元できます</li>
    </ol></div>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;hubSaveJson()&quot;>💾 全データをJSON保存</button>
      <button onclick=&quot;document.getElementById('hubFile').click()&quot;>📂 JSONを取り込む</button>
      <input type=&quot;file&quot; id=&quot;hubFile&quot; accept=&quot;.json&quot; style=&quot;display:none&quot; onchange=&quot;hubLoadJson(this)&quot;>
      <button onclick=&quot;hubClearAll()&quot;>🗑 全クリア</button>
    </div>
    <p class=&quot;hint&quot;>保存したJSONはこのツールでのみ復元できます。</p>
  </div>

  <div class=&quot;outwrap&quot;>
    <h3>生成結果</h3>
    <pre class=&quot;out&quot; id=&quot;out&quot;>ここに生成結果が表示されます。各タブの「生成する」を押してください。</pre>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;copyOut()&quot;>📋 コピー</button>
      <button onclick=&quot;downloadOut('txt')&quot;>📄 テキスト保存</button>
      <button onclick=&quot;downloadOut('md')&quot;>📝 Markdown保存</button>
      <button onclick=&quot;clearOut()&quot;>クリア</button>
    </div>
  </div>
</div>
<div class=&quot;toast&quot; id=&quot;toast&quot;></div>
<script>
&quot;use strict&quot;;
function $(id){ return document.getElementById(id); }
function v(id){ var el=$(id); return el?(el.value||&quot;&quot;).trim():&quot;&quot;; }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function lines(s){ return (s||&quot;&quot;).split(/\n+/).map(function(x){return x.trim();}).filter(Boolean); }
function toast(m){ var t=$(&quot;toast&quot;); if(!t)return; t.textContent=m; t.classList.add(&quot;show&quot;); setTimeout(function(){t.classList.remove(&quot;show&quot;);},1600); }
function lsAvailable(){ try{ var k=&quot;__t&quot;+Math.random(); window.localStorage.setItem(k,&quot;1&quot;); window.localStorage.removeItem(k); return true; }catch(e){ return false; } }
function nowParts(){
  var d=new Date(), wd=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var mm=(&quot;0&quot;+(d.getMonth()+1)).slice(-2), dd=(&quot;0&quot;+d.getDate()).slice(-2);
  var hh=(&quot;0&quot;+d.getHours()).slice(-2), mi=(&quot;0&quot;+d.getMinutes()).slice(-2);
  return { date:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;）&quot;, time:hh+&quot;:&quot;+mi, datetime:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;） &quot;+hh+&quot;:&quot;+mi };
}
function todayJp(){ return nowParts().date; }
function stamp(){ return nowParts().date.replace(/[^0-9]/g,&quot;&quot;).slice(0,8); }
var BAR=&quot;────────────────────────────&quot;;

var lastOut={txt:&quot;&quot;,md:&quot;&quot;};
function setOut(txt,md){ lastOut.txt=txt||&quot;&quot;; lastOut.md=(md!=null?md:txt)||&quot;&quot;; var o=$(&quot;out&quot;); if(o) o.textContent=lastOut.txt; }
function clearOut(){ setOut(&quot;&quot;); var o=$(&quot;out&quot;); if(o) o.textContent=&quot;&quot;; toast(&quot;クリアしました&quot;); }
function copyOut(){
  var t=lastOut.txt||&quot;&quot;; if(!t){ toast(&quot;生成結果がありません&quot;); return; }
  try{ navigator.clipboard.writeText(t); toast(&quot;コピーしました&quot;); }
  catch(e){ var ta=document.createElement(&quot;textarea&quot;); ta.value=t; document.body.appendChild(ta); ta.select(); try{document.execCommand(&quot;copy&quot;);}catch(_){} document.body.removeChild(ta); toast(&quot;コピーしました&quot;); }
}
function _saveBlob(text,fname,mime){
  try{ var blob=new Blob([text],{type:mime||&quot;text/plain;charset=utf-8&quot;}); var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=fname; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(url);},500); }catch(e){ toast(&quot;保存に失敗しました&quot;); }
}
function downloadOut(fmt){
  if(!lastOut.txt){ toast(&quot;生成結果がありません&quot;); return; }
  if(fmt===&quot;md&quot;){ _saveBlob(lastOut.md,&quot;jira_&quot;+stamp()+&quot;.md&quot;,&quot;text/markdown;charset=utf-8&quot;); }
  else{ _saveBlob(lastOut.txt,&quot;jira_&quot;+stamp()+&quot;.txt&quot;,&quot;text/plain;charset=utf-8&quot;); }
}
function mkRow(html){ var d=document.createElement(&quot;div&quot;); d.className=&quot;row&quot;; d.innerHTML=html; return d; }
function delRow(btn){ var r=btn.closest(&quot;.row&quot;); if(r) r.remove(); }
function badgeClass(t){ return t===&quot;ストーリー&quot;?&quot;b-story&quot;:t===&quot;バグ&quot;?&quot;b-bug&quot;:t===&quot;エピック&quot;?&quot;b-epic&quot;:&quot;b-task&quot;; }

/* ===== ① チケット作成 ===== */
function buildTicket(){
  var type=v(&quot;tk_type&quot;), sum=v(&quot;tk_sum&quot;)||&quot;（要約未入力）&quot;;
  var ac=lines(v(&quot;tk_ac&quot;)), labels=v(&quot;tk_labels&quot;);
  var o=[];
  o.push(&quot;【&quot;+type+&quot;】&quot;+sum);
  o.push(&quot;優先度：&quot;+v(&quot;tk_pri&quot;)+(v(&quot;tk_sp&quot;)?(&quot;　SP：&quot;+v(&quot;tk_sp&quot;)):&quot;&quot;));
  if(v(&quot;tk_assignee&quot;)||v(&quot;tk_due&quot;)) o.push(&quot;担当：&quot;+(v(&quot;tk_assignee&quot;)||&quot;—&quot;)+&quot;　期日：&quot;+(v(&quot;tk_due&quot;)||&quot;—&quot;));
  if(v(&quot;tk_epic&quot;)) o.push(&quot;エピック/親：&quot;+v(&quot;tk_epic&quot;));
  if(labels) o.push(&quot;ラベル：&quot;+labels);
  o.push(&quot;&quot;); o.push(&quot;■ 説明&quot;);
  o.push(v(&quot;tk_desc&quot;)||&quot;（未入力）&quot;);
  o.push(&quot;&quot;); o.push(&quot;■ 受け入れ条件&quot;);
  if(ac.length){ ac.forEach(function(a){ o.push(&quot;- [ ] &quot;+a); }); } else { o.push(&quot;（未入力）&quot;); }
  // Markdown（Jira説明貼り付け用）
  var m=[&quot;h2. &quot;+sum,&quot;&quot;,(&quot;*課題タイプ:* &quot;+type),(&quot;*優先度:* &quot;+v(&quot;tk_pri&quot;)+(v(&quot;tk_sp&quot;)?(&quot;  *SP:* &quot;+v(&quot;tk_sp&quot;)):&quot;&quot;)),&quot;&quot;];
  if(v(&quot;tk_assignee&quot;)||v(&quot;tk_due&quot;)) m.push(&quot;*担当:* &quot;+(v(&quot;tk_assignee&quot;)||&quot;—&quot;)+&quot;  *期日:* &quot;+(v(&quot;tk_due&quot;)||&quot;—&quot;));
  if(v(&quot;tk_epic&quot;)) m.push(&quot;*エピック/親:* &quot;+v(&quot;tk_epic&quot;));
  if(labels) m.push(&quot;*ラベル:* &quot;+labels);
  m.push(&quot;&quot;); m.push(&quot;h3. 説明&quot;); m.push(v(&quot;tk_desc&quot;)||&quot;（未入力）&quot;);
  m.push(&quot;&quot;); m.push(&quot;h3. 受け入れ条件&quot;);
  if(ac.length){ ac.forEach(function(a){ m.push(&quot;* (/) &quot;+a); }); } else { m.push(&quot;（未入力）&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
  // プレビュー
  var chips=[];
  chips.push('<span class=&quot;chip&quot;>優先度: '+esc(v(&quot;tk_pri&quot;))+'</span>');
  if(v(&quot;tk_sp&quot;)) chips.push('<span class=&quot;chip&quot;>SP: '+esc(v(&quot;tk_sp&quot;))+'</span>');
  if(v(&quot;tk_assignee&quot;)) chips.push('<span class=&quot;chip&quot;>担当: '+esc(v(&quot;tk_assignee&quot;))+'</span>');
  if(v(&quot;tk_due&quot;)) chips.push('<span class=&quot;chip&quot;>期日: '+esc(v(&quot;tk_due&quot;))+'</span>');
  if(labels) lines(labels.replace(/,/g,&quot;\n&quot;)).forEach(function(l){ chips.push('<span class=&quot;chip&quot;>🏷 '+esc(l)+'</span>'); });
  $(&quot;tkPreview&quot;).innerHTML='<div class=&quot;prev&quot;><span class=&quot;pkey&quot;>'+esc(type)+'</span>'+
    '<div class=&quot;psum&quot;><span class=&quot;badge '+badgeClass(type)+'&quot;>'+esc(type)+'</span>'+esc(sum)+'</div>'+
    '<div class=&quot;meta&quot;>'+chips.join(&quot;&quot;)+'</div></div>';
}

/* ===== ② 説明テンプレ ===== */
function buildDesc(){
  var todo=lines(v(&quot;ds_todo&quot;)), dod=lines(v(&quot;ds_dod&quot;));
  var o=[];
  o.push(&quot;■ 背景&quot;); o.push(v(&quot;ds_bg&quot;)||&quot;—&quot;);
  o.push(&quot;&quot;); o.push(&quot;■ 目的&quot;); o.push(v(&quot;ds_goal&quot;)||&quot;—&quot;);
  o.push(&quot;&quot;); o.push(&quot;■ やること&quot;);
  if(todo.length){ todo.forEach(function(x){ o.push(&quot;・&quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(&quot;■ 完了条件&quot;);
  if(dod.length){ dod.forEach(function(x){ o.push(&quot;□ &quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  if(v(&quot;ds_note&quot;)){ o.push(&quot;&quot;); o.push(&quot;■ 補足&quot;); o.push(v(&quot;ds_note&quot;)); }
  var m=[&quot;h3. 背景&quot;,v(&quot;ds_bg&quot;)||&quot;—&quot;,&quot;&quot;,&quot;h3. 目的&quot;,v(&quot;ds_goal&quot;)||&quot;—&quot;,&quot;&quot;,&quot;h3. やること&quot;];
  if(todo.length){ todo.forEach(function(x){ m.push(&quot;* &quot;+x); }); } else { m.push(&quot;（未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;h3. 完了条件&quot;);
  if(dod.length){ dod.forEach(function(x){ m.push(&quot;* (/) &quot;+x); }); } else { m.push(&quot;（未入力）&quot;); }
  if(v(&quot;ds_note&quot;)){ m.push(&quot;&quot;); m.push(&quot;h3. 補足&quot;); m.push(v(&quot;ds_note&quot;)); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== ③ サブタスク分解 ===== */
function stAdd(sum,owner,est){
  $(&quot;stList&quot;).appendChild(mkRow(
    '<input class=&quot;st-s&quot; placeholder=&quot;子タスクの要約&quot; value=&quot;'+esc(sum||&quot;&quot;)+'&quot;>'+
    '<input class=&quot;st-o&quot; placeholder=&quot;担当&quot; value=&quot;'+esc(owner||&quot;&quot;)+'&quot; style=&quot;max-width:18%&quot;>'+
    '<input class=&quot;st-e&quot; placeholder=&quot;h&quot; value=&quot;'+esc(est||&quot;&quot;)+'&quot; style=&quot;max-width:10%&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function stRead(){ return [].slice.call(document.querySelectorAll(&quot;#stList .row&quot;)).map(function(r){
  return { s:r.querySelector(&quot;.st-s&quot;).value.trim(), o:r.querySelector(&quot;.st-o&quot;).value.trim(), e:r.querySelector(&quot;.st-e&quot;).value.trim() }; }).filter(function(x){return x.s;}); }
function buildSubtask(){
  var parent=v(&quot;st_parent&quot;)||&quot;（親タスク未入力）&quot;, subs=stRead(), totalH=0;
  var o=[];
  o.push(&quot;【親タスク】&quot;+parent);
  o.push(&quot;&quot;); o.push(BAR);
  if(subs.length){ subs.forEach(function(s,i){ var h=parseFloat(s.e); if(!isNaN(h)) totalH+=h; o.push(&quot;　└ サブ&quot;+(i+1)+&quot;：&quot;+s.s+(s.o?(&quot;　担当:&quot;+s.o):&quot;&quot;)+(s.e?(&quot;　&quot;+s.e+&quot;h&quot;):&quot;&quot;)); }); } else { o.push(&quot;（サブタスク未入力）&quot;); }
  if(totalH>0){ o.push(&quot;&quot;); o.push(&quot;合計見積：約&quot;+totalH+&quot;h&quot;); }
  var m=[&quot;h2. &quot;+parent,&quot;&quot;,&quot;|| サブタスク || 担当 || 見積(h) ||&quot;];
  if(subs.length){ subs.forEach(function(s){ m.push(&quot;| &quot;+s.s+&quot; | &quot;+(s.o||&quot;—&quot;)+&quot; | &quot;+(s.e||&quot;—&quot;)+&quot; |&quot;); }); } else { m.push(&quot;| （未入力） | — | — |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== ④ 一括起票 ===== */
function bulkAdd(type,sum,owner,sp){
  $(&quot;bulkList&quot;).appendChild(mkRow(
    '<select class=&quot;bk-t&quot; style=&quot;max-width:18%&quot;>'+['ストーリー','タスク','バグ','エピック'].map(function(s){return '<option'+(type===s?' selected':'')+'>'+s+'</option>';}).join(&quot;&quot;)+'</select>'+
    '<input class=&quot;bk-s&quot; placeholder=&quot;要約&quot; value=&quot;'+esc(sum||&quot;&quot;)+'&quot;>'+
    '<input class=&quot;bk-o&quot; placeholder=&quot;担当&quot; value=&quot;'+esc(owner||&quot;&quot;)+'&quot; style=&quot;max-width:16%&quot;>'+
    '<input class=&quot;bk-p&quot; placeholder=&quot;SP&quot; value=&quot;'+esc(sp||&quot;&quot;)+'&quot; style=&quot;max-width:10%&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function bulkRead(){ return [].slice.call(document.querySelectorAll(&quot;#bulkList .row&quot;)).map(function(r){
  return { t:r.querySelector(&quot;.bk-t&quot;).value, s:r.querySelector(&quot;.bk-s&quot;).value.trim(), o:r.querySelector(&quot;.bk-o&quot;).value.trim(), p:r.querySelector(&quot;.bk-p&quot;).value.trim() }; }).filter(function(x){return x.s;}); }
function buildBulk(){
  var items=bulkRead();
  var o=[];
  o.push(&quot;【一括起票リスト】件数：&quot;+items.length+&quot;　&quot;+todayJp());
  o.push(&quot;&quot;); o.push(BAR);
  if(items.length){ items.forEach(function(x,i){ o.push((i+1)+&quot;. [&quot;+x.t+&quot;] &quot;+x.s+(x.o?(&quot;　担当:&quot;+x.o):&quot;&quot;)+(x.p?(&quot;　SP:&quot;+x.p):&quot;&quot;)); }); } else { o.push(&quot;（未入力）&quot;); }
  var m=[&quot;# 一括起票リスト&quot;,&quot;&quot;,&quot;| Issue Type | Summary | Assignee | Story Points |&quot;,&quot;|---|---|---|---|&quot;];
  if(items.length){ items.forEach(function(x){ m.push(&quot;| &quot;+x.t+&quot; | &quot;+x.s+&quot; | &quot;+(x.o||&quot;&quot;)+&quot; | &quot;+(x.p||&quot;&quot;)+&quot; |&quot;); }); } else { m.push(&quot;| — | （未入力） | — | — |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}
function csvCell(s){ s=(s==null?&quot;&quot;:String(s)); if(/[&quot;,\n]/.test(s)){ return '&quot;'+s.replace(/&quot;/g,'&quot;&quot;')+'&quot;'; } return s; }
function bulkExportCsv(){
  var items=bulkRead();
  var rows=[[&quot;Issue Type&quot;,&quot;Summary&quot;,&quot;Assignee&quot;,&quot;Story Points&quot;]];
  if(items.length){ items.forEach(function(x){ rows.push([x.t,x.s,x.o,x.p]); }); }
  var csv=&quot;\ufeff&quot;+rows.map(function(r){ return r.map(csvCell).join(&quot;,&quot;); }).join(&quot;\r\n&quot;);
  _saveBlob(csv,&quot;jira_bulk_&quot;+stamp()+&quot;.csv&quot;,&quot;text/csv;charset=utf-8&quot;);
  toast(&quot;CSVを書き出しました&quot;);
}

/* ===== データ統合 ===== */
function collectAll(){
  return { _app:&quot;usausa_jira&quot;, _ver:&quot;1.0&quot;, _saved:nowParts().datetime,
    ticket:{ type:v(&quot;tk_type&quot;),pri:v(&quot;tk_pri&quot;),sp:v(&quot;tk_sp&quot;),sum:v(&quot;tk_sum&quot;),desc:v(&quot;tk_desc&quot;),ac:v(&quot;tk_ac&quot;),assignee:v(&quot;tk_assignee&quot;),due:v(&quot;tk_due&quot;),epic:v(&quot;tk_epic&quot;),labels:v(&quot;tk_labels&quot;) },
    desc:{ bg:v(&quot;ds_bg&quot;),goal:v(&quot;ds_goal&quot;),todo:v(&quot;ds_todo&quot;),dod:v(&quot;ds_dod&quot;),note:v(&quot;ds_note&quot;) },
    subtask:{ parent:v(&quot;st_parent&quot;),subs:stRead() },
    bulk:{ items:bulkRead() }
  };
}
function hubSaveJson(){ _saveBlob(JSON.stringify(collectAll(),null,2),&quot;jira_data_&quot;+stamp()+&quot;.json&quot;,&quot;application/json;charset=utf-8&quot;); toast(&quot;全データをJSON保存しました&quot;); }
function applyAll(d){
  if(!d||typeof d!==&quot;object&quot;) return;
  function set(id,val){ var el=$(id); if(el) el.value=(val||&quot;&quot;); }
  if(d.ticket){ var t=d.ticket; if(t.type)set(&quot;tk_type&quot;,t.type); if(t.pri)set(&quot;tk_pri&quot;,t.pri); set(&quot;tk_sp&quot;,t.sp);set(&quot;tk_sum&quot;,t.sum);set(&quot;tk_desc&quot;,t.desc);set(&quot;tk_ac&quot;,t.ac);set(&quot;tk_assignee&quot;,t.assignee);set(&quot;tk_due&quot;,t.due);set(&quot;tk_epic&quot;,t.epic);set(&quot;tk_labels&quot;,t.labels); }
  if(d.desc){ set(&quot;ds_bg&quot;,d.desc.bg);set(&quot;ds_goal&quot;,d.desc.goal);set(&quot;ds_todo&quot;,d.desc.todo);set(&quot;ds_dod&quot;,d.desc.dod);set(&quot;ds_note&quot;,d.desc.note); }
  if(d.subtask){ set(&quot;st_parent&quot;,d.subtask.parent); $(&quot;stList&quot;).innerHTML=&quot;&quot;; (d.subtask.subs||[]).forEach(function(s){ stAdd(s.s,s.o,s.e); }); }
  if(d.bulk){ $(&quot;bulkList&quot;).innerHTML=&quot;&quot;; (d.bulk.items||[]).forEach(function(x){ bulkAdd(x.t,x.s,x.o,x.p); }); }
}
function hubLoadJson(input){
  var f=input&amp;&amp;input.files&amp;&amp;input.files[0]; if(!f){ return; }
  var rd=new FileReader();
  rd.onload=function(){ try{ applyAll(JSON.parse(rd.result)); toast(&quot;JSONを取り込みました&quot;); }catch(e){ toast(&quot;JSONの読み込みに失敗しました&quot;); } input.value=&quot;&quot;; };
  rd.readAsText(f);
}
function hubClearAll(){
  if(!window.confirm(&quot;すべての入力をクリアします。よろしいですか？&quot;)) return;
  [&quot;tk_sp&quot;,&quot;tk_sum&quot;,&quot;tk_desc&quot;,&quot;tk_ac&quot;,&quot;tk_assignee&quot;,&quot;tk_due&quot;,&quot;tk_epic&quot;,&quot;tk_labels&quot;,&quot;ds_bg&quot;,&quot;ds_goal&quot;,&quot;ds_todo&quot;,&quot;ds_dod&quot;,&quot;ds_note&quot;,&quot;st_parent&quot;].forEach(function(id){ var el=$(id); if(el) el.value=&quot;&quot;; });
  $(&quot;stList&quot;).innerHTML=&quot;&quot;; $(&quot;bulkList&quot;).innerHTML=&quot;&quot;; $(&quot;tkPreview&quot;).innerHTML=&quot;&quot;;
  setOut(&quot;&quot;); $(&quot;out&quot;).textContent=&quot;&quot;;
  stAdd(); bulkAdd();
  toast(&quot;全クリアしました&quot;);
}

/* ===== タブ ===== */
function switchPanel(tab){
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.classList.toggle(&quot;active&quot;, t.dataset.tab===tab); });
  [].slice.call(document.querySelectorAll(&quot;.panel&quot;)).forEach(function(p){ p.classList.toggle(&quot;active&quot;, p.id===&quot;panel-&quot;+tab); });
}

/* ===== init ===== */
(function(){
  stAdd(); bulkAdd();
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.addEventListener(&quot;click&quot;, function(){ switchPanel(t.dataset.tab); }); });
  try{ var vt=$(&quot;ver_today&quot;); if(vt) vt.textContent=nowParts().date; }catch(e){}
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-senseiapi" title="プロンプト先生APIあり" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>AIプロンプト集品質向上先生 🧠</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#0f0c29,#302b63,#24243e);color:#f0f0f0;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(139,92,246,.5);border-radius:3px}
  textarea,input{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.85}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.04);border-radius:12px;padding:20px;border:1px solid rgba(255,255,255,0.08);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#64748b;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(139,92,246,.3);border-bottom:2px solid #8b5cf6;color:#a78bfa;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#64748b;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(139,92,246,.4);border:1px solid #8b5cf6;color:#a78bfa;}
  textarea,input[type=password]{width:100%;background:rgba(0,0,0,.2);border:1px solid rgba(255,255,255,.1);
    border-radius:8px;padding:10px 12px;color:#e2e8f0;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#8b5cf6,#ec4899);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>🧠</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#a78bfa,#f472b6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>AIプロンプト集品質向上先生</h1>
      <p style=&quot;margin:0;font-size:11px;color:#94a3b8;&quot;>【APIキー版】キーを入れると自動分析。振り返り → 図解 → 手順書 → プロンプト集 → 記事</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 入力</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>📊 結果</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:18px;&quot; id=&quot;formGrid&quot;></div>

    <div class=&quot;card&quot; style=&quot;padding:14px;margin-bottom:14px;&quot;>
      <label style=&quot;display:block;font-size:12px;font-weight:700;color:#94a3b8;margin-bottom:6px;&quot;>🔑 Anthropic APIキー（任意・入れると自動分析）</label>
      <input type=&quot;password&quot; id=&quot;apiKey&quot; placeholder=&quot;sk-ant-... （未入力なら下の手動コピーを使用）&quot;>
      <p style=&quot;margin:6px 0 0;font-size:10px;color:#64748b;&quot;>※キーはこの画面内だけで使われ、保存も外部送信もされません（Anthropic API以外には送りません）。</p>
    </div>

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.3);border-radius:8px;padding:10px 14px;color:#fca5a5;margin-bottom:14px;font-size:13px;&quot;></div>

    <button class=&quot;btn&quot; id=&quot;analyzeBtn&quot; onclick=&quot;handleAnalyze()&quot; style=&quot;width:100%;padding:15px;background:linear-gradient(135deg,#7c3aed,#db2777);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;&quot;>🚀 AI分析してプロンプト集を生成する</button>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#94a3b8;&quot;>🛠 APIキーがない場合（手動）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#64748b;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(139,92,246,.2);border:1px solid #8b5cf6;border-radius:8px;padding:7px 14px;color:#c4b5fd;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(16,185,129,.2);border:1px solid #10b981;border-radius:8px;padding:7px 14px;color:#6ee7b7;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで結果を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#94a3b8;&quot;>✨ 生成されるもの</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#475569;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>📝</div>
      <p>「入力」タブで振り返りを入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:20px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「AIプロンプト集品質向上先生」です。
ユーザーの振り返り（グッド/バッド/学び/取り組み）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;abstract_level&quot;: {
    &quot;level1_concrete&quot;: [&quot;具体的な出来事・行動を3〜5個&quot;],
    &quot;level2_pattern&quot;: [&quot;パターン・傾向を2〜3個&quot;],
    &quot;level3_principle&quot;: [&quot;原則・法則を1〜2個&quot;],
    &quot;level4_philosophy&quot;: &quot;本質的な気づき1文&quot;
  },
  &quot;flow_diagram&quot;: [
    {&quot;id&quot;: 1, &quot;label&quot;: &quot;きっかけ&quot;, &quot;content&quot;: &quot;何が起きたか&quot;, &quot;type&quot;: &quot;trigger&quot;},
    {&quot;id&quot;: 2, &quot;label&quot;: &quot;行動&quot;, &quot;content&quot;: &quot;何をしたか&quot;, &quot;type&quot;: &quot;action&quot;},
    {&quot;id&quot;: 3, &quot;label&quot;: &quot;結果&quot;, &quot;content&quot;: &quot;どうなったか&quot;, &quot;type&quot;: &quot;result&quot;},
    {&quot;id&quot;: 4, &quot;label&quot;: &quot;学び&quot;, &quot;content&quot;: &quot;何を得たか&quot;, &quot;type&quot;: &quot;learning&quot;},
    {&quot;id&quot;: 5, &quot;label&quot;: &quot;次のアクション&quot;, &quot;content&quot;: &quot;次に何をするか&quot;, &quot;type&quot;: &quot;next&quot;}
  ],
  &quot;procedure&quot;: {
    &quot;title&quot;: &quot;業務手順書タイトル&quot;,
    &quot;goal&quot;: &quot;この手順の目標&quot;,
    &quot;steps&quot;: [
      {&quot;step&quot;: 1, &quot;title&quot;: &quot;ステップ名&quot;, &quot;action&quot;: &quot;具体的なアクション&quot;, &quot;tip&quot;: &quot;ポイント&quot;}
    ],
    &quot;checklist&quot;: [&quot;確認項目1&quot;, &quot;確認項目2&quot;]
  },
  &quot;prompts&quot;: [
    {
      &quot;category&quot;: &quot;カテゴリ名&quot;,
      &quot;title&quot;: &quot;プロンプト名&quot;,
      &quot;usecase&quot;: &quot;使用場面&quot;,
      &quot;prompt&quot;: &quot;コピペ用プロンプト本文（{{変数}}形式）&quot;,
      &quot;variables&quot;: {&quot;変数名&quot;: &quot;説明&quot;}
    }
  ],
  &quot;qiita&quot;: {
    &quot;title&quot;: &quot;記事タイトル&quot;,
    &quot;tags&quot;: [&quot;タグ1&quot;, &quot;タグ2&quot;, &quot;タグ3&quot;],
    &quot;summary&quot;: &quot;要約2〜3文&quot;,
    &quot;body&quot;: &quot;Markdown本文（800字程度）&quot;
  }
}`;

var typeStyles = {
  trigger: { bg:&quot;#fef3c7&quot;, border:&quot;#f59e0b&quot;, icon:&quot;⚡&quot; },
  action:  { bg:&quot;#dbeafe&quot;, border:&quot;#3b82f6&quot;, icon:&quot;🎯&quot; },
  result:  { bg:&quot;#d1fae5&quot;, border:&quot;#10b981&quot;, icon:&quot;📊&quot; },
  learning:{ bg:&quot;#ede9fe&quot;, border:&quot;#8b5cf6&quot;, icon:&quot;💡&quot; },
  next:    { bg:&quot;#fce7f3&quot;, border:&quot;#ec4899&quot;, icon:&quot;🚀&quot; }
};
var FIELDS=[
  { key:&quot;good&quot;,    label:&quot;✅ よかったこと（グッド）&quot;,           color:&quot;#10b981&quot;, ph:&quot;例：チームとの認識合わせがうまくいった&quot; },
  { key:&quot;bad&quot;,     label:&quot;❌ うまくいかなかったこと（バッド）&quot;, color:&quot;#ef4444&quot;, ph:&quot;例：見積もりが甘くて時間が足りなかった&quot; },
  { key:&quot;learned&quot;, label:&quot;💡 今日学んだこと&quot;,                   color:&quot;#f59e0b&quot;, ph:&quot;例：SQLのEXPLAINの読み方&quot; },
  { key:&quot;tried&quot;,   label:&quot;🚀 今日の取り組み&quot;,                   color:&quot;#8b5cf6&quot;, ph:&quot;例：新しいAIツールを試した&quot; }
];
var form={good:&quot;&quot;,bad:&quot;&quot;,learned:&quot;&quot;,tried:&quot;&quot;};
var result=null, tab=&quot;input&quot;, viewTab=&quot;diagram&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }

function buildUserMsg(){
  return [&quot;## 今日の振り返り&quot;,
    &quot;【よかったこと】&quot;+(form.good||&quot;なし&quot;),
    &quot;【うまくいかなかったこと】&quot;+(form.bad||&quot;なし&quot;),
    &quot;【学んだこと】&quot;+(form.learned||&quot;なし&quot;),
    &quot;【取り組んだこと】&quot;+(form.tried||&quot;なし&quot;)].join(&quot;\n&quot;);
}

function renderForm(){
  var g=$(&quot;formGrid&quot;); g.innerHTML=&quot;&quot;;
  FIELDS.forEach(function(f){
    var box=document.createElement(&quot;div&quot;);
    box.className=&quot;card&quot;;
    box.style.cssText=&quot;border-left:3px solid &quot;+f.color+&quot;;padding:14px;&quot;;
    box.innerHTML='<label style=&quot;display:block;font-size:12px;font-weight:700;color:'+f.color+';margin-bottom:6px;&quot;>'+f.label+'</label>'+
      '<textarea data-k=&quot;'+f.key+'&quot; placeholder=&quot;'+esc(f.ph)+'&quot; style=&quot;min-height:90px;resize:vertical;&quot;></textarea>';
    var ta=box.querySelector(&quot;textarea&quot;);
    ta.value=form[f.key];
    ta.addEventListener(&quot;input&quot;, function(){ form[f.key]=ta.value; });
    g.appendChild(box);
  });
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  [&quot;📊 具体⇔抽象4段階&quot;,&quot;🔀 フロー図解&quot;,&quot;📋 業務手順書&quot;,&quot;📎 プロンプト集&quot;,&quot;📄 Markdown記事&quot;].forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(139,92,246,.15);border:1px solid rgba(139,92,246,.3);border-radius:20px;padding:3px 11px;font-size:11px;color:#c4b5fd;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}

function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}

function handleAnalyze(){
  if(!Object.keys(form).some(function(k){return form[k].trim();})){ setErr(&quot;少なくとも1つ入力してください&quot;); return; }
  var key=$(&quot;apiKey&quot;).value.trim();
  if(!key){ setErr(&quot;APIキーが未入力です。下の「手動プロンプトをコピー」を使うか、APIキーを入力してください。&quot;); return; }
  setErr(&quot;&quot;);
  var btn=$(&quot;analyzeBtn&quot;); btn.disabled=true; btn.innerHTML='<span class=&quot;pulse&quot;>🧠</span> AIが分析中…';
  fetch(&quot;https://api.anthropic.com/v1/messages&quot;,{
    method:&quot;POST&quot;,
    headers:{ &quot;Content-Type&quot;:&quot;application/json&quot;,&quot;anthropic-version&quot;:&quot;2023-06-01&quot;,&quot;anthropic-dangerous-direct-browser-access&quot;:&quot;true&quot;,&quot;x-api-key&quot;:key },
    body:JSON.stringify({ model:&quot;claude-sonnet-4-5&quot;, max_tokens:8000, system:SYSTEM_PROMPT, messages:[{role:&quot;user&quot;,content:buildUserMsg()}] })
  }).then(function(res){ return res.json().then(function(data){ return {ok:res.ok,status:res.status,data:data}; }); })
   .then(function(r){
     if(!r.ok || r.data.error) throw new Error((r.data.error&amp;&amp;r.data.error.message)||(&quot;HTTP &quot;+r.status));
     var raw=(r.data.content||[]).map(function(c){return c.text||&quot;&quot;;}).join(&quot;&quot;);
     var m=raw.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりませんでした&quot;);
     result=JSON.parse(m[0]); setTab(&quot;result&quot;);
   }).catch(function(e){ setErr(&quot;分析に失敗しました: &quot;+e.message+&quot;（CORSやAPIキーをご確認ください。手動コピーも使えます）&quot;); })
   .then(function(){ btn.disabled=false; btn.innerHTML=&quot;🚀 AI分析してプロンプト集を生成する&quot;; });
}

function importJson(){
  setErr(&quot;&quot;);
  try{
    var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}

function copyToClip(text){
  function fall(){
    var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;;
    document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el);
  }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function copyBtn(btn, text){
  copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000);
}

var SUBTABS=[[&quot;diagram&quot;,&quot;🔀 フロー&quot;],[&quot;abstract&quot;,&quot;📐 具体⇔抽象&quot;],[&quot;procedure&quot;,&quot;📋 手順書&quot;],[&quot;prompts&quot;,&quot;📎 プロンプト集&quot;],[&quot;qiita&quot;,&quot;📄 記事&quot;]];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBTABS.forEach(function(p){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===p[0]?&quot; active&quot;:&quot;&quot;); b.textContent=p[1];
    b.onclick=function(){ viewTab=p[0]; renderResult(); };
    st.appendChild(b);
  });
  var v=$(&quot;resultView&quot;); v.innerHTML=renderView();
  [].slice.call(v.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){
    b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); });
  });
}
function card(inner){ return '<div class=&quot;card&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;diagram&quot;) return viewDiagram();
  if(viewTab===&quot;abstract&quot;) return viewAbstract();
  if(viewTab===&quot;procedure&quot;) return viewProcedure();
  if(viewTab===&quot;prompts&quot;) return viewPrompts();
  if(viewTab===&quot;qiita&quot;) return viewQiita();
  return &quot;&quot;;
}
function viewDiagram(){
  var fd=result.flow_diagram||[];
  var h='<h3 style=&quot;margin:0 0 18px;font-size:15px;color:#94a3b8;font-weight:700;&quot;>🔀 業務フロー図解</h3>';
  h+='<div style=&quot;display:flex;align-items:stretch;overflow-x:auto;padding-bottom:8px;&quot;>';
  fd.forEach(function(node,i){
    var s=typeStyles[node.type]||{bg:&quot;#f1f5f9&quot;,border:&quot;#64748b&quot;,icon:&quot;●&quot;};
    h+='<div style=&quot;display:flex;align-items:center;flex:0 0 auto;&quot;>'+
       '<div style=&quot;width:150px;background:'+s.bg+';border:2px solid '+s.border+';border-radius:12px;padding:12px;text-align:center;&quot;>'+
       '<div style=&quot;font-size:18px;margin-bottom:3px;&quot;>'+s.icon+'</div>'+
       '<div style=&quot;font-size:11px;font-weight:700;color:'+s.border+';margin-bottom:5px;&quot;>'+esc(node.label)+'</div>'+
       '<div style=&quot;font-size:11px;color:#334155;line-height:1.5;&quot;>'+esc(node.content)+'</div></div>'+
       (i<fd.length-1?'<div style=&quot;padding:0 5px;color:#64748b;font-size:18px;&quot;>→</div>':'')+'</div>';
  });
  h+='</div>';
  return h;
}
function viewAbstract(){
  var levels=[
    {key:&quot;level1_concrete&quot;,label:&quot;Lv.1 具体&quot;,desc:&quot;実際の出来事・行動&quot;,color:&quot;#10b981&quot;,icon:&quot;🔍&quot;},
    {key:&quot;level2_pattern&quot;,label:&quot;Lv.2 パターン&quot;,desc:&quot;傾向・繰り返し&quot;,color:&quot;#3b82f6&quot;,icon:&quot;🔄&quot;},
    {key:&quot;level3_principle&quot;,label:&quot;Lv.3 原則&quot;,desc:&quot;法則・ルール&quot;,color:&quot;#8b5cf6&quot;,icon:&quot;⚖️&quot;},
    {key:&quot;level4_philosophy&quot;,label:&quot;Lv.4 本質&quot;,desc:&quot;根本的な気づき&quot;,color:&quot;#ec4899&quot;,icon:&quot;✨&quot;}
  ];
  var al=result.abstract_level||{};
  var h='<h3 style=&quot;margin:0 0 18px;font-size:15px;color:#94a3b8;font-weight:700;&quot;>📐 具体⇔抽象 4段階マッピング</h3>';
  levels.forEach(function(L){
    var d=al[L.key]; var items=Array.isArray(d)?d:(d?[d]:[]);
    h+='<div style=&quot;display:flex;gap:14px;margin-bottom:10px;align-items:flex-start;&quot;>'+
       '<div style=&quot;width:110px;flex:0 0 110px;text-align:right;&quot;><div style=&quot;font-size:11px;font-weight:700;color:'+L.color+';&quot;>'+L.icon+' '+L.label+'</div>'+
       '<div style=&quot;font-size:10px;color:#64748b;&quot;>'+L.desc+'</div></div>'+
       '<div style=&quot;width:3px;background:linear-gradient(to bottom,'+L.color+',rgba(255,255,255,.1));border-radius:2px;min-height:36px;align-self:stretch;&quot;></div>'+
       '<div style=&quot;flex:1;display:flex;flex-direction:column;gap:5px;&quot;>';
    items.forEach(function(it){ h+='<div style=&quot;background:'+L.color+'18;border:1px solid '+L.color+'40;border-radius:8px;padding:8px 12px;font-size:12px;color:#e2e8f0;line-height:1.6;&quot;>'+esc(it)+'</div>'; });
    h+='</div></div>';
  });
  return h;
}
function viewProcedure(){
  var p=result.procedure; if(!p) return '<p style=&quot;color:#64748b;&quot;>手順書データがありません</p>';
  var md=&quot;# &quot;+p.title+&quot;\n\n目標: &quot;+p.goal+&quot;\n\n## 手順\n&quot;+(p.steps||[]).map(function(s){return &quot;### Step&quot;+s.step+&quot;: &quot;+s.title+&quot;\n&quot;+s.action+&quot;\n💡 &quot;+s.tip;}).join(&quot;\n\n&quot;)+&quot;\n\n## チェックリスト\n&quot;+(p.checklist||[]).map(function(c){return &quot;- [ ] &quot;+c;}).join(&quot;\n&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;&quot;>'+
        '<h3 style=&quot;margin:0;font-size:15px;color:#94a3b8;font-weight:700;&quot;>📋 業務手順書</h3>'+
        '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(md)+'&quot; style=&quot;background:rgba(16,185,129,.2);border:1px solid #10b981;border-radius:8px;padding:5px 13px;color:#6ee7b7;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  var inner='<h4 style=&quot;margin:0 0 4px;color:#a78bfa;font-size:17px;&quot;>'+esc(p.title)+'</h4><p style=&quot;margin:0 0 18px;color:#64748b;font-size:12px;&quot;>🎯 '+esc(p.goal)+'</p>';
  (p.steps||[]).forEach(function(s){
    inner+='<div style=&quot;display:flex;gap:14px;margin-bottom:14px;align-items:flex-start;&quot;>'+
      '<div style=&quot;width:32px;height:32px;background:linear-gradient(135deg,#7c3aed,#db2777);border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:13px;flex:0 0 32px;&quot;>'+esc(s.step)+'</div>'+
      '<div><div style=&quot;font-weight:700;font-size:13px;color:#e2e8f0;margin-bottom:3px;&quot;>'+esc(s.title)+'</div>'+
      '<div style=&quot;font-size:12px;color:#94a3b8;margin-bottom:3px;&quot;>'+esc(s.action)+'</div>'+
      (s.tip?'<div style=&quot;font-size:11px;color:#f59e0b;background:rgba(245,158,11,.1);border-radius:6px;padding:3px 9px;&quot;>💡 '+esc(s.tip)+'</div>':'')+'</div></div>';
  });
  if(p.checklist&amp;&amp;p.checklist.length){
    inner+='<div style=&quot;border-top:1px solid rgba(255,255,255,.08);padding-top:14px;margin-top:6px;&quot;><p style=&quot;margin:0 0 7px;font-size:12px;font-weight:700;color:#64748b;&quot;>✅ チェックリスト</p>';
    p.checklist.forEach(function(c){ inner+='<div style=&quot;display:flex;gap:7px;align-items:center;margin-bottom:5px;&quot;><div style=&quot;width:14px;height:14px;border:2px solid #8b5cf6;border-radius:4px;flex:0 0 14px;&quot;></div><span style=&quot;font-size:12px;color:#94a3b8;&quot;>'+esc(c)+'</span></div>'; });
    inner+='</div>';
  }
  return h+card(inner);
}
function viewPrompts(){
  var ps=result.prompts||[];
  var h='<h3 style=&quot;margin:0 0 18px;font-size:15px;color:#94a3b8;font-weight:700;&quot;>📎 コピペで使えるAIプロンプト集</h3><div style=&quot;display:flex;flex-direction:column;gap:14px;&quot;>';
  ps.forEach(function(p){
    var vars=&quot;&quot;;
    if(p.variables){ Object.keys(p.variables).forEach(function(k){ vars+='<span style=&quot;background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.3);border-radius:6px;padding:2px 7px;font-size:10px;color:#fbbf24;&quot;>{{'+esc(k)+'}}: '+esc(p.variables[k])+'</span>'; }); }
    h+=card(
      '<div style=&quot;display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;&quot;>'+
      '<div><span style=&quot;background:rgba(139,92,246,.2);border:1px solid rgba(139,92,246,.4);border-radius:20px;padding:2px 9px;font-size:10px;color:#a78bfa;margin-right:7px;&quot;>'+esc(p.category)+'</span>'+
      '<span style=&quot;font-weight:700;font-size:14px;color:#e2e8f0;&quot;>'+esc(p.title)+'</span></div>'+
      '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(p.prompt||&quot;&quot;)+'&quot; style=&quot;background:rgba(139,92,246,.2);border:1px solid #8b5cf6;border-radius:8px;padding:5px 12px;color:#c4b5fd;font-size:11px;cursor:pointer;font-weight:600;white-space:nowrap;&quot;>📋 コピー</button></div>'+
      '<p style=&quot;margin:0 0 8px;font-size:11px;color:#64748b;&quot;>🎯 '+esc(p.usecase)+'</p>'+
      '<div style=&quot;background:rgba(0,0,0,.3);border-radius:8px;padding:12px;font-family:monospace;font-size:11px;color:#a5f3fc;line-height:1.8;white-space:pre-wrap;word-break:break-word;&quot;>'+esc(p.prompt)+'</div>'+
      (vars?'<div style=&quot;margin-top:8px;display:flex;flex-wrap:wrap;gap:5px;&quot;>'+vars+'</div>':'')
    );
  });
  h+='</div>';
  return h;
}
function viewQiita(){
  var q=result.qiita; if(!q) return '<p style=&quot;color:#64748b;&quot;>記事データがありません</p>';
  var md=&quot;---\ntitle: &quot;+q.title+&quot;\ntags: &quot;+((q.tags||[]).join(&quot;, &quot;))+&quot;\n---\n\n&quot;+q.body;
  var tags=(q.tags||[]).map(function(t){return '<span style=&quot;background:rgba(52,211,153,.15);border:1px solid rgba(52,211,153,.3);border-radius:4px;padding:2px 7px;font-size:11px;color:#6ee7b7;&quot;>#'+esc(t)+'</span>';}).join(&quot;&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;&quot;>'+
        '<h3 style=&quot;margin:0;font-size:15px;color:#94a3b8;font-weight:700;&quot;>📄 Markdown記事</h3>'+
        '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(md)+'&quot; style=&quot;background:rgba(16,185,129,.2);border:1px solid #10b981;border-radius:8px;padding:5px 13px;color:#6ee7b7;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  var inner='<h2 style=&quot;margin:0 0 10px;color:#f0f0f0;font-size:18px;font-weight:900;line-height:1.4;&quot;>'+esc(q.title)+'</h2>'+
    '<div style=&quot;display:flex;gap:5px;flex-wrap:wrap;margin-bottom:14px;&quot;>'+tags+'</div>'+
    '<div style=&quot;background:rgba(0,0,0,.2);border-radius:8px;padding:10px;margin-bottom:14px;border-left:3px solid #8b5cf6;&quot;><p style=&quot;margin:0;font-size:12px;color:#94a3b8;line-height:1.6;&quot;>'+esc(q.summary)+'</p></div>'+
    '<pre style=&quot;margin:0;white-space:pre-wrap;word-break:break-word;font-size:12px;color:#cbd5e1;line-height:1.9;font-family:\'Noto Sans JP\',sans-serif;&quot;>'+esc(q.body)+'</pre>';
  return h+card(inner);
}

renderForm();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-subt" title="サブ講師依頼" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ サブ講師依頼ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;}
  :root{ --radius:14px; }
  body.theme-jp{
    --paper:#ffffff; --cream:#fbf4ea; --cream2:#f5e9d6; --ink:#3a2c1c; --ink-soft:#6f5a40;
    --line:#ecd9bd; --line-soft:#f5ead6; --ok:#3f8f5f; --ng:#d24b4b;
    --accent:#c47a2f; --accent-deep:#9c5d1c; --gold:#d8a763; --gold-soft:#eed4a8;
    --shadow:0 10px 30px rgba(196,122,47,.13);
  }
  body{margin:0;font-family:&quot;Hiragino Sans&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;color:var(--ink);
    background:linear-gradient(160deg,#f4e6d2,var(--cream) 42%);min-height:100vh;line-height:1.7;}
  .wrap{max-width:980px;margin:0 auto;padding:18px 16px 80px;}
  header.hero{position:relative;margin-top:24px;background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:24px 28px;box-shadow:var(--shadow);overflow:hidden;}
  header.hero::before{content:&quot;&quot;;position:absolute;inset:0 0 auto 0;height:6px;background:linear-gradient(90deg,var(--gold-soft),var(--accent),var(--gold));}
  header.hero h1{margin:0 0 6px;font-size:1.3rem;font-weight:800;padding-right:46px;}
  header.hero p{margin:0;color:var(--ink-soft);font-size:.9rem;padding-right:46px;}
  .ver-badge{display:flex;gap:8px;align-items:center;margin:0 0 8px;flex-wrap:wrap;}
  .ver-pill{display:inline-block;background:var(--accent);color:#fff;font-weight:800;font-size:.72rem;letter-spacing:.3px;padding:2px 9px;border-radius:999px;}
  .ver-date,.ver-today{color:var(--ink-soft);font-size:.74rem;}
  .ver-today:not(:empty)::before{content:&quot;｜ 今日 &quot;;opacity:.8;}
  .bunny{position:absolute;top:16px;right:20px;font-size:28px;filter:drop-shadow(0 4px 8px rgba(196,122,47,.25));}
  .lang-switch{display:none;}
  .tabs{display:flex;gap:8px;margin:16px 0;flex-wrap:wrap;}
  .tab{flex:1 1 auto;min-width:130px;text-align:center;cursor:pointer;border:1px solid var(--line);background:var(--paper);border-radius:12px;padding:9px 11px;font-weight:700;font-size:.86rem;color:var(--ink-soft);box-shadow:0 2px 5px rgba(0,0,0,.05);transition:transform .08s,box-shadow .12s,background .12s;}
  .tab:hover{transform:translateY(-1px);box-shadow:0 4px 10px rgba(0,0,0,.1);}
  .tab:active{transform:translateY(1px) scale(.99);}
  .tab.active{background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;border-color:transparent;}
  .panel{display:none;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);}
  .panel.active{display:block;}
  h2{font-size:1.1rem;margin:0 0 6px;}
  h3{font-size:.96rem;margin:16px 0 6px;color:var(--accent-deep);}
  label{display:block;font-size:.8rem;font-weight:700;color:var(--ink-soft);margin:8px 0 3px;}
  input,select,textarea{width:100%;border:1px solid var(--line);border-radius:9px;padding:8px 10px;font-size:.92rem;font-family:inherit;color:var(--ink);background:var(--paper);}
  textarea{min-height:56px;resize:vertical;}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .hint{font-size:.78rem;color:var(--ink-soft);margin:4px 0 0;}
  code{background:var(--cream2);padding:1px 5px;border-radius:5px;font-size:.86em;}
  .howto{background:var(--cream2);border:1px solid var(--line);border-left:5px solid var(--accent);border-radius:10px;padding:10px 14px;margin:0 0 14px;font-size:.84rem;color:var(--ink-soft);}
  .howto b{color:var(--accent-deep);}
  .howto ol{margin:6px 0 0;padding-left:20px;}
  .howto li{margin:2px 0;}
  .sec{border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin:10px 0;background:var(--cream);}
  .sec h3{margin:0 0 6px;}
  .checks label{display:flex;align-items:flex-start;gap:8px;font-weight:600;color:var(--ink);font-size:.88rem;margin:5px 0;}
  .checks input{width:auto;margin-top:4px;}
  button{transition:transform .08s,box-shadow .12s,filter .12s,background .12s;}
  .gen{margin-top:18px;width:100%;background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;border:none;border-radius:12px;padding:13px;font-size:1rem;font-weight:800;cursor:pointer;box-shadow:0 2px 5px rgba(0,0,0,.12);}
  .gen:hover{box-shadow:0 4px 10px rgba(0,0,0,.16);transform:translateY(-1px);}
  .gen:active{transform:translateY(1px) scale(.99);box-shadow:inset 0 3px 6px rgba(0,0,0,.2);}
  .addbtn{margin-top:8px;background:var(--cream2);border:1px dashed var(--accent);color:var(--accent-deep);border-radius:9px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.84rem;box-shadow:0 2px 5px rgba(0,0,0,.05);}
  .addbtn:hover{transform:translateY(-1px);}
  .addbtn:active{transform:translateY(1px) scale(.99);}
  .del{background:#fff;border:1px solid var(--line);color:var(--ng);border-radius:8px;padding:6px 9px;cursor:pointer;font-weight:700;}
  .row{display:flex;gap:8px;align-items:flex-start;margin:6px 0;}
  .row>*{margin:0;}
  .tplbtns{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0 10px;}
  .tplbtns button{border:1px solid var(--line);background:var(--paper);color:var(--accent-deep);border-radius:999px;padding:7px 14px;cursor:pointer;font-weight:700;font-size:.82rem;box-shadow:0 2px 5px rgba(0,0,0,.05);}
  .tplbtns button:hover{transform:translateY(-1px);background:var(--cream);}
  .tplbtns button.on{background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;border-color:transparent;}
  .outwrap{margin-top:18px;background:var(--cream2);border:1px solid var(--line);border-radius:12px;padding:14px;}
  .outwrap h3{margin-top:0;}
  pre.out{white-space:pre-wrap;word-break:break-word;background:var(--paper);border:1px solid var(--line);border-radius:9px;padding:12px;font-size:.86rem;max-height:440px;overflow:auto;font-family:inherit;}
  .outbtns{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
  .outbtns button{border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:10px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.84rem;box-shadow:0 2px 5px rgba(0,0,0,.05);}
  .outbtns button:hover{transform:translateY(-1px);}
  .outbtns button:active{transform:translateY(1px) scale(.99);}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:999px;font-size:.86rem;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50;}
  .toast.show{opacity:.95;}
  .flow{background:var(--cream2);border:1px solid var(--line);border-radius:10px;padding:12px 16px;font-size:.82rem;color:var(--ink-soft);white-space:pre-wrap;font-family:inherit;}
  @media (max-width:560px){ .grid{grid-template-columns:1fr;} header.hero h1{padding-top:30px;padding-right:0;} }
</style>
</head>
<body class=&quot;theme-jp&quot;>
<div class=&quot;wrap&quot;>
  <header class=&quot;hero&quot;>
    <div class=&quot;bunny&quot;>🐰</div>
    <h1>うさうさ サブ講師依頼ジェネレーター</h1>
    <div class=&quot;ver-badge&quot;><span class=&quot;ver-pill&quot;>v1.0</span><span class=&quot;ver-date&quot;>2026-05-22</span><span class=&quot;ver-today&quot; id=&quot;ver_today&quot;></span></div>
    <p>メイン講師⇄サブ講師の依頼・引き継ぎを工程化します。依頼シート・依頼前チェック・5種のひな形・課題管理まで。データは端末内のみ・外部送信なし。</p>
  </header>

  <div class=&quot;tabs&quot; id=&quot;tabs&quot;>
    <div class=&quot;tab active&quot; data-tab=&quot;request&quot;>📋 依頼シート</div>
    <div class=&quot;tab&quot; data-tab=&quot;check&quot;>✅ 依頼前チェック</div>
    <div class=&quot;tab&quot; data-tab=&quot;template&quot;>📨 コピペひな形</div>
    <div class=&quot;tab&quot; data-tab=&quot;issue&quot;>🐛 課題管理</div>
    <div class=&quot;tab&quot; data-tab=&quot;docs&quot;>📂 一次資料</div>
    <div class=&quot;tab&quot; data-tab=&quot;mtg&quot;>📅 MTGリスト</div>
    <div class=&quot;tab&quot; data-tab=&quot;hub&quot;>🗂 データ統合</div>
  </div>

  <!-- 依頼シート -->
  <div class=&quot;panel active&quot; id=&quot;panel-request&quot;>
    <h2>依頼シート（メイン講師 → サブ講師）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>案件ごとに、担当者・日程・研修概要・サブの役割・方針を埋める</li>
      <li>「依頼シートを生成する」で、サブ講師に渡せる依頼文ができます</li>
      <li>6STEPの流れに沿って、STEP0（依頼準備）の成果物になります</li>
    </ol></div>
    <div class=&quot;sec&quot;><h3>👥 担当者</h3>
      <div class=&quot;grid&quot;><div><label>メイン講師（依頼する側・役職名）</label><input id=&quot;rq_main&quot; placeholder=&quot;メイン講師&quot;></div>
      <div><label>サブ講師（依頼を受ける側・役職名）</label><input id=&quot;rq_sub&quot; placeholder=&quot;サブ講師&quot;></div></div>
      <div class=&quot;grid&quot;><div><label>依頼日</label><input id=&quot;rq_date&quot; placeholder=&quot;2026/05/22&quot;></div>
      <div><label>返信期日（サブがSTEP1回答）</label><input id=&quot;rq_reply&quot; placeholder=&quot;2026/05/26&quot;></div></div>
    </div>
    <div class=&quot;sec&quot;><h3>📅 日程</h3>
      <div class=&quot;grid&quot;><div><label>研修実施日</label><input id=&quot;rq_day&quot; placeholder=&quot;2026/06/02&quot;></div>
      <div><label>研修時間帯</label><input id=&quot;rq_time&quot; placeholder=&quot;10:00〜17:00&quot;></div></div>
      <div class=&quot;grid&quot;><div><label>事前資料共有期日</label><input id=&quot;rq_share&quot; placeholder=&quot;2026/05/28&quot;></div>
      <div><label>事前合わせ日時（STEP4/60分）</label><input id=&quot;rq_pre&quot; placeholder=&quot;2026/05/30 16:00〜&quot;></div></div>
    </div>
    <div class=&quot;sec&quot;><h3>🎓 研修概要</h3>
      <div class=&quot;grid&quot;><div><label>研修名</label><input id=&quot;rq_name&quot; placeholder=&quot;新卒向けLinux基礎研修&quot;></div>
      <div><label>受講者数</label><input id=&quot;rq_num&quot; placeholder=&quot;12名&quot;></div></div>
      <div><label>受講者像（職種・経験・レベル）</label><input id=&quot;rq_who&quot; placeholder=&quot;新卒・文系出身・Linux未経験&quot;></div>
      <div class=&quot;grid&quot;><div><label>事前スキル（学習済み）</label><input id=&quot;rq_skill&quot; placeholder=&quot;基本的なPC操作のみ&quot;></div>
      <div><label>研修ゴール</label><input id=&quot;rq_goal&quot; placeholder=&quot;基本コマンドでファイル操作ができる&quot;></div></div>
      <div><label>つまずきやすい点（過去の傾向）</label><textarea id=&quot;rq_stuck&quot; placeholder=&quot;絶対パスと相対パスの違い／権限の概念&quot;></textarea></div>
    </div>
    <div class=&quot;sec&quot;><h3>🛠 形式・ツール</h3>
      <div class=&quot;grid&quot;><div><label>研修形式</label><select id=&quot;rq_format&quot;><option>オンライン</option><option>対面</option><option>ハイブリッド</option></select></div>
      <div><label>使用ツール</label><input id=&quot;rq_tools&quot; placeholder=&quot;Zoom / Slack / GitHub&quot;></div></div>
      <div class=&quot;grid&quot;><div><label>グループ有無</label><input id=&quot;rq_group&quot; placeholder=&quot;有（3グループ）&quot;></div>
      <div><label>録画有無</label><select id=&quot;rq_rec&quot;><option>無</option><option>有</option></select></div></div>
    </div>
    <div class=&quot;sec&quot;><h3>🎧 サブ講師の担当役割</h3>
      <div class=&quot;checks&quot;>
        <label><input type=&quot;checkbox&quot; class=&quot;role&quot; value=&quot;チャット質問対応&quot;> チャット質問対応</label>
        <label><input type=&quot;checkbox&quot; class=&quot;role&quot; value=&quot;グループワーク巡回&quot;> グループワーク巡回</label>
        <label><input type=&quot;checkbox&quot; class=&quot;role&quot; value=&quot;ハンズオン進行サポート&quot;> ハンズオン進行サポート</label>
        <label><input type=&quot;checkbox&quot; class=&quot;role&quot; value=&quot;タイムキープ補助&quot;> タイムキープ補助</label>
      </div>
      <label>その他の役割</label><input id=&quot;rq_role_other&quot; placeholder=&quot;演習の模範解答準備 など&quot;>
    </div>
    <div class=&quot;sec&quot;><h3>🧭 メイン講師の方針</h3>
      <div class=&quot;grid&quot;><div><label>研修スタイル</label><select id=&quot;rq_style&quot;><option>受講者主体</option><option>講義中心</option><option>ハンズオン形式</option></select></div>
      <div><label>質問への答え方</label><select id=&quot;rq_qa&quot;><option>ヒントで返す</option><option>答えを伝える</option><option>場面で使い分ける</option></select></div></div>
    </div>
    <div class=&quot;sec&quot;><h3>🚨 緊急時・連絡</h3>
      <div class=&quot;grid&quot;><div><label>研修中の連絡手段</label><input id=&quot;rq_c_in&quot; placeholder=&quot;Zoom内DM&quot;></div>
      <div><label>研修外の連絡手段</label><input id=&quot;rq_c_out&quot; placeholder=&quot;Slack DM&quot;></div></div>
      <div class=&quot;grid&quot;><div><label>返信可能時間帯</label><input id=&quot;rq_c_time&quot; placeholder=&quot;平日10:00〜18:00&quot;></div>
      <div><label>特記事項</label><input id=&quot;rq_note&quot; placeholder=&quot;&quot;></div></div>
    </div>
    <button class=&quot;gen&quot; onclick=&quot;buildRequest()&quot;>依頼シートを生成する</button>
    <h3>📋 全体の流れ（6 STEP）</h3>
    <div class=&quot;flow&quot; id=&quot;flowBox&quot;></div>
  </div>

  <!-- 依頼前チェック -->
  <div class=&quot;panel&quot; id=&quot;panel-check&quot;>
    <h2>依頼前チェックリスト（メイン講師 STEP 0）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>サブに依頼を出す前に、準備が整っているかチェック</li>
      <li>「定番チェック項目を入れる」で、運用シートの項目が入ります</li>
      <li>チェックを付けて「チェック結果を生成する」</li>
    </ol></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;ckTemplate()&quot;>✅ 定番チェック項目を入れる</button>
    <div id=&quot;ckList&quot; style=&quot;margin-top:8px;&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;ckAdd()&quot;>＋ 項目を追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildCheck()&quot;>チェック結果を生成する</button>
  </div>

  <!-- コピペひな形 -->
  <div class=&quot;panel&quot; id=&quot;panel-template&quot;>
    <h2>コピペひな形（5種）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>使いたいひな形を選ぶ（依頼シート以外の4種は依頼情報を一部引き継ぎます）</li>
      <li>必要な項目を埋める</li>
      <li>「ひな形を生成する」でコピペできる文面ができます</li>
    </ol></div>
    <div class=&quot;tplbtns&quot; id=&quot;tplBtns&quot;>
      <button type=&quot;button&quot; data-tpl=&quot;request&quot; class=&quot;on&quot; onclick=&quot;tplPick('request')&quot;>① 依頼シート</button>
      <button type=&quot;button&quot; data-tpl=&quot;question&quot; onclick=&quot;tplPick('question')&quot;>② 質問テンプレ</button>
      <button type=&quot;button&quot; data-tpl=&quot;ready&quot; onclick=&quot;tplPick('ready')&quot;>③ 準備完了報告</button>
      <button type=&quot;button&quot; data-tpl=&quot;urgent&quot; onclick=&quot;tplPick('urgent')&quot;>④ 緊急連絡</button>
      <button type=&quot;button&quot; data-tpl=&quot;review&quot; onclick=&quot;tplPick('review')&quot;>⑤ 振り返り</button>
    </div>
    <div id=&quot;tplFields&quot;></div>
    <button class=&quot;gen&quot; onclick=&quot;buildTemplate()&quot;>ひな形を生成する</button>
  </div>

  <!-- 課題管理 -->
  <div class=&quot;panel&quot; id=&quot;panel-issue&quot;>
    <h2>課題管理（質問・確認・トラブル）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>研修準備〜当日に出た質問・確認事項・トラブルを1行ずつ記録</li>
      <li>区分・状態・担当をつけて管理</li>
      <li>「課題一覧を生成する」で、共有できる一覧になります</li>
    </ol></div>
    <div id=&quot;issueList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;issueAdd()&quot;>＋ 課題を追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildIssue()&quot;>課題一覧を生成する</button>
  </div>

  <!-- 一次資料 -->
  <div class=&quot;panel&quot; id=&quot;panel-docs&quot;>
    <h2>一次資料 共有リスト</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>サブ講師に共有する資料を1行ずつ登録（資料名・種別・リンク・共有者）</li>
      <li>サブ確認のチェックで、受け取り状況を管理できます</li>
      <li>「資料一覧を生成する」で、共有状況の一覧になります</li>
    </ol></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;docTemplate()&quot;>📂 定番の共有資料を入れる</button>
    <div id=&quot;docList&quot; style=&quot;margin-top:8px;&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;docAdd()&quot;>＋ 資料を追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildDocs()&quot;>資料一覧を生成する</button>
  </div>

  <!-- MTGリスト -->
  <div class=&quot;panel&quot; id=&quot;panel-mtg&quot;>
    <h2>MTGリスト（事前合わせ・振り返り 等）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>事前合わせ・中間確認・振り返りなどの打ち合わせを登録</li>
      <li>種別・日時・場所/ツール・参加者・アジェンダ・状態を記録</li>
      <li>「MTG一覧を生成する」で、予定の一覧になります</li>
    </ol></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;mtgTemplate()&quot;>📅 定番MTG（事前合わせ/中間/振り返り）を入れる</button>
    <div id=&quot;mtgList&quot; style=&quot;margin-top:8px;&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;mtgAdd()&quot;>＋ MTGを追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildMtg()&quot;>MTG一覧を生成する</button>
  </div>

  <!-- データ統合 -->
  <div class=&quot;panel&quot; id=&quot;panel-hub&quot;>
    <h2>データ統合（保存・取り込み）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>「JSON保存」で全タブの入力を1ファイルに保存</li>
      <li>「JSON取り込み」で復元できます</li>
    </ol></div>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;hubSaveJson()&quot;>💾 全データをJSON保存</button>
      <button onclick=&quot;document.getElementById('hubFile').click()&quot;>📂 JSONを取り込む</button>
      <input type=&quot;file&quot; id=&quot;hubFile&quot; accept=&quot;.json&quot; style=&quot;display:none&quot; onchange=&quot;hubLoadJson(this)&quot;>
      <button onclick=&quot;hubClearAll()&quot;>🗑 全クリア</button>
    </div>
    <p class=&quot;hint&quot;>保存したJSONはこのツールでのみ復元できます。</p>
  </div>

  <div class=&quot;outwrap&quot;>
    <h3>生成結果</h3>
    <pre class=&quot;out&quot; id=&quot;out&quot;>ここに生成結果が表示されます。各タブの「生成する」を押してください。</pre>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;copyOut()&quot;>📋 コピー</button>
      <button onclick=&quot;downloadOut('txt')&quot;>📄 テキスト保存</button>
      <button onclick=&quot;downloadOut('md')&quot;>📝 Markdown保存</button>
      <button onclick=&quot;clearOut()&quot;>クリア</button>
    </div>
  </div>
</div>
<div class=&quot;toast&quot; id=&quot;toast&quot;></div>
<script>
&quot;use strict&quot;;
function $(id){ return document.getElementById(id); }
function v(id){ var el=$(id); return el?(el.value||&quot;&quot;).trim():&quot;&quot;; }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function lines(s){ return (s||&quot;&quot;).split(/\n+/).map(function(x){return x.trim();}).filter(Boolean); }
function toast(m){ var t=$(&quot;toast&quot;); if(!t)return; t.textContent=m; t.classList.add(&quot;show&quot;); setTimeout(function(){t.classList.remove(&quot;show&quot;);},1600); }
function lsAvailable(){ try{ var k=&quot;__t&quot;+Math.random(); window.localStorage.setItem(k,&quot;1&quot;); window.localStorage.removeItem(k); return true; }catch(e){ return false; } }
function nowParts(){
  var d=new Date(), wd=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var mm=(&quot;0&quot;+(d.getMonth()+1)).slice(-2), dd=(&quot;0&quot;+d.getDate()).slice(-2);
  var hh=(&quot;0&quot;+d.getHours()).slice(-2), mi=(&quot;0&quot;+d.getMinutes()).slice(-2);
  return { date:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;）&quot;, time:hh+&quot;:&quot;+mi, datetime:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;） &quot;+hh+&quot;:&quot;+mi };
}
function todayJp(){ return nowParts().date; }
function stamp(){ return nowParts().date.replace(/[^0-9]/g,&quot;&quot;).slice(0,8); }
var BAR=&quot;────────────────────────────&quot;;

var lastOut={txt:&quot;&quot;,md:&quot;&quot;};
function setOut(txt,md){ lastOut.txt=txt||&quot;&quot;; lastOut.md=(md!=null?md:txt)||&quot;&quot;; var o=$(&quot;out&quot;); if(o) o.textContent=lastOut.txt; }
function clearOut(){ setOut(&quot;&quot;); var o=$(&quot;out&quot;); if(o) o.textContent=&quot;&quot;; toast(&quot;クリアしました&quot;); }
function copyOut(){
  var t=lastOut.txt||&quot;&quot;; if(!t){ toast(&quot;生成結果がありません&quot;); return; }
  try{ navigator.clipboard.writeText(t); toast(&quot;コピーしました&quot;); }
  catch(e){ var ta=document.createElement(&quot;textarea&quot;); ta.value=t; document.body.appendChild(ta); ta.select(); try{document.execCommand(&quot;copy&quot;);}catch(_){} document.body.removeChild(ta); toast(&quot;コピーしました&quot;); }
}
function _saveBlob(text,fname,mime){
  try{ var blob=new Blob([text],{type:mime||&quot;text/plain;charset=utf-8&quot;}); var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=fname; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(url);},500); }catch(e){ toast(&quot;保存に失敗しました&quot;); }
}
function downloadOut(fmt){
  if(!lastOut.txt){ toast(&quot;生成結果がありません&quot;); return; }
  if(fmt===&quot;md&quot;){ _saveBlob(lastOut.md,&quot;subteacher_&quot;+stamp()+&quot;.md&quot;,&quot;text/markdown;charset=utf-8&quot;); }
  else{ _saveBlob(lastOut.txt,&quot;subteacher_&quot;+stamp()+&quot;.txt&quot;,&quot;text/plain;charset=utf-8&quot;); }
}
function mkRow(html){ var d=document.createElement(&quot;div&quot;); d.className=&quot;row&quot;; d.innerHTML=html; return d; }
function delRow(btn){ var r=btn.closest(&quot;.row&quot;); if(r) r.remove(); }

var FLOW=&quot;STEP 0  メイン：依頼準備（依頼シート作成）\n   ↓\nSTEP 1  サブ ：内容確認・疑問点を質問\nSTEP 2  サブ ：資料・ツール確認・環境セットアップ\nSTEP 3  サブ ：担当パートの読み込み・リハーサル\n   ↓\nSTEP 4  両者 ：事前合わせ（60分）★最重要\n   ↓\nSTEP 5  メイン：最終確認・役割分担の承認\n   ↓\n〈当日運営〉\n   ↓\nSTEP 6  メイン：振り返り・フィードバック共有&quot;;

/* ===== ① 依頼シート ===== */
function rolesRead(){
  var arr=[].slice.call(document.querySelectorAll(&quot;.role&quot;)).filter(function(c){return c.checked;}).map(function(c){return c.value;});
  var other=v(&quot;rq_role_other&quot;); if(other) arr.push(other);
  return arr;
}
function buildRequest(){
  var roles=rolesRead();
  var o=[];
  o.push(&quot;【サブ講師 依頼シート】&quot;+(v(&quot;rq_name&quot;)||&quot;（研修名未入力）&quot;));
  o.push(&quot;依頼日：&quot;+(v(&quot;rq_date&quot;)||todayJp())+&quot;　返信期日：&quot;+(v(&quot;rq_reply&quot;)||&quot;—&quot;));
  o.push(&quot;メイン講師：&quot;+(v(&quot;rq_main&quot;)||&quot;メイン講師&quot;)+&quot;　→　サブ講師：&quot;+(v(&quot;rq_sub&quot;)||&quot;サブ講師&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 日程&quot;); o.push(BAR);
  o.push(&quot;研修実施日：&quot;+(v(&quot;rq_day&quot;)||&quot;—&quot;)+&quot;　&quot;+(v(&quot;rq_time&quot;)||&quot;&quot;));
  o.push(&quot;事前資料共有期日：&quot;+(v(&quot;rq_share&quot;)||&quot;—&quot;));
  o.push(&quot;事前合わせ（STEP4/60分）：&quot;+(v(&quot;rq_pre&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 研修概要&quot;); o.push(BAR);
  o.push(&quot;受講者数：&quot;+(v(&quot;rq_num&quot;)||&quot;—&quot;));
  o.push(&quot;受講者像：&quot;+(v(&quot;rq_who&quot;)||&quot;—&quot;));
  o.push(&quot;事前スキル：&quot;+(v(&quot;rq_skill&quot;)||&quot;—&quot;));
  o.push(&quot;研修ゴール：&quot;+(v(&quot;rq_goal&quot;)||&quot;—&quot;));
  o.push(&quot;つまずきやすい点：&quot;+(v(&quot;rq_stuck&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 形式・ツール&quot;); o.push(BAR);
  o.push(&quot;形式：&quot;+v(&quot;rq_format&quot;)+&quot;　ツール：&quot;+(v(&quot;rq_tools&quot;)||&quot;—&quot;));
  o.push(&quot;グループ：&quot;+(v(&quot;rq_group&quot;)||&quot;—&quot;)+&quot;　録画：&quot;+v(&quot;rq_rec&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ サブ講師の担当役割&quot;); o.push(BAR);
  if(roles.length){ roles.forEach(function(r){ o.push(&quot;☑ &quot;+r); }); } else { o.push(&quot;（未選択）&quot;); }
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ メイン講師の方針&quot;); o.push(BAR);
  o.push(&quot;研修スタイル：&quot;+v(&quot;rq_style&quot;));
  o.push(&quot;質問への答え方：&quot;+v(&quot;rq_qa&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 緊急時・連絡&quot;); o.push(BAR);
  o.push(&quot;研修中：&quot;+(v(&quot;rq_c_in&quot;)||&quot;—&quot;)+&quot;　研修外：&quot;+(v(&quot;rq_c_out&quot;)||&quot;—&quot;));
  o.push(&quot;返信可能時間：&quot;+(v(&quot;rq_c_time&quot;)||&quot;—&quot;));
  if(v(&quot;rq_note&quot;)) o.push(&quot;特記事項：&quot;+v(&quot;rq_note&quot;));
  o.push(&quot;&quot;); o.push(&quot;※ 内容を確認し、不明点があれば返信期日までに質問してください（STEP1）。&quot;);
  var m=[&quot;# サブ講師 依頼シート：&quot;+(v(&quot;rq_name&quot;)||&quot;（研修名未入力）&quot;),&quot;&quot;,
    &quot;- 依頼日：&quot;+(v(&quot;rq_date&quot;)||todayJp()),&quot;- 返信期日：&quot;+(v(&quot;rq_reply&quot;)||&quot;—&quot;),&quot;- メイン講師：&quot;+(v(&quot;rq_main&quot;)||&quot;メイン講師&quot;),&quot;- サブ講師：&quot;+(v(&quot;rq_sub&quot;)||&quot;サブ講師&quot;),
    &quot;&quot;,&quot;## 日程&quot;,&quot;- 研修実施日：&quot;+(v(&quot;rq_day&quot;)||&quot;—&quot;)+&quot; &quot;+(v(&quot;rq_time&quot;)||&quot;&quot;),&quot;- 事前資料共有：&quot;+(v(&quot;rq_share&quot;)||&quot;—&quot;),&quot;- 事前合わせ：&quot;+(v(&quot;rq_pre&quot;)||&quot;—&quot;),
    &quot;&quot;,&quot;## 研修概要&quot;,&quot;- 受講者数：&quot;+(v(&quot;rq_num&quot;)||&quot;—&quot;),&quot;- 受講者像：&quot;+(v(&quot;rq_who&quot;)||&quot;—&quot;),&quot;- 事前スキル：&quot;+(v(&quot;rq_skill&quot;)||&quot;—&quot;),&quot;- 研修ゴール：&quot;+(v(&quot;rq_goal&quot;)||&quot;—&quot;),&quot;- つまずきやすい点：&quot;+(v(&quot;rq_stuck&quot;)||&quot;—&quot;),
    &quot;&quot;,&quot;## 形式・ツール&quot;,&quot;- 形式：&quot;+v(&quot;rq_format&quot;),&quot;- ツール：&quot;+(v(&quot;rq_tools&quot;)||&quot;—&quot;),&quot;- グループ：&quot;+(v(&quot;rq_group&quot;)||&quot;—&quot;),&quot;- 録画：&quot;+v(&quot;rq_rec&quot;),
    &quot;&quot;,&quot;## サブ講師の担当役割&quot;,&quot;&quot;];
  if(roles.length){ roles.forEach(function(r){ m.push(&quot;- [x] &quot;+r); }); } else { m.push(&quot;- （未選択）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## メイン講師の方針&quot;); m.push(&quot;- 研修スタイル：&quot;+v(&quot;rq_style&quot;)); m.push(&quot;- 質問への答え方：&quot;+v(&quot;rq_qa&quot;));
  m.push(&quot;&quot;); m.push(&quot;## 緊急時・連絡&quot;); m.push(&quot;- 研修中：&quot;+(v(&quot;rq_c_in&quot;)||&quot;—&quot;)); m.push(&quot;- 研修外：&quot;+(v(&quot;rq_c_out&quot;)||&quot;—&quot;)); m.push(&quot;- 返信可能時間：&quot;+(v(&quot;rq_c_time&quot;)||&quot;—&quot;));
  if(v(&quot;rq_note&quot;)) m.push(&quot;- 特記事項：&quot;+v(&quot;rq_note&quot;));
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== ② 依頼前チェック ===== */
function ckAdd(cat,text,done){
  $(&quot;ckList&quot;).appendChild(mkRow(
    '<label style=&quot;display:flex;align-items:center;gap:6px;margin:0;flex:0 0 auto;&quot;><input type=&quot;checkbox&quot; class=&quot;ck-c&quot; style=&quot;width:auto&quot;'+(done?' checked':'')+'></label>'+
    '<input class=&quot;ck-cat&quot; placeholder=&quot;区分&quot; value=&quot;'+esc(cat||&quot;&quot;)+'&quot; style=&quot;max-width:26%&quot;>'+
    '<input class=&quot;ck-v&quot; placeholder=&quot;チェック項目&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function ckTemplate(){
  [[&quot;目的・受講者レベル&quot;,&quot;対象受講者の職種・役職を記入した&quot;],
   [&quot;目的・受講者レベル&quot;,&quot;受講者の現在のスキルレベルを記入した&quot;],
   [&quot;目的・受講者レベル&quot;,&quot;この研修で達成したいこと（ゴール）を記入した&quot;],
   [&quot;目的・受講者レベル&quot;,&quot;受講者がつまずきやすいポイントを記入した&quot;],
   [&quot;方針共有&quot;,&quot;研修スタイルの方針を伝えた（主体ワーク/講義中心 等）&quot;],
   [&quot;方針共有&quot;,&quot;サブ講師に担当してほしい役割を明確に伝えた&quot;],
   [&quot;方針共有&quot;,&quot;当日の緊急連絡手段を伝えた&quot;],
   [&quot;資料共有&quot;,&quot;使用スライド・教材を共有した&quot;],
   [&quot;資料共有&quot;,&quot;演習・ハンズオンの手順を共有した&quot;],
   [&quot;日程&quot;,&quot;事前合わせ（60分）の日程を確保した&quot;]].forEach(function(t){ ckAdd(t[0],t[1]); });
  toast(&quot;定番チェック項目を入れました&quot;);
}
function ckRead(){ return [].slice.call(document.querySelectorAll(&quot;#ckList .row&quot;)).map(function(r){
  return { cat:r.querySelector(&quot;.ck-cat&quot;).value.trim(), v:r.querySelector(&quot;.ck-v&quot;).value.trim(), done:r.querySelector(&quot;.ck-c&quot;).checked }; }).filter(function(x){return x.v;}); }
function buildCheck(){
  var items=ckRead(), done=items.filter(function(x){return x.done;}).length;
  var o=[];
  o.push(&quot;【依頼前チェックリスト（STEP 0）】&quot;);
  o.push(&quot;達成：&quot;+done+&quot;/&quot;+items.length+&quot;　日付：&quot;+todayJp());
  o.push(&quot;&quot;); o.push(BAR);
  var lastCat=&quot;&quot;;
  items.forEach(function(x){ if(x.cat&amp;&amp;x.cat!==lastCat){ o.push(&quot;◆ &quot;+x.cat); lastCat=x.cat; } o.push((x.done?&quot;☑&quot;:&quot;☐&quot;)+&quot; &quot;+x.v); });
  if(!items.length) o.push(&quot;（未入力）&quot;);
  if(items.length&amp;&amp;done<items.length){ o.push(&quot;&quot;); o.push(&quot;⚠️ 未完了が&quot;+(items.length-done)+&quot;件。依頼前に埋めましょう。&quot;); }
  else if(items.length){ o.push(&quot;&quot;); o.push(&quot;✅ 全項目完了。サブ講師へ依頼OKです。&quot;); }
  var m=[&quot;# 依頼前チェックリスト（STEP 0）&quot;,&quot;&quot;,&quot;達成：&quot;+done+&quot;/&quot;+items.length,&quot;&quot;,&quot;| 完了 | 区分 | チェック項目 |&quot;,&quot;|---|---|---|&quot;];
  if(items.length){ items.forEach(function(x){ m.push(&quot;| &quot;+(x.done?&quot;✅&quot;:&quot;⬜&quot;)+&quot; | &quot;+(x.cat||&quot;—&quot;)+&quot; | &quot;+x.v+&quot; |&quot;); }); } else { m.push(&quot;| — | — | （未入力） |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== ③ コピペひな形 ===== */
var curTpl=&quot;request&quot;;
var TPL_FIELDS={
  question:[[&quot;q_part&quot;,&quot;質問する箇所（パート・資料名）&quot;,&quot;STEP3 演習2の手順&quot;],[&quot;q_what&quot;,&quot;分からないこと（5分調べた上で）&quot;,&quot;模範解答のファイル場所&quot;],[&quot;q_self&quot;,&quot;自分の仮説・調べたこと&quot;,&quot;リポジトリ内を検索したが見当たらず&quot;]],
  ready:[[&quot;r_done&quot;,&quot;完了したこと（1行ずつ）&quot;,&quot;資料確認 / 環境構築 / 担当パート読み込み&quot;],[&quot;r_concern&quot;,&quot;懸念・確認したい点&quot;,&quot;ネット回線が不安定な場合の代替&quot;]],
  urgent:[[&quot;u_what&quot;,&quot;起きていること&quot;,&quot;Zoomの音声が受講者側で途切れる&quot;],[&quot;u_tried&quot;,&quot;試したこと&quot;,&quot;再接続・デバイス変更を案内済み&quot;],[&quot;u_need&quot;,&quot;メインに依頼したいこと&quot;,&quot;講義を一時中断して切り分けたい&quot;]],
  review:[[&quot;v_good&quot;,&quot;よかったこと（事実ベース）&quot;,&quot;質問対応のレスポンスが速かった&quot;],[&quot;v_bad&quot;,&quot;うまくいかなかったこと&quot;,&quot;巡回が一部グループに偏った&quot;],[&quot;v_next&quot;,&quot;次回への改善（具体策）&quot;,&quot;巡回ローテ表を事前に作る&quot;]]
};
function tplPick(tpl){
  curTpl=tpl;
  [].slice.call(document.querySelectorAll(&quot;#tplBtns button&quot;)).forEach(function(b){ b.classList.toggle(&quot;on&quot;, b.getAttribute(&quot;data-tpl&quot;)===tpl); });
  var box=$(&quot;tplFields&quot;); box.innerHTML=&quot;&quot;;
  if(tpl===&quot;request&quot;){ box.innerHTML='<p class=&quot;hint&quot;>「依頼シート」は①タブで詳細に作れます。ここでは簡易版を出力します。</p>'; return; }
  TPL_FIELDS[tpl].forEach(function(f){
    var multi=f[1].indexOf(&quot;1行ずつ&quot;)>=0;
    box.insertAdjacentHTML(&quot;beforeend&quot;,'<label>'+esc(f[1])+'</label>'+(multi?'<textarea id=&quot;'+f[0]+'&quot; placeholder=&quot;'+esc(f[2])+'&quot;></textarea>':'<input id=&quot;'+f[0]+'&quot; placeholder=&quot;'+esc(f[2])+'&quot;>'));
  });
}
function buildTemplate(){
  var name=v(&quot;rq_name&quot;)||&quot;本研修&quot;, main=v(&quot;rq_main&quot;)||&quot;メイン講師&quot;, sub=v(&quot;rq_sub&quot;)||&quot;サブ講師&quot;;
  var o=[];
  if(curTpl===&quot;request&quot;){
    buildRequest(); toast(&quot;依頼シートを生成しました（①タブで詳細編集可）&quot;); return;
  } else if(curTpl===&quot;question&quot;){
    o.push(&quot;【質問】&quot;+name+&quot;（&quot;+sub+&quot;→&quot;+main+&quot;）&quot;);
    o.push(&quot;お疲れ様です。下記について確認させてください。&quot;);
    o.push(&quot;&quot;);
    o.push(&quot;■ 箇所：&quot;+(v(&quot;q_part&quot;)||&quot;—&quot;));
    o.push(&quot;■ 分からないこと：&quot;+(v(&quot;q_what&quot;)||&quot;—&quot;));
    o.push(&quot;■ 自分の仮説・調べたこと：&quot;+(v(&quot;q_self&quot;)||&quot;—&quot;));
    o.push(&quot;&quot;);
    o.push(&quot;お手すきの際にご教示いただけますと助かります。&quot;);
  } else if(curTpl===&quot;ready&quot;){
    o.push(&quot;【準備完了報告】&quot;+name+&quot;（&quot;+sub+&quot;→&quot;+main+&quot;）&quot;);
    o.push(&quot;事前準備が完了しましたのでご報告します。&quot;);
    o.push(&quot;&quot;);
    o.push(&quot;■ 完了したこと：&quot;);
    var dn=lines(v(&quot;r_done&quot;)); if(dn.length){ dn.forEach(function(x){ o.push(&quot;　・&quot;+x); }); } else { o.push(&quot;　—&quot;); }
    o.push(&quot;■ 懸念・確認したい点：&quot;+(v(&quot;r_concern&quot;)||&quot;特になし&quot;));
    o.push(&quot;&quot;);
    o.push(&quot;事前合わせ（STEP4）でよろしくお願いします。&quot;);
  } else if(curTpl===&quot;urgent&quot;){
    o.push(&quot;🚨【緊急】&quot;+name+&quot;（&quot;+sub+&quot;→&quot;+main+&quot;）&quot;);
    o.push(&quot;■ 起きていること：&quot;+(v(&quot;u_what&quot;)||&quot;—&quot;));
    o.push(&quot;■ 試したこと：&quot;+(v(&quot;u_tried&quot;)||&quot;—&quot;));
    o.push(&quot;■ 依頼したいこと：&quot;+(v(&quot;u_need&quot;)||&quot;—&quot;));
    o.push(&quot;至急ご対応をお願いします。&quot;);
  } else if(curTpl===&quot;review&quot;){
    o.push(&quot;【振り返りシート】&quot;+name+&quot;　&quot;+todayJp());
    o.push(&quot;記入：&quot;+main+&quot;／&quot;+sub);
    o.push(&quot;&quot;);
    o.push(&quot;■ よかったこと（事実）：&quot;+(v(&quot;v_good&quot;)||&quot;—&quot;));
    o.push(&quot;■ うまくいかなかったこと：&quot;+(v(&quot;v_bad&quot;)||&quot;—&quot;));
    o.push(&quot;■ 次回への改善（具体策）：&quot;+(v(&quot;v_next&quot;)||&quot;—&quot;));
    o.push(&quot;&quot;);
    o.push(&quot;※ 感想で終わらせず、次回の具体的アクションまで落とす。&quot;);
  }
  setOut(o.join(&quot;\n&quot;), o.join(&quot;\n&quot;));
}

/* ===== ④ 課題管理 ===== */
function issueAdd(cat,text,st,owner){
  $(&quot;issueList&quot;).appendChild(mkRow(
    '<select class=&quot;is-cat&quot; style=&quot;max-width:20%&quot;>'+['質問','確認','トラブル','改善'].map(function(s){return '<option'+(cat===s?' selected':'')+'>'+s+'</option>';}).join(&quot;&quot;)+'</select>'+
    '<input class=&quot;is-v&quot; placeholder=&quot;内容&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;>'+
    '<select class=&quot;is-st&quot; style=&quot;max-width:18%&quot;>'+['未対応','対応中','解決'].map(function(s){return '<option'+(st===s?' selected':'')+'>'+s+'</option>';}).join(&quot;&quot;)+'</select>'+
    '<input class=&quot;is-o&quot; placeholder=&quot;担当&quot; value=&quot;'+esc(owner||&quot;&quot;)+'&quot; style=&quot;max-width:16%&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function issueRead(){ return [].slice.call(document.querySelectorAll(&quot;#issueList .row&quot;)).map(function(r){
  return { cat:r.querySelector(&quot;.is-cat&quot;).value, v:r.querySelector(&quot;.is-v&quot;).value.trim(), st:r.querySelector(&quot;.is-st&quot;).value, o:r.querySelector(&quot;.is-o&quot;).value.trim() }; }).filter(function(x){return x.v;}); }
function buildIssue(){
  var items=issueRead();
  var open=items.filter(function(x){return x.st!==&quot;解決&quot;;}).length;
  var o=[];
  o.push(&quot;【課題管理一覧】&quot;+(v(&quot;rq_name&quot;)||&quot;&quot;));
  o.push(&quot;未解決：&quot;+open+&quot;/&quot;+items.length+&quot;　日付：&quot;+todayJp());
  o.push(&quot;&quot;); o.push(BAR);
  if(items.length){ items.forEach(function(x,i){ o.push(&quot;[&quot;+x.st+&quot;][&quot;+x.cat+&quot;] &quot;+(i+1)+&quot;. &quot;+x.v+(x.o?(&quot;　担当:&quot;+x.o):&quot;&quot;)); }); } else { o.push(&quot;（未入力）&quot;); }
  var m=[&quot;# 課題管理一覧&quot;,&quot;&quot;,&quot;未解決：&quot;+open+&quot;/&quot;+items.length,&quot;&quot;,&quot;| 状態 | 区分 | # | 内容 | 担当 |&quot;,&quot;|---|---|---|---|---|&quot;];
  if(items.length){ items.forEach(function(x,i){ m.push(&quot;| &quot;+x.st+&quot; | &quot;+x.cat+&quot; | &quot;+(i+1)+&quot; | &quot;+x.v+&quot; | &quot;+(x.o||&quot;—&quot;)+&quot; |&quot;); }); } else { m.push(&quot;| — | — | — | （未入力） | — |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== ⑤ 一次資料 ===== */
function docAdd(name,kind,url,by,done,note){
  $(&quot;docList&quot;).appendChild(mkRow(
    '<label style=&quot;display:flex;align-items:center;gap:6px;margin:0;flex:0 0 auto;&quot;><input type=&quot;checkbox&quot; class=&quot;dc-c&quot; style=&quot;width:auto&quot;'+(done?' checked':'')+'></label>'+
    '<input class=&quot;dc-n&quot; placeholder=&quot;資料名&quot; value=&quot;'+esc(name||&quot;&quot;)+'&quot; style=&quot;max-width:26%&quot;>'+
    '<select class=&quot;dc-k&quot; style=&quot;max-width:16%&quot;>'+['スライド','コード','名簿','アジェンダ','環境','参考資料','その他'].map(function(s){return '<option'+(kind===s?' selected':'')+'>'+s+'</option>';}).join(&quot;&quot;)+'</select>'+
    '<input class=&quot;dc-u&quot; placeholder=&quot;リンクURL/場所&quot; value=&quot;'+esc(url||&quot;&quot;)+'&quot;>'+
    '<input class=&quot;dc-b&quot; placeholder=&quot;共有者&quot; value=&quot;'+esc(by||&quot;&quot;)+'&quot; style=&quot;max-width:14%&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function docTemplate(){
  [[&quot;研修スライド一式&quot;,&quot;スライド&quot;],[&quot;ハンズオン用コードテンプレ&quot;,&quot;コード&quot;],[&quot;受講者名簿・グループ分け&quot;,&quot;名簿&quot;],[&quot;アジェンダ・タイムテーブル&quot;,&quot;アジェンダ&quot;],[&quot;環境構築手順書&quot;,&quot;環境&quot;],[&quot;過去のFAQ集&quot;,&quot;参考資料&quot;]].forEach(function(t){ docAdd(t[0],t[1],&quot;&quot;,&quot;メイン講師&quot;,false,&quot;&quot;); });
  toast(&quot;定番の共有資料を入れました&quot;);
}
function docRead(){ return [].slice.call(document.querySelectorAll(&quot;#docList .row&quot;)).map(function(r){
  return { n:r.querySelector(&quot;.dc-n&quot;).value.trim(), k:r.querySelector(&quot;.dc-k&quot;).value, u:r.querySelector(&quot;.dc-u&quot;).value.trim(), b:r.querySelector(&quot;.dc-b&quot;).value.trim(), done:r.querySelector(&quot;.dc-c&quot;).checked }; }).filter(function(x){return x.n;}); }
function buildDocs(){
  var items=docRead(), done=items.filter(function(x){return x.done;}).length;
  var o=[];
  o.push(&quot;【一次資料 共有リスト】&quot;+(v(&quot;rq_name&quot;)||&quot;&quot;));
  o.push(&quot;サブ確認済：&quot;+done+&quot;/&quot;+items.length+&quot;　日付：&quot;+todayJp());
  o.push(&quot;&quot;); o.push(BAR);
  if(items.length){ items.forEach(function(x,i){ o.push((x.done?&quot;☑&quot;:&quot;☐&quot;)+&quot; &quot;+(i+1)+&quot;. [&quot;+x.k+&quot;] &quot;+x.n+(x.u?(&quot;　&quot;+x.u):&quot;&quot;)+(x.b?(&quot;　共有:&quot;+x.b):&quot;&quot;)); }); } else { o.push(&quot;（未入力）&quot;); }
  if(items.length&amp;&amp;done<items.length){ o.push(&quot;&quot;); o.push(&quot;⚠️ サブ未確認が&quot;+(items.length-done)+&quot;件あります。&quot;); }
  else if(items.length){ o.push(&quot;&quot;); o.push(&quot;✅ 全資料サブ確認済み。&quot;); }
  var m=[&quot;# 一次資料 共有リスト&quot;,&quot;&quot;,&quot;サブ確認済：&quot;+done+&quot;/&quot;+items.length,&quot;&quot;,&quot;| 確認 | # | 資料名 | 種別 | リンク | 共有者 |&quot;,&quot;|---|---|---|---|---|---|&quot;];
  if(items.length){ items.forEach(function(x,i){ m.push(&quot;| &quot;+(x.done?&quot;✅&quot;:&quot;⬜&quot;)+&quot; | &quot;+(i+1)+&quot; | &quot;+x.n+&quot; | &quot;+x.k+&quot; | &quot;+(x.u||&quot;—&quot;)+&quot; | &quot;+(x.b||&quot;—&quot;)+&quot; |&quot;); }); } else { m.push(&quot;| — | — | （未入力） | — | — | — |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== ⑥ MTGリスト ===== */
function mtgAdd(kind,when,place,who,agenda,st){
  $(&quot;mtgList&quot;).appendChild(mkRow(
    '<select class=&quot;mt-k&quot; style=&quot;max-width:16%&quot;>'+['事前合わせ','中間確認','振り返り','その他'].map(function(s){return '<option'+(kind===s?' selected':'')+'>'+s+'</option>';}).join(&quot;&quot;)+'</select>'+
    '<input class=&quot;mt-w&quot; placeholder=&quot;日時&quot; value=&quot;'+esc(when||&quot;&quot;)+'&quot; style=&quot;max-width:18%&quot;>'+
    '<input class=&quot;mt-p&quot; placeholder=&quot;場所/ツール&quot; value=&quot;'+esc(place||&quot;&quot;)+'&quot; style=&quot;max-width:16%&quot;>'+
    '<input class=&quot;mt-a&quot; placeholder=&quot;アジェンダ&quot; value=&quot;'+esc(agenda||&quot;&quot;)+'&quot;>'+
    '<select class=&quot;mt-s&quot; style=&quot;max-width:14%&quot;>'+['予定','調整中','完了'].map(function(s){return '<option'+(st===s?' selected':'')+'>'+s+'</option>';}).join(&quot;&quot;)+'</select>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function mtgTemplate(){
  [[&quot;事前合わせ&quot;,&quot;&quot;,&quot;Zoom&quot;,&quot;タイムテーブル確認 / 役割分担 / 緊急時対応&quot;,&quot;予定&quot;],[&quot;中間確認&quot;,&quot;&quot;,&quot;Slackハドル&quot;,&quot;STEP1-3進捗確認 / 不明点解消&quot;,&quot;予定&quot;],[&quot;振り返り&quot;,&quot;&quot;,&quot;Zoom&quot;,&quot;良かった点 / 改善点 / 次回引き継ぎ&quot;,&quot;予定&quot;]].forEach(function(t){ mtgAdd(t[0],t[1],t[2],&quot;&quot;,t[3],t[4]); });
  toast(&quot;定番MTGを入れました&quot;);
}
function mtgRead(){ return [].slice.call(document.querySelectorAll(&quot;#mtgList .row&quot;)).map(function(r){
  return { k:r.querySelector(&quot;.mt-k&quot;).value, w:r.querySelector(&quot;.mt-w&quot;).value.trim(), p:r.querySelector(&quot;.mt-p&quot;).value.trim(), a:r.querySelector(&quot;.mt-a&quot;).value.trim(), s:r.querySelector(&quot;.mt-s&quot;).value }; }).filter(function(x){return x.a||x.w;}); }
function buildMtg(){
  var items=mtgRead();
  var o=[];
  o.push(&quot;【MTGリスト】&quot;+(v(&quot;rq_name&quot;)||&quot;&quot;));
  o.push(&quot;件数：&quot;+items.length+&quot;　日付：&quot;+todayJp());
  o.push(&quot;&quot;); o.push(BAR);
  if(items.length){ items.forEach(function(x,i){
    o.push(&quot;[&quot;+x.s+&quot;] &quot;+(i+1)+&quot;. &quot;+x.k+(x.w?(&quot;　&quot;+x.w):&quot;&quot;)+(x.p?(&quot;　@&quot;+x.p):&quot;&quot;));
    if(x.a) o.push(&quot;　└ アジェンダ：&quot;+x.a);
  }); } else { o.push(&quot;（未入力）&quot;); }
  var m=[&quot;# MTGリスト&quot;,&quot;&quot;,&quot;| 状態 | 種別 | 日時 | 場所/ツール | アジェンダ |&quot;,&quot;|---|---|---|---|---|&quot;];
  if(items.length){ items.forEach(function(x){ m.push(&quot;| &quot;+x.s+&quot; | &quot;+x.k+&quot; | &quot;+(x.w||&quot;—&quot;)+&quot; | &quot;+(x.p||&quot;—&quot;)+&quot; | &quot;+(x.a||&quot;—&quot;)+&quot; |&quot;); }); } else { m.push(&quot;| — | — | — | — | （未入力） |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== データ統合 ===== */
function collectAll(){
  var tpl={}; [&quot;q_part&quot;,&quot;q_what&quot;,&quot;q_self&quot;,&quot;r_done&quot;,&quot;r_concern&quot;,&quot;u_what&quot;,&quot;u_tried&quot;,&quot;u_need&quot;,&quot;v_good&quot;,&quot;v_bad&quot;,&quot;v_next&quot;].forEach(function(id){ tpl[id]=v(id); });
  return { _app:&quot;usausa_subteacher&quot;, _ver:&quot;1.0&quot;, _saved:nowParts().datetime,
    request:{ main:v(&quot;rq_main&quot;),sub:v(&quot;rq_sub&quot;),date:v(&quot;rq_date&quot;),reply:v(&quot;rq_reply&quot;),day:v(&quot;rq_day&quot;),time:v(&quot;rq_time&quot;),share:v(&quot;rq_share&quot;),pre:v(&quot;rq_pre&quot;),
      name:v(&quot;rq_name&quot;),num:v(&quot;rq_num&quot;),who:v(&quot;rq_who&quot;),skill:v(&quot;rq_skill&quot;),goal:v(&quot;rq_goal&quot;),stuck:v(&quot;rq_stuck&quot;),
      format:v(&quot;rq_format&quot;),tools:v(&quot;rq_tools&quot;),group:v(&quot;rq_group&quot;),rec:v(&quot;rq_rec&quot;),roles:rolesRead(),role_other:v(&quot;rq_role_other&quot;),
      style:v(&quot;rq_style&quot;),qa:v(&quot;rq_qa&quot;),c_in:v(&quot;rq_c_in&quot;),c_out:v(&quot;rq_c_out&quot;),c_time:v(&quot;rq_c_time&quot;),note:v(&quot;rq_note&quot;) },
    check:{ items:ckRead() },
    template:{ cur:curTpl, fields:tpl },
    issue:{ items:issueRead() },
    docs:{ items:docRead() },
    mtg:{ items:mtgRead() }
  };
}
function hubSaveJson(){ _saveBlob(JSON.stringify(collectAll(),null,2),&quot;subteacher_data_&quot;+stamp()+&quot;.json&quot;,&quot;application/json;charset=utf-8&quot;); toast(&quot;全データをJSON保存しました&quot;); }
function applyAll(d){
  if(!d||typeof d!==&quot;object&quot;) return;
  function set(id,val){ var el=$(id); if(el) el.value=(val||&quot;&quot;); }
  if(d.request){ var r=d.request;
    set(&quot;rq_main&quot;,r.main);set(&quot;rq_sub&quot;,r.sub);set(&quot;rq_date&quot;,r.date);set(&quot;rq_reply&quot;,r.reply);set(&quot;rq_day&quot;,r.day);set(&quot;rq_time&quot;,r.time);set(&quot;rq_share&quot;,r.share);set(&quot;rq_pre&quot;,r.pre);
    set(&quot;rq_name&quot;,r.name);set(&quot;rq_num&quot;,r.num);set(&quot;rq_who&quot;,r.who);set(&quot;rq_skill&quot;,r.skill);set(&quot;rq_goal&quot;,r.goal);set(&quot;rq_stuck&quot;,r.stuck);
    set(&quot;rq_tools&quot;,r.tools);set(&quot;rq_group&quot;,r.group);set(&quot;rq_role_other&quot;,r.role_other);set(&quot;rq_c_in&quot;,r.c_in);set(&quot;rq_c_out&quot;,r.c_out);set(&quot;rq_c_time&quot;,r.c_time);set(&quot;rq_note&quot;,r.note);
    if(r.format) set(&quot;rq_format&quot;,r.format); if(r.rec) set(&quot;rq_rec&quot;,r.rec); if(r.style) set(&quot;rq_style&quot;,r.style); if(r.qa) set(&quot;rq_qa&quot;,r.qa);
    var rs=r.roles||[]; [].slice.call(document.querySelectorAll(&quot;.role&quot;)).forEach(function(c){ c.checked=rs.indexOf(c.value)>=0; }); }
  if(d.check){ $(&quot;ckList&quot;).innerHTML=&quot;&quot;; (d.check.items||[]).forEach(function(x){ ckAdd(x.cat,x.v,x.done); }); }
  if(d.template){ if(d.template.cur) tplPick(d.template.cur); var f=d.template.fields||{}; Object.keys(f).forEach(function(id){ var el=$(id); if(el) el.value=f[id]; }); }
  if(d.issue){ $(&quot;issueList&quot;).innerHTML=&quot;&quot;; (d.issue.items||[]).forEach(function(x){ issueAdd(x.cat,x.v,x.st,x.o); }); }
  if(d.docs){ $(&quot;docList&quot;).innerHTML=&quot;&quot;; (d.docs.items||[]).forEach(function(x){ docAdd(x.n,x.k,x.u,x.b,x.done); }); }
  if(d.mtg){ $(&quot;mtgList&quot;).innerHTML=&quot;&quot;; (d.mtg.items||[]).forEach(function(x){ mtgAdd(x.k,x.w,x.p,&quot;&quot;,x.a,x.s); }); }
}
function hubLoadJson(input){
  var f=input&amp;&amp;input.files&amp;&amp;input.files[0]; if(!f){ return; }
  var rd=new FileReader();
  rd.onload=function(){ try{ applyAll(JSON.parse(rd.result)); toast(&quot;JSONを取り込みました&quot;); }catch(e){ toast(&quot;JSONの読み込みに失敗しました&quot;); } input.value=&quot;&quot;; };
  rd.readAsText(f);
}
function hubClearAll(){
  if(!window.confirm(&quot;すべての入力をクリアします。よろしいですか？&quot;)) return;
  [&quot;rq_main&quot;,&quot;rq_sub&quot;,&quot;rq_date&quot;,&quot;rq_reply&quot;,&quot;rq_day&quot;,&quot;rq_time&quot;,&quot;rq_share&quot;,&quot;rq_pre&quot;,&quot;rq_name&quot;,&quot;rq_num&quot;,&quot;rq_who&quot;,&quot;rq_skill&quot;,&quot;rq_goal&quot;,&quot;rq_stuck&quot;,&quot;rq_tools&quot;,&quot;rq_group&quot;,&quot;rq_role_other&quot;,&quot;rq_c_in&quot;,&quot;rq_c_out&quot;,&quot;rq_c_time&quot;,&quot;rq_note&quot;,&quot;q_part&quot;,&quot;q_what&quot;,&quot;q_self&quot;,&quot;r_done&quot;,&quot;r_concern&quot;,&quot;u_what&quot;,&quot;u_tried&quot;,&quot;u_need&quot;,&quot;v_good&quot;,&quot;v_bad&quot;,&quot;v_next&quot;].forEach(function(id){ var el=$(id); if(el) el.value=&quot;&quot;; });
  [].slice.call(document.querySelectorAll(&quot;.role&quot;)).forEach(function(c){ c.checked=false; });
  $(&quot;ckList&quot;).innerHTML=&quot;&quot;; $(&quot;issueList&quot;).innerHTML=&quot;&quot;; $(&quot;docList&quot;).innerHTML=&quot;&quot;; $(&quot;mtgList&quot;).innerHTML=&quot;&quot;;
  setOut(&quot;&quot;); $(&quot;out&quot;).textContent=&quot;&quot;;
  toast(&quot;全クリアしました&quot;);
}

/* ===== タブ ===== */
function switchPanel(tab){
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.classList.toggle(&quot;active&quot;, t.dataset.tab===tab); });
  [].slice.call(document.querySelectorAll(&quot;.panel&quot;)).forEach(function(p){ p.classList.toggle(&quot;active&quot;, p.id===&quot;panel-&quot;+tab); });
}

/* ===== init ===== */
(function(){
  if($(&quot;flowBox&quot;)) $(&quot;flowBox&quot;).textContent=FLOW;
  tplPick(&quot;request&quot;);
  issueAdd();
  docAdd();
  mtgAdd();
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.addEventListener(&quot;click&quot;, function(){ switchPanel(t.dataset.tab); }); });
  try{ var vt=$(&quot;ver_today&quot;); if(vt) vt.textContent=nowParts().date; }catch(e){}
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-fuwa" title="ふわふわ指示変換" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ ふわふわ指示 変換ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;}
  :root{ --radius:14px; }
  body.theme-jp{
    --paper:#ffffff; --cream:#eef5fb; --cream2:#e1edf8; --ink:#1f2c3a; --ink-soft:#566578;
    --line:#d3e3f2; --line-soft:#e6f0fa; --ok:#3f8f5f; --ng:#d24b4b;
    --accent:#2f7fc4; --accent-deep:#1f5d96; --gold:#6fa9d8; --gold-soft:#c2dcf0;
    --shadow:0 10px 30px rgba(47,127,196,.13);
  }
  body{margin:0;font-family:&quot;Hiragino Sans&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;color:var(--ink);
    background:linear-gradient(160deg,#dbe9f6,var(--cream) 42%);min-height:100vh;line-height:1.7;}
  .wrap{max-width:980px;margin:0 auto;padding:18px 16px 80px;}
  header.hero{position:relative;margin-top:24px;background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:24px 28px;box-shadow:var(--shadow);overflow:hidden;}
  header.hero::before{content:&quot;&quot;;position:absolute;inset:0 0 auto 0;height:6px;background:linear-gradient(90deg,var(--gold-soft),var(--accent),var(--gold));}
  header.hero h1{margin:0 0 6px;font-size:1.3rem;font-weight:800;padding-right:46px;}
  header.hero p{margin:0;color:var(--ink-soft);font-size:.9rem;padding-right:46px;}
  .ver-badge{display:flex;gap:8px;align-items:center;margin:0 0 8px;flex-wrap:wrap;}
  .ver-pill{display:inline-block;background:var(--accent);color:#fff;font-weight:800;font-size:.72rem;letter-spacing:.3px;padding:2px 9px;border-radius:999px;}
  .ver-date,.ver-today{color:var(--ink-soft);font-size:.74rem;}
  .ver-today:not(:empty)::before{content:&quot;｜ 今日 &quot;;opacity:.8;}
  .bunny{position:absolute;top:16px;right:20px;font-size:28px;filter:drop-shadow(0 4px 8px rgba(47,127,196,.25));}
  .lang-switch{display:none;}
  .tabs{display:flex;gap:8px;margin:16px 0;flex-wrap:wrap;}
  .tab{flex:1 1 auto;min-width:130px;text-align:center;cursor:pointer;border:1px solid var(--line);background:var(--paper);border-radius:12px;padding:9px 11px;font-weight:700;font-size:.86rem;color:var(--ink-soft);box-shadow:0 2px 5px rgba(0,0,0,.05);transition:transform .08s,box-shadow .12s,background .12s;}
  .tab:hover{transform:translateY(-1px);box-shadow:0 4px 10px rgba(0,0,0,.1);}
  .tab:active{transform:translateY(1px) scale(.99);}
  .tab.active{background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;border-color:transparent;}
  .panel{display:none;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);}
  .panel.active{display:block;}
  h2{font-size:1.1rem;margin:0 0 6px;}
  h3{font-size:.96rem;margin:16px 0 6px;color:var(--accent-deep);}
  label{display:block;font-size:.8rem;font-weight:700;color:var(--ink-soft);margin:8px 0 3px;}
  input,select,textarea{width:100%;border:1px solid var(--line);border-radius:9px;padding:8px 10px;font-size:.92rem;font-family:inherit;color:var(--ink);background:var(--paper);}
  textarea{min-height:56px;resize:vertical;}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .hint{font-size:.78rem;color:var(--ink-soft);margin:4px 0 0;}
  code{background:var(--cream2);padding:1px 5px;border-radius:5px;font-size:.86em;}
  .howto{background:var(--cream2);border:1px solid var(--line);border-left:5px solid var(--accent);border-radius:10px;padding:10px 14px;margin:0 0 14px;font-size:.84rem;color:var(--ink-soft);}
  .howto b{color:var(--accent-deep);}
  .howto ol{margin:6px 0 0;padding-left:20px;}
  .howto li{margin:2px 0;}
  .w-block{border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin:10px 0;background:var(--cream);}
  .w-block h3{margin:0 0 6px;}
  button{transition:transform .08s,box-shadow .12s,filter .12s,background .12s;}
  .gen{margin-top:18px;width:100%;background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;border:none;border-radius:12px;padding:13px;font-size:1rem;font-weight:800;cursor:pointer;box-shadow:0 2px 5px rgba(0,0,0,.12);}
  .gen:hover{box-shadow:0 4px 10px rgba(0,0,0,.16);transform:translateY(-1px);}
  .gen:active{transform:translateY(1px) scale(.99);box-shadow:inset 0 3px 6px rgba(0,0,0,.2);}
  .addbtn{margin-top:8px;background:var(--cream2);border:1px dashed var(--accent);color:var(--accent-deep);border-radius:9px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.84rem;box-shadow:0 2px 5px rgba(0,0,0,.05);}
  .addbtn:hover{transform:translateY(-1px);}
  .addbtn:active{transform:translateY(1px) scale(.99);}
  .del{background:#fff;border:1px solid var(--line);color:var(--ng);border-radius:8px;padding:6px 9px;cursor:pointer;font-weight:700;}
  .row{display:flex;gap:8px;align-items:flex-start;margin:6px 0;}
  .row>*{margin:0;}
  .outwrap{margin-top:18px;background:var(--cream2);border:1px solid var(--line);border-radius:12px;padding:14px;}
  .outwrap h3{margin-top:0;}
  pre.out{white-space:pre-wrap;word-break:break-word;background:var(--paper);border:1px solid var(--line);border-radius:9px;padding:12px;font-size:.86rem;max-height:440px;overflow:auto;font-family:inherit;}
  .outbtns{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
  .outbtns button{border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:10px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.84rem;box-shadow:0 2px 5px rgba(0,0,0,.05);}
  .outbtns button:hover{transform:translateY(-1px);}
  .outbtns button:active{transform:translateY(1px) scale(.99);}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:999px;font-size:.86rem;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50;}
  .toast.show{opacity:.95;}
  .transtable{width:100%;border-collapse:collapse;margin-top:8px;font-size:.86rem;}
  .transtable th,.transtable td{border:1px solid var(--line);padding:6px 9px;text-align:left;}
  .transtable th{background:var(--cream2);color:var(--accent-deep);}
  .transtable .pick{cursor:pointer;}
  .transtable .pick:hover{background:var(--cream);}
  @media (max-width:560px){ .grid{grid-template-columns:1fr;} header.hero h1{padding-top:30px;padding-right:0;} }
</style>
</head>
<body class=&quot;theme-jp&quot;>
<div class=&quot;wrap&quot;>
  <header class=&quot;hero&quot;>
    <div class=&quot;bunny&quot;>🐰</div>
    <h1>うさうさ ふわふわ指示 変換ジェネレーター</h1>
    <div class=&quot;ver-badge&quot;><span class=&quot;ver-pill&quot;>v1.0</span><span class=&quot;ver-date&quot;>2026-05-22</span><span class=&quot;ver-today&quot; id=&quot;ver_today&quot;></span></div>
    <p>「いい感じにやっといて」を、測定可能な仕様に翻訳します。5W3H分解 → YES/NO確認文 → 引継ぎメモまで。データは端末内のみ・外部送信なし。</p>
  </header>

  <div class=&quot;tabs&quot; id=&quot;tabs&quot;>
    <div class=&quot;tab active&quot; data-tab=&quot;bunkai&quot;>🧩 5W3H分解</div>
    <div class=&quot;tab&quot; data-tab=&quot;confirm&quot;>📨 確認メッセージ</div>
    <div class=&quot;tab&quot; data-tab=&quot;handoff&quot;>🤝 引継ぎメモ</div>
    <div class=&quot;tab&quot; data-tab=&quot;trans&quot;>🔢 ふわふわ語→数値</div>
    <div class=&quot;tab&quot; data-tab=&quot;hub&quot;>🗂 データ統合</div>
  </div>

  <!-- 5W3H分解 -->
  <div class=&quot;panel active&quot; id=&quot;panel-bunkai&quot;>
    <h2>5W3H分解（測定可能な仕様にする）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>受けたふわふわ指示を上に貼る</li>
      <li>WHY/WHAT/WHEN/WHO/HOW/測定基準/やらないこと を仮置きで埋める（推測でOK）</li>
      <li>「仕様に分解する」で、確認できる仕様書になります</li>
    </ol></div>
    <div class=&quot;grid&quot;>
      <div><label>受けたふわふわ指示（原文）</label><input id=&quot;bk_raw&quot; placeholder=&quot;次の研修資料、いい感じにまとめといて&quot;></div>
      <div><label>案件名</label><input id=&quot;bk_title&quot; placeholder=&quot;次回研修 配布資料&quot;></div>
    </div>
    <div class=&quot;w-block&quot;><h3>🎯 WHY（なぜ）</h3>
      <div class=&quot;grid&quot;><div><label>表向きの理由</label><input id=&quot;bk_why1&quot; placeholder=&quot;次回研修の資料が必要だから&quot;></div>
      <div><label>推測される本質</label><input id=&quot;bk_why2&quot; placeholder=&quot;受講満足度を上げて契約更改したい&quot;></div></div>
    </div>
    <div class=&quot;w-block&quot;><h3>📦 WHAT（何を）</h3>
      <div class=&quot;grid&quot;><div><label>成果物の種類</label><input id=&quot;bk_what_kind&quot; placeholder=&quot;PowerPoint資料&quot;></div>
      <div><label>分量（枚数・ページ）</label><input id=&quot;bk_what_vol&quot; placeholder=&quot;15スライド ±2&quot;></div></div>
      <div class=&quot;grid&quot;><div><label>形式</label><input id=&quot;bk_what_fmt&quot; placeholder=&quot;PPTX + PDF&quot;></div>
      <div><label>配布形式</label><input id=&quot;bk_what_dist&quot; placeholder=&quot;Docswell公開 + 印刷10部&quot;></div></div>
    </div>
    <div class=&quot;w-block&quot;><h3>⏰ WHEN（いつまで）</h3>
      <div class=&quot;grid&quot;><div><label>最終納期</label><input id=&quot;bk_when_due&quot; placeholder=&quot;2026/05/10 17:00&quot;></div>
      <div><label>中間レビュー</label><input id=&quot;bk_when_mid&quot; placeholder=&quot;2026/05/05&quot;></div></div>
    </div>
    <div class=&quot;w-block&quot;><h3>👥 WHO/WHOM（誰が誰のために）</h3>
      <div class=&quot;grid&quot;><div><label>作業担当</label><input id=&quot;bk_who_do&quot; placeholder=&quot;自分（メイン）＋サブ講師（レビュー）&quot;></div>
      <div><label>対象読者・レベル</label><input id=&quot;bk_who_for&quot; placeholder=&quot;受講者（IT初心者・学習2週目）&quot;></div></div>
      <div class=&quot;grid&quot;><div><label>関係者（CC/FYI）</label><input id=&quot;bk_who_cc&quot; placeholder=&quot;上長・人事担当&quot;></div>
      <div><label>最終決裁</label><input id=&quot;bk_who_ok&quot; placeholder=&quot;上長の承認後リリース&quot;></div></div>
    </div>
    <div class=&quot;w-block&quot;><h3>🛠 HOW（どうやって）</h3>
      <div><label>方法・ツール・基準（1行ずつ）</label><textarea id=&quot;bk_how&quot; placeholder=&quot;使用ツール：pptxgenjs → PDF検証&amp;#10;デザイン：既存ライト系テーマ踏襲&amp;#10;コード：実機検証済みのみ掲載&quot;></textarea></div>
    </div>
    <div class=&quot;w-block&quot;><h3>📏 測定可能な完了基準（1行ずつ）</h3>
      <div><label>完了条件（数値で）</label><textarea id=&quot;bk_dod&quot; placeholder=&quot;スライド15枚±2&amp;#10;図解 章ごと1個以上&amp;#10;演習問題 5問以上&amp;#10;校正 0件&quot;></textarea></div>
    </div>
    <div class=&quot;w-block&quot;><h3>🚫 やらないこと（スコープ外・1行ずつ）</h3>
      <div><label>含まないこと</label><textarea id=&quot;bk_not&quot; placeholder=&quot;動画・音声は含めない&amp;#10;個人名・会社名は記載しない（役職名のみ）&amp;#10;LPI公式以外の出典は使わない&quot;></textarea></div>
    </div>
    <button class=&quot;gen&quot; onclick=&quot;buildBunkai()&quot;>仕様に分解する</button>
  </div>

  <!-- 確認メッセージ -->
  <div class=&quot;panel&quot; id=&quot;panel-confirm&quot;>
    <h2>確認メッセージ（YES/NOで答えられる形）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>5W3H分解を先に埋めると、その内容が自動で反映されます</li>
      <li>送る相手と、形式（標準／超圧縮／選択肢）を選ぶ</li>
      <li>「確認メッセージを作る」でコピペできる文面ができます</li>
    </ol></div>
    <div class=&quot;grid&quot;>
      <div><label>送る相手（役職名）</label><input id=&quot;cf_to&quot; placeholder=&quot;上長&quot;></div>
      <div><label>形式</label><select id=&quot;cf_type&quot;><option value=&quot;std&quot;>標準版（30秒で読める）</option><option value=&quot;short&quot;>超圧縮版（忙しい上司向け）</option><option value=&quot;choice&quot;>選択肢提示版（A/B案）</option></select></div>
    </div>
    <p class=&quot;hint&quot;>「選択肢提示版」のときは、下のA案・B案も使われます。</p>
    <div class=&quot;grid&quot;>
      <div><label>A案（メリット/デメリット）</label><textarea id=&quot;cf_a&quot; placeholder=&quot;既存テーマ踏襲・15枚・5/10&amp;#10;メリット：早い・統一感&amp;#10;デメリット：新鮮味なし&quot;></textarea></div>
      <div><label>B案（メリット/デメリット）</label><textarea id=&quot;cf_b&quot; placeholder=&quot;新規デザイン・20枚・5/15&amp;#10;メリット：印象残る&amp;#10;デメリット：5日遅れる&quot;></textarea></div>
    </div>
    <label><input type=&quot;checkbox&quot; id=&quot;cf_48&quot; style=&quot;width:auto&quot; checked> 「48時間返信なき場合は提案通り進めます」を添える</label>
    <button class=&quot;gen&quot; onclick=&quot;buildConfirm()&quot;>確認メッセージを作る</button>
  </div>

  <!-- 引継ぎメモ -->
  <div class=&quot;panel&quot; id=&quot;panel-handoff&quot;>
    <h2>引継ぎメモ（同僚・後輩へ）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>5W3H分解の確定値が「確定仕様」に自動で入ります</li>
      <li>判断軸・上司の好み・自己判断OK範囲・要確認事項を埋める</li>
      <li>「引継ぎメモを作る」で、誰でも引き継げる文書になります</li>
    </ol></div>
    <div class=&quot;grid&quot;>
      <div><label>案件ID</label><input id=&quot;ho_id&quot; placeholder=&quot;WO-001&quot;></div>
      <div><label>引継ぎ先（役職名）</label><input id=&quot;ho_to&quot; placeholder=&quot;サブ講師&quot;></div>
    </div>
    <div><label>判断軸（迷ったらこの順・1行ずつ）</label><textarea id=&quot;ho_axis&quot; placeholder=&quot;期日厳守&amp;#10;公式準拠&amp;#10;既存デザイン踏襲&amp;#10;文字を増やすより図解を増やす&quot;></textarea></div>
    <div><label>上司の好みポイント（1行ずつ）</label><textarea id=&quot;ho_pref&quot; placeholder=&quot;シンプル＞詳細&amp;#10;図解多め&amp;#10;報告は箇条書き3行以内&quot;></textarea></div>
    <div><label>自己判断していい範囲（1行ずつ）</label><textarea id=&quot;ho_self&quot; placeholder=&quot;図解の色味&amp;#10;フォント選択&amp;#10;章タイトルの言い回し&quot;></textarea></div>
    <div><label>必ず確認が必要な変更（1行ずつ）</label><textarea id=&quot;ho_must&quot; placeholder=&quot;スコープの追加・削減&amp;#10;期日の前後&amp;#10;公開先の変更&quot;></textarea></div>
    <button class=&quot;gen&quot; onclick=&quot;buildHandoff()&quot;>引継ぎメモを作る</button>
  </div>

  <!-- ふわふわ語→数値 -->
  <div class=&quot;panel&quot; id=&quot;panel-trans&quot;>
    <h2>ふわふわ語 → 測定可能化</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>下の語彙集の行をクリックすると「変換メモ」に追加されます</li>
      <li>自分の言葉も「ふわふわ語」「数値化」に入れて追加できます</li>
      <li>「変換表を出力する」で、自分用の翻訳辞書ができます</li>
    </ol></div>
    <table class=&quot;transtable&quot;><thead><tr><th>ふわふわ語</th><th>測定可能な変換（例）</th></tr></thead><tbody id=&quot;transBody&quot;></tbody></table>
    <h3>自分の変換を追加</h3>
    <div class=&quot;row&quot;><input id=&quot;tr_word&quot; placeholder=&quot;ふわふわ語&quot; style=&quot;max-width:30%&quot;><input id=&quot;tr_num&quot; placeholder=&quot;測定可能な変換&quot;><button type=&quot;button&quot; class=&quot;addbtn&quot; style=&quot;margin:0&quot; onclick=&quot;trAddCustom()&quot;>＋追加</button></div>
    <h3>変換メモ（採用したもの）</h3>
    <div id=&quot;trPicked&quot;></div>
    <button class=&quot;gen&quot; onclick=&quot;buildTrans()&quot;>変換表を出力する</button>
  </div>

  <!-- データ統合 -->
  <div class=&quot;panel&quot; id=&quot;panel-hub&quot;>
    <h2>データ統合（保存・取り込み）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>「JSON保存」で全タブの入力を1ファイルに保存</li>
      <li>「JSON取り込み」で復元できます</li>
    </ol></div>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;hubSaveJson()&quot;>💾 全データをJSON保存</button>
      <button onclick=&quot;document.getElementById('hubFile').click()&quot;>📂 JSONを取り込む</button>
      <input type=&quot;file&quot; id=&quot;hubFile&quot; accept=&quot;.json&quot; style=&quot;display:none&quot; onchange=&quot;hubLoadJson(this)&quot;>
      <button onclick=&quot;hubClearAll()&quot;>🗑 全クリア</button>
    </div>
    <p class=&quot;hint&quot;>保存したJSONはこのツールでのみ復元できます。</p>
  </div>

  <div class=&quot;outwrap&quot;>
    <h3>生成結果</h3>
    <pre class=&quot;out&quot; id=&quot;out&quot;>ここに生成結果が表示されます。各タブの「生成する」を押してください。</pre>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;copyOut()&quot;>📋 コピー</button>
      <button onclick=&quot;downloadOut('txt')&quot;>📄 テキスト保存</button>
      <button onclick=&quot;downloadOut('md')&quot;>📝 Markdown保存</button>
      <button onclick=&quot;clearOut()&quot;>クリア</button>
    </div>
  </div>
</div>
<div class=&quot;toast&quot; id=&quot;toast&quot;></div>
<script>
&quot;use strict&quot;;
function $(id){ return document.getElementById(id); }
function v(id){ var el=$(id); return el?(el.value||&quot;&quot;).trim():&quot;&quot;; }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function lines(s){ return (s||&quot;&quot;).split(/\n+/).map(function(x){return x.trim();}).filter(Boolean); }
function toast(m){ var t=$(&quot;toast&quot;); if(!t)return; t.textContent=m; t.classList.add(&quot;show&quot;); setTimeout(function(){t.classList.remove(&quot;show&quot;);},1600); }
function lsAvailable(){ try{ var k=&quot;__t&quot;+Math.random(); window.localStorage.setItem(k,&quot;1&quot;); window.localStorage.removeItem(k); return true; }catch(e){ return false; } }
function nowParts(){
  var d=new Date(), wd=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var mm=(&quot;0&quot;+(d.getMonth()+1)).slice(-2), dd=(&quot;0&quot;+d.getDate()).slice(-2);
  var hh=(&quot;0&quot;+d.getHours()).slice(-2), mi=(&quot;0&quot;+d.getMinutes()).slice(-2);
  return { date:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;）&quot;, time:hh+&quot;:&quot;+mi, datetime:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;） &quot;+hh+&quot;:&quot;+mi };
}
function todayJp(){ return nowParts().date; }
function stamp(){ return nowParts().date.replace(/[^0-9]/g,&quot;&quot;).slice(0,8); }
var BAR=&quot;────────────────────────────&quot;;

var lastOut={txt:&quot;&quot;,md:&quot;&quot;};
function setOut(txt,md){ lastOut.txt=txt||&quot;&quot;; lastOut.md=(md!=null?md:txt)||&quot;&quot;; var o=$(&quot;out&quot;); if(o) o.textContent=lastOut.txt; }
function clearOut(){ setOut(&quot;&quot;); var o=$(&quot;out&quot;); if(o) o.textContent=&quot;&quot;; toast(&quot;クリアしました&quot;); }
function copyOut(){
  var t=lastOut.txt||&quot;&quot;; if(!t){ toast(&quot;生成結果がありません&quot;); return; }
  try{ navigator.clipboard.writeText(t); toast(&quot;コピーしました&quot;); }
  catch(e){ var ta=document.createElement(&quot;textarea&quot;); ta.value=t; document.body.appendChild(ta); ta.select(); try{document.execCommand(&quot;copy&quot;);}catch(_){} document.body.removeChild(ta); toast(&quot;コピーしました&quot;); }
}
function _saveBlob(text,fname,mime){
  try{ var blob=new Blob([text],{type:mime||&quot;text/plain;charset=utf-8&quot;}); var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=fname; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(url);},500); }catch(e){ toast(&quot;保存に失敗しました&quot;); }
}
function downloadOut(fmt){
  if(!lastOut.txt){ toast(&quot;生成結果がありません&quot;); return; }
  if(fmt===&quot;md&quot;){ _saveBlob(lastOut.md,&quot;fuwafuwa_&quot;+stamp()+&quot;.md&quot;,&quot;text/markdown;charset=utf-8&quot;); }
  else{ _saveBlob(lastOut.txt,&quot;fuwafuwa_&quot;+stamp()+&quot;.txt&quot;,&quot;text/plain;charset=utf-8&quot;); }
}
function mkRow(html){ var d=document.createElement(&quot;div&quot;); d.className=&quot;row&quot;; d.innerHTML=html; return d; }
function delRow(btn){ var r=btn.closest(&quot;.row&quot;); if(r) r.remove(); }

/* ===== ① 5W3H分解 ===== */
function buildBunkai(){
  var title=v(&quot;bk_title&quot;)||&quot;（無題案件）&quot;;
  var how=lines(v(&quot;bk_how&quot;)), dod=lines(v(&quot;bk_dod&quot;)), not=lines(v(&quot;bk_not&quot;));
  var o=[];
  o.push(&quot;【ふわふわ指示 → 仕様分解】&quot;+title);
  o.push(&quot;受けた指示：&quot;+(v(&quot;bk_raw&quot;)||&quot;—&quot;));
  o.push(&quot;分解日：&quot;+todayJp());
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 🎯 WHY（なぜ）&quot;); o.push(BAR);
  o.push(&quot;表向きの理由：&quot;+(v(&quot;bk_why1&quot;)||&quot;—&quot;));
  o.push(&quot;推測される本質：&quot;+(v(&quot;bk_why2&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 📦 WHAT（何を）&quot;); o.push(BAR);
  o.push(&quot;種類：&quot;+(v(&quot;bk_what_kind&quot;)||&quot;—&quot;));
  o.push(&quot;分量：&quot;+(v(&quot;bk_what_vol&quot;)||&quot;—&quot;));
  o.push(&quot;形式：&quot;+(v(&quot;bk_what_fmt&quot;)||&quot;—&quot;));
  o.push(&quot;配布：&quot;+(v(&quot;bk_what_dist&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ ⏰ WHEN（いつまで）&quot;); o.push(BAR);
  o.push(&quot;最終納期：&quot;+(v(&quot;bk_when_due&quot;)||&quot;—&quot;));
  o.push(&quot;中間レビュー：&quot;+(v(&quot;bk_when_mid&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 👥 WHO/WHOM（誰が誰のために）&quot;); o.push(BAR);
  o.push(&quot;作業担当：&quot;+(v(&quot;bk_who_do&quot;)||&quot;—&quot;));
  o.push(&quot;対象読者：&quot;+(v(&quot;bk_who_for&quot;)||&quot;—&quot;));
  o.push(&quot;関係者：&quot;+(v(&quot;bk_who_cc&quot;)||&quot;—&quot;));
  o.push(&quot;最終決裁：&quot;+(v(&quot;bk_who_ok&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 🛠 HOW（どうやって）&quot;); o.push(BAR);
  if(how.length){ how.forEach(function(x){ o.push(&quot;・&quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 📏 測定可能な完了基準&quot;); o.push(BAR);
  if(dod.length){ dod.forEach(function(x){ o.push(&quot;□ &quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 🚫 やらないこと（スコープ外）&quot;); o.push(BAR);
  if(not.length){ not.forEach(function(x){ o.push(&quot;・&quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  var m=[&quot;# ふわふわ指示 → 仕様分解：&quot;+title,&quot;&quot;,&quot;- 受けた指示：&quot;+(v(&quot;bk_raw&quot;)||&quot;—&quot;),&quot;- 分解日：&quot;+todayJp(),
    &quot;&quot;,&quot;## 🎯 WHY&quot;,&quot;- 表向き：&quot;+(v(&quot;bk_why1&quot;)||&quot;—&quot;),&quot;- 本質（推測）：&quot;+(v(&quot;bk_why2&quot;)||&quot;—&quot;),
    &quot;&quot;,&quot;## 📦 WHAT&quot;,&quot;| 項目 | 値 |&quot;,&quot;|---|---|&quot;,&quot;| 種類 | &quot;+(v(&quot;bk_what_kind&quot;)||&quot;—&quot;)+&quot; |&quot;,&quot;| 分量 | &quot;+(v(&quot;bk_what_vol&quot;)||&quot;—&quot;)+&quot; |&quot;,&quot;| 形式 | &quot;+(v(&quot;bk_what_fmt&quot;)||&quot;—&quot;)+&quot; |&quot;,&quot;| 配布 | &quot;+(v(&quot;bk_what_dist&quot;)||&quot;—&quot;)+&quot; |&quot;,
    &quot;&quot;,&quot;## ⏰ WHEN&quot;,&quot;- 最終納期：&quot;+(v(&quot;bk_when_due&quot;)||&quot;—&quot;),&quot;- 中間レビュー：&quot;+(v(&quot;bk_when_mid&quot;)||&quot;—&quot;),
    &quot;&quot;,&quot;## 👥 WHO/WHOM&quot;,&quot;- 作業担当：&quot;+(v(&quot;bk_who_do&quot;)||&quot;—&quot;),&quot;- 対象読者：&quot;+(v(&quot;bk_who_for&quot;)||&quot;—&quot;),&quot;- 関係者：&quot;+(v(&quot;bk_who_cc&quot;)||&quot;—&quot;),&quot;- 最終決裁：&quot;+(v(&quot;bk_who_ok&quot;)||&quot;—&quot;),
    &quot;&quot;,&quot;## 🛠 HOW&quot;,&quot;&quot;];
  if(how.length){ how.forEach(function(x){ m.push(&quot;- &quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## 📏 測定可能な完了基準&quot;); m.push(&quot;&quot;);
  if(dod.length){ dod.forEach(function(x){ m.push(&quot;- [ ] &quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## 🚫 やらないこと&quot;); m.push(&quot;&quot;);
  if(not.length){ not.forEach(function(x){ m.push(&quot;- &quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== ② 確認メッセージ ===== */
function buildConfirm(){
  var to=v(&quot;cf_to&quot;)||&quot;（相手）&quot;, type=v(&quot;cf_type&quot;)||&quot;std&quot;;
  var title=v(&quot;bk_title&quot;)||&quot;本件&quot;;
  var why=v(&quot;bk_why1&quot;)||v(&quot;bk_why2&quot;)||&quot;—&quot;;
  var what=[v(&quot;bk_what_kind&quot;),v(&quot;bk_what_vol&quot;),v(&quot;bk_what_fmt&quot;)].filter(Boolean).join(&quot; / &quot;)||&quot;—&quot;;
  var dist=v(&quot;bk_what_dist&quot;)||&quot;&quot;;
  var due=v(&quot;bk_when_due&quot;)||&quot;—&quot;, mid=v(&quot;bk_when_mid&quot;)||&quot;&quot;;
  var dod=lines(v(&quot;bk_dod&quot;)), not=lines(v(&quot;bk_not&quot;));
  var add48=$(&quot;cf_48&quot;).checked;
  var o=[];
  if(type===&quot;std&quot;){
    o.push(&quot;件名：【着手前確認】&quot;+title+&quot; 認識合わせ（30秒で読めます）&quot;);
    o.push(&quot;&quot;);
    o.push(to+&quot; お疲れ様です。&quot;);
    o.push(&quot;&quot;);
    o.push(title+&quot;の件、以下の理解で着手して問題ないでしょうか。&quot;);
    o.push(&quot;ご返信は「OK」または修正点だけで結構です。&quot;);
    o.push(&quot;&quot;);
    o.push(&quot;【目的】&quot;+why);
    o.push(&quot;【成果物】&quot;+what+(dist?(&quot; / &quot;+dist):&quot;&quot;));
    o.push(&quot;【期日】最終：&quot;+due+(mid?(&quot;　中間レビュー：&quot;+mid):&quot;&quot;));
    if(not.length) o.push(&quot;【含まないこと】&quot;+not.join(&quot;／&quot;));
    if(dod.length){ o.push(&quot;【完了基準】&quot;); dod.forEach(function(d){ o.push(&quot;　・&quot;+d); }); }
    o.push(&quot;&quot;);
    o.push(&quot;上記で問題なければ「OK」とだけご返信ください。&quot;);
    o.push(&quot;修正があれば該当箇所のみ書き換えていただければ反映します。&quot;);
    if(add48){ o.push(&quot;&quot;); o.push(&quot;※48時間ご返信なき場合は、上記の通り進めます。&quot;); }
    o.push(&quot;&quot;);
    o.push(&quot;以上、よろしくお願いいたします。&quot;);
  } else if(type===&quot;short&quot;){
    o.push(title+&quot;の件、下記で着手します。NGあれば指摘ください。&quot;);
    o.push(&quot;【目的】&quot;+why+&quot;　【成果物】&quot;+what+&quot;　【期日】&quot;+due+&quot;　【主担当】&quot;+(v(&quot;bk_who_do&quot;)||&quot;自分&quot;));
    if(add48) o.push(&quot;返信なし＝OKと判断します（48時間ルール）。&quot;);
  } else {
    o.push(title+&quot;の件、A/Bの2案あります。どちらで進めますか？&quot;);
    o.push(&quot;&quot;);
    o.push(&quot;【案A】&quot;);
    (lines(v(&quot;cf_a&quot;)).length?lines(v(&quot;cf_a&quot;)):[&quot;（A案を入力）&quot;]).forEach(function(x){ o.push(&quot;　&quot;+x); });
    o.push(&quot;&quot;);
    o.push(&quot;【案B】&quot;);
    (lines(v(&quot;cf_b&quot;)).length?lines(v(&quot;cf_b&quot;)):[&quot;（B案を入力）&quot;]).forEach(function(x){ o.push(&quot;　&quot;+x); });
    o.push(&quot;&quot;);
    o.push(&quot;ご指示をお願いします。&quot;);
    if(add48) o.push(&quot;※48時間ご返信なき場合は案Aで進めます。&quot;);
  }
  setOut(o.join(&quot;\n&quot;), o.join(&quot;\n&quot;));
}

/* ===== ③ 引継ぎメモ ===== */
function buildHandoff(){
  var id=v(&quot;ho_id&quot;)||&quot;WO-XXX&quot;, to=v(&quot;ho_to&quot;)||&quot;（引継ぎ先）&quot;;
  var title=v(&quot;bk_title&quot;)||&quot;本件&quot;;
  var axis=lines(v(&quot;ho_axis&quot;)), pref=lines(v(&quot;ho_pref&quot;)), self=lines(v(&quot;ho_self&quot;)), must=lines(v(&quot;ho_must&quot;));
  var o=[];
  o.push(&quot;【&quot;+id+&quot;】&quot;+title+&quot; 引継ぎメモ（→ &quot;+to+&quot;）&quot;);
  o.push(&quot;&quot;);
  o.push(&quot;■ 確定済みの仕様（YES/NO確認済み）&quot;);
  o.push(&quot;目的：&quot;+(v(&quot;bk_why1&quot;)||v(&quot;bk_why2&quot;)||&quot;—&quot;));
  o.push(&quot;成果物：&quot;+[v(&quot;bk_what_kind&quot;),v(&quot;bk_what_vol&quot;),v(&quot;bk_what_fmt&quot;)].filter(Boolean).join(&quot; / &quot;)||&quot;—&quot;);
  o.push(&quot;期日：&quot;+(v(&quot;bk_when_due&quot;)||&quot;—&quot;));
  o.push(&quot;対象：&quot;+(v(&quot;bk_who_for&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;);
  o.push(&quot;■ 🚦 判断軸（迷ったらこの順で優先）&quot;);
  if(axis.length){ axis.forEach(function(x,i){ o.push((i+1)+&quot;. &quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;);
  o.push(&quot;■ 上司の好みポイント&quot;);
  if(pref.length){ pref.forEach(function(x){ o.push(&quot;☑ &quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;);
  o.push(&quot;■ 自己判断していい範囲&quot;);
  if(self.length){ self.forEach(function(x){ o.push(&quot;・&quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;);
  o.push(&quot;■ ⚠️ 必ず確認が必要な変更&quot;);
  if(must.length){ must.forEach(function(x){ o.push(&quot;・&quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  var m=[&quot;# [&quot;+id+&quot;] &quot;+title+&quot; 引継ぎメモ&quot;,&quot;&quot;,&quot;**引継ぎ先**：&quot;+to,&quot;&quot;,&quot;## 確定済みの仕様&quot;,&quot;- 目的：&quot;+(v(&quot;bk_why1&quot;)||v(&quot;bk_why2&quot;)||&quot;—&quot;),&quot;- 成果物：&quot;+([v(&quot;bk_what_kind&quot;),v(&quot;bk_what_vol&quot;),v(&quot;bk_what_fmt&quot;)].filter(Boolean).join(&quot; / &quot;)||&quot;—&quot;),&quot;- 期日：&quot;+(v(&quot;bk_when_due&quot;)||&quot;—&quot;),&quot;- 対象：&quot;+(v(&quot;bk_who_for&quot;)||&quot;—&quot;),&quot;&quot;,&quot;## 🚦 判断軸&quot;,&quot;&quot;];
  if(axis.length){ axis.forEach(function(x,i){ m.push((i+1)+&quot;. &quot;+x); }); } else { m.push(&quot;1. （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## 上司の好みポイント&quot;); m.push(&quot;&quot;);
  if(pref.length){ pref.forEach(function(x){ m.push(&quot;- [x] &quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## 自己判断していい範囲&quot;); m.push(&quot;&quot;);
  if(self.length){ self.forEach(function(x){ m.push(&quot;- &quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## ⚠️ 必ず確認が必要な変更&quot;); m.push(&quot;&quot;);
  if(must.length){ must.forEach(function(x){ m.push(&quot;- &quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== ④ ふわふわ語→数値 ===== */
var TRANS=[
  [&quot;いい感じに&quot;,&quot;既存テーマ踏襲・分量と納期を明示&quot;],
  [&quot;しっかり&quot;,&quot;図解3個以上・演習5問以上&quot;],
  [&quot;分かりやすく&quot;,&quot;1スライド80字以内・専門用語に注釈&quot;],
  [&quot;ちゃんと&quot;,&quot;公式出典付き・校正0件&quot;],
  [&quot;すぐに&quot;,&quot;48時間以内に初稿&quot;],
  [&quot;たくさん&quot;,&quot;7個以上&quot;],
  [&quot;クオリティ高く&quot;,&quot;レビュー2回以上・修正反映100%&quot;],
  [&quot;シンプルに&quot;,&quot;1スライド1メッセージ・色3色以内&quot;],
  [&quot;印象的に&quot;,&quot;キービジュアル1枚・キャッチコピー10字以内&quot;],
  [&quot;早めに&quot;,&quot;期日3日前に初稿&quot;]
];
function renderTransTable(){
  var b=$(&quot;transBody&quot;); b.innerHTML=&quot;&quot;;
  TRANS.forEach(function(p,i){
    var tr=document.createElement(&quot;tr&quot;); tr.className=&quot;pick&quot;;
    tr.innerHTML='<td>'+esc(p[0])+'</td><td>'+esc(p[1])+'</td>';
    tr.onclick=function(){ trPick(p[0],p[1]); };
    b.appendChild(tr);
  });
}
function trPick(word,num){
  $(&quot;trPicked&quot;).appendChild(mkRow('<input class=&quot;tp-w&quot; value=&quot;'+esc(word)+'&quot; style=&quot;max-width:30%&quot;><input class=&quot;tp-n&quot; value=&quot;'+esc(num)+'&quot;><button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
  toast(&quot;「&quot;+word+&quot;」を追加しました&quot;);
}
function trAddCustom(){
  var w=v(&quot;tr_word&quot;), n=v(&quot;tr_num&quot;);
  if(!w&amp;&amp;!n){ toast(&quot;入力してください&quot;); return; }
  trPick(w,n); $(&quot;tr_word&quot;).value=&quot;&quot;; $(&quot;tr_num&quot;).value=&quot;&quot;;
}
function trPickedRead(){ return [].slice.call(document.querySelectorAll(&quot;#trPicked .row&quot;)).map(function(r){return {w:r.querySelector(&quot;.tp-w&quot;).value.trim(),n:r.querySelector(&quot;.tp-n&quot;).value.trim()};}).filter(function(x){return x.w||x.n;}); }
function buildTrans(){
  var picked=trPickedRead();
  var o=[];
  o.push(&quot;【ふわふわ語 → 測定可能化 辞書】&quot;);
  o.push(&quot;作成日：&quot;+todayJp());
  o.push(&quot;&quot;); o.push(BAR);
  if(picked.length){ picked.forEach(function(p){ o.push(&quot;「&quot;+(p.w||&quot;—&quot;)+&quot;」 → &quot;+(p.n||&quot;—&quot;)); }); } else { o.push(&quot;（採用したものがありません。表をクリックで追加）&quot;); }
  var m=[&quot;# ふわふわ語 → 測定可能化 辞書&quot;,&quot;&quot;,&quot;| ふわふわ語 | 測定可能な変換 |&quot;,&quot;|---|---|&quot;];
  if(picked.length){ picked.forEach(function(p){ m.push(&quot;| &quot;+(p.w||&quot;—&quot;)+&quot; | &quot;+(p.n||&quot;—&quot;)+&quot; |&quot;); }); } else { m.push(&quot;| — | （未採用） |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== データ統合 ===== */
function collectAll(){
  return { _app:&quot;usausa_fuwafuwa&quot;, _ver:&quot;1.0&quot;, _saved:nowParts().datetime,
    bunkai:{ raw:v(&quot;bk_raw&quot;),title:v(&quot;bk_title&quot;),why1:v(&quot;bk_why1&quot;),why2:v(&quot;bk_why2&quot;),
      what_kind:v(&quot;bk_what_kind&quot;),what_vol:v(&quot;bk_what_vol&quot;),what_fmt:v(&quot;bk_what_fmt&quot;),what_dist:v(&quot;bk_what_dist&quot;),
      when_due:v(&quot;bk_when_due&quot;),when_mid:v(&quot;bk_when_mid&quot;),
      who_do:v(&quot;bk_who_do&quot;),who_for:v(&quot;bk_who_for&quot;),who_cc:v(&quot;bk_who_cc&quot;),who_ok:v(&quot;bk_who_ok&quot;),
      how:v(&quot;bk_how&quot;),dod:v(&quot;bk_dod&quot;),not:v(&quot;bk_not&quot;) },
    confirm:{ to:v(&quot;cf_to&quot;),type:v(&quot;cf_type&quot;),a:v(&quot;cf_a&quot;),b:v(&quot;cf_b&quot;),add48:$(&quot;cf_48&quot;).checked },
    handoff:{ id:v(&quot;ho_id&quot;),to:v(&quot;ho_to&quot;),axis:v(&quot;ho_axis&quot;),pref:v(&quot;ho_pref&quot;),self:v(&quot;ho_self&quot;),must:v(&quot;ho_must&quot;) },
    trans:{ picked:trPickedRead() }
  };
}
function hubSaveJson(){ _saveBlob(JSON.stringify(collectAll(),null,2),&quot;fuwafuwa_data_&quot;+stamp()+&quot;.json&quot;,&quot;application/json;charset=utf-8&quot;); toast(&quot;全データをJSON保存しました&quot;); }
function applyAll(d){
  if(!d||typeof d!==&quot;object&quot;) return;
  function set(id,val){ var el=$(id); if(el) el.value=(val||&quot;&quot;); }
  if(d.bunkai){ var b=d.bunkai;
    set(&quot;bk_raw&quot;,b.raw);set(&quot;bk_title&quot;,b.title);set(&quot;bk_why1&quot;,b.why1);set(&quot;bk_why2&quot;,b.why2);
    set(&quot;bk_what_kind&quot;,b.what_kind);set(&quot;bk_what_vol&quot;,b.what_vol);set(&quot;bk_what_fmt&quot;,b.what_fmt);set(&quot;bk_what_dist&quot;,b.what_dist);
    set(&quot;bk_when_due&quot;,b.when_due);set(&quot;bk_when_mid&quot;,b.when_mid);
    set(&quot;bk_who_do&quot;,b.who_do);set(&quot;bk_who_for&quot;,b.who_for);set(&quot;bk_who_cc&quot;,b.who_cc);set(&quot;bk_who_ok&quot;,b.who_ok);
    set(&quot;bk_how&quot;,b.how);set(&quot;bk_dod&quot;,b.dod);set(&quot;bk_not&quot;,b.not); }
  if(d.confirm){ set(&quot;cf_to&quot;,d.confirm.to); if(d.confirm.type) set(&quot;cf_type&quot;,d.confirm.type); set(&quot;cf_a&quot;,d.confirm.a); set(&quot;cf_b&quot;,d.confirm.b); if($(&quot;cf_48&quot;)) $(&quot;cf_48&quot;).checked=(d.confirm.add48!==false); }
  if(d.handoff){ set(&quot;ho_id&quot;,d.handoff.id);set(&quot;ho_to&quot;,d.handoff.to);set(&quot;ho_axis&quot;,d.handoff.axis);set(&quot;ho_pref&quot;,d.handoff.pref);set(&quot;ho_self&quot;,d.handoff.self);set(&quot;ho_must&quot;,d.handoff.must); }
  if(d.trans){ $(&quot;trPicked&quot;).innerHTML=&quot;&quot;; (d.trans.picked||[]).forEach(function(p){ trPick(p.w,p.n); }); }
}
function hubLoadJson(input){
  var f=input&amp;&amp;input.files&amp;&amp;input.files[0]; if(!f){ return; }
  var rd=new FileReader();
  rd.onload=function(){ try{ applyAll(JSON.parse(rd.result)); toast(&quot;JSONを取り込みました&quot;); }catch(e){ toast(&quot;JSONの読み込みに失敗しました&quot;); } input.value=&quot;&quot;; };
  rd.readAsText(f);
}
function hubClearAll(){
  if(!window.confirm(&quot;すべての入力をクリアします。よろしいですか？&quot;)) return;
  [&quot;bk_raw&quot;,&quot;bk_title&quot;,&quot;bk_why1&quot;,&quot;bk_why2&quot;,&quot;bk_what_kind&quot;,&quot;bk_what_vol&quot;,&quot;bk_what_fmt&quot;,&quot;bk_what_dist&quot;,&quot;bk_when_due&quot;,&quot;bk_when_mid&quot;,&quot;bk_who_do&quot;,&quot;bk_who_for&quot;,&quot;bk_who_cc&quot;,&quot;bk_who_ok&quot;,&quot;bk_how&quot;,&quot;bk_dod&quot;,&quot;bk_not&quot;,&quot;cf_to&quot;,&quot;cf_a&quot;,&quot;cf_b&quot;,&quot;ho_id&quot;,&quot;ho_to&quot;,&quot;ho_axis&quot;,&quot;ho_pref&quot;,&quot;ho_self&quot;,&quot;ho_must&quot;,&quot;tr_word&quot;,&quot;tr_num&quot;].forEach(function(id){ var el=$(id); if(el) el.value=&quot;&quot;; });
  $(&quot;trPicked&quot;).innerHTML=&quot;&quot;; if($(&quot;cf_48&quot;)) $(&quot;cf_48&quot;).checked=true;
  setOut(&quot;&quot;); $(&quot;out&quot;).textContent=&quot;&quot;;
  toast(&quot;全クリアしました&quot;);
}

/* ===== タブ ===== */
function switchPanel(tab){
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.classList.toggle(&quot;active&quot;, t.dataset.tab===tab); });
  [].slice.call(document.querySelectorAll(&quot;.panel&quot;)).forEach(function(p){ p.classList.toggle(&quot;active&quot;, p.id===&quot;panel-&quot;+tab); });
}

/* ===== init ===== */
(function(){
  renderTransTable();
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.addEventListener(&quot;click&quot;, function(){ switchPanel(t.dataset.tab); }); });
  try{ var vt=$(&quot;ver_today&quot;); if(vt) vt.textContent=nowParts().date; }catch(e){}
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-nav" title="要求定義ナビ" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>🐰 うさうさ要求定義ナビ｜文系さんのための要求工学スキル診断＆業務分配ツール</title>
<style>
:root{
  --cream:#FFF8EE; --cream2:#FFEFD8; --paper:#FFFCF6;
  --orange:#FF8A3D; --orange-d:#F26B1F; --orange-l:#FFB877;
  --gold:#E0A53A; --gold-l:#F4CE73; --gold-soft:#FBE9C2;
  --ink:#4A3520; --ink-soft:#7A6347; --line:#EAD9BC;
  /* 三信号 */
  --aka:#E2483D; --aka-bg:#FDEAE8; --aka-d:#B72B22;
  --ki:#E7A100;  --ki-bg:#FFF3D2;  --ki-d:#B07900;
  --ao:#2E83C9;  --ao-bg:#E5F1FB;  --ao-d:#1E5E96;
  --shadow:0 10px 30px rgba(196,128,40,.18);
  --shadow-s:0 4px 14px rgba(196,128,40,.14);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:&quot;Zen Kaku Gothic New&quot;,sans-serif; color:var(--ink);
  background:
    radial-gradient(circle at 12% -5%, #FFE6C2 0%, transparent 40%),
    radial-gradient(circle at 92% 0%, #FFD9B0 0%, transparent 35%),
    linear-gradient(160deg,var(--cream) 0%, var(--cream2) 100%);
  background-attachment:fixed; min-height:100vh; line-height:1.7;
  -webkit-font-smoothing:antialiased;
}
.wrap{max-width:980px;margin:0 auto;padding:0 18px 80px}

/* ===== Header ===== */
header{padding:30px 0 14px;text-align:center;position:relative}
.bunny{font-size:54px;display:inline-block;filter:drop-shadow(0 6px 8px rgba(196,128,40,.3));animation:hop 3.4s ease-in-out infinite}
@keyframes hop{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-9px) rotate(3deg)}}
h1{font-family:&quot;Zen Maru Gothic&quot;;font-weight:900;font-size:clamp(22px,4.4vw,33px);color:var(--orange-d);letter-spacing:.02em;margin-top:6px;line-height:1.3;text-shadow:1px 2px 0 #fff}
.subtitle{font-size:14px;color:var(--ink-soft);margin-top:8px;font-weight:500}
.tagline{display:inline-block;margin-top:12px;font-family:&quot;Zen Maru Gothic&quot;;font-weight:700;font-size:13px;color:var(--gold);background:var(--gold-soft);padding:5px 16px;border-radius:999px;border:1.5px dashed var(--gold-l)}

/* ===== Tabs ===== */
nav{position:sticky;top:0;z-index:50;background:rgba(255,248,238,.86);backdrop-filter:blur(8px);border-radius:18px;padding:8px;margin:18px 0 26px;display:flex;gap:6px;flex-wrap:wrap;justify-content:center;box-shadow:var(--shadow-s);border:1.5px solid var(--line)}
.tab{font-family:&quot;Zen Maru Gothic&quot;;font-weight:700;font-size:13px;border:none;background:transparent;color:var(--ink-soft);padding:9px 14px;border-radius:12px;cursor:pointer;transition:.18s;white-space:nowrap}
.tab:hover{background:var(--gold-soft);color:var(--orange-d)}
.tab.active{background:linear-gradient(135deg,var(--orange),var(--orange-d));color:#fff;box-shadow:0 4px 12px rgba(242,107,31,.4)}

/* ===== Cards ===== */
.view{display:none;animation:fade .4s ease}
.view.show{display:block}
@keyframes fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.card{background:var(--paper);border-radius:22px;padding:26px 24px;box-shadow:var(--shadow);border:1.5px solid var(--line);margin-bottom:20px}
.card h2{font-family:&quot;Zen Maru Gothic&quot;;font-weight:900;font-size:21px;color:var(--orange-d);display:flex;align-items:center;gap:9px;margin-bottom:14px}
.card h3{font-family:&quot;Zen Maru Gothic&quot;;font-weight:700;font-size:16px;color:var(--gold);margin:18px 0 8px;border-left:5px solid var(--gold-l);padding-left:10px}
.card p{margin-bottom:10px}
.lead{font-size:15px}

.note-box{background:var(--gold-soft);border-radius:14px;padding:14px 16px;border:1.5px dashed var(--gold-l);font-size:13.5px;margin:14px 0}
.note-box b{color:var(--orange-d)}
.bunny-say{display:flex;gap:10px;align-items:flex-start;background:var(--cream2);border-radius:16px;padding:14px 16px;margin:14px 0;border:1.5px solid var(--line)}
.bunny-say .ic{font-size:28px;flex-shrink:0}
.bunny-say .txt{font-size:13.5px}
.bunny-say .txt b{color:var(--orange-d)}

/* ramen ladder */
.ladder{display:grid;gap:8px;margin:12px 0}
.rung{display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:center;background:#fff;border:1.5px solid var(--line);border-radius:14px;padding:11px 14px}
.rung .step{font-family:&quot;M PLUS Rounded 1c&quot;;font-weight:800;font-size:13px;color:#fff;background:var(--orange);padding:4px 11px;border-radius:999px;white-space:nowrap}
.rung .step.s2{background:var(--gold)}
.rung .step.s3{background:var(--ao)}
.rung .step.s4{background:var(--ink-soft)}
.rung small{color:var(--ink-soft)}

.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:680px){.grid2{grid-template-columns:1fr}}
.dim-card{background:#fff;border:1.5px solid var(--line);border-radius:14px;padding:13px 15px}
.dim-card .n{font-family:&quot;Zen Maru Gothic&quot;;font-weight:900;color:var(--orange-d);font-size:14px;margin-bottom:3px}
.dim-card small{color:var(--ink-soft);font-size:12.5px}

/* signal legend */
.signals{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:14px 0}
@media(max-width:680px){.signals{grid-template-columns:1fr}}
.sig{border-radius:16px;padding:15px;border:2px solid}
.sig.aka{background:var(--aka-bg);border-color:var(--aka)}
.sig.ki{background:var(--ki-bg);border-color:var(--ki)}
.sig.ao{background:var(--ao-bg);border-color:var(--ao)}
.sig .lamp{font-size:26px}
.sig .lv{font-family:&quot;Zen Maru Gothic&quot;;font-weight:900;font-size:15px;margin:4px 0}
.sig.aka .lv{color:var(--aka-d)}.sig.ki .lv{color:var(--ki-d)}.sig.ao .lv{color:var(--ao-d)}
.sig small{font-size:12px;color:var(--ink-soft);display:block}

/* ===== Quiz ===== */
.q{background:#fff;border:1.5px solid var(--line);border-radius:16px;padding:16px 18px;margin-bottom:14px}
.q .qhead{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:9px;flex-wrap:wrap}
.q .qno{font-family:&quot;M PLUS Rounded 1c&quot;;font-weight:800;color:var(--orange);font-size:14px}
.q .tag{font-size:11px;background:var(--gold-soft);color:var(--gold);padding:3px 9px;border-radius:999px;font-weight:700}
.q .qtext{font-weight:500;margin-bottom:11px;font-size:14.5px}
.opt{display:block;background:var(--cream);border:1.5px solid var(--line);border-radius:11px;padding:10px 13px;margin-bottom:7px;cursor:pointer;transition:.15s;font-size:13.5px}
.opt:hover{border-color:var(--orange-l);background:var(--gold-soft)}
.opt input{margin-right:8px;accent-color:var(--orange)}
.opt.correct{background:var(--ao-bg);border-color:var(--ao)}
.opt.wrong{background:var(--aka-bg);border-color:var(--aka)}
.explain{display:none;font-size:12.5px;background:var(--gold-soft);border-radius:10px;padding:9px 12px;margin-top:8px;border-left:4px solid var(--gold)}
.explain.show{display:block}
.explain b{color:var(--orange-d)}

/* oral */
.scenario{background:var(--ao-bg);border:1.5px solid var(--ao);border-radius:14px;padding:14px 16px;margin-bottom:10px;font-size:14px}
.scenario .role{font-family:&quot;Zen Maru Gothic&quot;;font-weight:700;color:var(--ao-d);font-size:13px;margin-bottom:5px}
textarea{width:100%;border:1.5px solid var(--line);border-radius:12px;padding:11px 13px;font-family:inherit;font-size:14px;color:var(--ink);resize:vertical;min-height:84px;background:var(--cream)}
textarea:focus{outline:none;border-color:var(--orange);background:#fff}
.rubric{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;align-items:center}
.rubric .lbl{font-size:12.5px;color:var(--ink-soft);font-weight:700}
.rscore{border:1.5px solid var(--line);background:#fff;border-radius:9px;width:38px;height:34px;cursor:pointer;font-family:&quot;M PLUS Rounded 1c&quot;;font-weight:800;color:var(--ink-soft);transition:.15s}
.rscore:hover{border-color:var(--orange-l)}
.rscore.sel{background:var(--orange);color:#fff;border-color:var(--orange-d)}
.model-q{display:none;margin-top:10px;background:var(--gold-soft);border-radius:11px;padding:11px 14px;border-left:4px solid var(--gold);font-size:12.5px}
.model-q.show{display:block}
.model-q ul{margin:6px 0 0 18px}
.model-q li{margin-bottom:4px}

/* buttons */
.btn{font-family:&quot;Zen Maru Gothic&quot;;font-weight:700;font-size:14px;border:none;border-radius:13px;padding:12px 24px;cursor:pointer;transition:.18s}
.btn-main{background:linear-gradient(135deg,var(--orange),var(--orange-d));color:#fff;box-shadow:0 5px 16px rgba(242,107,31,.4)}
.btn-main:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(242,107,31,.5)}
.btn-ghost{background:#fff;color:var(--orange-d);border:1.5px solid var(--orange-l)}
.btn-ghost:hover{background:var(--gold-soft)}
.btn-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}

/* ===== Score view ===== */
.score-dims{display:grid;gap:10px;margin:16px 0}
.bar-row{display:grid;grid-template-columns:130px 1fr 52px;gap:10px;align-items:center}
@media(max-width:560px){.bar-row{grid-template-columns:96px 1fr 44px}}
.bar-row .name{font-size:12.5px;font-weight:700;color:var(--ink)}
.bar-track{background:var(--cream2);border-radius:999px;height:16px;overflow:hidden;border:1px solid var(--line)}
.bar-fill{height:100%;border-radius:999px;background:linear-gradient(90deg,var(--gold-l),var(--orange));width:0;transition:width 1s cubic-bezier(.2,.9,.3,1)}
.bar-row .pct{font-family:&quot;M PLUS Rounded 1c&quot;;font-weight:800;font-size:13px;text-align:right;color:var(--orange-d)}

.result-lamp{text-align:center;padding:26px 18px;border-radius:20px;margin:18px 0;border:3px solid;position:relative;overflow:hidden}
.result-lamp .big-lamp{font-size:62px;animation:pulse 1.8s ease-in-out infinite}
@keyframes pulse{0%,100%{transform:scale(1);filter:drop-shadow(0 0 0 transparent)}50%{transform:scale(1.08)}}
.result-lamp .level{font-family:&quot;Zen Maru Gothic&quot;;font-weight:900;font-size:26px;margin:8px 0}
.result-lamp .total{font-family:&quot;M PLUS Rounded 1c&quot;;font-weight:800;font-size:18px}
.result-lamp .verdict{font-size:14px;margin-top:8px;color:var(--ink-soft)}
.result-lamp.aka{background:var(--aka-bg);border-color:var(--aka)} .result-lamp.aka .level{color:var(--aka-d)}
.result-lamp.ki{background:var(--ki-bg);border-color:var(--ki)} .result-lamp.ki .level{color:var(--ki-d)}
.result-lamp.ao{background:var(--ao-bg);border-color:var(--ao)} .result-lamp.ao .level{color:var(--ao-d)}
.empty-msg{text-align:center;color:var(--ink-soft);padding:30px;font-size:14px}

/* assignment */
.assign-block{display:none}
.assign-block.show{display:block}
.task-list{background:#fff;border:1.5px solid var(--line);border-radius:14px;padding:14px 16px;margin:12px 0}
.task-list li{margin:0 0 7px 18px;font-size:13.5px}
.deadline-tool{background:var(--cream2);border:1.5px solid var(--line);border-radius:16px;padding:18px;margin-top:16px}
.dl-row{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;margin-bottom:14px}
.dl-field{display:flex;flex-direction:column;gap:4px}
.dl-field label{font-size:12.5px;font-weight:700;color:var(--ink-soft)}
.dl-field input{border:1.5px solid var(--line);border-radius:10px;padding:9px 12px;font-family:inherit;font-size:14px;background:#fff;color:var(--ink)}
.dl-out{background:#fff;border-radius:13px;padding:15px 17px;border-left:5px solid var(--orange);font-size:14px;display:none}
.dl-out.show{display:block}
.dl-out .big-date{font-family:&quot;M PLUS Rounded 1c&quot;;font-weight:800;font-size:21px;color:var(--orange-d)}

/* refs */
.ref{display:block;background:#fff;border:1.5px solid var(--line);border-radius:13px;padding:13px 16px;margin-bottom:10px;text-decoration:none;color:var(--ink);transition:.15s}
.ref:hover{border-color:var(--orange-l);background:var(--gold-soft);transform:translateX(3px)}
.ref .rt{font-family:&quot;Zen Maru Gothic&quot;;font-weight:700;color:var(--orange-d);font-size:14px}
.ref .rd{font-size:12.5px;color:var(--ink-soft);margin-top:3px}
.ref .free{font-size:10.5px;background:var(--ao);color:#fff;padding:2px 8px;border-radius:999px;font-weight:700;margin-left:6px}

footer{text-align:center;font-size:12px;color:var(--ink-soft);padding:24px 0 0}
.confetti{position:fixed;width:11px;height:11px;top:-20px;z-index:999;pointer-events:none;border-radius:2px}

/* progress hint */
.miniprog{font-size:12px;color:var(--ink-soft);text-align:center;margin-top:8px}
.miniprog b{color:var(--orange-d)}
</style>
</head>
<body>
<div class=&quot;wrap&quot;>

  <header>
    <span class=&quot;bunny&quot;>🐰</span>
    <h1>うさうさ要求定義ナビ</h1>
    <div class=&quot;subtitle&quot;>文系さんのための「要求工学」スキル診断＆業務分配ツール ／ REBOK準拠・三信号方式 🔴🟡🔵</div>
    <div class=&quot;tagline&quot;>面白きこともなき世を面白く ── 上流工程をうさうさ流で</div>
  </header>

  <nav id=&quot;nav&quot;>
    <button class=&quot;tab active&quot; data-v=&quot;intro&quot;>① はじめに</button>
    <button class=&quot;tab&quot; data-v=&quot;written&quot;>② 筆記試験</button>
    <button class=&quot;tab&quot; data-v=&quot;oral&quot;>③ 口頭試問</button>
    <button class=&quot;tab&quot; data-v=&quot;score&quot;>④ スコア＆三信号</button>
    <button class=&quot;tab&quot; data-v=&quot;assign&quot;>⑤ 業務分配＆締切</button>
    <button class=&quot;tab&quot; data-v=&quot;refs&quot;>⑥ 参考文献</button>
  </nav>

  <!-- ============ ① INTRO ============ -->
  <section class=&quot;view show&quot; id=&quot;intro&quot;>
    <div class=&quot;card&quot;>
      <h2>🍜 ようこそ「うさうさラーメン店」へ！</h2>
      <p class=&quot;lead&quot;>こんにちは、うさうさ先生です🐰 このツールは、<b>文系出身で上流工程（要求定義・要件定義）にチャレンジする方</b>のために作りました。「コードは書けないけど、人の話を聞いて整理するのは得意かも？」── その力こそ、要求工学でいちばん大事なスキルなんです。</p>

      <h3>まず「要望→要求→要件→仕様」をラーメンで覚えよう</h3>
      <p>うちのラーメン店にお客さんが来たと思ってください。同じ「食べたい」でも、抽象度がぜんぜん違います👇</p>
      <div class=&quot;ladder&quot;>
        <div class=&quot;rung&quot;><span class=&quot;step&quot;>要望</span><div>「お腹すいた〜」<br><small>＝まだぼんやりした願い（潜在ニーズ）。本人も何が食べたいか言語化できていない</small></div></div>
        <div class=&quot;rung&quot;><span class=&quot;step s2&quot;>要求</span><div>「あったかいラーメンが食べたい」<br><small>＝願いが表に出て、方向が決まった状態（Requirements）</small></div></div>
        <div class=&quot;rung&quot;><span class=&quot;step s3&quot;>要件</span><div>「豚骨スープ・固麺・ネギ多め・900円以内」<br><small>＝実現すべき条件まで具体化。合意できる粒度</small></div></div>
        <div class=&quot;rung&quot;><span class=&quot;step s4&quot;>仕様</span><div>「鶏ガラ20%＋豚骨80%、加水率35%の麺を1分40秒…」<br><small>＝作り手向けのレシピ＝設計・実装の世界</small></div></div>
      </div>
      <div class=&quot;bunny-say&quot;><span class=&quot;ic&quot;>🐰</span><div class=&quot;txt&quot;><b>うさうさ流の要点：</b>上流工程の腕の見せどころは、お客さんの「お腹すいた」を、ケンカにならないように上手に聞き出して「豚骨・固麺・ネギ多め」まで一緒に言語化してあげること。コードより前の、いちばん人間くさい工程です。</div></div>
      <div class=&quot;note-box&quot;>💡 <b>なぜ大事？</b> IPA／JISAの調査でも、プロジェクト失敗の最大の原因は「要求・要件定義」にあると繰り返し指摘されています。手戻りの多くはここで生まれる ── だから文系の「対話力・整理力」が武器になるんです。</div>
    </div>

    <div class=&quot;card&quot;>
      <h2>📚 このツールの土台（REBOK・無料資料ベース）</h2>
      <p>診断の枠組みは、IPA／JISAが公開する <b>要求工学知識体系 REBOK（Requirements Engineering Body Of Knowledge）</b> の主要知識領域と、「要求アナリスト」に求められるスキル像をベースにしています（出典は⑥参考文献に無料リンクあり）。</p>
      <h3>REBOK 主要8知識領域（ざっくり）</h3>
      <div class=&quot;grid2&quot;>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>1. 要求工学の基礎</div><small>定義・分類・機能/非機能・要求の特性</small></div>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>2. 要求工学プロセス</div><small>進め方の型・役割・管理・改善</small></div>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>3. 要求獲得</div><small>ステークホルダ識別・現状理解・課題抽出・ゴール抽出</small></div>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>4. 要求分析</div><small>構造化・割り当て・優先順位づけ・要求交渉</small></div>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>5. 要求仕様化</div><small>ビジネス/システム/ソフト要求の文書化</small></div>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>6. 検証・妥当性確認</div><small>レビュー・プロトタイピング・評価</small></div>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>7. 計画と管理</div><small>優先順位・変更管理・トレース・測定</small></div>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>8. 実践の考慮点</div><small>ベストプラクティス・事例</small></div>
      </div>
    </div>

    <div class=&quot;card&quot;>
      <h2>📊 測る「コミュニケーション能力」5つの軸</h2>
      <p>REBOKで「要求アナリストの重要スキル」とされる<b>コミュニケーション力・観察力・論理的思考力</b>などを、文系さん向けに5つの実務スキルへ分解しました。筆記試験と口頭試問でこの5軸を測ります。</p>
      <div class=&quot;grid2&quot;>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>👂 傾聴・観察力</div><small>相手の言葉と「言葉になっていない本音」を拾う</small></div>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>❓ 質問力（要求獲得）</div><small>本音を引き出す問いを立てられるか（口頭試問の主役）</small></div>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>🧩 論理的思考・構造化</div><small>バラバラの要求を整理・優先順位づけできるか</small></div>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>🤝 合意形成・交渉</div><small>対立する要求を調整し、合意に導けるか</small></div>
        <div class=&quot;dim-card&quot;><div class=&quot;n&quot;>✍️ 言語化・文書化</div><small>あいまいさを残さず仕様に落とせるか</small></div>
      </div>
      <h3>診断結果は「三信号方式」で出ます</h3>
      <div class=&quot;signals&quot;>
        <div class=&quot;sig ao&quot;><span class=&quot;lamp&quot;>🔵</span><div class=&quot;lv&quot;>青｜上級</div><small>独立して任せてOK。要求獲得や要求交渉のリードも可。総合 75%〜</small></div>
        <div class=&quot;sig ki&quot;><span class=&quot;lamp&quot;>🟡</span><div class=&quot;lv&quot;>黄｜中級</div><small>レビュー前提で一部独立。ドラフト作成や構造化を担当。総合 50〜74%</small></div>
        <div class=&quot;sig aka&quot;><span class=&quot;lamp&quot;>🔴</span><div class=&quot;lv&quot;>赤｜初級</div><small>ペア作業・要支援。観察と記録から始めよう。総合 〜49%</small></div>
      </div>
      <div class=&quot;btn-row&quot;><button class=&quot;btn btn-main&quot; onclick=&quot;go('written')&quot;>さっそく筆記試験へ →</button></div>
    </div>
  </section>

  <!-- ============ ② WRITTEN ============ -->
  <section class=&quot;view&quot; id=&quot;written&quot;>
    <div class=&quot;card&quot;>
      <h2>📝 筆記試験（自動採点）</h2>
      <p>要求工学の基礎と判断力を測る選択式テストです。各問は5つのスキル軸のどれかに紐づいています。直感ではなく「なぜそれが要求定義として正しいか」を考えて選んでみてください🐰</p>
      <div id=&quot;writtenList&quot;></div>
      <div class=&quot;btn-row&quot;>
        <button class=&quot;btn btn-main&quot; onclick=&quot;gradeWritten()&quot;>採点する</button>
        <button class=&quot;btn btn-ghost&quot; onclick=&quot;resetWritten()&quot;>リセット</button>
      </div>
      <div class=&quot;miniprog&quot; id=&quot;writtenProg&quot;></div>
    </div>
  </section>

  <!-- ============ ③ ORAL ============ -->
  <section class=&quot;view&quot; id=&quot;oral&quot;>
    <div class=&quot;card&quot;>
      <h2>🗣️ 口頭試問｜「いい質問、できる？」</h2>
      <p>上流工程の本番は、相手が言ってくれない本音を<b>質問で引き出す</b>こと。下のシナリオを読んで、あなたがその場でステークホルダーに投げかける「質問」を書いてください。<br>書いたら、自分（または評価者）で<b>0〜4点</b>のルーブリックで採点します。終わったら「お手本の質問」と見比べてみましょう。</p>
      <div class=&quot;note-box&quot;>⭐ <b>採点ルーブリック：</b>0=質問できていない／1=Yes-Noで終わる浅い質問／2=理由を聞けている／3=背景・制約・優先度に踏み込む／4=潜在ニーズや対立を引き出す鋭い質問</div>
      <div id=&quot;oralList&quot;></div>
      <div class=&quot;btn-row&quot;>
        <button class=&quot;btn btn-main&quot; onclick=&quot;finishOral()&quot;>口頭試問を確定</button>
        <button class=&quot;btn btn-ghost&quot; onclick=&quot;toggleModels()&quot;>お手本の質問を表示／非表示</button>
      </div>
      <div class=&quot;miniprog&quot; id=&quot;oralProg&quot;></div>
    </div>
  </section>

  <!-- ============ ④ SCORE ============ -->
  <section class=&quot;view&quot; id=&quot;score&quot;>
    <div class=&quot;card&quot;>
      <h2>📊 コミュニケーション能力スコア</h2>
      <div id=&quot;scoreEmpty&quot; class=&quot;empty-msg&quot;>まだ採点データがありません。「② 筆記試験」と「③ 口頭試問」を終えると、ここに5軸スコアと三信号判定が表示されます🐰</div>
      <div id=&quot;scoreContent&quot; style=&quot;display:none&quot;>
        <div class=&quot;score-dims&quot; id=&quot;dimBars&quot;></div>
        <div class=&quot;result-lamp&quot; id=&quot;resultLamp&quot;></div>
        <div class=&quot;btn-row&quot;>
          <button class=&quot;btn btn-main&quot; onclick=&quot;go('assign')&quot;>業務分配＆締切の提案を見る →</button>
          <button class=&quot;btn btn-ghost&quot; onclick=&quot;exportJSON()&quot;>結果をJSON保存</button>
          <button class=&quot;btn btn-ghost&quot; onclick=&quot;window.print()&quot;>印刷／PDF</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ⑤ ASSIGN ============ -->
  <section class=&quot;view&quot; id=&quot;assign&quot;>
    <div class=&quot;card&quot;>
      <h2>🗂️ 業務分配＆締め切り設定</h2>
      <div id=&quot;assignEmpty&quot; class=&quot;empty-msg&quot;>先に④で診断を完了すると、信号に応じた「任せる業務」と「締め切りの考え方」を提案します🐰</div>

      <div class=&quot;assign-block&quot; id=&quot;assignAka&quot;>
        <div class=&quot;result-lamp aka&quot; style=&quot;margin-top:0&quot;><span class=&quot;big-lamp&quot;>🔴</span><div class=&quot;level&quot;>赤信号｜初級・要支援</div><div class=&quot;verdict&quot;>まずは「観察」と「記録」から。客先対応は必ずペアで。</div></div>
        <h3>任せる業務（REBOK 要求獲得の入口）</h3>
        <ul class=&quot;task-list&quot;>
          <li>ヒアリング同席＆<b>議事録・観察メモ</b>の作成（事実と所感を分けて記録）</li>
          <li>用語集・ステークホルダー一覧の整理</li>
          <li>先輩が作った要求一覧の<b>抜け漏れチェック</b>（レビュー補助）</li>
          <li>単独での要求の判断・客先への合意形成は<b>まだ任せない</b></li>
        </ul>
        <h3>締め切りの考え方</h3>
        <div class=&quot;note-box&quot;>基礎見積りの <b>×2.0</b> をバッファに。タスクは小さく分割し、<b>ペアレビューを必須</b>に。締め切り前に必ず中間確認を2回。</div>
      </div>

      <div class=&quot;assign-block&quot; id=&quot;assignKi&quot;>
        <div class=&quot;result-lamp ki&quot; style=&quot;margin-top:0&quot;><span class=&quot;big-lamp&quot;>🟡</span><div class=&quot;level&quot;>黄信号｜中級・条件付き独立</div><div class=&quot;verdict&quot;>レビュー前提なら一人で進めてOK。ドラフトを任せられる段階。</div></div>
        <h3>任せる業務（要求獲得〜要求分析）</h3>
        <ul class=&quot;task-list&quot;>
          <li>一次ヒアリングの<b>質問項目ドラフト</b>作成</li>
          <li>集めた要求の<b>構造化・優先順位づけ</b>（MoSCoW等）</li>
          <li>要求一覧・簡易仕様書の<b>ドラフト文書化</b>（レビュー前提）</li>
          <li>軽い対立の調整は同席のもとで経験を積む</li>
        </ul>
        <h3>締め切りの考え方</h3>
        <div class=&quot;note-box&quot;>基礎見積りの <b>×1.5</b> をバッファに。<b>中間レビュー1回</b>を必ず挟む。客先合意が絡む工程は先輩と並走。</div>
      </div>

      <div class=&quot;assign-block&quot; id=&quot;assignAo&quot;>
        <div class=&quot;result-lamp ao&quot; style=&quot;margin-top:0&quot;><span class=&quot;big-lamp&quot;>🔵</span><div class=&quot;level&quot;>青信号｜上級・独立担当可</div><div class=&quot;verdict&quot;>要求獲得から要求交渉まで、リードを任せられる段階！</div></div>
        <h3>任せる業務（要求獲得〜仕様化のリード）</h3>
        <ul class=&quot;task-list&quot;>
          <li>ステークホルダー識別〜<b>要求獲得のリード</b></li>
          <li>対立する要求の<b>要求交渉・合意形成ファシリテーション</b></li>
          <li>要求仕様書の<b>主担当</b>＆後輩のレビュー担当</li>
          <li>優先順位・変更管理・トレースの設計</li>
        </ul>
        <h3>締め切りの考え方</h3>
        <div class=&quot;note-box&quot;>基礎見積りの <b>×1.2</b> で十分。<b>最終レビューのみ</b>でOK。むしろ後輩の締め切り設計を支援する側に。</div>
      </div>

      <!-- deadline calculator -->
      <div class=&quot;deadline-tool&quot; id=&quot;dlTool&quot; style=&quot;display:none&quot;>
        <h3 style=&quot;margin-top:0&quot;>⏰ 締め切り自動計算ツール</h3>
        <p style=&quot;font-size:13px&quot;>基礎見積り日数と着手日を入れると、信号レベルに応じたバッファ込みの締め切りを提案します。</p>
        <div class=&quot;dl-row&quot;>
          <div class=&quot;dl-field&quot;><label>着手日</label><input type=&quot;date&quot; id=&quot;dlStart&quot;></div>
          <div class=&quot;dl-field&quot;><label>基礎見積り（営業日）</label><input type=&quot;number&quot; id=&quot;dlDays&quot; min=&quot;1&quot; value=&quot;5&quot; style=&quot;width:120px&quot;></div>
          <button class=&quot;btn btn-main&quot; onclick=&quot;calcDeadline()&quot;>計算する</button>
        </div>
        <div class=&quot;dl-out&quot; id=&quot;dlOut&quot;></div>
      </div>
    </div>
  </section>

  <!-- ============ ⑥ REFS ============ -->
  <section class=&quot;view&quot; id=&quot;refs&quot;>
    <div class=&quot;card&quot;>
      <h2>📖 参考文献（無料で読める一次資料）</h2>
      <p>この診断の枠組みは、以下の公開資料をベースにしています。要求工学をもっと深めたい方は、まず無料のREBOK関連資料から読むのがおすすめです🐰</p>

      <a class=&quot;ref&quot; href=&quot;https://www.jisa.or.jp/it_info/engineering/tabid/1165/default.aspx&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;>
        <div class=&quot;rt&quot;>要求工学 REBOK ポータル（JISA）<span class=&quot;free&quot;>無料PDF</span></div>
        <div class=&quot;rd&quot;>要求工学知識体系の公式ポータル。「要求アナリストの確立と育成」(2013) やREBOK-DX Vol.1/2 などをPDFで無償公開。要求工学の全体像をつかむ最初の一歩に。</div>
      </a>
      <a class=&quot;ref&quot; href=&quot;https://www.jisa.or.jp/Portals/0/report/24-J007.pdf&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;>
        <div class=&quot;rt&quot;>要求アナリストの確立と育成（PDF）<span class=&quot;free&quot;>無料PDF</span></div>
        <div class=&quot;rd&quot;>要求アナリストに必要なスキル＝コミュニケーション力・コラボレーション力・観察力・論理的思考力、と整理した資料。本ツールの5軸の根拠。ファシリテーション技法も具体的。</div>
      </a>
      <a class=&quot;ref&quot; href=&quot;https://ws.cs.kobe-u.ac.jp/~masa-n/ses2011/ses2011_tutorial1.pdf&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;>
        <div class=&quot;rt&quot;>要求工学の現状とREBOK第1版の紹介（青山幹雄, SES2011 チュートリアル PDF）<span class=&quot;free&quot;>無料PDF</span></div>
        <div class=&quot;rd&quot;>REBOKの主要8知識領域や、要望→要求→要件の対応関係を図でわかりやすく解説したスライド。文系さんでも全体像が直感的につかめます。</div>
      </a>
      <a class=&quot;ref&quot; href=&quot;https://www.jisa.or.jp/Portals/0/report/20-J007.pdf&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;>
        <div class=&quot;rt&quot;>REBOKとユーザ指向要求工学の調査研究（PDF）<span class=&quot;free&quot;>無料PDF</span></div>
        <div class=&quot;rd&quot;>要求アナリストを「初級・中級・上級」の3水準で定義。本ツールの三信号（赤・黄・青）の根拠になっています。</div>
      </a>
      <a class=&quot;ref&quot; href=&quot;https://qiita.com/shoki_kitajima/items/0f6ac36602a8a9044cb1&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;>
        <div class=&quot;rt&quot;>要求工学を学んで健康的なエンジニアライフを送ろう（Qiita）<span class=&quot;free&quot;>無料Web</span></div>
        <div class=&quot;rd&quot;>「要望＞要求＞要件＞仕様」の抽象度の違いを実務目線でかみ砕いた記事。IPA資料への導線もあり、最初の読み物に最適。</div>
      </a>
      <div class=&quot;bunny-say&quot;><span class=&quot;ic&quot;>🐰</span><div class=&quot;txt&quot;><b>うさうさ先生からひとこと：</b>本格的に学ぶなら、近代科学社の『要求工学知識体系 REBOK 第1版』や『要求工学概論』（電子書籍あり）もおすすめ。まずは上の無料PDFで地図を手に入れてから本に進むと、迷子になりませんよ🍜</div></div>
    </div>
    <footer>🐰 うさうさ要求定義ナビ ／ REBOK準拠・三信号方式 ／ 文系さんの上流工程デビューを応援します</footer>
  </section>

</div>

<script>
/* =================== DATA =================== */
const DIMS = {
  listen:{label:&quot;👂 傾聴・観察力&quot;},
  ask:{label:&quot;❓ 質問力（要求獲得）&quot;},
  logic:{label:&quot;🧩 論理的思考・構造化&quot;},
  agree:{label:&quot;🤝 合意形成・交渉&quot;},
  write:{label:&quot;✍️ 言語化・文書化&quot;}
};

const WRITTEN = [
  {dim:&quot;logic&quot;,tag:&quot;要求工学の基礎&quot;,q:&quot;「要望・要求・要件・仕様」を抽象度の高い順に並べたものはどれ？&quot;,
   opts:[&quot;仕様 ＞ 要件 ＞ 要求 ＞ 要望&quot;,&quot;要望 ＞ 要求 ＞ 要件 ＞ 仕様&quot;,&quot;要求 ＞ 要望 ＞ 仕様 ＞ 要件&quot;,&quot;要件 ＞ 要望 ＞ 要求 ＞ 仕様&quot;],a:1,
   exp:&quot;抽象度が高い（ぼんやり）順に 要望＞要求＞要件＞仕様。ラーメンでいえば『お腹すいた』→『豚骨固麺』→レシピ、の流れです。&quot;},
  {dim:&quot;listen&quot;,tag:&quot;要求獲得&quot;,q:&quot;ユーザーが「とにかく速いシステムが欲しい」と言いました。要求アナリストの最初の一手として最も適切なのは？&quot;,
   opts:[&quot;すぐ高速なサーバーを手配する&quot;,&quot;『速い』が何を指すか（表示速度？処理件数？）を具体的に聞き返す&quot;,&quot;技術的に無理だと伝える&quot;,&quot;仕様書に『高速』と記載する&quot;],a:1,
   exp:&quot;『速い』は人によって意味が違うあいまい語。観察・傾聴の基本は、言葉の裏にある本当の基準を確認すること。&quot;},
  {dim:&quot;ask&quot;,tag:&quot;要求獲得&quot;,q:&quot;潜在ニーズ（言葉になっていない本音）を引き出すのに最も有効な問いは？&quot;,
   opts:[&quot;「これでいいですよね？」（Yes/Noで確認）&quot;,&quot;「予算はいくらですか？」&quot;,&quot;「いまの業務でいちばん困っているのはどんな場面ですか？」&quot;,&quot;「いつまでに必要ですか？」&quot;],a:2,
   exp:&quot;オープンな『困りごと』を聞く問いは、本人も気づいていない潜在ニーズを表に出します。Yes/Noや事実確認だけでは本音は出てきません。&quot;},
  {dim:&quot;logic&quot;,tag:&quot;要求分析&quot;,q:&quot;集めた要求が30件。限られた予算で実装する順番を決めたい。最も適切な手法は？&quot;,
   opts:[&quot;先に言われた順に実装&quot;,&quot;声の大きい人の要求を優先&quot;,&quot;MoSCoW分析などで優先順位づけ&quot;,&quot;全部同時に着手&quot;],a:2,
   exp:&quot;要求分析では優先順位づけが核。MoSCoW（Must/Should/Could/Won't）等で合意可能な基準を作ります。&quot;},
  {dim:&quot;agree&quot;,tag:&quot;要求交渉&quot;,q:&quot;営業部は「機能を増やせ」、開発部は「納期に間に合わない」と対立。要求アナリストの動きとして適切なのは？&quot;,
   opts:[&quot;上司に丸投げする&quot;,&quot;両者の目的（なぜそれが欲しいか）を引き出し、優先度で落としどころを探る&quot;,&quot;営業部の言う通りにする&quot;,&quot;多数決で決める&quot;],a:1,
   exp:&quot;要求交渉では『立場』ではなく『その奥にある目的・利害』に注目し、優先度で合意形成します。&quot;},
  {dim:&quot;write&quot;,tag:&quot;要求仕様化&quot;,q:&quot;要求仕様書の記述として最も品質が高いのは？&quot;,
   opts:[&quot;「画面は使いやすくすること」&quot;,&quot;「ログイン画面は3秒以内に表示し、入力エラー時は赤字で理由を表示する」&quot;,&quot;「なるべく速く」&quot;,&quot;「いい感じにする」&quot;],a:1,
   exp:&quot;良い要求は『検証可能（テストできる）』であること。あいまい語を避け、数値や条件で書きます。&quot;},
  {dim:&quot;logic&quot;,tag:&quot;基礎&quot;,q:&quot;「同時アクセスが増えても落ちないこと」は、どの種類の要求？&quot;,
   opts:[&quot;機能要求&quot;,&quot;非機能要求&quot;,&quot;ビジネス要望&quot;,&quot;仕様の誤り&quot;],a:1,
   exp:&quot;性能・可用性・セキュリティなど『どう動くか』の品質要求は非機能要求。機能要求（何ができるか）と区別します。&quot;},
  {dim:&quot;listen&quot;,tag:&quot;要求獲得&quot;,q:&quot;ヒアリングのメモを取るとき、うさうさ流で最も大切なルールは？&quot;,
   opts:[&quot;全部を一字一句書き起こす&quot;,&quot;『事実』と『自分の所感・解釈』を分けて書く&quot;,&quot;印象に残ったことだけ書く&quot;,&quot;あとでまとめて記憶で書く&quot;],a:1,
   exp:&quot;事実と所感を分けるのは要求獲得の鉄則。混ぜると、解釈の誤りがそのまま要求になり手戻りの原因に。&quot;},
  {dim:&quot;ask&quot;,tag:&quot;要求獲得&quot;,q:&quot;顧客が挙げた要求の『背景』を確認する質問はどれ？&quot;,
   opts:[&quot;「それは何色にしますか？」&quot;,&quot;「それが必要なのは、どんな困りごとを解決するためですか？」&quot;,&quot;「いくらかかってもいいですか？」&quot;,&quot;「他社もやっていますか？」&quot;],a:1,
   exp:&quot;『なぜ（背景・目的）』を聞くと、表面の要求の奥にある真の課題が見え、より良い解決策を提案できます。&quot;},
  {dim:&quot;agree&quot;,tag:&quot;妥当性確認&quot;,q:&quot;要求の『妥当性確認（バリデーション）』とは何を確かめること？&quot;,
   opts:[&quot;プログラムにバグがないか&quot;,&quot;作った仕様が本当にユーザーの目的を満たすか&quot;,&quot;納期に間に合うか&quot;,&quot;予算内か&quot;],a:1,
   exp:&quot;検証(Verification)＝正しく作ったか、妥当性確認(Validation)＝正しいものを作ったか。要求段階では特に後者が重要。&quot;},
  {dim:&quot;write&quot;,tag:&quot;プロセス&quot;,q:&quot;要求の『トレーサビリティ（追跡可能性）』を保つ目的として正しいのは？&quot;,
   opts:[&quot;要求の数を増やすため&quot;,&quot;ある要求がどの目的から来て、どの仕様・テストに繋がるか追えるようにするため&quot;,&quot;文書を長くするため&quot;,&quot;顧客を安心させる演出&quot;],a:1,
   exp:&quot;要求トレースは、変更が起きたとき影響範囲を追えるようにする管理の要。文系さんの『整理する力』が活きる領域です。&quot;},
  {dim:&quot;agree&quot;,tag:&quot;実践&quot;,q:&quot;要求定義の打ち合わせで『偉い人がその場で思いつきの新機能を追加』。望ましい対応は？&quot;,
   opts:[&quot;黙ってそのまま仕様に入れる&quot;,&quot;『変更管理』として記録し、優先度と影響を確認してから扱う&quot;,&quot;無視する&quot;,&quot;議事録から消す&quot;],a:1,
   exp:&quot;思いつきの追加要求は変更管理プロセスにのせ、優先度・影響・コストを可視化してから合意します。なし崩しはスコープ崩壊の元。&quot;}
];

const ORAL = [
  {role:&quot;🏪 商店街の店主（ITに不慣れ）&quot;,
   scene:&quot;「うちの店、ネットでも売れるようにしたいんだよね。なんかこう、今風のやつで。よくわかんないけど、若い人がスマホでパッと買えるみたいな。」&quot;,
   dims:[&quot;ask&quot;,&quot;listen&quot;],
   models:[&quot;『今風』『パッと』とは具体的にどんな体験を想像していますか？&quot;,&quot;今いちばん困っているのは、集客・在庫・決済のどこですか？&quot;,&quot;現在はどうやって注文を受けていますか？（電話・店頭など）&quot;,&quot;予算と、いつまでに始めたいかの希望はありますか？&quot;,&quot;売りたい商品は何点くらいで、写真や説明文の準備はありますか？&quot;]},
  {role:&quot;🏥 病院の看護師長（現場の本音）&quot;,
   scene:&quot;「新しい記録システム？正直、今の紙のほうが速いのよ。導入するなら邪魔にならないやつにしてね。みんな忙しいんだから。」&quot;,
   dims:[&quot;listen&quot;,&quot;agree&quot;],
   models:[&quot;今の紙運用で『速い』と感じる具体的な場面を教えてください&quot;,&quot;逆に、紙でいちばん手間や危険を感じる瞬間はどこですか？&quot;,&quot;新システムで『邪魔』と感じるのはどんな動きですか？&quot;,&quot;現場の方が1日に何回・どんなタイミングで記録しますか？&quot;,&quot;導入が成功したと言える状態を、現場目線でどう定義しますか？&quot;]},
  {role:&quot;💼 経営者（要求が大きく抽象的）&quot;,
   scene:&quot;「とにかくDXで会社を変えたい。競合に勝てる、すごいシステムを頼むよ。細かいことは任せる。」&quot;,
   dims:[&quot;ask&quot;,&quot;agree&quot;],
   models:[&quot;『勝てる』とは、売上・コスト・スピードのどれを最優先しますか？&quot;,&quot;変えたい業務を1つだけ挙げるとしたら何ですか？&quot;,&quot;成功を測る数字（KPI）は何に置きますか？&quot;,&quot;今期中に必ず達成したいことと、後回しでよいことは？&quot;,&quot;現場の協力体制や予算の上限は決まっていますか？&quot;]}
];

/* =================== STATE =================== */
let writtenAnswers = {};
let writtenGraded = false;
let oralScores = {};   // index -> 0..4
let oralDone = false;

/* =================== TABS =================== */
document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>go(t.dataset.v)));
function go(v){
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.dataset.v===v));
  document.querySelectorAll('.view').forEach(s=>s.classList.toggle('show',s.id===v));
  window.scrollTo({top:0,behavior:'smooth'});
  if(v==='score') renderScore();
  if(v==='assign') renderAssign();
}

/* =================== WRITTEN =================== */
function renderWritten(){
  const el=document.getElementById('writtenList'); el.innerHTML='';
  WRITTEN.forEach((q,i)=>{
    const div=document.createElement('div'); div.className='q'; div.id='wq'+i;
    let opts=q.opts.map((o,j)=>`<label class=&quot;opt&quot; data-i=&quot;${i}&quot; data-j=&quot;${j}&quot;>
      <input type=&quot;radio&quot; name=&quot;wq${i}&quot; value=&quot;${j}&quot; onchange=&quot;pickWritten(${i},${j})&quot;> ${o}</label>`).join('');
    div.innerHTML=`<div class=&quot;qhead&quot;><span class=&quot;qno&quot;>Q${i+1}</span><span class=&quot;tag&quot;>${DIMS[q.dim].label} ／ ${q.tag}</span></div>
      <div class=&quot;qtext&quot;>${q.q}</div>${opts}
      <div class=&quot;explain&quot; id=&quot;wexp${i}&quot;><b>解説：</b>${q.exp}</div>`;
    el.appendChild(div);
  });
  updateWrittenProg();
}
function pickWritten(i,j){ writtenAnswers[i]=j; updateWrittenProg(); }
function updateWrittenProg(){
  const done=Object.keys(writtenAnswers).length;
  document.getElementById('writtenProg').innerHTML=`回答済み <b>${done}</b> / ${WRITTEN.length} 問`;
}
function gradeWritten(){
  if(Object.keys(writtenAnswers).length<WRITTEN.length){
    if(!confirm('未回答の問題があります。このまま採点しますか？')) return;
  }
  WRITTEN.forEach((q,i)=>{
    const chosen=writtenAnswers[i];
    document.querySelectorAll(`#wq${i} .opt`).forEach(l=>{
      const j=+l.dataset.j; l.classList.remove('correct','wrong');
      if(j===q.a) l.classList.add('correct');
      else if(j===chosen) l.classList.add('wrong');
    });
    document.getElementById('wexp'+i).classList.add('show');
  });
  writtenGraded=true;
  document.getElementById('writtenProg').innerHTML='✅ 採点完了！「④ スコア＆三信号」で結果を確認できます🐰';
}
function resetWritten(){
  writtenAnswers={}; writtenGraded=false;
  document.querySelectorAll('#writtenList input').forEach(x=>x.checked=false);
  document.querySelectorAll('#writtenList .opt').forEach(l=>l.classList.remove('correct','wrong'));
  document.querySelectorAll('#writtenList .explain').forEach(e=>e.classList.remove('show'));
  updateWrittenProg();
}

/* =================== ORAL =================== */
function renderOral(){
  const el=document.getElementById('oralList'); el.innerHTML='';
  ORAL.forEach((s,i)=>{
    const div=document.createElement('div'); div.className='q';
    let btns=[0,1,2,3,4].map(n=>`<button class=&quot;rscore&quot; data-i=&quot;${i}&quot; data-n=&quot;${n}&quot; onclick=&quot;pickOral(${i},${n})&quot;>${n}</button>`).join('');
    let models=s.models.map(m=>`<li>${m}</li>`).join('');
    div.innerHTML=`<div class=&quot;qhead&quot;><span class=&quot;qno&quot;>場面${i+1}</span><span class=&quot;tag&quot;>${s.dims.map(d=>DIMS[d].label).join(' ／ ')}</span></div>
      <div class=&quot;scenario&quot;><div class=&quot;role&quot;>${s.role}</div>${s.scene}</div>
      <textarea id=&quot;otext${i}&quot; placeholder=&quot;あなたなら、この相手にどんな質問をしますか？（複数OK）&quot;></textarea>
      <div class=&quot;rubric&quot;><span class=&quot;lbl&quot;>この質問の鋭さ（0〜4）：</span>${btns}</div>
      <div class=&quot;model-q&quot; id=&quot;omodel${i}&quot;><b>🐰 お手本の質問例：</b><ul>${models}</ul></div>`;
    el.appendChild(div);
  });
  updateOralProg();
}
function pickOral(i,n){
  oralScores[i]=n;
  document.querySelectorAll(`.rscore[data-i=&quot;${i}&quot;]`).forEach(b=>b.classList.toggle('sel',+b.dataset.n===n));
  updateOralProg();
}
function updateOralProg(){
  const done=Object.keys(oralScores).length;
  document.getElementById('oralProg').innerHTML=`採点済み <b>${done}</b> / ${ORAL.length} 場面`;
}
function finishOral(){
  if(Object.keys(oralScores).length<ORAL.length){
    if(!confirm('未採点の場面があります。確定しますか？')) return;
  }
  oralDone=true;
  document.getElementById('oralProg').innerHTML='✅ 口頭試問を確定しました！「④ スコア＆三信号」へ🐰';
  document.querySelectorAll('.model-q').forEach(m=>m.classList.add('show'));
}
let modelsShown=false;
function toggleModels(){
  modelsShown=!modelsShown;
  document.querySelectorAll('.model-q').forEach(m=>m.classList.toggle('show',modelsShown));
}

/* =================== SCORING =================== */
function computeScores(){
  // per-dimension raw + max
  const raw={}, max={};
  Object.keys(DIMS).forEach(d=>{raw[d]=0;max[d]=0;});
  // written: each q worth 1 to its dim
  WRITTEN.forEach((q,i)=>{
    max[q.dim]+=1;
    if(writtenGraded &amp;&amp; writtenAnswers[i]===q.a) raw[q.dim]+=1;
  });
  // oral: each scenario score (0..4) split across its dims
  ORAL.forEach((s,i)=>{
    const sc = oralScores[i]!==undefined ? oralScores[i] : 0;
    s.dims.forEach(d=>{ max[d]+=4/s.dims.length; raw[d]+= (oralDone? sc:0)/s.dims.length; });
  });
  const pct={}; let totalRaw=0,totalMax=0;
  Object.keys(DIMS).forEach(d=>{
    pct[d]= max[d]>0 ? Math.round(raw[d]/max[d]*100) : 0;
    totalRaw+=raw[d]; totalMax+=max[d];
  });
  const total= totalMax>0 ? Math.round(totalRaw/totalMax*100) : 0;
  return {pct,total};
}
function signalOf(total){
  if(total>=75) return {key:'ao',lamp:'🔵',name:'青信号｜上級',cls:'ao'};
  if(total>=50) return {key:'ki',lamp:'🟡',name:'黄信号｜中級',cls:'ki'};
  return {key:'aka',lamp:'🔴',name:'赤信号｜初級',cls:'aka'};
}

function renderScore(){
  const has = writtenGraded || oralDone;
  document.getElementById('scoreEmpty').style.display = has?'none':'block';
  document.getElementById('scoreContent').style.display = has?'block':'none';
  if(!has) return;
  const {pct,total}=computeScores();
  // bars
  const bars=document.getElementById('dimBars'); bars.innerHTML='';
  Object.keys(DIMS).forEach(d=>{
    const row=document.createElement('div'); row.className='bar-row';
    row.innerHTML=`<div class=&quot;name&quot;>${DIMS[d].label}</div>
      <div class=&quot;bar-track&quot;><div class=&quot;bar-fill&quot; id=&quot;bf-${d}&quot;></div></div>
      <div class=&quot;pct&quot;>${pct[d]}%</div>`;
    bars.appendChild(row);
  });
  setTimeout(()=>Object.keys(DIMS).forEach(d=>{document.getElementById('bf-'+d).style.width=pct[d]+'%';}),60);
  // lamp
  const sig=signalOf(total);
  const verdicts={
    ao:'要求獲得から要求交渉まで、リードを任せられる段階です。後輩の育成側にも回れます。',
    ki:'レビュー前提なら一人で進められる中級者。ドラフト作成や構造化を任せましょう。',
    aka:'まずは観察と記録から。客先対応はペアで。土台を固めれば必ず伸びます🐰'
  };
  const lamp=document.getElementById('resultLamp');
  lamp.className='result-lamp '+sig.cls;
  lamp.innerHTML=`<div class=&quot;big-lamp&quot;>${sig.lamp}</div>
    <div class=&quot;level&quot;>${sig.name}</div>
    <div class=&quot;total&quot;>総合スコア ${total}%</div>
    <div class=&quot;verdict&quot;>${verdicts[sig.key]}</div>`;
  if(sig.key==='ao') celebrate();
}

/* =================== ASSIGN =================== */
function renderAssign(){
  const has = writtenGraded || oralDone;
  document.getElementById('assignEmpty').style.display = has?'none':'block';
  ['assignAka','assignKi','assignAo'].forEach(id=>document.getElementById(id).classList.remove('show'));
  document.getElementById('dlTool').style.display = has?'block':'none';
  if(!has) return;
  const {total}=computeScores();
  const sig=signalOf(total);
  const map={ao:'assignAo',ki:'assignKi',aka:'assignAka'};
  document.getElementById(map[sig.key]).classList.add('show');
  // default start date = today
  if(!document.getElementById('dlStart').value){
    document.getElementById('dlStart').value=new Date().toISOString().slice(0,10);
  }
}
function calcDeadline(){
  const start=document.getElementById('dlStart').value;
  const days=parseInt(document.getElementById('dlDays').value||'0',10);
  if(!start||days<1){alert('着手日と見積り日数を入力してください');return;}
  const {total}=computeScores();
  const sig=signalOf(total);
  const mult = sig.key==='ao'?1.2 : sig.key==='ki'?1.5 : 2.0;
  const review = sig.key==='ao'?'最終レビューのみ' : sig.key==='ki'?'中間レビュー1回＋最終' : 'ペアレビュー必須＋中間2回';
  const bufDays=Math.ceil(days*mult);
  // add business days
  let d=new Date(start), added=0;
  while(added<bufDays){ d.setDate(d.getDate()+1); const w=d.getDay(); if(w!==0&amp;&amp;w!==6) added++; }
  const fmt=d.toLocaleDateString('ja-JP',{year:'numeric',month:'long',day:'numeric',weekday:'short'});
  document.getElementById('dlOut').classList.add('show');
  document.getElementById('dlOut').innerHTML=
    `<div>${sig.lamp} <b>${sig.name}</b> ／ バッファ係数 <b>×${mult}</b></div>
     <div style=&quot;margin:8px 0&quot;>基礎見積り ${days}営業日 → 提案工期 <b>${bufDays}営業日</b></div>
     <div>推奨締め切り：<span class=&quot;big-date&quot;>${fmt}</span></div>
     <div style=&quot;margin-top:8px;font-size:13px;color:var(--ink-soft)&quot;>レビュー体制の目安：<b>${review}</b></div>`;
}

/* =================== EXPORT =================== */
function exportJSON(){
  const {pct,total}=computeScores();
  const sig=signalOf(total);
  const data={
    tool:&quot;うさうさ要求定義ナビ&quot;,
    date:new Date().toISOString(),
    written_graded:writtenGraded,
    oral_done:oralDone,
    dimension_scores:pct,
    total_score:total,
    signal:sig.name,
    written_raw:writtenAnswers,
    oral_raw:oralScores
  };
  const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='usausa_skill_result_'+new Date().toISOString().slice(0,10)+'.json';
  a.click();
}

/* =================== CONFETTI =================== */
function celebrate(){
  const cols=['#FF8A3D','#E0A53A','#2E83C9','#F4CE73','#FFB877'];
  for(let i=0;i<60;i++){
    const c=document.createElement('div'); c.className='confetti';
    c.style.left=Math.random()*100+'vw';
    c.style.background=cols[i%cols.length];
    c.style.animationDelay=(Math.random()*0.5)+'s';
    document.body.appendChild(c);
    const dur=2.4+Math.random()*1.6;
    c.animate([
      {transform:`translateY(0) rotate(0)`,opacity:1},
      {transform:`translateY(105vh) rotate(${720+Math.random()*360}deg)`,opacity:.9}
    ],{duration:dur*1000,easing:'cubic-bezier(.3,.7,.4,1)'});
    setTimeout(()=>c.remove(),dur*1000);
  }
}

/* init */
renderWritten();
renderOral();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-biz" title="IT業務設計" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ IT業務設計ツール（要件工学）🐰</title>
<style>
  *{box-sizing:border-box;}
  :root{ --radius:14px; }
  body.theme-jp{
    --paper:#ffffff; --cream:#eef1f8; --cream2:#e2e8f4; --ink:#1f2740; --ink-soft:#56607a;
    --line:#d3dcf0; --line-soft:#e6ecf8; --ok:#3f8f5f; --ng:#d24b4b;
    --accent:#3a4ea8; --accent-deep:#27387e; --gold:#6f80c8; --gold-soft:#c2cbed;
    --shadow:0 10px 30px rgba(58,78,168,.13);
  }
  body{margin:0;font-family:&quot;Hiragino Sans&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;color:var(--ink);
    background:linear-gradient(160deg,#dbe2f4,var(--cream) 42%);min-height:100vh;line-height:1.7;}
  .wrap{max-width:980px;margin:0 auto;padding:18px 16px 80px;}
  header.hero{position:relative;margin-top:24px;background:var(--paper);border:1px solid var(--line);
    border-radius:22px;padding:24px 28px;box-shadow:var(--shadow);overflow:hidden;}
  header.hero::before{content:&quot;&quot;;position:absolute;inset:0 0 auto 0;height:6px;
    background:linear-gradient(90deg,var(--gold-soft),var(--accent),var(--gold));}
  header.hero h1{margin:0 0 6px;font-size:1.32rem;font-weight:800;padding-right:46px;}
  header.hero p{margin:0;color:var(--ink-soft);font-size:.9rem;padding-right:46px;}
  .ver-badge{display:flex;gap:8px;align-items:center;margin:0 0 8px;flex-wrap:wrap;}
  .ver-pill{display:inline-block;background:var(--accent);color:#fff;font-weight:800;font-size:.72rem;letter-spacing:.3px;padding:2px 9px;border-radius:999px;}
  .ver-date,.ver-today{color:var(--ink-soft);font-size:.74rem;}
  .ver-today:not(:empty)::before{content:&quot;｜ 今日 &quot;;opacity:.8;}
  .bunny{position:absolute;top:16px;right:20px;font-size:28px;filter:drop-shadow(0 4px 8px rgba(58,78,168,.25));}
  .lang-switch{display:none;}

  .tabs{display:flex;gap:8px;margin:16px 0;flex-wrap:wrap;}
  .tab{flex:1 1 auto;min-width:120px;text-align:center;cursor:pointer;border:1px solid var(--line);
    background:var(--paper);border-radius:12px;padding:9px 11px;font-weight:700;font-size:.86rem;color:var(--ink-soft);
    box-shadow:0 2px 5px rgba(0,0,0,.05);transition:transform .08s,box-shadow .12s,background .12s;}
  .tab:hover{transform:translateY(-1px);box-shadow:0 4px 10px rgba(0,0,0,.1);}
  .tab:active{transform:translateY(1px) scale(.99);}
  .tab.active{background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;border-color:transparent;}

  .panel{display:none;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);}
  .panel.active{display:block;}
  h2{font-size:1.1rem;margin:0 0 6px;}
  h3{font-size:.96rem;margin:16px 0 6px;color:var(--accent-deep);}
  label{display:block;font-size:.8rem;font-weight:700;color:var(--ink-soft);margin:8px 0 3px;}
  input,select,textarea{width:100%;border:1px solid var(--line);border-radius:9px;padding:8px 10px;font-size:.92rem;font-family:inherit;color:var(--ink);background:var(--paper);}
  textarea{min-height:60px;resize:vertical;}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .hint{font-size:.78rem;color:var(--ink-soft);margin:4px 0 0;}
  code{background:var(--cream2);padding:1px 5px;border-radius:5px;font-size:.86em;}
  .howto{background:var(--cream2);border:1px solid var(--line);border-left:5px solid var(--accent);border-radius:10px;padding:10px 14px;margin:0 0 14px;font-size:.84rem;color:var(--ink-soft);}
  .howto b{color:var(--accent-deep);}
  .howto ol{margin:6px 0 0;padding-left:20px;}
  .howto li{margin:2px 0;}

  .stepnum{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;font-weight:800;font-size:.8rem;margin-right:8px;flex:0 0 24px;}
  .stepblock{border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin:10px 0;background:var(--cream);}
  .stepblock h3{margin:0 0 6px;display:flex;align-items:center;}

  button{transition:transform .08s,box-shadow .12s,filter .12s,background .12s;}
  .gen{margin-top:18px;width:100%;background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;border:none;border-radius:12px;padding:13px;font-size:1rem;font-weight:800;cursor:pointer;box-shadow:0 2px 5px rgba(0,0,0,.12);}
  .gen:hover{box-shadow:0 4px 10px rgba(0,0,0,.16);transform:translateY(-1px);}
  .gen:active{transform:translateY(1px) scale(.99);box-shadow:inset 0 3px 6px rgba(0,0,0,.2);}
  .addbtn{margin-top:8px;background:var(--cream2);border:1px dashed var(--accent);color:var(--accent-deep);border-radius:9px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.84rem;box-shadow:0 2px 5px rgba(0,0,0,.05);}
  .addbtn:hover{transform:translateY(-1px);}
  .addbtn:active{transform:translateY(1px) scale(.99);}
  .del{background:#fff;border:1px solid var(--line);color:var(--ng);border-radius:8px;padding:6px 9px;cursor:pointer;font-weight:700;}
  .row{display:flex;gap:8px;align-items:flex-start;margin:6px 0;}
  .row>*{margin:0;}
  .outwrap{margin-top:18px;background:var(--cream2);border:1px solid var(--line);border-radius:12px;padding:14px;}
  .outwrap h3{margin-top:0;}
  pre.out{white-space:pre-wrap;word-break:break-word;background:var(--paper);border:1px solid var(--line);border-radius:9px;padding:12px;font-size:.86rem;max-height:420px;overflow:auto;font-family:inherit;}
  .outbtns{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
  .outbtns button{border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:10px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.84rem;box-shadow:0 2px 5px rgba(0,0,0,.05);}
  .outbtns button:hover{transform:translateY(-1px);}
  .outbtns button:active{transform:translateY(1px) scale(.99);}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:999px;font-size:.86rem;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50;}
  .toast.show{opacity:.95;}
  #diagramWrap{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:14px;overflow:auto;margin-top:10px;}
  @media (max-width:560px){ .grid{grid-template-columns:1fr;} header.hero h1{padding-top:30px;padding-right:0;} }
</style>
</head>
<body class=&quot;theme-jp&quot;>
<div class=&quot;wrap&quot;>
  <header class=&quot;hero&quot;>
    <div class=&quot;bunny&quot;>🐰</div>
    <h1>うさうさ IT業務設計ツール（要件工学アプローチ）</h1>
    <div class=&quot;ver-badge&quot;><span class=&quot;ver-pill&quot;>v1.0</span><span class=&quot;ver-date&quot;>2026-05-22</span><span class=&quot;ver-today&quot; id=&quot;ver_today&quot;></span></div>
    <p>研修・コンサル業務を、要件工学の考え方で体系的に設計します。5ステップ設計・要件工学・論文テンプレ・作業分解（WBS）・図解まで。データは端末内のみ・外部送信なし。</p>
  </header>

  <div class=&quot;tabs&quot; id=&quot;tabs&quot;>
    <div class=&quot;tab active&quot; data-tab=&quot;step&quot;>🪜 5ステップ設計</div>
    <div class=&quot;tab&quot; data-tab=&quot;reqeng&quot;>📐 要件工学</div>
    <div class=&quot;tab&quot; data-tab=&quot;paper&quot;>📄 論文テンプレ</div>
    <div class=&quot;tab&quot; data-tab=&quot;wbs&quot;>🧩 作業分解WBS</div>
    <div class=&quot;tab&quot; data-tab=&quot;diagram&quot;>🖼 図解</div>
    <div class=&quot;tab&quot; data-tab=&quot;hub&quot;>🗂 データ統合</div>
  </div>

  <!-- 5ステップ設計 -->
  <div class=&quot;panel active&quot; id=&quot;panel-step&quot;>
    <h2>5ステップ設計</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>業務を、下の5つのステップで上から順に埋める（言葉の定義から完了条件まで）</li>
      <li>各ステップは「相手に伝わる業務設計」の基本5原則です</li>
      <li>「5ステップ設計書を生成する」で、体系化された設計書ができます</li>
    </ol></div>
    <div class=&quot;grid&quot;>
      <div><label>業務名・テーマ</label><input id=&quot;sp_title&quot; placeholder=&quot;新卒向けLinux研修の運営設計&quot;></div>
      <div><label>設計者</label><input id=&quot;sp_author&quot; placeholder=&quot;石黒 友季子&quot;></div>
    </div>

    <div class=&quot;stepblock&quot;>
      <h3><span class=&quot;stepnum&quot;>1</span>言葉を定義する</h3>
      <p class=&quot;hint&quot;>この業務で使う用語を、認識のズレがないよう定義します（1行＝1用語）。</p>
      <div id=&quot;defList&quot;></div>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;defAdd()&quot;>＋ 用語を追加</button>
    </div>

    <div class=&quot;stepblock&quot;>
      <h3><span class=&quot;stepnum&quot;>2</span>目的・ゴール・対象を決める</h3>
      <div class=&quot;grid&quot;>
        <div><label>目的（なぜやるか）</label><textarea id=&quot;sp_purpose&quot; placeholder=&quot;現場で困らないLinux基礎力をつける&quot;></textarea></div>
        <div><label>ゴール（どうなれば成功か）</label><textarea id=&quot;sp_goal&quot; placeholder=&quot;基本コマンドで自走でき、試験に合格する&quot;></textarea></div>
      </div>
      <div><label>対象（誰のため）</label><input id=&quot;sp_target&quot; placeholder=&quot;文系出身の新卒・Linux未経験&quot;></div>
    </div>

    <div class=&quot;stepblock&quot;>
      <h3><span class=&quot;stepnum&quot;>3</span>主語＋動詞でステップを書く</h3>
      <p class=&quot;hint&quot;>「誰が、何をする」を1行ずつ。曖昧さをなくすため主語と動詞を必ず入れます。</p>
      <div id=&quot;actList&quot;></div>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;actAdd()&quot;>＋ ステップを追加</button>
    </div>

    <div class=&quot;stepblock&quot;>
      <h3><span class=&quot;stepnum&quot;>4</span>気を付けることを全部書く</h3>
      <p class=&quot;hint&quot;>注意点・前提・禁止事項・リスクを残さず書き出します（1行ずつ）。</p>
      <div id=&quot;careList&quot;></div>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;careAdd()&quot;>＋ 注意点を追加</button>
    </div>

    <div class=&quot;stepblock&quot;>
      <h3><span class=&quot;stepnum&quot;>5</span>完了条件と期限</h3>
      <div class=&quot;grid&quot;>
        <div><label>完了条件（何をもって完了か）</label><textarea id=&quot;sp_dod&quot; placeholder=&quot;教材一式が揃い、メイン講師のレビューを通過している&quot;></textarea></div>
        <div><label>期限</label><input id=&quot;sp_due&quot; placeholder=&quot;2026/06/01&quot;></div>
      </div>
    </div>
    <button class=&quot;gen&quot; onclick=&quot;buildStep()&quot;>5ステップ設計書を生成する</button>
  </div>

  <!-- 要件工学 -->
  <div class=&quot;panel&quot; id=&quot;panel-reqeng&quot;>
    <h2>要件工学アプローチ</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>要件工学の4活動「要求獲得 → 分析 → 仕様化 → 検証」で業務要件を整理</li>
      <li>機能要件・非機能要件・ステークホルダを書き出す</li>
      <li>「要件定義書を生成する」で、要件工学に沿った文書ができます</li>
    </ol></div>
    <div><label>対象業務・システム</label><input id=&quot;re_scope&quot; placeholder=&quot;研修運営の標準化&quot;></div>
    <h3>① 要求獲得（ステークホルダと要求）</h3>
    <div id=&quot;reStake&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;reStakeAdd()&quot;>＋ ステークホルダ要求を追加</button>
    <h3>② 分析・仕様化（機能要件）</h3>
    <div id=&quot;reFunc&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;reFuncAdd()&quot;>＋ 機能要件を追加</button>
    <h3>③ 非機能要件（品質・制約）</h3>
    <div id=&quot;reNf&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;reNfAdd()&quot;>＋ 非機能要件を追加</button>
    <h3>④ 検証（受け入れ基準）</h3>
    <div><label>検証方法・受け入れ基準</label><textarea id=&quot;re_verify&quot; placeholder=&quot;各要件にトレース可能なテスト項目を用意し、レビューで合意する&quot;></textarea></div>
    <button class=&quot;gen&quot; onclick=&quot;buildReqeng()&quot;>要件定義書を生成する</button>
  </div>

  <!-- 論文テンプレ -->
  <div class=&quot;panel&quot; id=&quot;panel-paper&quot;>
    <h2>要件工学 論文テンプレート</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>研修・コンサル業務の体系化を「論文の型」でまとめます</li>
      <li>背景 → 課題 → 提案手法 → 評価 → 考察 → 結論 の順に埋める</li>
      <li>「論文ドラフトを生成する」で、発表・記事のたたき台になります</li>
    </ol></div>
    <div class=&quot;grid&quot;>
      <div><label>論文タイトル</label><input id=&quot;pp_title&quot; placeholder=&quot;要件工学アプローチによる研修業務の体系化&quot;></div>
      <div><label>著者</label><input id=&quot;pp_author&quot; placeholder=&quot;石黒 友季子&quot;></div>
    </div>
    <div><label>要旨（アブストラクト）</label><textarea id=&quot;pp_abstract&quot; placeholder=&quot;本研究では、属人化しやすい研修業務に要件工学を適用し…&quot;></textarea></div>
    <div><label>1. 背景</label><textarea id=&quot;pp_bg&quot; placeholder=&quot;研修業務は講師個人の経験に依存しがちで…&quot;></textarea></div>
    <div><label>2. 課題（問題設定）</label><textarea id=&quot;pp_problem&quot; placeholder=&quot;品質のばらつき・再現性の低さ…&quot;></textarea></div>
    <div><label>3. 提案手法</label><textarea id=&quot;pp_method&quot; placeholder=&quot;5ステップ設計と要件工学の4活動を組み合わせ…&quot;></textarea></div>
    <div><label>4. 評価（実験・適用結果）</label><textarea id=&quot;pp_eval&quot; placeholder=&quot;実際の研修に適用し、準備時間とばらつきを比較…&quot;></textarea></div>
    <div><label>5. 考察</label><textarea id=&quot;pp_discuss&quot; placeholder=&quot;効果と限界、適用条件について…&quot;></textarea></div>
    <div><label>6. 結論・今後の課題</label><textarea id=&quot;pp_conclusion&quot; placeholder=&quot;本手法の有効性を確認した。今後は…&quot;></textarea></div>
    <div><label>参考文献（1行ずつ）</label><textarea id=&quot;pp_refs&quot; placeholder=&quot;ソフトウェア要求 第3版, …&quot;></textarea></div>
    <button class=&quot;gen&quot; onclick=&quot;buildPaper()&quot;>論文ドラフトを生成する</button>
  </div>

  <!-- 作業分解WBS -->
  <div class=&quot;panel&quot; id=&quot;panel-wbs&quot;>
    <h2>作業分解（WBS）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>業務を「大項目 → 作業」の2階層に分解します</li>
      <li>同じ大項目名を続けて入れると、その下にぶら下がります</li>
      <li>「WBSを生成する」で、階層付きの作業分解表ができます</li>
    </ol></div>
    <div><label>プロジェクト名</label><input id=&quot;wb_proj&quot; placeholder=&quot;LPIC研修 教材整備&quot;></div>
    <h3>作業項目（大項目＋作業＋担当＋見積h）</h3>
    <div id=&quot;wbsList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;wbsAdd()&quot;>＋ 作業を追加</button>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;wbsTemplate()&quot;>🧩 研修業務の定番WBSを入れる</button>
    <button class=&quot;gen&quot; onclick=&quot;buildWbs()&quot;>WBSを生成する</button>
  </div>

  <!-- 図解 -->
  <div class=&quot;panel&quot; id=&quot;panel-diagram&quot;>
    <h2>図解（5ステップ階段図 / フロー）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>下の各行に、図にしたい項目を上から順に入れる（最大8行）</li>
      <li>「階段図」か「フロー図」を選んで「図を描く」</li>
      <li>「PNGで保存」で画像として保存できます（資料に貼れます）</li>
    </ol></div>
    <div class=&quot;grid&quot;>
      <div><label>図のタイトル</label><input id=&quot;dg_title&quot; placeholder=&quot;目的とゴールの5ステップ&quot;></div>
      <div><label>図の種類</label><select id=&quot;dg_type&quot;><option value=&quot;stair&quot;>階段図（画像と同じ）</option><option value=&quot;flow&quot;>フロー図（縦の流れ）</option></select></div>
    </div>
    <h3>図の項目（上から順）</h3>
    <div id=&quot;dgList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;dgAdd()&quot;>＋ 項目を追加</button>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;dgFromStep()&quot;>🪜 5ステップから取り込む</button>
    <button class=&quot;gen&quot; onclick=&quot;drawDiagram()&quot;>図を描く</button>
    <div id=&quot;diagramWrap&quot; style=&quot;display:none;&quot;></div>
    <div class=&quot;outbtns&quot; id=&quot;dgBtns&quot; style=&quot;display:none;&quot;>
      <button onclick=&quot;downloadSvg()&quot;>🖼 SVGで保存</button>
      <button onclick=&quot;downloadPng()&quot;>🖼 PNGで保存</button>
    </div>
  </div>

  <!-- データ統合 -->
  <div class=&quot;panel&quot; id=&quot;panel-hub&quot;>
    <h2>データ統合（保存・書き出し・取り込み）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>「JSON保存」で全タブの入力を1ファイルに保存</li>
      <li>「JSON取り込み」で復元</li>
      <li>WBSは「Excel出力」で表にできます</li>
    </ol></div>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;hubSaveJson()&quot;>💾 全データをJSON保存</button>
      <button onclick=&quot;document.getElementById('hubFile').click()&quot;>📂 JSONを取り込む</button>
      <input type=&quot;file&quot; id=&quot;hubFile&quot; accept=&quot;.json&quot; style=&quot;display:none&quot; onchange=&quot;hubLoadJson(this)&quot;>
      <button onclick=&quot;wbsExportXlsx()&quot;>📊 WBSをExcel出力</button>
      <button onclick=&quot;hubClearAll()&quot;>🗑 全クリア</button>
    </div>
    <p class=&quot;hint&quot;>保存したJSONはこのツールでのみ復元できます。大事なデータはこまめに保存してください。</p>
  </div>

  <div class=&quot;outwrap&quot;>
    <h3>生成結果</h3>
    <pre class=&quot;out&quot; id=&quot;out&quot;>ここに生成結果が表示されます。各タブの「生成する」を押してください。</pre>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;copyOut()&quot;>📋 コピー</button>
      <button onclick=&quot;downloadOut('txt')&quot;>📄 テキスト保存</button>
      <button onclick=&quot;downloadOut('md')&quot;>📝 Markdown保存</button>
      <button onclick=&quot;clearOut()&quot;>クリア</button>
    </div>
  </div>
</div>
<div class=&quot;toast&quot; id=&quot;toast&quot;></div>
<script>
&quot;use strict&quot;;
function $(id){ return document.getElementById(id); }
function v(id){ var el=$(id); return el?(el.value||&quot;&quot;).trim():&quot;&quot;; }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function lines(s){ return (s||&quot;&quot;).split(/\n+/).map(function(x){return x.trim();}).filter(Boolean); }
function toast(m){ var t=$(&quot;toast&quot;); if(!t)return; t.textContent=m; t.classList.add(&quot;show&quot;); setTimeout(function(){t.classList.remove(&quot;show&quot;);},1600); }
function lsAvailable(){ try{ var k=&quot;__t&quot;+Math.random(); window.localStorage.setItem(k,&quot;1&quot;); window.localStorage.removeItem(k); return true; }catch(e){ return false; } }
function nowParts(){
  var d=new Date(), wd=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var mm=(&quot;0&quot;+(d.getMonth()+1)).slice(-2), dd=(&quot;0&quot;+d.getDate()).slice(-2);
  var hh=(&quot;0&quot;+d.getHours()).slice(-2), mi=(&quot;0&quot;+d.getMinutes()).slice(-2);
  return { date:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;）&quot;, time:hh+&quot;:&quot;+mi, datetime:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;） &quot;+hh+&quot;:&quot;+mi };
}
function todayJp(){ return nowParts().date; }
function stamp(){ return nowParts().date.replace(/[^0-9]/g,&quot;&quot;).slice(0,8); }
var BAR=&quot;────────────────────────────&quot;;

var lastOut={txt:&quot;&quot;,md:&quot;&quot;};
function setOut(txt,md){ lastOut.txt=txt||&quot;&quot;; lastOut.md=(md!=null?md:txt)||&quot;&quot;; var o=$(&quot;out&quot;); if(o) o.textContent=lastOut.txt; }
function clearOut(){ setOut(&quot;&quot;); var o=$(&quot;out&quot;); if(o) o.textContent=&quot;&quot;; toast(&quot;クリアしました&quot;); }
function copyOut(){
  var t=lastOut.txt||&quot;&quot;; if(!t){ toast(&quot;生成結果がありません&quot;); return; }
  try{ navigator.clipboard.writeText(t); toast(&quot;コピーしました&quot;); }
  catch(e){ var ta=document.createElement(&quot;textarea&quot;); ta.value=t; document.body.appendChild(ta); ta.select(); try{document.execCommand(&quot;copy&quot;);}catch(_){} document.body.removeChild(ta); toast(&quot;コピーしました&quot;); }
}
function _saveBlob(text,fname,mime){
  try{ var blob=new Blob([text],{type:mime||&quot;text/plain;charset=utf-8&quot;}); var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=fname; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(url);},500); }catch(e){ toast(&quot;保存に失敗しました&quot;); }
}
function downloadOut(fmt){
  if(!lastOut.txt){ toast(&quot;生成結果がありません&quot;); return; }
  if(fmt===&quot;md&quot;){ _saveBlob(lastOut.md,&quot;bizdesign_&quot;+stamp()+&quot;.md&quot;,&quot;text/markdown;charset=utf-8&quot;); }
  else{ _saveBlob(lastOut.txt,&quot;bizdesign_&quot;+stamp()+&quot;.txt&quot;,&quot;text/plain;charset=utf-8&quot;); }
}
function mkRow(html){ var d=document.createElement(&quot;div&quot;); d.className=&quot;row&quot;; d.innerHTML=html; return d; }
function delRow(btn){ var r=btn.closest(&quot;.row&quot;); if(r) r.remove(); }

/* ===== ① 5ステップ設計 ===== */
function defAdd(term,mean){
  $(&quot;defList&quot;).appendChild(mkRow('<input class=&quot;def-t&quot; placeholder=&quot;用語&quot; value=&quot;'+esc(term||&quot;&quot;)+'&quot; style=&quot;max-width:30%&quot;><input class=&quot;def-m&quot; placeholder=&quot;定義・意味&quot; value=&quot;'+esc(mean||&quot;&quot;)+'&quot;><button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function actAdd(text){
  $(&quot;actList&quot;).appendChild(mkRow('<input class=&quot;act-s&quot; placeholder=&quot;主語＋動詞（例：講師が、教材をレビューする）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;><button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function careAdd(text){
  $(&quot;careList&quot;).appendChild(mkRow('<input class=&quot;care-c&quot; placeholder=&quot;気を付けること（例：独断で進めない／個人情報を扱わない）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;><button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function defRead(){ return [].slice.call(document.querySelectorAll(&quot;#defList .row&quot;)).map(function(r){return {t:r.querySelector(&quot;.def-t&quot;).value.trim(),m:r.querySelector(&quot;.def-m&quot;).value.trim()};}).filter(function(x){return x.t;}); }
function actRead(){ return [].slice.call(document.querySelectorAll(&quot;#actList .act-s&quot;)).map(function(e){return e.value.trim();}).filter(Boolean); }
function careRead(){ return [].slice.call(document.querySelectorAll(&quot;#careList .care-c&quot;)).map(function(e){return e.value.trim();}).filter(Boolean); }
function buildStep(){
  var defs=defRead(), acts=actRead(), cares=careRead();
  var o=[];
  o.push(&quot;【5ステップ設計書】&quot;+(v(&quot;sp_title&quot;)||&quot;（無題業務）&quot;));
  o.push(&quot;設計者：&quot;+(v(&quot;sp_author&quot;)||&quot;—&quot;)+&quot;　作成日：&quot;+todayJp());
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 1. 言葉を定義する&quot;); o.push(BAR);
  if(defs.length){ defs.forEach(function(d){ o.push(&quot;・&quot;+d.t+&quot;：&quot;+(d.m||&quot;—&quot;)); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 2. 目的・ゴール・対象&quot;); o.push(BAR);
  o.push(&quot;目的：&quot;+(v(&quot;sp_purpose&quot;)||&quot;—&quot;));
  o.push(&quot;ゴール：&quot;+(v(&quot;sp_goal&quot;)||&quot;—&quot;));
  o.push(&quot;対象：&quot;+(v(&quot;sp_target&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 3. 主語＋動詞でステップ&quot;); o.push(BAR);
  if(acts.length){ acts.forEach(function(a,i){ o.push((i+1)+&quot;. &quot;+a); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 4. 気を付けること&quot;); o.push(BAR);
  if(cares.length){ cares.forEach(function(c){ o.push(&quot;・&quot;+c); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 5. 完了条件と期限&quot;); o.push(BAR);
  o.push(&quot;完了条件：&quot;+(v(&quot;sp_dod&quot;)||&quot;—&quot;));
  o.push(&quot;期限：&quot;+(v(&quot;sp_due&quot;)||&quot;—&quot;));
  var m=[&quot;# 5ステップ設計書：&quot;+(v(&quot;sp_title&quot;)||&quot;（無題業務）&quot;),&quot;&quot;,&quot;- 設計者：&quot;+(v(&quot;sp_author&quot;)||&quot;—&quot;),&quot;- 作成日：&quot;+todayJp(),&quot;&quot;,&quot;## 1. 言葉を定義する&quot;,&quot;&quot;];
  if(defs.length){ defs.forEach(function(d){ m.push(&quot;- **&quot;+d.t+&quot;**：&quot;+(d.m||&quot;—&quot;)); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## 2. 目的・ゴール・対象&quot;); m.push(&quot;&quot;);
  m.push(&quot;- 目的：&quot;+(v(&quot;sp_purpose&quot;)||&quot;—&quot;)); m.push(&quot;- ゴール：&quot;+(v(&quot;sp_goal&quot;)||&quot;—&quot;)); m.push(&quot;- 対象：&quot;+(v(&quot;sp_target&quot;)||&quot;—&quot;));
  m.push(&quot;&quot;); m.push(&quot;## 3. 主語＋動詞でステップ&quot;); m.push(&quot;&quot;);
  if(acts.length){ acts.forEach(function(a,i){ m.push((i+1)+&quot;. &quot;+a); }); } else { m.push(&quot;1. （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## 4. 気を付けること&quot;); m.push(&quot;&quot;);
  if(cares.length){ cares.forEach(function(c){ m.push(&quot;- &quot;+c); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## 5. 完了条件と期限&quot;); m.push(&quot;&quot;);
  m.push(&quot;- 完了条件：&quot;+(v(&quot;sp_dod&quot;)||&quot;—&quot;)); m.push(&quot;- 期限：&quot;+(v(&quot;sp_due&quot;)||&quot;—&quot;));
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== ② 要件工学 ===== */
function reStakeAdd(who,req){
  $(&quot;reStake&quot;).appendChild(mkRow('<input class=&quot;rs-w&quot; placeholder=&quot;ステークホルダ&quot; value=&quot;'+esc(who||&quot;&quot;)+'&quot; style=&quot;max-width:32%&quot;><input class=&quot;rs-r&quot; placeholder=&quot;要求（何を求めるか）&quot; value=&quot;'+esc(req||&quot;&quot;)+'&quot;><button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function reFuncAdd(text){ $(&quot;reFunc&quot;).appendChild(mkRow('<input class=&quot;rf-f&quot; placeholder=&quot;機能要件（〜できること）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;><button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>')); }
function reNfAdd(text){ $(&quot;reNf&quot;).appendChild(mkRow('<input class=&quot;rn-n&quot; placeholder=&quot;非機能要件（品質・制約）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;><button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>')); }
function reStakeRead(){ return [].slice.call(document.querySelectorAll(&quot;#reStake .row&quot;)).map(function(r){return {w:r.querySelector(&quot;.rs-w&quot;).value.trim(),r:r.querySelector(&quot;.rs-r&quot;).value.trim()};}).filter(function(x){return x.w||x.r;}); }
function reFuncRead(){ return [].slice.call(document.querySelectorAll(&quot;#reFunc .rf-f&quot;)).map(function(e){return e.value.trim();}).filter(Boolean); }
function reNfRead(){ return [].slice.call(document.querySelectorAll(&quot;#reNf .rn-n&quot;)).map(function(e){return e.value.trim();}).filter(Boolean); }
function buildReqeng(){
  var st=reStakeRead(), fs=reFuncRead(), nf=reNfRead();
  var o=[];
  o.push(&quot;【要件定義書（要件工学アプローチ）】&quot;);
  o.push(&quot;対象：&quot;+(v(&quot;re_scope&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ ① 要求獲得（ステークホルダと要求）&quot;); o.push(BAR);
  if(st.length){ st.forEach(function(s){ o.push(&quot;・[&quot;+(s.w||&quot;—&quot;)+&quot;] &quot;+(s.r||&quot;—&quot;)); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ ② 機能要件&quot;); o.push(BAR);
  if(fs.length){ fs.forEach(function(x,i){ o.push(&quot;F&quot;+(i+1)+&quot;. &quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ ③ 非機能要件&quot;); o.push(BAR);
  if(nf.length){ nf.forEach(function(x,i){ o.push(&quot;N&quot;+(i+1)+&quot;. &quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ ④ 検証（受け入れ基準）&quot;); o.push(BAR);
  o.push(v(&quot;re_verify&quot;)||&quot;—&quot;);
  var m=[&quot;# 要件定義書（要件工学アプローチ）&quot;,&quot;&quot;,&quot;対象：&quot;+(v(&quot;re_scope&quot;)||&quot;—&quot;),&quot;&quot;,&quot;## ① 要求獲得&quot;,&quot;&quot;];
  if(st.length){ m.push(&quot;| ステークホルダ | 要求 |&quot;); m.push(&quot;|---|---|&quot;); st.forEach(function(s){ m.push(&quot;| &quot;+(s.w||&quot;—&quot;)+&quot; | &quot;+(s.r||&quot;—&quot;)+&quot; |&quot;); }); } else { m.push(&quot;（未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## ② 機能要件&quot;); m.push(&quot;&quot;);
  if(fs.length){ fs.forEach(function(x,i){ m.push(&quot;- **F&quot;+(i+1)+&quot;**：&quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## ③ 非機能要件&quot;); m.push(&quot;&quot;);
  if(nf.length){ nf.forEach(function(x,i){ m.push(&quot;- **N&quot;+(i+1)+&quot;**：&quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## ④ 検証（受け入れ基準）&quot;); m.push(&quot;&quot;); m.push(v(&quot;re_verify&quot;)||&quot;—&quot;);
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== ③ 論文テンプレ ===== */
function buildPaper(){
  var refs=lines(v(&quot;pp_refs&quot;));
  var o=[];
  o.push(&quot;【論文ドラフト】&quot;+(v(&quot;pp_title&quot;)||&quot;（無題）&quot;));
  o.push(&quot;著者：&quot;+(v(&quot;pp_author&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(&quot;■ 要旨&quot;); o.push(v(&quot;pp_abstract&quot;)||&quot;—&quot;);
  o.push(&quot;&quot;); o.push(&quot;■ 1. 背景&quot;); o.push(v(&quot;pp_bg&quot;)||&quot;—&quot;);
  o.push(&quot;&quot;); o.push(&quot;■ 2. 課題&quot;); o.push(v(&quot;pp_problem&quot;)||&quot;—&quot;);
  o.push(&quot;&quot;); o.push(&quot;■ 3. 提案手法&quot;); o.push(v(&quot;pp_method&quot;)||&quot;—&quot;);
  o.push(&quot;&quot;); o.push(&quot;■ 4. 評価&quot;); o.push(v(&quot;pp_eval&quot;)||&quot;—&quot;);
  o.push(&quot;&quot;); o.push(&quot;■ 5. 考察&quot;); o.push(v(&quot;pp_discuss&quot;)||&quot;—&quot;);
  o.push(&quot;&quot;); o.push(&quot;■ 6. 結論・今後の課題&quot;); o.push(v(&quot;pp_conclusion&quot;)||&quot;—&quot;);
  o.push(&quot;&quot;); o.push(&quot;■ 参考文献&quot;);
  if(refs.length){ refs.forEach(function(r,i){ o.push(&quot;[&quot;+(i+1)+&quot;] &quot;+r); }); } else { o.push(&quot;（未入力）&quot;); }
  var m=[&quot;# &quot;+(v(&quot;pp_title&quot;)||&quot;（無題）&quot;),&quot;&quot;,&quot;**著者**：&quot;+(v(&quot;pp_author&quot;)||&quot;—&quot;),&quot;&quot;,&quot;## 要旨&quot;,&quot;&quot;,v(&quot;pp_abstract&quot;)||&quot;—&quot;,
    &quot;&quot;,&quot;## 1. 背景&quot;,&quot;&quot;,v(&quot;pp_bg&quot;)||&quot;—&quot;,&quot;&quot;,&quot;## 2. 課題&quot;,&quot;&quot;,v(&quot;pp_problem&quot;)||&quot;—&quot;,&quot;&quot;,&quot;## 3. 提案手法&quot;,&quot;&quot;,v(&quot;pp_method&quot;)||&quot;—&quot;,
    &quot;&quot;,&quot;## 4. 評価&quot;,&quot;&quot;,v(&quot;pp_eval&quot;)||&quot;—&quot;,&quot;&quot;,&quot;## 5. 考察&quot;,&quot;&quot;,v(&quot;pp_discuss&quot;)||&quot;—&quot;,&quot;&quot;,&quot;## 6. 結論・今後の課題&quot;,&quot;&quot;,v(&quot;pp_conclusion&quot;)||&quot;—&quot;,&quot;&quot;,&quot;## 参考文献&quot;,&quot;&quot;];
  if(refs.length){ refs.forEach(function(r,i){ m.push(&quot;[&quot;+(i+1)+&quot;] &quot;+r); }); } else { m.push(&quot;（未入力）&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== ④ WBS ===== */
function wbsAdd(big,task,owner,est){
  $(&quot;wbsList&quot;).appendChild(mkRow(
    '<input class=&quot;wb-b&quot; placeholder=&quot;大項目&quot; value=&quot;'+esc(big||&quot;&quot;)+'&quot; style=&quot;max-width:24%&quot;>'+
    '<input class=&quot;wb-t&quot; placeholder=&quot;作業&quot; value=&quot;'+esc(task||&quot;&quot;)+'&quot;>'+
    '<input class=&quot;wb-o&quot; placeholder=&quot;担当&quot; value=&quot;'+esc(owner||&quot;&quot;)+'&quot; style=&quot;max-width:16%&quot;>'+
    '<input class=&quot;wb-e&quot; placeholder=&quot;h&quot; value=&quot;'+esc(est||&quot;&quot;)+'&quot; style=&quot;max-width:10%&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function wbsTemplate(){
  [[&quot;要件定義&quot;,&quot;到達目標の定義&quot;,&quot;&quot;,&quot;&quot;],[&quot;要件定義&quot;,&quot;受講生レベルの把握&quot;,&quot;&quot;,&quot;&quot;],[&quot;設計&quot;,&quot;カリキュラム設計&quot;,&quot;&quot;,&quot;&quot;],[&quot;設計&quot;,&quot;タイムテーブル作成&quot;,&quot;&quot;,&quot;&quot;],[&quot;教材&quot;,&quot;スライド作成&quot;,&quot;&quot;,&quot;&quot;],[&quot;教材&quot;,&quot;演習・模範解答作成&quot;,&quot;&quot;,&quot;&quot;],[&quot;評価&quot;,&quot;筆記・実技試験設計&quot;,&quot;&quot;,&quot;&quot;],[&quot;運営&quot;,&quot;当日進行・サポート&quot;,&quot;&quot;,&quot;&quot;],[&quot;改善&quot;,&quot;アンケート分析・改善&quot;,&quot;&quot;,&quot;&quot;]].forEach(function(t){ wbsAdd(t[0],t[1],t[2],t[3]); });
  toast(&quot;定番WBSを入れました&quot;);
}
function wbsRead(){ return [].slice.call(document.querySelectorAll(&quot;#wbsList .row&quot;)).map(function(r){return {b:r.querySelector(&quot;.wb-b&quot;).value.trim(),t:r.querySelector(&quot;.wb-t&quot;).value.trim(),o:r.querySelector(&quot;.wb-o&quot;).value.trim(),e:r.querySelector(&quot;.wb-e&quot;).value.trim()};}).filter(function(x){return x.b||x.t;}); }
function buildWbs(){
  var ws=wbsRead();
  var o=[];
  o.push(&quot;【作業分解（WBS）】&quot;+(v(&quot;wb_proj&quot;)||&quot;（無題PJ）&quot;));
  o.push(&quot;&quot;); o.push(BAR);
  var lastBig=&quot;&quot;, totalH=0;
  ws.forEach(function(w){
    if(w.b &amp;&amp; w.b!==lastBig){ o.push(&quot;◆ &quot;+w.b); lastBig=w.b; }
    var h=parseFloat(w.e); if(!isNaN(h)) totalH+=h;
    o.push(&quot;　└ &quot;+(w.t||&quot;—&quot;)+(w.o?(&quot;　担当:&quot;+w.o):&quot;&quot;)+(w.e?(&quot;　&quot;+w.e+&quot;h&quot;):&quot;&quot;));
  });
  if(!ws.length) o.push(&quot;（未入力）&quot;);
  if(totalH>0){ o.push(&quot;&quot;); o.push(&quot;合計見積：約&quot;+totalH+&quot;h&quot;); }
  var m=[&quot;# 作業分解（WBS）：&quot;+(v(&quot;wb_proj&quot;)||&quot;（無題PJ）&quot;),&quot;&quot;,&quot;| 大項目 | 作業 | 担当 | 見積(h) |&quot;,&quot;|---|---|---|---|&quot;];
  if(ws.length){ ws.forEach(function(w){ m.push(&quot;| &quot;+(w.b||&quot;&quot;)+&quot; | &quot;+(w.t||&quot;—&quot;)+&quot; | &quot;+(w.o||&quot;—&quot;)+&quot; | &quot;+(w.e||&quot;—&quot;)+&quot; |&quot;); }); } else { m.push(&quot;| — | （未入力） | — | — |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ===== ⑤ 図解（SVG） ===== */
function dgAdd(text){ $(&quot;dgList&quot;).appendChild(mkRow('<input class=&quot;dg-i&quot; placeholder=&quot;項目&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;><button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>')); }
function dgRead(){ return [].slice.call(document.querySelectorAll(&quot;#dgList .dg-i&quot;)).map(function(e){return e.value.trim();}).filter(Boolean); }
function dgFromStep(){
  $(&quot;dgList&quot;).innerHTML=&quot;&quot;;
  [&quot;1. 言葉を定義する&quot;,&quot;2. 目的・ゴール・対象を決める&quot;,&quot;3. 主語＋動詞でステップを書く&quot;,&quot;4. 気を付けることを全部書く&quot;,&quot;5. 完了条件と期限&quot;].forEach(dgAdd);
  if(!v(&quot;dg_title&quot;)) $(&quot;dg_title&quot;).value=&quot;目的とゴールの5ステップ&quot;;
  toast(&quot;5ステップを取り込みました&quot;);
}
var lastSvg=&quot;&quot;;
function drawDiagram(){
  var items=dgRead().slice(0,8); var title=v(&quot;dg_title&quot;)||&quot;&quot;;
  if(!items.length){ toast(&quot;項目を入れてください&quot;); return; }
  var type=v(&quot;dg_type&quot;)||&quot;stair&quot;;
  var W=760, padX=24, topY=title?54:24, rowH=46, gap=14;
  var H=topY+items.length*(rowH+gap)+20;
  var svg='<svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;'+W+'&quot; height=&quot;'+H+'&quot; viewBox=&quot;0 0 '+W+' '+H+'&quot; font-family=&quot;Hiragino Sans, Meiryo, sans-serif&quot;>';
  svg+='<rect x=&quot;0&quot; y=&quot;0&quot; width=&quot;'+W+'&quot; height=&quot;'+H+'&quot; fill=&quot;#ffffff&quot;/>';
  if(title){ svg+='<text x=&quot;'+(W/2)+'&quot; y=&quot;32&quot; text-anchor=&quot;middle&quot; font-size=&quot;18&quot; font-weight=&quot;700&quot; fill=&quot;#27387e&quot;>'+esc(title)+'</text>'; }
  if(type===&quot;stair&quot;){
    // 画像と同じ：下が1、上が最大。右肩上がりの階段
    var n=items.length;
    for(var i=0;i<n;i++){
      var idxFromBottom=i; // items[0]=1番下
      var item=items[i];
      var y=topY+(n-1-i)*(rowH+gap); // 上に行くほど番号大
      var boxW=300+i*70; if(boxW>W-2*padX) boxW=W-2*padX;
      var x=padX+i*36; if(x+boxW>W-padX) x=W-padX-boxW;
      svg+='<rect x=&quot;'+x+'&quot; y=&quot;'+y+'&quot; width=&quot;'+boxW+'&quot; height=&quot;'+rowH+'&quot; fill=&quot;#eef1f8&quot; stroke=&quot;#3a4ea8&quot; stroke-width=&quot;1.5&quot; rx=&quot;6&quot;/>';
      svg+='<text x=&quot;'+(x+14)+'&quot; y=&quot;'+(y+rowH/2+5)+'&quot; font-size=&quot;14&quot; fill=&quot;#1f2740&quot;>'+esc(item)+'</text>';
    }
  } else {
    // フロー：縦に並べて矢印
    for(var j=0;j<items.length;j++){
      var fy=topY+j*(rowH+gap);
      var fx=padX, fw=W-2*padX;
      svg+='<rect x=&quot;'+fx+'&quot; y=&quot;'+fy+'&quot; width=&quot;'+fw+'&quot; height=&quot;'+rowH+'&quot; fill=&quot;#eef1f8&quot; stroke=&quot;#3a4ea8&quot; stroke-width=&quot;1.5&quot; rx=&quot;8&quot;/>';
      svg+='<text x=&quot;'+(fx+16)+'&quot; y=&quot;'+(fy+rowH/2+5)+'&quot; font-size=&quot;14&quot; fill=&quot;#1f2740&quot;>'+esc(items[j])+'</text>';
      if(j<items.length-1){ var ay=fy+rowH, ay2=fy+rowH+gap; var cx=W/2; svg+='<line x1=&quot;'+cx+'&quot; y1=&quot;'+ay+'&quot; x2=&quot;'+cx+'&quot; y2=&quot;'+ay2+'&quot; stroke=&quot;#3a4ea8&quot; stroke-width=&quot;2&quot;/><polygon points=&quot;'+(cx-5)+','+(ay2-6)+' '+(cx+5)+','+(ay2-6)+' '+cx+','+ay2+'&quot; fill=&quot;#3a4ea8&quot;/>'; }
    }
  }
  svg+='</svg>';
  lastSvg=svg;
  var w=$(&quot;diagramWrap&quot;); w.style.display=&quot;block&quot;; w.innerHTML=svg;
  $(&quot;dgBtns&quot;).style.display=&quot;flex&quot;;
  toast(&quot;図を描きました&quot;);
}
function downloadSvg(){ if(!lastSvg){ toast(&quot;先に図を描いてください&quot;); return; } _saveBlob(lastSvg, &quot;diagram_&quot;+stamp()+&quot;.svg&quot;, &quot;image/svg+xml;charset=utf-8&quot;); }
function downloadPng(){
  if(!lastSvg){ toast(&quot;先に図を描いてください&quot;); return; }
  try{
    var svgEl=$(&quot;diagramWrap&quot;).querySelector(&quot;svg&quot;);
    var w=parseInt(svgEl.getAttribute(&quot;width&quot;)), h=parseInt(svgEl.getAttribute(&quot;height&quot;));
    var blob=new Blob([lastSvg],{type:&quot;image/svg+xml;charset=utf-8&quot;});
    var url=URL.createObjectURL(blob);
    var img=new Image();
    img.onload=function(){
      var scale=2;
      var canvas=document.createElement(&quot;canvas&quot;); canvas.width=w*scale; canvas.height=h*scale;
      var ctx=canvas.getContext(&quot;2d&quot;); ctx.scale(scale,scale); ctx.drawImage(img,0,0);
      URL.revokeObjectURL(url);
      canvas.toBlob(function(b){ var u=URL.createObjectURL(b); var a=document.createElement(&quot;a&quot;); a.href=u; a.download=&quot;diagram_&quot;+stamp()+&quot;.png&quot;; document.body.appendChild(a); a.click(); document.body.removeChild(a); setTimeout(function(){URL.revokeObjectURL(u);},500); toast(&quot;PNGを保存しました&quot;); });
    };
    img.onerror=function(){ toast(&quot;PNG変換に失敗しました&quot;); };
    img.src=url;
  }catch(e){ toast(&quot;PNG変換に失敗しました&quot;); }
}

/* ===== Excel(WBS) ===== */
function _crc32(b){ var c,crc=0xFFFFFFFF; for(var i=0;i<b.length;i++){ c=(crc^b[i])&amp;0xFF; for(var k=0;k<8;k++){ c=(c&amp;1)?(0xEDB88320^(c>>>1)):(c>>>1); } crc=(crc>>>8)^c; } return (crc^0xFFFFFFFF)>>>0; }
function _sb(s){ return new TextEncoder().encode(s); }
function _u16(n){ return [n&amp;0xFF,(n>>>8)&amp;0xFF]; }
function _u32(n){ return [n&amp;0xFF,(n>>>8)&amp;0xFF,(n>>>16)&amp;0xFF,(n>>>24)&amp;0xFF]; }
function _S(s){ return {t:&quot;s&quot;,v:(s==null?&quot;&quot;:String(s))}; }
function _N(n){ return {t:&quot;n&quot;,v:n}; }
function _col(i){ var s=&quot;&quot;; i++; while(i>0){ var m=(i-1)%26; s=String.fromCharCode(65+m)+s; i=Math.floor((i-1)/26); } return s; }
function _sheetXml(rows){
  var xml='<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><worksheet xmlns=&quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot;><sheetData>';
  for(var r=0;r<rows.length;r++){ xml+='<row r=&quot;'+(r+1)+'&quot;>';
    for(var c=0;c<rows[r].length;c++){ var cell=rows[r][c], ref=_col(c)+(r+1);
      if(cell&amp;&amp;cell.t===&quot;n&quot;){ xml+='<c r=&quot;'+ref+'&quot;><v>'+cell.v+'</v></c>'; }
      else{ var t=(cell&amp;&amp;cell.v!=null)?String(cell.v):&quot;&quot;; xml+='<c r=&quot;'+ref+'&quot; t=&quot;inlineStr&quot;><is><t xml:space=&quot;preserve&quot;>'+esc(t)+'</t></is></c>'; } }
    xml+='</row>'; }
  xml+='</sheetData></worksheet>'; return xml;
}
function _zipStore(files){
  var chunks=[],central=[],offset=0;
  files.forEach(function(f){ var nameB=_sb(f.name),dataB=f.data,crc=_crc32(dataB);
    var lh=[].concat(_u32(0x04034b50),_u16(20),_u16(0),_u16(0),_u16(0),_u16(0),_u32(crc),_u32(dataB.length),_u32(dataB.length),_u16(nameB.length),_u16(0));
    chunks.push(new Uint8Array(lh)); chunks.push(nameB); chunks.push(dataB);
    var ch=[].concat(_u32(0x02014b50),_u16(20),_u16(20),_u16(0),_u16(0),_u16(0),_u16(0),_u32(crc),_u32(dataB.length),_u32(dataB.length),_u16(nameB.length),_u16(0),_u16(0),_u16(0),_u16(0),_u32(0),_u32(offset));
    central.push(new Uint8Array(ch)); central.push(nameB); offset+=lh.length+nameB.length+dataB.length; });
  var cstart=offset,csize=0; central.forEach(function(c){ csize+=c.length; });
  var end=[].concat(_u32(0x06054b50),_u16(0),_u16(0),_u16(files.length),_u16(files.length),_u32(csize),_u32(cstart),_u16(0));
  var all=[]; chunks.forEach(function(c){all.push(c);}); central.forEach(function(c){all.push(c);}); all.push(new Uint8Array(end));
  var total=0; all.forEach(function(a){total+=a.length;}); var out=new Uint8Array(total),p=0; all.forEach(function(a){ out.set(a,p); p+=a.length; }); return out;
}
function _buildXlsx(sheets){
  var files=[];
  files.push({name:&quot;[Content_Types].xml&quot;,data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Types xmlns=&quot;http://schemas.openxmlformats.org/package/2006/content-types&quot;><Default Extension=&quot;rels&quot; ContentType=&quot;application/vnd.openxmlformats-package.relationships+xml&quot;/><Default Extension=&quot;xml&quot; ContentType=&quot;application/xml&quot;/><Override PartName=&quot;/xl/workbook.xml&quot; ContentType=&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml&quot;/>'+sheets.map(function(s,i){return '<Override PartName=&quot;/xl/worksheets/sheet'+(i+1)+'.xml&quot; ContentType=&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml&quot;/>';}).join(&quot;&quot;)+'</Types>')});
  files.push({name:&quot;_rels/.rels&quot;,data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Relationships xmlns=&quot;http://schemas.openxmlformats.org/package/2006/relationships&quot;><Relationship Id=&quot;rId1&quot; Type=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument&quot; Target=&quot;xl/workbook.xml&quot;/></Relationships>')});
  files.push({name:&quot;xl/workbook.xml&quot;,data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><workbook xmlns=&quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot; xmlns:r=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships&quot;><sheets>'+sheets.map(function(s,i){return '<sheet name=&quot;'+esc(s.name)+'&quot; sheetId=&quot;'+(i+1)+'&quot; r:id=&quot;rId'+(i+1)+'&quot;/>';}).join(&quot;&quot;)+'</sheets></workbook>')});
  files.push({name:&quot;xl/_rels/workbook.xml.rels&quot;,data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Relationships xmlns=&quot;http://schemas.openxmlformats.org/package/2006/relationships&quot;>'+sheets.map(function(s,i){return '<Relationship Id=&quot;rId'+(i+1)+'&quot; Type=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet&quot; Target=&quot;worksheets/sheet'+(i+1)+'.xml&quot;/>';}).join(&quot;&quot;)+'</Relationships>')});
  sheets.forEach(function(s,i){ files.push({name:&quot;xl/worksheets/sheet&quot;+(i+1)+&quot;.xml&quot;,data:_sb(_sheetXml(s.rows))}); });
  return _zipStore(files);
}
function wbsExportXlsx(){
  var ws=wbsRead();
  var rows=[[_S(&quot;大項目&quot;),_S(&quot;作業&quot;),_S(&quot;担当&quot;),_S(&quot;見積(h)&quot;)]];
  if(ws.length){ ws.forEach(function(w){ rows.push([_S(w.b),_S(w.t),_S(w.o),(w.e&amp;&amp;!isNaN(parseFloat(w.e)))?_N(parseFloat(w.e)):_S(w.e)]); }); } else { rows.push([_S(&quot;—&quot;),_S(&quot;（未入力）&quot;),_S(&quot;—&quot;),_S(&quot;—&quot;)]); }
  try{ var u8=_buildXlsx([{name:&quot;WBS&quot;,rows:rows}]);
    var blob=new Blob([u8],{type:&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet&quot;}); var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=&quot;WBS_&quot;+stamp()+&quot;.xlsx&quot;; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(url);},500); toast(&quot;Excelを書き出しました&quot;); }catch(e){ toast(&quot;Excel出力に失敗しました&quot;); }
}

/* ===== データ統合 ===== */
function collectAll(){
  return { _app:&quot;usausa_bizdesign&quot;, _ver:&quot;1.0&quot;, _saved:nowParts().datetime,
    step:{ title:v(&quot;sp_title&quot;),author:v(&quot;sp_author&quot;),defs:defRead(),purpose:v(&quot;sp_purpose&quot;),goal:v(&quot;sp_goal&quot;),target:v(&quot;sp_target&quot;),acts:actRead(),cares:careRead(),dod:v(&quot;sp_dod&quot;),due:v(&quot;sp_due&quot;) },
    reqeng:{ scope:v(&quot;re_scope&quot;),stake:reStakeRead(),func:reFuncRead(),nf:reNfRead(),verify:v(&quot;re_verify&quot;) },
    paper:{ title:v(&quot;pp_title&quot;),author:v(&quot;pp_author&quot;),abstract:v(&quot;pp_abstract&quot;),bg:v(&quot;pp_bg&quot;),problem:v(&quot;pp_problem&quot;),method:v(&quot;pp_method&quot;),eval:v(&quot;pp_eval&quot;),discuss:v(&quot;pp_discuss&quot;),conclusion:v(&quot;pp_conclusion&quot;),refs:v(&quot;pp_refs&quot;) },
    wbs:{ proj:v(&quot;wb_proj&quot;),list:wbsRead() },
    diagram:{ title:v(&quot;dg_title&quot;),type:v(&quot;dg_type&quot;),items:dgRead() }
  };
}
function hubSaveJson(){ _saveBlob(JSON.stringify(collectAll(),null,2),&quot;bizdesign_data_&quot;+stamp()+&quot;.json&quot;,&quot;application/json;charset=utf-8&quot;); toast(&quot;全データをJSON保存しました&quot;); }
function applyAll(d){
  if(!d||typeof d!==&quot;object&quot;) return;
  function set(id,val){ var el=$(id); if(el) el.value=(val||&quot;&quot;); }
  if(d.step){ set(&quot;sp_title&quot;,d.step.title); set(&quot;sp_author&quot;,d.step.author); set(&quot;sp_purpose&quot;,d.step.purpose); set(&quot;sp_goal&quot;,d.step.goal); set(&quot;sp_target&quot;,d.step.target); set(&quot;sp_dod&quot;,d.step.dod); set(&quot;sp_due&quot;,d.step.due);
    $(&quot;defList&quot;).innerHTML=&quot;&quot;; (d.step.defs||[]).forEach(function(x){ defAdd(x.t,x.m); });
    $(&quot;actList&quot;).innerHTML=&quot;&quot;; (d.step.acts||[]).forEach(actAdd);
    $(&quot;careList&quot;).innerHTML=&quot;&quot;; (d.step.cares||[]).forEach(careAdd); }
  if(d.reqeng){ set(&quot;re_scope&quot;,d.reqeng.scope); set(&quot;re_verify&quot;,d.reqeng.verify);
    $(&quot;reStake&quot;).innerHTML=&quot;&quot;; (d.reqeng.stake||[]).forEach(function(x){ reStakeAdd(x.w,x.r); });
    $(&quot;reFunc&quot;).innerHTML=&quot;&quot;; (d.reqeng.func||[]).forEach(reFuncAdd);
    $(&quot;reNf&quot;).innerHTML=&quot;&quot;; (d.reqeng.nf||[]).forEach(reNfAdd); }
  if(d.paper){ [&quot;title&quot;,&quot;author&quot;,&quot;abstract&quot;,&quot;bg&quot;,&quot;problem&quot;,&quot;method&quot;,&quot;eval&quot;,&quot;discuss&quot;,&quot;conclusion&quot;,&quot;refs&quot;].forEach(function(k){ set(&quot;pp_&quot;+k, d.paper[k]); }); }
  if(d.wbs){ set(&quot;wb_proj&quot;,d.wbs.proj); $(&quot;wbsList&quot;).innerHTML=&quot;&quot;; (d.wbs.list||[]).forEach(function(w){ wbsAdd(w.b,w.t,w.o,w.e); }); }
  if(d.diagram){ set(&quot;dg_title&quot;,d.diagram.title); if(d.diagram.type) set(&quot;dg_type&quot;,d.diagram.type); $(&quot;dgList&quot;).innerHTML=&quot;&quot;; (d.diagram.items||[]).forEach(dgAdd); }
}
function hubLoadJson(input){
  var f=input&amp;&amp;input.files&amp;&amp;input.files[0]; if(!f){ return; }
  var rd=new FileReader();
  rd.onload=function(){ try{ applyAll(JSON.parse(rd.result)); toast(&quot;JSONを取り込みました&quot;); }catch(e){ toast(&quot;JSONの読み込みに失敗しました&quot;); } input.value=&quot;&quot;; };
  rd.readAsText(f);
}
function hubClearAll(){
  if(!window.confirm(&quot;すべての入力をクリアします。よろしいですか？&quot;)) return;
  [&quot;sp_title&quot;,&quot;sp_author&quot;,&quot;sp_purpose&quot;,&quot;sp_goal&quot;,&quot;sp_target&quot;,&quot;sp_dod&quot;,&quot;sp_due&quot;,&quot;re_scope&quot;,&quot;re_verify&quot;,&quot;pp_title&quot;,&quot;pp_author&quot;,&quot;pp_abstract&quot;,&quot;pp_bg&quot;,&quot;pp_problem&quot;,&quot;pp_method&quot;,&quot;pp_eval&quot;,&quot;pp_discuss&quot;,&quot;pp_conclusion&quot;,&quot;pp_refs&quot;,&quot;wb_proj&quot;,&quot;dg_title&quot;].forEach(function(id){ var el=$(id); if(el) el.value=&quot;&quot;; });
  [&quot;defList&quot;,&quot;actList&quot;,&quot;careList&quot;,&quot;reStake&quot;,&quot;reFunc&quot;,&quot;reNf&quot;,&quot;wbsList&quot;,&quot;dgList&quot;].forEach(function(id){ var el=$(id); if(el) el.innerHTML=&quot;&quot;; });
  setOut(&quot;&quot;); $(&quot;out&quot;).textContent=&quot;&quot;; $(&quot;diagramWrap&quot;).style.display=&quot;none&quot;; $(&quot;dgBtns&quot;).style.display=&quot;none&quot;; lastSvg=&quot;&quot;;
  defAdd(); actAdd(); careAdd(); reStakeAdd(); reFuncAdd(); reNfAdd(); wbsAdd(); dgAdd();
  $(&quot;sp_author&quot;).value=&quot;石黒 友季子&quot;; $(&quot;pp_author&quot;).value=&quot;石黒 友季子&quot;;
  toast(&quot;全クリアしました&quot;);
}

/* ===== タブ ===== */
function switchPanel(tab){
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.classList.toggle(&quot;active&quot;, t.dataset.tab===tab); });
  [].slice.call(document.querySelectorAll(&quot;.panel&quot;)).forEach(function(p){ p.classList.toggle(&quot;active&quot;, p.id===&quot;panel-&quot;+tab); });
}

/* ===== init ===== */
(function(){
  defAdd(); actAdd(); careAdd(); reStakeAdd(); reFuncAdd(); reNfAdd(); wbsAdd(); dgAdd();
  if($(&quot;sp_author&quot;)) $(&quot;sp_author&quot;).value=&quot;石黒 友季子&quot;;
  if($(&quot;pp_author&quot;)) $(&quot;pp_author&quot;).value=&quot;石黒 友季子&quot;;
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.addEventListener(&quot;click&quot;, function(){ switchPanel(t.dataset.tab); }); });
  try{ var vt=$(&quot;ver_today&quot;); if(vt) vt.textContent=nowParts().date; }catch(e){}
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-sensei" title="プロンプト先生" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>AIプロンプト集品質向上先生 🧠</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:&quot;Noto Sans JP&quot;,&quot;Hiragino Sans&quot;,sans-serif;min-height:100vh;
    background:linear-gradient(135deg,#0f0c29,#302b63,#24243e);color:#f0f0f0;}
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:rgba(139,92,246,.5);border-radius:3px}
  textarea,input{outline:none;font-family:inherit;}
  .btn{transition:all .2s;cursor:pointer}
  .btn:hover{opacity:.85}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .fi{animation:fadeIn .35s ease forwards}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .pulse{animation:pulse 1.4s infinite}
  .wrapH{padding:24px 28px 0;max-width:960px;margin:0 auto;}
  .wrapB{max-width:960px;margin:0 auto;padding:24px 28px 60px;}
  .card{background:rgba(255,255,255,0.04);border-radius:12px;padding:20px;border:1px solid rgba(255,255,255,0.08);}
  .toptab{padding:9px 18px;background:transparent;border:none;border-bottom:2px solid transparent;
    color:#64748b;font-weight:700;font-size:13px;cursor:pointer;border-radius:8px 8px 0 0;}
  .toptab.active{background:rgba(139,92,246,.3);border-bottom:2px solid #8b5cf6;color:#a78bfa;}
  .subtab{padding:7px 13px;background:rgba(255,255,255,.05);border:1px solid transparent;border-radius:20px;
    color:#64748b;font-size:12px;font-weight:600;cursor:pointer;}
  .subtab.active{background:rgba(139,92,246,.4);border:1px solid #8b5cf6;color:#a78bfa;}
  textarea,input[type=password]{width:100%;background:rgba(0,0,0,.2);border:1px solid rgba(255,255,255,.1);
    border-radius:8px;padding:10px 12px;color:#e2e8f0;font-size:12px;line-height:1.6;}
  .lang-switch{display:none;}
</style>
</head>
<body>
<div class=&quot;wrapH&quot;>
  <div style=&quot;display:flex;align-items:center;gap:12px;margin-bottom:4px;&quot;>
    <div style=&quot;width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#8b5cf6,#ec4899);display:flex;align-items:center;justify-content:center;font-size:20px;&quot;>🧠</div>
    <div>
      <h1 style=&quot;margin:0;font-size:18px;font-weight:900;background:linear-gradient(90deg,#a78bfa,#f472b6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;&quot;>AIプロンプト集品質向上先生</h1>
      <p style=&quot;margin:0;font-size:11px;color:#94a3b8;&quot;>【APIキーなし版】完全オフライン。手動プロンプトをコピー→AIに貼付→JSON取り込み</p>
    </div>
  </div>
  <div style=&quot;display:flex;gap:4px;margin-top:20px;border-bottom:1px solid rgba(255,255,255,.1);&quot;>
    <button class=&quot;btn toptab active&quot; id=&quot;tt-input&quot; onclick=&quot;setTab('input')&quot;>📝 入力</button>
    <button class=&quot;btn toptab&quot; id=&quot;tt-result&quot; onclick=&quot;setTab('result')&quot;>📊 結果</button>
  </div>
</div>

<div class=&quot;wrapB&quot;>
  <div id=&quot;view-input&quot; class=&quot;fi&quot;>
    <div style=&quot;display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:18px;&quot; id=&quot;formGrid&quot;></div>

    

    <div id=&quot;errBox&quot; style=&quot;display:none;background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.3);border-radius:8px;padding:10px 14px;color:#fca5a5;margin-bottom:14px;font-size:13px;&quot;></div>

    

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 8px;font-size:12px;font-weight:700;color:#94a3b8;&quot;>🛠 使い方（3ステップ）</p>
      <p style=&quot;margin:0 0 10px;font-size:11px;color:#64748b;line-height:1.7;&quot;>①「手動プロンプトをコピー」→ ②Claude等のAIに貼り付け → ③返ってきたJSONを下に貼って「取り込む」。</p>
      <div style=&quot;display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;&quot;>
        <button class=&quot;btn&quot; id=&quot;manualBtn&quot; onclick=&quot;copyManual()&quot; style=&quot;background:rgba(139,92,246,.2);border:1px solid #8b5cf6;border-radius:8px;padding:7px 14px;color:#c4b5fd;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 手動プロンプトをコピー</button>
      </div>
      <textarea id=&quot;pasteJson&quot; placeholder=&quot;AIが返したJSONをここに貼り付け&quot; style=&quot;min-height:80px;margin-bottom:8px;&quot;></textarea>
      <button class=&quot;btn&quot; onclick=&quot;importJson()&quot; style=&quot;background:rgba(16,185,129,.2);border:1px solid #10b981;border-radius:8px;padding:7px 14px;color:#6ee7b7;font-size:12px;cursor:pointer;font-weight:600;&quot;>📥 JSONを取り込んで結果を表示</button>
    </div>

    <div class=&quot;card&quot; style=&quot;margin-top:20px;&quot;>
      <p style=&quot;margin:0 0 10px;font-size:12px;font-weight:700;color:#94a3b8;&quot;>✨ 生成されるもの</p>
      <div style=&quot;display:flex;flex-wrap:wrap;gap:6px;&quot; id=&quot;genTags&quot;></div>
    </div>
  </div>

  <div id=&quot;view-result&quot; class=&quot;fi&quot; style=&quot;display:none;&quot;>
    <div id=&quot;resultEmpty&quot; style=&quot;text-align:center;padding:80px 20px;color:#475569;&quot;>
      <div style=&quot;font-size:44px;margin-bottom:14px;&quot;>📝</div>
      <p>「入力」タブで振り返りを入力してください</p>
    </div>
    <div id=&quot;resultBody&quot; style=&quot;display:none;&quot;>
      <div style=&quot;display:flex;gap:4px;margin-bottom:20px;flex-wrap:wrap;&quot; id=&quot;subtabs&quot;></div>
      <div id=&quot;resultView&quot;></div>
    </div>
  </div>
</div>

<script>
&quot;use strict&quot;;
var SYSTEM_PROMPT = `あなたは「AIプロンプト集品質向上先生」です。
ユーザーの振り返り（グッド/バッド/学び/取り組み）を受け取り、以下の形式でJSONのみ返してください（前後に余分なテキスト・バッククォート不要）：

{
  &quot;abstract_level&quot;: {
    &quot;level1_concrete&quot;: [&quot;具体的な出来事・行動を3〜5個&quot;],
    &quot;level2_pattern&quot;: [&quot;パターン・傾向を2〜3個&quot;],
    &quot;level3_principle&quot;: [&quot;原則・法則を1〜2個&quot;],
    &quot;level4_philosophy&quot;: &quot;本質的な気づき1文&quot;
  },
  &quot;flow_diagram&quot;: [
    {&quot;id&quot;: 1, &quot;label&quot;: &quot;きっかけ&quot;, &quot;content&quot;: &quot;何が起きたか&quot;, &quot;type&quot;: &quot;trigger&quot;},
    {&quot;id&quot;: 2, &quot;label&quot;: &quot;行動&quot;, &quot;content&quot;: &quot;何をしたか&quot;, &quot;type&quot;: &quot;action&quot;},
    {&quot;id&quot;: 3, &quot;label&quot;: &quot;結果&quot;, &quot;content&quot;: &quot;どうなったか&quot;, &quot;type&quot;: &quot;result&quot;},
    {&quot;id&quot;: 4, &quot;label&quot;: &quot;学び&quot;, &quot;content&quot;: &quot;何を得たか&quot;, &quot;type&quot;: &quot;learning&quot;},
    {&quot;id&quot;: 5, &quot;label&quot;: &quot;次のアクション&quot;, &quot;content&quot;: &quot;次に何をするか&quot;, &quot;type&quot;: &quot;next&quot;}
  ],
  &quot;procedure&quot;: {
    &quot;title&quot;: &quot;業務手順書タイトル&quot;,
    &quot;goal&quot;: &quot;この手順の目標&quot;,
    &quot;steps&quot;: [
      {&quot;step&quot;: 1, &quot;title&quot;: &quot;ステップ名&quot;, &quot;action&quot;: &quot;具体的なアクション&quot;, &quot;tip&quot;: &quot;ポイント&quot;}
    ],
    &quot;checklist&quot;: [&quot;確認項目1&quot;, &quot;確認項目2&quot;]
  },
  &quot;prompts&quot;: [
    {
      &quot;category&quot;: &quot;カテゴリ名&quot;,
      &quot;title&quot;: &quot;プロンプト名&quot;,
      &quot;usecase&quot;: &quot;使用場面&quot;,
      &quot;prompt&quot;: &quot;コピペ用プロンプト本文（{{変数}}形式）&quot;,
      &quot;variables&quot;: {&quot;変数名&quot;: &quot;説明&quot;}
    }
  ],
  &quot;qiita&quot;: {
    &quot;title&quot;: &quot;記事タイトル&quot;,
    &quot;tags&quot;: [&quot;タグ1&quot;, &quot;タグ2&quot;, &quot;タグ3&quot;],
    &quot;summary&quot;: &quot;要約2〜3文&quot;,
    &quot;body&quot;: &quot;Markdown本文（800字程度）&quot;
  }
}`;

var typeStyles = {
  trigger: { bg:&quot;#fef3c7&quot;, border:&quot;#f59e0b&quot;, icon:&quot;⚡&quot; },
  action:  { bg:&quot;#dbeafe&quot;, border:&quot;#3b82f6&quot;, icon:&quot;🎯&quot; },
  result:  { bg:&quot;#d1fae5&quot;, border:&quot;#10b981&quot;, icon:&quot;📊&quot; },
  learning:{ bg:&quot;#ede9fe&quot;, border:&quot;#8b5cf6&quot;, icon:&quot;💡&quot; },
  next:    { bg:&quot;#fce7f3&quot;, border:&quot;#ec4899&quot;, icon:&quot;🚀&quot; }
};
var FIELDS=[
  { key:&quot;good&quot;,    label:&quot;✅ よかったこと（グッド）&quot;,           color:&quot;#10b981&quot;, ph:&quot;例：チームとの認識合わせがうまくいった&quot; },
  { key:&quot;bad&quot;,     label:&quot;❌ うまくいかなかったこと（バッド）&quot;, color:&quot;#ef4444&quot;, ph:&quot;例：見積もりが甘くて時間が足りなかった&quot; },
  { key:&quot;learned&quot;, label:&quot;💡 今日学んだこと&quot;,                   color:&quot;#f59e0b&quot;, ph:&quot;例：SQLのEXPLAINの読み方&quot; },
  { key:&quot;tried&quot;,   label:&quot;🚀 今日の取り組み&quot;,                   color:&quot;#8b5cf6&quot;, ph:&quot;例：新しいAIツールを試した&quot; }
];
var form={good:&quot;&quot;,bad:&quot;&quot;,learned:&quot;&quot;,tried:&quot;&quot;};
var result=null, tab=&quot;input&quot;, viewTab=&quot;diagram&quot;;

function $(id){ return document.getElementById(id); }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function setErr(msg){ var e=$(&quot;errBox&quot;); if(!e)return; if(msg){ e.textContent=msg; e.style.display=&quot;block&quot;; } else { e.style.display=&quot;none&quot;; } }

function buildUserMsg(){
  return [&quot;## 今日の振り返り&quot;,
    &quot;【よかったこと】&quot;+(form.good||&quot;なし&quot;),
    &quot;【うまくいかなかったこと】&quot;+(form.bad||&quot;なし&quot;),
    &quot;【学んだこと】&quot;+(form.learned||&quot;なし&quot;),
    &quot;【取り組んだこと】&quot;+(form.tried||&quot;なし&quot;)].join(&quot;\n&quot;);
}

function renderForm(){
  var g=$(&quot;formGrid&quot;); g.innerHTML=&quot;&quot;;
  FIELDS.forEach(function(f){
    var box=document.createElement(&quot;div&quot;);
    box.className=&quot;card&quot;;
    box.style.cssText=&quot;border-left:3px solid &quot;+f.color+&quot;;padding:14px;&quot;;
    box.innerHTML='<label style=&quot;display:block;font-size:12px;font-weight:700;color:'+f.color+';margin-bottom:6px;&quot;>'+f.label+'</label>'+
      '<textarea data-k=&quot;'+f.key+'&quot; placeholder=&quot;'+esc(f.ph)+'&quot; style=&quot;min-height:90px;resize:vertical;&quot;></textarea>';
    var ta=box.querySelector(&quot;textarea&quot;);
    ta.value=form[f.key];
    ta.addEventListener(&quot;input&quot;, function(){ form[f.key]=ta.value; });
    g.appendChild(box);
  });
  var tags=$(&quot;genTags&quot;); tags.innerHTML=&quot;&quot;;
  [&quot;📊 具体⇔抽象4段階&quot;,&quot;🔀 フロー図解&quot;,&quot;📋 業務手順書&quot;,&quot;📎 プロンプト集&quot;,&quot;📄 Markdown記事&quot;].forEach(function(t){
    var s=document.createElement(&quot;span&quot;);
    s.style.cssText=&quot;background:rgba(139,92,246,.15);border:1px solid rgba(139,92,246,.3);border-radius:20px;padding:3px 11px;font-size:11px;color:#c4b5fd;&quot;;
    s.textContent=t; tags.appendChild(s);
  });
}

function setTab(t){
  tab=t;
  $(&quot;tt-input&quot;).classList.toggle(&quot;active&quot;, t===&quot;input&quot;);
  $(&quot;tt-result&quot;).classList.toggle(&quot;active&quot;, t===&quot;result&quot;);
  $(&quot;view-input&quot;).style.display = t===&quot;input&quot;?&quot;block&quot;:&quot;none&quot;;
  $(&quot;view-result&quot;).style.display = t===&quot;result&quot;?&quot;block&quot;:&quot;none&quot;;
  if(t===&quot;result&quot;) renderResult();
}

function importJson(){
  setErr(&quot;&quot;);
  try{
    var m=$(&quot;pasteJson&quot;).value.match(/\{[\s\S]*\}/); if(!m) throw new Error(&quot;JSONが見つかりません&quot;);
    result=JSON.parse(m[0]); setTab(&quot;result&quot;);
  }catch(e){ setErr(&quot;JSONの取り込みに失敗: &quot;+e.message); }
}

function copyToClip(text){
  function fall(){
    var el=document.createElement(&quot;textarea&quot;); el.value=text; el.style.cssText=&quot;position:fixed;top:-9999px;opacity:0&quot;;
    document.body.appendChild(el); el.focus(); el.select(); try{document.execCommand(&quot;copy&quot;);}catch(e){} document.body.removeChild(el);
  }
  if(navigator.clipboard &amp;&amp; navigator.clipboard.writeText){ navigator.clipboard.writeText(text).catch(fall); } else { fall(); }
}
function copyManual(){
  copyToClip(SYSTEM_PROMPT+&quot;\n\n---\n\n&quot;+buildUserMsg());
  var b=$(&quot;manualBtn&quot;); var o=b.textContent; b.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ b.textContent=o; },2000);
}
function copyBtn(btn, text){
  copyToClip(text); var o=btn.textContent; btn.textContent=&quot;✅ コピー済み&quot;; setTimeout(function(){ btn.textContent=o; },2000);
}

var SUBTABS=[[&quot;diagram&quot;,&quot;🔀 フロー&quot;],[&quot;abstract&quot;,&quot;📐 具体⇔抽象&quot;],[&quot;procedure&quot;,&quot;📋 手順書&quot;],[&quot;prompts&quot;,&quot;📎 プロンプト集&quot;],[&quot;qiita&quot;,&quot;📄 記事&quot;]];
function renderResult(){
  if(!result){ $(&quot;resultEmpty&quot;).style.display=&quot;block&quot;; $(&quot;resultBody&quot;).style.display=&quot;none&quot;; return; }
  $(&quot;resultEmpty&quot;).style.display=&quot;none&quot;; $(&quot;resultBody&quot;).style.display=&quot;block&quot;;
  var st=$(&quot;subtabs&quot;); st.innerHTML=&quot;&quot;;
  SUBTABS.forEach(function(p){
    var b=document.createElement(&quot;button&quot;);
    b.className=&quot;btn subtab&quot;+(viewTab===p[0]?&quot; active&quot;:&quot;&quot;); b.textContent=p[1];
    b.onclick=function(){ viewTab=p[0]; renderResult(); };
    st.appendChild(b);
  });
  var v=$(&quot;resultView&quot;); v.innerHTML=renderView();
  [].slice.call(v.querySelectorAll(&quot;[data-copy]&quot;)).forEach(function(b){
    b.addEventListener(&quot;click&quot;, function(){ copyBtn(b, decodeURIComponent(b.getAttribute(&quot;data-copy&quot;))); });
  });
}
function card(inner){ return '<div class=&quot;card&quot;>'+inner+'</div>'; }
function renderView(){
  if(viewTab===&quot;diagram&quot;) return viewDiagram();
  if(viewTab===&quot;abstract&quot;) return viewAbstract();
  if(viewTab===&quot;procedure&quot;) return viewProcedure();
  if(viewTab===&quot;prompts&quot;) return viewPrompts();
  if(viewTab===&quot;qiita&quot;) return viewQiita();
  return &quot;&quot;;
}
function viewDiagram(){
  var fd=result.flow_diagram||[];
  var h='<h3 style=&quot;margin:0 0 18px;font-size:15px;color:#94a3b8;font-weight:700;&quot;>🔀 業務フロー図解</h3>';
  h+='<div style=&quot;display:flex;align-items:stretch;overflow-x:auto;padding-bottom:8px;&quot;>';
  fd.forEach(function(node,i){
    var s=typeStyles[node.type]||{bg:&quot;#f1f5f9&quot;,border:&quot;#64748b&quot;,icon:&quot;●&quot;};
    h+='<div style=&quot;display:flex;align-items:center;flex:0 0 auto;&quot;>'+
       '<div style=&quot;width:150px;background:'+s.bg+';border:2px solid '+s.border+';border-radius:12px;padding:12px;text-align:center;&quot;>'+
       '<div style=&quot;font-size:18px;margin-bottom:3px;&quot;>'+s.icon+'</div>'+
       '<div style=&quot;font-size:11px;font-weight:700;color:'+s.border+';margin-bottom:5px;&quot;>'+esc(node.label)+'</div>'+
       '<div style=&quot;font-size:11px;color:#334155;line-height:1.5;&quot;>'+esc(node.content)+'</div></div>'+
       (i<fd.length-1?'<div style=&quot;padding:0 5px;color:#64748b;font-size:18px;&quot;>→</div>':'')+'</div>';
  });
  h+='</div>';
  return h;
}
function viewAbstract(){
  var levels=[
    {key:&quot;level1_concrete&quot;,label:&quot;Lv.1 具体&quot;,desc:&quot;実際の出来事・行動&quot;,color:&quot;#10b981&quot;,icon:&quot;🔍&quot;},
    {key:&quot;level2_pattern&quot;,label:&quot;Lv.2 パターン&quot;,desc:&quot;傾向・繰り返し&quot;,color:&quot;#3b82f6&quot;,icon:&quot;🔄&quot;},
    {key:&quot;level3_principle&quot;,label:&quot;Lv.3 原則&quot;,desc:&quot;法則・ルール&quot;,color:&quot;#8b5cf6&quot;,icon:&quot;⚖️&quot;},
    {key:&quot;level4_philosophy&quot;,label:&quot;Lv.4 本質&quot;,desc:&quot;根本的な気づき&quot;,color:&quot;#ec4899&quot;,icon:&quot;✨&quot;}
  ];
  var al=result.abstract_level||{};
  var h='<h3 style=&quot;margin:0 0 18px;font-size:15px;color:#94a3b8;font-weight:700;&quot;>📐 具体⇔抽象 4段階マッピング</h3>';
  levels.forEach(function(L){
    var d=al[L.key]; var items=Array.isArray(d)?d:(d?[d]:[]);
    h+='<div style=&quot;display:flex;gap:14px;margin-bottom:10px;align-items:flex-start;&quot;>'+
       '<div style=&quot;width:110px;flex:0 0 110px;text-align:right;&quot;><div style=&quot;font-size:11px;font-weight:700;color:'+L.color+';&quot;>'+L.icon+' '+L.label+'</div>'+
       '<div style=&quot;font-size:10px;color:#64748b;&quot;>'+L.desc+'</div></div>'+
       '<div style=&quot;width:3px;background:linear-gradient(to bottom,'+L.color+',rgba(255,255,255,.1));border-radius:2px;min-height:36px;align-self:stretch;&quot;></div>'+
       '<div style=&quot;flex:1;display:flex;flex-direction:column;gap:5px;&quot;>';
    items.forEach(function(it){ h+='<div style=&quot;background:'+L.color+'18;border:1px solid '+L.color+'40;border-radius:8px;padding:8px 12px;font-size:12px;color:#e2e8f0;line-height:1.6;&quot;>'+esc(it)+'</div>'; });
    h+='</div></div>';
  });
  return h;
}
function viewProcedure(){
  var p=result.procedure; if(!p) return '<p style=&quot;color:#64748b;&quot;>手順書データがありません</p>';
  var md=&quot;# &quot;+p.title+&quot;\n\n目標: &quot;+p.goal+&quot;\n\n## 手順\n&quot;+(p.steps||[]).map(function(s){return &quot;### Step&quot;+s.step+&quot;: &quot;+s.title+&quot;\n&quot;+s.action+&quot;\n💡 &quot;+s.tip;}).join(&quot;\n\n&quot;)+&quot;\n\n## チェックリスト\n&quot;+(p.checklist||[]).map(function(c){return &quot;- [ ] &quot;+c;}).join(&quot;\n&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;&quot;>'+
        '<h3 style=&quot;margin:0;font-size:15px;color:#94a3b8;font-weight:700;&quot;>📋 業務手順書</h3>'+
        '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(md)+'&quot; style=&quot;background:rgba(16,185,129,.2);border:1px solid #10b981;border-radius:8px;padding:5px 13px;color:#6ee7b7;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  var inner='<h4 style=&quot;margin:0 0 4px;color:#a78bfa;font-size:17px;&quot;>'+esc(p.title)+'</h4><p style=&quot;margin:0 0 18px;color:#64748b;font-size:12px;&quot;>🎯 '+esc(p.goal)+'</p>';
  (p.steps||[]).forEach(function(s){
    inner+='<div style=&quot;display:flex;gap:14px;margin-bottom:14px;align-items:flex-start;&quot;>'+
      '<div style=&quot;width:32px;height:32px;background:linear-gradient(135deg,#7c3aed,#db2777);border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:13px;flex:0 0 32px;&quot;>'+esc(s.step)+'</div>'+
      '<div><div style=&quot;font-weight:700;font-size:13px;color:#e2e8f0;margin-bottom:3px;&quot;>'+esc(s.title)+'</div>'+
      '<div style=&quot;font-size:12px;color:#94a3b8;margin-bottom:3px;&quot;>'+esc(s.action)+'</div>'+
      (s.tip?'<div style=&quot;font-size:11px;color:#f59e0b;background:rgba(245,158,11,.1);border-radius:6px;padding:3px 9px;&quot;>💡 '+esc(s.tip)+'</div>':'')+'</div></div>';
  });
  if(p.checklist&amp;&amp;p.checklist.length){
    inner+='<div style=&quot;border-top:1px solid rgba(255,255,255,.08);padding-top:14px;margin-top:6px;&quot;><p style=&quot;margin:0 0 7px;font-size:12px;font-weight:700;color:#64748b;&quot;>✅ チェックリスト</p>';
    p.checklist.forEach(function(c){ inner+='<div style=&quot;display:flex;gap:7px;align-items:center;margin-bottom:5px;&quot;><div style=&quot;width:14px;height:14px;border:2px solid #8b5cf6;border-radius:4px;flex:0 0 14px;&quot;></div><span style=&quot;font-size:12px;color:#94a3b8;&quot;>'+esc(c)+'</span></div>'; });
    inner+='</div>';
  }
  return h+card(inner);
}
function viewPrompts(){
  var ps=result.prompts||[];
  var h='<h3 style=&quot;margin:0 0 18px;font-size:15px;color:#94a3b8;font-weight:700;&quot;>📎 コピペで使えるAIプロンプト集</h3><div style=&quot;display:flex;flex-direction:column;gap:14px;&quot;>';
  ps.forEach(function(p){
    var vars=&quot;&quot;;
    if(p.variables){ Object.keys(p.variables).forEach(function(k){ vars+='<span style=&quot;background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.3);border-radius:6px;padding:2px 7px;font-size:10px;color:#fbbf24;&quot;>{{'+esc(k)+'}}: '+esc(p.variables[k])+'</span>'; }); }
    h+=card(
      '<div style=&quot;display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;&quot;>'+
      '<div><span style=&quot;background:rgba(139,92,246,.2);border:1px solid rgba(139,92,246,.4);border-radius:20px;padding:2px 9px;font-size:10px;color:#a78bfa;margin-right:7px;&quot;>'+esc(p.category)+'</span>'+
      '<span style=&quot;font-weight:700;font-size:14px;color:#e2e8f0;&quot;>'+esc(p.title)+'</span></div>'+
      '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(p.prompt||&quot;&quot;)+'&quot; style=&quot;background:rgba(139,92,246,.2);border:1px solid #8b5cf6;border-radius:8px;padding:5px 12px;color:#c4b5fd;font-size:11px;cursor:pointer;font-weight:600;white-space:nowrap;&quot;>📋 コピー</button></div>'+
      '<p style=&quot;margin:0 0 8px;font-size:11px;color:#64748b;&quot;>🎯 '+esc(p.usecase)+'</p>'+
      '<div style=&quot;background:rgba(0,0,0,.3);border-radius:8px;padding:12px;font-family:monospace;font-size:11px;color:#a5f3fc;line-height:1.8;white-space:pre-wrap;word-break:break-word;&quot;>'+esc(p.prompt)+'</div>'+
      (vars?'<div style=&quot;margin-top:8px;display:flex;flex-wrap:wrap;gap:5px;&quot;>'+vars+'</div>':'')
    );
  });
  h+='</div>';
  return h;
}
function viewQiita(){
  var q=result.qiita; if(!q) return '<p style=&quot;color:#64748b;&quot;>記事データがありません</p>';
  var md=&quot;---\ntitle: &quot;+q.title+&quot;\ntags: &quot;+((q.tags||[]).join(&quot;, &quot;))+&quot;\n---\n\n&quot;+q.body;
  var tags=(q.tags||[]).map(function(t){return '<span style=&quot;background:rgba(52,211,153,.15);border:1px solid rgba(52,211,153,.3);border-radius:4px;padding:2px 7px;font-size:11px;color:#6ee7b7;&quot;>#'+esc(t)+'</span>';}).join(&quot;&quot;);
  var h='<div style=&quot;display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;&quot;>'+
        '<h3 style=&quot;margin:0;font-size:15px;color:#94a3b8;font-weight:700;&quot;>📄 Markdown記事</h3>'+
        '<button class=&quot;btn&quot; data-copy=&quot;'+encodeURIComponent(md)+'&quot; style=&quot;background:rgba(16,185,129,.2);border:1px solid #10b981;border-radius:8px;padding:5px 13px;color:#6ee7b7;font-size:12px;cursor:pointer;font-weight:600;&quot;>📋 コピー</button></div>';
  var inner='<h2 style=&quot;margin:0 0 10px;color:#f0f0f0;font-size:18px;font-weight:900;line-height:1.4;&quot;>'+esc(q.title)+'</h2>'+
    '<div style=&quot;display:flex;gap:5px;flex-wrap:wrap;margin-bottom:14px;&quot;>'+tags+'</div>'+
    '<div style=&quot;background:rgba(0,0,0,.2);border-radius:8px;padding:10px;margin-bottom:14px;border-left:3px solid #8b5cf6;&quot;><p style=&quot;margin:0;font-size:12px;color:#94a3b8;line-height:1.6;&quot;>'+esc(q.summary)+'</p></div>'+
    '<pre style=&quot;margin:0;white-space:pre-wrap;word-break:break-word;font-size:12px;color:#cbd5e1;line-height:1.9;font-family:\'Noto Sans JP\',sans-serif;&quot;>'+esc(q.body)+'</pre>';
  return h+card(inner);
}

renderForm();
setTab(&quot;input&quot;);
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-intake" title="業務受領" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 業務受領ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;}
  :root{ --radius:14px; }
  body.theme-jp{
    --paper:#ffffff; --cream:#eef6f3; --cream2:#e0efe9; --ink:#1f3a33; --ink-soft:#566b64;
    --line:#cfe6dd; --line-soft:#e4f1ec; --ok:#3f8f5f; --ng:#d24b4b;
    --accent:#138a72; --accent-deep:#0d6253; --gold:#5fb39c; --gold-soft:#bfe3d8;
    --shadow:0 10px 30px rgba(19,138,114,.13);
  }
  body{margin:0;font-family:&quot;Hiragino Sans&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;color:var(--ink);
    background:linear-gradient(160deg,#dceee8,var(--cream) 42%);min-height:100vh;line-height:1.7;}
  .wrap{max-width:980px;margin:0 auto;padding:18px 16px 80px;}
  header.hero{position:relative;margin-top:24px;background:var(--paper);border:1px solid var(--line);
    border-radius:22px;padding:24px 28px;box-shadow:var(--shadow);overflow:hidden;}
  header.hero::before{content:&quot;&quot;;position:absolute;inset:0 0 auto 0;height:6px;
    background:linear-gradient(90deg,var(--gold-soft),var(--accent),var(--gold));}
  header.hero h1{margin:0 0 6px;font-size:1.34rem;font-weight:800;padding-right:46px;}
  header.hero p{margin:0;color:var(--ink-soft);font-size:.9rem;padding-right:46px;}
  .ver-badge{display:flex;gap:8px;align-items:center;margin:0 0 8px;flex-wrap:wrap;}
  .ver-pill{display:inline-block;background:var(--accent);color:#fff;font-weight:800;font-size:.72rem;
    letter-spacing:.3px;padding:2px 9px;border-radius:999px;}
  .ver-date,.ver-today{color:var(--ink-soft);font-size:.74rem;}
  .ver-today:not(:empty)::before{content:&quot;｜ 今日 &quot;;opacity:.8;}
  .bunny{position:absolute;top:16px;right:20px;font-size:28px;filter:drop-shadow(0 4px 8px rgba(19,138,114,.25));}
  .lang-switch{display:none;}

  .tabs{display:flex;gap:8px;margin:16px 0;flex-wrap:wrap;}
  .tab{flex:1 1 auto;min-width:130px;text-align:center;cursor:pointer;border:1px solid var(--line);
    background:var(--paper);border-radius:12px;padding:9px 11px;font-weight:700;font-size:.86rem;color:var(--ink-soft);
    box-shadow:0 2px 5px rgba(0,0,0,.05);transition:transform .08s,box-shadow .12s,background .12s;}
  .tab:hover{transform:translateY(-1px);box-shadow:0 4px 10px rgba(0,0,0,.1);}
  .tab:active{transform:translateY(1px) scale(.99);}
  .tab.active{background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;border-color:transparent;}

  .panel{display:none;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);
    padding:20px;box-shadow:var(--shadow);}
  .panel.active{display:block;}
  h2{font-size:1.1rem;margin:0 0 6px;}
  h3{font-size:.96rem;margin:16px 0 6px;color:var(--accent-deep);}
  label{display:block;font-size:.8rem;font-weight:700;color:var(--ink-soft);margin:8px 0 3px;}
  input,select,textarea{width:100%;border:1px solid var(--line);border-radius:9px;padding:8px 10px;
    font-size:.92rem;font-family:inherit;color:var(--ink);background:var(--paper);}
  textarea{min-height:60px;resize:vertical;}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .hint{font-size:.78rem;color:var(--ink-soft);margin:4px 0 0;}
  code{background:var(--cream2);padding:1px 5px;border-radius:5px;font-size:.86em;}

  /* 使い方セクション */
  .howto{background:var(--cream2);border:1px solid var(--line);border-left:5px solid var(--accent);
    border-radius:10px;padding:10px 14px;margin:0 0 14px;font-size:.84rem;color:var(--ink-soft);}
  .howto b{color:var(--accent-deep);}
  .howto ol{margin:6px 0 0;padding-left:20px;}
  .howto li{margin:2px 0;}

  button{transition:transform .08s,box-shadow .12s,filter .12s,background .12s;}
  .gen{margin-top:18px;width:100%;background:linear-gradient(135deg,var(--accent),var(--accent-deep));
    color:#fff;border:none;border-radius:12px;padding:13px;font-size:1rem;font-weight:800;cursor:pointer;
    box-shadow:0 2px 5px rgba(0,0,0,.12);}
  .gen:hover{box-shadow:0 4px 10px rgba(0,0,0,.16);transform:translateY(-1px);}
  .gen:active{transform:translateY(1px) scale(.99);box-shadow:inset 0 3px 6px rgba(0,0,0,.2);}
  .addbtn{margin-top:8px;background:var(--cream2);border:1px dashed var(--accent);color:var(--accent-deep);
    border-radius:9px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.84rem;box-shadow:0 2px 5px rgba(0,0,0,.05);}
  .addbtn:hover{transform:translateY(-1px);}
  .addbtn:active{transform:translateY(1px) scale(.99);}
  .del{background:#fff;border:1px solid var(--line);color:var(--ng);border-radius:8px;padding:6px 9px;cursor:pointer;font-weight:700;}
  .row{display:flex;gap:8px;align-items:flex-start;margin:6px 0;}
  .row>*{margin:0;}

  .outwrap{margin-top:18px;background:var(--cream2);border:1px solid var(--line);border-radius:12px;padding:14px;}
  .outwrap h3{margin-top:0;}
  pre.out{white-space:pre-wrap;word-break:break-word;background:var(--paper);border:1px solid var(--line);
    border-radius:9px;padding:12px;font-size:.86rem;max-height:420px;overflow:auto;font-family:inherit;}
  .outbtns{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
  .outbtns button{border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:10px;
    padding:8px 12px;cursor:pointer;font-weight:700;font-size:.84rem;box-shadow:0 2px 5px rgba(0,0,0,.05);}
  .outbtns button:hover{transform:translateY(-1px);}
  .outbtns button:active{transform:translateY(1px) scale(.99);}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;
    padding:10px 18px;border-radius:999px;font-size:.86rem;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50;}
  .toast.show{opacity:.95;}
  .checks label{display:flex;align-items:center;gap:8px;font-weight:600;color:var(--ink);}
  .checks input{width:auto;}
  @media (max-width:560px){ .grid{grid-template-columns:1fr;} header.hero h1{padding-top:30px;padding-right:0;} }
</style>
</head>
<body class=&quot;theme-jp&quot;>
<div class=&quot;wrap&quot;>
  <header class=&quot;hero&quot;>
    <div class=&quot;bunny&quot;>🐰</div>
    <h1>うさうさ 業務受領ジェネレーター</h1>
    <div class=&quot;ver-badge&quot;><span class=&quot;ver-pill&quot;>v1.0</span><span class=&quot;ver-date&quot;>2026-05-22</span><span class=&quot;ver-today&quot; id=&quot;ver_today&quot;></span></div>
    <p>研修・開発の業務をメイン講師から受領するときの「認識合わせ」を支援します。役割分担・完了条件・教育設計までまとめて整理。データは端末内のみ・外部送信なし。</p>
  </header>

  <div class=&quot;tabs&quot; id=&quot;tabs&quot;>
    <div class=&quot;tab active&quot; data-tab=&quot;intake&quot;>📥 業務受領</div>
    <div class=&quot;tab&quot; data-tab=&quot;role&quot;>👥 役割分担</div>
    <div class=&quot;tab&quot; data-tab=&quot;dod&quot;>✅ 完了条件</div>
    <div class=&quot;tab&quot; data-tab=&quot;design&quot;>🎓 教育設計</div>
    <div class=&quot;tab&quot; data-tab=&quot;handoff&quot;>🤝 引き継ぎ確認</div>
    <div class=&quot;tab&quot; data-tab=&quot;hub&quot;>🗂 データ統合</div>
  </div>

  <!-- 業務受領 -->
  <div class=&quot;panel active&quot; id=&quot;panel-intake&quot;>
    <h2>業務受領（クライアント → メイン講師 → サブ講師）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>業務名・受領日を埋める</li>
      <li>受け渡しの流れ（クライアント→メイン講師→サブ講師）の登場人物と、各段で受けた依頼内容を埋める</li>
      <li>下の「受領項目」に、自分（サブ講師）が実際にやること・成果物を1行ずつ追加</li>
      <li>「業務受領メモを生成する」で、2段階の流れが分かる認識合わせ文面ができます</li>
    </ol></div>
    <div class=&quot;grid&quot;>
      <div><label>業務名・テーマ</label><input id=&quot;in_title&quot; placeholder=&quot;新卒研修 LinuC Level1 応用クラス&quot;></div>
      <div><label>受領日（空なら今日）</label><input id=&quot;in_date&quot; placeholder=&quot;2026/05/22（金）&quot;></div>
    </div>

    <h3>① クライアント → メイン講師</h3>
    <div class=&quot;grid&quot;>
      <div><label>クライアント（発注元）</label><input id=&quot;in_client&quot; placeholder=&quot;株式会社〇〇 人事部&quot;></div>
      <div><label>メイン講師（受注・統括）</label>
        <select id=&quot;in_main&quot; onchange=&quot;syncMain2()&quot;></select>
        <div style=&quot;display:flex;gap:6px;margin-top:6px;&quot;>
          <input id=&quot;in_main_new&quot; placeholder=&quot;新しいメイン講師名を登録&quot; style=&quot;flex:1;&quot;>
          <button type=&quot;button&quot; class=&quot;addbtn&quot; style=&quot;margin:0;white-space:nowrap;&quot; onclick=&quot;addMainTeacher()&quot;>＋登録</button>
        </div>
      </div>
    </div>
    <div><label>クライアントからの依頼内容（メイン講師が受けたこと）</label><textarea id=&quot;in_client_req&quot; placeholder=&quot;新卒エンジニアにLinuxの実務基礎を5日間で習得させたい&quot;></textarea></div>

    <h3>② メイン講師 → サブ講師</h3>
    <div class=&quot;grid&quot;>
      <div><label>メイン講師（依頼者）</label><select id=&quot;in_main2&quot;></select></div>
      <div><label>サブ講師（自分）</label><input id=&quot;in_sub&quot; placeholder=&quot;石黒 友季子&quot;></div>
    </div>
    <div><label>メイン講師からの依頼内容（自分が受けたこと）</label><textarea id=&quot;in_main_req&quot; placeholder=&quot;応用クラスの教材作成と演習サポートを担当してほしい&quot;></textarea></div>

    <div class=&quot;grid&quot;>
      <div><label>背景・目的（なぜこの業務か）</label><textarea id=&quot;in_bg&quot; placeholder=&quot;文系出身の新人が現場で困らないようLinuxの基礎を固める&quot;></textarea></div>
      <div><label>期日・スケジュール</label><textarea id=&quot;in_due&quot; placeholder=&quot;教材レビュー 5/28／本番 6/2〜6/6&quot;></textarea></div>
    </div>
    <h3>受領項目（自分がやること・成果物）</h3>
    <div id=&quot;inList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;inAdd()&quot;>＋ 受領項目を追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildIntake()&quot;>業務受領メモを生成する</button>
  </div>

  <!-- 役割分担 -->
  <div class=&quot;panel&quot; id=&quot;panel-role&quot;>
    <h2>役割分担（メイン講師／サブ講師）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>項目ごとに、担当が「メイン／サブ／両方」のどれかを選ぶ</li>
      <li>定番ボタンで、講師業務の典型的な分担を一括で入れられます</li>
      <li>「役割分担表を生成する」で、責任範囲がはっきりします</li>
    </ol></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;roleTemplate()&quot;>👥 講師業務の定番分担を入れる</button>
    <h3>分担項目</h3>
    <div id=&quot;roleList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;roleAdd()&quot;>＋ 項目を追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildRole()&quot;>役割分担表を生成する</button>
  </div>

  <!-- 完了条件 -->
  <div class=&quot;panel&quot; id=&quot;panel-dod&quot;>
    <h2>完了条件（Definition of Done）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>「何をもって完了とするか」を1行ずつ、確認できる形で書く</li>
      <li>定番ボタンで、研修業務の典型的な完了条件を入れられます</li>
      <li>達成チェックを付けて「完了条件表を生成する」</li>
    </ol></div>
    <div><label>対象（成果物・業務）</label><input id=&quot;dod_target&quot; placeholder=&quot;LinuC応用クラスの教材一式&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;dodTemplate()&quot;>✅ 研修の定番完了条件を入れる</button>
    <h3>完了条件</h3>
    <div id=&quot;dodList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;dodAdd()&quot;>＋ 完了条件を追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildDod()&quot;>完了条件表を生成する</button>
  </div>

  <!-- 教育設計 -->
  <div class=&quot;panel&quot; id=&quot;panel-design&quot;>
    <h2>教育設計（学習目標・カリキュラム）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>対象者と、研修後に「できるようになること（学習目標）」を決める</li>
      <li>WHY→WHAT→HOW を意識して、コマ（カリキュラム）を組む</li>
      <li>「教育設計書を生成する」で、研修の設計図ができます</li>
    </ol></div>
    <div class=&quot;grid&quot;>
      <div><label>研修名</label><input id=&quot;de_title&quot; placeholder=&quot;LinuC Level1 応用クラス&quot;></div>
      <div><label>対象者（前提知識）</label><input id=&quot;de_target&quot; placeholder=&quot;文系出身の新卒・Linux未経験&quot;></div>
    </div>
    <div><label>学習目標（研修後にできること・1行ずつ）</label><textarea id=&quot;de_goal&quot; placeholder=&quot;基本的なコマンドでファイル操作ができる&amp;#10;権限とプロセスの考え方を説明できる&quot;></textarea></div>
    <div class=&quot;grid&quot;>
      <div><label>評価方法</label><input id=&quot;de_eval&quot; placeholder=&quot;筆記試験＋実機演習＋口頭試問&quot;></div>
      <div><label>所要（日数・コマ数）</label><input id=&quot;de_time&quot; placeholder=&quot;5日間／1日6コマ&quot;></div>
    </div>
    <h3>カリキュラム（コマ単位／WHY→WHAT→HOW）</h3>
    <div id=&quot;deList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;deAdd()&quot;>＋ コマを追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildDesign()&quot;>教育設計書を生成する</button>
  </div>

  <!-- 引き継ぎ確認 -->
  <div class=&quot;panel&quot; id=&quot;panel-handoff&quot;>
    <h2>引き継ぎ確認（認識合わせ）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>メイン講師との認識合わせ観点をチェックする</li>
      <li>定番ボタンで、確認すべき観点を一括で入れられます</li>
      <li>OK/未確認をつけて「認識合わせ表を生成する」</li>
    </ol></div>
    <div class=&quot;grid&quot;>
      <div><label>確認相手（メイン講師）</label><input id=&quot;ho_with&quot; placeholder=&quot;メイン講師名を入力&quot;></div>
      <div><label>確認者（自分）</label><input id=&quot;ho_by&quot; placeholder=&quot;石黒 友季子&quot;></div>
    </div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;hoTemplate()&quot;>🤝 定番の確認観点を入れる</button>
    <h3>確認観点</h3>
    <div id=&quot;hoList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;hoAdd()&quot;>＋ 観点を追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildHandoff()&quot;>認識合わせ表を生成する</button>
  </div>

  <!-- データ統合 -->
  <div class=&quot;panel&quot; id=&quot;panel-hub&quot;>
    <h2>データ統合（保存・書き出し・取り込み）</h2>
    <div class=&quot;howto&quot;>💡 <b>使い方</b><ol>
      <li>「JSON保存」で全タブの入力を1ファイルに保存</li>
      <li>「JSON取り込み」で保存した内容を復元</li>
      <li>完了条件・確認観点は「Excel出力」で表にできます</li>
    </ol></div>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;hubSaveJson()&quot;>💾 全データをJSON保存</button>
      <button onclick=&quot;document.getElementById('hubFile').click()&quot;>📂 JSONを取り込む</button>
      <input type=&quot;file&quot; id=&quot;hubFile&quot; accept=&quot;.json&quot; style=&quot;display:none&quot; onchange=&quot;hubLoadJson(this)&quot;>
      <button onclick=&quot;dodExportXlsx()&quot;>📊 完了条件をExcel出力</button>
      <button onclick=&quot;hubClearAll()&quot;>🗑 全クリア</button>
    </div>
    <p class=&quot;hint&quot;>保存したJSONはこのツールでのみ復元できます。大事なデータはこまめに保存してください。</p>
  </div>

  <!-- 出力 -->
  <div class=&quot;outwrap&quot;>
    <h3>生成結果</h3>
    <pre class=&quot;out&quot; id=&quot;out&quot;>ここに生成結果が表示されます。各タブの「生成する」を押してください。</pre>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;copyOut()&quot;>📋 コピー</button>
      <button onclick=&quot;downloadOut('txt')&quot;>📄 テキスト保存</button>
      <button onclick=&quot;downloadOut('md')&quot;>📝 Markdown保存</button>
      <button onclick=&quot;clearOut()&quot;>クリア</button>
    </div>
  </div>
</div>
<div class=&quot;toast&quot; id=&quot;toast&quot;></div>
<script>
&quot;use strict&quot;;
function $(id){ return document.getElementById(id); }
function v(id){ var el=$(id); return el?(el.value||&quot;&quot;).trim():&quot;&quot;; }
function esc(s){ return (s||&quot;&quot;).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function lines(s){ return (s||&quot;&quot;).split(/\n+/).map(function(x){return x.trim();}).filter(Boolean); }
function toast(m){ var t=$(&quot;toast&quot;); if(!t)return; t.textContent=m; t.classList.add(&quot;show&quot;); setTimeout(function(){t.classList.remove(&quot;show&quot;);},1600); }
function lsAvailable(){ try{ var k=&quot;__t&quot;+Math.random(); window.localStorage.setItem(k,&quot;1&quot;); window.localStorage.removeItem(k); return true; }catch(e){ return false; } }
function nowParts(){
  var d=new Date(), wd=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var mm=(&quot;0&quot;+(d.getMonth()+1)).slice(-2), dd=(&quot;0&quot;+d.getDate()).slice(-2);
  var hh=(&quot;0&quot;+d.getHours()).slice(-2), mi=(&quot;0&quot;+d.getMinutes()).slice(-2);
  return { date:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;）&quot;, time:hh+&quot;:&quot;+mi, datetime:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;） &quot;+hh+&quot;:&quot;+mi };
}
function todayJp(){ return nowParts().date; }
function stamp(){ return nowParts().date.replace(/[^0-9]/g,&quot;&quot;).slice(0,8); }
var BAR=&quot;────────────────────────────&quot;;

var lastOut={txt:&quot;&quot;,md:&quot;&quot;};
function setOut(txt,md){ lastOut.txt=txt||&quot;&quot;; lastOut.md=(md!=null?md:txt)||&quot;&quot;; var o=$(&quot;out&quot;); if(o) o.textContent=lastOut.txt; }
function clearOut(){ setOut(&quot;&quot;); var o=$(&quot;out&quot;); if(o) o.textContent=&quot;&quot;; toast(&quot;クリアしました&quot;); }
function copyOut(){
  var t=lastOut.txt||&quot;&quot;; if(!t){ toast(&quot;生成結果がありません&quot;); return; }
  try{ navigator.clipboard.writeText(t); toast(&quot;コピーしました&quot;); }
  catch(e){ var ta=document.createElement(&quot;textarea&quot;); ta.value=t; document.body.appendChild(ta); ta.select(); try{document.execCommand(&quot;copy&quot;);}catch(_){} document.body.removeChild(ta); toast(&quot;コピーしました&quot;); }
}
function _saveBlob(text,fname,mime){
  try{ var blob=new Blob([text],{type:mime||&quot;text/plain;charset=utf-8&quot;}); var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=fname; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(url);},500); }catch(e){ toast(&quot;保存に失敗しました&quot;); }
}
function downloadOut(fmt){
  if(!lastOut.txt){ toast(&quot;生成結果がありません&quot;); return; }
  if(fmt===&quot;md&quot;){ _saveBlob(lastOut.md,&quot;intake_&quot;+stamp()+&quot;.md&quot;,&quot;text/markdown;charset=utf-8&quot;); }
  else{ _saveBlob(lastOut.txt,&quot;intake_&quot;+stamp()+&quot;.txt&quot;,&quot;text/plain;charset=utf-8&quot;); }
}
function mkRow(html){ var d=document.createElement(&quot;div&quot;); d.className=&quot;row&quot;; d.innerHTML=html; return d; }
function delRow(btn){ var r=btn.closest(&quot;.row&quot;); if(r) r.remove(); }

/* ---- メイン講師プルダウン管理 ---- */
var MAIN_KEY=&quot;usausa_intake_mains&quot;;
var mainTeachers=[];
function loadMains(){
  try{ if(lsAvailable()){ var s=window.localStorage.getItem(MAIN_KEY); if(s) return JSON.parse(s); } }catch(e){}
  return [];
}
function saveMains(){ try{ if(lsAvailable()) window.localStorage.setItem(MAIN_KEY, JSON.stringify(mainTeachers)); }catch(e){} }
function renderMainOptions(){
  var sel1=$(&quot;in_main&quot;), sel2=$(&quot;in_main2&quot;);
  var prev1=sel1?sel1.value:&quot;&quot;, prev2=sel2?sel2.value:&quot;&quot;;
  [sel1,sel2].forEach(function(sel){
    if(!sel) return;
    sel.innerHTML=&quot;&quot;;
    if(!mainTeachers.length){
      var op=document.createElement(&quot;option&quot;); op.value=&quot;&quot;; op.textContent=&quot;（メイン講師を登録してください）&quot;; sel.appendChild(op);
    } else {
      mainTeachers.forEach(function(n){ var op=document.createElement(&quot;option&quot;); op.value=n; op.textContent=n; sel.appendChild(op); });
    }
  });
  if(sel1 &amp;&amp; prev1 &amp;&amp; mainTeachers.indexOf(prev1)>=0) sel1.value=prev1;
  if(sel2 &amp;&amp; prev2 &amp;&amp; mainTeachers.indexOf(prev2)>=0) sel2.value=prev2;
}
function addMainTeacher(){
  var name=v(&quot;in_main_new&quot;);
  if(!name){ toast(&quot;登録する名前を入力してください&quot;); return; }
  if(mainTeachers.indexOf(name)<0){ mainTeachers.push(name); saveMains(); }
  renderMainOptions();
  if($(&quot;in_main&quot;)) $(&quot;in_main&quot;).value=name;
  syncMain2();
  if($(&quot;in_main_new&quot;)) $(&quot;in_main_new&quot;).value=&quot;&quot;;
  toast(&quot;メイン講師「&quot;+name+&quot;」を登録しました&quot;);
}
// ①で選んだメイン講師を②に自動コピー
function syncMain2(){
  var s1=$(&quot;in_main&quot;), s2=$(&quot;in_main2&quot;);
  if(s1 &amp;&amp; s2 &amp;&amp; s1.value){ s2.value=s1.value; }
}

/* ---- 業務受領 ---- */
function inAdd(text,deliv){
  $(&quot;inList&quot;).appendChild(mkRow(
    '<input class=&quot;in-t&quot; placeholder=&quot;やること（例：応用クラスのスライド作成）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;>'+
    '<input class=&quot;in-d&quot; placeholder=&quot;成果物&quot; value=&quot;'+esc(deliv||&quot;&quot;)+'&quot; style=&quot;max-width:38%&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function inRead(){ return [].slice.call(document.querySelectorAll(&quot;#inList .row&quot;)).map(function(r){
  return { t:r.querySelector(&quot;.in-t&quot;).value.trim(), d:r.querySelector(&quot;.in-d&quot;).value.trim() }; }).filter(function(x){return x.t;}); }
function buildIntake(){
  var title=v(&quot;in_title&quot;)||&quot;（無題業務）&quot;, date=v(&quot;in_date&quot;)||todayJp(), items=inRead();
  var client=v(&quot;in_client&quot;)||&quot;—&quot;, main=v(&quot;in_main&quot;)||v(&quot;in_main2&quot;)||&quot;—&quot;, sub=v(&quot;in_sub&quot;)||&quot;—&quot;;
  var o=[];
  o.push(&quot;【業務受領メモ】&quot;+title);
  o.push(&quot;受領日：&quot;+date);
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 受け渡しの流れ&quot;); o.push(BAR);
  o.push(&quot;クライアント（&quot;+client+&quot;）&quot;);
  o.push(&quot;　└→ メイン講師（&quot;+main+&quot;）が受注・統括&quot;);
  o.push(&quot;　　　└→ サブ講師（&quot;+sub+&quot;）＝自分が担当&quot;);
  o.push(&quot;&quot;);
  o.push(&quot;① クライアント → メイン講師の依頼：&quot;);
  o.push(&quot;　&quot;+(v(&quot;in_client_req&quot;)||&quot;—&quot;));
  o.push(&quot;② メイン講師 → サブ講師の依頼：&quot;);
  o.push(&quot;　&quot;+(v(&quot;in_main_req&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;);
  o.push(&quot;背景・目的：&quot;+(v(&quot;in_bg&quot;)||&quot;—&quot;));
  o.push(&quot;期日・スケジュール：&quot;+(v(&quot;in_due&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 自分（サブ講師）が受けた業務&quot;); o.push(BAR);
  if(items.length){ items.forEach(function(x,i){ o.push((i+1)+&quot;. &quot;+x.t+(x.d?(&quot;　→ 成果物：&quot;+x.d):&quot;&quot;)); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(&quot;※ この内容でメイン講師と認識を合わせてから着手します。&quot;);
  var m=[&quot;# 業務受領メモ：&quot;+title,&quot;&quot;,&quot;- 受領日：&quot;+date,&quot;&quot;,&quot;## 受け渡しの流れ&quot;,&quot;&quot;,&quot;```&quot;,&quot;クライアント（&quot;+client+&quot;）&quot;,&quot;  └→ メイン講師（&quot;+main+&quot;）が受注・統括&quot;,&quot;      └→ サブ講師（&quot;+sub+&quot;）＝自分が担当&quot;,&quot;```&quot;,&quot;&quot;,
    &quot;- **① クライアント → メイン講師**：&quot;+(v(&quot;in_client_req&quot;)||&quot;—&quot;),
    &quot;- **② メイン講師 → サブ講師**：&quot;+(v(&quot;in_main_req&quot;)||&quot;—&quot;),
    &quot;- 背景・目的：&quot;+(v(&quot;in_bg&quot;)||&quot;—&quot;),&quot;- 期日：&quot;+(v(&quot;in_due&quot;)||&quot;—&quot;),
    &quot;&quot;,&quot;## 自分（サブ講師）が受けた業務&quot;,&quot;&quot;,&quot;| # | やること | 成果物 |&quot;,&quot;|---|---|---|&quot;];
  if(items.length){ items.forEach(function(x,i){ m.push(&quot;| &quot;+(i+1)+&quot; | &quot;+x.t+&quot; | &quot;+(x.d||&quot;—&quot;)+&quot; |&quot;); }); } else { m.push(&quot;| — | （未入力） | — |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- 役割分担 ---- */
function roleAdd(item,who){
  var w=who||&quot;両方&quot;;
  $(&quot;roleList&quot;).appendChild(mkRow(
    '<input class=&quot;role-i&quot; placeholder=&quot;項目（例：教材作成）&quot; value=&quot;'+esc(item||&quot;&quot;)+'&quot;>'+
    '<select class=&quot;role-w&quot; style=&quot;max-width:130px&quot;>'+
      ['メイン','サブ','両方'].map(function(s){ return '<option'+(w===s?' selected':'')+'>'+s+'</option>'; }).join(&quot;&quot;)+
    '</select>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function roleTemplate(){
  [[&quot;カリキュラム設計&quot;,&quot;メイン&quot;],[&quot;教材作成&quot;,&quot;両方&quot;],[&quot;スライドレビュー&quot;,&quot;メイン&quot;],[&quot;講義の進行&quot;,&quot;メイン&quot;],[&quot;演習サポート・巡回&quot;,&quot;サブ&quot;],[&quot;質問対応（一次）&quot;,&quot;サブ&quot;],[&quot;受講生の様子観察・報告&quot;,&quot;サブ&quot;],[&quot;採点・評価&quot;,&quot;両方&quot;],[&quot;保護者/会社への報告&quot;,&quot;メイン&quot;]].forEach(function(t){ roleAdd(t[0],t[1]); });
  toast(&quot;定番分担を入れました&quot;);
}
function roleRead(){ return [].slice.call(document.querySelectorAll(&quot;#roleList .row&quot;)).map(function(r){
  return { i:r.querySelector(&quot;.role-i&quot;).value.trim(), w:r.querySelector(&quot;.role-w&quot;).value }; }).filter(function(x){return x.i;}); }
function buildRole(){
  var rs=roleRead();
  var o=[];
  o.push(&quot;【役割分担表】メイン講師／サブ講師&quot;);
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 担当範囲&quot;); o.push(BAR);
  if(rs.length){ rs.forEach(function(r){ o.push(&quot;[&quot;+r.w+&quot;] &quot;+r.i); }); } else { o.push(&quot;（未入力）&quot;); }
  var mainList=rs.filter(function(r){return r.w===&quot;メイン&quot;;}).map(function(r){return r.i;});
  var subList=rs.filter(function(r){return r.w===&quot;サブ&quot;;}).map(function(r){return r.i;});
  var bothList=rs.filter(function(r){return r.w===&quot;両方&quot;;}).map(function(r){return r.i;});
  o.push(&quot;&quot;);
  o.push(&quot;メイン講師の主担当：&quot;+(mainList.length?mainList.join(&quot;／&quot;):&quot;—&quot;));
  o.push(&quot;サブ講師の主担当：&quot;+(subList.length?subList.join(&quot;／&quot;):&quot;—&quot;));
  o.push(&quot;共同：&quot;+(bothList.length?bothList.join(&quot;／&quot;):&quot;—&quot;));
  var m=[&quot;# 役割分担表&quot;,&quot;&quot;,&quot;| 項目 | 担当 |&quot;,&quot;|---|---|&quot;];
  if(rs.length){ rs.forEach(function(r){ m.push(&quot;| &quot;+r.i+&quot; | &quot;+r.w+&quot; |&quot;); }); } else { m.push(&quot;| （未入力） | — |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- 完了条件 ---- */
function dodAdd(text,done){
  $(&quot;dodList&quot;).appendChild(mkRow(
    '<label style=&quot;display:flex;align-items:center;gap:6px;margin:0;flex:0 0 auto;&quot;><input type=&quot;checkbox&quot; class=&quot;dod-c&quot; style=&quot;width:auto&quot;'+(done?' checked':'')+'></label>'+
    '<input class=&quot;dod-v&quot; placeholder=&quot;完了条件（例：講師用・受講生用スライドが揃っている）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function dodTemplate(){
  [&quot;講師用・受講生用のスライドが揃っている&quot;,&quot;演習問題と模範解答が用意されている&quot;,&quot;筆記試験と採点基準がある&quot;,&quot;タイムテーブル（コマ割り）が確定している&quot;,&quot;メイン講師のレビューを通過している&quot;,&quot;当日の機材・環境が動作確認済み&quot;].forEach(function(x){ dodAdd(x); });
  toast(&quot;定番完了条件を入れました&quot;);
}
function dodRead(){ return [].slice.call(document.querySelectorAll(&quot;#dodList .row&quot;)).map(function(r){
  return { v:r.querySelector(&quot;.dod-v&quot;).value.trim(), done:r.querySelector(&quot;.dod-c&quot;).checked }; }).filter(function(x){return x.v;}); }
function buildDod(){
  var target=v(&quot;dod_target&quot;)||&quot;（対象未入力）&quot;, items=dodRead();
  var done=items.filter(function(x){return x.done;}).length;
  var o=[];
  o.push(&quot;【完了条件（DoD）】&quot;+target);
  o.push(&quot;達成：&quot;+done+&quot;/&quot;+items.length);
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 完了条件&quot;); o.push(BAR);
  if(items.length){ items.forEach(function(x,i){ o.push((x.done?&quot;☑&quot;:&quot;☐&quot;)+&quot; &quot;+(i+1)+&quot;. &quot;+x.v); }); } else { o.push(&quot;（未入力）&quot;); }
  if(items.length &amp;&amp; done===items.length){ o.push(&quot;&quot;); o.push(&quot;✅ すべて達成。完了とみなせます。&quot;); }
  else if(items.length){ o.push(&quot;&quot;); o.push(&quot;⚠️ 未達成が&quot;+(items.length-done)+&quot;件あります。&quot;); }
  var m=[&quot;# 完了条件（DoD）：&quot;+target,&quot;&quot;,&quot;達成：&quot;+done+&quot;/&quot;+items.length,&quot;&quot;,&quot;| 達成 | # | 完了条件 |&quot;,&quot;|---|---|---|&quot;];
  if(items.length){ items.forEach(function(x,i){ m.push(&quot;| &quot;+(x.done?&quot;✅&quot;:&quot;⬜&quot;)+&quot; | &quot;+(i+1)+&quot; | &quot;+x.v+&quot; |&quot;); }); } else { m.push(&quot;| — | — | （未入力） |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- 教育設計 ---- */
function deAdd(theme,why,what,how){
  $(&quot;deList&quot;).appendChild(mkRow(
    '<input class=&quot;de-t&quot; placeholder=&quot;コマ名（例：権限とパーミッション）&quot; value=&quot;'+esc(theme||&quot;&quot;)+'&quot; style=&quot;max-width:24%&quot;>'+
    '<input class=&quot;de-why&quot; placeholder=&quot;WHY（なぜ学ぶ）&quot; value=&quot;'+esc(why||&quot;&quot;)+'&quot;>'+
    '<input class=&quot;de-what&quot; placeholder=&quot;WHAT（何を）&quot; value=&quot;'+esc(what||&quot;&quot;)+'&quot;>'+
    '<input class=&quot;de-how&quot; placeholder=&quot;HOW（どう）&quot; value=&quot;'+esc(how||&quot;&quot;)+'&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function deRead(){ return [].slice.call(document.querySelectorAll(&quot;#deList .row&quot;)).map(function(r){
  return { t:r.querySelector(&quot;.de-t&quot;).value.trim(), why:r.querySelector(&quot;.de-why&quot;).value.trim(), what:r.querySelector(&quot;.de-what&quot;).value.trim(), how:r.querySelector(&quot;.de-how&quot;).value.trim() }; }).filter(function(x){return x.t;}); }
function buildDesign(){
  var goals=lines(v(&quot;de_goal&quot;)), cur=deRead();
  var o=[];
  o.push(&quot;【教育設計書】&quot;+(v(&quot;de_title&quot;)||&quot;（無題研修）&quot;));
  o.push(&quot;対象者：&quot;+(v(&quot;de_target&quot;)||&quot;—&quot;));
  o.push(&quot;評価方法：&quot;+(v(&quot;de_eval&quot;)||&quot;—&quot;)+&quot;　／　所要：&quot;+(v(&quot;de_time&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 学習目標（研修後にできること）&quot;); o.push(BAR);
  if(goals.length){ goals.forEach(function(g,i){ o.push((i+1)+&quot;. &quot;+g); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ カリキュラム（WHY→WHAT→HOW）&quot;); o.push(BAR);
  if(cur.length){ cur.forEach(function(c,i){
    o.push(&quot;─ コマ&quot;+(i+1)+&quot;：&quot;+c.t+&quot; ─&quot;);
    o.push(&quot;　WHY ：&quot;+(c.why||&quot;—&quot;));
    o.push(&quot;　WHAT：&quot;+(c.what||&quot;—&quot;));
    o.push(&quot;　HOW ：&quot;+(c.how||&quot;—&quot;));
  }); } else { o.push(&quot;（未入力）&quot;); }
  var m=[&quot;# 教育設計書：&quot;+(v(&quot;de_title&quot;)||&quot;（無題研修）&quot;),&quot;&quot;,&quot;- 対象者：&quot;+(v(&quot;de_target&quot;)||&quot;—&quot;),&quot;- 評価方法：&quot;+(v(&quot;de_eval&quot;)||&quot;—&quot;),&quot;- 所要：&quot;+(v(&quot;de_time&quot;)||&quot;—&quot;),&quot;&quot;,&quot;## 学習目標&quot;,&quot;&quot;];
  if(goals.length){ goals.forEach(function(g){ m.push(&quot;- &quot;+g); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## カリキュラム（WHY→WHAT→HOW）&quot;); m.push(&quot;&quot;);
  if(cur.length){ m.push(&quot;| コマ | WHY | WHAT | HOW |&quot;); m.push(&quot;|---|---|---|---|&quot;); cur.forEach(function(c){ m.push(&quot;| &quot;+c.t+&quot; | &quot;+(c.why||&quot;—&quot;)+&quot; | &quot;+(c.what||&quot;—&quot;)+&quot; | &quot;+(c.how||&quot;—&quot;)+&quot; |&quot;); }); } else { m.push(&quot;（未入力）&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- 引き継ぎ確認 ---- */
function hoAdd(text,result){
  var rv=result||&quot;&quot;;
  $(&quot;hoList&quot;).appendChild(mkRow(
    '<input class=&quot;ho-v&quot; placeholder=&quot;確認観点（例：完了の定義は合っているか）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;>'+
    '<select class=&quot;ho-r&quot; style=&quot;max-width:120px&quot;>'+
      ['','OK','要確認','N/A'].map(function(x){ var lbl=x===&quot;&quot;?&quot;未&quot;:(x===&quot;N/A&quot;?&quot;該当なし&quot;:x); return '<option value=&quot;'+x+'&quot;'+(rv===x?' selected':'')+'>'+lbl+'</option>'; }).join(&quot;&quot;)+
    '</select>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function hoTemplate(){
  [&quot;業務の目的・ゴールは合っているか&quot;,&quot;成果物と完了条件は合っているか&quot;,&quot;期日・スケジュールは現実的か&quot;,&quot;メイン／サブの役割分担は明確か&quot;,&quot;判断に迷ったときの相談先・連絡方法&quot;,&quot;受講生情報・前提知識の共有はあるか&quot;,&quot;使ってよい教材・テンプレートの範囲&quot;].forEach(function(x){ hoAdd(x); });
  toast(&quot;定番の確認観点を入れました&quot;);
}
function hoRead(){ return [].slice.call(document.querySelectorAll(&quot;#hoList .row&quot;)).map(function(r){
  return { v:r.querySelector(&quot;.ho-v&quot;).value.trim(), r:r.querySelector(&quot;.ho-r&quot;).value }; }).filter(function(x){return x.v;}); }
function buildHandoff(){
  var items=hoRead();
  var ok=items.filter(function(x){return x.r===&quot;OK&quot;;}).length;
  var ng=items.filter(function(x){return x.r===&quot;要確認&quot;;}).length;
  var un=items.filter(function(x){return !x.r;}).length;
  var o=[];
  o.push(&quot;【引き継ぎ・認識合わせ表】&quot;);
  o.push(&quot;確認相手：&quot;+(v(&quot;ho_with&quot;)||&quot;—&quot;)+&quot;　／　確認者：&quot;+(v(&quot;ho_by&quot;)||&quot;—&quot;)+&quot;　日付：&quot;+todayJp());
  o.push(&quot;OK &quot;+ok+&quot;／要確認 &quot;+ng+&quot;／未 &quot;+un+&quot;（全 &quot;+items.length+&quot;件）&quot;);
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 確認観点&quot;); o.push(BAR);
  if(items.length){ items.forEach(function(x,i){ o.push(&quot;[&quot;+(x.r||&quot;未&quot;)+&quot;] &quot;+(i+1)+&quot;. &quot;+x.v); }); } else { o.push(&quot;（未入力）&quot;); }
  if(ng>0||un>0){ o.push(&quot;&quot;); o.push(&quot;⚠️ 要確認/未が残っています。着手前にメイン講師と合わせましょう。&quot;); }
  else if(items.length){ o.push(&quot;&quot;); o.push(&quot;✅ すべて確認済み。着手OKです。&quot;); }
  var m=[&quot;# 引き継ぎ・認識合わせ表&quot;,&quot;&quot;,&quot;- 確認相手：&quot;+(v(&quot;ho_with&quot;)||&quot;—&quot;),&quot;- 確認者：&quot;+(v(&quot;ho_by&quot;)||&quot;—&quot;),&quot;- 日付：&quot;+todayJp(),&quot;&quot;,&quot;| 状態 | # | 確認観点 |&quot;,&quot;|---|---|---|&quot;];
  if(items.length){ items.forEach(function(x,i){ m.push(&quot;| &quot;+(x.r||&quot;未&quot;)+&quot; | &quot;+(i+1)+&quot; | &quot;+x.v+&quot; |&quot;); }); } else { m.push(&quot;| — | — | （未入力） |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- Excel(.xlsx) ---- */
function _crc32(b){ var c,crc=0xFFFFFFFF; for(var i=0;i<b.length;i++){ c=(crc^b[i])&amp;0xFF; for(var k=0;k<8;k++){ c=(c&amp;1)?(0xEDB88320^(c>>>1)):(c>>>1); } crc=(crc>>>8)^c; } return (crc^0xFFFFFFFF)>>>0; }
function _sb(s){ return new TextEncoder().encode(s); }
function _u16(n){ return [n&amp;0xFF,(n>>>8)&amp;0xFF]; }
function _u32(n){ return [n&amp;0xFF,(n>>>8)&amp;0xFF,(n>>>16)&amp;0xFF,(n>>>24)&amp;0xFF]; }
function _S(s){ return {t:&quot;s&quot;,v:(s==null?&quot;&quot;:String(s))}; }
function _N(n){ return {t:&quot;n&quot;,v:n}; }
function _col(i){ var s=&quot;&quot;; i++; while(i>0){ var m=(i-1)%26; s=String.fromCharCode(65+m)+s; i=Math.floor((i-1)/26); } return s; }
function _sheetXml(rows){
  var xml='<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><worksheet xmlns=&quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot;><sheetData>';
  for(var r=0;r<rows.length;r++){ xml+='<row r=&quot;'+(r+1)+'&quot;>';
    for(var c=0;c<rows[r].length;c++){ var cell=rows[r][c], ref=_col(c)+(r+1);
      if(cell&amp;&amp;cell.t===&quot;n&quot;){ xml+='<c r=&quot;'+ref+'&quot;><v>'+cell.v+'</v></c>'; }
      else{ var t=(cell&amp;&amp;cell.v!=null)?String(cell.v):&quot;&quot;; xml+='<c r=&quot;'+ref+'&quot; t=&quot;inlineStr&quot;><is><t xml:space=&quot;preserve&quot;>'+esc(t)+'</t></is></c>'; } }
    xml+='</row>'; }
  xml+='</sheetData></worksheet>'; return xml;
}
function _zipStore(files){
  var chunks=[],central=[],offset=0;
  files.forEach(function(f){ var nameB=_sb(f.name),dataB=f.data,crc=_crc32(dataB);
    var lh=[].concat(_u32(0x04034b50),_u16(20),_u16(0),_u16(0),_u16(0),_u16(0),_u32(crc),_u32(dataB.length),_u32(dataB.length),_u16(nameB.length),_u16(0));
    chunks.push(new Uint8Array(lh)); chunks.push(nameB); chunks.push(dataB);
    var ch=[].concat(_u32(0x02014b50),_u16(20),_u16(20),_u16(0),_u16(0),_u16(0),_u16(0),_u32(crc),_u32(dataB.length),_u32(dataB.length),_u16(nameB.length),_u16(0),_u16(0),_u16(0),_u16(0),_u32(0),_u32(offset));
    central.push(new Uint8Array(ch)); central.push(nameB); offset+=lh.length+nameB.length+dataB.length; });
  var cstart=offset,csize=0; central.forEach(function(c){ csize+=c.length; });
  var end=[].concat(_u32(0x06054b50),_u16(0),_u16(0),_u16(files.length),_u16(files.length),_u32(csize),_u32(cstart),_u16(0));
  var all=[]; chunks.forEach(function(c){all.push(c);}); central.forEach(function(c){all.push(c);}); all.push(new Uint8Array(end));
  var total=0; all.forEach(function(a){total+=a.length;}); var out=new Uint8Array(total),p=0; all.forEach(function(a){ out.set(a,p); p+=a.length; }); return out;
}
function _buildXlsx(sheets){
  var files=[];
  files.push({name:&quot;[Content_Types].xml&quot;,data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Types xmlns=&quot;http://schemas.openxmlformats.org/package/2006/content-types&quot;><Default Extension=&quot;rels&quot; ContentType=&quot;application/vnd.openxmlformats-package.relationships+xml&quot;/><Default Extension=&quot;xml&quot; ContentType=&quot;application/xml&quot;/><Override PartName=&quot;/xl/workbook.xml&quot; ContentType=&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml&quot;/>'+sheets.map(function(s,i){return '<Override PartName=&quot;/xl/worksheets/sheet'+(i+1)+'.xml&quot; ContentType=&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml&quot;/>';}).join(&quot;&quot;)+'</Types>')});
  files.push({name:&quot;_rels/.rels&quot;,data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Relationships xmlns=&quot;http://schemas.openxmlformats.org/package/2006/relationships&quot;><Relationship Id=&quot;rId1&quot; Type=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument&quot; Target=&quot;xl/workbook.xml&quot;/></Relationships>')});
  files.push({name:&quot;xl/workbook.xml&quot;,data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><workbook xmlns=&quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot; xmlns:r=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships&quot;><sheets>'+sheets.map(function(s,i){return '<sheet name=&quot;'+esc(s.name)+'&quot; sheetId=&quot;'+(i+1)+'&quot; r:id=&quot;rId'+(i+1)+'&quot;/>';}).join(&quot;&quot;)+'</sheets></workbook>')});
  files.push({name:&quot;xl/_rels/workbook.xml.rels&quot;,data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Relationships xmlns=&quot;http://schemas.openxmlformats.org/package/2006/relationships&quot;>'+sheets.map(function(s,i){return '<Relationship Id=&quot;rId'+(i+1)+'&quot; Type=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet&quot; Target=&quot;worksheets/sheet'+(i+1)+'.xml&quot;/>';}).join(&quot;&quot;)+'</Relationships>')});
  sheets.forEach(function(s,i){ files.push({name:&quot;xl/worksheets/sheet&quot;+(i+1)+&quot;.xml&quot;,data:_sb(_sheetXml(s.rows))}); });
  return _zipStore(files);
}
function dodExportXlsx(){
  var items=dodRead();
  var rows=[[_S(&quot;達成&quot;),_S(&quot;#&quot;),_S(&quot;完了条件&quot;)]];
  if(items.length){ items.forEach(function(x,i){ rows.push([_S(x.done?&quot;済&quot;:&quot;未&quot;),_N(i+1),_S(x.v)]); }); } else { rows.push([_S(&quot;—&quot;),_S(&quot;—&quot;),_S(&quot;（未入力）&quot;)]); }
  try{ var u8=_buildXlsx([{name:&quot;完了条件&quot;,rows:rows}]);
    var blob=new Blob([u8],{type:&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet&quot;}); var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=&quot;完了条件_&quot;+stamp()+&quot;.xlsx&quot;; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(url);},500); toast(&quot;Excelを書き出しました&quot;); }catch(e){ toast(&quot;Excel出力に失敗しました&quot;); }
}

/* ---- データ統合 ---- */
function collectAll(){
  return { _app:&quot;usausa_intake&quot;, _ver:&quot;1.0&quot;, _saved:nowParts().datetime,
    intake:{ title:v(&quot;in_title&quot;),date:v(&quot;in_date&quot;),client:v(&quot;in_client&quot;),clientReq:v(&quot;in_client_req&quot;),main:v(&quot;in_main&quot;),main2:v(&quot;in_main2&quot;),mainReq:v(&quot;in_main_req&quot;),sub:v(&quot;in_sub&quot;),bg:v(&quot;in_bg&quot;),due:v(&quot;in_due&quot;),list:inRead() },
    role:{ list:roleRead() },
    dod:{ target:v(&quot;dod_target&quot;),list:dodRead() },
    design:{ title:v(&quot;de_title&quot;),target:v(&quot;de_target&quot;),goal:v(&quot;de_goal&quot;),eval:v(&quot;de_eval&quot;),time:v(&quot;de_time&quot;),cur:deRead() },
    handoff:{ with:v(&quot;ho_with&quot;),by:v(&quot;ho_by&quot;),items:hoRead() }
  };
}
function hubSaveJson(){ _saveBlob(JSON.stringify(collectAll(),null,2),&quot;intake_data_&quot;+stamp()+&quot;.json&quot;,&quot;application/json;charset=utf-8&quot;); toast(&quot;全データをJSON保存しました&quot;); }
function applyAll(d){
  if(!d||typeof d!==&quot;object&quot;) return;
  function set(id,val){ var el=$(id); if(el) el.value=(val||&quot;&quot;); }
  if(d.intake){ set(&quot;in_title&quot;,d.intake.title); set(&quot;in_date&quot;,d.intake.date); set(&quot;in_client&quot;,d.intake.client); set(&quot;in_client_req&quot;,d.intake.clientReq); set(&quot;in_main_req&quot;,d.intake.mainReq); set(&quot;in_sub&quot;,d.intake.sub); set(&quot;in_bg&quot;,d.intake.bg); set(&quot;in_due&quot;,d.intake.due);
    // メイン講師：保存名を登録してから選択
    [d.intake.main,d.intake.main2].forEach(function(nm){ if(nm &amp;&amp; mainTeachers.indexOf(nm)<0){ mainTeachers.push(nm); } });
    saveMains(); renderMainOptions();
    if($(&quot;in_main&quot;)&amp;&amp;d.intake.main) $(&quot;in_main&quot;).value=d.intake.main;
    if($(&quot;in_main2&quot;)&amp;&amp;d.intake.main2) $(&quot;in_main2&quot;).value=d.intake.main2;
    $(&quot;inList&quot;).innerHTML=&quot;&quot;; (d.intake.list||[]).forEach(function(x){ inAdd(x.t,x.d); }); }
  if(d.role){ $(&quot;roleList&quot;).innerHTML=&quot;&quot;; (d.role.list||[]).forEach(function(x){ roleAdd(x.i,x.w); }); }
  if(d.dod){ set(&quot;dod_target&quot;,d.dod.target); $(&quot;dodList&quot;).innerHTML=&quot;&quot;; (d.dod.list||[]).forEach(function(x){ dodAdd(x.v,x.done); }); }
  if(d.design){ set(&quot;de_title&quot;,d.design.title); set(&quot;de_target&quot;,d.design.target); set(&quot;de_goal&quot;,d.design.goal); set(&quot;de_eval&quot;,d.design.eval); set(&quot;de_time&quot;,d.design.time);
    $(&quot;deList&quot;).innerHTML=&quot;&quot;; (d.design.cur||[]).forEach(function(c){ deAdd(c.t,c.why,c.what,c.how); }); }
  if(d.handoff){ set(&quot;ho_with&quot;,d.handoff.with); set(&quot;ho_by&quot;,d.handoff.by); $(&quot;hoList&quot;).innerHTML=&quot;&quot;; (d.handoff.items||[]).forEach(function(x){ hoAdd(x.v,x.r); }); }
}
function hubLoadJson(input){
  var f=input&amp;&amp;input.files&amp;&amp;input.files[0]; if(!f){ return; }
  var rd=new FileReader();
  rd.onload=function(){ try{ applyAll(JSON.parse(rd.result)); toast(&quot;JSONを取り込みました&quot;); }catch(e){ toast(&quot;JSONの読み込みに失敗しました&quot;); } input.value=&quot;&quot;; };
  rd.readAsText(f);
}
function hubClearAll(){
  if(!window.confirm(&quot;すべての入力をクリアします。よろしいですか？&quot;)) return;
  [&quot;in_title&quot;,&quot;in_date&quot;,&quot;in_client&quot;,&quot;in_client_req&quot;,&quot;in_main_req&quot;,&quot;in_sub&quot;,&quot;in_bg&quot;,&quot;in_due&quot;,&quot;dod_target&quot;,&quot;de_title&quot;,&quot;de_target&quot;,&quot;de_goal&quot;,&quot;de_eval&quot;,&quot;de_time&quot;,&quot;ho_with&quot;,&quot;ho_by&quot;].forEach(function(id){ var el=$(id); if(el) el.value=&quot;&quot;; });
  [&quot;inList&quot;,&quot;roleList&quot;,&quot;dodList&quot;,&quot;deList&quot;,&quot;hoList&quot;].forEach(function(id){ var el=$(id); if(el) el.innerHTML=&quot;&quot;; });
  setOut(&quot;&quot;); $(&quot;out&quot;).textContent=&quot;&quot;;
  inAdd(); roleAdd(); dodAdd(); deAdd(); hoAdd();
  // 名前の初期値を戻す
  $(&quot;in_sub&quot;).value=&quot;石黒 友季子&quot;; $(&quot;ho_by&quot;).value=&quot;石黒 友季子&quot;;
  toast(&quot;全クリアしました&quot;);
}

/* ---- タブ ---- */
function switchPanel(tab){
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.classList.toggle(&quot;active&quot;, t.dataset.tab===tab); });
  [].slice.call(document.querySelectorAll(&quot;.panel&quot;)).forEach(function(p){ p.classList.toggle(&quot;active&quot;, p.id===&quot;panel-&quot;+tab); });
}

/* ---- init ---- */
(function(){
  mainTeachers=loadMains();
  renderMainOptions();
  inAdd(); roleAdd(); dodAdd(); deAdd(); hoAdd();
  // 名前の初期値
  if($(&quot;in_sub&quot;)) $(&quot;in_sub&quot;).value=&quot;石黒 友季子&quot;;
  if($(&quot;ho_by&quot;)) $(&quot;ho_by&quot;).value=&quot;石黒 友季子&quot;;
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.addEventListener(&quot;click&quot;, function(){ switchPanel(t.dataset.tab); }); });
  try{ var vt=$(&quot;ver_today&quot;); if(vt) vt.textContent=nowParts().date; }catch(e){}
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-web" title="Web制作STUDIO" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ Web制作STUDIOジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;}
  :root{ --radius:14px; }
  body.theme-jp{
    --paper:#ffffff; --cream:#f5f2fb; --cream2:#ece5f7; --ink:#2c2740; --ink-soft:#6a6480;
    --line:#e2dcf0; --line-soft:#efeaf9; --ok:#3f8f5f; --ng:#d24b4b;
    --accent:#7a5cc4; --accent-deep:#5a3fa0; --gold:#a98fe0; --gold-soft:#d8caf2;
    --shadow:0 10px 30px rgba(122,92,196,.14);
  }
  body{margin:0;font-family:&quot;Hiragino Sans&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;color:var(--ink);
    background:linear-gradient(160deg,#ece4f8,var(--cream) 42%);min-height:100vh;line-height:1.7;}
  .wrap{max-width:980px;margin:0 auto;padding:18px 16px 80px;}

  header.hero{position:relative;margin-top:24px;background:var(--paper);border:1px solid var(--line);
    border-radius:22px;padding:24px 28px;box-shadow:var(--shadow);overflow:hidden;}
  header.hero::before{content:&quot;&quot;;position:absolute;inset:0 0 auto 0;height:6px;
    background:linear-gradient(90deg,var(--gold-soft),var(--accent),var(--gold));}
  header.hero h1{margin:0 0 6px;font-size:1.36rem;font-weight:800;padding-right:46px;}
  header.hero p{margin:0;color:var(--ink-soft);font-size:.9rem;padding-right:46px;}
  .ver-badge{display:flex;gap:8px;align-items:center;margin:0 0 8px;flex-wrap:wrap;}
  .ver-pill{display:inline-block;background:var(--accent);color:#fff;font-weight:800;font-size:.72rem;
    letter-spacing:.3px;padding:2px 9px;border-radius:999px;}
  .ver-date,.ver-today{color:var(--ink-soft);font-size:.74rem;}
  .ver-today:not(:empty)::before{content:&quot;｜ 今日 &quot;;opacity:.8;}
  .bunny{position:absolute;top:16px;right:20px;font-size:28px;filter:drop-shadow(0 4px 8px rgba(122,92,196,.25));}
  .lang-switch{display:none;}

  .tabs{display:flex;gap:8px;margin:16px 0;flex-wrap:wrap;}
  .tab{flex:1 1 auto;min-width:130px;text-align:center;cursor:pointer;border:1px solid var(--line);
    background:var(--paper);border-radius:12px;padding:9px 11px;font-weight:700;font-size:.86rem;color:var(--ink-soft);
    box-shadow:0 2px 5px rgba(0,0,0,.05);transition:transform .08s,box-shadow .12s,background .12s;}
  .tab:hover{transform:translateY(-1px);box-shadow:0 4px 10px rgba(0,0,0,.1);}
  .tab:active{transform:translateY(1px) scale(.99);}
  .tab.active{background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;border-color:transparent;}

  .panel{display:none;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);
    padding:20px;box-shadow:var(--shadow);}
  .panel.active{display:block;}
  h2{font-size:1.1rem;margin:0 0 6px;}
  h3{font-size:.96rem;margin:16px 0 6px;color:var(--accent-deep);}
  label{display:block;font-size:.8rem;font-weight:700;color:var(--ink-soft);margin:8px 0 3px;}
  input,select,textarea{width:100%;border:1px solid var(--line);border-radius:9px;padding:8px 10px;
    font-size:.92rem;font-family:inherit;color:var(--ink);background:var(--paper);}
  textarea{min-height:60px;resize:vertical;}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
  .hint{font-size:.78rem;color:var(--ink-soft);margin:4px 0 0;}
  code{background:var(--cream2);padding:1px 5px;border-radius:5px;font-size:.86em;}

  button{transition:transform .08s,box-shadow .12s,filter .12s,background .12s;}
  .gen{margin-top:18px;width:100%;background:linear-gradient(135deg,var(--accent),var(--accent-deep));
    color:#fff;border:none;border-radius:12px;padding:13px;font-size:1rem;font-weight:800;cursor:pointer;
    box-shadow:0 2px 5px rgba(0,0,0,.12);}
  .gen:hover{box-shadow:0 4px 10px rgba(0,0,0,.16);transform:translateY(-1px);}
  .gen:active{transform:translateY(1px) scale(.99);box-shadow:inset 0 3px 6px rgba(0,0,0,.2);}
  .addbtn{margin-top:8px;background:var(--cream2);border:1px dashed var(--accent);color:var(--accent-deep);
    border-radius:9px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.84rem;box-shadow:0 2px 5px rgba(0,0,0,.05);}
  .addbtn:hover{transform:translateY(-1px);}
  .addbtn:active{transform:translateY(1px) scale(.99);}
  .del{background:#fff;border:1px solid var(--line);color:var(--ng);border-radius:8px;padding:6px 9px;cursor:pointer;font-weight:700;}
  .row{display:flex;gap:8px;align-items:flex-start;margin:6px 0;}
  .row>*{margin:0;}

  .outwrap{margin-top:18px;background:var(--cream2);border:1px solid var(--line);border-radius:12px;padding:14px;}
  .outwrap h3{margin-top:0;}
  pre.out{white-space:pre-wrap;word-break:break-word;background:var(--paper);border:1px solid var(--line);
    border-radius:9px;padding:12px;font-size:.86rem;max-height:420px;overflow:auto;font-family:inherit;}
  .outbtns{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
  .outbtns button{border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:10px;
    padding:8px 12px;cursor:pointer;font-weight:700;font-size:.84rem;box-shadow:0 2px 5px rgba(0,0,0,.05);}
  .outbtns button:hover{transform:translateY(-1px);}
  .outbtns button:active{transform:translateY(1px) scale(.99);}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;
    padding:10px 18px;border-radius:999px;font-size:.86rem;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50;}
  .toast.show{opacity:.95;}

  @media (max-width:560px){
    .grid,.grid3{grid-template-columns:1fr;}
    header.hero h1{padding-top:30px;padding-right:0;}
  }
</style>
</head>
<body class=&quot;theme-jp&quot;>
<div class=&quot;wrap&quot;>
  <header class=&quot;hero&quot;>
    <div class=&quot;bunny&quot;>🐰</div>
    <h1>うさうさ Web制作STUDIOジェネレーター</h1>
    <div class=&quot;ver-badge&quot;><span class=&quot;ver-pill&quot;>v1.0</span><span class=&quot;ver-date&quot;>2026-05-22</span><span class=&quot;ver-today&quot; id=&quot;ver_today&quot;></span></div>
    <p>STUDIO（ノーコード）でのWeb制作を、要求整理から要件・実装タスク・サイト設計・セクション設計・コンテンツ・公開前チェックまで支援します。データは端末内のみ・外部送信なし。</p>
  </header>

  <div class=&quot;tabs&quot; id=&quot;tabs&quot;>
    <div class=&quot;tab active&quot; data-tab=&quot;req&quot;>📌 要求定義</div>
    <div class=&quot;tab&quot; data-tab=&quot;spec&quot;>📐 STUDIO要件整理</div>
    <div class=&quot;tab&quot; data-tab=&quot;task&quot;>🧩 実装タスク分割</div>
    <div class=&quot;tab&quot; data-tab=&quot;site&quot;>🗺 サイト設計</div>
    <div class=&quot;tab&quot; data-tab=&quot;sec&quot;>🧱 セクション設計</div>
    <div class=&quot;tab&quot; data-tab=&quot;copy&quot;>✍️ コンテンツ整理</div>
    <div class=&quot;tab&quot; data-tab=&quot;check&quot;>✅ 公開前チェック</div>
    <div class=&quot;tab&quot; data-tab=&quot;hub&quot;>🗂 データ統合</div>
  </div>

  <!-- 要求定義 -->
  <div class=&quot;panel active&quot; id=&quot;panel-req&quot;>
    <h2>要求定義（誰のため・何を・なぜ）</h2>
    <p class=&quot;hint&quot;>クライアント・利用者がWebサイトに本当に求めるもの（要求）を、背景と理由つきで整理します。</p>
    <div class=&quot;grid&quot;>
      <div><label>サイト名・案件名</label><input id=&quot;rq_title&quot; placeholder=&quot;〇〇クリニック サイトリニューアル&quot;></div>
      <div><label>記入日（空なら今日）</label><input id=&quot;rq_date&quot; placeholder=&quot;2026/05/22（金）&quot;></div>
    </div>
    <div class=&quot;grid&quot;>
      <div><label>クライアント・発注者</label><input id=&quot;rq_client&quot; placeholder=&quot;〇〇クリニック 院長&quot;></div>
      <div><label>サイトの目的（ゴール）</label><input id=&quot;rq_goal&quot; placeholder=&quot;新規予約の問い合わせを増やす&quot;></div>
    </div>
    <div><label>背景・現状の課題</label><textarea id=&quot;rq_bg&quot; placeholder=&quot;今のサイトはスマホで見づらく、予約導線がない&quot;></textarea></div>
    <h3>要求リスト（1行＝1要求／なぜを添える）</h3>
    <div id=&quot;rqList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;rqAdd()&quot;>＋ 要求を追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildReq()&quot;>要求定義書を生成する</button>
  </div>

  <!-- STUDIO要件整理 -->
  <div class=&quot;panel&quot; id=&quot;panel-spec&quot;>
    <h2>STUDIO要件整理（実現する条件）</h2>
    <p class=&quot;hint&quot;>要求を「STUDIOで実現する条件」に翻訳します。機能・非機能・STUDIO特有の項目に分けます。</p>
    <div><label>対象範囲（ページ・機能の範囲）</label><input id=&quot;sp_scope&quot; placeholder=&quot;トップ／診療案内／医師紹介／アクセス／予約フォーム&quot;></div>
    <h3>機能要件（〜できること）</h3>
    <div id=&quot;spFunc&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;spAddFunc()&quot;>＋ 機能要件を追加</button>
    <h3>非機能要件（表示速度・SEO・運用など）</h3>
    <div id=&quot;spNf&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;spAddNf()&quot;>＋ 非機能要件を追加</button>
    <h3>STUDIO特有の項目</h3>
    <div class=&quot;grid&quot;>
      <div><label>レスポンシブ対応</label><select id=&quot;sp_resp&quot;><option>PC・タブレット・スマホの3ブレークポイント</option><option>PC・スマホの2ブレークポイント</option><option>スマホファースト</option></select></div>
      <div><label>CMS（STUDIO CMS）利用</label><select id=&quot;sp_cms&quot;><option>あり（お知らせ・ブログ等）</option><option>なし（静的ページのみ）</option></select></div>
    </div>
    <div class=&quot;grid&quot;>
      <div><label>独自ドメイン</label><input id=&quot;sp_domain&quot; placeholder=&quot;example.com（取得済み／未取得）&quot;></div>
      <div><label>公開プラン・制約</label><input id=&quot;sp_plan&quot; placeholder=&quot;STUDIO有料プラン／公開期限あり&quot;></div>
    </div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;spWebTemplate()&quot;>🌐 STUDIO定番要件を入れる</button>
    <button class=&quot;gen&quot; onclick=&quot;buildSpec()&quot;>要件定義書を生成する</button>
  </div>

  <!-- 実装タスク分割 -->
  <div class=&quot;panel&quot; id=&quot;panel-task&quot;>
    <h2>実装作業のタスク分割（WBS）</h2>
    <p class=&quot;hint&quot;>STUDIOでの制作作業を、工程ごとのタスクに分けます。担当・見積り時間・状態をつけられます。</p>
    <div><label>マイルストーン・納期メモ</label><input id=&quot;tk_milestone&quot; placeholder=&quot;デザイン確定 6/10／公開 6/30&quot;></div>
    <h3>タスク一覧</h3>
    <div id=&quot;tkList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;tkAdd()&quot;>＋ タスクを追加</button>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;tkTemplate()&quot;>🧩 STUDIO定番タスクを入れる</button>
    <button class=&quot;gen&quot; onclick=&quot;buildTask()&quot;>タスク表を生成する</button>
  </div>

  <!-- サイト設計 -->
  <div class=&quot;panel&quot; id=&quot;panel-site&quot;>
    <h2>サイト設計（目的・ターゲット・ページ構成）</h2>
    <div class=&quot;grid&quot;>
      <div><label>サイトの目的（再掲・要約）</label><input id=&quot;st_goal&quot; placeholder=&quot;新規予約の問い合わせを増やす&quot;></div>
      <div><label>ターゲット（ペルソナ）</label><input id=&quot;st_target&quot; placeholder=&quot;近隣に住む30〜40代の子育て世帯&quot;></div>
    </div>
    <div class=&quot;grid&quot;>
      <div><label>トーン＆マナー（雰囲気）</label><input id=&quot;st_tone&quot; placeholder=&quot;清潔感・安心感・やわらかい&quot;></div>
      <div><label>参考サイト・方向性</label><input id=&quot;st_ref&quot; placeholder=&quot;〇〇／白基調・写真大きめ&quot;></div>
    </div>
    <h3>ページ構成（1行＝1ページ／役割を添える）</h3>
    <div id=&quot;siteList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;siteAdd()&quot;>＋ ページを追加</button>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;siteTemplate()&quot;>🗺 定番ページ構成を入れる</button>
    <button class=&quot;gen&quot; onclick=&quot;buildSite()&quot;>サイト設計書を生成する</button>
  </div>

  <!-- セクション設計 -->
  <div class=&quot;panel&quot; id=&quot;panel-sec&quot;>
    <h2>セクション設計（ワイヤー）</h2>
    <p class=&quot;hint&quot;>1ページを上から並ぶセクションに分けます。各セクションの役割・要素・CTAを決めます。</p>
    <div><label>対象ページ</label><input id=&quot;sc_page&quot; placeholder=&quot;トップページ&quot;></div>
    <h3>セクション一覧（上から順に）</h3>
    <div id=&quot;secList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;secAdd()&quot;>＋ セクションを追加</button>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;secTemplate()&quot;>🧱 LP定番セクションを入れる</button>
    <button class=&quot;gen&quot; onclick=&quot;buildSec()&quot;>セクション設計（ワイヤー）を生成する</button>
  </div>

  <!-- コンテンツ整理 -->
  <div class=&quot;panel&quot; id=&quot;panel-copy&quot;>
    <h2>コンテンツ整理（コピー・CTA）</h2>
    <p class=&quot;hint&quot;>見出し・本文・CTA（行動喚起）など、原稿になる文言を整理します。</p>
    <div class=&quot;grid&quot;>
      <div><label>キャッチコピー（メイン）</label><input id=&quot;cp_catch&quot; placeholder=&quot;今日の不安を、明日の安心に。&quot;></div>
      <div><label>サブコピー</label><input id=&quot;cp_sub&quot; placeholder=&quot;土日も診療。Web予約で待ち時間ゼロ。&quot;></div>
    </div>
    <div class=&quot;grid&quot;>
      <div><label>主要CTA（ボタン文言）</label><input id=&quot;cp_cta&quot; placeholder=&quot;Webで予約する&quot;></div>
      <div><label>サブCTA</label><input id=&quot;cp_cta2&quot; placeholder=&quot;電話で相談する&quot;></div>
    </div>
    <h3>本文ブロック（見出し＋本文）</h3>
    <div id=&quot;copyList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;copyAdd()&quot;>＋ 本文ブロックを追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildCopy()&quot;>コンテンツ原稿を生成する</button>
  </div>

  <!-- 公開前チェック -->
  <div class=&quot;panel&quot; id=&quot;panel-check&quot;>
    <h2>公開前チェック（表示・SEO・レスポンシブ）</h2>
    <p class=&quot;hint&quot;>公開前に確認すべき観点をチェックします。結果（OK/NG/該当なし）と所見を記録できます。</p>
    <div class=&quot;grid&quot;>
      <div><label>対象サイト・URL</label><input id=&quot;ck_target&quot; placeholder=&quot;example.com（プレビュー）&quot;></div>
      <div><label>チェック担当</label><input id=&quot;ck_by&quot; placeholder=&quot;石黒 友季子&quot;></div>
    </div>
    <h3>チェック観点</h3>
    <div style=&quot;display:flex;gap:6px;flex-wrap:wrap;margin:4px 0;&quot;>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; style=&quot;margin:0;&quot; onclick=&quot;ckQuick('disp')&quot;>＋表示・レスポンシブ</button>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; style=&quot;margin:0;&quot; onclick=&quot;ckQuick('seo')&quot;>＋SEO・メタ</button>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; style=&quot;margin:0;&quot; onclick=&quot;ckQuick('pub')&quot;>＋公開・運用</button>
    </div>
    <div id=&quot;ckList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;ckAdd()&quot;>＋ 観点を追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildCheck()&quot;>公開前チェック表を生成する</button>
  </div>

  <!-- データ統合 -->
  <div class=&quot;panel&quot; id=&quot;panel-hub&quot;>
    <h2>データ統合（保存・書き出し・取り込み）</h2>
    <p class=&quot;hint&quot;>入力した全データを1つのJSONで保存・復元できます。公開前チェック表はExcelにも書き出せます。</p>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;hubSaveJson()&quot;>💾 全データをJSON保存</button>
      <button onclick=&quot;document.getElementById('hubFile').click()&quot;>📂 JSONを取り込む</button>
      <input type=&quot;file&quot; id=&quot;hubFile&quot; accept=&quot;.json&quot; style=&quot;display:none&quot; onchange=&quot;hubLoadJson(this)&quot;>
      <button onclick=&quot;ckExportXlsx()&quot;>📊 公開前チェック表をExcel出力</button>
      <button onclick=&quot;hubClearAll()&quot;>🗑 全クリア</button>
    </div>
    <p class=&quot;hint&quot;>保存したJSONはこのツールでのみ復元できます。大事なデータはこまめに保存してください。</p>
  </div>

  <!-- 出力 -->
  <div class=&quot;outwrap&quot;>
    <h3>生成結果</h3>
    <pre class=&quot;out&quot; id=&quot;out&quot;>ここに生成結果が表示されます。各タブの「生成する」を押してください。</pre>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;copyOut()&quot;>📋 コピー</button>
      <button onclick=&quot;downloadOut('txt')&quot;>📄 テキスト保存</button>
      <button onclick=&quot;downloadOut('md')&quot;>📝 Markdown保存</button>
      <button onclick=&quot;clearOut()&quot;>クリア</button>
    </div>
  </div>
</div>
<div class=&quot;toast&quot; id=&quot;toast&quot;></div>
<script>
&quot;use strict&quot;;
function $(id){ return document.getElementById(id); }
function v(id){ var el=$(id); return el?(el.value||&quot;&quot;).trim():&quot;&quot;; }
function esc(s){ return (s||&quot;&quot;).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function lines(s){ return (s||&quot;&quot;).split(/\n+/).map(function(x){return x.trim();}).filter(Boolean); }
function toast(m){ var t=$(&quot;toast&quot;); if(!t)return; t.textContent=m; t.classList.add(&quot;show&quot;); setTimeout(function(){t.classList.remove(&quot;show&quot;);},1600); }
function lsAvailable(){ try{ var k=&quot;__t&quot;+Math.random(); window.localStorage.setItem(k,&quot;1&quot;); window.localStorage.removeItem(k); return true; }catch(e){ return false; } }
function nowParts(){
  var d=new Date(), wd=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var mm=(&quot;0&quot;+(d.getMonth()+1)).slice(-2), dd=(&quot;0&quot;+d.getDate()).slice(-2);
  var hh=(&quot;0&quot;+d.getHours()).slice(-2), mi=(&quot;0&quot;+d.getMinutes()).slice(-2);
  return { date:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;）&quot;, time:hh+&quot;:&quot;+mi, datetime:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;） &quot;+hh+&quot;:&quot;+mi };
}
function todayJp(){ return nowParts().date; }
function stamp(){ return nowParts().date.replace(/[^0-9]/g,&quot;&quot;).slice(0,8); }
var BAR=&quot;────────────────────────────&quot;;

var lastOut={txt:&quot;&quot;,md:&quot;&quot;};
function setOut(txt,md){ lastOut.txt=txt||&quot;&quot;; lastOut.md=(md!=null?md:txt)||&quot;&quot;; var o=$(&quot;out&quot;); if(o) o.textContent=lastOut.txt; }
function clearOut(){ setOut(&quot;&quot;); var o=$(&quot;out&quot;); if(o) o.textContent=&quot;&quot;; toast(&quot;クリアしました&quot;); }
function copyOut(){
  var t=lastOut.txt||&quot;&quot;; if(!t){ toast(&quot;生成結果がありません&quot;); return; }
  try{ navigator.clipboard.writeText(t); toast(&quot;コピーしました&quot;); }
  catch(e){ var ta=document.createElement(&quot;textarea&quot;); ta.value=t; document.body.appendChild(ta); ta.select(); try{document.execCommand(&quot;copy&quot;);}catch(_){} document.body.removeChild(ta); toast(&quot;コピーしました&quot;); }
}
function _saveBlob(text,fname,mime){
  try{ var blob=new Blob([text],{type:mime||&quot;text/plain;charset=utf-8&quot;}); var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=fname; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(url);},500); }catch(e){ toast(&quot;保存に失敗しました&quot;); }
}
function downloadOut(fmt){
  if(!lastOut.txt){ toast(&quot;生成結果がありません&quot;); return; }
  if(fmt===&quot;md&quot;){ _saveBlob(lastOut.md,&quot;web_studio_&quot;+stamp()+&quot;.md&quot;,&quot;text/markdown;charset=utf-8&quot;); }
  else{ _saveBlob(lastOut.txt,&quot;web_studio_&quot;+stamp()+&quot;.txt&quot;,&quot;text/plain;charset=utf-8&quot;); }
}

function mkRow(html){ var d=document.createElement(&quot;div&quot;); d.className=&quot;row&quot;; d.innerHTML=html; return d; }
function delRow(btn){ var r=btn.closest(&quot;.row&quot;); if(r) r.remove(); }

/* ---- 要求定義 ---- */
function rqAdd(text,why){
  $(&quot;rqList&quot;).appendChild(mkRow(
    '<input class=&quot;rq-text&quot; placeholder=&quot;要求（例：スマホで予約できるようにしたい）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;>'+
    '<input class=&quot;rq-why&quot; placeholder=&quot;なぜ（理由）&quot; value=&quot;'+esc(why||&quot;&quot;)+'&quot; style=&quot;max-width:40%&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function rqRead(){ return [].slice.call(document.querySelectorAll(&quot;#rqList .row&quot;)).map(function(r){
  return { text:r.querySelector(&quot;.rq-text&quot;).value.trim(), why:r.querySelector(&quot;.rq-why&quot;).value.trim() }; }).filter(function(x){return x.text;}); }
function buildReq(){
  var title=v(&quot;rq_title&quot;)||&quot;（無題サイト）&quot;, date=v(&quot;rq_date&quot;)||todayJp(), reqs=rqRead();
  var o=[];
  o.push(&quot;【Web要求定義書】&quot;+title);
  o.push(&quot;記入日：&quot;+date);
  o.push(&quot;クライアント：&quot;+(v(&quot;rq_client&quot;)||&quot;—&quot;));
  o.push(&quot;サイトの目的：&quot;+(v(&quot;rq_goal&quot;)||&quot;—&quot;));
  o.push(&quot;背景・課題：&quot;+(v(&quot;rq_bg&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 要求一覧&quot;); o.push(BAR);
  if(reqs.length){ reqs.forEach(function(r,i){ o.push(&quot;R&quot;+(i+1)+&quot;. &quot;+r.text+(r.why?(&quot;　（理由：&quot;+r.why+&quot;）&quot;):&quot;&quot;)); }); } else { o.push(&quot;（未入力）&quot;); }
  var m=[&quot;# Web要求定義書：&quot;+title,&quot;&quot;,&quot;- 記入日：&quot;+date,&quot;- クライアント：&quot;+(v(&quot;rq_client&quot;)||&quot;—&quot;),&quot;- サイトの目的：&quot;+(v(&quot;rq_goal&quot;)||&quot;—&quot;),&quot;- 背景・課題：&quot;+(v(&quot;rq_bg&quot;)||&quot;—&quot;),&quot;&quot;,&quot;## 要求一覧&quot;,&quot;&quot;,&quot;| ID | 要求 | 理由 |&quot;,&quot;|---|---|---|&quot;];
  if(reqs.length){ reqs.forEach(function(r,i){ m.push(&quot;| R&quot;+(i+1)+&quot; | &quot;+r.text+&quot; | &quot;+(r.why||&quot;—&quot;)+&quot; |&quot;); }); } else { m.push(&quot;| — | （未入力） | — |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- STUDIO要件整理 ---- */
function spAddFunc(text){ $(&quot;spFunc&quot;).appendChild(mkRow('<input class=&quot;sp-f&quot; placeholder=&quot;〜できること（例：Web予約フォームから送信できる）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;><button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>')); }
function spAddNf(text){ $(&quot;spNf&quot;).appendChild(mkRow('<input class=&quot;sp-nf&quot; placeholder=&quot;非機能（例：表示3秒以内／常時SSL）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;><button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>')); }
function spReadFunc(){ return [].slice.call(document.querySelectorAll(&quot;#spFunc .sp-f&quot;)).map(function(e){return e.value.trim();}).filter(Boolean); }
function spReadNf(){ return [].slice.call(document.querySelectorAll(&quot;#spNf .sp-nf&quot;)).map(function(e){return e.value.trim();}).filter(Boolean); }
function spWebTemplate(){
  if(!v(&quot;sp_scope&quot;)){ $(&quot;sp_scope&quot;).value=&quot;トップ／サービス／実績／お問い合わせ&quot;; }
  [&quot;スマホ・PCで崩れず表示できる（レスポンシブ）&quot;,&quot;お問い合わせ／予約フォームから送信できる&quot;,&quot;CMSでお知らせを更新できる&quot;,&quot;各ページにtitle/meta descriptionを設定できる&quot;].forEach(spAddFunc);
  [&quot;初回表示3秒以内（画像を最適化）&quot;,&quot;常時SSL（https）&quot;,&quot;主要ブラウザで表示崩れなし&quot;].forEach(spAddNf);
  toast(&quot;STUDIO定番要件を入れました&quot;);
}
function buildSpec(){
  var fs=spReadFunc(), nf=spReadNf();
  var o=[];
  o.push(&quot;【STUDIO要件定義書】&quot;);
  o.push(&quot;対象範囲：&quot;+(v(&quot;sp_scope&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 機能要件&quot;); o.push(BAR);
  if(fs.length){ fs.forEach(function(x,i){ o.push(&quot;F&quot;+(i+1)+&quot;. &quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 非機能要件&quot;); o.push(BAR);
  if(nf.length){ nf.forEach(function(x,i){ o.push(&quot;N&quot;+(i+1)+&quot;. &quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(&quot;■ STUDIO特有&quot;);
  o.push(&quot;レスポンシブ：&quot;+v(&quot;sp_resp&quot;));
  o.push(&quot;CMS：&quot;+v(&quot;sp_cms&quot;));
  o.push(&quot;独自ドメイン：&quot;+(v(&quot;sp_domain&quot;)||&quot;—&quot;));
  o.push(&quot;公開プラン・制約：&quot;+(v(&quot;sp_plan&quot;)||&quot;—&quot;));
  var m=[&quot;# STUDIO要件定義書&quot;,&quot;&quot;,&quot;対象範囲：&quot;+(v(&quot;sp_scope&quot;)||&quot;—&quot;),&quot;&quot;,&quot;## 機能要件&quot;,&quot;&quot;];
  if(fs.length){ fs.forEach(function(x,i){ m.push(&quot;- **F&quot;+(i+1)+&quot;**：&quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## 非機能要件&quot;); m.push(&quot;&quot;);
  if(nf.length){ nf.forEach(function(x,i){ m.push(&quot;- **N&quot;+(i+1)+&quot;**：&quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## STUDIO特有&quot;); m.push(&quot;&quot;);
  m.push(&quot;- レスポンシブ：&quot;+v(&quot;sp_resp&quot;)); m.push(&quot;- CMS：&quot;+v(&quot;sp_cms&quot;)); m.push(&quot;- 独自ドメイン：&quot;+(v(&quot;sp_domain&quot;)||&quot;—&quot;)); m.push(&quot;- 公開プラン・制約：&quot;+(v(&quot;sp_plan&quot;)||&quot;—&quot;));
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- 実装タスク分割 ---- */
function tkAdd(name,owner,est,status){
  $(&quot;tkList&quot;).appendChild(mkRow(
    '<input class=&quot;tk-name&quot; placeholder=&quot;タスク（例：トップのワイヤー作成）&quot; value=&quot;'+esc(name||&quot;&quot;)+'&quot;>'+
    '<input class=&quot;tk-owner&quot; placeholder=&quot;担当&quot; value=&quot;'+esc(owner||&quot;&quot;)+'&quot; style=&quot;max-width:18%&quot;>'+
    '<input class=&quot;tk-est&quot; placeholder=&quot;見積h&quot; value=&quot;'+esc(est||&quot;&quot;)+'&quot; style=&quot;max-width:12%&quot;>'+
    '<select class=&quot;tk-st&quot; style=&quot;max-width:18%&quot;>'+
      ['未着手','着手中','レビュー','完了'].map(function(s){ return '<option'+(status===s?' selected':'')+'>'+s+'</option>'; }).join(&quot;&quot;)+
    '</select>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function tkTemplate(){
  [[&quot;要件・サイトマップ確定&quot;,&quot;&quot;,&quot;&quot;],[&quot;デザインカンプ作成&quot;,&quot;&quot;,&quot;&quot;],[&quot;STUDIOでトップ実装&quot;,&quot;&quot;,&quot;&quot;],[&quot;下層ページ実装&quot;,&quot;&quot;,&quot;&quot;],[&quot;レスポンシブ調整&quot;,&quot;&quot;,&quot;&quot;],[&quot;CMS設定・お知らせ投入&quot;,&quot;&quot;,&quot;&quot;],[&quot;フォーム設定・テスト&quot;,&quot;&quot;,&quot;&quot;],[&quot;公開前チェック&quot;,&quot;&quot;,&quot;&quot;],[&quot;独自ドメイン接続・公開&quot;,&quot;&quot;,&quot;&quot;]].forEach(function(t){ tkAdd(t[0],t[1],t[2],&quot;未着手&quot;); });
  toast(&quot;STUDIO定番タスクを入れました&quot;);
}
function tkRead(){ return [].slice.call(document.querySelectorAll(&quot;#tkList .row&quot;)).map(function(r){
  return { name:r.querySelector(&quot;.tk-name&quot;).value.trim(), owner:r.querySelector(&quot;.tk-owner&quot;).value.trim(), est:r.querySelector(&quot;.tk-est&quot;).value.trim(), st:r.querySelector(&quot;.tk-st&quot;).value }; }).filter(function(x){return x.name;}); }
function buildTask(){
  var ts=tkRead();
  var o=[];
  o.push(&quot;【実装タスク表（WBS）】&quot;);
  o.push(&quot;マイルストーン：&quot;+(v(&quot;tk_milestone&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ タスク一覧&quot;); o.push(BAR);
  if(ts.length){ ts.forEach(function(t,i){ o.push(&quot;[&quot;+t.st+&quot;] &quot;+(i+1)+&quot;. &quot;+t.name+(t.owner?(&quot;　担当:&quot;+t.owner):&quot;&quot;)+(t.est?(&quot;　見積:&quot;+t.est+&quot;h&quot;):&quot;&quot;)); }); } else { o.push(&quot;（未入力）&quot;); }
  var done=ts.filter(function(t){return t.st===&quot;完了&quot;;}).length;
  if(ts.length){ o.push(&quot;&quot;); o.push(&quot;進捗：&quot;+done+&quot;/&quot;+ts.length+&quot;完了&quot;); }
  var m=[&quot;# 実装タスク表（WBS）&quot;,&quot;&quot;,&quot;マイルストーン：&quot;+(v(&quot;tk_milestone&quot;)||&quot;—&quot;),&quot;&quot;,&quot;| 状態 | # | タスク | 担当 | 見積(h) |&quot;,&quot;|---|---|---|---|---|&quot;];
  if(ts.length){ ts.forEach(function(t,i){ m.push(&quot;| &quot;+t.st+&quot; | &quot;+(i+1)+&quot; | &quot;+t.name+&quot; | &quot;+(t.owner||&quot;—&quot;)+&quot; | &quot;+(t.est||&quot;—&quot;)+&quot; |&quot;); }); } else { m.push(&quot;| — | — | （未入力） | — | — |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- サイト設計 ---- */
function siteAdd(name,role){
  $(&quot;siteList&quot;).appendChild(mkRow(
    '<input class=&quot;site-n&quot; placeholder=&quot;ページ名（例：トップ）&quot; value=&quot;'+esc(name||&quot;&quot;)+'&quot;>'+
    '<input class=&quot;site-r&quot; placeholder=&quot;役割・目的&quot; value=&quot;'+esc(role||&quot;&quot;)+'&quot; style=&quot;max-width:55%&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function siteTemplate(){
  [[&quot;トップ&quot;,&quot;サイトの第一印象・全体への導線&quot;],[&quot;サービス／診療案内&quot;,&quot;提供内容を伝える&quot;],[&quot;実績／症例&quot;,&quot;信頼感を高める&quot;],[&quot;お客様の声&quot;,&quot;安心材料を提示&quot;],[&quot;会社概要／医師紹介&quot;,&quot;運営者の信頼性&quot;],[&quot;アクセス&quot;,&quot;場所・行き方・地図&quot;],[&quot;お問い合わせ／予約&quot;,&quot;CV（コンバージョン）地点&quot;]].forEach(function(p){ siteAdd(p[0],p[1]); });
  toast(&quot;定番ページ構成を入れました&quot;);
}
function siteRead(){ return [].slice.call(document.querySelectorAll(&quot;#siteList .row&quot;)).map(function(r){
  return { name:r.querySelector(&quot;.site-n&quot;).value.trim(), role:r.querySelector(&quot;.site-r&quot;).value.trim() }; }).filter(function(x){return x.name;}); }
function buildSite(){
  var ps=siteRead();
  var o=[];
  o.push(&quot;【サイト設計書】&quot;);
  o.push(&quot;目的：&quot;+(v(&quot;st_goal&quot;)||&quot;—&quot;));
  o.push(&quot;ターゲット：&quot;+(v(&quot;st_target&quot;)||&quot;—&quot;));
  o.push(&quot;トーン＆マナー：&quot;+(v(&quot;st_tone&quot;)||&quot;—&quot;));
  o.push(&quot;参考・方向性：&quot;+(v(&quot;st_ref&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ ページ構成（サイトマップ）&quot;); o.push(BAR);
  if(ps.length){ ps.forEach(function(p,i){ o.push((i+1)+&quot;. &quot;+p.name+(p.role?(&quot;　― &quot;+p.role):&quot;&quot;)); }); } else { o.push(&quot;（未入力）&quot;); }
  var m=[&quot;# サイト設計書&quot;,&quot;&quot;,&quot;- 目的：&quot;+(v(&quot;st_goal&quot;)||&quot;—&quot;),&quot;- ターゲット：&quot;+(v(&quot;st_target&quot;)||&quot;—&quot;),&quot;- トーン＆マナー：&quot;+(v(&quot;st_tone&quot;)||&quot;—&quot;),&quot;- 参考・方向性：&quot;+(v(&quot;st_ref&quot;)||&quot;—&quot;),&quot;&quot;,&quot;## ページ構成（サイトマップ）&quot;,&quot;&quot;];
  if(ps.length){ ps.forEach(function(p,i){ m.push((i+1)+&quot;. **&quot;+p.name+&quot;** — &quot;+(p.role||&quot;—&quot;)); }); } else { m.push(&quot;1. （未入力）&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- セクション設計 ---- */
function secAdd(name,elem,cta){
  $(&quot;secList&quot;).appendChild(mkRow(
    '<input class=&quot;sec-n&quot; placeholder=&quot;セクション（例：ファーストビュー）&quot; value=&quot;'+esc(name||&quot;&quot;)+'&quot;>'+
    '<input class=&quot;sec-e&quot; placeholder=&quot;要素・内容&quot; value=&quot;'+esc(elem||&quot;&quot;)+'&quot; style=&quot;max-width:40%&quot;>'+
    '<input class=&quot;sec-c&quot; placeholder=&quot;CTA(任意)&quot; value=&quot;'+esc(cta||&quot;&quot;)+'&quot; style=&quot;max-width:22%&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function secTemplate(){
  [[&quot;ファーストビュー&quot;,&quot;キャッチコピー＋メイン画像＋主要CTA&quot;,&quot;予約する&quot;],[&quot;課題提起&quot;,&quot;訪問者の悩みに共感&quot;,&quot;&quot;],[&quot;提供価値・特徴&quot;,&quot;選ばれる理由を3点&quot;,&quot;&quot;],[&quot;サービス内容&quot;,&quot;具体的な内容・料金&quot;,&quot;&quot;],[&quot;お客様の声&quot;,&quot;実例・レビュー&quot;,&quot;&quot;],[&quot;よくある質問&quot;,&quot;不安の解消&quot;,&quot;&quot;],[&quot;最後のCTA&quot;,&quot;背中を押す一言＋ボタン&quot;,&quot;今すぐ予約&quot;]].forEach(function(s){ secAdd(s[0],s[1],s[2]); });
  toast(&quot;LP定番セクションを入れました&quot;);
}
function secRead(){ return [].slice.call(document.querySelectorAll(&quot;#secList .row&quot;)).map(function(r){
  return { name:r.querySelector(&quot;.sec-n&quot;).value.trim(), elem:r.querySelector(&quot;.sec-e&quot;).value.trim(), cta:r.querySelector(&quot;.sec-c&quot;).value.trim() }; }).filter(function(x){return x.name;}); }
function buildSec(){
  var ss=secRead(), page=v(&quot;sc_page&quot;)||&quot;（対象ページ）&quot;;
  var o=[];
  o.push(&quot;【セクション設計（ワイヤー）】&quot;+page);
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 上から並ぶセクション&quot;); o.push(BAR);
  if(ss.length){ ss.forEach(function(s,i){
    o.push(&quot;─ [&quot;+(i+1)+&quot;] &quot;+s.name+&quot; ─&quot;);
    if(s.elem) o.push(&quot;　要素：&quot;+s.elem);
    if(s.cta) o.push(&quot;　CTA：&quot;+s.cta);
  }); } else { o.push(&quot;（未入力）&quot;); }
  var m=[&quot;# セクション設計（ワイヤー）：&quot;+page,&quot;&quot;];
  if(ss.length){ ss.forEach(function(s,i){ m.push(&quot;## &quot;+(i+1)+&quot;. &quot;+s.name); if(s.elem) m.push(&quot;- 要素：&quot;+s.elem); if(s.cta) m.push(&quot;- CTA：&quot;+s.cta); m.push(&quot;&quot;); }); } else { m.push(&quot;（未入力）&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- コンテンツ整理 ---- */
function copyAdd(head,body){
  $(&quot;copyList&quot;).appendChild(mkRow(
    '<input class=&quot;cp-h&quot; placeholder=&quot;見出し&quot; value=&quot;'+esc(head||&quot;&quot;)+'&quot; style=&quot;max-width:34%&quot;>'+
    '<input class=&quot;cp-b&quot; placeholder=&quot;本文&quot; value=&quot;'+esc(body||&quot;&quot;)+'&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function copyRead(){ return [].slice.call(document.querySelectorAll(&quot;#copyList .row&quot;)).map(function(r){
  return { head:r.querySelector(&quot;.cp-h&quot;).value.trim(), body:r.querySelector(&quot;.cp-b&quot;).value.trim() }; }).filter(function(x){return x.head||x.body;}); }
function buildCopy(){
  var blocks=copyRead();
  var o=[];
  o.push(&quot;【コンテンツ原稿】&quot;);
  o.push(&quot;キャッチコピー：&quot;+(v(&quot;cp_catch&quot;)||&quot;—&quot;));
  o.push(&quot;サブコピー：&quot;+(v(&quot;cp_sub&quot;)||&quot;—&quot;));
  o.push(&quot;主要CTA：&quot;+(v(&quot;cp_cta&quot;)||&quot;—&quot;)+(v(&quot;cp_cta2&quot;)?(&quot;　／サブCTA：&quot;+v(&quot;cp_cta2&quot;)):&quot;&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 本文ブロック&quot;); o.push(BAR);
  if(blocks.length){ blocks.forEach(function(b,i){ o.push(&quot;【&quot;+(b.head||&quot;（見出しなし）&quot;)+&quot;】&quot;); if(b.body) o.push(b.body); o.push(&quot;&quot;); }); } else { o.push(&quot;（未入力）&quot;); }
  var m=[&quot;# コンテンツ原稿&quot;,&quot;&quot;,&quot;- キャッチコピー：&quot;+(v(&quot;cp_catch&quot;)||&quot;—&quot;),&quot;- サブコピー：&quot;+(v(&quot;cp_sub&quot;)||&quot;—&quot;),&quot;- 主要CTA：&quot;+(v(&quot;cp_cta&quot;)||&quot;—&quot;),&quot;- サブCTA：&quot;+(v(&quot;cp_cta2&quot;)||&quot;—&quot;),&quot;&quot;,&quot;## 本文ブロック&quot;,&quot;&quot;];
  if(blocks.length){ blocks.forEach(function(b){ m.push(&quot;### &quot;+(b.head||&quot;（見出しなし）&quot;)); if(b.body) m.push(b.body); m.push(&quot;&quot;); }); } else { m.push(&quot;（未入力）&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- 公開前チェック ---- */
function ckAdd(text,result){
  var rv=result||&quot;&quot;;
  $(&quot;ckList&quot;).appendChild(mkRow(
    '<input class=&quot;ck-v&quot; placeholder=&quot;観点（例：スマホで崩れない）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;>'+
    '<select class=&quot;ck-r&quot; style=&quot;max-width:110px&quot;>'+
      ['','OK','NG','N/A'].map(function(x){ var lbl=x===&quot;&quot;?&quot;未&quot;:(x===&quot;N/A&quot;?&quot;該当なし&quot;:x); return '<option value=&quot;'+x+'&quot;'+(rv===x?' selected':'')+'>'+lbl+'</option>'; }).join(&quot;&quot;)+
    '</select>'+
    '<input class=&quot;ck-note&quot; placeholder=&quot;所見&quot; value=&quot;&quot; style=&quot;max-width:28%&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>'));
}
function ckQuick(kind){
  var sets={
    disp:[&quot;主要ブラウザ（Chrome/Safari/Edge）で表示崩れがない&quot;,&quot;スマホ・タブレット・PCでレスポンシブに表示される&quot;,&quot;画像が粗くない・はみ出さない&quot;,&quot;フォント・余白が崩れていない&quot;],
    seo:[&quot;各ページにtitle/meta descriptionが設定されている&quot;,&quot;OGP（SNSシェア画像）が設定されている&quot;,&quot;画像にalt（代替テキスト）がある&quot;,&quot;見出し階層（h1→h2）が適切&quot;],
    pub:[&quot;フォーム送信・自動返信が正しく動く&quot;,&quot;リンク切れ・404がない&quot;,&quot;独自ドメイン・httpsが有効&quot;,&quot;アクセス解析（計測タグ）が入っている&quot;,&quot;公開範囲・パスワード設定が意図どおり&quot;]
  };
  (sets[kind]||sets.disp).forEach(function(x){ ckAdd(x); });
  toast(&quot;観点を追加しました&quot;);
}
function ckRead(){ return [].slice.call(document.querySelectorAll(&quot;#ckList .row&quot;)).map(function(r){
  return { v:r.querySelector(&quot;.ck-v&quot;).value.trim(), r:r.querySelector(&quot;.ck-r&quot;).value, note:r.querySelector(&quot;.ck-note&quot;).value.trim() }; }).filter(function(x){return x.v;}); }
function buildCheck(){
  var target=v(&quot;ck_target&quot;)||&quot;（対象未入力）&quot;, by=v(&quot;ck_by&quot;)||&quot;—&quot;, items=ckRead();
  var ok=items.filter(function(x){return x.r===&quot;OK&quot;;}).length, ng=items.filter(function(x){return x.r===&quot;NG&quot;;}).length;
  var na=items.filter(function(x){return x.r===&quot;N/A&quot;;}).length, un=items.filter(function(x){return !x.r;}).length;
  var o=[];
  o.push(&quot;【公開前チェック表】&quot;+target);
  o.push(&quot;担当：&quot;+by+&quot;　日付：&quot;+todayJp());
  o.push(&quot;結果：OK &quot;+ok+&quot;／NG &quot;+ng+&quot;／該当なし &quot;+na+&quot;／未 &quot;+un+&quot;（全 &quot;+items.length+&quot;件）&quot;);
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ チェック結果&quot;); o.push(BAR);
  if(items.length){ items.forEach(function(x,i){ o.push(&quot;[&quot;+(x.r||&quot;未&quot;)+&quot;] &quot;+(i+1)+&quot;. &quot;+x.v+(x.note?(&quot;　／所見：&quot;+x.note):&quot;&quot;)); }); } else { o.push(&quot;（未入力）&quot;); }
  if(ng>0){ o.push(&quot;&quot;); o.push(&quot;⚠️ NGが&quot;+ng+&quot;件。公開前に是正が必要です。&quot;); }
  else if(items.length&amp;&amp;un===0){ o.push(&quot;&quot;); o.push(&quot;✅ NGなし。公開判断OKです。&quot;); }
  var m=[&quot;# 公開前チェック表：&quot;+target,&quot;&quot;,&quot;- 担当：&quot;+by,&quot;- 日付：&quot;+todayJp(),&quot;- 結果：OK &quot;+ok+&quot; / NG &quot;+ng+&quot; / 該当なし &quot;+na+&quot; / 未 &quot;+un+&quot;（全 &quot;+items.length+&quot;件）&quot;,&quot;&quot;,&quot;| 結果 | # | 観点 | 所見 |&quot;,&quot;|---|---|---|---|&quot;];
  if(items.length){ items.forEach(function(x,i){ m.push(&quot;| &quot;+(x.r||&quot;未&quot;)+&quot; | &quot;+(i+1)+&quot; | &quot;+x.v+&quot; | &quot;+(x.note||&quot;—&quot;)+&quot; |&quot;); }); } else { m.push(&quot;| — | — | （未入力） | — |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- Excel(.xlsx) ---- */
function _crc32(b){ var c,crc=0xFFFFFFFF; for(var i=0;i<b.length;i++){ c=(crc^b[i])&amp;0xFF; for(var k=0;k<8;k++){ c=(c&amp;1)?(0xEDB88320^(c>>>1)):(c>>>1); } crc=(crc>>>8)^c; } return (crc^0xFFFFFFFF)>>>0; }
function _sb(s){ return new TextEncoder().encode(s); }
function _u16(n){ return [n&amp;0xFF,(n>>>8)&amp;0xFF]; }
function _u32(n){ return [n&amp;0xFF,(n>>>8)&amp;0xFF,(n>>>16)&amp;0xFF,(n>>>24)&amp;0xFF]; }
function _S(s){ return {t:&quot;s&quot;,v:(s==null?&quot;&quot;:String(s))}; }
function _N(n){ return {t:&quot;n&quot;,v:n}; }
function _col(i){ var s=&quot;&quot;; i++; while(i>0){ var m=(i-1)%26; s=String.fromCharCode(65+m)+s; i=Math.floor((i-1)/26); } return s; }
function _sheetXml(rows){
  var xml='<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><worksheet xmlns=&quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot;><sheetData>';
  for(var r=0;r<rows.length;r++){ xml+='<row r=&quot;'+(r+1)+'&quot;>';
    for(var c=0;c<rows[r].length;c++){ var cell=rows[r][c], ref=_col(c)+(r+1);
      if(cell&amp;&amp;cell.t===&quot;n&quot;){ xml+='<c r=&quot;'+ref+'&quot;><v>'+cell.v+'</v></c>'; }
      else{ var t=(cell&amp;&amp;cell.v!=null)?String(cell.v):&quot;&quot;; xml+='<c r=&quot;'+ref+'&quot; t=&quot;inlineStr&quot;><is><t xml:space=&quot;preserve&quot;>'+esc(t)+'</t></is></c>'; } }
    xml+='</row>'; }
  xml+='</sheetData></worksheet>'; return xml;
}
function _zipStore(files){
  var chunks=[],central=[],offset=0;
  files.forEach(function(f){ var nameB=_sb(f.name),dataB=f.data,crc=_crc32(dataB);
    var lh=[].concat(_u32(0x04034b50),_u16(20),_u16(0),_u16(0),_u16(0),_u16(0),_u32(crc),_u32(dataB.length),_u32(dataB.length),_u16(nameB.length),_u16(0));
    chunks.push(new Uint8Array(lh)); chunks.push(nameB); chunks.push(dataB);
    var ch=[].concat(_u32(0x02014b50),_u16(20),_u16(20),_u16(0),_u16(0),_u16(0),_u16(0),_u32(crc),_u32(dataB.length),_u32(dataB.length),_u16(nameB.length),_u16(0),_u16(0),_u16(0),_u16(0),_u32(0),_u32(offset));
    central.push(new Uint8Array(ch)); central.push(nameB); offset+=lh.length+nameB.length+dataB.length; });
  var cstart=offset,csize=0; central.forEach(function(c){ csize+=c.length; });
  var end=[].concat(_u32(0x06054b50),_u16(0),_u16(0),_u16(files.length),_u16(files.length),_u32(csize),_u32(cstart),_u16(0));
  var all=[]; chunks.forEach(function(c){all.push(c);}); central.forEach(function(c){all.push(c);}); all.push(new Uint8Array(end));
  var total=0; all.forEach(function(a){total+=a.length;}); var out=new Uint8Array(total),p=0; all.forEach(function(a){ out.set(a,p); p+=a.length; }); return out;
}
function _buildXlsx(sheets){
  var files=[];
  files.push({name:&quot;[Content_Types].xml&quot;,data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Types xmlns=&quot;http://schemas.openxmlformats.org/package/2006/content-types&quot;><Default Extension=&quot;rels&quot; ContentType=&quot;application/vnd.openxmlformats-package.relationships+xml&quot;/><Default Extension=&quot;xml&quot; ContentType=&quot;application/xml&quot;/><Override PartName=&quot;/xl/workbook.xml&quot; ContentType=&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml&quot;/>'+sheets.map(function(s,i){return '<Override PartName=&quot;/xl/worksheets/sheet'+(i+1)+'.xml&quot; ContentType=&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml&quot;/>';}).join(&quot;&quot;)+'</Types>')});
  files.push({name:&quot;_rels/.rels&quot;,data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Relationships xmlns=&quot;http://schemas.openxmlformats.org/package/2006/relationships&quot;><Relationship Id=&quot;rId1&quot; Type=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument&quot; Target=&quot;xl/workbook.xml&quot;/></Relationships>')});
  files.push({name:&quot;xl/workbook.xml&quot;,data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><workbook xmlns=&quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot; xmlns:r=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships&quot;><sheets>'+sheets.map(function(s,i){return '<sheet name=&quot;'+esc(s.name)+'&quot; sheetId=&quot;'+(i+1)+'&quot; r:id=&quot;rId'+(i+1)+'&quot;/>';}).join(&quot;&quot;)+'</sheets></workbook>')});
  files.push({name:&quot;xl/_rels/workbook.xml.rels&quot;,data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Relationships xmlns=&quot;http://schemas.openxmlformats.org/package/2006/relationships&quot;>'+sheets.map(function(s,i){return '<Relationship Id=&quot;rId'+(i+1)+'&quot; Type=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet&quot; Target=&quot;worksheets/sheet'+(i+1)+'.xml&quot;/>';}).join(&quot;&quot;)+'</Relationships>')});
  sheets.forEach(function(s,i){ files.push({name:&quot;xl/worksheets/sheet&quot;+(i+1)+&quot;.xml&quot;,data:_sb(_sheetXml(s.rows))}); });
  return _zipStore(files);
}
function ckExportXlsx(){
  var items=ckRead();
  var rows=[[_S(&quot;結果&quot;),_S(&quot;#&quot;),_S(&quot;観点&quot;),_S(&quot;所見&quot;)]];
  if(items.length){ items.forEach(function(x,i){ rows.push([_S(x.r||&quot;未&quot;),_N(i+1),_S(x.v),_S(x.note)]); }); } else { rows.push([_S(&quot;—&quot;),_S(&quot;—&quot;),_S(&quot;（未入力）&quot;),_S(&quot;—&quot;)]); }
  var meta=[[_S(&quot;対象&quot;),_S(v(&quot;ck_target&quot;))],[_S(&quot;担当&quot;),_S(v(&quot;ck_by&quot;))],[_S(&quot;日付&quot;),_S(todayJp())]];
  try{ var u8=_buildXlsx([{name:&quot;公開前チェック表&quot;,rows:rows},{name:&quot;情報&quot;,rows:meta}]);
    var blob=new Blob([u8],{type:&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet&quot;}); var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=&quot;公開前チェック表_&quot;+stamp()+&quot;.xlsx&quot;; document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){URL.revokeObjectURL(url);},500); toast(&quot;Excelを書き出しました&quot;); }catch(e){ toast(&quot;Excel出力に失敗しました&quot;); }
}

/* ---- データ統合（JSON） ---- */
function collectAll(){
  return { _app:&quot;usausa_web_studio&quot;, _ver:&quot;1.0&quot;, _saved:nowParts().datetime,
    req:{ title:v(&quot;rq_title&quot;),date:v(&quot;rq_date&quot;),client:v(&quot;rq_client&quot;),goal:v(&quot;rq_goal&quot;),bg:v(&quot;rq_bg&quot;),list:rqRead() },
    spec:{ scope:v(&quot;sp_scope&quot;),func:spReadFunc(),nf:spReadNf(),resp:v(&quot;sp_resp&quot;),cms:v(&quot;sp_cms&quot;),domain:v(&quot;sp_domain&quot;),plan:v(&quot;sp_plan&quot;) },
    task:{ milestone:v(&quot;tk_milestone&quot;),list:tkRead() },
    site:{ goal:v(&quot;st_goal&quot;),target:v(&quot;st_target&quot;),tone:v(&quot;st_tone&quot;),ref:v(&quot;st_ref&quot;),pages:siteRead() },
    sec:{ page:v(&quot;sc_page&quot;),list:secRead() },
    copy:{ catch:v(&quot;cp_catch&quot;),sub:v(&quot;cp_sub&quot;),cta:v(&quot;cp_cta&quot;),cta2:v(&quot;cp_cta2&quot;),blocks:copyRead() },
    check:{ target:v(&quot;ck_target&quot;),by:v(&quot;ck_by&quot;),items:ckRead() }
  };
}
function hubSaveJson(){ _saveBlob(JSON.stringify(collectAll(),null,2),&quot;web_studio_data_&quot;+stamp()+&quot;.json&quot;,&quot;application/json;charset=utf-8&quot;); toast(&quot;全データをJSON保存しました&quot;); }
function applyAll(d){
  if(!d||typeof d!==&quot;object&quot;) return;
  function set(id,val){ var el=$(id); if(el) el.value=(val||&quot;&quot;); }
  if(d.req){ set(&quot;rq_title&quot;,d.req.title); set(&quot;rq_date&quot;,d.req.date); set(&quot;rq_client&quot;,d.req.client); set(&quot;rq_goal&quot;,d.req.goal); set(&quot;rq_bg&quot;,d.req.bg);
    $(&quot;rqList&quot;).innerHTML=&quot;&quot;; (d.req.list||[]).forEach(function(r){ rqAdd(r.text,r.why); }); }
  if(d.spec){ set(&quot;sp_scope&quot;,d.spec.scope); set(&quot;sp_resp&quot;,d.spec.resp); set(&quot;sp_cms&quot;,d.spec.cms); set(&quot;sp_domain&quot;,d.spec.domain); set(&quot;sp_plan&quot;,d.spec.plan);
    $(&quot;spFunc&quot;).innerHTML=&quot;&quot;; (d.spec.func||[]).forEach(spAddFunc); $(&quot;spNf&quot;).innerHTML=&quot;&quot;; (d.spec.nf||[]).forEach(spAddNf); }
  if(d.task){ set(&quot;tk_milestone&quot;,d.task.milestone); $(&quot;tkList&quot;).innerHTML=&quot;&quot;; (d.task.list||[]).forEach(function(t){ tkAdd(t.name,t.owner,t.est,t.st); }); }
  if(d.site){ set(&quot;st_goal&quot;,d.site.goal); set(&quot;st_target&quot;,d.site.target); set(&quot;st_tone&quot;,d.site.tone); set(&quot;st_ref&quot;,d.site.ref);
    $(&quot;siteList&quot;).innerHTML=&quot;&quot;; (d.site.pages||[]).forEach(function(p){ siteAdd(p.name,p.role); }); }
  if(d.sec){ set(&quot;sc_page&quot;,d.sec.page); $(&quot;secList&quot;).innerHTML=&quot;&quot;; (d.sec.list||[]).forEach(function(s){ secAdd(s.name,s.elem,s.cta); }); }
  if(d.copy){ set(&quot;cp_catch&quot;,d.copy.catch); set(&quot;cp_sub&quot;,d.copy.sub); set(&quot;cp_cta&quot;,d.copy.cta); set(&quot;cp_cta2&quot;,d.copy.cta2);
    $(&quot;copyList&quot;).innerHTML=&quot;&quot;; (d.copy.blocks||[]).forEach(function(b){ copyAdd(b.head,b.body); }); }
  if(d.check){ set(&quot;ck_target&quot;,d.check.target); set(&quot;ck_by&quot;,d.check.by);
    $(&quot;ckList&quot;).innerHTML=&quot;&quot;; (d.check.items||[]).forEach(function(x){ ckAdd(x.v,x.r); var rows=document.querySelectorAll(&quot;#ckList .row&quot;); var last=rows[rows.length-1]; if(last&amp;&amp;x.note) last.querySelector(&quot;.ck-note&quot;).value=x.note; }); }
}
function hubLoadJson(input){
  var f=input&amp;&amp;input.files&amp;&amp;input.files[0]; if(!f){ return; }
  var rd=new FileReader();
  rd.onload=function(){ try{ applyAll(JSON.parse(rd.result)); toast(&quot;JSONを取り込みました&quot;); }catch(e){ toast(&quot;JSONの読み込みに失敗しました&quot;); } input.value=&quot;&quot;; };
  rd.readAsText(f);
}
function hubClearAll(){
  if(!window.confirm(&quot;すべての入力をクリアします。よろしいですか？&quot;)) return;
  [&quot;rq_title&quot;,&quot;rq_date&quot;,&quot;rq_client&quot;,&quot;rq_goal&quot;,&quot;rq_bg&quot;,&quot;sp_scope&quot;,&quot;sp_domain&quot;,&quot;sp_plan&quot;,&quot;tk_milestone&quot;,&quot;st_goal&quot;,&quot;st_target&quot;,&quot;st_tone&quot;,&quot;st_ref&quot;,&quot;sc_page&quot;,&quot;cp_catch&quot;,&quot;cp_sub&quot;,&quot;cp_cta&quot;,&quot;cp_cta2&quot;,&quot;ck_target&quot;,&quot;ck_by&quot;].forEach(function(id){ var el=$(id); if(el) el.value=&quot;&quot;; });
  [&quot;rqList&quot;,&quot;spFunc&quot;,&quot;spNf&quot;,&quot;tkList&quot;,&quot;siteList&quot;,&quot;secList&quot;,&quot;copyList&quot;,&quot;ckList&quot;].forEach(function(id){ var el=$(id); if(el) el.innerHTML=&quot;&quot;; });
  setOut(&quot;&quot;); $(&quot;out&quot;).textContent=&quot;&quot;;
  rqAdd(); spAddFunc(); spAddNf(); tkAdd(); siteAdd(); secAdd(); copyAdd(); ckAdd();
  toast(&quot;全クリアしました&quot;);
}

/* ---- タブ ---- */
function switchPanel(tab){
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.classList.toggle(&quot;active&quot;, t.dataset.tab===tab); });
  [].slice.call(document.querySelectorAll(&quot;.panel&quot;)).forEach(function(p){ p.classList.toggle(&quot;active&quot;, p.id===&quot;panel-&quot;+tab); });
}

/* ---- init ---- */
(function(){
  rqAdd(); spAddFunc(); spAddNf(); tkAdd(); siteAdd(); secAdd(); copyAdd(); ckAdd();
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.addEventListener(&quot;click&quot;, function(){ switchPanel(t.dataset.tab); }); });
  try{ var vt=$(&quot;ver_today&quot;); if(vt) vt.textContent=nowParts().date; }catch(e){}
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-qa" title="品質保証ジェネレーター" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ 品質保証ジェネレーター 🐰</title>
<style>
  *{box-sizing:border-box;}
  :root{ --radius:14px; }
  /* テーマ：日本語＝ブルー（品質・信頼） */
  body.theme-jp{
    --cream:#f5f8fc; --cream2:#eaf1f9; --paper:#ffffff; --orange:#2f6fb0; --orange-deep:#1f4f86;
    --gold:#6fa3d6; --gold-soft:#c5dcef; --ink:#22303f; --ink-soft:#566578;
    --line:#d6e2f0; --line-soft:#e8f0f9; --ok:#3f8f5f; --ng:#d24b4b;
    --shadow:0 10px 30px rgba(47,111,176,.12);
    --accent:#2f6fb0; --accent-deep:#1f4f86;
    --headfont:&quot;Hiragino Sans&quot;,&quot;Hiragino Kaku Gothic ProN&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;
  }
  /* テーマ：英語＝スレート＋ティール（クリーンなプロダクト調） */
  body.theme-uk{
    --cream:#f4f6f7; --cream2:#e9eef0; --paper:#ffffff; --orange:#0f766e; --orange-deep:#0b5751;
    --gold:#5eaaa2; --gold-soft:#bfe0db; --ink:#1f2933; --ink-soft:#56636e;
    --line:#d8e0e2; --line-soft:#eaf0f0; --ok:#3f8f5f; --ng:#d24b4b;
    --shadow:0 10px 30px rgba(15,118,110,.12);
    --accent:#0f766e; --accent-deep:#0b5751;
    --headfont:&quot;Helvetica Neue&quot;,Helvetica,Arial,&quot;Segoe UI&quot;,sans-serif;
  }
  body.theme-uk h1, body.theme-uk h2, body.theme-uk header.hero h1{font-family:var(--headfont);letter-spacing:.2px;}

  body{margin:0;font-family:&quot;Hiragino Sans&quot;,&quot;Yu Gothic&quot;,&quot;Meiryo&quot;,sans-serif;color:var(--ink);
    background:linear-gradient(160deg,var(--bg1,#dde9f5),var(--cream) 40%);min-height:100vh;line-height:1.7;}
  .wrap{max-width:980px;margin:0 auto;padding:18px 16px 80px;}

  header.hero{position:relative;margin-top:32px;background:var(--paper);border:1px solid var(--line);
    border-radius:22px;padding:26px 30px;box-shadow:var(--shadow);overflow:hidden;}
  header.hero::before{content:&quot;&quot;;position:absolute;inset:0 0 auto 0;height:6px;
    background:linear-gradient(90deg,var(--gold-soft),var(--accent),var(--gold));}
  header.hero h1{margin:0 0 6px;font-size:1.4rem;font-weight:800;padding-right:46px;min-height:34px;}
  header.hero p{margin:0;color:var(--ink-soft);font-size:.92rem;padding-right:46px;}
  .ver-badge{display:flex;gap:8px;align-items:center;margin:0 0 8px;flex-wrap:wrap;}
  .ver-pill{display:inline-block;background:var(--accent);color:#fff;font-weight:800;font-size:.72rem;
    letter-spacing:.3px;padding:2px 9px;border-radius:999px;}
  .ver-date,.ver-today{color:var(--ink-soft);font-size:.74rem;}
  .ver-today:not(:empty)::before{content:&quot;｜ 今日 &quot;;opacity:.8;}
  .bunny{position:absolute;top:50px;right:24px;font-size:30px;filter:drop-shadow(0 4px 8px rgba(47,111,176,.25));}
  .lang-switch{position:absolute;top:14px;right:16px;display:flex;gap:6px;z-index:2;}
  .lang-btn{border:1px solid var(--line);background:var(--paper);color:var(--ink-soft);border-radius:999px;
    padding:5px 12px;cursor:pointer;font-weight:700;font-size:.78rem;}
  .lang-btn.active{background:linear-gradient(135deg,var(--accent),var(--gold));color:#fff;border-color:transparent;}

  .tabs{display:flex;gap:8px;margin:18px 0;flex-wrap:wrap;}
  .tab{flex:1 1 auto;min-width:140px;text-align:center;cursor:pointer;border:1px solid var(--line);
    background:var(--paper);border-radius:12px;padding:10px 12px;font-weight:700;color:var(--ink-soft);
    box-shadow:0 2px 5px rgba(0,0,0,.06);transition:transform .08s,box-shadow .12s,background .12s;}
  .tab:hover{transform:translateY(-1px);box-shadow:0 4px 10px rgba(0,0,0,.12);}
  .tab:active{transform:translateY(1px) scale(.99);}
  .tab.active{background:linear-gradient(135deg,var(--accent),var(--accent-deep));color:#fff;border-color:transparent;}

  .panel{display:none;background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);
    padding:20px;box-shadow:var(--shadow);}
  .panel.active{display:block;}
  h2{font-size:1.12rem;margin:0 0 6px;}
  h3{font-size:.98rem;margin:18px 0 6px;color:var(--accent-deep);}
  label{display:block;font-size:.82rem;font-weight:700;color:var(--ink-soft);margin:8px 0 3px;}
  input,select,textarea{width:100%;border:1px solid var(--line);border-radius:9px;padding:8px 10px;
    font-size:.92rem;font-family:inherit;color:var(--ink);background:var(--paper);}
  textarea{min-height:64px;resize:vertical;}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
  .hint{font-size:.78rem;color:var(--ink-soft);margin:4px 0 0;}
  code{background:var(--cream2);padding:1px 5px;border-radius:5px;font-size:.86em;}

  button{transition:transform .08s,box-shadow .12s,filter .12s,background .12s;}
  .gen{margin-top:20px;width:100%;background:linear-gradient(135deg,var(--accent),var(--accent-deep));
    color:#fff;border:none;border-radius:12px;padding:13px;font-size:1rem;font-weight:800;cursor:pointer;
    box-shadow:0 2px 5px rgba(0,0,0,.12);}
  .gen:hover{box-shadow:0 4px 10px rgba(0,0,0,.16);transform:translateY(-1px);}
  .gen:active{transform:translateY(1px) scale(.99);box-shadow:inset 0 3px 6px rgba(0,0,0,.2);}
  .addbtn{margin-top:8px;background:var(--cream2);border:1px dashed var(--accent);color:var(--accent-deep);
    border-radius:9px;padding:8px 12px;cursor:pointer;font-weight:700;font-size:.86rem;
    box-shadow:0 2px 5px rgba(0,0,0,.06);}
  .addbtn:hover{transform:translateY(-1px);}
  .addbtn:active{transform:translateY(1px) scale(.99);}
  .del{background:#fff;border:1px solid var(--line);color:var(--ng);border-radius:8px;padding:6px 9px;
    cursor:pointer;font-weight:700;}
  .row{display:flex;gap:8px;align-items:flex-start;margin:6px 0;}
  .row>*{margin:0;}

  .outwrap{margin-top:18px;background:var(--cream2);border:1px solid var(--line);border-radius:12px;padding:14px;}
  .outwrap h3{margin-top:0;}
  pre.out{white-space:pre-wrap;word-break:break-word;background:var(--paper);border:1px solid var(--line);
    border-radius:9px;padding:12px;font-size:.86rem;max-height:420px;overflow:auto;font-family:inherit;}
  .outbtns{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
  .outbtns button{border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:10px;
    padding:8px 12px;cursor:pointer;font-weight:700;font-size:.84rem;box-shadow:0 2px 5px rgba(0,0,0,.06);}
  .outbtns button:hover{transform:translateY(-1px);}
  .outbtns button:active{transform:translateY(1px) scale(.99);}

  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;
    padding:10px 18px;border-radius:999px;font-size:.86rem;opacity:0;pointer-events:none;transition:opacity .25s;z-index:50;}
  .toast.show{opacity:.95;}
  .checks label{display:flex;align-items:center;gap:8px;font-weight:600;color:var(--ink);}
  .checks input{width:auto;}
  table.mtx{width:100%;border-collapse:collapse;font-size:.84rem;margin-top:6px;}
  table.mtx th,table.mtx td{border:1px solid var(--line);padding:6px 8px;text-align:left;}
  table.mtx th{background:var(--cream2);}
  .badge-ok{color:var(--ok);font-weight:800;}
  .badge-ng{color:var(--ng);font-weight:800;}

  @media (max-width:560px){
    .grid,.grid3{grid-template-columns:1fr;}
    header.hero h1{padding-top:34px;padding-right:0;}
    .bunny{top:auto;}
  }

  .lang-switch{display:none !important;}
</style>
</head>
<body class=&quot;theme-jp&quot;>
<div class=&quot;wrap&quot;>
  <header class=&quot;hero&quot;>
    <div class=&quot;lang-switch&quot;>
      <button type=&quot;button&quot; id=&quot;langJp&quot; class=&quot;lang-btn active&quot; onclick=&quot;setLang('jp')&quot;>🇯🇵 日本語</button>
      <button type=&quot;button&quot; id=&quot;langEn&quot; class=&quot;lang-btn&quot; onclick=&quot;setLang('en')&quot;>🇬🇧 English</button>
    </div>
    <div class=&quot;bunny&quot;>🐰</div>
    <h1 data-i18n=&quot;title&quot;>うさうさ 品質保証ジェネレーター</h1>
    <div class=&quot;ver-badge&quot;><span class=&quot;ver-pill&quot;>v1.0</span><span class=&quot;ver-date&quot;>2026-05-22</span><span class=&quot;ver-today&quot; id=&quot;ver_today&quot;></span></div>
    <p data-i18n=&quot;subtitle&quot;>要求定義から要件定義・作業標準化・品質チェックまで。ブラウザだけで「作業のばらつき」を減らし、品質を保証するドキュメントを作れます。データは端末内のみ・外部送信なし。</p>
  </header>

  <div class=&quot;tabs&quot; id=&quot;tabs&quot;>
    <div class=&quot;tab active&quot; data-tab=&quot;req&quot;>📌 要求定義</div>
    <div class=&quot;tab&quot; data-tab=&quot;spec&quot;>📐 要件定義</div>
    <div class=&quot;tab&quot; data-tab=&quot;std&quot;>📋 作業標準化</div>
    <div class=&quot;tab&quot; data-tab=&quot;qc&quot;>✅ 品質チェック</div>
    <div class=&quot;tab&quot; data-tab=&quot;trace&quot;>🔗 トレーサビリティ</div>
    <div class=&quot;tab&quot; data-tab=&quot;hub&quot;>🗂 データ統合</div>
  </div>

  <!-- 要求定義 -->
  <div class=&quot;panel active&quot; id=&quot;panel-req&quot;>
    <h2 data-jp=&quot;要求定義（誰が・何を・なぜ）&quot;>要求定義（誰が・何を・なぜ）</h2>
    <p class=&quot;hint&quot; data-jp=&quot;お客様・利用者が本当に欲しいもの（要求）を、背景と理由つきで整理します。&quot;>お客様・利用者が本当に欲しいもの（要求）を、背景と理由つきで整理します。</p>
    <div class=&quot;grid&quot;>
      <div><label data-jp=&quot;案件・テーマ名&quot;>案件・テーマ名</label><input id=&quot;rq_title&quot; placeholder=&quot;社内勤怠システムの刷新&quot;></div>
      <div><label data-jp=&quot;記入日（空なら今日）&quot;>記入日（空なら今日）</label><input id=&quot;rq_date&quot; placeholder=&quot;2026/05/22（金）&quot;></div>
    </div>
    <div class=&quot;grid&quot;>
      <div><label data-jp=&quot;誰のため（利用者・ステークホルダ）&quot;>誰のため（利用者・ステークホルダ）</label><input id=&quot;rq_who&quot; placeholder=&quot;現場社員・管理者・人事&quot;></div>
      <div><label data-jp=&quot;背景・現状の課題&quot;>背景・現状の課題</label><input id=&quot;rq_bg&quot; placeholder=&quot;手入力でミスと残業申請の手戻りが多い&quot;></div>
    </div>
    <h3 data-jp=&quot;要求リスト（1行＝1要求／なぜを添える）&quot;>要求リスト（1行＝1要求／なぜを添える）</h3>
    <p class=&quot;hint&quot; data-jp=&quot;例：打刻をスマホでしたい（理由：外回りが多く出社前に打刻が必要）&quot;>例：打刻をスマホでしたい（理由：外回りが多く出社前に打刻が必要）</p>
    <div id=&quot;rqList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;rqAdd()&quot; data-jp=&quot;＋ 要求を追加&quot;>＋ 要求を追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildReq()&quot; data-jp=&quot;要求定義書を生成する&quot;>要求定義書を生成する</button>
  </div>

  <!-- 要件定義 -->
  <div class=&quot;panel&quot; id=&quot;panel-spec&quot;>
    <h2 data-jp=&quot;要件定義（要求を満たす条件）&quot;>要件定義（要求を満たす条件）</h2>
    <p class=&quot;hint&quot; data-jp=&quot;要求を「実現する条件」に翻訳します。機能要件と非機能要件、スコープ、前提・制約に分けます。&quot;>要求を「実現する条件」に翻訳します。機能要件と非機能要件、スコープ、前提・制約に分けます。</p>
    <div><label data-jp=&quot;対象システム・対象範囲&quot;>対象システム・対象範囲</label><input id=&quot;sp_scope&quot; placeholder=&quot;勤怠打刻〜申請承認まで（給与計算は対象外）&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;spWebTemplate()&quot; data-jp=&quot;🌐 Web制作テンプレを入れる&quot;>🌐 Web制作テンプレを入れる</button>
    <h3 data-jp=&quot;機能要件（〜できること）&quot;>機能要件（〜できること）</h3>
    <div id=&quot;spFunc&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;spAddFunc()&quot; data-jp=&quot;＋ 機能要件を追加&quot;>＋ 機能要件を追加</button>
    <h3 data-jp=&quot;非機能要件（性能・セキュリティ・運用など）&quot;>非機能要件（性能・セキュリティ・運用など）</h3>
    <div id=&quot;spNf&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;spAddNf()&quot; data-jp=&quot;＋ 非機能要件を追加&quot;>＋ 非機能要件を追加</button>
    <div class=&quot;grid&quot;>
      <div><label data-jp=&quot;前提&quot;>前提</label><textarea id=&quot;sp_assume&quot; placeholder=&quot;社員は全員スマホを所持&quot;></textarea></div>
      <div><label data-jp=&quot;制約&quot;>制約</label><textarea id=&quot;sp_limit&quot; placeholder=&quot;既存の人事DBと連携必須／予算上限あり&quot;></textarea></div>
    </div>
    <button class=&quot;gen&quot; onclick=&quot;buildSpec()&quot; data-jp=&quot;要件定義書を生成する&quot;>要件定義書を生成する</button>
  </div>

  <!-- 作業標準化 -->
  <div class=&quot;panel&quot; id=&quot;panel-std&quot;>
    <h2 data-jp=&quot;作業標準化（手順書テンプレ）&quot;>作業標準化（手順書テンプレ）</h2>
    <p class=&quot;hint&quot; data-jp=&quot;誰がやっても同じ品質になるよう、目的・前提・手順・注意点をそろえます。&quot;>誰がやっても同じ品質になるよう、目的・前提・手順・注意点をそろえます。</p>
    <div class=&quot;grid&quot;>
      <div><label data-jp=&quot;作業名&quot;>作業名</label><input id=&quot;st_title&quot; placeholder=&quot;本番リリース手順&quot;></div>
      <div><label data-jp=&quot;担当・役割&quot;>担当・役割</label><input id=&quot;st_role&quot; placeholder=&quot;リリース担当（2名・相互確認）&quot;></div>
    </div>
    <div class=&quot;grid&quot;>
      <div><label data-jp=&quot;目的（なぜやるか）&quot;>目的（なぜやるか）</label><input id=&quot;st_purpose&quot; placeholder=&quot;無停止で安全に新版を反映する&quot;></div>
      <div><label data-jp=&quot;前提条件&quot;>前提条件</label><input id=&quot;st_pre&quot; placeholder=&quot;検証環境でテスト合格済み・承認取得済み&quot;></div>
    </div>
    <h3 data-jp=&quot;手順ステップ（順番に1行ずつ）&quot;>手順ステップ（順番に1行ずつ）</h3>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;stWebTemplate()&quot; data-jp=&quot;🌐 Web公開手順テンプレを入れる&quot;>🌐 Web公開手順テンプレを入れる</button>
    <div id=&quot;stSteps&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;stAddStep()&quot; data-jp=&quot;＋ 手順を追加&quot;>＋ 手順を追加</button>
    <div><label data-jp=&quot;注意点・禁止事項&quot;>注意点・禁止事項</label><textarea id=&quot;st_note&quot; placeholder=&quot;作業中はSlackで実況／不明点は独断で進めない&quot;></textarea></div>
    <button class=&quot;gen&quot; onclick=&quot;buildStd()&quot; data-jp=&quot;作業手順書を生成する&quot;>作業手順書を生成する</button>
  </div>

  <!-- 品質チェック -->
  <div class=&quot;panel&quot; id=&quot;panel-qc&quot;>
    <h2 data-jp=&quot;品質チェック（レビュー観点・検査記録）&quot;>品質チェック（レビュー観点・検査記録）</h2>
    <p class=&quot;hint&quot; data-jp=&quot;観点を決めて検査し、結果（OK/NG/該当なし）と所見を記録します。&quot;>観点を決めて検査し、結果（OK/NG/該当なし）と所見を記録します。</p>
    <div class=&quot;grid&quot;>
      <div><label data-jp=&quot;対象（成果物・作業）&quot;>対象（成果物・作業）</label><input id=&quot;qc_target&quot; placeholder=&quot;ログイン機能 v1.2&quot;></div>
      <div><label data-jp=&quot;検査者&quot;>検査者</label><input id=&quot;qc_by&quot; placeholder=&quot;石黒 友季子&quot;></div>
    </div>
    <h3 data-jp=&quot;チェック観点（1行＝1観点）&quot;>チェック観点（1行＝1観点）</h3>
    <p class=&quot;hint&quot; data-jp=&quot;観点を入れて結果を選びます。クイック追加で定番観点をまとめて入れられます。&quot;>観点を入れて結果を選びます。クイック追加で定番観点をまとめて入れられます。</p>
    <div style=&quot;display:flex;gap:6px;flex-wrap:wrap;margin:4px 0;&quot;>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; style=&quot;margin:0;&quot; onclick=&quot;qcQuick('basic')&quot; data-jp=&quot;＋定番（要件充足・異常系・表記）&quot;>＋定番（要件充足・異常系・表記）</button>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; style=&quot;margin:0;&quot; onclick=&quot;qcQuick('sec')&quot; data-jp=&quot;＋セキュリティ観点&quot;>＋セキュリティ観点</button>
      <button type=&quot;button&quot; class=&quot;addbtn&quot; style=&quot;margin:0;&quot; onclick=&quot;qcQuick('web')&quot; data-jp=&quot;＋Web制作観点（表示・レスポンシブ・SEO）&quot;>＋Web制作観点（表示・レスポンシブ・SEO）</button>
    </div>
    <div id=&quot;qcList&quot;></div>
    <button type=&quot;button&quot; class=&quot;addbtn&quot; onclick=&quot;qcAdd()&quot; data-jp=&quot;＋ 観点を追加&quot;>＋ 観点を追加</button>
    <button class=&quot;gen&quot; onclick=&quot;buildQc()&quot; data-jp=&quot;品質チェック表を生成する&quot;>品質チェック表を生成する</button>
  </div>

  <!-- トレーサビリティ -->
  <div class=&quot;panel&quot; id=&quot;panel-trace&quot;>
    <h2 data-jp=&quot;トレーサビリティ（要求→要件→作業→検査）&quot;>トレーサビリティ（要求→要件→作業→検査）</h2>
    <p class=&quot;hint&quot; data-jp=&quot;各タブに入力した内容から、要求・要件・作業・検査のつながりと、抜け漏れを確認します。&quot;>各タブに入力した内容から、要求・要件・作業・検査のつながりと、抜け漏れを確認します。</p>
    <button class=&quot;gen&quot; onclick=&quot;buildTrace()&quot; data-jp=&quot;トレーサビリティ・マトリクスを作る&quot;>トレーサビリティ・マトリクスを作る</button>
    <div id=&quot;traceView&quot; style=&quot;margin-top:14px;&quot;></div>
  </div>

  <!-- データ統合 -->
  <div class=&quot;panel&quot; id=&quot;panel-hub&quot;>
    <h2 data-jp=&quot;データ統合（保存・書き出し・取り込み）&quot;>データ統合（保存・書き出し・取り込み）</h2>
    <p class=&quot;hint&quot; data-jp=&quot;入力した全データを1つのJSONとして保存・復元できます。Excel（観点表）も書き出せます。&quot;>入力した全データを1つのJSONとして保存・復元できます。Excel（観点表）も書き出せます。</p>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;hubSaveJson()&quot; data-jp=&quot;💾 全データをJSON保存&quot;>💾 全データをJSON保存</button>
      <button onclick=&quot;document.getElementById('hubFile').click()&quot; data-jp=&quot;📂 JSONを取り込む&quot;>📂 JSONを取り込む</button>
      <input type=&quot;file&quot; id=&quot;hubFile&quot; accept=&quot;.json&quot; style=&quot;display:none&quot; onchange=&quot;hubLoadJson(this)&quot;>
      <button onclick=&quot;qcExportXlsx()&quot; data-jp=&quot;📊 品質チェック表をExcel出力&quot;>📊 品質チェック表をExcel出力</button>
      <button onclick=&quot;hubClearAll()&quot; data-jp=&quot;🗑 全クリア&quot;>🗑 全クリア</button>
    </div>
    <p class=&quot;hint&quot; data-jp=&quot;保存したJSONはこのツールでのみ復元できます。大事なデータはこまめに保存してください。&quot;>保存したJSONはこのツールでのみ復元できます。大事なデータはこまめに保存してください。</p>
  </div>

  <!-- 出力 -->
  <div class=&quot;outwrap&quot;>
    <h3 data-jp=&quot;生成結果&quot;>生成結果</h3>
    <pre class=&quot;out&quot; id=&quot;out&quot; data-jp-empty=&quot;ここに生成結果が表示されます。各タブの「生成する」を押してください。&quot;>ここに生成結果が表示されます。各タブの「生成する」を押してください。</pre>
    <div class=&quot;outbtns&quot;>
      <button onclick=&quot;copyOut()&quot; data-jp=&quot;📋 コピー&quot;>📋 コピー</button>
      <button onclick=&quot;downloadOut('txt')&quot; data-jp=&quot;📄 テキスト保存&quot;>📄 テキスト保存</button>
      <button onclick=&quot;downloadOut('md')&quot; data-jp=&quot;📝 Markdown保存&quot;>📝 Markdown保存</button>
      <button onclick=&quot;clearOut()&quot; data-jp=&quot;クリア&quot;>クリア</button>
    </div>
  </div>
</div>
<div class=&quot;toast&quot; id=&quot;toast&quot;></div>

<script>
&quot;use strict&quot;;
/* ============ 基盤ヘルパ ============ */
function $(id){ return document.getElementById(id); }
function v(id){ var el=$(id); return el ? (el.value||&quot;&quot;).trim() : &quot;&quot;; }
function lines(s){ return (s||&quot;&quot;).split(/\n+/).map(function(x){return x.trim();}).filter(Boolean); }
function esc(s){ return (s||&quot;&quot;).replace(/&amp;/g,&quot;&amp;amp;&quot;).replace(/</g,&quot;&amp;lt;&quot;).replace(/>/g,&quot;&amp;gt;&quot;); }
function toast(msg){ var t=$(&quot;toast&quot;); if(!t)return; t.textContent=msg; t.classList.add(&quot;show&quot;); setTimeout(function(){t.classList.remove(&quot;show&quot;);},1600); }

function lsAvailable(){ try{ var k=&quot;__t&quot;+Math.random(); window.localStorage.setItem(k,&quot;1&quot;); window.localStorage.removeItem(k); return true; }catch(e){ return false; } }

function nowParts(){
  var d=new Date();
  var wd=[&quot;日&quot;,&quot;月&quot;,&quot;火&quot;,&quot;水&quot;,&quot;木&quot;,&quot;金&quot;,&quot;土&quot;][d.getDay()];
  var mm=(&quot;0&quot;+(d.getMonth()+1)).slice(-2), dd=(&quot;0&quot;+d.getDate()).slice(-2);
  var hh=(&quot;0&quot;+d.getHours()).slice(-2), mi=(&quot;0&quot;+d.getMinutes()).slice(-2);
  return { date:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;）&quot;, time:hh+&quot;:&quot;+mi,
           datetime:d.getFullYear()+&quot;/&quot;+mm+&quot;/&quot;+dd+&quot;（&quot;+wd+&quot;） &quot;+hh+&quot;:&quot;+mi };
}
function todayJp(){ return nowParts().date; }

var BAR=&quot;────────────────────────────&quot;;

/* 出力管理 */
var lastOut={txt:&quot;&quot;,md:&quot;&quot;};
function setOut(txt, md){
  lastOut.txt=txt||&quot;&quot;; lastOut.md=(md!=null?md:txt)||&quot;&quot;;
  var o=$(&quot;out&quot;); if(o) o.textContent=lastOut.txt;
}
function clearOut(){ setOut(&quot;&quot;); var o=$(&quot;out&quot;); if(o) o.textContent=&quot;&quot;; toast(&quot;クリアしました&quot;); }
function copyOut(){
  var t=lastOut.txt||&quot;&quot;; if(!t){ toast(&quot;生成結果がありません&quot;); return; }
  try{ navigator.clipboard.writeText(t); toast(&quot;コピーしました&quot;); }
  catch(e){ var ta=document.createElement(&quot;textarea&quot;); ta.value=t; document.body.appendChild(ta); ta.select(); try{document.execCommand(&quot;copy&quot;);}catch(_){} document.body.removeChild(ta); toast(&quot;コピーしました&quot;); }
}
function _saveBlob(text, fname, mime){
  try{
    var blob=new Blob([text],{type:mime||&quot;text/plain;charset=utf-8&quot;});
    var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=fname; document.body.appendChild(a); a.click();
    document.body.removeChild(a); setTimeout(function(){URL.revokeObjectURL(url);},500);
  }catch(e){ toast(&quot;保存に失敗しました&quot;); }
}
function downloadOut(fmt){
  if(!lastOut.txt){ toast(&quot;生成結果がありません&quot;); return; }
  if(fmt===&quot;md&quot;){ _saveBlob(lastOut.md, &quot;qa_&quot;+stamp()+&quot;.md&quot;, &quot;text/markdown;charset=utf-8&quot;); }
  else{ _saveBlob(lastOut.txt, &quot;qa_&quot;+stamp()+&quot;.txt&quot;, &quot;text/plain;charset=utf-8&quot;); }
}
function stamp(){ var p=nowParts(); return p.date.replace(/[\/（）日月火水木金土]/g,&quot;&quot;).slice(0,8); }

/* ============ 行追加の共通 ============ */
function mkRow(html){ var d=document.createElement(&quot;div&quot;); d.className=&quot;row&quot;; d.innerHTML=html; return d; }
function delRow(btn){ var r=btn.closest(&quot;.row&quot;); if(r) r.remove(); }

/* ---- 要求定義 ---- */
function rqAdd(text, why){
  var d=mkRow(
    '<input class=&quot;rq-text&quot; placeholder=&quot;要求（例：打刻をスマホでしたい）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;>'+
    '<input class=&quot;rq-why&quot; placeholder=&quot;なぜ（理由）&quot; value=&quot;'+esc(why||&quot;&quot;)+'&quot; style=&quot;max-width:40%&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>');
  $(&quot;rqList&quot;).appendChild(d);
}
function rqRead(){
  return [].slice.call(document.querySelectorAll(&quot;#rqList .row&quot;)).map(function(r){
    return { text:r.querySelector(&quot;.rq-text&quot;).value.trim(), why:r.querySelector(&quot;.rq-why&quot;).value.trim() };
  }).filter(function(x){return x.text;});
}
function buildReq(){
  var title=v(&quot;rq_title&quot;)||&quot;（無題）&quot;;
  var date=v(&quot;rq_date&quot;)||todayJp();
  var reqs=rqRead();
  var o=[];
  o.push(&quot;【要求定義書】&quot;+title);
  o.push(&quot;記入日：&quot;+date);
  o.push(&quot;対象利用者：&quot;+(v(&quot;rq_who&quot;)||&quot;—&quot;));
  o.push(&quot;背景・課題：&quot;+(v(&quot;rq_bg&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 要求一覧&quot;); o.push(BAR);
  if(reqs.length){ reqs.forEach(function(r,i){ o.push(&quot;R&quot;+(i+1)+&quot;. &quot;+r.text+(r.why?(&quot;　（理由：&quot;+r.why+&quot;）&quot;):&quot;&quot;)); }); }
  else { o.push(&quot;（要求が未入力です）&quot;); }
  var m=[];
  m.push(&quot;# 要求定義書：&quot;+title);
  m.push(&quot;&quot;); m.push(&quot;- 記入日：&quot;+date);
  m.push(&quot;- 対象利用者：&quot;+(v(&quot;rq_who&quot;)||&quot;—&quot;));
  m.push(&quot;- 背景・課題：&quot;+(v(&quot;rq_bg&quot;)||&quot;—&quot;));
  m.push(&quot;&quot;); m.push(&quot;## 要求一覧&quot;); m.push(&quot;&quot;);
  m.push(&quot;| ID | 要求 | 理由 |&quot;); m.push(&quot;|---|---|---|&quot;);
  if(reqs.length){ reqs.forEach(function(r,i){ m.push(&quot;| R&quot;+(i+1)+&quot; | &quot;+r.text+&quot; | &quot;+(r.why||&quot;—&quot;)+&quot; |&quot;); }); }
  else { m.push(&quot;| — | （未入力） | — |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- 要件定義 ---- */
function spAddFunc(text){
  var d=mkRow('<input class=&quot;sp-f&quot; placeholder=&quot;〜できること（例：スマホで打刻できる）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>');
  $(&quot;spFunc&quot;).appendChild(d);
}
function spAddNf(text){
  var d=mkRow('<input class=&quot;sp-nf&quot; placeholder=&quot;非機能（例：99.9%稼働／応答1秒以内）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>');
  $(&quot;spNf&quot;).appendChild(d);
}
function spReadFunc(){ return [].slice.call(document.querySelectorAll(&quot;#spFunc .sp-f&quot;)).map(function(e){return e.value.trim();}).filter(Boolean); }
function spReadNf(){ return [].slice.call(document.querySelectorAll(&quot;#spNf .sp-nf&quot;)).map(function(e){return e.value.trim();}).filter(Boolean); }
function buildSpec(){
  var scope=v(&quot;sp_scope&quot;)||&quot;—&quot;;
  var fs=spReadFunc(), nf=spReadNf();
  var o=[];
  o.push(&quot;【要件定義書】&quot;);
  o.push(&quot;対象範囲：&quot;+scope);
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 機能要件&quot;); o.push(BAR);
  if(fs.length){ fs.forEach(function(x,i){ o.push(&quot;F&quot;+(i+1)+&quot;. &quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 非機能要件&quot;); o.push(BAR);
  if(nf.length){ nf.forEach(function(x,i){ o.push(&quot;N&quot;+(i+1)+&quot;. &quot;+x); }); } else { o.push(&quot;（未入力）&quot;); }
  o.push(&quot;&quot;); o.push(&quot;■ 前提&quot;); o.push(v(&quot;sp_assume&quot;)||&quot;—&quot;);
  o.push(&quot;&quot;); o.push(&quot;■ 制約&quot;); o.push(v(&quot;sp_limit&quot;)||&quot;—&quot;);
  var m=[];
  m.push(&quot;# 要件定義書&quot;);
  m.push(&quot;&quot;); m.push(&quot;対象範囲：&quot;+scope);
  m.push(&quot;&quot;); m.push(&quot;## 機能要件&quot;); m.push(&quot;&quot;);
  if(fs.length){ fs.forEach(function(x,i){ m.push(&quot;- **F&quot;+(i+1)+&quot;**：&quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## 非機能要件&quot;); m.push(&quot;&quot;);
  if(nf.length){ nf.forEach(function(x,i){ m.push(&quot;- **N&quot;+(i+1)+&quot;**：&quot;+x); }); } else { m.push(&quot;- （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## 前提&quot;); m.push(v(&quot;sp_assume&quot;)||&quot;—&quot;);
  m.push(&quot;&quot;); m.push(&quot;## 制約&quot;); m.push(v(&quot;sp_limit&quot;)||&quot;—&quot;);
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- Web制作テンプレ投入 ---- */
function spWebTemplate(){
  if(!v(&quot;sp_scope&quot;)) { var el=$(&quot;sp_scope&quot;); if(el) el.value=&quot;トップ／会社概要／サービス／お問い合わせ の4ページ（ブログは対象外）&quot;; }
  [&quot;スマホ・PCで正しく表示できる（レスポンシブ）&quot;,&quot;お問い合わせフォームから送信できる&quot;,&quot;各ページにtitle/meta descriptionを設定できる&quot;,&quot;主要ブラウザで表示崩れがない&quot;].forEach(function(x){ spAddFunc(x); });
  [&quot;ページ表示は3秒以内を目安&quot;,&quot;HTTPS対応・常時SSL&quot;,&quot;アクセシビリティに配慮（alt・コントラスト）&quot;].forEach(function(x){ spAddNf(x); });
  if(!v(&quot;sp_assume&quot;)) { var a=$(&quot;sp_assume&quot;); if(a) a.value=&quot;独自ドメイン取得済み／素材（ロゴ・写真）支給あり&quot;; }
  if(!v(&quot;sp_limit&quot;)) { var l=$(&quot;sp_limit&quot;); if(l) l.value=&quot;公開期限あり／既存CMSのデザインに合わせる&quot;; }
  toast(&quot;Web制作テンプレを入れました&quot;);
}
function stWebTemplate(){
  if(!v(&quot;st_title&quot;)) { var t=$(&quot;st_title&quot;); if(t) t.value=&quot;Webサイト公開手順&quot;; }
  if(!v(&quot;st_purpose&quot;)) { var p=$(&quot;st_purpose&quot;); if(p) p.value=&quot;本番環境へ安全に公開する&quot;; }
  if(!v(&quot;st_pre&quot;)) { var pr=$(&quot;st_pre&quot;); if(pr) pr.value=&quot;ステージングで表示・動作確認済み／承認取得済み&quot;; }
  [&quot;ステージングで最終表示確認（PC・スマホ）&quot;,&quot;リンク切れ・誤字をチェック&quot;,&quot;本番へファイルをアップロード（バックアップを取得）&quot;,&quot;DNS・キャッシュを確認し本番URLで表示確認&quot;,&quot;フォーム送信など主要動作を本番で確認&quot;,&quot;公開をチームに連絡&quot;].forEach(function(x){ stAddStep(x); });
  if(!v(&quot;st_note&quot;)) { var n=$(&quot;st_note&quot;); if(n) n.value=&quot;公開作業は2名で相互確認／問題時は即ロールバック&quot;; }
  toast(&quot;Web公開手順テンプレを入れました&quot;);
}

/* ---- 作業標準化 ---- */
function stAddStep(text){
  var d=mkRow('<input class=&quot;st-s&quot; placeholder=&quot;手順（例：メンテナンス画面を表示する）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>');
  $(&quot;stSteps&quot;).appendChild(d);
}
function stReadSteps(){ return [].slice.call(document.querySelectorAll(&quot;#stSteps .st-s&quot;)).map(function(e){return e.value.trim();}).filter(Boolean); }
function buildStd(){
  var title=v(&quot;st_title&quot;)||&quot;（無題作業）&quot;;
  var steps=stReadSteps();
  var o=[];
  o.push(&quot;【作業手順書】&quot;+title);
  o.push(&quot;担当・役割：&quot;+(v(&quot;st_role&quot;)||&quot;—&quot;));
  o.push(&quot;目的：&quot;+(v(&quot;st_purpose&quot;)||&quot;—&quot;));
  o.push(&quot;前提条件：&quot;+(v(&quot;st_pre&quot;)||&quot;—&quot;));
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ 手順&quot;); o.push(BAR);
  if(steps.length){ steps.forEach(function(x,i){ o.push((i+1)+&quot;. &quot;+x); }); } else { o.push(&quot;（手順が未入力です）&quot;); }
  o.push(&quot;&quot;); o.push(&quot;■ 注意点・禁止事項&quot;);
  o.push(v(&quot;st_note&quot;)||&quot;—&quot;);
  var m=[];
  m.push(&quot;# 作業手順書：&quot;+title);
  m.push(&quot;&quot;); m.push(&quot;- 担当・役割：&quot;+(v(&quot;st_role&quot;)||&quot;—&quot;));
  m.push(&quot;- 目的：&quot;+(v(&quot;st_purpose&quot;)||&quot;—&quot;));
  m.push(&quot;- 前提条件：&quot;+(v(&quot;st_pre&quot;)||&quot;—&quot;));
  m.push(&quot;&quot;); m.push(&quot;## 手順&quot;); m.push(&quot;&quot;);
  if(steps.length){ steps.forEach(function(x,i){ m.push((i+1)+&quot;. &quot;+x); }); } else { m.push(&quot;1. （未入力）&quot;); }
  m.push(&quot;&quot;); m.push(&quot;## 注意点・禁止事項&quot;); m.push(&quot;&quot;); m.push(v(&quot;st_note&quot;)||&quot;—&quot;);
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- 品質チェック ---- */
function qcAdd(text, result){
  var rv=result||&quot;&quot;;
  var d=mkRow(
    '<input class=&quot;qc-v&quot; placeholder=&quot;観点（例：必須項目が空でエラーになる）&quot; value=&quot;'+esc(text||&quot;&quot;)+'&quot;>'+
    '<select class=&quot;qc-r&quot; style=&quot;max-width:120px&quot;>'+
      '<option value=&quot;&quot;'+(rv===&quot;&quot;?&quot; selected&quot;:&quot;&quot;)+'>未</option>'+
      '<option value=&quot;OK&quot;'+(rv===&quot;OK&quot;?&quot; selected&quot;:&quot;&quot;)+'>OK</option>'+
      '<option value=&quot;NG&quot;'+(rv===&quot;NG&quot;?&quot; selected&quot;:&quot;&quot;)+'>NG</option>'+
      '<option value=&quot;N/A&quot;'+(rv===&quot;N/A&quot;?&quot; selected&quot;:&quot;&quot;)+'>該当なし</option>'+
    '</select>'+
    '<input class=&quot;qc-note&quot; placeholder=&quot;所見&quot; value=&quot;&quot; style=&quot;max-width:30%&quot;>'+
    '<button type=&quot;button&quot; class=&quot;del&quot; onclick=&quot;delRow(this)&quot;>×</button>');
  $(&quot;qcList&quot;).appendChild(d);
}
function qcQuick(kind){
  var sets={
    basic:[&quot;要件どおりの結果になる&quot;,&quot;異常系（空・最大・不正値）で適切に振る舞う&quot;,&quot;エラーメッセージが分かりやすい&quot;,&quot;表記ゆれ・誤字がない&quot;],
    sec:[&quot;権限のない操作が拒否される&quot;,&quot;入力値の検証（XSS/SQLi対策）&quot;,&quot;パスワード等が平文で保存されない&quot;,&quot;ログに機微情報が出ない&quot;],
    web:[&quot;主要ブラウザ（Chrome/Safari/Edge）で表示崩れがない&quot;,&quot;スマホ・タブレット・PCでレスポンシブに表示される&quot;,&quot;リンク切れ・404がない&quot;,&quot;画像にalt属性があり代替テキストが適切&quot;,&quot;ページ表示速度が許容範囲（重い画像を圧縮）&quot;,&quot;title/meta descriptionが各ページに設定されている&quot;,&quot;フォーム送信・バリデーションが正しく動く&quot;,&quot;キーボード操作・コントラスト比などアクセシビリティに配慮&quot;]
  };
  var arr=sets[kind]||sets.basic;
  arr.forEach(function(x){ qcAdd(x); });
  toast(&quot;観点を追加しました&quot;);
}
function qcRead(){
  return [].slice.call(document.querySelectorAll(&quot;#qcList .row&quot;)).map(function(r){
    return { v:r.querySelector(&quot;.qc-v&quot;).value.trim(), r:r.querySelector(&quot;.qc-r&quot;).value, note:r.querySelector(&quot;.qc-note&quot;).value.trim() };
  }).filter(function(x){return x.v;});
}
function buildQc(){
  var target=v(&quot;qc_target&quot;)||&quot;（対象未入力）&quot;;
  var by=v(&quot;qc_by&quot;)||&quot;—&quot;;
  var items=qcRead();
  var ok=items.filter(function(x){return x.r===&quot;OK&quot;;}).length;
  var ng=items.filter(function(x){return x.r===&quot;NG&quot;;}).length;
  var na=items.filter(function(x){return x.r===&quot;N/A&quot;;}).length;
  var un=items.filter(function(x){return !x.r;}).length;
  var o=[];
  o.push(&quot;【品質チェック表】&quot;+target);
  o.push(&quot;検査者：&quot;+by+&quot;　検査日：&quot;+todayJp());
  o.push(&quot;結果サマリ：OK &quot;+ok+&quot;／NG &quot;+ng+&quot;／該当なし &quot;+na+&quot;／未 &quot;+un+&quot;（全 &quot;+items.length+&quot;件）&quot;);
  o.push(&quot;&quot;); o.push(BAR); o.push(&quot;■ チェック結果&quot;); o.push(BAR);
  if(items.length){ items.forEach(function(x,i){ o.push(&quot;[&quot;+(x.r||&quot;未&quot;)+&quot;] &quot;+(i+1)+&quot;. &quot;+x.v+(x.note?(&quot;　／所見：&quot;+x.note):&quot;&quot;)); }); }
  else { o.push(&quot;（観点が未入力です）&quot;); }
  if(ng>0){ o.push(&quot;&quot;); o.push(&quot;⚠️ NGが&quot;+ng+&quot;件あります。是正と再検査が必要です。&quot;); }
  else if(items.length &amp;&amp; un===0){ o.push(&quot;&quot;); o.push(&quot;✅ NGなし。すべて確認済みです。&quot;); }
  var m=[];
  m.push(&quot;# 品質チェック表：&quot;+target);
  m.push(&quot;&quot;); m.push(&quot;- 検査者：&quot;+by); m.push(&quot;- 検査日：&quot;+todayJp());
  m.push(&quot;- 結果：OK &quot;+ok+&quot; / NG &quot;+ng+&quot; / 該当なし &quot;+na+&quot; / 未 &quot;+un+&quot;（全 &quot;+items.length+&quot;件）&quot;);
  m.push(&quot;&quot;); m.push(&quot;| 結果 | # | 観点 | 所見 |&quot;); m.push(&quot;|---|---|---|---|&quot;);
  if(items.length){ items.forEach(function(x,i){ m.push(&quot;| &quot;+(x.r||&quot;未&quot;)+&quot; | &quot;+(i+1)+&quot; | &quot;+x.v+&quot; | &quot;+(x.note||&quot;—&quot;)+&quot; |&quot;); }); }
  else { m.push(&quot;| — | — | （未入力） | — |&quot;); }
  setOut(o.join(&quot;\n&quot;), m.join(&quot;\n&quot;));
}

/* ---- トレーサビリティ ---- */
function buildTrace(){
  var reqs=rqRead(), fs=spReadFunc(), steps=stReadSteps(), qcs=qcRead();
  var o=[];
  o.push(&quot;【トレーサビリティ・マトリクス】&quot;);
  o.push(&quot;要求 &quot;+reqs.length+&quot;件／機能要件 &quot;+fs.length+&quot;件／作業手順 &quot;+steps.length+&quot;件／検査観点 &quot;+qcs.length+&quot;件&quot;);
  o.push(&quot;&quot;);
  // 抜け漏れ警告
  var warn=[];
  if(reqs.length &amp;&amp; !fs.length) warn.push(&quot;要求はあるが機能要件が未定義&quot;);
  if(fs.length &amp;&amp; !qcs.length) warn.push(&quot;機能要件はあるが検査観点が未定義&quot;);
  if(steps.length===0) warn.push(&quot;作業手順が未定義&quot;);
  var ngQc=qcs.filter(function(x){return x.r===&quot;NG&quot;;}).length;
  if(ngQc>0) warn.push(&quot;品質チェックにNGが&quot;+ngQc+&quot;件&quot;);
  if(warn.length){ o.push(&quot;⚠️ 抜け漏れ・要対応：&quot;); warn.forEach(function(w){ o.push(&quot;　・&quot;+w); }); }
  else { o.push(&quot;✅ 大きな抜け漏れは見当たりません。&quot;); }
  setOut(o.join(&quot;\n&quot;), o.join(&quot;\n&quot;));

  // 画面表示（マトリクス）
  var html='<table class=&quot;mtx&quot;><tr><th>区分</th><th>件数</th><th>状態</th></tr>';
  function row(name,cnt,state){ return &quot;<tr><td>&quot;+name+&quot;</td><td>&quot;+cnt+&quot;</td><td>&quot;+state+&quot;</td></tr>&quot;; }
  html+=row(&quot;要求&quot;,reqs.length, reqs.length?&quot;<span class='badge-ok'>有</span>&quot;:&quot;<span class='badge-ng'>無</span>&quot;);
  html+=row(&quot;機能要件&quot;,fs.length, fs.length?&quot;<span class='badge-ok'>有</span>&quot;:&quot;<span class='badge-ng'>無</span>&quot;);
  html+=row(&quot;作業手順&quot;,steps.length, steps.length?&quot;<span class='badge-ok'>有</span>&quot;:&quot;<span class='badge-ng'>無</span>&quot;);
  html+=row(&quot;検査観点&quot;,qcs.length, qcs.length?&quot;<span class='badge-ok'>有</span>&quot;:&quot;<span class='badge-ng'>無</span>&quot;);
  html+=row(&quot;検査NG&quot;,ngQc, ngQc?&quot;<span class='badge-ng'>&quot;+ngQc+&quot;件</span>&quot;:&quot;<span class='badge-ok'>0</span>&quot;);
  html+=&quot;</table>&quot;;
  if(warn.length){ html+='<p class=&quot;hint&quot;>⚠️ '+warn.map(esc).join(' ／ ')+'</p>'; }
  $(&quot;traceView&quot;).innerHTML=html;
}

/* ============ Excel(.xlsx) 出力（品質チェック表） ============ */
function _crc32(bytes){
  var c, crc=0xFFFFFFFF;
  for(var i=0;i<bytes.length;i++){ c=(crc^bytes[i])&amp;0xFF; for(var k=0;k<8;k++){ c=(c&amp;1)?(0xEDB88320^(c>>>1)):(c>>>1); } crc=(crc>>>8)^c; }
  return (crc^0xFFFFFFFF)>>>0;
}
function _sb(s){ return new TextEncoder().encode(s); }
function _u16(n){ return [n&amp;0xFF,(n>>>8)&amp;0xFF]; }
function _u32(n){ return [n&amp;0xFF,(n>>>8)&amp;0xFF,(n>>>16)&amp;0xFF,(n>>>24)&amp;0xFF]; }
function _S(s){ return {t:&quot;s&quot;,v:(s==null?&quot;&quot;:String(s))}; }
function _N(n){ return {t:&quot;n&quot;,v:n}; }
function _sheetXml(rows){
  var xml='<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?>';
  xml+='<worksheet xmlns=&quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot;><sheetData>';
  for(var r=0;r<rows.length;r++){
    xml+='<row r=&quot;'+(r+1)+'&quot;>';
    for(var c=0;c<rows[r].length;c++){
      var cell=rows[r][c]; var ref=_col(c)+(r+1);
      if(cell&amp;&amp;cell.t===&quot;n&quot;){ xml+='<c r=&quot;'+ref+'&quot;><v>'+cell.v+'</v></c>'; }
      else{ var t=(cell&amp;&amp;cell.v!=null)?String(cell.v):&quot;&quot;; xml+='<c r=&quot;'+ref+'&quot; t=&quot;inlineStr&quot;><is><t xml:space=&quot;preserve&quot;>'+esc(t)+'</t></is></c>'; }
    }
    xml+='</row>';
  }
  xml+='</sheetData></worksheet>'; return xml;
}
function _col(i){ var s=&quot;&quot;; i++; while(i>0){ var m=(i-1)%26; s=String.fromCharCode(65+m)+s; i=Math.floor((i-1)/26); } return s; }
function _zipStore(files){
  var chunks=[], central=[], offset=0;
  files.forEach(function(f){
    var nameB=_sb(f.name), dataB=f.data, crc=_crc32(dataB);
    var lh=[].concat(_u32(0x04034b50),_u16(20),_u16(0),_u16(0),_u16(0),_u16(0),_u32(crc),_u32(dataB.length),_u32(dataB.length),_u16(nameB.length),_u16(0));
    chunks.push(new Uint8Array(lh)); chunks.push(nameB); chunks.push(dataB);
    var ch=[].concat(_u32(0x02014b50),_u16(20),_u16(20),_u16(0),_u16(0),_u16(0),_u16(0),_u32(crc),_u32(dataB.length),_u32(dataB.length),_u16(nameB.length),_u16(0),_u16(0),_u16(0),_u16(0),_u32(0),_u32(offset));
    central.push(new Uint8Array(ch)); central.push(nameB);
    offset+=lh.length+nameB.length+dataB.length;
  });
  var cstart=offset, csize=0;
  central.forEach(function(c){ csize+=c.length; });
  var end=[].concat(_u32(0x06054b50),_u16(0),_u16(0),_u16(files.length),_u16(files.length),_u32(csize),_u32(cstart),_u16(0));
  var all=[]; chunks.forEach(function(c){all.push(c);}); central.forEach(function(c){all.push(c);}); all.push(new Uint8Array(end));
  var total=0; all.forEach(function(a){total+=a.length;});
  var out=new Uint8Array(total), p=0; all.forEach(function(a){ out.set(a,p); p+=a.length; });
  return out;
}
function _buildXlsx(sheets){
  var files=[];
  files.push({name:&quot;[Content_Types].xml&quot;, data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Types xmlns=&quot;http://schemas.openxmlformats.org/package/2006/content-types&quot;><Default Extension=&quot;rels&quot; ContentType=&quot;application/vnd.openxmlformats-package.relationships+xml&quot;/><Default Extension=&quot;xml&quot; ContentType=&quot;application/xml&quot;/><Override PartName=&quot;/xl/workbook.xml&quot; ContentType=&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml&quot;/>'+sheets.map(function(s,i){return '<Override PartName=&quot;/xl/worksheets/sheet'+(i+1)+'.xml&quot; ContentType=&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml&quot;/>';}).join(&quot;&quot;)+'</Types>')});
  files.push({name:&quot;_rels/.rels&quot;, data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Relationships xmlns=&quot;http://schemas.openxmlformats.org/package/2006/relationships&quot;><Relationship Id=&quot;rId1&quot; Type=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument&quot; Target=&quot;xl/workbook.xml&quot;/></Relationships>')});
  var wbSheets=sheets.map(function(s,i){return '<sheet name=&quot;'+esc(s.name)+'&quot; sheetId=&quot;'+(i+1)+'&quot; r:id=&quot;rId'+(i+1)+'&quot;/>';}).join(&quot;&quot;);
  files.push({name:&quot;xl/workbook.xml&quot;, data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><workbook xmlns=&quot;http://schemas.openxmlformats.org/spreadsheetml/2006/main&quot; xmlns:r=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships&quot;><sheets>'+wbSheets+'</sheets></workbook>')});
  var rels=sheets.map(function(s,i){return '<Relationship Id=&quot;rId'+(i+1)+'&quot; Type=&quot;http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet&quot; Target=&quot;worksheets/sheet'+(i+1)+'.xml&quot;/>';}).join(&quot;&quot;);
  files.push({name:&quot;xl/_rels/workbook.xml.rels&quot;, data:_sb('<?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot; standalone=&quot;yes&quot;?><Relationships xmlns=&quot;http://schemas.openxmlformats.org/package/2006/relationships&quot;>'+rels+'</Relationships>')});
  sheets.forEach(function(s,i){ files.push({name:&quot;xl/worksheets/sheet&quot;+(i+1)+&quot;.xml&quot;, data:_sb(_sheetXml(s.rows))}); });
  return _zipStore(files);
}
function qcExportXlsx(){
  var items=qcRead();
  var rows=[[_S(&quot;結果&quot;),_S(&quot;#&quot;),_S(&quot;観点&quot;),_S(&quot;所見&quot;)]];
  if(items.length){ items.forEach(function(x,i){ rows.push([_S(x.r||&quot;未&quot;),_N(i+1),_S(x.v),_S(x.note)]); }); }
  else { rows.push([_S(&quot;—&quot;),_S(&quot;—&quot;),_S(&quot;（未入力）&quot;),_S(&quot;—&quot;)]); }
  var meta=[[_S(&quot;対象&quot;),_S(v(&quot;qc_target&quot;))],[_S(&quot;検査者&quot;),_S(v(&quot;qc_by&quot;))],[_S(&quot;検査日&quot;),_S(todayJp())]];
  try{
    var u8=_buildXlsx([{name:&quot;品質チェック表&quot;,rows:rows},{name:&quot;検査情報&quot;,rows:meta}]);
    var blob=new Blob([u8],{type:&quot;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet&quot;});
    var url=URL.createObjectURL(blob);
    var a=document.createElement(&quot;a&quot;); a.href=url; a.download=&quot;品質チェック表_&quot;+stamp()+&quot;.xlsx&quot;; document.body.appendChild(a); a.click();
    document.body.removeChild(a); setTimeout(function(){URL.revokeObjectURL(url);},500);
    toast(&quot;Excelを書き出しました&quot;);
  }catch(e){ toast(&quot;Excel出力に失敗しました&quot;); }
}

/* ============ データ統合（JSON保存・復元） ============ */
function collectAll(){
  return {
    _app:&quot;usausa_qa_generator&quot;, _ver:&quot;1.0&quot;, _saved:nowParts().datetime,
    req:{ title:v(&quot;rq_title&quot;), date:v(&quot;rq_date&quot;), who:v(&quot;rq_who&quot;), bg:v(&quot;rq_bg&quot;), list:rqRead() },
    spec:{ scope:v(&quot;sp_scope&quot;), func:spReadFunc(), nf:spReadNf(), assume:v(&quot;sp_assume&quot;), limit:v(&quot;sp_limit&quot;) },
    std:{ title:v(&quot;st_title&quot;), role:v(&quot;st_role&quot;), purpose:v(&quot;st_purpose&quot;), pre:v(&quot;st_pre&quot;), steps:stReadSteps(), note:v(&quot;st_note&quot;) },
    qc:{ target:v(&quot;qc_target&quot;), by:v(&quot;qc_by&quot;), items:qcRead() }
  };
}
function hubSaveJson(){
  var data=collectAll();
  _saveBlob(JSON.stringify(data,null,2), &quot;qa_data_&quot;+stamp()+&quot;.json&quot;, &quot;application/json;charset=utf-8&quot;);
  toast(&quot;全データをJSON保存しました&quot;);
}
function applyAll(d){
  if(!d||typeof d!==&quot;object&quot;) return;
  function set(id,val){ var el=$(id); if(el) el.value=(val||&quot;&quot;); }
  if(d.req){ set(&quot;rq_title&quot;,d.req.title); set(&quot;rq_date&quot;,d.req.date); set(&quot;rq_who&quot;,d.req.who); set(&quot;rq_bg&quot;,d.req.bg);
    $(&quot;rqList&quot;).innerHTML=&quot;&quot;; (d.req.list||[]).forEach(function(r){ rqAdd(r.text,r.why); }); }
  if(d.spec){ set(&quot;sp_scope&quot;,d.spec.scope); set(&quot;sp_assume&quot;,d.spec.assume); set(&quot;sp_limit&quot;,d.spec.limit);
    $(&quot;spFunc&quot;).innerHTML=&quot;&quot;; (d.spec.func||[]).forEach(function(x){ spAddFunc(x); });
    $(&quot;spNf&quot;).innerHTML=&quot;&quot;; (d.spec.nf||[]).forEach(function(x){ spAddNf(x); }); }
  if(d.std){ set(&quot;st_title&quot;,d.std.title); set(&quot;st_role&quot;,d.std.role); set(&quot;st_purpose&quot;,d.std.purpose); set(&quot;st_pre&quot;,d.std.pre); set(&quot;st_note&quot;,d.std.note);
    $(&quot;stSteps&quot;).innerHTML=&quot;&quot;; (d.std.steps||[]).forEach(function(x){ stAddStep(x); }); }
  if(d.qc){ set(&quot;qc_target&quot;,d.qc.target); set(&quot;qc_by&quot;,d.qc.by);
    $(&quot;qcList&quot;).innerHTML=&quot;&quot;; (d.qc.items||[]).forEach(function(x){ qcAdd(x.v,x.r); var rows=document.querySelectorAll(&quot;#qcList .row&quot;); var last=rows[rows.length-1]; if(last&amp;&amp;x.note) last.querySelector(&quot;.qc-note&quot;).value=x.note; }); }
}
function hubLoadJson(input){
  var f=input&amp;&amp;input.files&amp;&amp;input.files[0]; if(!f){ return; }
  var rd=new FileReader();
  rd.onload=function(){ try{ var d=JSON.parse(rd.result); applyAll(d); toast(&quot;JSONを取り込みました&quot;); }catch(e){ toast(&quot;JSONの読み込みに失敗しました&quot;); } input.value=&quot;&quot;; };
  rd.readAsText(f);
}
function hubClearAll(){
  if(!window.confirm(&quot;すべての入力をクリアします。よろしいですか？&quot;)) return;
  [&quot;rq_title&quot;,&quot;rq_date&quot;,&quot;rq_who&quot;,&quot;rq_bg&quot;,&quot;sp_scope&quot;,&quot;sp_assume&quot;,&quot;sp_limit&quot;,&quot;st_title&quot;,&quot;st_role&quot;,&quot;st_purpose&quot;,&quot;st_pre&quot;,&quot;st_note&quot;,&quot;qc_target&quot;,&quot;qc_by&quot;].forEach(function(id){ var el=$(id); if(el) el.value=&quot;&quot;; });
  [&quot;rqList&quot;,&quot;spFunc&quot;,&quot;spNf&quot;,&quot;stSteps&quot;,&quot;qcList&quot;].forEach(function(id){ var el=$(id); if(el) el.innerHTML=&quot;&quot;; });
  setOut(&quot;&quot;); $(&quot;out&quot;).textContent=&quot;&quot;; $(&quot;traceView&quot;).innerHTML=&quot;&quot;;
  rqAdd(); spAddFunc(); spAddNf(); stAddStep(); qcAdd();
  toast(&quot;全クリアしました&quot;);
}

/* ============ タブ ============ */
function switchPanel(tab){
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){ t.classList.toggle(&quot;active&quot;, t.dataset.tab===tab); });
  [].slice.call(document.querySelectorAll(&quot;.panel&quot;)).forEach(function(p){ p.classList.toggle(&quot;active&quot;, p.id===&quot;panel-&quot;+tab); });
}

/* ============ 言語（UI辞書） ============ */
var UI_DICT={
  &quot;うさうさ 品質保証ジェネレーター&quot;:&quot;Usausa QA Generator&quot;,
  &quot;要求定義から要件定義・作業標準化・品質チェックまで。ブラウザだけで「作業のばらつき」を減らし、品質を保証するドキュメントを作れます。データは端末内のみ・外部送信なし。&quot;:&quot;From requirements to specs, work standardization and QA checks. Reduce variation and document quality assurance — all in your browser. Data stays on your device only.&quot;,
  &quot;📌 要求定義&quot;:&quot;📌 Requirements&quot;,&quot;📐 要件定義&quot;:&quot;📐 Specification&quot;,&quot;📋 作業標準化&quot;:&quot;📋 Standardization&quot;,
  &quot;✅ 品質チェック&quot;:&quot;✅ QA Check&quot;,&quot;🔗 トレーサビリティ&quot;:&quot;🔗 Traceability&quot;,&quot;🗂 データ統合&quot;:&quot;🗂 Data&quot;,
  &quot;要求定義（誰が・何を・なぜ）&quot;:&quot;Requirements (who / what / why)&quot;,
  &quot;要件定義（要求を満たす条件）&quot;:&quot;Specification (conditions to satisfy requirements)&quot;,
  &quot;作業標準化（手順書テンプレ）&quot;:&quot;Work Standardization (procedure template)&quot;,
  &quot;品質チェック（レビュー観点・検査記録）&quot;:&quot;QA Check (review points &amp; inspection log)&quot;,
  &quot;トレーサビリティ（要求→要件→作業→検査）&quot;:&quot;Traceability (req → spec → work → check)&quot;,
  &quot;データ統合（保存・書き出し・取り込み）&quot;:&quot;Data (save / export / import)&quot;,
  &quot;生成結果&quot;:&quot;Output&quot;,
  &quot;📋 コピー&quot;:&quot;📋 Copy&quot;,&quot;📄 テキスト保存&quot;:&quot;📄 Save as text&quot;,&quot;📝 Markdown保存&quot;:&quot;📝 Save as Markdown&quot;,&quot;クリア&quot;:&quot;Clear&quot;,
  &quot;要求定義書を生成する&quot;:&quot;Generate requirements doc&quot;,&quot;要件定義書を生成する&quot;:&quot;Generate specification doc&quot;,
  &quot;作業手順書を生成する&quot;:&quot;Generate procedure doc&quot;,&quot;品質チェック表を生成する&quot;:&quot;Generate QA checklist&quot;,
  &quot;トレーサビリティ・マトリクスを作る&quot;:&quot;Build traceability matrix&quot;,
  &quot;＋ 要求を追加&quot;:&quot;+ Add requirement&quot;,&quot;＋ 機能要件を追加&quot;:&quot;+ Add functional req&quot;,&quot;＋ 非機能要件を追加&quot;:&quot;+ Add non-functional req&quot;,
  &quot;＋ 手順を追加&quot;:&quot;+ Add step&quot;,&quot;＋ 観点を追加&quot;:&quot;+ Add check point&quot;,
  &quot;＋定番（要件充足・異常系・表記）&quot;:&quot;+ Standard (coverage / edge / wording)&quot;,&quot;＋セキュリティ観点&quot;:&quot;+ Security points&quot;,
  &quot;💾 全データをJSON保存&quot;:&quot;💾 Save all as JSON&quot;,&quot;📂 JSONを取り込む&quot;:&quot;📂 Import JSON&quot;,
  &quot;📊 品質チェック表をExcel出力&quot;:&quot;📊 Export QA checklist to Excel&quot;,&quot;🗑 全クリア&quot;:&quot;🗑 Clear all&quot;
,
  &quot;＋Web制作観点（表示・レスポンシブ・SEO）&quot;:&quot;+ Web build points (display / responsive / SEO)&quot;,  &quot;🌐 Web制作テンプレを入れる&quot;:&quot;🌐 Insert web build template&quot;,  &quot;🌐 Web公開手順テンプレを入れる&quot;:&quot;🌐 Insert web release procedure template&quot;
};
var LANG=&quot;jp&quot;;
function i18nTranslatable(el){ return el.childElementCount===0; }
function applyLang(lang){
  LANG=lang;
  document.body.classList.toggle(&quot;theme-jp&quot;, lang===&quot;jp&quot;);
  document.body.classList.toggle(&quot;theme-uk&quot;, lang!==&quot;jp&quot;);
  $(&quot;langJp&quot;).classList.toggle(&quot;active&quot;, lang===&quot;jp&quot;);
  $(&quot;langEn&quot;).classList.toggle(&quot;active&quot;, lang!==&quot;jp&quot;);
  var sel=&quot;header.hero h1,header.hero p,.tab,h2,h3,label,button,.hint,option&quot;;
  [].slice.call(document.querySelectorAll(sel)).forEach(function(el){
    if(!i18nTranslatable(el)) return;
    if(el.getAttribute(&quot;data-jp&quot;)==null){ el.setAttribute(&quot;data-jp&quot;, el.textContent.trim()); }
    var jp=el.getAttribute(&quot;data-jp&quot;); if(jp==null) return;
    if(lang===&quot;jp&quot;){ el.textContent=jp; }
    else { var en=UI_DICT[jp]; if(en!=null) el.textContent=en; }
  });
  try{ if(lsAvailable()) window.localStorage.setItem(&quot;usausa_qa_lang&quot;,&quot;jp&quot;===lang?&quot;jp&quot;:&quot;en&quot;); }catch(e){}
}
function setLang(lang){ applyLang(lang); }

/* ============ init ============ */
(function(){
  // 各タブに初期行を1つ
  rqAdd(); spAddFunc(); spAddNf(); stAddStep(); qcAdd();
  // タブのクリック
  [].slice.call(document.querySelectorAll(&quot;.tab&quot;)).forEach(function(t){
    t.addEventListener(&quot;click&quot;, function(){ switchPanel(t.dataset.tab); });
  });
  // 今日の日付
  try{ var vt=$(&quot;ver_today&quot;); if(vt) vt.textContent=nowParts().date; }catch(e){}
  // 言語初期化
  var saved=null; try{ if(lsAvailable()) saved=window.localStorage.getItem(&quot;usausa_qa_lang&quot;); }catch(e){}
  applyLang(saved===&quot;en&quot;?&quot;en&quot;:&quot;jp&quot;);
})();
</script>
</body>
</html>
"></iframe>
    <iframe id="frm-v26" title="IT現場ジェネレーター" srcdoc="<!DOCTYPE html>
<html lang=&quot;ja&quot;>
<head>
<meta charset=&quot;UTF-8&quot;>
<meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;>
<title>うさうさ式 IT現場ジェネレーター v2.6</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--font-sans)}
:root{
  --mono:var(--font-mono);
  /* うさうさ先生 パステル3色パレット：優しい緑・優しい黄・オフホワイト */
  --brand-green:#A8D5BA;        /* メイン：優しいパステルグリーン */
  --brand-green-deep:#5E9B77;   /* 緑の濃いめ（文字・アクセント用） */
  --brand-yellow:#F5E6A8;       /* アクセント：優しいパステルイエロー */
  --brand-yellow-deep:#B89320;  /* 黄の濃いめ（文字用） */
  --brand-cream:#FBFAF3;        /* 背景：オフホワイト */
  --brand-cream-deep:#EDE9D8;   /* オフホワイトの一段濃いめ（境界・帯用） */
  /* 旧変数を新パレットにマッピング（既存参照を保つ） */
  --brand-navy:#5E9B77;         /* → 濃い緑 */
  --brand-orange:#B89320;       /* → 濃い黄 */
  --brand-mint:#A8D5BA;         /* → パステル緑 */
}
.wrap{padding:1.25rem;background:var(--brand-cream);border-radius:var(--border-radius-lg)}
h2.title{font-size:22px;font-weight:600;color:var(--brand-green-deep);margin-bottom:4px;display:flex;align-items:center;gap:8px}
h2.title .bunny{font-size:24px}
.sub{font-size:13px;color:#7A8A7E;margin-bottom:1.25rem}
.card{background:#FFFFFF;border:0.5px solid var(--brand-cream-deep);border-radius:var(--border-radius-lg);padding:1.1rem;margin-bottom:.85rem}
.card-tight{padding:.85rem 1.1rem}
.section-label{font-size:11px;font-weight:600;color:var(--color-text-secondary);letter-spacing:.08em;text-transform:uppercase;margin-bottom:.55rem;display:flex;align-items:center;gap:6px}
.section-label .accent{width:3px;height:11px;background:var(--brand-green-deep);border-radius:2px;display:inline-block}
.row{display:grid;gap:10px;margin-bottom:10px}
.row.cols2{grid-template-columns:1fr 1fr}
.row.cols3{grid-template-columns:1fr 1fr 1fr}
.row.cols4{grid-template-columns:1fr 1fr 1fr 1fr}
label{font-size:12px;color:var(--color-text-secondary);display:block;margin-bottom:3px}
input[type=text],input[type=date],input[type=time],textarea,select{width:100%;font-family:var(--font-sans);font-size:13.5px}
textarea{resize:vertical;min-height:64px}

/* === タブ === */
.tabs{display:flex;gap:6px;margin-bottom:1rem;border-bottom:0.5px solid var(--brand-cream-deep);padding-bottom:0;flex-wrap:wrap}
.tab{flex:1;padding:.7rem .5rem;font-size:13px;font-weight:500;text-align:center;cursor:pointer;color:#7A8A7E;border:none;background:transparent;border-bottom:2px solid transparent;transition:all .15s;border-radius:6px 6px 0 0}
.tab:hover{background:rgba(168,213,186,.20);color:var(--brand-green-deep)}
.tab.active{color:var(--brand-green-deep);border-bottom-color:var(--brand-green-deep);background:rgba(168,213,186,.28);font-weight:600}
.tab .ic{margin-right:4px}
.panel{display:none}
.panel.active{display:block}

/* === 対象者セレクター === */
.audience-bar{background:linear-gradient(90deg,rgba(168,213,186,.22),rgba(245,230,168,.22));border:0.5px solid var(--color-border-tertiary);border-radius:var(--border-radius-lg);padding:.7rem .9rem;margin-bottom:1rem;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.audience-bar .lbl{font-size:11px;font-weight:600;color:var(--brand-navy);letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}
.audience-options{display:flex;gap:6px;flex-wrap:wrap;flex:1}
.aud{font-size:12px;padding:5px 11px;border-radius:20px;cursor:pointer;border:0.5px solid var(--color-border-secondary);background:var(--color-background-primary);color:var(--color-text-secondary);transition:all .15s;font-weight:500}
.aud:hover{border-color:var(--brand-mint)}
.aud.active[data-val=&quot;newbie&quot;]{background:#EAF3DE;color:#27500A;border-color:#97C459}
.aud.active[data-val=&quot;eng&quot;]{background:#E6F1FB;color:#0C447C;border-color:#85B7EB}
.aud.active[data-val=&quot;se&quot;]{background:#FAEEDA;color:#633806;border-color:#EF9F27}

/* === バッジ === */
.badge-row{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:4px}
.badge{font-size:12px;padding:4px 10px;border-radius:20px;cursor:pointer;border:0.5px solid var(--color-border-secondary);background:var(--color-background-secondary);color:var(--color-text-secondary);transition:all .15s}
.badge.active.pri-high{background:#FAECE7;color:#712B13;border-color:#F0997B}
.badge.active.pri-med{background:#FAEEDA;color:#633806;border-color:#EF9F27}
.badge.active.pri-low{background:#EAF3DE;color:#27500A;border-color:#97C459}
.badge.active.status{background:#E6F1FB;color:#0C447C;border-color:#85B7EB}
.badge.active.step{background:#EEEDFE;color:#3C3489;border-color:#AFA9EC}
.badge.active.conf{background:#FAECE7;color:#712B13;border-color:#F0997B}
.badge.active.default{background:var(--color-background-info);color:var(--color-text-info);border-color:var(--color-border-info)}

/* === ボタン === */
.btn-gen{width:100%;padding:.8rem;font-size:14.5px;font-weight:700;background:var(--brand-green);color:var(--brand-green-deep);border:none;border-radius:var(--border-radius-md);cursor:pointer;margin-bottom:1rem;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:8px}
.btn-gen:hover{background:var(--brand-green-deep);color:#fff;transform:translateY(-1px)}
.btn-copy{padding:.45rem .9rem;font-size:12.5px;border-radius:var(--border-radius-md);border:0.5px solid var(--color-border-secondary);background:var(--color-background-secondary);color:var(--color-text-primary);cursor:pointer;transition:all .15s}
.btn-copy:hover{background:var(--color-background-tertiary)}
.btn-mini{padding:5px 9px;font-size:11px;border-radius:var(--border-radius-md);border:0.5px solid var(--color-border-secondary);background:var(--color-background-primary);color:var(--color-text-secondary);cursor:pointer}
.btn-mini:hover{background:var(--color-background-secondary)}

/* === 出力 === */
.output-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:.7rem;gap:8px;flex-wrap:wrap}
.output-title{font-size:13.5px;font-weight:600;color:var(--color-text-primary);display:flex;align-items:center;gap:6px}
.output-actions{display:flex;gap:6px}
.output-box{background:var(--brand-cream);border:0.5px solid var(--brand-cream-deep);border-radius:var(--border-radius-md);padding:1rem;font-family:var(--font-mono);font-size:11.5px;line-height:1.75;white-space:pre-wrap;word-break:break-word;max-height:520px;overflow-y:auto;color:var(--color-text-primary)}
.copied{color:var(--color-text-success)!important;border-color:var(--color-border-success)!important}

/* === ステップ行 === */
.step-row{display:flex;gap:8px;align-items:flex-start;margin-bottom:8px}
.step-num{min-width:22px;height:22px;border-radius:50%;background:var(--color-background-info);color:var(--color-text-info);font-size:12px;font-weight:600;display:flex;align-items:center;justify-content:center;margin-top:7px;flex-shrink:0}

/* === パターンカード（報連相用） === */
.pattern-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin-bottom:4px}
.pattern-card{padding:.6rem .7rem;border:0.5px solid var(--color-border-secondary);border-radius:var(--border-radius-md);background:var(--color-background-primary);cursor:pointer;transition:all .15s;text-align:left}
.pattern-card:hover{border-color:var(--brand-mint);background:var(--color-background-secondary)}
.pattern-card.active{border-color:var(--brand-yellow-deep);background:var(--brand-yellow);box-shadow:0 0 0 1px var(--brand-yellow-deep) inset}
.pattern-card .pc-key{font-size:11px;font-weight:700;color:var(--brand-orange);letter-spacing:.08em;margin-bottom:2px}
.pattern-card.active .pc-key{color:#633806}
.pattern-card .pc-title{font-size:13px;font-weight:600;color:var(--color-text-primary);margin-bottom:3px}
.pattern-card .pc-desc{font-size:11px;color:var(--color-text-secondary);line-height:1.4}

/* === ヒントボックス === */
.hint{background:rgba(168,213,186,.25);border-left:3px solid var(--brand-green);padding:.5rem .75rem;border-radius:0 6px 6px 0;font-size:12px;color:#3A7355;margin-bottom:.7rem;line-height:1.5}
.hint.warn{background:rgba(245,230,168,.40);border-left-color:var(--brand-yellow-deep);color:#8A6D12}
.hint .ttl{font-weight:700;margin-right:6px}

/* === ヘッダーバー === */
.brand-stripe{display:flex;align-items:center;gap:8px;padding:6px 12px;background:linear-gradient(90deg,var(--brand-green),var(--brand-yellow));color:var(--brand-green-deep);border-radius:var(--border-radius-md);font-size:11px;font-weight:500;letter-spacing:.05em;margin-bottom:1rem;flex-wrap:wrap}
.brand-stripe .sep{opacity:.5}
.brand-stripe .meta{margin-left:auto;opacity:.85;font-size:10.5px}

/* === 設計5原則カード === */
.principles-card{background:linear-gradient(180deg,rgba(245,230,168,.30),rgba(168,213,186,.20));border:0.5px solid var(--brand-green);border-radius:var(--border-radius-lg);padding:0;margin-bottom:1rem;overflow:hidden}
.principles-header{display:flex;align-items:center;justify-content:space-between;padding:.85rem 1.1rem;cursor:pointer;user-select:none}
.principles-header:hover{background:rgba(168,213,186,.18)}
.principles-tag{font-size:10px;font-weight:600;background:var(--brand-green);color:var(--brand-green-deep);padding:2px 7px;border-radius:10px;margin-left:8px;letter-spacing:.03em;text-transform:none}
.principles-chev{font-size:14px;color:var(--brand-orange);transition:transform .2s}
.principles-card.collapsed .principles-chev{transform:rotate(-90deg)}
.principles-card.collapsed .principles-body{display:none}
.principles-body{padding:0 1.1rem 1rem 1.1rem}
.principle{display:flex;gap:12px;padding:.8rem 0;border-top:0.5px dashed var(--color-border-tertiary)}
.principle:first-of-type{border-top:none;padding-top:.5rem}
.principle-num{min-width:28px;height:28px;border-radius:50%;background:var(--brand-green);color:var(--brand-green-deep);font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-family:var(--font-mono)}
.principle-body{flex:1;min-width:0}
.principle-title{font-size:14px;font-weight:600;color:var(--brand-navy);margin-bottom:6px}
.chk{display:flex;align-items:flex-start;gap:6px;font-size:12.5px;color:var(--color-text-primary);margin-bottom:4px;cursor:pointer;line-height:1.45}
.chk input[type=checkbox]{margin-top:3px;cursor:pointer;accent-color:var(--brand-orange)}
.chk.small{font-size:12px;color:var(--color-text-secondary);margin-left:8px}
.vocab-zone{margin-top:8px;padding:.6rem .75rem;background:var(--color-background-secondary);border-radius:6px;border:0.5px dashed var(--color-border-tertiary)}
.vocab-row{display:grid;grid-template-columns:1fr 2fr auto;gap:6px;margin-bottom:5px;align-items:center}
.vocab-row input{font-size:12px;padding:4px 6px}
.example-box{margin-top:6px;padding:.45rem .65rem;background:var(--color-background-secondary);border-radius:6px;border-left:3px solid var(--brand-mint)}
.principle-summary{margin-top:1rem;padding-top:.8rem;border-top:0.5px solid var(--color-border-tertiary)}
.meter{width:100%;height:6px;background:var(--color-background-secondary);border-radius:3px;overflow:hidden}
.meter-fill{height:100%;background:linear-gradient(90deg,var(--brand-green),var(--brand-yellow-deep));width:0%;transition:width .3s ease}

/* === メモタブ：整形オプション === */
.opt-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:6px 14px}
.opt-grid .chk{font-size:12.5px;color:var(--color-text-primary)}
code{font-family:var(--font-mono);font-size:11px;background:var(--color-background-secondary);padding:1px 5px;border-radius:3px;color:var(--brand-orange)}

/* === レビュータブ === */
.self-check-row{display:flex;gap:8px;align-items:flex-start;margin-bottom:6px;padding:6px;border:0.5px solid var(--color-border-tertiary);border-radius:6px;background:var(--color-background-primary)}
.self-check-row .chk{flex:1;margin-bottom:0}
.self-check-row .sc-label{font-size:13px}
.self-check-row .sc-note{width:200px;font-size:12px;color:var(--color-text-secondary)}
.resp-item{border:0.5px solid var(--color-border-tertiary);border-left:3px solid var(--brand-orange);border-radius:6px;padding:.75rem;margin-bottom:10px;background:var(--color-background-primary)}
.resp-head{display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap}
.resp-num{font-size:13px;font-weight:700;color:var(--brand-orange);padding:3px 8px;background:#FAEEDA;border-radius:4px;min-width:60px;text-align:center}
.resp-type,.resp-action{font-size:12px;padding:4px 6px;flex:1;min-width:140px}
.resp-body label{font-size:11px;color:var(--color-text-secondary);display:block;margin:6px 0 3px}
.resp-body textarea{min-height:50px;font-size:12.5px}
.rev-item{border:0.5px solid var(--color-border-tertiary);border-left:4px solid var(--brand-orange);border-radius:6px;padding:.7rem .8rem;margin-bottom:8px;background:var(--color-background-primary)}
.rev-head{display:flex;gap:8px;align-items:center;margin-bottom:6px;flex-wrap:wrap}
.rev-badge{font-size:11px;font-weight:600;padding:3px 8px;border-radius:12px;border:0.5px solid;letter-spacing:.02em}
.rev-num{font-size:11px;color:var(--color-text-secondary);font-family:var(--font-mono)}
.rev-where{flex:1;font-size:12px;min-width:180px}
.rev-body label{font-size:11px;color:var(--color-text-secondary);display:block;margin:5px 0 3px}
.rev-body textarea{min-height:42px;font-size:12.5px}
.rev-body input{font-size:12.5px}

/* === Web制作タブ === */
.phase-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:8px;margin-bottom:4px}
.phase-card{padding:.6rem .5rem;border:0.5px solid var(--color-border-secondary);border-radius:var(--border-radius-md);background:var(--color-background-primary);cursor:pointer;transition:all .15s;text-align:center;display:flex;flex-direction:column;align-items:center;gap:3px}
.phase-card:hover{border-color:var(--brand-mint);background:var(--color-background-secondary);transform:translateY(-1px)}
.phase-card.active{border-color:var(--brand-yellow-deep);background:var(--brand-yellow);box-shadow:0 0 0 1px var(--brand-yellow-deep) inset}
.phase-card .ph-num{font-size:11px;font-weight:700;color:var(--brand-orange);font-family:var(--font-mono)}
.phase-card .ph-icon{font-size:22px;line-height:1}
.phase-card .ph-name{font-size:11px;font-weight:600;color:var(--color-text-primary);line-height:1.3}
.phase-card.phase-final{border:0.5px dashed var(--brand-yellow-deep);background:linear-gradient(180deg,rgba(245,230,168,.30),transparent)}
.phase-card.phase-final.active{border-style:solid}
.aud[data-pers=&quot;student&quot;].active{background:#EAF3DE;color:#27500A;border-color:#97C459}
.aud[data-pers=&quot;teacher&quot;].active{background:#FAEEDA;color:#633806;border-color:#EF9F27}

/* === ToDoタブ === */
.todo-item{border:0.5px solid var(--brand-cream-deep);border-left:3px solid var(--brand-green);border-radius:var(--border-radius-md);padding:.7rem .8rem;margin-bottom:8px;background:#fff}
.todo-item.overdue{border-left-color:#E0846A;background:rgba(224,132,106,.05)}
.todo-item.done{border-left-color:#A8D5BA;opacity:.7}
.todo-row1{display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap}
.todo-num{min-width:24px;height:24px;border-radius:50%;background:rgba(168,213,186,.35);color:var(--brand-green-deep);font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-family:var(--font-mono)}
.todo-task{flex:1;min-width:200px;font-size:13.5px}
.todo-row2{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr 0.9fr;gap:6px;align-items:end}
.todo-row2 label{font-size:10px;color:#7A8A7E;margin-bottom:2px}
.todo-row2 input,.todo-row2 select{font-size:12px;padding:4px 6px}
.todo-del{padding:5px 8px;font-size:11px}
@media(max-width:640px){.todo-row2{grid-template-columns:1fr 1fr}}

/* === 依頼＆分配タブ === */
.aud[data-areqdir].active{background:rgba(168,213,186,.35);color:var(--brand-green-deep);border-color:var(--brand-green)}
.alog-item{border:0.5px solid var(--brand-cream-deep);border-left:3px solid var(--brand-green);border-radius:6px;padding:.6rem .7rem;margin-bottom:8px;background:#fff}
.alog-head{display:flex;gap:8px;align-items:center;margin-bottom:6px;flex-wrap:wrap}
.alog-head select,.alog-head input{font-size:12px;padding:4px 6px}
.alog-head .alog-type{min-width:120px}
.member-card{border:0.5px solid var(--brand-cream-deep);border-radius:8px;padding:.7rem .8rem;margin-bottom:8px;background:#fff}
.member-row1{display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap}
.member-row1 .m-name{flex:1;min-width:140px;font-weight:600}
.member-row1 .m-points{width:130px}
.skill-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.skill-cell{background:var(--brand-cream);border-radius:6px;padding:6px;text-align:center}
.skill-cell label{font-size:10.5px;color:#7A8A7E;display:block;margin-bottom:3px}
.skill-cell select{font-size:13px;padding:3px;width:100%;text-align:center}
.task-card{border:0.5px solid var(--brand-cream-deep);border-left:3px solid var(--brand-yellow-deep);border-radius:6px;padding:.6rem .7rem;margin-bottom:8px;background:#fff}
.task-row{display:grid;grid-template-columns:1.6fr 1fr 1fr 0.8fr auto;gap:6px;align-items:end}
.task-row label{font-size:10px;color:#7A8A7E;margin-bottom:2px}
.task-row input,.task-row select{font-size:12px;padding:4px 6px}
@media(max-width:640px){.task-row{grid-template-columns:1fr 1fr}.skill-grid{grid-template-columns:1fr}}
.result-card{background:#fff;border:0.5px solid var(--brand-cream-deep);border-radius:8px;padding:.8rem;margin-bottom:8px}
.result-task{font-weight:600;font-size:13.5px;color:var(--color-text-primary);margin-bottom:4px}
.result-pick{font-size:13px;color:var(--brand-green-deep);font-weight:600}
.result-reason{font-size:11.5px;color:#7A8A7E;margin-top:4px;line-height:1.5}
.result-none{font-size:12.5px;color:#C8553D;font-weight:600}
.result-summary{background:rgba(168,213,186,.18);border-radius:8px;padding:.7rem .8rem;margin-top:10px;font-size:12.5px;line-height:1.7}

/* === 研修ドキュメントタブ：時間割セッション === */
.sess-item{display:grid;grid-template-columns:auto 1.4fr 0.7fr 1fr 1.6fr auto;gap:6px;align-items:end;border:0.5px solid var(--brand-cream-deep);border-radius:6px;padding:.5rem .6rem;margin-bottom:6px;background:#fff}
.sess-item label{font-size:10px;color:#7A8A7E;margin-bottom:2px}
.sess-item input,.sess-item select{font-size:12px;padding:4px 6px}
.sess-time{font-family:var(--font-mono);font-size:11px;color:var(--brand-green-deep);font-weight:600;min-width:90px;text-align:center;padding-bottom:6px}
@media(max-width:640px){.sess-item{grid-template-columns:1fr 1fr}}

/* === Jira風チケット === */
.ticket-item{border:0.5px solid var(--brand-cream-deep);border-radius:6px;padding:.6rem .7rem;margin-bottom:8px;background:#fff}
.ticket-item.is-story{border-left:3px solid var(--brand-green-deep)}
.ticket-item.is-sub{border-left:3px solid var(--brand-yellow-deep);margin-left:20px}
.ticket-head{display:flex;gap:8px;align-items:center;margin-bottom:6px;flex-wrap:wrap}
.ticket-type{font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:4px}
.ticket-type.story{background:rgba(94,155,119,.18);color:var(--brand-green-deep)}
.ticket-type.sub{background:rgba(184,147,32,.18);color:var(--brand-yellow-deep)}
.ticket-head input.tk-title{flex:1;min-width:160px;font-size:13px}
.ticket-row{display:grid;grid-template-columns:1fr 1.2fr 0.7fr;gap:6px;align-items:end}
.ticket-row label{font-size:10px;color:#7A8A7E;margin-bottom:2px}
.ticket-row input,.ticket-row select{font-size:12px;padding:4px 6px}
@media(max-width:640px){.ticket-row{grid-template-columns:1fr 1fr}}

/* === メモタブ：オプショングリッド === */
.opt-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px}
@media (max-width:600px){.opt-grid{grid-template-columns:1fr}}
.hint code{background:rgba(94,155,119,.14);color:var(--brand-green-deep);padding:1px 5px;border-radius:3px;font-family:var(--font-mono);font-size:11.5px;font-weight:500}

  .lang-switch{display:none !important;}
</style>

<div class=&quot;wrap&quot;>
<h2 class=&quot;title&quot;><span class=&quot;bunny&quot;>🐰</span> うさうさ式 IT現場ジェネレーター <span style=&quot;font-size:12px;color:var(--color-text-tertiary);font-weight:400&quot;>v2.6 — 2026-05-21</span></h2>
<p class=&quot;sub&quot;>作業手順書・報連相・認識確認をNotionコピペ用マークダウンで自動生成（非エンジニア研修／エンジニア研修／社内SE切替対応）</p>

<div class=&quot;brand-stripe&quot;>
  <span>📐 ISO 9001 / ISO/IEC 27001 準拠様式</span>
  <span class=&quot;sep&quot;>|</span>
  <span>📝 事実と所感を分ける</span>
  <span class=&quot;sep&quot;>|</span>
  <span>🎯 受講生視点で書く</span>
  <span class=&quot;sep&quot;>|</span>
  <span>✅ v2.6（2026-05-21 全13タブ26モード試験合格・README風タブ追加）</span>
  <span class=&quot;meta&quot;>面白きこともなき世を面白く ─ 高杉晋作</span>
</div>

<!-- === 対象者セレクター === -->
<div class=&quot;audience-bar&quot;>
  <span class=&quot;lbl&quot;>👤 対象者</span>
  <div class=&quot;audience-options&quot; id=&quot;aud-group&quot;>
    <span class=&quot;aud&quot; data-val=&quot;newbie&quot;>🌱 非エンジニア研修生</span>
    <span class=&quot;aud&quot; data-val=&quot;eng&quot;>🛠 エンジニア研修生</span>
    <span class=&quot;aud&quot; data-val=&quot;se&quot;>🏢 社内SE / 実務者</span>
  </div>
</div>

<!-- === うさうさ式 設計5原則チェックリスト（全タブ共通） === -->
<div class=&quot;card principles-card&quot; id=&quot;principles&quot;>
  <div class=&quot;principles-header&quot; id=&quot;principles-toggle&quot;>
    <div class=&quot;section-label&quot; style=&quot;margin-bottom:0&quot;><span class=&quot;accent&quot;></span>📐 うさうさ式 設計5原則チェックリスト <span class=&quot;principles-tag&quot;>全タブ共通 / 生成物に自動反映</span></div>
    <span class=&quot;principles-chev&quot; id=&quot;principles-chev&quot;>▾</span>
  </div>
  <div class=&quot;principles-body&quot; id=&quot;principles-body&quot;>

    <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 使い方：</span>作業手順書・報連相・認識確認のいずれを書く前にも、この5原則を通すと「相手に伝わる文書」になります。チェックと用語定義は生成マークダウンに自動で含まれます。</div>

    <!-- ① 言葉を定義する -->
    <div class=&quot;principle&quot;>
      <div class=&quot;principle-num&quot;>①</div>
      <div class=&quot;principle-body&quot;>
        <div class=&quot;principle-title&quot;>言葉を定義する</div>
        <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; data-pchk=&quot;p1a&quot;><span>曖昧な用語をゼロにする</span></label>
        <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; data-pchk=&quot;p1b&quot;><span>共通言語を揃える</span></label>
        <div class=&quot;vocab-zone&quot;>
          <div style=&quot;font-size:11px;color:var(--color-text-secondary);margin-bottom:5px&quot;>📖 語彙集（このタスクで使う用語を定義しておく）</div>
          <div id=&quot;vocab-list&quot;></div>
          <button class=&quot;btn-mini&quot; id=&quot;add-vocab&quot; style=&quot;margin-top:5px&quot;>＋ 用語を追加</button>
        </div>
      </div>
    </div>

    <!-- ② 目的・ゴール・対象 -->
    <div class=&quot;principle&quot;>
      <div class=&quot;principle-num&quot;>②</div>
      <div class=&quot;principle-body&quot;>
        <div class=&quot;principle-title&quot;>目的・ゴール・対象を決める</div>
        <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; data-pchk=&quot;p2a&quot;><span>「何のために」「どこまで」「誰向けに」を明確にする</span></label>
        <div class=&quot;row cols3&quot; style=&quot;margin-top:6px&quot;>
          <div><label>何のために</label><input type=&quot;text&quot; id=&quot;p2_why&quot; placeholder=&quot;例：新人が独力でAPI実装できるようにする&quot;></div>
          <div><label>どこまで</label><input type=&quot;text&quot; id=&quot;p2_scope&quot; placeholder=&quot;例：CRUD操作とエラーハンドリングまで&quot;></div>
          <div><label>誰向けに</label><input type=&quot;text&quot; id=&quot;p2_for&quot; placeholder=&quot;例：プログラム未経験の新卒5名&quot;></div>
        </div>
      </div>
    </div>

    <!-- ③ 主語＋動詞 -->
    <div class=&quot;principle&quot;>
      <div class=&quot;principle-num&quot;>③</div>
      <div class=&quot;principle-body&quot;>
        <div class=&quot;principle-title&quot;>主語＋動詞でステップを書く</div>
        <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; data-pchk=&quot;p3a&quot;><span>作業を「行動単位」に分解する</span></label>
        <div class=&quot;example-box&quot;>
          <div style=&quot;font-size:11px;color:var(--color-text-secondary);margin-bottom:4px&quot;>📌 例：</div>
          <label class=&quot;chk small&quot;><input type=&quot;checkbox&quot; data-pchk=&quot;p3ex1&quot;><span>受講生が理解する</span></label>
          <label class=&quot;chk small&quot;><input type=&quot;checkbox&quot; data-pchk=&quot;p3ex2&quot;><span>講師が説明する</span></label>
          <label class=&quot;chk small&quot;><input type=&quot;checkbox&quot; data-pchk=&quot;p3ex3&quot;><span>メンターが確認する</span></label>
        </div>
        <input type=&quot;text&quot; id=&quot;p3_actors&quot; placeholder=&quot;このタスクの登場人物（カンマ区切り）：例：講師, 受講生, メンター, リーダー&quot; style=&quot;margin-top:6px&quot;>
      </div>
    </div>

    <!-- ④ 気を付けることを全部書く -->
    <div class=&quot;principle&quot;>
      <div class=&quot;principle-num&quot;>④</div>
      <div class=&quot;principle-body&quot;>
        <div class=&quot;principle-title&quot;>気を付けることを全部書く</div>
        <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; data-pchk=&quot;p4a&quot;><span>失敗ポイント・注意点・落とし穴を先に書き出す</span></label>
        <textarea id=&quot;p4_pitfalls&quot; placeholder=&quot;例：&amp;#10;- 新人は『接続できません』とだけ言いがち → 何のどの段階かまで聞き出す&amp;#10;- 環境変数の設定漏れで30分溶ける&amp;#10;- バックアップ取得前に作業を始めてしまう&quot; style=&quot;margin-top:6px;min-height:60px&quot;></textarea>
      </div>
    </div>

    <!-- ⑤ 完了条件と期限 -->
    <div class=&quot;principle&quot;>
      <div class=&quot;principle-num&quot;>⑤</div>
      <div class=&quot;principle-body&quot;>
        <div class=&quot;principle-title&quot;>完了条件と期限</div>
        <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; data-pchk=&quot;p5a&quot;><span>Notion の ToDo リストに落とし込む</span></label>
        <div class=&quot;row cols2&quot; style=&quot;margin-top:6px&quot;>
          <div><label>完了の判定条件（DoD）</label><input type=&quot;text&quot; id=&quot;p5_dod&quot; placeholder=&quot;例：レビュー承認＋本番稼働24h無事象&quot;></div>
          <div><label>期限</label><input type=&quot;text&quot; id=&quot;p5_due&quot; placeholder=&quot;例：2026/05/29 17:00&quot;></div>
        </div>
      </div>
    </div>

    <div class=&quot;principle-summary&quot;>
      <div style=&quot;font-size:11px;color:var(--color-text-secondary);margin-bottom:6px&quot;>📊 達成度</div>
      <div class=&quot;meter&quot;><div class=&quot;meter-fill&quot; id=&quot;meter-fill&quot;></div></div>
      <div style=&quot;font-size:11px;color:var(--color-text-secondary);margin-top:4px;text-align:right&quot; id=&quot;meter-text&quot;>0 / 10 チェック</div>
    </div>

  </div>
</div>

<!-- === タブ === -->
<div class=&quot;tabs&quot; id=&quot;tab-bar&quot;>
  <button class=&quot;tab active&quot; data-tab=&quot;task&quot;><span class=&quot;ic&quot;>📋</span>作業手順書</button>
  <button class=&quot;tab&quot; data-tab=&quot;hourensou&quot;><span class=&quot;ic&quot;>📞</span>報連相</button>
  <button class=&quot;tab&quot; data-tab=&quot;confirm&quot;><span class=&quot;ic&quot;>✅</span>認識・理解確認</button>
  <button class=&quot;tab&quot; data-tab=&quot;memo&quot;><span class=&quot;ic&quot;>📝</span>メモ→MD</button>
  <button class=&quot;tab&quot; data-tab=&quot;review&quot;><span class=&quot;ic&quot;>🔍</span>レビュー</button>
  <button class=&quot;tab&quot; data-tab=&quot;web&quot;><span class=&quot;ic&quot;>🎨</span>Web制作</button>
  <button class=&quot;tab&quot; data-tab=&quot;intake&quot;><span class=&quot;ic&quot;>💼</span>お仕事受領</button>
  <button class=&quot;tab&quot; data-tab=&quot;todo&quot;><span class=&quot;ic&quot;>✅</span>ToDo/進捗</button>
  <button class=&quot;tab&quot; data-tab=&quot;assign&quot;><span class=&quot;ic&quot;>🤝</span>依頼＆分配</button>
  <button class=&quot;tab&quot; data-tab=&quot;docs&quot;><span class=&quot;ic&quot;>📄</span>研修ドキュメント</button>
  <button class=&quot;tab&quot; data-tab=&quot;comm&quot;><span class=&quot;ic&quot;>📋</span>現場コミュ</button>
  <button class=&quot;tab&quot; data-tab=&quot;grow&quot;><span class=&quot;ic&quot;>🎓</span>育成＆社内SE</button>
  <button class=&quot;tab&quot; data-tab=&quot;readme&quot;><span class=&quot;ic&quot;>📘</span>README</button>
</div>

<!-- =========================================== -->
<!-- ============ TAB 1: 作業手順書 ============ -->
<!-- =========================================== -->
<div class=&quot;panel active&quot; id=&quot;panel-task&quot;>

<div class=&quot;card card-tight&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ISO文書管理情報</div>
  <div class=&quot;row cols4&quot;>
    <div><label>文書番号</label><input type=&quot;text&quot; id=&quot;t_docno&quot; placeholder=&quot;例：PROC-2026-0001&quot;></div>
    <div><label>版数</label><input type=&quot;text&quot; id=&quot;t_rev&quot; placeholder=&quot;例：Rev.1.0&quot; value=&quot;Rev.1.0&quot;></div>
    <div><label>機密区分</label>
      <select id=&quot;t_conf&quot;>
        <option value=&quot;公開&quot;>公開</option>
        <option value=&quot;社内限&quot; selected>社内限</option>
        <option value=&quot;社外秘&quot;>社外秘</option>
        <option value=&quot;極秘&quot;>極秘</option>
      </select>
    </div>
    <div><label>関連文書</label><input type=&quot;text&quot; id=&quot;t_relate&quot; placeholder=&quot;例：SEC-POL-001&quot;></div>
  </div>
  <div class=&quot;row cols3&quot;>
    <div><label>作成者</label><input type=&quot;text&quot; id=&quot;t_author&quot; placeholder=&quot;例：山田花子&quot;></div>
    <div><label>確認者</label><input type=&quot;text&quot; id=&quot;t_checker&quot; placeholder=&quot;例：佐藤太郎&quot;></div>
    <div><label>承認者</label><input type=&quot;text&quot; id=&quot;t_approver&quot; placeholder=&quot;例：部門長&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>基本情報</div>
  <div class=&quot;row cols2&quot;>
    <div><label>タスク名 / 件名</label><input type=&quot;text&quot; id=&quot;title&quot; placeholder=&quot;例：本番DBマイグレーション対応&quot;></div>
    <div><label>担当者</label><input type=&quot;text&quot; id=&quot;assignee&quot; placeholder=&quot;例：山田太郎&quot;></div>
  </div>
  <div class=&quot;row cols3&quot;>
    <div><label>作成日</label><input type=&quot;date&quot; id=&quot;created&quot;></div>
    <div><label>期限</label><input type=&quot;date&quot; id=&quot;deadline&quot;></div>
    <div><label>完了条件</label><input type=&quot;text&quot; id=&quot;done_cond&quot; placeholder=&quot;例：ステージング確認済み&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>緊急度 / 優先度</div>
  <div style=&quot;margin-bottom:10px&quot;>
    <label>緊急度</label>
    <div class=&quot;badge-row&quot; id=&quot;emergency-group&quot;>
      <span class=&quot;badge&quot; data-group=&quot;emergency&quot; data-val=&quot;🚨 緊急&quot; data-cls=&quot;pri-high&quot;>🚨 緊急</span>
      <span class=&quot;badge&quot; data-group=&quot;emergency&quot; data-val=&quot;⚠️ 注意&quot; data-cls=&quot;pri-med&quot;>⚠️ 注意</span>
      <span class=&quot;badge&quot; data-group=&quot;emergency&quot; data-val=&quot;ℹ️ 通常&quot; data-cls=&quot;pri-low&quot;>ℹ️ 通常</span>
    </div>
  </div>
  <div>
    <label>優先度</label>
    <div class=&quot;badge-row&quot; id=&quot;priority-group&quot;>
      <span class=&quot;badge&quot; data-group=&quot;priority&quot; data-val=&quot;🔴 高&quot; data-cls=&quot;pri-high&quot;>🔴 高</span>
      <span class=&quot;badge&quot; data-group=&quot;priority&quot; data-val=&quot;🟡 中&quot; data-cls=&quot;pri-med&quot;>🟡 中</span>
      <span class=&quot;badge&quot; data-group=&quot;priority&quot; data-val=&quot;🟢 低&quot; data-cls=&quot;pri-low&quot;>🟢 低</span>
    </div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>対応ステータス</div>
  <div class=&quot;badge-row&quot; id=&quot;status-group&quot;>
    <span class=&quot;badge&quot; data-group=&quot;status&quot; data-val=&quot;📋 未着手&quot; data-cls=&quot;status&quot;>📋 未着手</span>
    <span class=&quot;badge&quot; data-group=&quot;status&quot; data-val=&quot;🔄 対応中&quot; data-cls=&quot;status&quot;>🔄 対応中</span>
    <span class=&quot;badge&quot; data-group=&quot;status&quot; data-val=&quot;🔍 レビュー中&quot; data-cls=&quot;status&quot;>🔍 レビュー中</span>
    <span class=&quot;badge&quot; data-group=&quot;status&quot; data-val=&quot;✅ 完了&quot; data-cls=&quot;status&quot;>✅ 完了</span>
    <span class=&quot;badge&quot; data-group=&quot;status&quot; data-val=&quot;⏸ 保留&quot; data-cls=&quot;status&quot;>⏸ 保留</span>
    <span class=&quot;badge&quot; data-group=&quot;status&quot; data-val=&quot;❌ キャンセル&quot; data-cls=&quot;status&quot;>❌ キャンセル</span>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>概要 / 目的</div>
  <div class=&quot;row&quot;>
    <div><label>背景・目的</label><textarea id=&quot;purpose&quot; placeholder=&quot;例：v2.1リリースに伴い、usersテーブルにカラム追加が必要。本番停止なしで実施する。&quot;></textarea></div>
    <div><label>影響範囲</label><textarea id=&quot;scope&quot; placeholder=&quot;例：APIサーバー全台、管理画面ログイン機能&quot; style=&quot;min-height:50px&quot;></textarea></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>作業ステップ（主語＋動詞で記述）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>💡 書き方のコツ：</span>「誰が・何を・どうする」の3点セット。曖昧な「対応する」ではなく「ログを確認する／コマンドを実行する」と具体動詞で。</div>
  <div id=&quot;steps-container&quot;></div>
  <button class=&quot;btn-copy&quot; id=&quot;add-step&quot; style=&quot;width:100%;margin-top:8px&quot;>＋ ステップを追加</button>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>気を付けること / 注意事項</div>
  <textarea id=&quot;caution&quot; placeholder=&quot;例：&amp;#10;- 本番実行前に必ずバックアップを取得する&amp;#10;- 実行ユーザーはadminであること&amp;#10;- ロールバック手順を事前に確認する&quot;></textarea>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ロールバック手順</div>
  <textarea id=&quot;rollback&quot; placeholder=&quot;例：&amp;#10;1. スナップショットから復元&amp;#10;2. リリースフラグをOFFに変更&amp;#10;3. ヘルスチェック確認&quot; style=&quot;min-height:60px&quot;></textarea>
</div>

<button class=&quot;btn-gen&quot; id=&quot;gen-btn&quot;>📋 作業手順書のマークダウンを生成する</button>

<div class=&quot;card&quot; id=&quot;output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（作業手順書）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;dl-btn&quot; data-out=&quot;output&quot; data-prefix=&quot;作業手順書&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;output&quot;></div>
</div>

</div><!-- /panel-task -->

<!-- =========================================== -->
<!-- ============ TAB 2: 報連相 ================ -->
<!-- =========================================== -->
<div class=&quot;panel&quot; id=&quot;panel-hourensou&quot;>

<div class=&quot;card card-tight&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ISO文書管理情報</div>
  <div class=&quot;row cols4&quot;>
    <div><label>文書番号</label><input type=&quot;text&quot; id=&quot;h_docno&quot; placeholder=&quot;例：HRN-2026-0001&quot;></div>
    <div><label>版数</label><input type=&quot;text&quot; id=&quot;h_rev&quot; placeholder=&quot;例：Rev.1.0&quot; value=&quot;Rev.1.0&quot;></div>
    <div><label>機密区分</label>
      <select id=&quot;h_conf&quot;>
        <option value=&quot;公開&quot;>公開</option>
        <option value=&quot;社内限&quot; selected>社内限</option>
        <option value=&quot;社外秘&quot;>社外秘</option>
        <option value=&quot;極秘&quot;>極秘</option>
      </select>
    </div>
    <div><label>関連チケット</label><input type=&quot;text&quot; id=&quot;h_relate&quot; placeholder=&quot;例：JIRA-1234&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>パターン選択（5パターン A〜E）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>📐 うさうさ式 報連相5パターン：</span>状況に応じてパターンを選ぶと、適切な順序と必須項目で生成されます。「事実 → 所感 → 依頼」の3層構造を必ず守ります。</div>
  <div class=&quot;pattern-grid&quot; id=&quot;pattern-group&quot;>
    <div class=&quot;pattern-card&quot; data-pattern=&quot;A&quot;>
      <div class=&quot;pc-key&quot;>パターン A</div>
      <div class=&quot;pc-title&quot;>🚨 緊急報告</div>
      <div class=&quot;pc-desc&quot;>障害・トラブル発生時。即時の判断を仰ぐ。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-pattern=&quot;B&quot;>
      <div class=&quot;pc-key&quot;>パターン B</div>
      <div class=&quot;pc-title&quot;>💡 相談</div>
      <div class=&quot;pc-desc&quot;>判断に迷う・選択肢を整理して指示を仰ぐ。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-pattern=&quot;C&quot;>
      <div class=&quot;pc-key&quot;>パターン C</div>
      <div class=&quot;pc-title&quot;>📢 連絡</div>
      <div class=&quot;pc-desc&quot;>情報共有・周知。返答不要のことも多い。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-pattern=&quot;D&quot;>
      <div class=&quot;pc-key&quot;>パターン D</div>
      <div class=&quot;pc-title&quot;>📊 進捗報告</div>
      <div class=&quot;pc-desc&quot;>タスクの状態を定期的に共有する。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-pattern=&quot;E&quot;>
      <div class=&quot;pc-key&quot;>パターン E</div>
      <div class=&quot;pc-title&quot;>❓ 質問・確認</div>
      <div class=&quot;pc-desc&quot;>不明点を解消する。自分の調査結果も添えて。</div>
    </div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>発信者（自分）</label><input type=&quot;text&quot; id=&quot;h_from&quot; placeholder=&quot;例：山田太郎&quot;></div>
    <div><label>宛先</label><input type=&quot;text&quot; id=&quot;h_to&quot; placeholder=&quot;例：リーダー / 開発チーム&quot;></div>
    <div><label>件名</label><input type=&quot;text&quot; id=&quot;h_title&quot; placeholder=&quot;例：ステージング環境でAPI 500エラー発生&quot;></div>
  </div>
  <div class=&quot;row cols3&quot;>
    <div><label>発生日</label><input type=&quot;date&quot; id=&quot;h_date&quot;></div>
    <div><label>発生時刻</label><input type=&quot;time&quot; id=&quot;h_time&quot;></div>
    <div><label>連絡手段</label>
      <select id=&quot;h_channel&quot;>
        <option value=&quot;Slack&quot; selected>Slack</option>
        <option value=&quot;メール&quot;>メール</option>
        <option value=&quot;口頭&quot;>口頭</option>
        <option value=&quot;チャット（Teams）&quot;>チャット（Teams）</option>
        <option value=&quot;電話&quot;>電話</option>
      </select>
    </div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>① 事実（FACT）— 5W2Hで客観的に</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>⚖️ 重要：</span>ここには「実際に観察したこと・確認できたこと」だけを書く。推測や感想は次のセクションへ。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>いつ（When）</label><input type=&quot;text&quot; id=&quot;h_when&quot; placeholder=&quot;例：本日14:30頃&quot;></div>
    <div><label>どこで（Where）</label><input type=&quot;text&quot; id=&quot;h_where&quot; placeholder=&quot;例：ステージング環境 api-stg-01&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>誰が（Who）</label><input type=&quot;text&quot; id=&quot;h_who&quot; placeholder=&quot;例：自分（QA作業中）&quot;></div>
    <div><label>何を（What）</label><input type=&quot;text&quot; id=&quot;h_what&quot; placeholder=&quot;例：ユーザー一覧APIで500エラーが発生&quot;></div>
  </div>
  <div><label>どのように（How）／観察した内容</label><textarea id=&quot;h_how&quot; placeholder=&quot;例：&amp;#10;- レスポンスタイムが通常200msのところ8秒以上&amp;#10;- エラーログに『Connection timeout to db』&amp;#10;- 過去30分で同様のエラーが12件発生&quot;></textarea></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>② 所感・推測（IMPRESSION）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>⚠️ 注意：</span>事実と所感を必ず分ける。「〜と思います」「〜の可能性があります」と推測であることを明示。</div>
  <textarea id=&quot;h_impression&quot; placeholder=&quot;例：&amp;#10;- DB接続プールの枯渇が原因の可能性があると考えています&amp;#10;- 直前のデプロイでコネクション設定変更があったため、それが影響しているかもしれません&quot;></textarea>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>③ 依頼事項（REQUEST）</div>
  <div class=&quot;row cols2&quot;>
    <div><label>お願いしたいこと</label><textarea id=&quot;h_request&quot; placeholder=&quot;例：&amp;#10;- 設定変更を一旦ロールバックしてよいかご判断ください&amp;#10;- インフラチームへの連携要否を相談させてください&quot; style=&quot;min-height:60px&quot;></textarea></div>
    <div><label>いつまでに</label><input type=&quot;text&quot; id=&quot;h_when_need&quot; placeholder=&quot;例：本日17時まで（業務影響のため）&quot;></div>
  </div>
  <div><label>自分で取った／取る予定の対応</label><textarea id=&quot;h_self_action&quot; placeholder=&quot;例：&amp;#10;- ログ取得済み（添付）&amp;#10;- 該当APIのモニタリングを継続中&quot; style=&quot;min-height:50px&quot;></textarea></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>選択肢の提示（パターンB「相談」のとき）</div>
  <textarea id=&quot;h_options&quot; placeholder=&quot;例：&amp;#10;案1：即座にロールバック → 影響：機能Aの新規利用者に影響あり / メリット：早期復旧&amp;#10;案2：原因調査優先 → 影響：障害継続 / メリット：根本対策可能&amp;#10;案3：縮退運用に切替 → 影響：限定機能のみ / メリット：両立可能&quot;></textarea>
</div>

<button class=&quot;btn-gen&quot; id=&quot;h_gen-btn&quot;>📞 報連相のマークダウンを生成する</button>

<div class=&quot;card&quot; id=&quot;h_output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（報連相）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;h_copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;h_dl-btn&quot; data-out=&quot;h_output&quot; data-prefix=&quot;報連相&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;h_output&quot;></div>
</div>

</div><!-- /panel-hourensou -->

<!-- =========================================== -->
<!-- ========= TAB 3: 認識・理解確認 ============ -->
<!-- =========================================== -->
<div class=&quot;panel&quot; id=&quot;panel-confirm&quot;>

<div class=&quot;card card-tight&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ISO文書管理情報</div>
  <div class=&quot;row cols4&quot;>
    <div><label>文書番号</label><input type=&quot;text&quot; id=&quot;c_docno&quot; placeholder=&quot;例：CFM-2026-0001&quot;></div>
    <div><label>版数</label><input type=&quot;text&quot; id=&quot;c_rev&quot; placeholder=&quot;例：Rev.1.0&quot; value=&quot;Rev.1.0&quot;></div>
    <div><label>機密区分</label>
      <select id=&quot;c_conf&quot;>
        <option value=&quot;公開&quot;>公開</option>
        <option value=&quot;社内限&quot; selected>社内限</option>
        <option value=&quot;社外秘&quot;>社外秘</option>
      </select>
    </div>
    <div><label>関連指示書</label><input type=&quot;text&quot; id=&quot;c_relate&quot; placeholder=&quot;例：INST-2026-005&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>うさうさ式 認識確認フレーム</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🎯 目的：</span>「指示を受けた直後」に、自分の理解が正しいかを文書化して指示元に確認するためのテンプレート。手戻り防止・期待値ズレ防止のための重要工程。</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>📐 構造：</span>定義 → 比喩 → 詳細整理 → 一行まとめ の4階層で自分の理解を可視化する。</div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>確認者（自分）</label><input type=&quot;text&quot; id=&quot;c_self&quot; placeholder=&quot;例：山田太郎&quot;></div>
    <div><label>指示元</label><input type=&quot;text&quot; id=&quot;c_giver&quot; placeholder=&quot;例：リーダー&quot;></div>
    <div><label>指示を受けた日時</label><input type=&quot;date&quot; id=&quot;c_date&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>タスク名</label><input type=&quot;text&quot; id=&quot;c_title&quot; placeholder=&quot;例：新人向けLPIC-2研修資料の修正&quot;></div>
    <div><label>確認方法</label>
      <select id=&quot;c_via&quot;>
        <option value=&quot;Slackで本ドキュメントを共有&quot; selected>Slackで本ドキュメントを共有</option>
        <option value=&quot;対面で読み合わせ&quot;>対面で読み合わせ</option>
        <option value=&quot;メールで送付&quot;>メールで送付</option>
        <option value=&quot;Notionページで共有&quot;>Notionページで共有</option>
      </select>
    </div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>① 受けた指示（事実ベース）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>📝 ポイント：</span>指示元が言ったことを、自分の解釈を加えずに記録する。曖昧な部分はそのまま「〇〇とのご指示」と書く。</div>
  <textarea id=&quot;c_instruction&quot; placeholder=&quot;例：&amp;#10;- 新人向けLPIC-2研修資料Vol.3〜5の演習問題を見直すように指示いただきました&amp;#10;- 現状の演習が難しすぎるとの受講生フィードバックがあったとのこと&amp;#10;- 期限は来週金曜（5/29）まで&quot;></textarea>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>② 私の理解（4階層構造）</div>

  <div style=&quot;margin-bottom:10px&quot;><label>🅐 定義：このタスクは一言でいうと何か</label>
    <input type=&quot;text&quot; id=&quot;c_def&quot; placeholder=&quot;例：受講生のつまずきポイントに合わせた演習問題の難易度調整作業&quot;>
  </div>

  <div style=&quot;margin-bottom:10px&quot;><label>🅑 比喩：たとえるならば</label>
    <input type=&quot;text&quot; id=&quot;c_metaphor&quot; placeholder=&quot;例：ラーメン店で『辛さ控えめ』の声に応えてメニュー全体の辛さ表記を見直すような作業&quot;>
  </div>

  <div style=&quot;margin-bottom:10px&quot;><label>🅒 詳細整理：具体的に何をするか</label>
    <textarea id=&quot;c_detail&quot; placeholder=&quot;例：&amp;#10;1. Vol.3〜5の演習問題を全件リストアップ&amp;#10;2. 受講生フィードバックから難所を特定&amp;#10;3. ヒント追加 or 段階分解で難易度を調整&amp;#10;4. リーダーにレビュー依頼&quot;></textarea>
  </div>

  <div><label>🅓 一行まとめ</label>
    <input type=&quot;text&quot; id=&quot;c_summary&quot; placeholder=&quot;例：受講生フィードバックを起点に、Vol.3〜5の演習を段階的に解けるよう再設計する&quot;>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>③ 期待されるアウトプット（成果物の認識）</div>
  <div class=&quot;row cols2&quot;>
    <div><label>成果物の形式</label><input type=&quot;text&quot; id=&quot;c_output_form&quot; placeholder=&quot;例：修正版PowerPoint 3ファイル＋差分まとめNotionページ&quot;></div>
    <div><label>提出先 / 提出方法</label><input type=&quot;text&quot; id=&quot;c_submit&quot; placeholder=&quot;例：Google Drive共有フォルダ＋Slack通知&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>完了条件（DoD）</label><input type=&quot;text&quot; id=&quot;c_dod&quot; placeholder=&quot;例：リーダーのレビュー承認＋ステージング受講生での試行確認&quot;></div>
    <div><label>納期の認識</label><input type=&quot;text&quot; id=&quot;c_dueact&quot; placeholder=&quot;例：5/29（金）17時まで&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>④ 不明点・確認したい点</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>❓ ここが最重要：</span>「分かったつもり」で進めて後で手戻りするのを防ぐ。少しでも曖昧な点は遠慮なく挙げる。</div>
  <textarea id=&quot;c_unclear&quot; placeholder=&quot;例：&amp;#10;- Q1：『難しすぎる』の対象範囲は全演習か、特定の単元のみか？&amp;#10;- Q2：難易度調整の方向性は『ヒント追加』『問題分解』『削除』のどれを優先しますか？&amp;#10;- Q3：受講生フィードバックの一次資料はどこで確認できますか？&quot;></textarea>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>⑤ 私の進め方案（叩き台）</div>
  <textarea id=&quot;c_plan&quot; placeholder=&quot;例：&amp;#10;Day 1：演習リスト化＋フィードバック分析&amp;#10;Day 2-3：修正案作成&amp;#10;Day 4：リーダーに中間レビュー依頼&amp;#10;Day 5：最終調整・提出&quot;></textarea>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>⑥ 想定リスク・前提条件</div>
  <textarea id=&quot;c_risk&quot; placeholder=&quot;例：&amp;#10;- 前提：受講生フィードバックは集計済みである&amp;#10;- リスク：他業務（別研修対応）と重なるため、優先度判断を要相談&quot;></textarea>
</div>

<button class=&quot;btn-gen&quot; id=&quot;c_gen-btn&quot;>✅ 認識確認書のマークダウンを生成する</button>

<div class=&quot;card&quot; id=&quot;c_output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（認識・理解確認）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;c_copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;c_dl-btn&quot; data-out=&quot;c_output&quot; data-prefix=&quot;認識確認&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;c_output&quot;></div>
</div>

</div><!-- /panel-confirm -->

<!-- =========================================== -->
<!-- ============ TAB 4: メモ→MD ============== -->
<!-- =========================================== -->
<div class=&quot;panel&quot; id=&quot;panel-memo&quot;>

<div class=&quot;card card-tight&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ISO文書管理情報</div>
  <div class=&quot;row cols4&quot;>
    <div><label>文書番号</label><input type=&quot;text&quot; id=&quot;m_docno&quot; placeholder=&quot;例：MEMO-2026-0001&quot;></div>
    <div><label>版数</label><input type=&quot;text&quot; id=&quot;m_rev&quot; placeholder=&quot;例：Rev.1.0&quot; value=&quot;Rev.1.0&quot;></div>
    <div><label>機密区分</label>
      <select id=&quot;m_conf&quot;>
        <option value=&quot;公開&quot;>公開</option>
        <option value=&quot;社内限&quot; selected>社内限</option>
        <option value=&quot;社外秘&quot;>社外秘</option>
      </select>
    </div>
    <div><label>関連文書</label><input type=&quot;text&quot; id=&quot;m_relate&quot; placeholder=&quot;例：受講生カルテDB&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>メモタイプ</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>📝 使い方：</span>研修中・会議中の殴り書きメモを下に貼り付けるだけ。タイプに応じて自動でマークダウン構造化＆Notion対応形式に変換します。</div>
  <div class=&quot;pattern-grid&quot; id=&quot;memotype-group&quot;>
    <div class=&quot;pattern-card&quot; data-mtype=&quot;general&quot;>
      <div class=&quot;pc-key&quot;>TYPE 1</div>
      <div class=&quot;pc-title&quot;>📝 一般メモ</div>
      <div class=&quot;pc-desc&quot;>汎用。タイムスタンプ＋構造化のみ。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-mtype=&quot;observe&quot;>
      <div class=&quot;pc-key&quot;>TYPE 2</div>
      <div class=&quot;pc-title&quot;>👀 受講生観察メモ</div>
      <div class=&quot;pc-desc&quot;>受講生カルテDB向け。事実と所感を分けて記録。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-mtype=&quot;awareness&quot;>
      <div class=&quot;pc-key&quot;>TYPE 3</div>
      <div class=&quot;pc-title&quot;>🧀 気づきログ</div>
      <div class=&quot;pc-desc&quot;>スイスチーズモデル準拠。Blameless / ヒヤリハット記録。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-mtype=&quot;learn&quot;>
      <div class=&quot;pc-key&quot;>TYPE 4</div>
      <div class=&quot;pc-title&quot;>📚 学習メモ</div>
      <div class=&quot;pc-desc&quot;>自分の学び記録。定義→比喩→詳細→まとめの4階層。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-mtype=&quot;meeting&quot;>
      <div class=&quot;pc-key&quot;>TYPE 5</div>
      <div class=&quot;pc-title&quot;>🗣 会議メモ</div>
      <div class=&quot;pc-desc&quot;>参加者・決定事項・宿題・次回確認事項を抽出。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-mtype=&quot;idea&quot;>
      <div class=&quot;pc-key&quot;>TYPE 6</div>
      <div class=&quot;pc-title&quot;>💡 アイデアメモ</div>
      <div class=&quot;pc-desc&quot;>思いつきの種をMD化。タグ集計・関連メモ欄付き。</div>
    </div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>記録者</label><input type=&quot;text&quot; id=&quot;m_author&quot; placeholder=&quot;例：山田花子&quot;></div>
    <div><label>件名</label><input type=&quot;text&quot; id=&quot;m_title&quot; placeholder=&quot;例：5/20 研修 Day3 観察&quot;></div>
    <div><label>記録日</label><input type=&quot;date&quot; id=&quot;m_date&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>場所・コンテキスト</label><input type=&quot;text&quot; id=&quot;m_context&quot; placeholder=&quot;例：研修センター / Linuxコマンド演習中&quot;></div>
    <div><label>関連受講生・参加者</label><input type=&quot;text&quot; id=&quot;m_people&quot; placeholder=&quot;例：田中, 佐藤, 鈴木（カンマ区切り）&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📋 生メモ（殴り書きOK）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>✏️ 入力テクニック：</span>下の整形オプションで認識される特殊記法があります。<br>
  <code>事実：</code> <code>所感：</code> で行頭にラベル / <code>#タグ</code> でタグ付け / <code>→</code> でアクション項目 / <code>[]</code> <code>TODO:</code> でチェックボックス化 / <code>?</code> 末尾で質問抽出</div>
  <textarea id=&quot;m_raw&quot; placeholder=&quot;例（受講生観察メモ）：&amp;#10;14:30 田中さん、ifconfig が出てこなくて固まる&amp;#10;事実：ipコマンドを教えていない / 過去資料にもifconfig主流の表記あり&amp;#10;所感：基礎コマンドの世代差を埋める短い解説を入れた方がよさそう&amp;#10;→ 明日の冒頭で5分使って ip vs ifconfig 補足する #補講ネタ #linux&amp;#10;佐藤さん、grepの -E オプションで詰まる?&amp;#10;[] grep正規表現の演習問題を1問追加&quot; style=&quot;min-height:180px;font-family:var(--font-mono);font-size:12.5px&quot;></textarea>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🔧 自動整形オプション</div>
  <div class=&quot;opt-grid&quot;>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; id=&quot;opt_timestamp&quot; checked><span>行頭の時刻表記（14:30 など）を見出しに昇格</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; id=&quot;opt_factimp&quot; checked><span>「事実：」「所感：」を自動分類してセクション化</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; id=&quot;opt_action&quot; checked><span>「→」「→」を含む行をアクション項目として抽出</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; id=&quot;opt_todo&quot; checked><span>「[]」「TODO:」「やる:」をチェックボックスに統一</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; id=&quot;opt_tag&quot; checked><span>「#タグ」を自動抽出してタグ一覧に集計</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; id=&quot;opt_question&quot; checked><span>「?」で終わる行を質問・確認事項に抽出</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; id=&quot;opt_people&quot; checked><span>記録した参加者名を本文中で太字に強調</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; id=&quot;opt_smart&quot;><span>箇条書きスマート整形（連続する行を統合・空白行で段落区切り）</span></label>
  </div>
</div>

<button class=&quot;btn-gen&quot; id=&quot;m_gen-btn&quot;>📝 メモをマークダウンに変換する</button>

<div class=&quot;card&quot; id=&quot;m_output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（メモ）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;m_copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;m_dl-btn&quot; data-out=&quot;m_output&quot; data-prefix=&quot;メモ&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;m_output&quot;></div>
</div>

</div><!-- /panel-memo -->

<!-- =========================================== -->
<!-- ============ TAB 5: レビュー =============== -->
<!-- =========================================== -->
<div class=&quot;panel&quot; id=&quot;panel-review&quot;>

<div class=&quot;card card-tight&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ISO文書管理情報</div>
  <div class=&quot;row cols4&quot;>
    <div><label>文書番号</label><input type=&quot;text&quot; id=&quot;r_docno&quot; placeholder=&quot;例：REV-2026-0001&quot;></div>
    <div><label>版数</label><input type=&quot;text&quot; id=&quot;r_rev&quot; placeholder=&quot;例：Rev.1.0&quot; value=&quot;Rev.1.0&quot;></div>
    <div><label>機密区分</label>
      <select id=&quot;r_conf&quot;>
        <option value=&quot;公開&quot;>公開</option>
        <option value=&quot;社内限&quot; selected>社内限</option>
        <option value=&quot;社外秘&quot;>社外秘</option>
      </select>
    </div>
    <div><label>関連文書</label><input type=&quot;text&quot; id=&quot;r_relate&quot; placeholder=&quot;例：PR#123 / 研修資料Vol.3&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>レビューモード選択</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🔍 使い分け：</span>提出前のセルフチェック → 受けた指摘への返信 → 自分が指摘するとき、の3場面で使い分けます。指摘する側テンプレは「先に良い点を承認」がデフォルト構成です。</div>
  <div class=&quot;pattern-grid&quot; id=&quot;reviewmode-group&quot;>
    <div class=&quot;pattern-card&quot; data-rmode=&quot;self&quot;>
      <div class=&quot;pc-key&quot;>MODE 1</div>
      <div class=&quot;pc-title&quot;>🎯 セルフレビュー前ToDo</div>
      <div class=&quot;pc-desc&quot;>提出前に自分でチェックする観点別リスト。<br>新人の「とりあえず提出」を防ぐ。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-rmode=&quot;response&quot;>
      <div class=&quot;pc-key&quot;>MODE 2</div>
      <div class=&quot;pc-title&quot;>💬 一次レビュー指摘対応</div>
      <div class=&quot;pc-desc&quot;>指摘を受けた側のテンプレ。<br>指摘ごとに「理解→方針→対応」を構造化。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-rmode=&quot;reviewer&quot;>
      <div class=&quot;pc-key&quot;>MODE 3</div>
      <div class=&quot;pc-title&quot;>📝 レビュー指摘（する側）</div>
      <div class=&quot;pc-desc&quot;>レビュアー側のテンプレ。<br>Must/Should/Nice/Question/Good で構造化。</div>
    </div>
  </div>
</div>

<!-- ===== MODE 1: セルフレビュー前ToDo ===== -->
<div class=&quot;rmode-block&quot; data-rmode-target=&quot;self&quot;>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🎯 セルフレビュー基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>提出者（自分）</label><input type=&quot;text&quot; id=&quot;r_self_author&quot; placeholder=&quot;例：山田太郎&quot;></div>
    <div><label>レビュー対象</label><input type=&quot;text&quot; id=&quot;r_self_target&quot; placeholder=&quot;例：ユーザー登録API実装（PR#123）&quot;></div>
    <div><label>提出予定日</label><input type=&quot;date&quot; id=&quot;r_self_date&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>提出先レビュアー</label><input type=&quot;text&quot; id=&quot;r_self_reviewer&quot; placeholder=&quot;例：リーダー&quot;></div>
    <div><label>レビューカテゴリ</label>
      <select id=&quot;r_self_category&quot;>
        <option value=&quot;code&quot;>💻 コード</option>
        <option value=&quot;doc&quot;>📄 ドキュメント</option>
        <option value=&quot;design&quot;>🏗 設計・構成</option>
        <option value=&quot;training&quot;>🎓 研修資料</option>
        <option value=&quot;custom&quot;>⚙️ カスタム（自由項目）</option>
      </select>
    </div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📋 セルフチェック項目</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 カテゴリを選んで「項目を読み込む」を押すと、観点別テンプレが入力されます。</span>カスタム追加・削除も自由です。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;r_self_load&quot;>📥 カテゴリのテンプレを読み込む</button>
    <button class=&quot;btn-mini&quot; id=&quot;r_self_addcheck&quot;>＋ 項目を追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;r_self_clear&quot;>🗑 すべてクリア</button>
  </div>
  <div id=&quot;r_self_checks&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>💬 提出時の伝達事項</div>
  <div class=&quot;row&quot;>
    <div><label>レビュアーに先に伝えたいこと（既知の懸念・限界・前提）</label><textarea id=&quot;r_self_message&quot; placeholder=&quot;例：&amp;#10;- ユニットテストはハッピーパスのみ実装、異常系は次PRで対応予定&amp;#10;- パフォーマンスチューニング前の状態です&amp;#10;- 設計について判断に迷った箇所が2点あり（後述）&quot;></textarea></div>
  </div>
  <div><label>特に重点的に見てほしい点</label><textarea id=&quot;r_self_focus&quot; placeholder=&quot;例：&amp;#10;- エラーハンドリングの粒度&amp;#10;- DBトランザクション境界の妥当性&quot; style=&quot;min-height:50px&quot;></textarea></div>
</div>

</div><!-- /MODE 1 -->

<!-- ===== MODE 2: 一次レビュー指摘対応 ===== -->
<div class=&quot;rmode-block&quot; data-rmode-target=&quot;response&quot; style=&quot;display:none&quot;>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>💬 指摘対応 基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>対応者（自分）</label><input type=&quot;text&quot; id=&quot;r_resp_author&quot; placeholder=&quot;例：山田太郎&quot;></div>
    <div><label>レビュアー</label><input type=&quot;text&quot; id=&quot;r_resp_reviewer&quot; placeholder=&quot;例：リーダー&quot;></div>
    <div><label>指摘を受けた日</label><input type=&quot;date&quot; id=&quot;r_resp_date&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>レビュー対象</label><input type=&quot;text&quot; id=&quot;r_resp_target&quot; placeholder=&quot;例：ユーザー登録API（PR#123）&quot;></div>
    <div><label>レビュー回</label>
      <select id=&quot;r_resp_round&quot;>
        <option value=&quot;1次&quot; selected>1次レビュー</option>
        <option value=&quot;2次&quot;>2次レビュー</option>
        <option value=&quot;3次&quot;>3次レビュー</option>
        <option value=&quot;最終&quot;>最終レビュー</option>
      </select>
    </div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📝 指摘事項と対応（指摘ごとに記入）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 必須3点：</span>① <strong>指摘の意図を自分の言葉で書き直す</strong>（認識合わせ）　② <strong>対応方針を明示</strong>（修正/相談/見送り）　③ <strong>変更した具体的な箇所</strong>を示す。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;r_resp_add&quot;>＋ 指摘事項を追加</button>
  </div>
  <div id=&quot;r_resp_items&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🎯 全体所感・学び</div>
  <textarea id=&quot;r_resp_learnings&quot; placeholder=&quot;例：&amp;#10;- 今回のレビューを通して、エラーハンドリングの設計観点が抜けていることに気づきました&amp;#10;- 次回からは『正常系の前に異常系を設計する』を意識します&quot;></textarea>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🙏 再レビュー依頼</div>
  <textarea id=&quot;r_resp_request&quot; placeholder=&quot;例：&amp;#10;対応完了しましたので、再度ご確認をお願いいたします。&amp;#10;特に指摘No.2の修正方針について、認識相違がないか合わせて見ていただけますと幸いです。&quot; style=&quot;min-height:60px&quot;></textarea>
</div>

</div><!-- /MODE 2 -->

<!-- ===== MODE 3: レビュー指摘（する側） ===== -->
<div class=&quot;rmode-block&quot; data-rmode-target=&quot;reviewer&quot; style=&quot;display:none&quot;>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📝 指摘者（レビュアー）基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>レビュアー（自分）</label><input type=&quot;text&quot; id=&quot;r_rev_author&quot; placeholder=&quot;例：佐藤太郎&quot;></div>
    <div><label>被レビュー者</label><input type=&quot;text&quot; id=&quot;r_rev_target_person&quot; placeholder=&quot;例：田中花子（新人）&quot;></div>
    <div><label>レビュー日</label><input type=&quot;date&quot; id=&quot;r_rev_date&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>レビュー対象</label><input type=&quot;text&quot; id=&quot;r_rev_target&quot; placeholder=&quot;例：研修課題3 / ユーザー一覧画面の実装&quot;></div>
    <div><label>レビュー観点（コンテキスト）</label>
      <select id=&quot;r_rev_context&quot;>
        <option value=&quot;新人研修&quot;>新人研修課題</option>
        <option value=&quot;OJTコードレビュー&quot;>OJTコードレビュー</option>
        <option value=&quot;本番リリース前&quot;>本番リリース前</option>
        <option value=&quot;研修資料相互レビュー&quot;>研修資料相互レビュー</option>
        <option value=&quot;その他&quot;>その他</option>
      </select>
    </div>
  </div>
</div>

<div class=&quot;card&quot; style=&quot;border-color:var(--brand-green);background:linear-gradient(180deg,rgba(168,213,186,.25),transparent)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot; style=&quot;background:var(--brand-green-deep)&quot;></span>👍 まず：良かった点（必ず先に書く）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 うさうさ式レビュー鉄則：</span>指摘の前に必ず承認を1つ以上。新人・受講生はここを読んで安心してから指摘を受け止められます。「具体的に」「事実ベースで」褒めるのがコツ。</div>
  <textarea id=&quot;r_rev_good&quot; placeholder=&quot;例：&amp;#10;- 関数命名が意図を表していて読みやすい（特に validateUserInput）&amp;#10;- エッジケースの考慮（空文字列・null）が初学者で漏れがちな箇所まで網羅されている&amp;#10;- コミット粒度が機能単位で揃っていて履歴が追いやすい&quot; style=&quot;min-height:80px&quot;></textarea>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📋 指摘事項（種別ごとに分類）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>📐 種別の使い分け：</span>
  <code>🔴 Must</code>本番影響あり、必ず直す / <code>🟡 Should</code>できれば直す / <code>🟢 Nice</code>あれば嬉しい / <code>💬 Question</code>意図を確認したい / <code>👍 Good</code>個別の褒めポイント</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;r_rev_add_must&quot; style=&quot;border-color:#F0997B;color:#712B13&quot;>＋ 🔴 Must</button>
    <button class=&quot;btn-mini&quot; id=&quot;r_rev_add_should&quot; style=&quot;border-color:#EF9F27;color:#633806&quot;>＋ 🟡 Should</button>
    <button class=&quot;btn-mini&quot; id=&quot;r_rev_add_nice&quot; style=&quot;border-color:#97C459;color:#27500A&quot;>＋ 🟢 Nice</button>
    <button class=&quot;btn-mini&quot; id=&quot;r_rev_add_q&quot; style=&quot;border-color:#85B7EB;color:#0C447C&quot;>＋ 💬 Question</button>
    <button class=&quot;btn-mini&quot; id=&quot;r_rev_add_good&quot; style=&quot;border-color:#AFA9EC;color:#3C3489&quot;>＋ 👍 Good</button>
  </div>
  <div id=&quot;r_rev_items&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🌱 期待する学び・成長ポイント</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>教育的レビューの肝：</span>「なぜこの指摘をするのか」を伝えると学習効果が大きく上がります。</div>
  <textarea id=&quot;r_rev_growth&quot; placeholder=&quot;例：&amp;#10;- 今回の指摘の多くは『他の人が読む前提』で書くと自然と気づける観点です&amp;#10;- 次回は提出前にコードを5分置いてから読み返してみてください&quot;></textarea>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📆 次のアクション</div>
  <div class=&quot;row cols2&quot;>
    <div><label>対応期限の目安</label><input type=&quot;text&quot; id=&quot;r_rev_deadline&quot; placeholder=&quot;例：今週金曜まで / 急ぎではないが来週前半まで&quot;></div>
    <div><label>再レビュー方法</label>
      <select id=&quot;r_rev_renext&quot;>
        <option value=&quot;同じPRで対応後コメント&quot;>同じPRで対応後コメント</option>
        <option value=&quot;新規PR作成&quot;>新規PR作成</option>
        <option value=&quot;対面で読み合わせ&quot;>対面で読み合わせ</option>
        <option value=&quot;Slackスレッドで議論継続&quot;>Slackスレッドで議論継続</option>
      </select>
    </div>
  </div>
  <div><label>励まし・メッセージ</label><textarea id=&quot;r_rev_encourage&quot; placeholder=&quot;例：&amp;#10;指摘多めですが、これは伸びしろが大きいということです。&amp;#10;ひとつずつ潰していけば必ず力になります。質問あればいつでも。&quot; style=&quot;min-height:50px&quot;></textarea></div>
</div>

</div><!-- /MODE 3 -->

<button class=&quot;btn-gen&quot; id=&quot;r_gen-btn&quot;>🔍 レビュー文書のマークダウンを生成する</button>

<div class=&quot;card&quot; id=&quot;r_output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（レビュー）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;r_copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;r_dl-btn&quot; data-out=&quot;r_output&quot; data-prefix=&quot;レビュー&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;r_output&quot;></div>
</div>

</div><!-- /panel-review -->

<!-- =========================================== -->
<!-- ============ TAB 6: Web制作 ================ -->
<!-- =========================================== -->
<div class=&quot;panel&quot; id=&quot;panel-web&quot;>

<div class=&quot;card card-tight&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ISO文書管理情報</div>
  <div class=&quot;row cols4&quot;>
    <div><label>文書番号</label><input type=&quot;text&quot; id=&quot;w_docno&quot; placeholder=&quot;例：WEB-2026-0001&quot;></div>
    <div><label>版数</label><input type=&quot;text&quot; id=&quot;w_rev&quot; placeholder=&quot;例：Rev.1.0&quot; value=&quot;Rev.1.0&quot;></div>
    <div><label>機密区分</label>
      <select id=&quot;w_conf&quot;>
        <option value=&quot;公開&quot;>公開</option>
        <option value=&quot;社内限&quot; selected>社内限</option>
        <option value=&quot;社外秘&quot;>社外秘</option>
      </select>
    </div>
    <div><label>関連文書</label><input type=&quot;text&quot; id=&quot;w_relate&quot; placeholder=&quot;例：研修課題 PG-WEB-03&quot;></div>
  </div>
</div>

<!-- ===== 視点切替（受講生 / 講師） ===== -->
<div class=&quot;audience-bar&quot; style=&quot;background:linear-gradient(90deg,rgba(245,230,168,.25),rgba(168,213,186,.25));border-color:var(--brand-green)&quot;>
  <span class=&quot;lbl&quot;>📐 視点</span>
  <div class=&quot;audience-options&quot; id=&quot;w_perspective-group&quot;>
    <span class=&quot;aud&quot; data-pers=&quot;student&quot;>🌱 受講生視点（自分が作る側）</span>
    <span class=&quot;aud&quot; data-pers=&quot;teacher&quot;>🏫 講師視点（指示書・評価観点）</span>
  </div>
</div>

<!-- ===== プロジェクト基本情報（全フェーズ共通） ===== -->
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🎨 プロジェクト基本情報（全フェーズ共通）</div>
  <div class=&quot;row cols3&quot;>
    <div><label>プロジェクト名</label><input type=&quot;text&quot; id=&quot;w_project&quot; placeholder=&quot;例：地域カフェ紹介サイト『まちカフェめぐり』&quot;></div>
    <div><label>受講生名 / 制作者</label><input type=&quot;text&quot; id=&quot;w_student&quot; placeholder=&quot;例：田中花子&quot;></div>
    <div><label>担当講師 / レビュアー</label><input type=&quot;text&quot; id=&quot;w_teacher&quot; placeholder=&quot;例：山田花子&quot;></div>
  </div>
  <div class=&quot;row cols3&quot;>
    <div><label>制作開始日</label><input type=&quot;date&quot; id=&quot;w_startdate&quot;></div>
    <div><label>提出期限</label><input type=&quot;date&quot; id=&quot;w_duedate&quot;></div>
    <div><label>研修コース・課題番号</label><input type=&quot;text&quot; id=&quot;w_course&quot; placeholder=&quot;例：Webコース 課題3&quot;></div>
  </div>
</div>

<!-- ===== フェーズ選択 ===== -->
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🛤 フェーズ選択（順番に取り組んでください）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 Web制作の標準フロー：</span>要求定義 → 要件定義 → UIデモ → 実装 → テスト → 提出前チェック → README → 提出一式。各フェーズで生成 or 最後に「提出一式」で全部まとめて生成。</div>
  <div class=&quot;phase-grid&quot; id=&quot;phase-group&quot;>
    <div class=&quot;phase-card&quot; data-phase=&quot;req&quot;><div class=&quot;ph-num&quot;>①</div><div class=&quot;ph-icon&quot;>📋</div><div class=&quot;ph-name&quot;>要求定義</div></div>
    <div class=&quot;phase-card&quot; data-phase=&quot;spec&quot;><div class=&quot;ph-num&quot;>②</div><div class=&quot;ph-icon&quot;>📐</div><div class=&quot;ph-name&quot;>要件定義</div></div>
    <div class=&quot;phase-card&quot; data-phase=&quot;ui&quot;><div class=&quot;ph-num&quot;>③</div><div class=&quot;ph-icon&quot;>🎨</div><div class=&quot;ph-name&quot;>UIデモ</div></div>
    <div class=&quot;phase-card&quot; data-phase=&quot;impl&quot;><div class=&quot;ph-num&quot;>④</div><div class=&quot;ph-icon&quot;>🛠</div><div class=&quot;ph-name&quot;>実装</div></div>
    <div class=&quot;phase-card&quot; data-phase=&quot;test&quot;><div class=&quot;ph-num&quot;>⑤</div><div class=&quot;ph-icon&quot;>🧪</div><div class=&quot;ph-name&quot;>テスト</div></div>
    <div class=&quot;phase-card&quot; data-phase=&quot;precheck&quot;><div class=&quot;ph-num&quot;>⑥</div><div class=&quot;ph-icon&quot;>✅</div><div class=&quot;ph-name&quot;>提出前チェック</div></div>
    <div class=&quot;phase-card&quot; data-phase=&quot;readme&quot;><div class=&quot;ph-num&quot;>⑦</div><div class=&quot;ph-icon&quot;>📖</div><div class=&quot;ph-name&quot;>README</div></div>
    <div class=&quot;phase-card phase-final&quot; data-phase=&quot;all&quot;><div class=&quot;ph-num&quot;>📦</div><div class=&quot;ph-icon&quot;>🎁</div><div class=&quot;ph-name&quot;>提出一式</div></div>
  </div>
</div>

<!-- ===== Phase 1: 要求定義 ===== -->
<div class=&quot;phase-block&quot; data-phase-target=&quot;req&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📋 ① 要求定義（誰が・何のために・何を求めているか）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 要求とは：</span>「誰の・どんな困りごと・どう解決したい」を言葉にすること。まだ&quot;作るもの&quot;ではなく&quot;求めているもの&quot;を書きます。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>誰のためのサイトか（ターゲットユーザー・ペルソナ）</label><textarea id=&quot;w_req_user&quot; placeholder=&quot;例：&amp;#10;- 主：30代女性、カフェ巡りが趣味&amp;#10;- 副：地元のカフェオーナー&amp;#10;- 想定利用シーン：休日の朝、スマホで近くのカフェを探したいとき&quot;></textarea></div>
    <div><label>解決したい課題（現状の困りごと）</label><textarea id=&quot;w_req_problem&quot; placeholder=&quot;例：&amp;#10;- 地元の小さなカフェ情報が散らばっていて探しにくい&amp;#10;- 公式SNSはあっても写真・営業時間がバラバラ&amp;#10;- 観光客には地元のお気に入りが伝わらない&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>期待する効果・成功イメージ</label><textarea id=&quot;w_req_goal&quot; placeholder=&quot;例：&amp;#10;- 月10人が新しいカフェに足を運ぶきっかけになる&amp;#10;- カフェ側に『〇〇サイト見て来ました』の声が届く&quot;></textarea></div>
    <div><label>制約条件（期限・予算・技術）</label><textarea id=&quot;w_req_constraint&quot; placeholder=&quot;例：&amp;#10;- 期限：3週間&amp;#10;- 技術：HTML/CSS/JavaScript（バニラ）&amp;#10;- 予算：無料ホスティング（GitHub Pages等）&quot;></textarea></div>
  </div>
  <div><label>ステークホルダー（関係者）</label><input type=&quot;text&quot; id=&quot;w_req_stake&quot; placeholder=&quot;例：受講生（制作）、担当講師（レビュー）、想定ユーザー、カフェオーナー（取材協力）&quot;></div>
</div>
</div>

<!-- ===== Phase 2: 要件定義 ===== -->
<div class=&quot;phase-block&quot; data-phase-target=&quot;spec&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📐 ② 要件定義（何を作るか）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 要件とは：</span>要求を満たすために&quot;具体的に何を作るか&quot;を定義。機能要件と非機能要件の両方を書きます。</div>
  <div><label>機能要件（実装する機能のリスト）</label><textarea id=&quot;w_spec_func&quot; placeholder=&quot;例：&amp;#10;- F-01：トップページ（カフェ一覧表示）&amp;#10;- F-02：カフェ詳細ページ（写真・営業時間・地図リンク）&amp;#10;- F-03：エリア絞り込み機能&amp;#10;- F-04：お気に入り保存（localStorage）&amp;#10;- F-05：レスポンシブ対応（スマホ/PC）&quot; style=&quot;min-height:80px&quot;></textarea></div>
  <div class=&quot;row cols2&quot;>
    <div><label>非機能要件（性能・セキュリティ・互換性）</label><textarea id=&quot;w_spec_nonfunc&quot; placeholder=&quot;例：&amp;#10;- 初期表示2秒以内&amp;#10;- 対象ブラウザ：Chrome/Safari/Edge 最新2バージョン&amp;#10;- スマホ幅 360px 〜 PC幅 1280px 対応&amp;#10;- 個人情報は扱わない（取得・保存しない）&quot;></textarea></div>
    <div><label>アクセシビリティ要件</label><textarea id=&quot;w_spec_a11y&quot; placeholder=&quot;例：&amp;#10;- 文字色のコントラスト比4.5:1以上&amp;#10;- 全画像にalt属性&amp;#10;- キーボード操作のみで全機能使用可能&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>画面一覧（ページ構成）</label><textarea id=&quot;w_spec_pages&quot; placeholder=&quot;例：&amp;#10;- トップページ（/index.html）&amp;#10;- カフェ詳細（/cafe/[id].html × 5件）&amp;#10;- お気に入り一覧（/favorites.html）&amp;#10;- このサイトについて（/about.html）&quot;></textarea></div>
    <div><label>データ要件（扱うデータ・形式）</label><textarea id=&quot;w_spec_data&quot; placeholder=&quot;例：&amp;#10;- カフェデータ：JSON形式（cafes.json）&amp;#10;- 項目：id, name, area, hours, image, description, mapUrl&amp;#10;- お気に入り：localStorage（id配列）&quot;></textarea></div>
  </div>
</div>
</div>

<!-- ===== Phase 3: UIデモ ===== -->
<div class=&quot;phase-block&quot; data-phase-target=&quot;ui&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🎨 ③ UIデモ・デザイン仕様</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 UIデモのコツ：</span>言葉だけでなく『色名・余白・フォントサイズ』を具体的に。完成後の見た目をレビュアーが頭の中で再現できるレベルで書きましょう。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>サイトの世界観・テーマ</label><textarea id=&quot;w_ui_theme&quot; placeholder=&quot;例：&amp;#10;『晴れた朝の庭』をイメージ。&amp;#10;やわらかなパステルグリーン＋淡いイエロー、オフホワイト基調で優しい印象。&amp;#10;余白を多く取り、丸みのあるフォントで親しみやすく。&quot;></textarea></div>
    <div><label>カラーパレット（HEXコード）</label><textarea id=&quot;w_ui_color&quot; placeholder=&quot;例：&amp;#10;- メイン：#A8D5BA（パステルグリーン）&amp;#10;- アクセント：#F5E6A8（パステルイエロー）&amp;#10;- 背景：#FBFAF3（オフホワイト）&amp;#10;- テキスト：#3A7355（深緑）&amp;#10;- ボーダー：#EDE9D8&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>フォント指定</label><textarea id=&quot;w_ui_font&quot; placeholder=&quot;例：&amp;#10;- 見出し：Noto Serif JP（明朝、weight 700）&amp;#10;- 本文：Noto Sans JP（ゴシック、weight 400）&amp;#10;- アクセント：Caveat（手書き風、英字のみ）&quot;></textarea></div>
    <div><label>レスポンシブ設計（ブレークポイント）</label><textarea id=&quot;w_ui_responsive&quot; placeholder=&quot;例：&amp;#10;- スマホ：〜767px（1カラム）&amp;#10;- タブレット：768〜1023px（2カラム）&amp;#10;- PC：1024px〜（3カラム）&amp;#10;- カフェカード：スマホ縦並び/PCグリッド&quot;></textarea></div>
  </div>
  <div><label>主要画面のワイヤーフレーム説明（言葉で描写）</label><textarea id=&quot;w_ui_wireframe&quot; placeholder=&quot;例：&amp;#10;【トップページ】&amp;#10;- ヘッダー：左にロゴ、右にナビ（Home / カフェ一覧 / お気に入り / About）&amp;#10;- ヒーロー：横長写真＋『まちカフェめぐり』タイトル＋サブコピー&amp;#10;- カフェ一覧：3列グリッド（PC）／カード形式（写真＋店名＋エリア＋営業時間）&amp;#10;- フッター：制作者情報、SNSリンク&amp;#10;&amp;#10;【カフェ詳細】&amp;#10;- 上部：大きな写真&amp;#10;- 中央：店名（h1）、エリア、営業時間&amp;#10;- 下部：紹介文、地図リンクボタン、戻るボタン&quot; style=&quot;min-height:100px&quot;></textarea></div>
  <div><label>インタラクション・アニメーション</label><textarea id=&quot;w_ui_interact&quot; placeholder=&quot;例：&amp;#10;- カフェカード：ホバーで影＋微浮き上がり（transform: translateY(-2px)）&amp;#10;- お気に入りボタン：クリックでハートが赤に切替（CSS transition 0.2s）&amp;#10;- ページ遷移：fade-in 0.3s&quot; style=&quot;min-height:60px&quot;></textarea></div>
</div>
</div>

<!-- ===== Phase 4: 実装 ===== -->
<div class=&quot;phase-block&quot; data-phase-target=&quot;impl&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🛠 ④ 実装記録</div>
  <div class=&quot;row cols2&quot;>
    <div><label>技術スタック</label><textarea id=&quot;w_impl_stack&quot; placeholder=&quot;例：&amp;#10;- HTML5&amp;#10;- CSS3（Flexbox / Grid / CSS Variables）&amp;#10;- JavaScript（ES6+ / バニラ）&amp;#10;- データ：JSON&amp;#10;- ホスティング：GitHub Pages&amp;#10;- 開発ツール：VS Code, Live Server&quot;></textarea></div>
    <div><label>ディレクトリ構成</label><textarea id=&quot;w_impl_struct&quot; placeholder=&quot;例：&amp;#10;machicafe/&amp;#10;├── index.html&amp;#10;├── about.html&amp;#10;├── favorites.html&amp;#10;├── css/&amp;#10;│   └── style.css&amp;#10;├── js/&amp;#10;│   ├── main.js&amp;#10;│   └── favorites.js&amp;#10;├── data/&amp;#10;│   └── cafes.json&amp;#10;└── images/&quot; style=&quot;font-family:var(--font-mono);font-size:11.5px&quot;></textarea></div>
  </div>
  <div><label>主要な実装ポイント（関数・コンポーネント）</label><textarea id=&quot;w_impl_main&quot; placeholder=&quot;例：&amp;#10;- renderCafeList()：cafes.jsonを読み込んでカード生成&amp;#10;- toggleFavorite(id)：localStorageと連携&amp;#10;- filterByArea(area)：絞り込み機能&amp;#10;- レスポンシブ：CSS Gridで auto-fit + minmax で自動列数調整&quot; style=&quot;min-height:80px&quot;></textarea></div>
  <div class=&quot;row cols2&quot;>
    <div><label>💡 工夫した点</label><textarea id=&quot;w_impl_proud&quot; placeholder=&quot;例：&amp;#10;- CSS変数でカラーパレットを一元管理し、ダークモード切替に拡張しやすくした&amp;#10;- お気に入り機能をlocalStorageで実装、ユーザーがログイン不要に&amp;#10;- 画像は遅延読み込み（loading=&amp;quot;lazy&amp;quot;）でパフォーマンス改善&quot;></textarea></div>
    <div><label>🤔 詰まった点と解決方法</label><textarea id=&quot;w_impl_stuck&quot; placeholder=&quot;例：&amp;#10;- fetchでJSON読込時にCORS エラー → Live Serverで開発し解決&amp;#10;- レスポンシブで画像比率が崩れる → object-fit: cover で解決&amp;#10;- localStorage の値が文字列で扱いに迷った → JSON.stringify/parseで配列保存&quot;></textarea></div>
  </div>
</div>
</div>

<!-- ===== Phase 5: テスト ===== -->
<div class=&quot;phase-block&quot; data-phase-target=&quot;test&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🧪 ⑤ テスト</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 テスト3観点：</span>① 機能が動く（機能テスト）　② 見た目が正しい（UI/UXテスト）　③ 環境を超えて動く（互換性テスト）</div>
  <div><label>機能テスト結果（要件定義のF-XXに対応）</label><textarea id=&quot;w_test_func&quot; placeholder=&quot;例：&amp;#10;| 要件ID | テスト内容 | 結果 |&amp;#10;|--------|----------|------|&amp;#10;| F-01 | トップでカフェ一覧が表示される | ✅ OK |&amp;#10;| F-02 | カフェクリックで詳細ページに遷移 | ✅ OK |&amp;#10;| F-03 | エリア絞り込みで該当カフェのみ表示 | ✅ OK |&amp;#10;| F-04 | お気に入り追加→ページ更新後も保持 | ✅ OK |&amp;#10;| F-05 | スマホ幅で1カラム / PC幅で3カラム | ✅ OK |&quot; style=&quot;font-family:var(--font-mono);font-size:11.5px;min-height:120px&quot;></textarea></div>
  <div class=&quot;row cols2&quot;>
    <div><label>ブラウザ互換性テスト</label><textarea id=&quot;w_test_browser&quot; placeholder=&quot;例：&amp;#10;- ✅ Chrome 124（Mac/Win）&amp;#10;- ✅ Safari 17（Mac/iPhone）&amp;#10;- ✅ Edge 124（Win）&amp;#10;- ⚠️ Firefox：CSS Grid のgap表示が若干異なる（軽微）&quot;></textarea></div>
    <div><label>レスポンシブ確認</label><textarea id=&quot;w_test_responsive&quot; placeholder=&quot;例：&amp;#10;- ✅ iPhone SE（375px）&amp;#10;- ✅ iPhone 14（390px）&amp;#10;- ✅ iPad（768px）&amp;#10;- ✅ ノートPC（1280px）&amp;#10;- ✅ 大型モニター（1920px）&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>アクセシビリティ確認</label><textarea id=&quot;w_test_a11y&quot; placeholder=&quot;例：&amp;#10;- ✅ 全画像にalt属性&amp;#10;- ✅ コントラスト比 4.5:1 以上（Chrome DevTools確認）&amp;#10;- ✅ Tab移動で全リンク到達&amp;#10;- ⚠️ スクリーンリーダー（VoiceOver）：見出し階層に1箇所スキップあり&quot;></textarea></div>
    <div><label>パフォーマンステスト</label><textarea id=&quot;w_test_perf&quot; placeholder=&quot;例：&amp;#10;- Lighthouse Performance：92点&amp;#10;- 初期表示：1.4秒（目標2秒以内 ✅）&amp;#10;- 画像最適化：WebP変換でサイズ60%削減&quot;></textarea></div>
  </div>
</div>
</div>

<!-- ===== Phase 6: 提出前チェック ===== -->
<div class=&quot;phase-block&quot; data-phase-target=&quot;precheck&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>✅ ⑥ 提出前チェック</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 提出前の5分で手戻り3時間を防ぐ：</span>下のチェック項目を順番に確認しましょう。テンプレ読込ボタンで標準項目を一括投入できます。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;w_pre_load&quot;>📥 Web制作標準チェックを読み込む</button>
    <button class=&quot;btn-mini&quot; id=&quot;w_pre_add&quot;>＋ 項目を追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;w_pre_clear&quot;>🗑 クリア</button>
  </div>
  <div id=&quot;w_pre_checks&quot;></div>
  <div style=&quot;margin-top:14px&quot;><label>既知の課題・限界（先に伝えておきたいこと）</label><textarea id=&quot;w_pre_known&quot; placeholder=&quot;例：&amp;#10;- お気に入り機能はブラウザ単位での保存（端末を変えると共有されません）&amp;#10;- 検索機能は実装余力がなく次回課題とします&amp;#10;- カフェデータは現状5件、本来は10件目標でした&quot; style=&quot;min-height:60px&quot;></textarea></div>
</div>
</div>

<!-- ===== Phase 7: README ===== -->
<div class=&quot;phase-block&quot; data-phase-target=&quot;readme&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📖 ⑦ README（リポジトリトップに置く）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 READMEの読み手：</span>『初見の人』を想定。プロジェクトを5分で理解できる構成にします。</div>
  <div><label>キャッチコピー・一言説明（リポジトリ説明欄にも使える）</label><input type=&quot;text&quot; id=&quot;w_readme_tagline&quot; placeholder=&quot;例：地元のカフェを巡る楽しさを共有するレスポンシブサイト&quot;></div>
  <div><label>スクリーンショット・デモURL</label><textarea id=&quot;w_readme_demo&quot; placeholder=&quot;例：&amp;#10;- デモ：https://taro-tanaka.github.io/machicafe/&amp;#10;- スクリーンショット：./images/screenshot.png&quot; style=&quot;min-height:50px&quot;></textarea></div>
  <div class=&quot;row cols2&quot;>
    <div><label>セットアップ手順</label><textarea id=&quot;w_readme_setup&quot; placeholder=&quot;例：&amp;#10;1. このリポジトリをクローン&amp;#10;   ```&amp;#10;   git clone https://github.com/xxx/machicafe.git&amp;#10;   ```&amp;#10;2. VS Code で開く&amp;#10;3. Live Server拡張機能で index.html を起動&amp;#10;4. http://127.0.0.1:5500/ にアクセス&quot; style=&quot;font-family:var(--font-mono);font-size:11.5px;min-height:100px&quot;></textarea></div>
    <div><label>使い方（主要機能の操作手順）</label><textarea id=&quot;w_readme_usage&quot; placeholder=&quot;例：&amp;#10;- トップページでカフェ一覧を閲覧&amp;#10;- カードをクリックで詳細ページへ&amp;#10;- ハートアイコンでお気に入り保存（再訪問時も保持）&amp;#10;- エリアタブで絞り込み&quot; style=&quot;min-height:100px&quot;></textarea></div>
  </div>
  <div><label>制作者からのひとこと（学んだこと・想い）</label><textarea id=&quot;w_readme_note&quot; placeholder=&quot;例：&amp;#10;Webサイト制作を通して、ユーザー視点で『欲しい情報がすぐ見つかる』設計の難しさを実感しました。&amp;#10;特にレスポンシブデザインは想定よりも考慮すべき画面サイズが多く、CSS Gridの便利さを体感しました。&quot; style=&quot;min-height:60px&quot;></textarea></div>
  <div><label>ライセンス</label>
    <select id=&quot;w_readme_license&quot;>
      <option value=&quot;MIT&quot; selected>MIT License</option>
      <option value=&quot;研修課題のため非公開&quot;>研修課題のため非公開</option>
      <option value=&quot;社内利用のみ&quot;>社内利用のみ</option>
      <option value=&quot;Apache 2.0&quot;>Apache License 2.0</option>
      <option value=&quot;CC BY 4.0&quot;>Creative Commons BY 4.0</option>
    </select>
  </div>
</div>
</div>

<!-- ===== Phase 8: 提出一式 ===== -->
<div class=&quot;phase-block&quot; data-phase-target=&quot;all&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot; style=&quot;background:linear-gradient(180deg,rgba(245,230,168,.28),transparent);border-color:var(--brand-yellow-deep)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📦 ⑧ 提出一式（全フェーズ統合ドキュメント生成）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 提出一式とは：</span>①〜⑦の全フェーズの入力内容を、目次付きの1つの大きなマークダウンとして出力します。Notion・GitHub Wiki・PDF化どこにでも貼れる形式です。<br><strong>事前に①〜⑦の各フェーズで入力を済ませてから生成してください。</strong></div>
  <div><label>提出者からの総括コメント（任意）</label><textarea id=&quot;w_all_overall&quot; placeholder=&quot;例：&amp;#10;3週間の制作を通して、要求→要件→実装の流れを一通り体験できました。&amp;#10;特に要件定義段階で『何を作らないか』を決めることの大切さを学びました。&amp;#10;次回課題ではテスト計画を制作開始時から立てるよう改善します。&quot;></textarea></div>
  <div class=&quot;row cols3&quot;>
    <div><label>提出ファイル一覧</label><textarea id=&quot;w_all_files&quot; placeholder=&quot;例：&amp;#10;- 本書（提出一式.md）&amp;#10;- ソースコード（GitHubリポジトリ）&amp;#10;- デモURL&amp;#10;- スクリーンショット 5枚&quot; style=&quot;min-height:80px&quot;></textarea></div>
    <div><label>所要時間（実績）</label><input type=&quot;text&quot; id=&quot;w_all_hours&quot; placeholder=&quot;例：32時間（要件定義8h / 実装16h / テスト4h / 文書4h）&quot;></div>
    <div><label>自己評価（5段階）</label>
      <select id=&quot;w_all_selfeval&quot;>
        <option value=&quot;&quot;>選択してください</option>
        <option value=&quot;⭐⭐⭐⭐⭐ 期待を超えた&quot;>⭐⭐⭐⭐⭐ 期待を超えた</option>
        <option value=&quot;⭐⭐⭐⭐ 期待通り達成&quot;>⭐⭐⭐⭐ 期待通り達成</option>
        <option value=&quot;⭐⭐⭐ おおむね達成&quot;>⭐⭐⭐ おおむね達成</option>
        <option value=&quot;⭐⭐ 一部未達&quot; selected>⭐⭐ 一部未達</option>
        <option value=&quot;⭐ 未達多数&quot;>⭐ 未達多数</option>
      </select>
    </div>
  </div>
</div>
</div>

<button class=&quot;btn-gen&quot; id=&quot;w_gen-btn&quot;>🎨 Web制作マークダウンを生成する</button>

<div class=&quot;card&quot; id=&quot;w_output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（Web制作）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;w_copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;w_dl-btn&quot; data-out=&quot;w_output&quot; data-prefix=&quot;Web制作&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;w_output&quot;></div>
</div>

</div><!-- /panel-web -->

<!-- =========================================== -->
<!-- ============ TAB 7: お仕事受領 ============= -->
<!-- =========================================== -->
<div class=&quot;panel&quot; id=&quot;panel-intake&quot;>

<div class=&quot;card card-tight&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ISO文書管理情報</div>
  <div class=&quot;row cols4&quot;>
    <div><label>文書番号</label><input type=&quot;text&quot; id=&quot;i_docno&quot; placeholder=&quot;例：JOB-2026-0001&quot;></div>
    <div><label>版数</label><input type=&quot;text&quot; id=&quot;i_rev&quot; placeholder=&quot;例：Rev.1.0&quot; value=&quot;Rev.1.0&quot;></div>
    <div><label>機密区分</label>
      <select id=&quot;i_conf&quot;>
        <option value=&quot;公開&quot;>公開</option>
        <option value=&quot;社内限&quot;>社内限</option>
        <option value=&quot;社外秘&quot; selected>社外秘</option>
        <option value=&quot;極秘&quot;>極秘</option>
      </select>
    </div>
    <div><label>関連文書</label><input type=&quot;text&quot; id=&quot;i_relate&quot; placeholder=&quot;例：見積書 EST-2026-005&quot;></div>
  </div>
</div>

<!-- ===== 視点切替（受注側 / 発注側） ===== -->
<div class=&quot;audience-bar&quot; style=&quot;background:linear-gradient(90deg,rgba(168,213,186,.25),rgba(245,230,168,.25));border-color:var(--brand-green)&quot;>
  <span class=&quot;lbl&quot;>📐 視点</span>
  <div class=&quot;audience-options&quot; id=&quot;i_perspective-group&quot;>
    <span class=&quot;aud&quot; data-ipers=&quot;receiver&quot;>📥 受注側（自分が受ける）</span>
    <span class=&quot;aud&quot; data-ipers=&quot;client&quot;>🤝 発注側（クライアント整理）</span>
  </div>
</div>

<!-- ===== 案件基本情報（全モード共通） ===== -->
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>💼 案件基本情報（全モード共通）</div>
  <div class=&quot;row cols3&quot;>
    <div><label>案件名</label><input type=&quot;text&quot; id=&quot;i_job&quot; placeholder=&quot;例：Linux応用研修 追加実施&quot;></div>
    <div><label>発注元（クライアント・依頼者）</label><input type=&quot;text&quot; id=&quot;i_client&quot; placeholder=&quot;例：クライアント担当 〇〇様&quot;></div>
    <div><label>受注担当（自分）</label><input type=&quot;text&quot; id=&quot;i_self&quot; placeholder=&quot;例：山田花子&quot;></div>
  </div>
  <div class=&quot;row cols3&quot;>
    <div><label>社内上長 / 相談先</label><input type=&quot;text&quot; id=&quot;i_boss&quot; placeholder=&quot;例：佐藤太郎 主任&quot;></div>
    <div><label>受領日</label><input type=&quot;date&quot; id=&quot;i_recvdate&quot;></div>
    <div><label>最終締切（デッドライン）</label><input type=&quot;date&quot; id=&quot;i_deadline&quot;></div>
  </div>
</div>

<!-- ===== モード選択 ===== -->
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>モード選択</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 受領フロー：</span>受領メモ（一次記録）→ 詰めMTGアジェンダ（曖昧をゼロに）→ 合意事項記録（着手前の最終確認）→ 受領一式（全部統合）。</div>
  <div class=&quot;pattern-grid&quot; id=&quot;intakemode-group&quot;>
    <div class=&quot;pattern-card&quot; data-imode=&quot;memo&quot;>
      <div class=&quot;pc-key&quot;>MODE 1</div>
      <div class=&quot;pc-title&quot;>📥 受領メモ</div>
      <div class=&quot;pc-desc&quot;>受領直後の一次記録。聞いたことを5W2Hで残す。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-imode=&quot;agenda&quot;>
      <div class=&quot;pc-key&quot;>MODE 2</div>
      <div class=&quot;pc-title&quot;>🎯 詰めMTGアジェンダ</div>
      <div class=&quot;pc-desc&quot;>曖昧をゼロにする確認事項リスト。詰め詰めの核。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-imode=&quot;agree&quot;>
      <div class=&quot;pc-key&quot;>MODE 3</div>
      <div class=&quot;pc-title&quot;>🤝 合意事項記録</div>
      <div class=&quot;pc-desc&quot;>着手前の最終合意。スコープ・成果物・利益を確定。</div>
    </div>
    <div class=&quot;pattern-card phase-final&quot; data-imode=&quot;all&quot;>
      <div class=&quot;pc-key&quot;>MODE 4</div>
      <div class=&quot;pc-title&quot;>📦 受領一式</div>
      <div class=&quot;pc-desc&quot;>1〜3を統合した正式な案件受領書。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-imode=&quot;ticket&quot;>
      <div class=&quot;pc-key&quot;>MODE 5</div>
      <div class=&quot;pc-title&quot;>🎫 Jira風タスク分解</div>
      <div class=&quot;pc-desc&quot;>必要条件→Why/What/How→チケット階層に分解。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-imode=&quot;value&quot;>
      <div class=&quot;pc-key&quot;>MODE 6</div>
      <div class=&quot;pc-title&quot;>💎 仕事の言語化</div>
      <div class=&quot;pc-desc&quot;>誰を幸せに・どんな変化を。情報不足は確認質問を生成。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-imode=&quot;empathy&quot;>
      <div class=&quot;pc-key&quot;>MODE 7</div>
      <div class=&quot;pc-title&quot;>🔍 相手理解（教育コンサル）</div>
      <div class=&quot;pc-desc&quot;>何が欲しいか・価値観・プロセス・期待成果を深掘り。</div>
    </div>
  </div>
</div>

<!-- ===== 共通：依頼の認識理解（4モードで常に表示） ===== -->
<div class=&quot;card&quot; style=&quot;border-color:var(--brand-green-deep);background:linear-gradient(180deg,rgba(168,213,186,.22),transparent)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot; style=&quot;background:var(--brand-green-deep)&quot;></span>🎯 依頼の認識・理解（最重要・全モード共通）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 詰め詰めの核心：</span>ここがズレると全部ズレます。「目的・ゴール・最終利益・締切」を発注元と握ること。推測で埋めず、不明なら『要確認』と書く勇気を。</div>

  <div class=&quot;row cols2&quot;>
    <div><label>🅰 何のために（目的・背景）</label><textarea id=&quot;i_why&quot; placeholder=&quot;例：&amp;#10;- 新人エンジニアのLinux実務スキル底上げのため&amp;#10;- 前回研修で『応用範囲が足りない』とのフィードバックがあったため&quot;></textarea></div>
    <div><label>🅱 どこまで（ゴール・到達点）</label><textarea id=&quot;i_goal&quot; placeholder=&quot;例：&amp;#10;- 受講生がLPIC-2レベルのコマンド操作を独力で実施できる&amp;#10;- 実機演習を通して障害切り分けができる状態&quot;></textarea></div>
  </div>

  <div class=&quot;row cols2&quot;>
    <div><label>💰 最終利益（クライアントが得る価値・ビジネスゴール）</label><textarea id=&quot;i_profit&quot; placeholder=&quot;例：&amp;#10;- クライアント側：新人の早期戦力化、外部研修コスト削減&amp;#10;- 自社側：継続契約・追加案件の獲得、実績蓄積&amp;#10;- 受講生：実務で使えるスキルと自信&quot;></textarea></div>
    <div><label>🎯 誰向けに（対象者・受益者）</label><textarea id=&quot;i_for&quot; placeholder=&quot;例：&amp;#10;- 新卒エンジニア12名（非IT学部出身含む）&amp;#10;- スキルレベル：LPIC-1相当を学習済み&quot;></textarea></div>
  </div>

  <div><label>📝 私の理解（一行まとめ）— 依頼を自分の言葉で言い直す</label><input type=&quot;text&quot; id=&quot;i_summary&quot; placeholder=&quot;例：LPIC-1修了済みの新人12名を、3日間でLPIC-2応用レベルの実務スキルまで引き上げる研修を設計・実施する案件&quot;></div>
</div>

<!-- ===== MODE 1: 受領メモ ===== -->
<div class=&quot;imode-block&quot; data-imode-target=&quot;memo&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📥 受領メモ（5W2Hで一次記録）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 受領直後にすぐ書く：</span>記憶が鮮明なうちに。曖昧な点は『要確認』マークを付けてMODE 2に持ち込みます。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>いつ受けたか / どのように（経緯）</label><textarea id=&quot;i_memo_how&quot; placeholder=&quot;例：&amp;#10;- 5/20 14時のMTGで口頭依頼&amp;#10;- その後メールで概要受領&amp;#10;- 前回研修担当の縁で指名&quot;></textarea></div>
    <div><label>何を頼まれたか（依頼内容ざっくり）</label><textarea id=&quot;i_memo_what&quot; placeholder=&quot;例：&amp;#10;- Linux応用研修（3日間想定）&amp;#10;- 資料作成＋当日講師&amp;#10;- 修了テスト込み&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>提示された予算・条件（あれば）</label><textarea id=&quot;i_memo_budget&quot; placeholder=&quot;例：&amp;#10;- 予算：前回同等（要確認）&amp;#10;- 場所：研修センター&amp;#10;- 人数：12名前後&quot;></textarea></div>
    <div><label>⚠️ この時点で曖昧・要確認な点</label><textarea id=&quot;i_memo_unclear&quot; placeholder=&quot;例：&amp;#10;- 正確な日程が未定（候補は6月上旬）&amp;#10;- 演習用サーバー環境は誰が用意するか&amp;#10;- 修了テストの合格基準の有無&amp;#10;- 予算の正式金額&quot;></textarea></div>
  </div>
  <div><label>第一印象・直感的な所感（推測として）</label><textarea id=&quot;i_memo_impression&quot; placeholder=&quot;例：&amp;#10;- 前回ベースなら工数感は読める&amp;#10;- ただし『応用』の範囲定義次第で大きく変わりそう&amp;#10;- 環境準備の責任分界点が曖昧でリスクと感じる&quot; style=&quot;min-height:50px&quot;></textarea></div>
</div>
</div>

<!-- ===== MODE 2: 詰めMTGアジェンダ ===== -->
<div class=&quot;imode-block&quot; data-imode-target=&quot;agenda&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🎯 詰めMTGアジェンダ（曖昧をゼロにする）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 詰め詰めの本番：</span>確認事項を「決定/選択肢/質問」に分類。各項目に『なぜ確認するか（確認しないと何が困るか）』を添えると相手も答えやすい。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;i_agenda_load&quot;>📥 標準確認項目を読み込む</button>
    <button class=&quot;btn-mini&quot; id=&quot;i_agenda_add&quot;>＋ 確認事項を追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;i_agenda_clear&quot;>🗑 クリア</button>
  </div>
  <div id=&quot;i_agenda_items&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📅 MTG情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>MTG日時</label><input type=&quot;text&quot; id=&quot;i_agenda_when&quot; placeholder=&quot;例：5/23（金）15:00-16:00&quot;></div>
    <div><label>出席者</label><input type=&quot;text&quot; id=&quot;i_agenda_who&quot; placeholder=&quot;例：先方〇〇様、自分、リーダー&quot;></div>
    <div><label>形式</label>
      <select id=&quot;i_agenda_format&quot;>
        <option value=&quot;オンライン（Zoom）&quot; selected>オンライン（Zoom）</option>
        <option value=&quot;対面&quot;>対面</option>
        <option value=&quot;電話&quot;>電話</option>
        <option value=&quot;メール往復&quot;>メール往復</option>
      </select>
    </div>
  </div>
  <div><label>このMTGのゴール（終了時に何が決まっていればOKか）</label><input type=&quot;text&quot; id=&quot;i_agenda_goal&quot; placeholder=&quot;例：日程確定・スコープ合意・環境準備の責任分界点を明確化&quot;></div>
</div>
</div>

<!-- ===== MODE 3: 合意事項記録 ===== -->
<div class=&quot;imode-block&quot; data-imode-target=&quot;agree&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🤝 合意事項記録（着手前の最終確認）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 これが契約の土台：</span>詰めMTGで決まったことを確定文書化。後で『言った言わない』を防ぎ、自分も上長も安心して着手できます。</div>
  <div><label>✅ スコープ（やること）</label><textarea id=&quot;i_agree_scope&quot; placeholder=&quot;例：&amp;#10;- LPIC-2応用研修の資料作成（PowerPoint一式）&amp;#10;- 3日間の講師実施&amp;#10;- 修了テストの作成・採点&amp;#10;- 実施後の講師所見レポート提出&quot;></textarea></div>
  <div><label>🚫 スコープ外（やらないこと）— 明示が重要</label><textarea id=&quot;i_agree_outscope&quot; placeholder=&quot;例：&amp;#10;- 演習用サーバー環境の構築（先方インフラ部門が担当）&amp;#10;- 受講生の事前学習サポート&amp;#10;- 研修後の個別フォローアップ（別途見積）&quot; style=&quot;min-height:50px&quot;></textarea></div>
  <div class=&quot;row cols2&quot;>
    <div><label>📦 成果物（納品物）と納期</label><textarea id=&quot;i_agree_deliver&quot; placeholder=&quot;例：&amp;#10;- 研修資料：研修開始1週間前&amp;#10;- 修了テスト：研修初日&amp;#10;- 講師所見レポート：研修終了後3営業日以内&quot;></textarea></div>
    <div><label>💰 金額・支払条件 / 最終利益の確定</label><textarea id=&quot;i_agree_money&quot; placeholder=&quot;例：&amp;#10;- 金額：〇〇円（税別）&amp;#10;- 支払：月末締め翌月末払い&amp;#10;- 自社利益見込み：粗利〇〇%&amp;#10;- 継続案件の可能性：高（四半期ごと想定）&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>👥 体制・役割分担</label><textarea id=&quot;i_agree_team&quot; placeholder=&quot;例：&amp;#10;- メイン講師：リーダー&amp;#10;- サブ講師：自分&amp;#10;- 環境準備：先方側&amp;#10;- 窓口：先方〇〇様 / 自社〇〇&quot;></textarea></div>
    <div><label>📆 スケジュール・マイルストーン</label><textarea id=&quot;i_agree_schedule&quot; placeholder=&quot;例：&amp;#10;- 6/1 資料初稿&amp;#10;- 6/5 先方レビュー&amp;#10;- 6/8 資料確定&amp;#10;- 6/10-12 研修実施&amp;#10;- 6/17 レポート提出&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>📌 前提条件（これが崩れたら再協議）</label><textarea id=&quot;i_agree_premise&quot; placeholder=&quot;例：&amp;#10;- 受講生はLPIC-1相当を学習済み&amp;#10;- 演習環境は研修3日前までに先方が準備完了&amp;#10;- 受講人数は最大15名まで&quot;></textarea></div>
    <div><label>⚠️ リスク・懸念事項と対策</label><textarea id=&quot;i_agree_risk&quot; placeholder=&quot;例：&amp;#10;- リスク：環境準備遅延 → 対策：3日前チェックポイント設定&amp;#10;- リスク：受講者スキルばらつき → 対策：事前アンケート実施&amp;#10;- リスク：他案件と繁忙期重複 → 対策：資料は5月中に着手&quot;></textarea></div>
  </div>
</div>
</div>

<!-- ===== MODE 4: 受領一式 ===== -->
<div class=&quot;imode-block&quot; data-imode-target=&quot;all&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot; style=&quot;background:linear-gradient(180deg,rgba(245,230,168,.28),transparent);border-color:var(--brand-yellow-deep)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📦 受領一式（MODE 1〜3を統合した正式受領書）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 統合出力：</span>受領メモ・詰めMTGアジェンダ・合意事項を1つの正式文書に統合します。<strong>各モードで先に入力を済ませてから生成してください。</strong></div>
  <div><label>📋 案件総括・自分の決意表明（任意）</label><textarea id=&quot;i_all_overall&quot; placeholder=&quot;例：&amp;#10;前回研修の信頼を土台にした重要案件。&amp;#10;『応用』のスコープを明確に握ったうえで、受講生が実務で使えるレベルまで引き上げることにコミットする。&amp;#10;環境準備の責任分界点を最初に確定させ、当日トラブルをゼロにする。&quot;></textarea></div>
  <div class=&quot;row cols2&quot;>
    <div><label>承認状態</label>
      <select id=&quot;i_all_approval&quot;>
        <option value=&quot;☐ 上長確認待ち&quot; selected>☐ 上長確認待ち</option>
        <option value=&quot;☐ 上長確認済み・先方合意待ち&quot;>☐ 上長確認済み・先方合意待ち</option>
        <option value=&quot;✅ 双方合意済み・着手可&quot;>✅ 双方合意済み・着手可</option>
      </select>
    </div>
    <div><label>次のアクション</label><input type=&quot;text&quot; id=&quot;i_all_next&quot; placeholder=&quot;例：リーダーに本書を共有しレビュー依頼&quot;></div>
  </div>
</div>
</div>

<!-- ===== MODE 5: Jira風タスク分解 ===== -->
<div class=&quot;imode-block&quot; data-imode-target=&quot;ticket&quot; style=&quot;display:none&quot;>

<div class=&quot;card&quot; style=&quot;border-color:var(--brand-green-deep);background:linear-gradient(180deg,rgba(168,213,186,.20),transparent)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot; style=&quot;background:var(--brand-green-deep)&quot;></span>🎫 必要条件の明確化（着手の前提）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 まず必要条件をゼロ曖昧に：</span>「これが揃っていないと着手できない」という前提条件を先に洗い出します。完了条件（DoD）と受け入れ基準も明示。</div>
  <div><label>✅ 必要条件（前提・インプット・揃えるべきもの）</label><textarea id=&quot;i_tk_require&quot; placeholder=&quot;例：&amp;#10;- 要件定義書の確定版が共有されていること&amp;#10;- ステージング環境のアクセス権が付与されていること&amp;#10;- レビュー担当者がアサインされていること&quot;></textarea></div>
  <div class=&quot;row cols2&quot;>
    <div><label>🎯 完了条件（DoD：何をもって完了か）</label><textarea id=&quot;i_tk_dod&quot; placeholder=&quot;例：&amp;#10;- 全機能がステージングで動作確認済み&amp;#10;- レビュー承認を得た&amp;#10;- ドキュメント更新済み&quot; style=&quot;min-height:50px&quot;></textarea></div>
    <div><label>📋 受け入れ基準（依頼者が満足する条件）</label><textarea id=&quot;i_tk_accept&quot; placeholder=&quot;例：&amp;#10;- レスポンス2秒以内&amp;#10;- 主要3ブラウザで動作&amp;#10;- 既存機能に影響なし&quot; style=&quot;min-height:50px&quot;></textarea></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🧭 目的・ゴール（Why / What / How）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 3つの問い：</span><strong>Why</strong>＝なぜやるのか（目的・背景）／<strong>What</strong>＝何を作る・達成するのか（成果）／<strong>How</strong>＝どうやるのか（方針・手段）。この順で詰めると手段が目的化しません。</div>
  <div><label>❓ Why（なぜやるのか・目的・背景）</label><textarea id=&quot;i_tk_why&quot; placeholder=&quot;例：&amp;#10;- 手作業のレポート集計に毎月20時間かかっており、自動化で工数削減したい&amp;#10;- ヒューマンエラーによる数値ミスを撲滅したい&quot;></textarea></div>
  <div><label>📦 What（何を作る・達成するのか・成果物）</label><textarea id=&quot;i_tk_what&quot; placeholder=&quot;例：&amp;#10;- 月次レポートを自動生成するバッチ処理&amp;#10;- 集計結果のダッシュボード画面&amp;#10;- エラー時の通知機能&quot;></textarea></div>
  <div><label>🛠 How（どうやるのか・方針・技術・手段）</label><textarea id=&quot;i_tk_how&quot; placeholder=&quot;例：&amp;#10;- Python + pandas で集計ロジックを実装&amp;#10;- 既存DBから日次でデータ取得&amp;#10;- 結果はスプレッドシートとSlackに出力&amp;#10;- 段階リリース（まず集計のみ→通知追加）&quot;></textarea></div>
  <div><label>🎯 ゴール（達成された状態を一文で）</label><input type=&quot;text&quot; id=&quot;i_tk_goal&quot; placeholder=&quot;例：月次レポートが毎月1日に自動生成され、担当者の作業がゼロになっている状態&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🎫 チケット基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>プロジェクトキー</label><input type=&quot;text&quot; id=&quot;i_tk_projkey&quot; placeholder=&quot;例：MFKB&quot; value=&quot;PROJ&quot;></div>
    <div><label>エピック名（大きなまとまり）</label><input type=&quot;text&quot; id=&quot;i_tk_epic&quot; placeholder=&quot;例：月次レポート自動化&quot;></div>
    <div><label>担当（アサイン先）</label><input type=&quot;text&quot; id=&quot;i_tk_assignee&quot; placeholder=&quot;例：山田花子&quot;></div>
  </div>
  <div class=&quot;row cols3&quot;>
    <div><label>報告者</label><input type=&quot;text&quot; id=&quot;i_tk_reporter&quot; placeholder=&quot;例：佐藤太郎&quot;></div>
    <div><label>スプリント</label><input type=&quot;text&quot; id=&quot;i_tk_sprint&quot; placeholder=&quot;例：Sprint 12&quot;></div>
    <div><label>期限</label><input type=&quot;date&quot; id=&quot;i_tk_due&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📝 ストーリー / サブタスク分解</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 分解のコツ：</span>「主語＋動詞」で行動単位に。各チケットにストーリーポイント（規模感：1,2,3,5,8,13）とステータスを設定。Notion DBにもJiraにも貼れる形で出力します。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;i_tk_addstory&quot;>＋ ストーリーを追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;i_tk_addsub&quot;>＋ サブタスクを追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;i_tk_loadsample&quot;>📥 サンプル分解</button>
    <button class=&quot;btn-mini&quot; id=&quot;i_tk_clear&quot;>🗑 クリア</button>
  </div>
  <div id=&quot;i_tk_tickets&quot;></div>
</div>

</div><!-- /MODE 5 -->

<!-- ===== MODE 6: 仕事の言語化 ===== -->
<div class=&quot;imode-block&quot; data-imode-target=&quot;value&quot; style=&quot;display:none&quot;>

<div class=&quot;card&quot; style=&quot;border-color:var(--brand-green-deep);background:linear-gradient(180deg,rgba(168,213,186,.20),transparent)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot; style=&quot;background:var(--brand-green-deep)&quot;></span>💎 この仕事の「価値」を言語化する</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 プロの言語化コンサルの視点：</span>依頼を「作業」ではなく「誰のどんな変化を生むか」で捉え直します。タスクに入る前に、この仕事の意味を1枚で言葉にしておくと、判断のブレも手戻りも激減します。</div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>👥 誰を幸せにするのか（受益者）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>📌 三層で考える：</span>直接の受益者（エンドユーザー）／依頼者（発注元）／その先にいる人（社会・周囲）。それぞれの「嬉しい」を言葉にします。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>① 直接の受益者（一番幸せになる人）</label><textarea id=&quot;i_vl_who1&quot; placeholder=&quot;例：&amp;#10;- レポート作成に追われていた経理担当者&amp;#10;- 毎月の締め作業で残業していた人&quot;></textarea></div>
    <div><label>② 依頼者・発注元（その人の嬉しい）</label><textarea id=&quot;i_vl_who2&quot; placeholder=&quot;例：&amp;#10;- 部門のコスト削減を求められている管理職&amp;#10;- チームの生産性を上げたいリーダー&quot;></textarea></div>
  </div>
  <div><label>③ その先にいる人（波及する幸せ）</label><textarea id=&quot;i_vl_who3&quot; placeholder=&quot;例：&amp;#10;- 早く正確な数字が出ることで意思決定できる経営層&amp;#10;- 残業が減って家族との時間が増える担当者の周囲&quot; style=&quot;min-height:50px&quot;></textarea></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🔄 どんな変化をもたらすのか（Before → After）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 変化が価値：</span>「何を作るか」ではなく「世界がどう変わるか」。Before（今の困った状態）と After（理想の状態）を具体的に対比させます。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>😟 Before（今の状態・困りごと）</label><textarea id=&quot;i_vl_before&quot; placeholder=&quot;例：&amp;#10;- 毎月20時間を手作業の集計に費やしている&amp;#10;- 転記ミスで数字が間違うことがある&amp;#10;- 締め日前に残業が常態化&quot;></textarea></div>
    <div><label>😊 After（この仕事の後の理想状態）</label><textarea id=&quot;i_vl_after&quot; placeholder=&quot;例：&amp;#10;- ボタン1つで集計完了、作業時間ほぼゼロ&amp;#10;- 自動計算でミスがなくなる&amp;#10;- 締め作業の残業が消える&quot;></textarea></div>
  </div>
  <div><label>📏 変化を測る指標（定量・定性）</label><input type=&quot;text&quot; id=&quot;i_vl_metric&quot; placeholder=&quot;例：月間作業時間 20h→1h / 転記ミス 月3件→0件 / 担当者の心理的負担の軽減&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>✍️ 言語化サマリー（1〜2文で言い切る）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 エレベーターピッチ：</span>「この仕事は、〈誰〉が〈どんな状態〉になるために、〈何〉をして〈どんな変化〉を生むものだ」を一息で言える形に。</div>
  <div><label>💎 この仕事を一言でいうと</label><textarea id=&quot;i_vl_summary&quot; placeholder=&quot;例：&amp;#10;この仕事は、毎月の集計作業に追われる経理担当者が『数字を作る人』から『数字を活かす人』に変わるための、レポート自動化である。&quot; style=&quot;min-height:60px&quot;></textarea></div>
  <div><label>🌟 自分がこの仕事に込める想い・こだわり（任意）</label><textarea id=&quot;i_vl_will&quot; placeholder=&quot;例：&amp;#10;- ただ動くものではなく、担当者が『これなら自分でも触れる』と思える優しい設計にする&amp;#10;- 引き継ぎやすさを最優先にする&quot; style=&quot;min-height:50px&quot;></textarea></div>
</div>

<div class=&quot;card&quot; style=&quot;border-color:var(--brand-yellow-deep);background:linear-gradient(180deg,rgba(245,230,168,.25),transparent)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot; style=&quot;background:var(--brand-yellow-deep)&quot;></span>❓ 情報不足チェック → 確認しに行く質問を生成</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 プロは「分からないまま進めない」：</span>言語化していて「ここが曖昧だ」と感じた項目にチェックを入れると、依頼者に確認しに行くための質問文を自動生成します。空欄の必須項目も自動で検出します。</div>
  <div class=&quot;opt-grid&quot; style=&quot;margin-bottom:10px&quot;>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; class=&quot;i_vl_unclear&quot; data-q=&quot;この仕事で一番幸せにしたいのは、具体的にどなたですか？（役職・立場）&quot;><span>受益者が曖昧</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; class=&quot;i_vl_unclear&quot; data-q=&quot;現状（Before）の困りごとを、もう少し具体的に教えていただけますか？&quot;><span>現状(Before)が曖昧</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; class=&quot;i_vl_unclear&quot; data-q=&quot;この仕事が成功したと言える理想の状態（After）はどんなイメージですか？&quot;><span>理想(After)が曖昧</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; class=&quot;i_vl_unclear&quot; data-q=&quot;成果をどう測れば「うまくいった」と判断できますか？（指標）&quot;><span>成功指標が曖昧</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; class=&quot;i_vl_unclear&quot; data-q=&quot;優先順位として、何を最も大事にすべきでしょうか？（速さ/正確さ/使いやすさ等）&quot;><span>優先順位が曖昧</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; class=&quot;i_vl_unclear&quot; data-q=&quot;この仕事の背景・きっかけになった出来事があれば教えてください。&quot;><span>背景・経緯が曖昧</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; class=&quot;i_vl_unclear&quot; data-q=&quot;納期と、絶対に外せない条件（マスト要件）を確認させてください。&quot;><span>納期・制約が曖昧</span></label>
    <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; class=&quot;i_vl_unclear&quot; data-q=&quot;関係者（承認者・利用者・連携先）はどなたになりますか？&quot;><span>関係者が曖昧</span></label>
  </div>
  <div><label>➕ その他、自分で確認したいこと（1行1問）</label><textarea id=&quot;i_vl_customq&quot; placeholder=&quot;例：&amp;#10;既存のExcelマクロは流用してよいですか？&amp;#10;データの保管場所に制約はありますか？&quot; style=&quot;min-height:50px&quot;></textarea></div>
  <div style=&quot;margin-top:8px&quot;><label>📨 確認の送り先・手段</label><input type=&quot;text&quot; id=&quot;i_vl_askwho&quot; placeholder=&quot;例：依頼者の〇〇様へSlackで / 次回MTGで口頭確認&quot;></div>
</div>

</div><!-- /MODE 6 -->

<!-- ===== MODE 7: 相手理解（教育コンサル） ===== -->
<div class=&quot;imode-block&quot; data-imode-target=&quot;empathy&quot; style=&quot;display:none&quot;>

<div class=&quot;card&quot; style=&quot;border-color:var(--brand-green-deep);background:linear-gradient(180deg,rgba(168,213,186,.18),transparent)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot; style=&quot;background:var(--brand-green-deep)&quot;></span>🔍 相手理解の深掘り（教育コンサルの視点）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 プロの教育コンサルは「相手を理解してから提案する」：</span>言われた要望（顕在ニーズ）の奥にある本当の願い（潜在ニーズ）、大切にしている価値観、重視するプロセスまで掴んでこそ、刺さる提案ができます。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>相手（クライアント・依頼者）</label><input type=&quot;text&quot; id=&quot;i_em_who&quot; placeholder=&quot;例：人材開発部の〇〇様&quot;></div>
    <div><label>立場・役割・背景</label><input type=&quot;text&quot; id=&quot;i_em_role&quot; placeholder=&quot;例：研修企画責任者・現場上がりで実務重視&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>① 相手は何が欲しいか（顕在 → 潜在）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 言葉の奥を読む：</span>「研修してほしい」の奥には「離職を止めたい」「現場から頼られたい」があるかも。表面の要望と、その奥の本当の願いを分けます。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🗣 顕在ニーズ（言葉で言われた要望）</label><textarea id=&quot;i_em_explicit&quot; placeholder=&quot;例：&amp;#10;- 新人にLinux研修をしてほしい&amp;#10;- 3日間で実務レベルまで&quot;></textarea></div>
    <div><label>💭 潜在ニーズ（その奥にある本当の願い・推測）</label><textarea id=&quot;i_em_latent&quot; placeholder=&quot;例：&amp;#10;- 早期離職を防ぎたい&amp;#10;- 現場に『使える新人』と認められたい&amp;#10;- 自分の企画が成功したと言われたい&quot;></textarea></div>
  </div>
  <div><label>😟 相手が抱えている不安・困りごと</label><textarea id=&quot;i_em_pain&quot; placeholder=&quot;例：&amp;#10;- 前回研修で受講生が脱落した苦い経験&amp;#10;- 上層部に成果を示すプレッシャー&quot; style=&quot;min-height:45px&quot;></textarea></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>② 認識・理解のすり合わせ</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🤝 こちらの理解（相手の要望を自分の言葉で）</label><textarea id=&quot;i_em_understand&quot; placeholder=&quot;例：&amp;#10;単なる知識付与でなく『現場で自走できる新人』を育てたい、というのが本質的な要望と理解&quot;></textarea></div>
    <div><label>❓ ズレていそうな点・要確認</label><textarea id=&quot;i_em_gap&quot; placeholder=&quot;例：&amp;#10;- 『実務レベル』の定義が双方で違うかも&amp;#10;- 評価方法の期待値を確認したい&quot;></textarea></div>
  </div>
</div>

<div class=&quot;card&quot; style=&quot;border-color:var(--brand-yellow-deep);background:linear-gradient(180deg,rgba(245,230,168,.20),transparent)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot; style=&quot;background:var(--brand-yellow-deep)&quot;></span>③ 大切にしている価値観</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 価値観が刺さりどころ：</span>相手が何を美徳とし、何を嫌うか。ここに合わせると信頼が生まれ、外すと一気に冷めます。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>💚 大切にしていること・こだわり</label><textarea id=&quot;i_em_value&quot; placeholder=&quot;例：&amp;#10;- 受講生一人ひとりを大切にする姿勢&amp;#10;- 現場で本当に使えること（机上の空論を嫌う）&amp;#10;- 丁寧なコミュニケーション&quot;></textarea></div>
    <div><label>🚫 嫌うこと・避けたいこと（地雷）</label><textarea id=&quot;i_em_dislike&quot; placeholder=&quot;例：&amp;#10;- 上から目線の指導&amp;#10;- 数字だけの報告&amp;#10;- 受講生を置き去りにする進め方&quot;></textarea></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>④ 重視するプロセス（進め方）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 結果だけでなく過程：</span>「どう進めるか」にこだわる相手は多い。報告頻度・関与度・意思決定スタイルを掴みます。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>📋 望ましい進め方・関わり方</label><textarea id=&quot;i_em_process&quot; placeholder=&quot;例：&amp;#10;- 節目ごとに相談しながら進めたい&amp;#10;- 中間レビューを重視&amp;#10;- 現場の声を反映するプロセスを大事に&quot; style=&quot;min-height:50px&quot;></textarea></div>
    <div><label>📞 報告・コミュニケーションの好み</label><textarea id=&quot;i_em_comm&quot; placeholder=&quot;例：&amp;#10;- こまめな共有を好む&amp;#10;- 結論より経緯も知りたいタイプ&amp;#10;- 対面/Slackどちらが良いか&quot; style=&quot;min-height:50px&quot;></textarea></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>⑤ 持ってきてほしい成果（期待アウトプット）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 「成果」の認識を握る：</span>相手が「これが出てきたら満足」と思う具体的な成果物・状態を明確に。ここが曖昧だと評価がブレます。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>📦 期待される具体的な成果物・状態</label><textarea id=&quot;i_em_output&quot; placeholder=&quot;例：&amp;#10;- 受講生全員が修了テスト80点以上&amp;#10;- 現場配属後すぐ動ける状態&amp;#10;- 研修レポート（成長の可視化）&quot;></textarea></div>
    <div><label>⭐ これがあると「期待を超えた」と思う成果</label><textarea id=&quot;i_em_wow&quot; placeholder=&quot;例：&amp;#10;- 受講生から『楽しかった』の声&amp;#10;- 現場上司から『今年の新人は違う』の評価&amp;#10;- 継続依頼につながる手応え&quot;></textarea></div>
  </div>
  <div><label>📏 成果をどう測るか（相手の評価基準）</label><input type=&quot;text&quot; id=&quot;i_em_metric&quot; placeholder=&quot;例：修了テスト点数・受講生アンケート・配属先上司の評価&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>⑥ 提案の方向性（理解を踏まえて）</div>
  <div><label>💡 この理解から見えた提案の軸</label><textarea id=&quot;i_em_proposal&quot; placeholder=&quot;例：&amp;#10;- 『現場で自走できる』を前面に出した設計を提案&amp;#10;- 受講生一人ひとりの成長を可視化するレポートを付加価値に&amp;#10;- 節目ごとの相談プロセスを組み込む&quot; style=&quot;min-height:50px&quot;></textarea></div>
</div>

</div><!-- /MODE 7 -->

<button class=&quot;btn-gen&quot; id=&quot;i_gen-btn&quot;>💼 お仕事受領マークダウンを生成する</button>

<div class=&quot;card&quot; id=&quot;i_output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（お仕事受領）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;i_copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;i_dl-btn&quot; data-out=&quot;i_output&quot; data-prefix=&quot;お仕事受領&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;i_output&quot;></div>
</div>

</div><!-- /panel-intake -->

<!-- =========================================== -->
<!-- ============ TAB 8: ToDo/進捗 ============== -->
<!-- =========================================== -->
<div class=&quot;panel&quot; id=&quot;panel-todo&quot;>

<div class=&quot;card card-tight&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ISO文書管理情報</div>
  <div class=&quot;row cols4&quot;>
    <div><label>文書番号</label><input type=&quot;text&quot; id=&quot;d_docno&quot; placeholder=&quot;例：TODO-2026-0001&quot;></div>
    <div><label>版数</label><input type=&quot;text&quot; id=&quot;d_rev&quot; placeholder=&quot;例：Rev.1.0&quot; value=&quot;Rev.1.0&quot;></div>
    <div><label>機密区分</label>
      <select id=&quot;d_conf&quot;>
        <option value=&quot;公開&quot;>公開</option>
        <option value=&quot;社内限&quot; selected>社内限</option>
        <option value=&quot;社外秘&quot;>社外秘</option>
      </select>
    </div>
    <div><label>関連文書</label><input type=&quot;text&quot; id=&quot;d_relate&quot; placeholder=&quot;例：作業手順書 PROC-2026-0001&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>✅ ToDoリスト基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>リスト名 / プロジェクト</label><input type=&quot;text&quot; id=&quot;d_title&quot; placeholder=&quot;例：研修資料リニューアル タスク管理&quot;></div>
    <div><label>管理者 / 担当</label><input type=&quot;text&quot; id=&quot;d_owner&quot; placeholder=&quot;例：山田花子&quot;></div>
    <div><label>基準日（締切判定の基準）</label><input type=&quot;date&quot; id=&quot;d_basedate&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>出力形式</label>
      <select id=&quot;d_format&quot;>
        <option value=&quot;both&quot; selected>📊 テーブル ＋ ✅ チェックリスト（両方）</option>
        <option value=&quot;table&quot;>📊 Notionテーブルのみ</option>
        <option value=&quot;checklist&quot;>✅ チェックリストのみ</option>
        <option value=&quot;kanban&quot;>📋 ステータス別（カンバン風）</option>
      </select>
    </div>
    <div><label>並び順</label>
      <select id=&quot;d_sort&quot;>
        <option value=&quot;deadline&quot; selected>⏰ 締切が近い順</option>
        <option value=&quot;priority&quot;>🔴 優先度が高い順</option>
        <option value=&quot;status&quot;>📊 ステータス順</option>
        <option value=&quot;none&quot;>入力順のまま</option>
      </select>
    </div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📝 タスク一覧</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 締切と対応状況を入れて管理：</span>各タスクに担当・締切・優先度・ステータス・進捗%を設定。締切超過は自動で🔴表示されます。「主語＋動詞」で書くのがコツ。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;d_add&quot;>＋ タスクを追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;d_load_sample&quot;>📥 サンプルを読み込む</button>
    <button class=&quot;btn-mini&quot; id=&quot;d_clear&quot;>🗑 すべてクリア</button>
  </div>
  <div id=&quot;d_items&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📌 補足メモ（任意）</div>
  <textarea id=&quot;d_note&quot; placeholder=&quot;例：&amp;#10;- 今週は研修準備を最優先&amp;#10;- ブロッカー：演習環境の確認待ち（先方回答待ち）&quot; style=&quot;min-height:50px&quot;></textarea>
</div>

<button class=&quot;btn-gen&quot; id=&quot;d_gen-btn&quot;>✅ ToDoリストのマークダウンを生成する</button>

<div class=&quot;card&quot; id=&quot;d_output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（ToDo/進捗）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;d_copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;d_dl-btn&quot; data-out=&quot;d_output&quot; data-prefix=&quot;ToDo&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;d_output&quot;></div>
</div>

</div><!-- /panel-todo -->

<!-- =========================================== -->
<!-- ============ TAB 9: 依頼＆分配 ============= -->
<!-- =========================================== -->
<div class=&quot;panel&quot; id=&quot;panel-assign&quot;>

<div class=&quot;card card-tight&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ISO文書管理情報</div>
  <div class=&quot;row cols4&quot;>
    <div><label>文書番号</label><input type=&quot;text&quot; id=&quot;a_docno&quot; placeholder=&quot;例：ASGN-2026-0001&quot;></div>
    <div><label>版数</label><input type=&quot;text&quot; id=&quot;a_rev&quot; placeholder=&quot;例：Rev.1.0&quot; value=&quot;Rev.1.0&quot;></div>
    <div><label>機密区分</label>
      <select id=&quot;a_conf&quot;>
        <option value=&quot;公開&quot;>公開</option>
        <option value=&quot;社内限&quot; selected>社内限</option>
        <option value=&quot;社外秘&quot;>社外秘</option>
      </select>
    </div>
    <div><label>関連文書</label><input type=&quot;text&quot; id=&quot;a_relate&quot; placeholder=&quot;例：ToDoリスト TODO-2026-0001&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>モード選択</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 3つの場面：</span>仕事を頼む/頼まれる（依頼のやりとり）、進行中のフォロー（指示出し＆フォロー）、誰に振るか迷ったとき（業務分配アシスト）。</div>
  <div class=&quot;pattern-grid&quot; id=&quot;assignmode-group&quot;>
    <div class=&quot;pattern-card&quot; data-amode=&quot;request&quot;>
      <div class=&quot;pc-key&quot;>MODE 1</div>
      <div class=&quot;pc-title&quot;>🤝 依頼のやりとり</div>
      <div class=&quot;pc-desc&quot;>依頼する/される側のテンプレ＋対応進捗メモ。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-amode=&quot;follow&quot;>
      <div class=&quot;pc-key&quot;>MODE 2</div>
      <div class=&quot;pc-title&quot;>📣 指示出し＆フォロー</div>
      <div class=&quot;pc-desc&quot;>指示を出し、途中フォロー、完了確認まで。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-amode=&quot;distribute&quot;>
      <div class=&quot;pc-key&quot;>MODE 3</div>
      <div class=&quot;pc-title&quot;>🎯 業務分配アシスト</div>
      <div class=&quot;pc-desc&quot;>スキル×ポイントで「誰に振るか」を提案。</div>
    </div>
  </div>
</div>

<!-- ===== MODE 1: 依頼のやりとり ===== -->
<div class=&quot;amode-block&quot; data-amode-target=&quot;request&quot;>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🤝 依頼の方向</div>
  <div class=&quot;audience-bar&quot; style=&quot;background:linear-gradient(90deg,rgba(168,213,186,.25),rgba(245,230,168,.25));border-color:var(--brand-green);margin-bottom:0&quot;>
    <span class=&quot;lbl&quot;>📐 立場</span>
    <div class=&quot;audience-options&quot; id=&quot;a_req_dir-group&quot;>
      <span class=&quot;aud&quot; data-areqdir=&quot;send&quot;>📤 依頼する側（お願いする）</span>
      <span class=&quot;aud&quot; data-areqdir=&quot;recv&quot;>📥 依頼される側（受ける）</span>
    </div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>依頼する人</label><input type=&quot;text&quot; id=&quot;a_req_from&quot; placeholder=&quot;例：山田花子&quot;></div>
    <div><label>依頼される人</label><input type=&quot;text&quot; id=&quot;a_req_to&quot; placeholder=&quot;例：佐藤太郎&quot;></div>
    <div><label>依頼日</label><input type=&quot;date&quot; id=&quot;a_req_date&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>依頼の件名</label><input type=&quot;text&quot; id=&quot;a_req_title&quot; placeholder=&quot;例：研修演習問題のレビュー依頼&quot;></div>
    <div><label>希望納期</label><input type=&quot;date&quot; id=&quot;a_req_due&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>依頼内容（5W2Hで明確に）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 依頼の鉄則：</span>「何を・なぜ・どこまで・いつまでに」を明示。受ける側が判断に迷わないように、ゴールと完了条件を必ず書く。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>何を依頼するか（What）</label><textarea id=&quot;a_req_what&quot; placeholder=&quot;例：&amp;#10;- LPIC-2演習問題 全15問のレビュー&amp;#10;- 難易度・誤字・解説の分かりやすさをチェック&quot;></textarea></div>
    <div><label>なぜ依頼するか（Why・背景）</label><textarea id=&quot;a_req_why&quot; placeholder=&quot;例：&amp;#10;- 受講生フィードバックで『難しすぎる』との声&amp;#10;- 第三者視点で難易度を確認したい&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>どこまで（ゴール・完了条件）</label><textarea id=&quot;a_req_goal&quot; placeholder=&quot;例：&amp;#10;- 各問にコメント付与&amp;#10;- 難易度評価（易/中/難）&amp;#10;- 修正提案があれば箇条書きで&quot; style=&quot;min-height:60px&quot;></textarea></div>
    <div><label>渡す材料・前提情報</label><textarea id=&quot;a_req_material&quot; placeholder=&quot;例：&amp;#10;- 演習問題ファイル（共有済み）&amp;#10;- 受講生フィードバック集計&amp;#10;- 前回の難易度基準メモ&quot; style=&quot;min-height:60px&quot;></textarea></div>
  </div>
  <div><label>想定工数・難易度（依頼側の見立て）</label><input type=&quot;text&quot; id=&quot;a_req_effort&quot; placeholder=&quot;例：1〜2時間程度 / 難易度：中&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📋 対応進捗メモ（受ける側が記入・随時更新）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 受領後に随時更新：</span>受けたら「受領」、進めたら「途中経過」、終わったら「完了報告」を追記。依頼側との認識ズレを防ぐ。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;a_req_addlog&quot;>＋ 進捗ログを追加</button>
  </div>
  <div id=&quot;a_req_logs&quot;></div>
  <div style=&quot;margin-top:12px&quot;><label>受ける側からの確認・質問（あれば）</label><textarea id=&quot;a_req_question&quot; placeholder=&quot;例：&amp;#10;- Q：難易度評価は3段階でよいですか？&amp;#10;- Q：締切は厳守ですか、それとも目安ですか？&quot; style=&quot;min-height:50px&quot;></textarea></div>
</div>

</div><!-- /MODE 1 -->

<!-- ===== MODE 2: 指示出し＆フォロー ===== -->
<div class=&quot;amode-block&quot; data-amode-target=&quot;follow&quot; style=&quot;display:none&quot;>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📣 基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>指示を出す人（リーダー）</label><input type=&quot;text&quot; id=&quot;a_fol_leader&quot; placeholder=&quot;例：佐藤太郎&quot;></div>
    <div><label>指示を受ける人（メンバー）</label><input type=&quot;text&quot; id=&quot;a_fol_member&quot; placeholder=&quot;例：新人 田中&quot;></div>
    <div><label>指示日</label><input type=&quot;date&quot; id=&quot;a_fol_date&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>タスク名</label><input type=&quot;text&quot; id=&quot;a_fol_task&quot; placeholder=&quot;例：トップページのレスポンシブ対応&quot;></div>
    <div><label>期限</label><input type=&quot;date&quot; id=&quot;a_fol_due&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>① 指示出し（最初に明確に伝える）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 良い指示の3点：</span>① ゴールを示す（どうなれば完了か）　② 任せる範囲と判断基準を渡す　③ 詰まったときの相談ルートを伝える。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>ゴール（完了状態）</label><textarea id=&quot;a_fol_goal&quot; placeholder=&quot;例：&amp;#10;- スマホ幅でレイアウト崩れがない&amp;#10;- 主要3デバイス幅で確認済み&quot;></textarea></div>
    <div><label>任せる範囲・判断基準</label><textarea id=&quot;a_fol_scope&quot; placeholder=&quot;例：&amp;#10;- CSSの実装方法は任せる&amp;#10;- ただしブレークポイントは既存仕様に合わせる&amp;#10;- 迷ったら既存ページを参考に&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>相談ルート・チェックポイント</label><textarea id=&quot;a_fol_route&quot; placeholder=&quot;例：&amp;#10;- 着手前に方針を一度共有&amp;#10;- 30分悩んだら即相談（抱え込まない）&amp;#10;- 中間地点で画面共有レビュー&quot; style=&quot;min-height:50px&quot;></textarea></div>
    <div><label>期待する成長ポイント（任せる意図）</label><textarea id=&quot;a_fol_growth&quot; placeholder=&quot;例：&amp;#10;- レスポンシブ設計の考え方を体得してほしい&amp;#10;- 自分で調べて判断する経験を積んでほしい&quot; style=&quot;min-height:50px&quot;></textarea></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>② フォロー記録（途中の声かけ・進捗確認）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 フォローのコツ：</span>放置せず、かといって過干渉せず。事実確認＋次の一歩を一緒に。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;a_fol_addcheck&quot;>＋ フォロー記録を追加</button>
  </div>
  <div id=&quot;a_fol_checks&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>③ 完了確認・振り返り</div>
  <div class=&quot;row cols2&quot;>
    <div><label>完了状態の確認結果</label><textarea id=&quot;a_fol_result&quot; placeholder=&quot;例：&amp;#10;- ゴール達成 ✅&amp;#10;- 3デバイス幅で崩れなし確認済み&amp;#10;- 1点だけフッターの余白を微調整依頼&quot;></textarea></div>
    <div><label>良かった点・次への課題（メンバーへ）</label><textarea id=&quot;a_fol_feedback&quot; placeholder=&quot;例：&amp;#10;- 👍 早めに方針相談ができていた&amp;#10;- 👍 自分で調べて解決した姿勢が良い&amp;#10;- 次回：着手前の完了条件の確認をもう一歩&quot;></textarea></div>
  </div>
</div>

</div><!-- /MODE 2 -->

<!-- ===== MODE 3: 業務分配アシスト ===== -->
<div class=&quot;amode-block&quot; data-amode-target=&quot;distribute&quot; style=&quot;display:none&quot;>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🎯 業務分配アシスト：基本設定</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 仕組み：</span>メンバーのスキルを<strong>🔴🟡🟢の3信号 ×（📝筆記/🛠実技/🗣口頭）</strong>で評価。タスクの必要スキルと突き合わせ、<strong>こなせる人の中で今いちばん持ちポイントが少ない人</strong>を提案します（負荷分散）。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>チーム名 / 案件</label><input type=&quot;text&quot; id=&quot;a_dist_team&quot; placeholder=&quot;例：研修制作チーム&quot;></div>
    <div><label>分配責任者</label><input type=&quot;text&quot; id=&quot;a_dist_owner&quot; placeholder=&quot;例：佐藤太郎&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>👥 メンバー登録（スキル3信号 × 3試験）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>信号の意味：</span><span style=&quot;color:#3A9B5C;font-weight:700&quot;>🟢=自立してできる</span> / <span style=&quot;color:#B89320;font-weight:700&quot;>🟡=補助があればできる</span> / <span style=&quot;color:#C8553D;font-weight:700&quot;>🔴=要指導</span>　　持ちポイントは現在抱えている負荷量です。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;a_dist_addmember&quot;>＋ メンバーを追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;a_dist_loadmember&quot;>📥 サンプルメンバー</button>
    <button class=&quot;btn-mini&quot; id=&quot;a_dist_clearmember&quot;>🗑 クリア</button>
  </div>
  <div id=&quot;a_dist_members&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📋 配分するタスク登録</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>設定方法：</span>各タスクに「主に必要なスキル領域（筆記/実技/口頭）」と「必要レベル」「ポイント（負荷）」を設定。提案ボタンで最適な担当を割り出します。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;a_dist_addtask&quot;>＋ タスクを追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;a_dist_loadtask&quot;>📥 サンプルタスク</button>
    <button class=&quot;btn-mini&quot; id=&quot;a_dist_cleartask&quot;>🗑 クリア</button>
  </div>
  <div id=&quot;a_dist_tasks&quot;></div>
</div>

<div class=&quot;card&quot; style=&quot;background:linear-gradient(180deg,rgba(168,213,186,.20),transparent);border-color:var(--brand-green)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>✨ 振り分け提案</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 負荷分散ロジック：</span>各タスクについて「必要レベルを満たすメンバー」を抽出し、その中で<strong>現在の持ちポイント＋本タスクのポイントが最小</strong>になる人を提案。割り当て後はポイントが加算され、次のタスク提案に反映されます。</div>
  <button class=&quot;btn-mini&quot; id=&quot;a_dist_suggest&quot; style=&quot;border-color:var(--brand-green-deep);color:var(--brand-green-deep);font-weight:600&quot;>🎯 振り分けを提案する</button>
  <div id=&quot;a_dist_result&quot; style=&quot;margin-top:12px&quot;></div>
</div>

</div><!-- /MODE 3 -->

<button class=&quot;btn-gen&quot; id=&quot;a_gen-btn&quot;>🤝 依頼＆分配マークダウンを生成する</button>

<div class=&quot;card&quot; id=&quot;a_output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（依頼＆分配）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;a_copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;a_dl-btn&quot; data-out=&quot;a_output&quot; data-prefix=&quot;依頼分配&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;a_output&quot;></div>
</div>

</div><!-- /panel-assign -->

<!-- =========================================== -->
<!-- ========== TAB 10: 研修ドキュメント ======== -->
<!-- =========================================== -->
<div class=&quot;panel&quot; id=&quot;panel-docs&quot;>

<div class=&quot;card card-tight&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ISO文書管理情報</div>
  <div class=&quot;row cols4&quot;>
    <div><label>文書番号</label><input type=&quot;text&quot; id=&quot;x_docno&quot; placeholder=&quot;例：DOC-2026-0001&quot;></div>
    <div><label>版数</label><input type=&quot;text&quot; id=&quot;x_rev&quot; placeholder=&quot;例：Rev.1.0&quot; value=&quot;Rev.1.0&quot;></div>
    <div><label>機密区分</label>
      <select id=&quot;x_conf&quot;>
        <option value=&quot;公開&quot;>公開</option>
        <option value=&quot;社内限&quot; selected>社内限</option>
        <option value=&quot;社外秘&quot;>社外秘</option>
      </select>
    </div>
    <div><label>関連文書</label><input type=&quot;text&quot; id=&quot;x_relate&quot; placeholder=&quot;例：研修企画書&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>モード選択</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 3つのドキュメント：</span>案件実績の整形（スキルシート）、案件受注前の期待値ヒアリング、研修当日の時間割。それぞれNotion/スプレッドシートに貼れる形で出力します。</div>
  <div class=&quot;pattern-grid&quot; id=&quot;docsmode-group&quot;>
    <div class=&quot;pattern-card&quot; data-xmode=&quot;skill&quot;>
      <div class=&quot;pc-key&quot;>MODE 1</div>
      <div class=&quot;pc-title&quot;>📄 スキルシート案件欄</div>
      <div class=&quot;pc-desc&quot;>5ブロック構成。期間別ケースA/B/C・企業名特定NG検出付き。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-xmode=&quot;hearing&quot;>
      <div class=&quot;pc-key&quot;>MODE 2</div>
      <div class=&quot;pc-title&quot;>🎤 ヒアリングシート</div>
      <div class=&quot;pc-desc&quot;>クライアント期待値を言語化。マインドタイプ診断付き。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-xmode=&quot;schedule&quot;>
      <div class=&quot;pc-key&quot;>MODE 3</div>
      <div class=&quot;pc-title&quot;>📅 研修時間割</div>
      <div class=&quot;pc-desc&quot;>黄金比チェック・カテゴリ別集計・LIVE対応の時間割。</div>
    </div>
  </div>
</div>

<!-- ===== MODE 1: スキルシート案件欄 ===== -->
<div class=&quot;xmode-block&quot; data-xmode-target=&quot;skill&quot;>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📋 メタデータ（外枠9項目）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>⚠️ 企業名特定はNG：</span>「業界＋システム種別」で書く（例：金融業 社内システム開発）。実在企業名・固有のシステム名を入れると提出前チェックで警告します。</div>
  <div class=&quot;row cols3&quot;>
    <div><label>No</label><input type=&quot;text&quot; id=&quot;x_sk_no&quot; placeholder=&quot;例：1&quot;></div>
    <div><label>期間（年月数）</label><input type=&quot;text&quot; id=&quot;x_sk_period1&quot; placeholder=&quot;例：4年8ケ月&quot;></div>
    <div><label>期間（年月）</label><input type=&quot;text&quot; id=&quot;x_sk_period2&quot; placeholder=&quot;例：2020年02月〜2024年09月&quot;></div>
  </div>
  <div class=&quot;row cols3&quot;>
    <div><label>業種</label><input type=&quot;text&quot; id=&quot;x_sk_industry&quot; placeholder=&quot;例：金融&quot;></div>
    <div><label>役割</label><input type=&quot;text&quot; id=&quot;x_sk_role&quot; placeholder=&quot;例：SE&quot;></div>
    <div><label>規模</label><input type=&quot;text&quot; id=&quot;x_sk_scale&quot; placeholder=&quot;例：全体20名 / チーム7名&quot;></div>
  </div>
  <div><label>企業・プロジェクト名（タイトル行・15〜25文字・企業名特定NG）</label><input type=&quot;text&quot; id=&quot;x_sk_title&quot; placeholder=&quot;例：金融業　社内システム開発　※FEとBE開発&quot;></div>
  <div class=&quot;row cols3&quot;>
    <div><label>言語／ツール（7〜8要素）</label><textarea id=&quot;x_sk_lang&quot; placeholder=&quot;例：Java（SpringBoot）（SpringBatch）HTML CSS3 Javascript（Jquery）&quot; style=&quot;min-height:50px&quot;></textarea></div>
    <div><label>DB</label><input type=&quot;text&quot; id=&quot;x_sk_db&quot; placeholder=&quot;例：PostgreSQL&quot;></div>
    <div><label>サーバ／OS</label><input type=&quot;text&quot; id=&quot;x_sk_os&quot; placeholder=&quot;例：Windows Server&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>環境／ミドルウェア</label><input type=&quot;text&quot; id=&quot;x_sk_env&quot; placeholder=&quot;例：Git spring&quot;></div>
    <div><label>担当工程（該当に○）</label><input type=&quot;text&quot; id=&quot;x_sk_process&quot; placeholder=&quot;例：要件定義、基本設計、詳細設計、製造、テスト&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📐 案件規模ケース（本文量の目安）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>見本PDF実測ベース：</span>選ぶと作業内容の推奨行数が変わります。<br><code>A 長期(4年級)</code>≈300字/作業11項目　<code>B 中期(1年級)</code>≈100〜150字/作業3〜5項目　<code>C 短期(4ヶ月級)</code>≈100字/作業5〜6項目</div>
  <div class=&quot;badge-row&quot; id=&quot;x_sk_case-group&quot;>
    <span class=&quot;badge&quot; data-group=&quot;skcase&quot; data-val=&quot;A&quot; data-cls=&quot;default&quot;>A：長期案件（4年級・約300字）</span>
    <span class=&quot;badge&quot; data-group=&quot;skcase&quot; data-val=&quot;B&quot; data-cls=&quot;default&quot;>B：中期案件（1年級・約100〜150字）</span>
    <span class=&quot;badge&quot; data-group=&quot;skcase&quot; data-val=&quot;C&quot; data-cls=&quot;default&quot;>C：短期案件（4ヶ月級・約100字）</span>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📝 本文5ブロック</div>
  <div class=&quot;row cols2&quot;>
    <div><label>■システム内容（1〜2行・15〜25文字）</label><textarea id=&quot;x_sk_system&quot; placeholder=&quot;例：金融系企業の社内システム開発支援&quot; style=&quot;min-height:45px&quot;></textarea></div>
    <div><label>■対応工程（2〜3行・「工程〜（期間）」）</label><textarea id=&quot;x_sk_phase&quot; placeholder=&quot;例：&amp;#10;要件定義〜詳細設計（2020/01〜2022/12）&amp;#10;製造〜（2023/01〜2023/11）&amp;#10;運用保守〜（2023/12〜）&quot;></textarea></div>
  </div>
  <div><label>■担当業務（2〜3行・役割と担当範囲）</label><textarea id=&quot;x_sk_duty&quot; placeholder=&quot;例：&amp;#10;SEとしてPJに参画&amp;#10;金融業向けの社内システムの新規開発に伴い要件定義から対応&quot; style=&quot;min-height:50px&quot;></textarea></div>
  <div><label>■作業内容（箇条書き・各行10〜20文字・動詞語尾で揃える）</label><textarea id=&quot;x_sk_work&quot; placeholder=&quot;1行に1項目（先頭の「・」は不要・自動付与）：&amp;#10;要件の実現検討（工数見積もり、設計方針）&amp;#10;クライアントへのヒアリング&amp;#10;基本設計、詳細設計及び設計書作成&amp;#10;単体テスト、結合テストの仕様書作成&amp;#10;単体テスト、結合テストの実施&quot; style=&quot;min-height:120px&quot;></textarea></div>
  <div><label>■成果物（1〜2行・可能なら数字を入れる）</label><textarea id=&quot;x_sk_output&quot; placeholder=&quot;例：要件定義書から報告書などの各種ドキュメント&quot; style=&quot;min-height:40px&quot;></textarea></div>
</div>

</div><!-- /MODE 1 -->

<!-- ===== MODE 2: ヒアリングシート ===== -->
<div class=&quot;xmode-block&quot; data-xmode-target=&quot;hearing&quot; style=&quot;display:none&quot;>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🎤 1. 基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>クライアント会社名（自分用メモ・出力では伏せ可）</label><input type=&quot;text&quot; id=&quot;x_h_company&quot; placeholder=&quot;例：株式会社〇〇&quot;></div>
    <div><label>担当者名</label><input type=&quot;text&quot; id=&quot;x_h_person&quot; placeholder=&quot;例：〇〇様&quot;></div>
    <div><label>記入日</label><input type=&quot;date&quot; id=&quot;x_h_date&quot;></div>
  </div>
  <div class=&quot;row cols3&quot;>
    <div><label>研修テーマ</label><input type=&quot;text&quot; id=&quot;x_h_theme&quot; placeholder=&quot;例：Python基礎 / Excel / セキュリティ&quot;></div>
    <div><label>実施形式</label>
      <select id=&quot;x_h_format&quot;>
        <option value=&quot;対面&quot;>対面</option>
        <option value=&quot;オンライン&quot;>オンライン</option>
        <option value=&quot;ハイブリッド&quot;>ハイブリッド</option>
      </select>
    </div>
    <div><label>受講人数</label><input type=&quot;text&quot; id=&quot;x_h_count&quot; placeholder=&quot;例：20名&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>実施予定日・回数</label><input type=&quot;text&quot; id=&quot;x_h_when&quot; placeholder=&quot;例：2026年7月〜 全4回×3時間&quot;></div>
    <div><label>受講生の職種・年齢層</label><input type=&quot;text&quot; id=&quot;x_h_who&quot; placeholder=&quot;例：営業・事務 / 20〜40代&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🎯 2. 期待値・ゴールの言語化（最重要）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 行動動詞で：</span>「理解する」ではなく「〇〇できる・〇〇を作れる」と行動で書くと、研修設計と評価がブレません。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>3ヶ月後に起きてほしい現場変化（行動動詞で）</label><textarea id=&quot;x_h_goal3m&quot; placeholder=&quot;例：&amp;#10;- 受講生が自力でExcelマクロを書いて定例レポートを自動化できる&amp;#10;- 質問が『動かない』から『ここのロジックが』に変わる&quot;></textarea></div>
    <div><label>研修企画の背景・きっかけ</label><textarea id=&quot;x_h_background&quot; placeholder=&quot;例：&amp;#10;- 定例業務の手作業が多く残業が常態化&amp;#10;- 若手の独力解決力を育てたい&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>成功の定義・測定基準</label><textarea id=&quot;x_h_success&quot; placeholder=&quot;例：業務時間20%削減 / 修了テスト80点以上&quot; style=&quot;min-height:50px&quot;></textarea></div>
    <div><label>失敗の定義（NGシナリオ）</label><textarea id=&quot;x_h_fail&quot; placeholder=&quot;例：研修後も誰も使わない / 難しすぎて離脱者が出る&quot; style=&quot;min-height:50px&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>絶対に身につけてほしいスキル TOP1</label><input type=&quot;text&quot; id=&quot;x_h_top1&quot; placeholder=&quot;例：エラーメッセージを読んで自分で対処する力&quot;></div>
    <div><label>絶対に外せないコンテンツ</label><input type=&quot;text&quot; id=&quot;x_h_must&quot; placeholder=&quot;例：変数・ループ・条件分岐の基礎&quot;></div>
  </div>
  <div><label>時間が足りない場合に削ってよい内容</label><input type=&quot;text&quot; id=&quot;x_h_cut&quot; placeholder=&quot;例：オブジェクト指向の応用部分&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>👥 3. 受講生プロファイル・マインド診断</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>マインドタイプ：</span><code>A=前向き型</code> <code>B=義務参加型</code> <code>C=懐疑型</code> <code>D=恐怖型(IT苦手)</code></div>
  <div class=&quot;row cols3&quot;>
    <div><label>主なマインドタイプ</label>
      <select id=&quot;x_h_mind&quot;>
        <option value=&quot;A=前向き型&quot;>A=前向き型</option>
        <option value=&quot;B=義務参加型&quot;>B=義務参加型</option>
        <option value=&quot;C=懐疑型&quot;>C=懐疑型</option>
        <option value=&quot;D=恐怖型（IT苦手）&quot;>D=恐怖型（IT苦手）</option>
        <option value=&quot;混在&quot;>混在</option>
      </select>
    </div>
    <div><label>受講の任意/強制</label>
      <select id=&quot;x_h_force&quot;><option value=&quot;任意&quot;>任意</option><option value=&quot;強制&quot;>強制</option></select>
    </div>
    <div><label>ITスキル平均レベル</label>
      <select id=&quot;x_h_level&quot;><option value=&quot;初級&quot;>初級</option><option value=&quot;中級&quot;>中級</option><option value=&quot;上級&quot;>上級</option></select>
    </div>
  </div>
  <div class=&quot;row cols3&quot;>
    <div><label>間違い指摘への耐性</label>
      <select id=&quot;x_h_tolerance&quot;><option value=&quot;高い&quot;>高い</option><option value=&quot;普通&quot;>普通</option><option value=&quot;低い&quot;>低い</option></select>
    </div>
    <div><label>研修トーン希望</label>
      <select id=&quot;x_h_tone&quot;><option value=&quot;楽しさ重視&quot;>楽しさ重視</option><option value=&quot;バランス&quot;>バランス</option><option value=&quot;真剣&quot;>真剣</option></select>
    </div>
    <div><label>講義 vs 演習の比率</label><input type=&quot;text&quot; id=&quot;x_h_ratio&quot; placeholder=&quot;例：講義60% 演習40%&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>テスト・評価の実施可否</label>
      <select id=&quot;x_h_test&quot;><option value=&quot;OK&quot;>OK</option><option value=&quot;NG&quot;>NG</option></select>
    </div>
    <div><label>宿題・事前課題の可否</label>
      <select id=&quot;x_h_homework&quot;><option value=&quot;OK&quot;>OK</option><option value=&quot;NG&quot;>NG</option></select>
    </div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🚫 4. 制約・NG事項</div>
  <div class=&quot;row cols2&quot;>
    <div><label>使用PC・ツール</label><input type=&quot;text&quot; id=&quot;x_h_tools&quot; placeholder=&quot;例：Windows11 / Office365&quot;></div>
    <div><label>予算感</label><input type=&quot;text&quot; id=&quot;x_h_budget&quot; placeholder=&quot;例：〇〇万円以内&quot;></div>
  </div>
  <div><label>NGトピック・社外秘情報</label><textarea id=&quot;x_h_ng&quot; placeholder=&quot;例：&amp;#10;- 自社の機密データは演習に使用不可&amp;#10;- 特定製品の批判はNG&quot; style=&quot;min-height:45px&quot;></textarea></div>
  <div><label>過去研修の良かった点・悪かった点</label><textarea id=&quot;x_h_past&quot; placeholder=&quot;例：&amp;#10;- 良：手を動かす演習が好評&amp;#10;- 悪：座学が長くて眠くなったとの声&quot; style=&quot;min-height:45px&quot;></textarea></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📋 出力オプション</div>
  <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; id=&quot;x_h_includeQ&quot; checked><span>当日質問テンプレート20問を出力に含める</span></label>
  <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; id=&quot;x_h_maskCompany&quot;><span>会社名を伏せ字（〇〇）にして出力する</span></label>
</div>

</div><!-- /MODE 2 -->

<!-- ===== MODE 3: 研修時間割 ===== -->
<div class=&quot;xmode-block&quot; data-xmode-target=&quot;schedule&quot; style=&quot;display:none&quot;>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📅 時間割 基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>研修名</label><input type=&quot;text&quot; id=&quot;x_s_title&quot; placeholder=&quot;例：Linux基礎研修 Day1&quot;></div>
    <div><label>日付</label><input type=&quot;date&quot; id=&quot;x_s_date&quot;></div>
    <div><label>開始時刻</label><input type=&quot;time&quot; id=&quot;x_s_start&quot; value=&quot;09:00&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🕐 セッション一覧</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 開始時刻は自動連鎖：</span>各セッションの「所要分」を入れると、開始時刻に積み上げて終了時刻まで自動計算。途中で押しても所要分を直すだけ。<br>黄金比目安：講義45% / 演習25% / 休憩+昼15% / テスト10% / オリエン+質問5%</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;x_s_add&quot;>＋ セッション追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;x_s_loadtemplate&quot;>📥 1日の定石を読み込む</button>
    <button class=&quot;btn-mini&quot; id=&quot;x_s_clear&quot;>🗑 クリア</button>
  </div>
  <div id=&quot;x_s_sessions&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📋 出力オプション</div>
  <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; id=&quot;x_s_summary&quot; checked><span>カテゴリ別の時間配分集計（黄金比チェック）を含める</span></label>
  <label class=&quot;chk&quot;><input type=&quot;checkbox&quot; id=&quot;x_s_sheets&quot;><span>Googleスプレッドシート用の関数ヒント（自動連鎖・LIVE）を付記する</span></label>
</div>

</div><!-- /MODE 3 -->

<button class=&quot;btn-gen&quot; id=&quot;x_gen-btn&quot;>📄 研修ドキュメントのマークダウンを生成する</button>

<div class=&quot;card&quot; id=&quot;x_output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（研修ドキュメント）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;x_copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;x_dl-btn&quot; data-out=&quot;x_output&quot; data-prefix=&quot;研修ドキュメント&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;x_output&quot;></div>
</div>

</div><!-- /panel-docs -->

<!-- =========================================== -->
<!-- ======== TAB 11: 現場コミュニケーション ==== -->
<!-- =========================================== -->
<div class=&quot;panel&quot; id=&quot;panel-comm&quot;>

<div class=&quot;card card-tight&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ISO文書管理情報</div>
  <div class=&quot;row cols4&quot;>
    <div><label>文書番号</label><input type=&quot;text&quot; id=&quot;k_docno&quot; placeholder=&quot;例：COMM-2026-0001&quot;></div>
    <div><label>版数</label><input type=&quot;text&quot; id=&quot;k_rev&quot; placeholder=&quot;例：Rev.1.0&quot; value=&quot;Rev.1.0&quot;></div>
    <div><label>機密区分</label>
      <select id=&quot;k_conf&quot;>
        <option value=&quot;公開&quot;>公開</option>
        <option value=&quot;社内限&quot; selected>社内限</option>
        <option value=&quot;社外秘&quot;>社外秘</option>
      </select>
    </div>
    <div><label>関連文書</label><input type=&quot;text&quot; id=&quot;k_relate&quot; placeholder=&quot;例：プロジェクト管理表&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>モード選択</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 現場の7つの場面：</span>会議・振り返り・上司報告・クレーム対応・指示確認・進捗報告・日報。それぞれ「事実と所感を分ける」「結論ファースト」の原則で組んであります。</div>
  <div class=&quot;pattern-grid&quot; id=&quot;commmode-group&quot;>
    <div class=&quot;pattern-card&quot; data-kmode=&quot;mtg&quot;><div class=&quot;pc-key&quot;>MODE 1</div><div class=&quot;pc-title&quot;>🗓 MTG当日メモ</div><div class=&quot;pc-desc&quot;>議題・決定事項・宿題を構造化。</div></div>
    <div class=&quot;pattern-card&quot; data-kmode=&quot;retro&quot;><div class=&quot;pc-key&quot;>MODE 2</div><div class=&quot;pc-title&quot;>🔄 振り返りシート</div><div class=&quot;pc-desc&quot;>KPT / YWT で学びを次に活かす。</div></div>
    <div class=&quot;pattern-card&quot; data-kmode=&quot;boss&quot;><div class=&quot;pc-key&quot;>MODE 3</div><div class=&quot;pc-title&quot;>📨 忙しい上司へ報告</div><div class=&quot;pc-desc&quot;>結論ファースト・30秒で読める形。</div></div>
    <div class=&quot;pattern-card&quot; data-kmode=&quot;claim&quot;><div class=&quot;pc-key&quot;>MODE 4</div><div class=&quot;pc-title&quot;>⚠️ クレーム→改善</div><div class=&quot;pc-desc&quot;>一次対応＋原因＋再発防止アクション。</div></div>
    <div class=&quot;pattern-card&quot; data-kmode=&quot;confirm2&quot;><div class=&quot;pc-key&quot;>MODE 5</div><div class=&quot;pc-title&quot;>✅ 指示の確認・復唱</div><div class=&quot;pc-desc&quot;>認識を合わせてから着手する。</div></div>
    <div class=&quot;pattern-card&quot; data-kmode=&quot;progress&quot;><div class=&quot;pc-key&quot;>MODE 6</div><div class=&quot;pc-title&quot;>📊 進捗報告</div><div class=&quot;pc-desc&quot;>順調/要注意/赤信号で状態共有。</div></div>
    <div class=&quot;pattern-card&quot; data-kmode=&quot;daily&quot;><div class=&quot;pc-key&quot;>MODE 7</div><div class=&quot;pc-title&quot;>📝 日報</div><div class=&quot;pc-desc&quot;>事実と所感を分けて1日を記録。</div></div>
    <div class=&quot;pattern-card&quot; data-kmode=&quot;prep&quot;><div class=&quot;pc-key&quot;>MODE 8</div><div class=&quot;pc-title&quot;>📋 報告メモ（PREP）</div><div class=&quot;pc-desc&quot;>結論→根拠→経緯。報告前に必ず記入。</div></div>
    <div class=&quot;pattern-card&quot; data-kmode=&quot;timed&quot;><div class=&quot;pc-key&quot;>MODE 9</div><div class=&quot;pc-title&quot;>⏱ 時間別報告</div><div class=&quot;pc-desc&quot;>1分/3分/5分で伝える内容を絞り込む。</div></div>
    <div class=&quot;pattern-card&quot; data-kmode=&quot;agenda2&quot;><div class=&quot;pc-key&quot;>MODE 10</div><div class=&quot;pc-title&quot;>📅 会議アジェンダ</div><div class=&quot;pc-desc&quot;>会議前に配る進行表。議題ごとの時間配分。</div></div>
    <div class=&quot;pattern-card&quot; data-kmode=&quot;kaizen&quot;><div class=&quot;pc-key&quot;>MODE 11</div><div class=&quot;pc-title&quot;>🔧 カイゼンMTG</div><div class=&quot;pc-desc&quot;>問題→なぜなぜ→改善策→担当・期限。</div></div>
    <div class=&quot;pattern-card&quot; data-kmode=&quot;fb&quot;><div class=&quot;pc-key&quot;>MODE 12</div><div class=&quot;pc-title&quot;>💬 FB会</div><div class=&quot;pc-desc&quot;>Good/More＋本人の振り返り＋次の目標。</div></div>
  </div>
</div>

<!-- 共通：基本情報 -->
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>基本情報（共通）</div>
  <div class=&quot;row cols3&quot;>
    <div><label>記入者（自分）</label><input type=&quot;text&quot; id=&quot;k_author&quot; placeholder=&quot;例：山田花子&quot;></div>
    <div><label>相手・宛先</label><input type=&quot;text&quot; id=&quot;k_to&quot; placeholder=&quot;例：佐藤リーダー / 開発チーム&quot;></div>
    <div><label>日付</label><input type=&quot;date&quot; id=&quot;k_date&quot;></div>
  </div>
</div>

<!-- ===== MODE 1: MTG当日メモ ===== -->
<div class=&quot;kmode-block&quot; data-kmode-target=&quot;mtg&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🗓 会議情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>会議名</label><input type=&quot;text&quot; id=&quot;k_mtg_title&quot; placeholder=&quot;例：週次定例MTG&quot;></div>
    <div><label>時間</label><input type=&quot;text&quot; id=&quot;k_mtg_time&quot; placeholder=&quot;例：15:00-16:00&quot;></div>
    <div><label>出席者</label><input type=&quot;text&quot; id=&quot;k_mtg_attendees&quot; placeholder=&quot;例：自分、佐藤、田中&quot;></div>
  </div>
  <div><label>会議の目的・ゴール</label><input type=&quot;text&quot; id=&quot;k_mtg_goal&quot; placeholder=&quot;例：来週リリースの最終確認&quot;></div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>議事内容</div>
  <div><label>📋 議題と議論内容</label><textarea id=&quot;k_mtg_agenda&quot; placeholder=&quot;例：&amp;#10;1. リリース日程の確認&amp;#10;　- 6/10で確定&amp;#10;2. 残課題の洗い出し&amp;#10;　- ログイン画面のバグ対応が未完&quot;></textarea></div>
  <div class=&quot;row cols2&quot;>
    <div><label>✅ 決定事項</label><textarea id=&quot;k_mtg_decisions&quot; placeholder=&quot;例：&amp;#10;- リリースは6/10に確定&amp;#10;- バグ対応を最優先にする&quot;></textarea></div>
    <div><label>❓ 保留・持ち帰り事項</label><textarea id=&quot;k_mtg_pending&quot; placeholder=&quot;例：&amp;#10;- インフラ増強の要否は来週判断&amp;#10;- 予算は部長確認待ち&quot;></textarea></div>
  </div>
  <div><label>📌 宿題・アクション（誰が・何を・いつまで）</label><textarea id=&quot;k_mtg_actions&quot; placeholder=&quot;例：&amp;#10;- 自分：ログインバグ修正（6/5まで）&amp;#10;- 佐藤：リリース手順書作成（6/7まで）&quot; style=&quot;min-height:60px&quot;></textarea></div>
</div>
</div>

<!-- ===== MODE 2: 振り返りシート ===== -->
<div class=&quot;kmode-block&quot; data-kmode-target=&quot;retro&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🔄 振り返りのフレーム</div>
  <div class=&quot;badge-row&quot; id=&quot;k_retro_frame-group&quot;>
    <span class=&quot;badge&quot; data-group=&quot;retroframe&quot; data-val=&quot;KPT&quot; data-cls=&quot;default&quot;>KPT（Keep/Problem/Try）</span>
    <span class=&quot;badge&quot; data-group=&quot;retroframe&quot; data-val=&quot;YWT&quot; data-cls=&quot;default&quot;>YWT（やったこと/わかったこと/次やること）</span>
  </div>
  <div><label>振り返り対象（期間・案件）</label><input type=&quot;text&quot; id=&quot;k_retro_target&quot; placeholder=&quot;例：5月の研修運営 / Sprint 12&quot;></div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>振り返り内容</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 KPTなら：</span>Keep=続けたい良かったこと / Problem=課題 / Try=次に試すこと。<strong>YWTなら：</strong>Y=やったこと / W=わかったこと（学び） / T=次にやること。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🟢 Keep / Y（やったこと・良かったこと）</label><textarea id=&quot;k_retro_a&quot; placeholder=&quot;例：&amp;#10;- 演習を早めに入れて理解が深まった&amp;#10;- 朝会で1日のゴールを共有できた&quot;></textarea></div>
    <div><label>🟡 Problem / W（課題・わかったこと）</label><textarea id=&quot;k_retro_b&quot; placeholder=&quot;例：&amp;#10;- 講義が長くて午後眠そうだった&amp;#10;- 質問対応に時間を取られた&quot;></textarea></div>
  </div>
  <div><label>🔵 Try / T（次にやること）</label><textarea id=&quot;k_retro_c&quot; placeholder=&quot;例：&amp;#10;- 午後イチは対話形式にする&amp;#10;- 質問はまとめて受ける時間を設ける&quot; style=&quot;min-height:55px&quot;></textarea></div>
  <div><label>💡 一番の学び（1行で）</label><input type=&quot;text&quot; id=&quot;k_retro_learn&quot; placeholder=&quot;例：受講生の集中力は午後イチが谷。設計で対策できる&quot;></div>
</div>
</div>

<!-- ===== MODE 3: 忙しい上司へ報告 ===== -->
<div class=&quot;kmode-block&quot; data-kmode-target=&quot;boss&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📨 結論ファースト報告</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 忙しい上司の鉄則：</span>最初の3行で「結論・必要な判断・期限」が分かるように。詳細は後ろ。読むのに30秒以上かからない構成にします。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🎯 結論（一番伝えたいこと・1〜2文）</label><textarea id=&quot;k_boss_conclusion&quot; placeholder=&quot;例：&amp;#10;リリースを2日延期したいです。重大バグが1件見つかったためです。&quot; style=&quot;min-height:50px&quot;></textarea></div>
    <div><label>🙋 上司にしてほしいこと（判断/承認/共有のみ）</label><textarea id=&quot;k_boss_need&quot; placeholder=&quot;例：&amp;#10;延期の承認をお願いします。&amp;#10;（判断のみで結構です）&quot; style=&quot;min-height:50px&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>⏰ 期限（いつまでに判断が必要か）</label><input type=&quot;text&quot; id=&quot;k_boss_due&quot; placeholder=&quot;例：本日17時まで&quot;></div>
    <div><label>📊 重要度</label>
      <select id=&quot;k_boss_level&quot;>
        <option value=&quot;🔴 至急・要判断&quot;>🔴 至急・要判断</option>
        <option value=&quot;🟡 要確認&quot; selected>🟡 要確認</option>
        <option value=&quot;🟢 共有のみ（返信不要）&quot;>🟢 共有のみ（返信不要）</option>
      </select>
    </div>
  </div>
  <div><label>📋 背景・詳細（必要な人だけ読む）</label><textarea id=&quot;k_boss_detail&quot; placeholder=&quot;例：&amp;#10;- ログイン処理で特定条件下のデータ消失バグを発見&amp;#10;- 修正に最低2日必要&amp;#10;- 影響範囲は限定的だが本番リスク大&quot;></textarea></div>
  <div><label>💡 自分の推奨案（あれば）</label><textarea id=&quot;k_boss_recommend&quot; placeholder=&quot;例：&amp;#10;6/12への延期を推奨。代替として機能を縮退してのリリースも可能ですが、品質面で延期が安全と考えます。&quot; style=&quot;min-height:45px&quot;></textarea></div>
</div>
</div>

<!-- ===== MODE 4: クレーム→改善 ===== -->
<div class=&quot;kmode-block&quot; data-kmode-target=&quot;claim&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>⚠️ クレーム内容（事実ベース）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 鉄則：</span>事実と解釈を分ける。まず一次対応（謝意・受け止め）、次に原因究明、最後に再発防止。個人を責めずシステムで考える。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>誰から・いつ</label><input type=&quot;text&quot; id=&quot;k_claim_from&quot; placeholder=&quot;例：受講生Aさん / 6/3 研修後&quot;></div>
    <div><label>重大度</label>
      <select id=&quot;k_claim_severity&quot;>
        <option value=&quot;🔴 重大&quot;>🔴 重大</option>
        <option value=&quot;🟡 中&quot; selected>🟡 中</option>
        <option value=&quot;🟢 軽微&quot;>🟢 軽微</option>
      </select>
    </div>
  </div>
  <div><label>📝 クレーム内容（言われたことを客観的に）</label><textarea id=&quot;k_claim_content&quot; placeholder=&quot;例：&amp;#10;- 演習の難易度が高すぎてついていけなかった&amp;#10;- 質問しても先生が忙しそうで聞けなかった&quot;></textarea></div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>対応とアクション</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🩹 一次対応（すでに取った/取る対応）</label><textarea id=&quot;k_claim_first&quot; placeholder=&quot;例：&amp;#10;- その場で謝意を伝え、補講を提案&amp;#10;- 翌日フォローアップ面談を実施&quot;></textarea></div>
    <div><label>🔍 原因分析（なぜ起きたか・システム視点）</label><textarea id=&quot;k_claim_cause&quot; placeholder=&quot;例：&amp;#10;- 事前スキルチェックをしておらず難易度がミスマッチ&amp;#10;- 質問しやすい時間設計がなかった&quot;></textarea></div>
  </div>
  <div><label>🛡 再発防止アクション（具体的に・期限付き）</label><textarea id=&quot;k_claim_prevent&quot; placeholder=&quot;例：&amp;#10;- 事前スキルアンケートを必須化（次回研修から）&amp;#10;- 各セッションに質問タイムを5分組み込む&amp;#10;- 演習に難易度別の選択制を導入&quot; style=&quot;min-height:60px&quot;></textarea></div>
  <div><label>📨 報告先・エスカレーション</label><input type=&quot;text&quot; id=&quot;k_claim_report&quot; placeholder=&quot;例：佐藤リーダーに即日共有済み / 人事へ報告予定&quot;></div>
</div>
</div>

<!-- ===== MODE 5: 指示の確認・復唱 ===== -->
<div class=&quot;kmode-block&quot; data-kmode-target=&quot;confirm2&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>✅ 指示の確認・復唱</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 着手前に認識合わせ：</span>受けた指示を自分の言葉で復唱し、認識ズレを着手前に潰す。「分かったつもり」で進めて手戻りする事故を防ぎます。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>📥 受けた指示（言われたまま）</label><textarea id=&quot;k_cf_received&quot; placeholder=&quot;例：&amp;#10;- 来週の研修資料を最新版に更新しておいて&amp;#10;- ついでに演習問題も見直して&quot;></textarea></div>
    <div><label>🎯 私の理解（自分の言葉で復唱）</label><textarea id=&quot;k_cf_understand&quot; placeholder=&quot;例：&amp;#10;- Vol.3〜5の資料を最新コマンド仕様に更新&amp;#10;- 演習問題の難易度と誤字を確認&amp;#10;という認識です&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>📦 成果物・完了条件の認識</label><textarea id=&quot;k_cf_dod&quot; placeholder=&quot;例：&amp;#10;- 更新版資料3ファイル&amp;#10;- レビュー依頼まで&amp;#10;が完了条件と理解&quot; style=&quot;min-height:45px&quot;></textarea></div>
    <div><label>⏰ 納期の認識</label><input type=&quot;text&quot; id=&quot;k_cf_due&quot; placeholder=&quot;例：来週金曜17時まで&quot;></div>
  </div>
  <div><label>❓ 確認したい点（曖昧な箇所）</label><textarea id=&quot;k_cf_questions&quot; placeholder=&quot;例：&amp;#10;- Q：更新対象はVol.3〜5でよいですか？&amp;#10;- Q：演習見直しは難易度調整までですか、新規追加も含みますか？&quot; style=&quot;min-height:50px&quot;></textarea></div>
</div>
</div>

<!-- ===== MODE 6: 進捗報告 ===== -->
<div class=&quot;kmode-block&quot; data-kmode-target=&quot;progress&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📊 進捗報告</div>
  <div class=&quot;row cols3&quot;>
    <div><label>タスク・案件名</label><input type=&quot;text&quot; id=&quot;k_pg_task&quot; placeholder=&quot;例：研修資料リニューアル&quot;></div>
    <div><label>全体進捗</label>
      <select id=&quot;k_pg_percent&quot;>
        <option value=&quot;0%&quot;>0%</option><option value=&quot;10%&quot;>10%</option><option value=&quot;20%&quot;>20%</option>
        <option value=&quot;30%&quot;>30%</option><option value=&quot;40%&quot;>40%</option><option value=&quot;50%&quot; selected>50%</option>
        <option value=&quot;60%&quot;>60%</option><option value=&quot;70%&quot;>70%</option><option value=&quot;80%&quot;>80%</option>
        <option value=&quot;90%&quot;>90%</option><option value=&quot;100%&quot;>100%</option>
      </select>
    </div>
    <div><label>状態信号</label>
      <select id=&quot;k_pg_signal&quot;>
        <option value=&quot;🟢 順調&quot;>🟢 順調</option>
        <option value=&quot;🟡 要注意&quot; selected>🟡 要注意</option>
        <option value=&quot;🔴 赤信号（要支援）&quot;>🔴 赤信号（要支援）</option>
      </select>
    </div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>✅ 完了したこと</label><textarea id=&quot;k_pg_done&quot; placeholder=&quot;例：&amp;#10;- Vol.3の更新完了&amp;#10;- 演習問題の難易度評価完了&quot;></textarea></div>
    <div><label>🔄 進行中・次にやること</label><textarea id=&quot;k_pg_next&quot; placeholder=&quot;例：&amp;#10;- Vol.4-5の更新中&amp;#10;- 来週レビュー依頼予定&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>⚠️ 課題・ブロッカー</label><textarea id=&quot;k_pg_block&quot; placeholder=&quot;例：&amp;#10;- 演習環境の確認が先方回答待ちで止まっている&quot; style=&quot;min-height:45px&quot;></textarea></div>
    <div><label>🙋 支援・判断してほしいこと</label><textarea id=&quot;k_pg_help&quot; placeholder=&quot;例：&amp;#10;- 先方への確認を急いでもらえると助かります&quot; style=&quot;min-height:45px&quot;></textarea></div>
  </div>
</div>
</div>

<!-- ===== MODE 7: 日報 ===== -->
<div class=&quot;kmode-block&quot; data-kmode-target=&quot;daily&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📝 日報</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 事実と所感を分ける：</span>やったこと（事実）と、感じたこと・気づき（所感）を分けて書くと、報告として正確で、自分の振り返りにもなります。</div>
  <div><label>✅ 本日やったこと（事実）</label><textarea id=&quot;k_dl_done&quot; placeholder=&quot;例：&amp;#10;- 研修Day2を実施（受講生12名、欠席0）&amp;#10;- 演習①②を完了&amp;#10;- 修了テストの採点を10名分完了&quot;></textarea></div>
  <div class=&quot;row cols2&quot;>
    <div><label>💭 気づき・所感（主観）</label><textarea id=&quot;k_dl_thoughts&quot; placeholder=&quot;例：&amp;#10;- Cさんが演習で大きく伸びた&amp;#10;- 午後の集中力低下を感じた&quot;></textarea></div>
    <div><label>⚠️ 課題・困りごと</label><textarea id=&quot;k_dl_issues&quot; placeholder=&quot;例：&amp;#10;- 演習②で想定より時間がかかった&amp;#10;- 環境トラブルが1件発生&quot;></textarea></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>📅 明日の予定</label><textarea id=&quot;k_dl_tomorrow&quot; placeholder=&quot;例：&amp;#10;- Day3実施&amp;#10;- 残り採点完了&amp;#10;- 進捗を佐藤リーダーに報告&quot; style=&quot;min-height:45px&quot;></textarea></div>
    <div><label>🙋 共有・相談したいこと</label><textarea id=&quot;k_dl_share&quot; placeholder=&quot;例：&amp;#10;- 演習時間の配分を見直したい&amp;#10;- 環境トラブルの恒久対策を相談したい&quot; style=&quot;min-height:45px&quot;></textarea></div>
  </div>
</div>
</div>

<!-- ===== MODE 8: 報告メモ（PREP） ===== -->
<div class=&quot;kmode-block&quot; data-kmode-target=&quot;prep&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📋 報告メモ（PREP法）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 報告前に必ず記入：</span>PREP法＝Point（結論）→ Reason（根拠）→ Example（経緯・具体）→ Point（今後）。結論から先に言うと、忙しい相手にも一発で伝わります。口頭・書面どちらにも使えます。</div>
  <div class=&quot;row cols3&quot;>
    <div><label>案件名</label><input type=&quot;text&quot; id=&quot;k_pr_project&quot; placeholder=&quot;例：研修資料リニューアル&quot;></div>
    <div><label>報告時間の目安</label>
      <select id=&quot;k_pr_time&quot;><option value=&quot;1分&quot;>1分</option><option value=&quot;3分&quot; selected>3分</option><option value=&quot;5分&quot;>5分</option></select>
    </div>
    <div><label>報告形式</label>
      <select id=&quot;k_pr_format&quot;><option value=&quot;口頭&quot;>口頭</option><option value=&quot;書面&quot;>書面</option><option value=&quot;メール&quot;>メール</option><option value=&quot;チャット&quot;>チャット</option></select>
    </div>
  </div>
  <div class=&quot;row cols3&quot;>
    <div><label>完了度</label>
      <select id=&quot;k_pr_percent&quot;><option value=&quot;0%&quot;>0%</option><option value=&quot;25%&quot;>25%</option><option value=&quot;50%&quot; selected>50%</option><option value=&quot;75%&quot;>75%</option><option value=&quot;100%&quot;>100%</option></select>
    </div>
    <div><label>ステータス</label>
      <select id=&quot;k_pr_status&quot;><option value=&quot;🟢 正常&quot;>🟢 正常</option><option value=&quot;🟡 遅延&quot;>🟡 遅延</option><option value=&quot;🟠 課題あり&quot; selected>🟠 課題あり</option><option value=&quot;✅ 完了&quot;>✅ 完了</option></select>
    </div>
    <div><label>期間</label><input type=&quot;text&quot; id=&quot;k_pr_period&quot; placeholder=&quot;例：6/1〜6/10&quot;></div>
  </div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>本文（PREP構造）</div>
  <div><label>📝 仕事内容（何をやっていたか・具体的に）</label><textarea id=&quot;k_pr_work&quot; placeholder=&quot;例：&amp;#10;LPIC-2研修資料Vol.3〜5の更新作業&quot; style=&quot;min-height:45px&quot;></textarea></div>
  <div class=&quot;row cols2&quot;>
    <div><label>🎯 P：結論（一言で言うと何か・結論から先に）</label><textarea id=&quot;k_pr_point&quot; placeholder=&quot;例：&amp;#10;Vol.3は完了、Vol.4-5は予定通り進行中です&quot;></textarea></div>
    <div><label>📊 R：結論の根拠（なぜその結論か・データ・事実）</label><textarea id=&quot;k_pr_reason&quot; placeholder=&quot;例：&amp;#10;- Vol.3は更新＋レビュー済み&amp;#10;- Vol.4-5は7割完了、残りは演習問題のみ&quot;></textarea></div>
  </div>
  <div><label>📜 E：経緯・背景（どういう経緯で・いつから・誰が関係）</label><textarea id=&quot;k_pr_example&quot; placeholder=&quot;例：&amp;#10;- 受講生フィードバックを起点に5/20から着手&amp;#10;- リーダーと難易度方針を合意済み&quot; style=&quot;min-height:50px&quot;></textarea></div>
  <div><label>🚀 今後の展開・依頼事項（次のP）</label><textarea id=&quot;k_pr_future&quot; placeholder=&quot;例：&amp;#10;- 6/10までに全Vol完了予定&amp;#10;- 演習環境の確認だけお願いしたいです&quot; style=&quot;min-height:50px&quot;></textarea></div>
</div>
</div>

<!-- ===== MODE 9: 時間別報告 ===== -->
<div class=&quot;kmode-block&quot; data-kmode-target=&quot;timed&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>⏱ 時間別報告（伝える内容を絞り込む）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 時間に合わせて絞る：</span>持ち時間で「何をどこまで伝えるか」が変わります。1分=結論だけ / 3分=結論＋根拠＋経緯 / 5分=詳細まで。下で時間を選ぶと、出力に必要な項目だけが含まれます。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>案件名</label><input type=&quot;text&quot; id=&quot;k_tm_project&quot; placeholder=&quot;例：研修資料リニューアル&quot;></div>
    <div><label>持ち時間</label>
      <select id=&quot;k_tm_time&quot;>
        <option value=&quot;1&quot;>⏱ 1分報告（口頭のみ）</option>
        <option value=&quot;3&quot; selected>⏱ 3分報告（口頭＋筆記メモ）</option>
        <option value=&quot;5&quot;>⏱ 5分報告（口頭＋書面・報告書）</option>
      </select>
    </div>
  </div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>報告内容</div>
  <div><label>① 結論（一言）<span style=&quot;color:var(--brand-green-deep)&quot;>　【1分〜】</span></label><textarea id=&quot;k_tm_conclusion&quot; placeholder=&quot;例：研修資料の更新、予定通り進行中です&quot; style=&quot;min-height:42px&quot;></textarea></div>
  <div class=&quot;row cols2&quot;>
    <div><label>② 完了度・ステータス<span style=&quot;color:var(--brand-green-deep)&quot;>　【1分〜】</span></label><input type=&quot;text&quot; id=&quot;k_tm_status&quot; placeholder=&quot;例：70% / 🟢正常&quot;></div>
    <div><label>③ 次のアクション<span style=&quot;color:var(--brand-green-deep)&quot;>　【1分〜】</span></label><input type=&quot;text&quot; id=&quot;k_tm_next&quot; placeholder=&quot;例：来週レビュー依頼&quot;></div>
  </div>
  <div><label>④ 根拠・事実<span style=&quot;color:var(--brand-yellow-deep)&quot;>　【3分〜】</span></label><textarea id=&quot;k_tm_reason&quot; placeholder=&quot;例：&amp;#10;- Vol.3完了、Vol.4-5は7割&amp;#10;- 受講生フィードバック反映済み&quot; style=&quot;min-height:42px&quot;></textarea></div>
  <div><label>⑤ 経緯（簡潔に）<span style=&quot;color:var(--brand-yellow-deep)&quot;>　【3分〜】</span></label><textarea id=&quot;k_tm_history&quot; placeholder=&quot;例：5/20から着手、難易度方針はリーダーと合意済み&quot; style=&quot;min-height:38px&quot;></textarea></div>
  <div><label>⑥ 仕事内容の詳細<span style=&quot;color:#C8553D&quot;>　【5分のみ】</span></label><textarea id=&quot;k_tm_detail&quot; placeholder=&quot;例：&amp;#10;- 各Volの更新箇所・変更理由&amp;#10;- 演習問題の難易度調整の具体内容&quot; style=&quot;min-height:42px&quot;></textarea></div>
  <div><label>⑦ 今後の展開・依頼事項<span style=&quot;color:#C8553D&quot;>　【5分のみ】</span></label><textarea id=&quot;k_tm_future&quot; placeholder=&quot;例：&amp;#10;- 6/10全完了予定&amp;#10;- 演習環境の確認をお願いしたい&quot; style=&quot;min-height:42px&quot;></textarea></div>
</div>
</div>

<!-- ===== MODE 10: 会議アジェンダ ===== -->
<div class=&quot;kmode-block&quot; data-kmode-target=&quot;agenda2&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📅 会議アジェンダ（会議前に配る進行表）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 会議の前に配る：</span>議事録は会議「後」、アジェンダは会議「前」。事前に目的・ゴール・議題ごとの時間を共有すると、会議が締まり、参加者が準備できます。</div>
  <div class=&quot;row cols3&quot;>
    <div><label>会議名</label><input type=&quot;text&quot; id=&quot;k_ag_title&quot; placeholder=&quot;例：週次定例 / 研修振り返り&quot;></div>
    <div><label>日時</label><input type=&quot;text&quot; id=&quot;k_ag_time&quot; placeholder=&quot;例：6/5（金）15:00-16:00&quot;></div>
    <div><label>場所・形式</label><input type=&quot;text&quot; id=&quot;k_ag_place&quot; placeholder=&quot;例：会議室A / Zoom&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>出席者</label><input type=&quot;text&quot; id=&quot;k_ag_attendees&quot; placeholder=&quot;例：自分、リーダー、メンバー3名&quot;></div>
    <div><label>事前準備のお願い</label><input type=&quot;text&quot; id=&quot;k_ag_prep&quot; placeholder=&quot;例：各自、担当タスクの進捗を確認しておく&quot;></div>
  </div>
  <div><label>🎯 この会議のゴール（終了時に何が決まっていればOKか）</label><input type=&quot;text&quot; id=&quot;k_ag_goal&quot; placeholder=&quot;例：リリース日程の確定と残課題の担当決め&quot;></div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>議題（時間配分付き）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 各議題に「分」と「ゴール」を：</span>所要分を入れると合計時間を自動計算。「議論する」だけでなく「何を決めるか」を書くと脱線しません。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;k_ag_add&quot;>＋ 議題を追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;k_ag_clear&quot;>🗑 クリア</button>
  </div>
  <div id=&quot;k_ag_items&quot;></div>
</div>
</div>

<!-- ===== MODE 11: カイゼンMTG ===== -->
<div class=&quot;kmode-block&quot; data-kmode-target=&quot;kaizen&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🔧 カイゼンMTG（継続的改善）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 個人を責めず仕組みを直す：</span>問題 → なぜなぜ分析（5回） → 改善策 → 担当・期限。人ではなくプロセスに原因を求めるのがカイゼンの基本です。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>テーマ・対象</label><input type=&quot;text&quot; id=&quot;k_kz_theme&quot; placeholder=&quot;例：研修演習で時間オーバーが頻発する問題&quot;></div>
    <div><label>参加者</label><input type=&quot;text&quot; id=&quot;k_kz_members&quot; placeholder=&quot;例：講師チーム3名&quot;></div>
  </div>
  <div><label>🔍 問題・現状（事実ベース）</label><textarea id=&quot;k_kz_problem&quot; placeholder=&quot;例：&amp;#10;- 演習②が毎回15分オーバーする&amp;#10;- 結果、まとめの時間が削られている&quot;></textarea></div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>なぜなぜ分析（5回繰り返す）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 なぜを掘る：</span>表面の原因で止めず「なぜ？」を繰り返して真因にたどり着く。空欄でもOK（たどり着いた所まで）。</div>
  <div><label>なぜ①</label><input type=&quot;text&quot; id=&quot;k_kz_why1&quot; placeholder=&quot;例：演習の手順が多く、説明に時間がかかる&quot;></div>
  <div><label>なぜ②</label><input type=&quot;text&quot; id=&quot;k_kz_why2&quot; placeholder=&quot;例：手順書が文字ばかりで読むのに時間がかかる&quot;></div>
  <div><label>なぜ③</label><input type=&quot;text&quot; id=&quot;k_kz_why3&quot; placeholder=&quot;例：図解を作る時間がなかった&quot;></div>
  <div><label>なぜ④</label><input type=&quot;text&quot; id=&quot;k_kz_why4&quot; placeholder=&quot;例：資料作成の工数見積もりが甘かった&quot;></div>
  <div><label>なぜ⑤（真因）</label><input type=&quot;text&quot; id=&quot;k_kz_why5&quot; placeholder=&quot;例：演習設計のテンプレートがなく毎回ゼロから作っている&quot;></div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>改善策とアクション</div>
  <div class=&quot;row cols2&quot;>
    <div><label>💡 改善策（真因に対する打ち手）</label><textarea id=&quot;k_kz_solution&quot; placeholder=&quot;例：&amp;#10;- 演習設計テンプレートを作成&amp;#10;- 手順書を図解中心に刷新&quot;></textarea></div>
    <div><label>📊 効果測定（どうなれば成功か）</label><textarea id=&quot;k_kz_metric&quot; placeholder=&quot;例：&amp;#10;- 演習②の所要時間が予定内に収まる&amp;#10;- まとめ時間が確保できる&quot;></textarea></div>
  </div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;k_kz_addaction&quot;>＋ アクションを追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;k_kz_clearaction&quot;>🗑 クリア</button>
  </div>
  <div id=&quot;k_kz_actions&quot;></div>
</div>
</div>

<!-- ===== MODE 12: FB会 ===== -->
<div class=&quot;kmode-block&quot; data-kmode-target=&quot;fb&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>💬 フィードバック面談（FB会）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 Good/Moreで建設的に：</span>「ダメ出し」ではなく「良かった点（Good）」と「もっと良くなる点（More）」。先にGoodで安心させてからMoreを伝えると受け止めやすい。本人の振り返りも引き出します。</div>
  <div class=&quot;row cols3&quot;>
    <div><label>フィードバックする人</label><input type=&quot;text&quot; id=&quot;k_fb_giver&quot; placeholder=&quot;例：自分（メンター）&quot;></div>
    <div><label>受ける人</label><input type=&quot;text&quot; id=&quot;k_fb_receiver&quot; placeholder=&quot;例：新人 田中さん&quot;></div>
    <div><label>対象期間・案件</label><input type=&quot;text&quot; id=&quot;k_fb_target&quot; placeholder=&quot;例：5月の研修サポート業務&quot;></div>
  </div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>① 本人の振り返り（先に聞く）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 まず本人から：</span>いきなり評価せず、本人の自己評価を先に聞くと対話になります。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>本人が「できた」と思うこと</label><textarea id=&quot;k_fb_self_good&quot; placeholder=&quot;例：&amp;#10;- 受講生への声かけが自然にできた&amp;#10;- 環境トラブルに落ち着いて対応できた&quot;></textarea></div>
    <div><label>本人が「課題」と思うこと</label><textarea id=&quot;k_fb_self_issue&quot; placeholder=&quot;例：&amp;#10;- 質問への回答に時間がかかった&amp;#10;- 全体を見る余裕がなかった&quot;></textarea></div>
  </div>
</div>
<div class=&quot;card&quot; style=&quot;border-color:var(--brand-green-deep);background:linear-gradient(180deg,rgba(168,213,186,.18),transparent)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot; style=&quot;background:var(--brand-green-deep)&quot;></span>② 👍 Good（良かった点・具体的に）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>必ず先に・具体的に：</span>「頑張ってた」ではなく「〇〇の場面で〇〇ができていた」と事実で。</div>
  <textarea id=&quot;k_fb_good&quot; placeholder=&quot;例：&amp;#10;- Aさんが詰まったとき、答えを言わずヒントで導いていた（メンターとして理想的）&amp;#10;- 環境トラブル時、受講生を不安にさせない声かけができていた&amp;#10;- 報連相のタイミングが適切だった&quot; style=&quot;min-height:70px&quot;></textarea>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>③ 🌱 More（もっと良くなる点・改善提案）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>人格でなく行動に：</span>「あなたは〜」ではなく「〇〇の行動を〇〇すると、もっと良くなる」。改善の方向を一緒に示す。</div>
  <textarea id=&quot;k_fb_more&quot; placeholder=&quot;例：&amp;#10;- 質問対応で抱え込みがちなので、5分悩んだら一旦保留にして全体を見る習慣をつけると、より多くの受講生をフォローできる&amp;#10;- 自分の判断に自信を持ってOK。確認の頻度を少し減らしても大丈夫&quot; style=&quot;min-height:70px&quot;></textarea>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>④ 次の目標・アクション（合意して決める）</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🎯 次に向けた目標（本人と合意）</label><textarea id=&quot;k_fb_goal&quot; placeholder=&quot;例：&amp;#10;- 次回研修で『全体を見る』を意識する&amp;#10;- 質問対応の時間管理を試す&quot; style=&quot;min-height:50px&quot;></textarea></div>
    <div><label>🤝 メンターからのサポート約束</label><textarea id=&quot;k_fb_support&quot; placeholder=&quot;例：&amp;#10;- 次回は中盤で一度声をかけて全体状況を一緒に確認する&amp;#10;- 判断に迷ったらいつでも相談OK&quot; style=&quot;min-height:50px&quot;></textarea></div>
  </div>
  <div><label>💌 締めのひとこと（励まし）</label><input type=&quot;text&quot; id=&quot;k_fb_message&quot; placeholder=&quot;例：この1ヶ月の成長は本当に大きいです。自信を持って次に進みましょう&quot;></div>
</div>
</div>

<button class=&quot;btn-gen&quot; id=&quot;k_gen-btn&quot;>📋 現場コミュ用マークダウンを生成する</button>

<div class=&quot;card&quot; id=&quot;k_output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（現場コミュニケーション）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;k_copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;k_dl-btn&quot; data-out=&quot;k_output&quot; data-prefix=&quot;現場コミュ&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;k_output&quot;></div>
</div>

</div><!-- /panel-comm -->

<!-- =========================================== -->
<!-- ======== TAB 12: 育成＆社内SE =============== -->
<!-- =========================================== -->
<div class=&quot;panel&quot; id=&quot;panel-grow&quot;>

<div class=&quot;card card-tight&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>ISO文書管理情報</div>
  <div class=&quot;row cols4&quot;>
    <div><label>文書番号</label><input type=&quot;text&quot; id=&quot;g_docno&quot; placeholder=&quot;例：EDU-2026-0001&quot;></div>
    <div><label>版数</label><input type=&quot;text&quot; id=&quot;g_rev&quot; placeholder=&quot;例：Rev.1.0&quot; value=&quot;Rev.1.0&quot;></div>
    <div><label>機密区分</label>
      <select id=&quot;g_conf&quot;>
        <option value=&quot;公開&quot;>公開</option>
        <option value=&quot;社内限&quot; selected>社内限</option>
        <option value=&quot;社外秘&quot;>社外秘</option>
      </select>
    </div>
    <div><label>関連文書</label><input type=&quot;text&quot; id=&quot;g_relate&quot; placeholder=&quot;例：育成方針書 / 業務規程&quot;></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>モード選択</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 3つの視点：</span>メンターが育成を設計する側／メンティーが成長を記録する側／社内SEがISO準拠で業務を記録する側。同じ育成でも立場で書くことが変わります。</div>
  <div class=&quot;pattern-grid&quot; id=&quot;growmode-group&quot;>
    <div class=&quot;pattern-card&quot; data-gmode=&quot;mentor&quot;>
      <div class=&quot;pc-key&quot;>MODE 1</div>
      <div class=&quot;pc-title&quot;>👩‍🏫 メンター：育成計画</div>
      <div class=&quot;pc-desc&quot;>現状→目標→育成ステップ→支援を設計する側。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-gmode=&quot;mentee&quot;>
      <div class=&quot;pc-key&quot;>MODE 2</div>
      <div class=&quot;pc-title&quot;>🌱 メンティー：成長記録</div>
      <div class=&quot;pc-desc&quot;>学び→できたこと→次の目標→相談を記録する側。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-gmode=&quot;se&quot;>
      <div class=&quot;pc-key&quot;>MODE 3</div>
      <div class=&quot;pc-title&quot;>🏢 社内SE：ISO式業務記録</div>
      <div class=&quot;pc-desc&quot;>ISO 9001/27001準拠の業務手順・変更管理。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-gmode=&quot;delegate&quot;>
      <div class=&quot;pc-key&quot;>MODE 4</div>
      <div class=&quot;pc-title&quot;>📤 業務移譲＆フォロー設計</div>
      <div class=&quot;pc-desc&quot;>誰に何を・なぜ渡すか＋納得確認＋フォロー要否。</div>
    </div>
  </div>
</div>

<!-- ===== MODE 1: メンター育成計画 ===== -->
<div class=&quot;gmode-block&quot; data-gmode-target=&quot;mentor&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>👩‍🏫 育成対象・基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>メンター（自分）</label><input type=&quot;text&quot; id=&quot;g_mt_mentor&quot; placeholder=&quot;例：山田花子&quot;></div>
    <div><label>メンティー（育成対象）</label><input type=&quot;text&quot; id=&quot;g_mt_mentee&quot; placeholder=&quot;例：新人 田中さん&quot;></div>
    <div><label>育成期間</label><input type=&quot;text&quot; id=&quot;g_mt_period&quot; placeholder=&quot;例：2026年6月〜8月（3ヶ月）&quot;></div>
  </div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>① 現状把握（3信号で評価）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 現在地を正確に：</span>🟢自立 / 🟡補助要 / 🔴要指導 で現状を評価し、「事実」と「所感」を分けて書く。</div>
  <div class=&quot;row cols3&quot;>
    <div><label>📝 知識・基礎（筆記）</label>
      <select id=&quot;g_mt_skill_w&quot;><option value=&quot;🟢 自立&quot;>🟢 自立</option><option value=&quot;🟡 補助要&quot; selected>🟡 補助要</option><option value=&quot;🔴 要指導&quot;>🔴 要指導</option></select>
    </div>
    <div><label>🛠 実務・実装（実技）</label>
      <select id=&quot;g_mt_skill_p&quot;><option value=&quot;🟢 自立&quot;>🟢 自立</option><option value=&quot;🟡 補助要&quot;>🟡 補助要</option><option value=&quot;🔴 要指導&quot; selected>🔴 要指導</option></select>
    </div>
    <div><label>🗣 説明・報連相（口頭）</label>
      <select id=&quot;g_mt_skill_o&quot;><option value=&quot;🟢 自立&quot;>🟢 自立</option><option value=&quot;🟡 補助要&quot; selected>🟡 補助要</option><option value=&quot;🔴 要指導&quot;>🔴 要指導</option></select>
    </div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>👀 現状の事実（観察できたこと）</label><textarea id=&quot;g_mt_fact&quot; placeholder=&quot;例：&amp;#10;- 基本コマンドは習得済み&amp;#10;- エラー時に自力で調べる前に質問する傾向&quot;></textarea></div>
    <div><label>💭 所感（推測・育成方針の仮説）</label><textarea id=&quot;g_mt_impression&quot; placeholder=&quot;例：&amp;#10;- 自信のなさが質問の早さに出ている可能性&amp;#10;- 成功体験を積めば自走できそう&quot;></textarea></div>
  </div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>② 育成ゴール（期間後の姿）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 行動動詞で：</span>「理解する」でなく「〇〇できる」。Lv.1=確認/Lv.3=業務文脈で説明/Lv.5=応用・障害対応 の到達レベルも意識。</div>
  <div><label>🎯 育成ゴール（行動レベルで）</label><textarea id=&quot;g_mt_goal&quot; placeholder=&quot;例：&amp;#10;- エラーメッセージを読んで自力で30分は粘れる（Lv.3）&amp;#10;- 簡単なシェルスクリプトを業務文脈で書ける（Lv.3）&amp;#10;- 後輩に基本コマンドを教えられる（Lv.5）&quot;></textarea></div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>③ 育成ステップ（マイルストーン）</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;g_mt_addstep&quot;>＋ ステップを追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;g_mt_clearstep&quot;>🗑 クリア</button>
  </div>
  <div id=&quot;g_mt_steps&quot;></div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>④ 支援設計・関わり方</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🤝 メンターの関わり方（頻度・方法）</label><textarea id=&quot;g_mt_support&quot; placeholder=&quot;例：&amp;#10;- 週1の1on1（30分）&amp;#10;- 詰まったら30分ルールで声かけ&amp;#10;- 答えでなくヒントを出す&quot; style=&quot;min-height:50px&quot;></textarea></div>
    <div><label>⚠️ 気を付けること（落とし穴）</label><textarea id=&quot;g_mt_caution&quot; placeholder=&quot;例：&amp;#10;- 過干渉で自走の芽を摘まない&amp;#10;- できていない事実を人格否定にしない&quot; style=&quot;min-height:50px&quot;></textarea></div>
  </div>
</div>
</div>

<!-- ===== MODE 2: メンティー成長記録 ===== -->
<div class=&quot;gmode-block&quot; data-gmode-target=&quot;mentee&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🌱 基本情報</div>
  <div class=&quot;row cols3&quot;>
    <div><label>記入者（自分）</label><input type=&quot;text&quot; id=&quot;g_me_self&quot; placeholder=&quot;例：田中&quot;></div>
    <div><label>メンター</label><input type=&quot;text&quot; id=&quot;g_me_mentor&quot; placeholder=&quot;例：山田さん&quot;></div>
    <div><label>記録対象期間</label><input type=&quot;text&quot; id=&quot;g_me_period&quot; placeholder=&quot;例：6月第1週&quot;></div>
  </div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>① 学んだこと・できるようになったこと</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 成長を言葉に：</span>小さな「できた」を記録すると自信になります。事実で書きましょう。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>📚 今週学んだこと（知識・気づき）</label><textarea id=&quot;g_me_learned&quot; placeholder=&quot;例：&amp;#10;- grepの-rオプションで再帰検索できる&amp;#10;- エラーは最初の1行を読むのが大事&quot;></textarea></div>
    <div><label>✅ できるようになったこと</label><textarea id=&quot;g_me_can&quot; placeholder=&quot;例：&amp;#10;- ログから該当行を自力で探せた&amp;#10;- 簡単なパイプ処理が書けた&quot;></textarea></div>
  </div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>② つまずき・課題</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🤔 つまずいたこと・難しかったこと</label><textarea id=&quot;g_me_stuck&quot; placeholder=&quot;例：&amp;#10;- 正規表現が複雑になると分からなくなる&amp;#10;- エラーの原因切り分けに時間がかかる&quot; style=&quot;min-height:50px&quot;></textarea></div>
    <div><label>💡 どう乗り越えた／乗り越えたいか</label><textarea id=&quot;g_me_overcome&quot; placeholder=&quot;例：&amp;#10;- 公式ドキュメントを見る習慣をつけたい&amp;#10;- 30分粘ってから質問するようにした&quot; style=&quot;min-height:50px&quot;></textarea></div>
  </div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>③ 次の目標・相談</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🎯 次の目標（小さくてOK）</label><textarea id=&quot;g_me_next&quot; placeholder=&quot;例：&amp;#10;- シェルスクリプトを1本自力で書く&amp;#10;- エラーを自力で30分は調べる&quot; style=&quot;min-height:50px&quot;></textarea></div>
    <div><label>🙋 メンターに相談したいこと</label><textarea id=&quot;g_me_consult&quot; placeholder=&quot;例：&amp;#10;- 正規表現の良い練習方法&amp;#10;- 質問のタイミングはこれで合っているか&quot; style=&quot;min-height:50px&quot;></textarea></div>
  </div>
  <div><label>😊 今の気持ち・モチベーション（任意）</label><input type=&quot;text&quot; id=&quot;g_me_mood&quot; placeholder=&quot;例：少しずつ自信がついてきた。次も頑張りたい&quot;></div>
</div>
</div>

<!-- ===== MODE 3: 社内SE ISO式業務記録 ===== -->
<div class=&quot;gmode-block&quot; data-gmode-target=&quot;se&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>🏢 ISO準拠 業務記録 基本情報</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 ISO式：</span>ISO 9001（品質）/ ISO/IEC 27001（情報セキュリティ）準拠の業務記録。トレーサビリティ（誰が・いつ・何を・なぜ）を残します。</div>
  <div class=&quot;row cols3&quot;>
    <div><label>業務種別</label>
      <select id=&quot;g_se_type&quot;>
        <option value=&quot;変更管理&quot;>変更管理（Change）</option>
        <option value=&quot;インシデント対応&quot;>インシデント対応</option>
        <option value=&quot;定常運用&quot;>定常運用</option>
        <option value=&quot;リリース&quot;>リリース</option>
        <option value=&quot;アクセス権限管理&quot;>アクセス権限管理</option>
        <option value=&quot;内部監査対応&quot;>内部監査対応</option>
      </select>
    </div>
    <div><label>担当者</label><input type=&quot;text&quot; id=&quot;g_se_author&quot; placeholder=&quot;例：山田花子&quot;></div>
    <div><label>承認者</label><input type=&quot;text&quot; id=&quot;g_se_approver&quot; placeholder=&quot;例：情報システム部長&quot;></div>
  </div>
  <div class=&quot;row cols3&quot;>
    <div><label>対象システム</label><input type=&quot;text&quot; id=&quot;g_se_system&quot; placeholder=&quot;例：人事システム / 社内ポータル&quot;></div>
    <div><label>実施日</label><input type=&quot;date&quot; id=&quot;g_se_date&quot;></div>
    <div><label>リスクレベル</label>
      <select id=&quot;g_se_risk&quot;><option value=&quot;🔴 高&quot;>🔴 高</option><option value=&quot;🟡 中&quot; selected>🟡 中</option><option value=&quot;🟢 低&quot;>🟢 低</option></select>
    </div>
  </div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>① 目的・背景（なぜ実施するか）</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🎯 目的・要求事項（ISO 9001：顧客/業務要求）</label><textarea id=&quot;g_se_purpose&quot; placeholder=&quot;例：&amp;#10;- 退職者のアカウント無効化（セキュリティ要件）&amp;#10;- 監査指摘事項への対応&quot;></textarea></div>
    <div><label>📋 背景・トリガー</label><textarea id=&quot;g_se_background&quot; placeholder=&quot;例：&amp;#10;- 人事から退職連絡（6/1付）&amp;#10;- 月次アクセス権棚卸しで検出&quot;></textarea></div>
  </div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>② 実施手順（トレーサビリティ確保）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 主語＋動詞で：</span>誰が何をするか明確に。各手順は監査で追跡可能なように具体的に。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;g_se_addstep&quot;>＋ 手順を追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;g_se_clearstep&quot;>🗑 クリア</button>
  </div>
  <div id=&quot;g_se_steps&quot;></div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>③ リスク・影響・セキュリティ（ISO 27001）</div>
  <div class=&quot;row cols2&quot;>
    <div><label>⚠️ 想定リスク・影響範囲</label><textarea id=&quot;g_se_risk_detail&quot; placeholder=&quot;例：&amp;#10;- 誤って現役社員のアカウントを無効化するリスク&amp;#10;- 影響：該当者の業務停止&quot;></textarea></div>
    <div><label>🔒 セキュリティ・コンプライアンス確認</label><textarea id=&quot;g_se_security&quot; placeholder=&quot;例：&amp;#10;- 個人情報の取扱いは規程に準拠&amp;#10;- 操作ログを取得・保管&amp;#10;- 最小権限の原則を遵守&quot;></textarea></div>
  </div>
  <div><label>🔁 ロールバック手順（問題発生時）</label><textarea id=&quot;g_se_rollback&quot; placeholder=&quot;例：&amp;#10;1. 無効化前のアカウント状態をバックアップから復元&amp;#10;2. 影響者に連絡&amp;#10;3. 原因調査・再発防止&quot; style=&quot;min-height:50px&quot;></textarea></div>
</div>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>④ 完了確認・記録</div>
  <div class=&quot;row cols2&quot;>
    <div><label>✅ 完了条件・検証結果</label><textarea id=&quot;g_se_verify&quot; placeholder=&quot;例：&amp;#10;- 対象アカウントの無効化を確認&amp;#10;- ログイン不可を検証済み&amp;#10;- 操作ログを証跡として保管&quot; style=&quot;min-height:50px&quot;></textarea></div>
    <div><label>📊 是正・予防処置（再発防止）</label><textarea id=&quot;g_se_capa&quot; placeholder=&quot;例：&amp;#10;- 退職連絡から無効化までのSLAを設定&amp;#10;- 自動連携の仕組みを次期検討&quot; style=&quot;min-height:50px&quot;></textarea></div>
  </div>
</div>
</div>

<!-- ===== MODE 4: 業務移譲＆フォロー設計 ===== -->
<div class=&quot;gmode-block&quot; data-gmode-target=&quot;delegate&quot; style=&quot;display:none&quot;>
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📤 業務移譲 基本情報</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 渡し方が育成を決める：</span>仕事は「丸投げ」でも「抱え込み」でもなく、<strong>なぜ渡すか（理由）を添えて納得して動いてもらう</strong>のが理想。そしてフォローが要るか要らないかを最初に見極めます。</div>
  <div class=&quot;row cols3&quot;>
    <div><label>渡す人（メンター・自分）</label><input type=&quot;text&quot; id=&quot;g_dl_giver&quot; placeholder=&quot;例：山田花子&quot;></div>
    <div><label>渡す相手（誰に）</label><input type=&quot;text&quot; id=&quot;g_dl_to&quot; placeholder=&quot;例：新人 田中さん&quot;></div>
    <div><label>移譲日</label><input type=&quot;date&quot; id=&quot;g_dl_date&quot;></div>
  </div>
  <div><label>📋 渡す仕事（タスク名・内容）</label><input type=&quot;text&quot; id=&quot;g_dl_task&quot; placeholder=&quot;例：研修Day3の演習サポート担当&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>① なぜこの人に渡すのか（理由・期待）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 「あなたにお願いする理由」を言葉に：</span>誰でもいい仕事ではなく「あなただから」を伝えると、納得感とモチベーションが上がります。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🎯 なぜこの人に任せるのか（選んだ理由）</label><textarea id=&quot;g_dl_why&quot; placeholder=&quot;例：&amp;#10;- 受講生への声かけが自然で適任&amp;#10;- この経験が次の単独講師への足がかりになる&quot;></textarea></div>
    <div><label>🌱 この仕事で得てほしい成長・経験</label><textarea id=&quot;g_dl_growth&quot; placeholder=&quot;例：&amp;#10;- 複数受講生を同時に見る視野&amp;#10;- その場で判断する経験&quot;></textarea></div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>② 何の情報を渡すか（情報＋理由をセットで）</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 情報には必ず「なぜ」を：</span>「これをして」だけでなく「なぜそれが必要か」を渡すと、相手が自分で判断できるようになります。各情報に理由を添えて登録します。</div>
  <div style=&quot;display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap&quot;>
    <button class=&quot;btn-mini&quot; id=&quot;g_dl_addinfo&quot;>＋ 渡す情報を追加</button>
    <button class=&quot;btn-mini&quot; id=&quot;g_dl_clearinfo&quot;>🗑 クリア</button>
  </div>
  <div id=&quot;g_dl_infos&quot;></div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>③ ゴールと任せる範囲</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🎯 ゴール（どうなれば完了か）</label><textarea id=&quot;g_dl_goal&quot; placeholder=&quot;例：&amp;#10;- 演習②を時間内に全員が完了&amp;#10;- つまずいた人を拾えている&quot; style=&quot;min-height:50px&quot;></textarea></div>
    <div><label>🤲 任せる範囲・判断してよいこと</label><textarea id=&quot;g_dl_scope&quot; placeholder=&quot;例：&amp;#10;- 進め方は任せる&amp;#10;- ヒントの出し方は自由&amp;#10;- 環境トラブルは即相談&quot; style=&quot;min-height:50px&quot;></textarea></div>
  </div>
</div>

<div class=&quot;card&quot; style=&quot;border-color:var(--brand-green-deep);background:linear-gradient(180deg,rgba(168,213,186,.18),transparent)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot; style=&quot;background:var(--brand-green-deep)&quot;></span>④ 納得確認（渡しっぱなしにしない）</div>
  <div class=&quot;hint warn&quot;><span class=&quot;ttl&quot;>🐰 「分かった？」で終わらせない：</span>相手が本当に納得して受け取れたかを確認。理解度と納得度を分けて記録します。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🤝 相手の理解度（受け取り方）</label>
      <select id=&quot;g_dl_understand&quot;>
        <option value=&quot;🟢 十分理解・自信あり&quot;>🟢 十分理解・自信あり</option>
        <option value=&quot;🟡 おおむね理解・やや不安&quot; selected>🟡 おおむね理解・やや不安</option>
        <option value=&quot;🔴 理解不十分・要フォロー&quot;>🔴 理解不十分・要フォロー</option>
      </select>
    </div>
    <div><label>💚 相手の納得度（やる気・腹落ち）</label>
      <select id=&quot;g_dl_agree&quot;>
        <option value=&quot;🟢 前向き・納得して受領&quot;>🟢 前向き・納得して受領</option>
        <option value=&quot;🟡 受領したが不安あり&quot; selected>🟡 受領したが不安あり</option>
        <option value=&quot;🔴 納得していない様子&quot;>🔴 納得していない様子</option>
      </select>
    </div>
  </div>
  <div><label>💬 相手からの反応・質問・懸念</label><textarea id=&quot;g_dl_response&quot; placeholder=&quot;例：&amp;#10;- 『複数人を同時に見られるか不安』との声&amp;#10;- 『環境トラブル時はどうすれば？』と質問あり&quot; style=&quot;min-height:50px&quot;></textarea></div>
  <div><label>📝 それに対して渡した補足・回答</label><textarea id=&quot;g_dl_reply&quot; placeholder=&quot;例：&amp;#10;- トラブル時は私がすぐ入ると伝えて安心してもらった&amp;#10;- 最初は2人だけ重点的に見ればOKと範囲を絞った&quot; style=&quot;min-height:50px&quot;></textarea></div>
</div>

<div class=&quot;card&quot; style=&quot;border-color:var(--brand-yellow-deep);background:linear-gradient(180deg,rgba(245,230,168,.22),transparent)&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot; style=&quot;background:var(--brand-yellow-deep)&quot;></span>⑤ フォロー要否の判断</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 フォローの要否を最初に決める：</span>理解度・納得度・タスクのリスクから、どれくらい伴走するかを設計。放置も過干渉も避けます。</div>
  <div class=&quot;row cols2&quot;>
    <div><label>🚦 フォロー方針</label>
      <select id=&quot;g_dl_follow&quot;>
        <option value=&quot;🟢 任せきり（フォロー不要・完了時のみ確認）&quot;>🟢 任せきり（完了時のみ確認）</option>
        <option value=&quot;🟡 軽めフォロー（要所でチェック）&quot; selected>🟡 軽めフォロー（要所でチェック）</option>
        <option value=&quot;🔴 密着フォロー（伴走・こまめに確認）&quot;>🔴 密着フォロー（伴走）</option>
      </select>
    </div>
    <div><label>⏰ フォローのタイミング・頻度</label><input type=&quot;text&quot; id=&quot;g_dl_follow_when&quot; placeholder=&quot;例：演習開始10分後に一度様子を見る / 中盤と終盤&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>👀 どこを見るか（観察ポイント）</label><textarea id=&quot;g_dl_watch&quot; placeholder=&quot;例：&amp;#10;- 受講生を放置していないか&amp;#10;- 自分が抱え込んでいないか&quot; style=&quot;min-height:45px&quot;></textarea></div>
    <div><label>🆘 こうなったら介入する（介入トリガー）</label><textarea id=&quot;g_dl_trigger&quot; placeholder=&quot;例：&amp;#10;- 1人に5分以上つきっきりになったら&amp;#10;- 環境トラブルが起きたら即&quot; style=&quot;min-height:45px&quot;></textarea></div>
  </div>
  <div><label>🤝 完了後の振り返り予定</label><input type=&quot;text&quot; id=&quot;g_dl_retro&quot; placeholder=&quot;例：研修後に5分、Good/Moreで振り返る（FB会へ連携）&quot;></div>
</div>

</div><!-- /MODE 4 -->

<button class=&quot;btn-gen&quot; id=&quot;g_gen-btn&quot;>🎓 育成＆社内SE用マークダウンを生成する</button>

<div class=&quot;card&quot; id=&quot;g_output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（育成＆社内SE）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;g_copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;g_dl-btn&quot; data-out=&quot;g_output&quot; data-prefix=&quot;育成社内SE&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;g_output&quot;></div>
</div>

</div><!-- /panel-grow -->

<div class=&quot;panel&quot; id=&quot;panel-readme&quot;>

<!-- ===== モード選択 ===== -->
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>モード選択</div>
  <div class=&quot;hint&quot;><span class=&quot;ttl&quot;>🐰 README風：</span>WHY→WHAT→HOW の順で「なぜ作ったか → 何ができるか → どう使うか」を1枚にまとめます。配布物・教材・プロジェクトのどれにも使えます。</div>
  <div class=&quot;pattern-grid&quot; id=&quot;rmode-group&quot;>
    <div class=&quot;pattern-card active&quot; data-rmode=&quot;tool&quot;>
      <div class=&quot;pc-key&quot;>MODE 1</div>
      <div class=&quot;pc-title&quot;>🛠 ツール用README</div>
      <div class=&quot;pc-desc&quot;>配布するツール・スクリプト向け。概要→機能→使い方→動作環境。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-rmode=&quot;material&quot;>
      <div class=&quot;pc-key&quot;>MODE 2</div>
      <div class=&quot;pc-title&quot;>📚 研修教材用README</div>
      <div class=&quot;pc-desc&quot;>教材・演習向け。学べること→進め方→対象者→注意点。</div>
    </div>
    <div class=&quot;pattern-card&quot; data-rmode=&quot;project&quot;>
      <div class=&quot;pc-key&quot;>MODE 3</div>
      <div class=&quot;pc-title&quot;>📦 プロジェクト用README</div>
      <div class=&quot;pc-desc&quot;>リポジトリ向け。概要→機能→セットアップ→使い方→ライセンス。</div>
    </div>
  </div>
</div>

<!-- ===== 共通入力 ===== -->
<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>📘 基本情報</div>
  <div class=&quot;row cols2&quot;>
    <div><label>名称（タイトル）</label><input type=&quot;text&quot; id=&quot;rm_name&quot; placeholder=&quot;例：うさうさ式 IT現場ジェネレーター&quot;></div>
    <div><label>一言キャッチ</label><input type=&quot;text&quot; id=&quot;rm_catch&quot; placeholder=&quot;例：現場の定型ドキュメントをボタンひとつで&quot;></div>
  </div>
  <div class=&quot;row cols2&quot;>
    <div><label>バージョン</label><input type=&quot;text&quot; id=&quot;rm_ver&quot; placeholder=&quot;例：v1.0&quot;></div>
    <div><label>ライセンス</label>
      <select id=&quot;rm_license&quot;>
        <option value=&quot;自由利用可（商用・改変・再配布OK）&quot; selected>自由利用可（商用・改変・再配布OK）</option>
        <option value=&quot;社内利用限定&quot;>社内利用限定</option>
        <option value=&quot;MIT License&quot;>MIT License</option>
        <option value=&quot;Apache License 2.0&quot;>Apache License 2.0</option>
        <option value=&quot;個人利用のみ&quot;>個人利用のみ</option>
        <option value=&quot;記載なし&quot;>記載なし</option>
      </select>
    </div>
  </div>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>① WHY：なぜ作ったか / これは何か</div>
  <div class=&quot;hint&quot;>背景・課題・「これがあると何が嬉しいか」を書きます。読み手の前提を想像して。</div>
  <textarea id=&quot;rm_why&quot; rows=&quot;3&quot; placeholder=&quot;例：研修・現場で毎回同じ書類を書いていた。型を渡せば誰でも書けるようにしたかった。&quot;></textarea>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>② WHAT：何ができるか / 内容（1行に1項目）</div>
  <div class=&quot;hint&quot;>機能・収録内容を改行区切りで。先頭の「-」は付けても付けなくてもOK。</div>
  <textarea id=&quot;rm_what&quot; rows=&quot;5&quot; placeholder=&quot;例：&amp;#10;12タブ・23モードの定型ドキュメントを生成&amp;#10;Notion用Markdownでそのままコピペできる&amp;#10;1ファイル完結・インストール不要&quot;></textarea>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>③ HOW：使い方 / 進め方（1行に1ステップ）</div>
  <div class=&quot;hint&quot;>手順を改行区切りで。番号は自動で振られます。</div>
  <textarea id=&quot;rm_how&quot; rows=&quot;5&quot; placeholder=&quot;例：&amp;#10;ファイルをダウンロード&amp;#10;ダブルクリックでブラウザで開く&amp;#10;フォームを埋めて生成ボタン&amp;#10;コピーしてNotionへ&quot;></textarea>
</div>

<div class=&quot;card&quot;>
  <div class=&quot;section-label&quot;><span class=&quot;accent&quot;></span>補足（任意）</div>
  <div class=&quot;row cols1&quot;>
    <div><label>動作環境 / 前提（ツール・プロジェクト用）</label><input type=&quot;text&quot; id=&quot;rm_env&quot; placeholder=&quot;例：Chrome / Safari / Edge、ネット不要&quot;></div>
  </div>
  <div class=&quot;row cols1&quot;>
    <div><label>注意点・既知の制限</label><textarea id=&quot;rm_note&quot; rows=&quot;2&quot; placeholder=&quot;例：localStorageは使用しません。入力データは送信されません。&quot;></textarea></div>
  </div>
  <div class=&quot;row cols1&quot;>
    <div><label>作者 / 連絡先（任意）</label><input type=&quot;text&quot; id=&quot;rm_author&quot; placeholder=&quot;例：うさうさエンジニア研究室&quot;></div>
  </div>
</div>

<button class=&quot;btn-gen&quot; id=&quot;rm_gen-btn&quot;>📘 READMEのマークダウンを生成する</button>

<div class=&quot;card&quot; id=&quot;rm_output-card&quot; style=&quot;display:none&quot;>
  <div class=&quot;output-header&quot;>
    <span class=&quot;output-title&quot;>📄 Notion用マークダウン（README）</span>
    <div class=&quot;output-actions&quot;>
      <button class=&quot;btn-copy&quot; id=&quot;rm_copy-btn&quot;>📋 コピー</button>
      <button class=&quot;btn-copy&quot; id=&quot;rm_dl-btn&quot; data-out=&quot;rm_output&quot; data-prefix=&quot;README&quot;>⬇️ MD保存</button>
    </div>
  </div>
  <div class=&quot;output-box&quot; id=&quot;rm_output&quot;></div>
</div>

</div><!-- /panel-readme -->

</div><!-- /wrap -->

<script>
/* ===================================================== */
/* ============== 共通：状態管理 ======================= */
/* ===================================================== */
const sel = {};
let audience = 'eng'; // newbie / eng / se
let pattern = null;   // A / B / C / D / E
let memoType = 'general';  // general / observe / awareness / learn / meeting / idea
let reviewMode = 'self'; // self / response / reviewer
let webPhase = 'req';   // req / spec / ui / impl / test / precheck / readme / all
let webPerspective = 'student'; // student / teacher
let intakeMode = 'memo'; // memo / agenda / agree / all
let intakePerspective = 'receiver'; // receiver / client

/* ===================================================== */
/* ============== 設計5原則：折りたたみ ================ */
/* ===================================================== */
document.getElementById('principles-toggle').addEventListener('click', () => {
  document.getElementById('principles').classList.toggle('collapsed');
});

/* ===================================================== */
/* ============== 設計5原則：語彙集 ==================== */
/* ===================================================== */
const vocabList = document.getElementById('vocab-list');
function addVocab(term='', def=''){
  const row = document.createElement('div');
  row.className = 'vocab-row';
  row.innerHTML = `<input type=&quot;text&quot; class=&quot;vocab-term&quot; placeholder=&quot;用語（例：DoD）&quot; value=&quot;${term}&quot;><input type=&quot;text&quot; class=&quot;vocab-def&quot; placeholder=&quot;定義（例：完了の定義、Definition of Done）&quot; value=&quot;${def}&quot;><button class=&quot;btn-mini&quot; onclick=&quot;this.parentNode.remove();updateMeter()&quot;>🗑</button>`;
  vocabList.appendChild(row);
}
document.getElementById('add-vocab').addEventListener('click', () => addVocab());
// デフォルト語彙
addVocab('DoD', '完了の定義（Definition of Done）— 何をもって完了とするかの判定基準');
addVocab('報連相', '報告・連絡・相談の総称。事実と所感を分けて伝える');

/* ===================================================== */
/* ============== 設計5原則：達成度メーター ============ */
/* ===================================================== */
function updateMeter(){
  const all = document.querySelectorAll('input[data-pchk]');
  const checked = [...all].filter(c => c.checked).length;
  const pct = all.length > 0 ? Math.round((checked / all.length) * 100) : 0;
  document.getElementById('meter-fill').style.width = pct + '%';
  document.getElementById('meter-text').textContent = `${checked} / ${all.length} チェック`;
}
document.querySelectorAll('input[data-pchk]').forEach(c => c.addEventListener('change', updateMeter));
updateMeter();

/* ===================================================== */
/* ============== 設計5原則：マークダウン化 ============ */
/* ===================================================== */
function buildPrinciplesMarkdown(){
  const chk = id => document.querySelector(`input[data-pchk=&quot;${id}&quot;]`).checked ? 'x' : ' ';
  const v = id => (document.getElementById(id)?.value || '').trim();

  // 語彙集
  const vocabRows = vocabList.querySelectorAll('.vocab-row');
  const vocabLines = [...vocabRows].map(r => {
    const t = r.querySelector('.vocab-term').value.trim();
    const d = r.querySelector('.vocab-def').value.trim();
    return (t || d) ? `| ${t || '—'} | ${d || '—'} |` : null;
  }).filter(Boolean);
  const vocabTable = vocabLines.length ? `| 用語 | 定義 |\n|------|------|\n${vocabLines.join('\n')}` : '_（語彙未登録）_';

  // ③ 登場人物
  const actors = v('p3_actors');

  // チェック達成度
  const allChks = document.querySelectorAll('input[data-pchk]');
  const checkedCount = [...allChks].filter(c => c.checked).length;
  const pct = allChks.length > 0 ? Math.round((checkedCount / allChks.length) * 100) : 0;

  return `## 📐 うさうさ式 設計5原則 確認

> このタスクは以下の5原則を通して設計されています。達成度： **${checkedCount} / ${allChks.length}** （${pct}%）

### ① 言葉を定義する

- [${chk('p1a')}] 曖昧な用語をゼロにする
- [${chk('p1b')}] 共通言語を揃える

**📖 語彙集**

${vocabTable}

### ② 目的・ゴール・対象を決める

- [${chk('p2a')}] 「何のために」「どこまで」「誰向けに」を明確にする

| 観点 | 内容 |
|------|------|
| 何のために | ${v('p2_why') || '（未記入）'} |
| どこまで | ${v('p2_scope') || '（未記入）'} |
| 誰向けに | ${v('p2_for') || '（未記入）'} |

### ③ 主語＋動詞でステップを書く

- [${chk('p3a')}] 作業を「行動単位」に分解する

**📌 例（チェック済みのもの）：**

- [${chk('p3ex1')}] 受講生が理解する
- [${chk('p3ex2')}] 講師が説明する
- [${chk('p3ex3')}] メンターが確認する

**👥 このタスクの登場人物：** ${actors || '（未記入）'}

### ④ 気を付けることを全部書く

- [${chk('p4a')}] 失敗ポイント・注意点・落とし穴を先に書き出す

${v('p4_pitfalls') ? v('p4_pitfalls').split('\n').map(l => l.startsWith('-') ? l : '- ' + l).join('\n') : '- （未記入）'}

### ⑤ 完了条件と期限

- [${chk('p5a')}] Notion の ToDo リストに落とし込む

| 項目 | 内容 |
|------|------|
| 完了の判定条件（DoD） | ${v('p5_dod') || '（未記入）'} |
| 期限 | ${v('p5_due') || '（未記入）'} |`;
}

