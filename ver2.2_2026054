document.getElementById('w_gen-btn').addEventListener('click', () => {
  const docno = w_v('w_docno');
  const rev = w_v('w_rev');
  const conf = document.getElementById('w_conf').value;
  const relate = w_v('w_relate');
  const {project, table} = w_metaTable();
  const start = w_v('w_startdate') || todayStr;
  const student = w_v('w_student');
  const teacher = w_v('w_teacher');

  const header = `${audTone()}

${w_perspectiveNote()}

# 🎨 ${project}`;

  const isoBlock = isoSection(docno, rev, conf, relate, student || '未設定', teacher || '', '', start);
  const principles = buildPrinciplesMarkdown();
  const metaBlock = `## 📨 プロジェクト基本情報

${table}`;

  let phaseBody;

  if (webPhase === 'all') {
    // ===== 提出一式：全フェーズ統合 =====
    const overall = w_v('w_all_overall') || '_（記載なし）_';
    const files = w_v('w_all_files') || '_（記載なし）_';
    const hours = w_v('w_all_hours') || '_（未記入）_';
    const eval_ = w_v('w_all_selfeval') || '_（未選択）_';

    const toc = `## 📑 目次

1. [① 要求定義](#-①-要求定義)
2. [② 要件定義](#-②-要件定義)
3. [③ UIデモ・デザイン仕様](#-③-uiデモデザイン仕様)
4. [④ 実装記録](#-④-実装記録)
5. [⑤ テスト](#-⑤-テスト)
6. [⑥ 提出前チェック](#-⑥-提出前チェック)
7. [⑦ README](#-⑦-readme)
8. [⑧ 提出総括](#-⑧-提出総括)`;

    const overallSection = webPerspective === 'teacher'
      ? `## 🎁 ⑧ 提出総括（指示・評価観点）

### 講師から：総合評価メモ欄

| 項目 | 内容 |
|------|------|
| 受講生の自己評価 | ${eval_} |
| 受講生申告所要時間 | ${hours} |
| 提出ファイル | ${files} |
| 講師総合評価 | ☐ S　／　☐ A　／　☐ B　／　☐ C |
| 良かった点 |  |
| 次回への課題 |  |

### 受講生からの総括コメント

> ${overall.split('\n').join('\n> ')}`
      : `## 🎁 ⑧ 提出総括

### 制作者からの総括コメント

${overall}

### 提出物一覧

${files}

### 実績データ

| 項目 | 内容 |
|------|------|
| 所要時間（実績） | ${hours} |
| 自己評価 | ${eval_} |

### 講師レビュー欄（指示元が記入）

| 項目 | 内容 |
|------|------|
| 総合評価 |  |
| 良かった点 |  |
| 次回への課題 |  |
| 確認日 |  |`;

    phaseBody = `${toc}

---

${buildReqPhase()}

---

${buildSpecPhase()}

---

${buildUiPhase()}

---

${buildImplPhase()}

---

${buildTestPhase()}

---

${buildPrecheckPhase()}

---

${buildReadmePhase()}

---

${overallSection}`;

  } else {
    // ===== 単一フェーズ =====
    const builders = {
      req: buildReqPhase,
      spec: buildSpecPhase,
      ui: buildUiPhase,
      impl: buildImplPhase,
      test: buildTestPhase,
      precheck: buildPrecheckPhase,
      readme: buildReadmePhase
    };
    phaseBody = builders[webPhase]();
  }

  const footer = `\n\n---\n\n> 🐰 *Generated by うさうさ式 IT現場ジェネレーター v2 ─ 要求→要件→UI→実装→テスト→README、Web制作の全工程を構造化*`;

  const md = `${header}

${isoBlock}

---

${principles}

---

${metaBlock}

---

${phaseBody}${footer}`;

  document.getElementById('w_output').textContent = md;
  document.getElementById('w_output-card').style.display = 'block';
  document.getElementById('w_output-card').scrollIntoView({behavior:'smooth', block:'nearest'});
});

document.getElementById('w_copy-btn').addEventListener('click', () => {
  copyTo('w_output', 'w_copy-btn');
});

