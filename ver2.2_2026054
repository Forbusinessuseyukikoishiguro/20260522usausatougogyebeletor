/* ===================================================== */
/* ============== タブ4：メモ→MD変換 ================== */
/* ===================================================== */
const MEMO_META = {
  general:   {icon:'📝', name:'一般メモ',      hint:'汎用フォーマットで記録します。'},
  observe:   {icon:'👀', name:'受講生観察メモ', hint:'受講生カルテDB向け。事実と所感を分離して記録します。'},
  awareness: {icon:'🧀', name:'気づきログ',    hint:'James Reasonのスイスチーズモデルに基づき、責めずに原因のレイヤーを可視化します。'},
  learn:     {icon:'📚', name:'学習メモ',      hint:'うさうさ式4階層（定義→比喩→詳細→まとめ）で自分の学びを構造化します。'},
  meeting:   {icon:'🗣', name:'会議メモ',      hint:'参加者・決定事項・宿題・次回確認事項を自動抽出します。'},
  idea:      {icon:'💡', name:'アイデアメモ',  hint:'タグ集計と関連メモ参照欄付きで思いつきを保管します。'}
};

/* ---------- メモ整形エンジン ---------- */
function parseRawMemo(raw, opts, peopleList){
  const lines = raw.split('\n');
  const blocks = [];      // {type:'timestamp|fact|impression|action|todo|question|para', text, time?, level?}
  const tags = new Set();
  const actions = [];
  const todos = [];
  const questions = [];
  const facts = [];
  const impressions = [];

  const escapeReg = s => s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&amp;');
  const tsRe = /^(\d{1,2}:\d{2})\s*[:：]?\s*(.*)$/;
  const tagRe = /#([^\s#]+)/g;

  lines.forEach(rawLine => {
    let line = rawLine.replace(/\s+$/,'');
    if (!line.trim()) { blocks.push({type:'blank'}); return; }

    // タグ抽出
    if (opts.tag) {
      let m;
      while ((m = tagRe.exec(line)) !== null) tags.add(m[1]);
    }

    // タイムスタンプ
    let timeMatch = null;
    if (opts.timestamp) {
      const tm = line.match(tsRe);
      if (tm) { timeMatch = tm[1]; line = tm[2]; }
    }

    // チェックボックス（TODO: / [] / やる:）
    if (opts.todo &amp;&amp; /^(\[\]|\[ \]|TODO[:：]|やる[:：])/.test(line.trim())) {
      const t = line.replace(/^(\[\]|\[ \]|TODO[:：]|やる[:：])\s*/,'').trim();
      todos.push({time:timeMatch, text:t});
      blocks.push({type:'todo', time:timeMatch, text:t});
      return;
    }

    // 質問（末尾?）
    if (opts.question &amp;&amp; /[?？]\s*$/.test(line.trim())) {
      questions.push({time:timeMatch, text:line.trim()});
      blocks.push({type:'question', time:timeMatch, text:line.trim()});
      return;
    }

    // 事実：/ 所感：
    if (opts.factimp) {
      const factM = line.match(/^[\s]*(事実|FACT|fact)[:：]\s*(.*)$/);
      const impM = line.match(/^[\s]*(所感|推測|IMPRESSION|impression)[:：]\s*(.*)$/);
      if (factM) {
        facts.push({time:timeMatch, text:factM[2]});
        blocks.push({type:'fact', time:timeMatch, text:factM[2]});
        return;
      }
      if (impM) {
        impressions.push({time:timeMatch, text:impM[2]});
        blocks.push({type:'impression', time:timeMatch, text:impM[2]});
        return;
      }
    }

    // アクション項目（→ または →）
    if (opts.action &amp;&amp; /(→|→)/.test(line)) {
      const t = line.replace(/^.*?(→|→)\s*/,'').trim();
      actions.push({time:timeMatch, text:t || line.trim()});
      blocks.push({type:'action', time:timeMatch, text:t || line.trim()});
      return;
    }

    // タイムスタンプ付き通常行
    if (timeMatch) {
      blocks.push({type:'timestamp', time:timeMatch, text:line.trim()});
      return;
    }

    blocks.push({type:'para', text:line.trim()});
  });

  // 参加者名強調
  if (opts.people &amp;&amp; peopleList.length) {
    blocks.forEach(b => {
      if (!b.text) return;
      peopleList.forEach(name => {
        if (!name) return;
        const re = new RegExp(escapeReg(name), 'g');
        b.text = b.text.replace(re, `**${name}**`);
      });
    });
  }

  return {blocks, tags:[...tags], actions, todos, questions, facts, impressions};
}

function renderBlocks(blocks, smartMode){
  const out = [];
  let buf = [];
  const flushPara = () => {
    if (buf.length) {
      out.push(buf.join(smartMode ? ' ' : '\n'));
      buf = [];
    }
  };
  blocks.forEach(b => {
    if (b.type === 'blank') { flushPara(); out.push(''); return; }
    if (b.type === 'timestamp') {
      flushPara();
      out.push(`### 🕒 ${b.time} ${b.text}`);
      return;
    }
    if (b.type === 'fact') {
      flushPara();
      out.push(`> 🔍 **事実${b.time ? ` (${b.time})` : ''}：** ${b.text}`);
      return;
    }
    if (b.type === 'impression') {
      flushPara();
      out.push(`> 💭 **所感${b.time ? ` (${b.time})` : ''}：** ${b.text}`);
      return;
    }
    if (b.type === 'action') {
      flushPara();
      out.push(`- 🎯 **アクション${b.time ? ` (${b.time})` : ''}：** ${b.text}`);
      return;
    }
    if (b.type === 'todo') {
      flushPara();
      out.push(`- [ ] ${b.time ? `(${b.time}) ` : ''}${b.text}`);
      return;
    }
    if (b.type === 'question') {
      flushPara();
      out.push(`- ❓ ${b.time ? `(${b.time}) ` : ''}${b.text}`);
      return;
    }
    if (b.type === 'para') {
      buf.push(`- ${b.text}`);
      return;
    }
  });
  flushPara();
  return out.join('\n');
}

document.getElementById('m_gen-btn').addEventListener('click', () => {
  const v = id => document.getElementById(id).value.trim();
  if (!memoType) { alert('メモタイプを選択してください'); return; }

  const meta = MEMO_META[memoType];
  const author = v('m_author') || '未設定';
  const title = v('m_title') || `${meta.name} ${todayStr}`;
  const date = v('m_date') || todayStr;
  const context = v('m_context');
  const peopleRaw = v('m_people');
  const people = peopleRaw ? peopleRaw.split(/[,、，]/).map(s=>s.trim()).filter(Boolean) : [];
  const raw = v('m_raw');

  const opts = {
    timestamp: document.getElementById('opt_timestamp').checked,
    factimp:   document.getElementById('opt_factimp').checked,
    action:    document.getElementById('opt_action').checked,
    todo:      document.getElementById('opt_todo').checked,
    tag:       document.getElementById('opt_tag').checked,
    question:  document.getElementById('opt_question').checked,
    people:    document.getElementById('opt_people').checked,
    smart:     document.getElementById('opt_smart').checked,
  };

  const docno = v('m_docno');
  const rev = v('m_rev');
  const conf = document.getElementById('m_conf').value;
  const relate = v('m_relate');

  const parsed = parseRawMemo(raw, opts, people);
  const body = renderBlocks(parsed.blocks, opts.smart);

  // 抽出サマリー
  const summaryLines = [];
  if (opts.tag &amp;&amp; parsed.tags.length) {
    summaryLines.push(`**🏷 タグ：** ${parsed.tags.map(t=>`\`#${t}\``).join(' ')}`);
  }
  if (parsed.actions.length) {
    summaryLines.push(`**🎯 アクション項目（${parsed.actions.length}件）：**\n${parsed.actions.map(a=>`- ${a.time?`(${a.time}) `:''}${a.text}`).join('\n')}`);
  }
  if (parsed.todos.length) {
    summaryLines.push(`**✅ ToDo（${parsed.todos.length}件）：**\n${parsed.todos.map(t=>`- [ ] ${t.time?`(${t.time}) `:''}${t.text}`).join('\n')}`);
  }
  if (parsed.questions.length) {
    summaryLines.push(`**❓ 質問・確認事項（${parsed.questions.length}件）：**\n${parsed.questions.map(q=>`- ${q.time?`(${q.time}) `:''}${q.text}`).join('\n')}`);
  }
  if (parsed.facts.length || parsed.impressions.length) {
    summaryLines.push(`**⚖️ 事実 ${parsed.facts.length}件 / 所感 ${parsed.impressions.length}件 を分離記録**`);
  }
  const summaryBlock = summaryLines.length
    ? `## 🔎 自動抽出サマリー\n\n${summaryLines.join('\n\n')}\n\n---\n`
    : '';

  // メモタイプ別の専用セクション
  let typeSection = '';
  if (memoType === 'observe') {
    typeSection = `
## 📋 受講生カルテへの記入候補

> このメモから受講生カルテDBに反映する情報の整理欄です。

| 受講生 | 観察内容（事実） | 次の打ち手（所感→アクション） |
|--------|-----------------|------------------------------|
${people.length ? people.map(p=>`| ${p} |  |  |`).join('\n') : '|  |  |  |'}
`;
  } else if (memoType === 'awareness') {
    typeSection = `
## 🧀 スイスチーズモデル分析（Blameless）

> 個人を責めず、システムとして「どこの防護層に穴があったか」を整理します。

| 防護層 | 穴の有無 | 補強策 |
|--------|----------|--------|
| ① 設計・手順書 | ☐ あり ／ ☐ なし |  |
| ② 訓練・教育 | ☐ あり ／ ☐ なし |  |
| ③ チェック・レビュー | ☐ あり ／ ☐ なし |  |
| ④ アラート・監視 | ☐ あり ／ ☐ なし |  |
| ⑤ 復旧手順 | ☐ あり ／ ☐ なし |  |

**🌱 学びとして残すこと：**

- 
`;
  } else if (memoType === 'learn') {
    typeSection = `
## 🐰 うさうさ式 4階層 自己整理（記入欄）

### 🅐 定義：今日学んだことを一言で

> 

