let docsMode = 'skill'; // skill / hearing / schedule

const DOCS_MODE_META = {
  skill:    {icon:'📄', name:'スキルシート案件欄'},
  hearing:  {icon:'🎤', name:'ヒアリングシート'},
  schedule: {icon:'📅', name:'研修時間割'}
};

document.querySelectorAll('.pattern-card[data-xmode]').forEach(p => {
  p.addEventListener('click', () => {
    document.querySelectorAll('.pattern-card[data-xmode]').forEach(x => x.classList.remove('active'));
    p.classList.add('active');
    docsMode = p.dataset.xmode;
    document.querySelectorAll('.xmode-block').forEach(b => {
      b.style.display = (b.dataset.xmodeTarget === docsMode) ? 'block' : 'none';
    });
  });
});
document.querySelector('.pattern-card[data-xmode=&quot;skill&quot;]').classList.add('active');

['x_h_date', 'x_s_date'].forEach(id => {
  const el = document.getElementById(id);
  if (el &amp;&amp; !el.value) el.value = todayStr;
});

/* ===== MODE 3: 時間割セッション ===== */
const SESS_CATEGORIES = ['オリエン','講義','演習','テスト','質問対応','休憩','昼休み','予備'];
const sessContainer = document.getElementById('x_s_sessions');

function addSession(cat='講義', theme='', minutes=60){
  const row = document.createElement('div');
  row.className = 'sess-item';
  row.innerHTML = `
    <div><label>時刻</label><div class=&quot;sess-time&quot;>--:-- 〜 --:--</div></div>
    <div><label>テーマ</label><input type=&quot;text&quot; class=&quot;ss-theme&quot; value=&quot;${theme.replace(/&quot;/g,'&amp;quot;')}&quot; placeholder=&quot;例：基本コマンド①&quot;></div>
    <div><label>所要分</label><input type=&quot;number&quot; class=&quot;ss-min&quot; value=&quot;${minutes}&quot; min=&quot;0&quot; step=&quot;5&quot;></div>
    <div><label>カテゴリ</label><select class=&quot;ss-cat&quot;>${SESS_CATEGORIES.map(c=>`<option value=&quot;${c}&quot;${c===cat?' selected':''}>${c}</option>`).join('')}</select></div>
    <div><label>メモ（任意）</label><input type=&quot;text&quot; class=&quot;ss-note&quot; placeholder=&quot;例：対話多め&quot;></div>
    <button class=&quot;btn-mini&quot; onclick=&quot;this.closest('.sess-item').remove();recalcSessions()&quot;>🗑</button>`;
  sessContainer.appendChild(row);
  row.querySelector('.ss-min').addEventListener('input', recalcSessions);
  recalcSessions();
}

function recalcSessions(){
  const start = document.getElementById('x_s_start').value || '09:00';
  let [h, m] = start.split(':').map(Number);
  let cur = h * 60 + m;
  sessContainer.querySelectorAll('.sess-item').forEach(row => {
    const min = parseInt(row.querySelector('.ss-min').value) || 0;
    const st = cur, en = cur + min;
    const fmt = t => `${String(Math.floor(t/60)%24).padStart(2,'0')}:${String(t%60).padStart(2,'0')}`;
    row.querySelector('.sess-time').textContent = `${fmt(st)} 〜 ${fmt(en)}`;
    cur = en;
  });
}
document.getElementById('x_s_start').addEventListener('input', recalcSessions);
document.getElementById('x_s_add').addEventListener('click', () => addSession());
document.getElementById('x_s_clear').addEventListener('click', () => {
  if (confirm('全セッションを削除しますか？')) sessContainer.innerHTML = '';
});
document.getElementById('x_s_loadtemplate').addEventListener('click', () => {
  if (sessContainer.children.length &amp;&amp; !confirm('既存セッションがあります。定石を追加しますか？')) return;
  document.getElementById('x_s_start').value = '09:00';
  addSession('オリエン','朝会・本日のゴール共有',30);
  addSession('講義','重要トピック（脳がフレッシュな時間）',60);
  addSession('休憩','休憩',15);
  addSession('講義','概念の深掘り',75);
  addSession('昼休み','昼休み',60);
  addSession('講義','午後イチ・対話多め',60);
  addSession('休憩','休憩',15);
  addSession('演習','手を動かす時間',60);
  addSession('休憩','休憩',15);
  addSession('テスト','自動採点で即フィードバック',30);
  addSession('質問対応','答え合わせ・日報・質問',30);
  recalcSessions();
});
// デフォルトで数行
addSession('オリエン','朝会・本日のゴール',30);
addSession('講義','本日のメイントピック',60);

/* ===================================================== */
/* 研修ドキュメント：マークダウン生成                    */
/* ===================================================== */
document.getElementById('x_gen-btn').addEventListener('click', () => {
  const v = id => (document.getElementById(id)?.value || '').trim();
  const meta = DOCS_MODE_META[docsMode];
  const docno = v('x_docno'), rev = v('x_rev');
  const conf = document.getElementById('x_conf').value;
  const relate = v('x_relate');

  let titleLine, body, isoAuthor = '', isoDate = todayStr;

  // ===== MODE 1: スキルシート案件欄 =====
  if (docsMode === 'skill') {
    const no = v('x_sk_no'), p1 = v('x_sk_period1'), p2 = v('x_sk_period2');
    const industry = v('x_sk_industry') || '—', role = v('x_sk_role') || '—', scale = v('x_sk_scale') || '—';
    const title = v('x_sk_title') || '（タイトル未入力）';
    const lang = v('x_sk_lang') || '—', db = v('x_sk_db') || '—', os = v('x_sk_os') || '—', env = v('x_sk_env') || '—';
    const proc = v('x_sk_process') || '—';
    const system = v('x_sk_system'), phase = v('x_sk_phase'), duty = v('x_sk_duty');
    const work = v('x_sk_work'), output = v('x_sk_output');
    const skcase = sel['skcase'] || '';

    // 作業内容を箇条書き化
    const workLines = work ? work.split('\n').map(l => l.trim()).filter(Boolean).map(l => l.replace(/^[・\-*]\s*/, '')) : [];
    const workMd = workLines.length ? workLines.map(l => `・${l}`).join('\n') : '・（未入力）';

    // 文字数カウント（本文5ブロック合計）
    const bodyText = [system, phase, duty, work, output].join('');
    const charCount = bodyText.replace(/\s/g, '').length;

    // 企業名特定NGの簡易検出
    const ngPatterns = /(株式会社|有限会社|\(株\)|（株）|㈱|Inc\.|Corp\.|Co\.,|LLC|銀行$|生命$|證券|証券$)/;
    const allInput = [title, system, phase, duty, work, output].join(' ');
    const ngHits = [];
    [title, system, phase, duty, work, output].forEach((t, i) => {
      const names = ['企業・PJ名','システム内容','対応工程','担当業務','作業内容','成果物'];
      if (t &amp;&amp; ngPatterns.test(t)) ngHits.push(names[i]);
    });

    // ケース別の推奨
    const caseGuide = {
      'A':'長期案件（4年級）：作業内容11項目前後・本文合計約300字が目安',
      'B':'中期案件（1年級）：作業内容3〜5項目・本文合計約100〜150字が目安',
      'C':'短期案件（4ヶ月級）：作業内容5〜6項目・本文合計約100字が目安'
    };

    // 提出前チェック自動判定
    const checks = [
      [system &amp;&amp; phase &amp;&amp; duty &amp;&amp; work &amp;&amp; output, 'すべての■ブロックが埋まっている（5ブロック）'],
      [ngHits.length === 0, '企業名・システム名の特定表現が無い'],
      [workLines.length >= 3, '作業内容が箇条書きで複数項目ある'],
      [/\d{4}\/\d{2}/.test(phase), '対応工程に期間（yyyy/mm〜）が入っている'],
      [/\d/.test(output), '成果物に可能な限り数字を入れた']
    ];
    const checkMd = checks.map(([ok, label]) => `- [${ok ? 'x' : ' '}] ${label}`).join('\n');

    isoAuthor = v('x_relate') ? '' : '';
    titleLine = `# 📄 スキルシート案件欄${no ? `（No.${no}）` : ''}：${title}`;
    body = `## 📋 メタデータ（外枠）

| 項目 | 内容 |
|------|------|
| No | ${no || '—'} |
| 期間 | ${p1 || '—'}${p2 ? ` ／ ${p2}` : ''} |
| 業種 | ${industry} |
| 企業・プロジェクト名 | ${title} |
| 役割 | ${role} |
| 規模 | ${scale} |
| 言語／ツール | ${lang} |
| DB | ${db} |
| サーバ／OS | ${os} |
| 環境／ミドルウェア | ${env} |
| 担当工程 | ${proc} |

---

## 📝 本文（5ブロック）

**${title}**

■システム内容
${system || '（未入力）'}

■対応工程
${phase || '（未入力）'}

■担当業務
${duty || '（未入力）'}

■作業内容
${workMd}

■成果物
${output || '（未入力）'}

---

## 🔍 サイズ実測

| 指標 | 値 |
|------|-----|
| 本文5ブロック合計文字数 | 約 ${charCount} 文字 |
| 作業内容の項目数 | ${workLines.length} 項目 |
| 選択ケース | ${skcase ? `ケース${skcase}` : '未選択'} |
${skcase ? `\n> 📐 ${caseGuide[skcase]}` : ''}

---

## 📊 提出前チェック（自動判定）

${checkMd}
${ngHits.length ? `\n> ⚠️ **企業名特定の疑いがある表現を検出しました：** ${ngHits.join('、')}。\n> 「業界＋システム種別」の表現に書き換えてください（例：金融業 社内システム開発）。` : '\n> ✅ 企業名特定表現は検出されませんでした。'}`;

  }

  // ===== MODE 2: ヒアリングシート =====
  else if (docsMode === 'hearing') {
    const mask = document.getElementById('x_h_maskCompany').checked;
    const company = mask ? '〇〇社' : (v('x_h_company') || '（未入力）');
    const person = v('x_h_person') || '（未入力）';
    const date = v('x_h_date') || todayStr;
    const theme = v('x_h_theme') || '（未入力）';
    const format = document.getElementById('x_h_format').value;
    const count = v('x_h_count') || '—';
    const when = v('x_h_when') || '—';
    const who = v('x_h_who') || '—';
    isoDate = date; isoAuthor = '';

    const includeQ = document.getElementById('x_h_includeQ').checked;
    const QUESTIONS = [
      ['ゴール','この研修を通じて、3ヶ月後に現場でどんな変化が起きていれば成功ですか？'],
      ['ゴール','受講生に研修後、具体的に何を「できるようになって」ほしいですか？'],
      ['ゴール','この研修を企画されたきっかけ・背景を教えてください'],
      ['ゴール','研修が失敗だったと感じるのはどんな状況ですか？（NGの定義）'],
      ['受講生','受講生の参加は任意ですか？それとも必須参加ですか？'],
      ['受講生','ITツールや技術への苦手意識がある受講生はどのくらいいますか？'],
      ['受講生','受講生の年齢層・職種・業務内容を教えてください'],
      ['受講生','過去の研修でクレームや不満が出たことはありましたか？'],
      ['スタイル','楽しさ重視ですか？厳しくても確実に身につけてほしいですか？'],
      ['スタイル','講師が受講生の間違いをその場で指摘することはOKですか？'],
      ['スタイル','グループワークや演習の比率はどのくらいを想定していますか？'],
      ['スタイル','宿題・事前課題を課してもいいですか？'],
      ['内容','絶対に外せないコンテンツ・テーマは何ですか？'],
      ['内容','時間が足りなくなった場合に削ってよいコンテンツはありますか？'],
      ['内容','研修中に扱えないNGトピック・社外秘情報はありますか？'],
      ['環境','実施環境（対面/オンライン）と使用するPCやツールを教えてください'],
      ['環境','既存の教材・資料はありますか？それを活用しますか？'],
      ['評価','研修後にアンケートやテストを実施しますか？'],
      ['その他','過去に「良かった」と感じた研修はどんな研修でしたか？'],
      ['その他','他に確認しておきたいことや懸念点はありますか？']
    ];
    const qSection = includeQ ? `\n\n---\n\n## 🎤 当日質問テンプレート（20問）\n\n${QUESTIONS.map((q,i) => `${i+1}. **[${q[0]}]** ${q[1]}\n   - 回答： `).join('\n')}` : '';

    // 完了チェック自動判定
    const hchecks = [
      [v('x_h_goal3m'), 'ビジネスゴール（3ヶ月後の変化）を行動動詞で確認した'],
      [document.getElementById('x_h_mind').value, '受講生のマインドタイプ（A〜D）を把握した'],
      [document.getElementById('x_h_tolerance').value, '厳しさ耐性レベルを確認した'],
      [v('x_h_success'), '研修成功の定義・測定方法を合意した'],
      [v('x_h_must') || v('x_h_cut'), '優先コンテンツ・削れるコンテンツを確認した'],
      [v('x_h_tools'), '環境・時間・ツールの制約を把握した'],
      [v('x_h_past'), '過去の研修の良かった点・悪かった点を聞いた'],
      [v('x_h_ng'), 'NGトピック・社外秘情報を確認した']
    ];
    const hcheckMd = hchecks.map(([ok,l]) => `- [${ok ? 'x' : ' '}] ${l}`).join('\n');

    titleLine = `# 🎤 IT研修 ヒアリングシート：${theme}`;
    body = `> 〜 クライアントの期待値を正確に言語化する 〜

## 1. 基本情報

| 項目 | 内容 |
|------|------|
| クライアント | ${company} |
| 担当者 | ${person} |
| 記入日 | ${date} |
| 研修テーマ | ${theme} |
| 実施形式 | ${format} |
| 受講人数 | ${count} |
| 実施予定 | ${when} |
| 受講生 | ${who} |

---

## 2. 期待値・ゴールの言語化

### 🎯 3ヶ月後に起きてほしい現場変化（行動動詞）

${v('x_h_goal3m') || '_（未記入）_'}

### 📌 研修企画の背景・きっかけ

${v('x_h_background') || '_（未記入）_'}

### ✅ 成功の定義・測定基準

${v('x_h_success') || '_（未記入）_'}

### 🚫 失敗の定義（NGシナリオ）

${v('x_h_fail') || '_（未記入）_'}

| 項目 | 内容 |
|------|------|
| 絶対に身につけてほしいスキルTOP1 | ${v('x_h_top1') || '—'} |
| 絶対に外せないコンテンツ | ${v('x_h_must') || '—'} |
| 削ってよい内容 | ${v('x_h_cut') || '—'} |

---

## 3. 受講生プロファイル・マインド診断

> マインドタイプ：A=前向き型 / B=義務参加型 / C=懐疑型 / D=恐怖型（IT苦手）

| 項目 | 内容 |
|------|------|
| 主なマインドタイプ | ${document.getElementById('x_h_mind').value} |
| 受講の任意/強制 | ${document.getElementById('x_h_force').value} |
| ITスキル平均レベル | ${document.getElementById('x_h_level').value} |
| 間違い指摘への耐性 | ${document.getElementById('x_h_tolerance').value} |
| 研修トーン希望 | ${document.getElementById('x_h_tone').value} |
| 講義 vs 演習比率 | ${v('x_h_ratio') || '—'} |
| テスト・評価 | ${document.getElementById('x_h_test').value} |
| 宿題・事前課題 | ${document.getElementById('x_h_homework').value} |

---

## 4. 制約・NG事項

| 項目 | 内容 |
|------|------|
| 使用PC・ツール | ${v('x_h_tools') || '—'} |
| 予算感 | ${v('x_h_budget') || '—'} |

**NGトピック・社外秘情報：**

${v('x_h_ng') || '_（未記入）_'}

**過去研修の良かった点・悪かった点：**

${v('x_h_past') || '_（未記入）_'}

---

## 5. ヒアリング完了チェックリスト

${hcheckMd}${qSection}`;

  }

  // ===== MODE 3: 研修時間割 =====
  else {
    const title = v('x_s_title') || '研修時間割';
    const date = v('x_s_date') || todayStr;
    const start = v('x_s_start') || '09:00';
    isoDate = date;
    const withSummary = document.getElementById('x_s_summary').checked;
    const withSheets = document.getElementById('x_s_sheets').checked;

    // セッション収集＋時刻再計算
    let [hh, mm] = start.split(':').map(Number);
    let cur = hh * 60 + mm;
    const fmt = t => `${String(Math.floor(t/60)%24).padStart(2,'0')}:${String(t%60).padStart(2,'0')}`;
    const sessions = [...sessContainer.querySelectorAll('.sess-item')].map((row, i) => {
      const theme = row.querySelector('.ss-theme').value.trim() || '（無題）';
      const min = parseInt(row.querySelector('.ss-min').value) || 0;
      const cat = row.querySelector('.ss-cat').value;
      const note = row.querySelector('.ss-note').value.trim();
      const st = cur, en = cur + min;
      cur = en;
      return {idx:i+1, st, en, min, cat, theme, note};
    });

    if (!sessions.length) { alert('セッションを1件以上追加してください'); return; }

    const tableRows = sessions.map(s =>
      `| ${s.idx} | ${fmt(s.st)} | ${s.min} | ${fmt(s.en)} | ${s.cat} | ${s.theme} | ${s.note || ''} |`
    ).join('\n');

    // カテゴリ別集計
    const totalMin = sessions.reduce((a,s) => a + s.min, 0);
    const byCat = {};
    sessions.forEach(s => { byCat[s.cat] = (byCat[s.cat]||0) + s.min; });
    const GOLDEN = {'講義':45,'演習':25,'休憩':15,'昼休み':15,'テスト':10,'オリエン':5,'質問対応':5,'予備':5};
    const summaryRows = SESS_CATEGORIES.filter(c => byCat[c]).map(c => {
      const min = byCat[c];
      const pct = Math.round(min / totalMin * 100);
      const h = (min/60).toFixed(1);
      const goldenHint = GOLDEN[c] != null ? `目安${GOLDEN[c]}%` : '—';
      return `| ${c} | ${min}分 | ${h}h | ${pct}% | ${goldenHint} |`;
    }).join('\n');

    const summarySection = withSummary ? `\n\n---\n\n## 📊 カテゴリ別 時間配分（黄金比チェック）

| カテゴリ | 合計分 | 時間 | 比率 | 黄金比目安 |
|----------|--------|------|------|-----------|
${summaryRows}
| **合計** | **${totalMin}分** | **${(totalMin/60).toFixed(1)}h** | **100%** | — |

> 🐰 黄金比の目安：講義45% / 演習25% / 休憩+昼15% / テスト10% / オリエン+質問5%
> 講義に寄りすぎると眠くなり、演習に寄りすぎると体系が見えなくなります。` : '';

    const sheetsSection = withSheets ? `\n\n---\n\n## 🛠 Googleスプレッドシート用 関数ヒント

時刻を自動連鎖させる場合（B=開始, C=所要分, D=終了）：

\`\`\`
D5 = B5 + TIME(0, C5, 0)      ← 終了 = 開始 + 所要分
B6 = D5                        ← 次の開始 = 前の終了（以降コピー）
\`\`\`

カテゴリ別集計（SUMIF）：

\`\`\`
=SUMIF(E5:E17, &quot;講義&quot;, C5:C17)  ← 講義の合計分
\`\`\`

現在進行中セッションを光らせる（LIVE）：

\`\`\`
=IF(AND(MOD(NOW(),1)>=B5, MOD(NOW(),1)<D5), &quot;🔴 LIVE&quot;, &quot;&quot;)
\`\`\`

> 条件付き書式のカスタム数式に \`=AND(MOD(NOW(),1)>=$B5, MOD(NOW(),1)<$D5)\` を入れると行全体が光ります。` : '';

    titleLine = `# 📅 ${title}`;
    body = `## 📨 基本情報

| 項目 | 内容 |
|------|------|
| 研修名 | ${title} |
| 日付 | ${date} |
| 開始 | ${start} |
| 終了（自動） | ${fmt(cur)} |
| 総所要時間 | ${(totalMin/60).toFixed(1)}h（${totalMin}分） |
| セッション数 | ${sessions.length}件 |

---

## 🕐 時間割

| # | 開始 | 所要分 | 終了 | カテゴリ | テーマ | メモ |
|---|------|--------|------|----------|--------|------|
${tableRows}${summarySection}${sheetsSection}

---

## 🚨 ひとり講師の3原則

1. **休憩を削るな** — 講師も受講生も体力切れになる
2. **休憩中の質問対応はしない** — 初日に宣言しておく
3. **最終日に予備30分** — 押し・突発質問を吸収`;
  }

  const md = `${audTone()}

${titleLine}

${isoSection(docno, rev, conf, relate, isoAuthor || '未設定', '', '', isoDate)}

---

${buildPrinciplesMarkdown()}

---

${body}

---

> 🐰 *Generated by うさうさ式 IT現場ジェネレーター v2 ─ ${meta.icon} ${meta.name}*
> *面白きこともなき世を面白く ─ 高杉晋作*`;

  document.getElementById('x_output').textContent = md;
  document.getElementById('x_output-card').style.display = 'block';
  document.getElementById('x_output-card').scrollIntoView({behavior:'smooth', block:'nearest'});
});

document.getElementById('x_copy-btn').addEventListener('click', () => {
  copyTo('x_output', 'x_copy-btn');
