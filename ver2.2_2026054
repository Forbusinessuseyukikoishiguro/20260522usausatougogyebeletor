---

> 💌 ${v('k_fb_message') || '_（励ましのひとこと）_'}

---

> 🐰 FBの鉄則：先にGoodで承認、Moreは人格でなく行動に向ける。本人の振り返りを起点に対話する。`;
  }

  const md = `${audTone()}

${titleLine}

${isoSection(docno, rev, conf, relate, author, '', '', date)}

---

${buildPrinciplesMarkdown()}

---

${body}

