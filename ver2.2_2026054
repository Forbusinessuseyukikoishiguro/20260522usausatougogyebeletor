  const project = w_v('w_project') || '無題プロジェクト';
  const student = w_v('w_student') || '未設定';
  const stack = w_v('w_impl_stack') || '（実装フェーズで記入）';

  // READMEはGitHub想定の形式で出力
  if (webPerspective === 'teacher') {
    return `## 📖 ⑦ README（指示・評価観点）

### 7-1. 受講生は以下の構成でREADMEを作成すること

\`\`\`markdown
# ${project}

