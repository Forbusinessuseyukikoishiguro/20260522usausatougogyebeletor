document.querySelector('.pattern-card[data-mtype=&quot;general&quot;]').classList.add('active');

/* ===================================================== */
/* ============== ステップ管理 ========================= */
/* ===================================================== */
const stepsContainer = document.getElementById('steps-container');
let stepCount = 0;

function addStep(val=''){
  stepCount++;
  const idx = stepCount;
  const row = document.createElement('div');
  row.className = 'step-row';
  row.innerHTML = `<span class=&quot;step-num&quot;>${idx}</span><input type=&quot;text&quot; placeholder=&quot;例：オペレーターがDBスナップショットを取得する&quot; style=&quot;flex:1&quot; value=&quot;${val}&quot;><button class=&quot;btn-mini&quot; style=&quot;margin-top:5px&quot; onclick=&quot;this.parentNode.remove()&quot;>🗑</button>`;
  stepsContainer.appendChild(row);
}

addStep('担当者がスコープと影響範囲を最終確認する');
addStep('オペレーターが本番バックアップを取得する');
addStep('担当者が変更スクリプトをステージング環境で実行・確認する');
addStep('リーダーが本番実行の承認をSlackで行う');
addStep('担当者が本番環境に変更を適用する');
addStep('担当者がヘルスチェックとログを確認する');

document.getElementById('add-step').addEventListener('click', ()=>addStep());

