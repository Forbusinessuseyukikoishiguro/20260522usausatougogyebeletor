let commMode = 'mtg';
const COMM_MODE_META = {
  mtg:      {icon:'🗓', name:'MTG当日メモ'},
  retro:    {icon:'🔄', name:'振り返りシート'},
  boss:     {icon:'📨', name:'忙しい上司への報告'},
  claim:    {icon:'⚠️', name:'クレーム対応・改善アクション'},
  confirm2: {icon:'✅', name:'指示の確認・復唱'},
  progress: {icon:'📊', name:'進捗報告'},
  daily:    {icon:'📝', name:'日報'},
  prep:     {icon:'📋', name:'報告メモ（PREP）'},
