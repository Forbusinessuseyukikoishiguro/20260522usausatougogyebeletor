document.querySelectorAll('.badge').forEach(b => {
  b.addEventListener('click', () => {
    const g = b.dataset.group;
    document.querySelectorAll(`.badge[data-group=&quot;${g}&quot;]`).forEach(x => {
      x.classList.remove('active','pri-high','pri-med','pri-low','status','step','conf','default');
    });
    b.classList.add('active', b.dataset.cls);
    sel[g] = b.dataset.val;
  });
});

